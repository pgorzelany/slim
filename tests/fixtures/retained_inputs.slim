fn version_entries(owner: identity.DeclarationId, count: I64, at: I64, entries: @Vec[retained.InputEntry]) -> Void effects[alloc, partial]:
  if at >= count:
    void
  else:
    let entry: retained.InputEntry = retained.InputEntry(owner: owner, key_start: 0, key_count: 0, result_start: 0, result_count: 0, next: at - 1)
    vec.push(@entries, entry)
    recur(owner, count, at + 1, @entries)

fn versions(owner: identity.DeclarationId, count: I64) -> retained.InputQueries effects[alloc, partial]:
  let heads: Vec[I64] = vec.new()
  vec.push(@heads, count - 1)
  let entries: Vec[retained.InputEntry] = vec.new()
  version_entries(owner, count, 0, @entries)
  retained.InputQueries(heads: heads, entries: entries, keys: vec.new(), results: vec.new())

# Inject five distinct valid-domain input facts into the query API. These facts
# exercise optional-history admission only and never approve a source program.
fn version_rounds(source: Bytes, tokens: Vec[syntax.Token], current: retained.Index, state: @retained.InputState, at: I64) -> I64 effects[alloc, partial]:
  if at >= 5:
    0
  else:
    let facts: Vec[ranges.Fact] = vec.new()
    ranges.initialize_facts(vec.len(tokens), 0, @facts)
    let argument: retained.InputArgument = vec.get(state.history.arguments, 0)
    let caller: retained.Declaration = vec.get(current.declarations, vec.get(state.callers, 0))
    let fact: ranges.Fact = ranges.Fact(analyzed: true, lower_known: true, lower: at, upper_known: true, upper: at, total: true)
    vec.set(@facts, caller.owner.first + argument.argument, fact)
    let parameters: Vec[ranges.Fact] = vec.new()
    let entries: Vec[ranges.Fact] = vec.new()
    let expected_parameters: Vec[ranges.Fact] = vec.new()
    let expected_entries: Vec[ranges.Fact] = vec.new()
    ranges.initialize_facts(vec.len(tokens), 0, @parameters)
    ranges.initialize_facts(vec.len(tokens), 0, @entries)
    ranges.initialize_facts(vec.len(tokens), 0, @expected_parameters)
    ranges.initialize_facts(vec.len(tokens), 0, @expected_entries)
    let invariant: Vec[Bool] = vec.new()
    ranges.initialize_booleans(vec.len(tokens), 0, true, @invariant)
    ranges.scan_parameter_calls(source, tokens, facts, state.invariants, 0, vec.len(tokens), @expected_parameters)
    ranges.scan_parameter_calls(source, tokens, facts, invariant, 0, vec.len(tokens), @expected_entries)
    retained.input_transfer(source, tokens, facts, current, @state, @parameters, @entries)
    let count: I64 = if at < 4:
      at + 1
    else:
      4
    let framed: Bool = (vec.len(state.history.queries.entries) == count) && same_bool(retained.input_admitted(state.budget), at < 4)
    if (framed && same_facts(parameters, expected_parameters, 0)) && same_facts(entries, expected_entries, 0):
      recur(source, tokens, current, @state, at + 1)
    else:
      38

fn check_version_producer() -> I64 effects[alloc, io, partial]:
  let source: Bytes = "module limits\n\nfn target(value: I64) -> I64:\n  value\n\nfn main(args: Vec[Bytes]) -> I64:\n  target(0)\n"
  let tokens: Vec[syntax.Token] = vec.new()
  let parsed: syntax.ProgramParse = syntax.parse_program_result(source, @tokens)
  let empty: retained.Cache = retained.empty_cache()
  let checked: check.Attempt = check.check_source_retained(source, @tokens, empty, identity.Revision(epoch: 1, serial: 1), 1000000)
  if checked.checked.status == 0:
    let state: retained.InputState = retained.input_start(source, tokens, empty, checked.cache.index, checked.transition, 1000000)
    let result: I64 = version_rounds(source, tokens, checked.cache.index, @state, 0)
    let finished: retained.InputHistory = retained.input_finish(^state)
    if vec.len(finished.functions) == 0:
      result
    else:
      39
  else:
    checked.checked.status

fn check_version_bounds() -> I64 effects[alloc, io, partial]:
  let file: identity.FileId = identity.FileId(revision: identity.Revision(epoch: 1, serial: 1), slot: 0)
  let owner: identity.DeclarationId = identity.DeclarationId(file: file, slot: 0)
  let none: retained.InputQueries = versions(owner, 0)
  let one: retained.InputQueries = versions(owner, 1)
  let three: retained.InputQueries = versions(owner, 3)
  let four: retained.InputQueries = versions(owner, 4)
  let five: retained.InputQueries = versions(owner, 5)
  let exact: Bool = ((retained.input_previous_head(none, four, owner, -1) == 3) && (retained.input_previous_head(one, three, owner, 0) == 2)) && (retained.input_previous_head(three, one, owner, 2) == 0)
  let beyond: Bool = ((retained.input_previous_head(one, four, owner, 0) == -1) && (retained.input_previous_head(four, one, owner, 3) == -1)) && (retained.input_previous_head(none, five, owner, -1) == -1)
  let malformed: Bool = (retained.input_previous_head(five, none, owner, 4) == -1) && (retained.input_previous_head(one, none, owner, 9223372036854775807) == -1)
  if (exact && beyond) && malformed:
    check_version_producer()
  else:
    35

fn main(args: Vec[Bytes]) -> I64 effects[alloc, io, partial]:
  if vec.len(args) == 1:
    check_version_bounds()
  else:
    run_files(args)

fn run_files(args: Vec[Bytes]) -> I64 effects[alloc, io, partial]:
  if vec.len(args) == 2:
    let input: Vec[U8] = vec.new()
    if io.read_file(vec.get(args, 1), @input):
      let source: Bytes = bytes.freeze(^input)
      run(source)
    else:
      66
  else:
    if (vec.len(args) == 3) || (vec.len(args) == 4):
      let before: Vec[U8] = vec.new()
      let after: Vec[U8] = vec.new()
      if io.read_file(vec.get(args, 1), @before) && io.read_file(vec.get(args, 2), @after):
        let source_before: Bytes = bytes.freeze(^before)
        let source_after: Bytes = bytes.freeze(^after)
        if vec.len(args) == 4:
          let absent: I64 = cardinality_case(source_before, source_after, 0)
          let multiple: I64 = cardinality_case(source_before, source_after, 2)
          if (absent == 0) && (multiple == 0):
            damaged_cases(source_before, source_after, 0)
          else:
            absent + multiple
        else:
          compare_previous(source_before, source_after)
      else:
        66
    else:
      64
