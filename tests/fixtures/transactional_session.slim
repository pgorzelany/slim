fn check_plan_budget_fields(plan: memory.FunctionPlan) -> Bool effects[partial]:
  let values: I64 = vec.len(plan.values)
  let allocations: I64 = vec.len(plan.allocations)
  let destructions: I64 = vec.len(plan.destructions)
  let exact: retained.PlanBudget = retained.PlanBudget(eligible: true, functions: 1, values: values, allocations: allocations, destructions: destructions)
  let functions: retained.PlanBudget = retained.PlanBudget(eligible: true, functions: 0, values: values, allocations: allocations, destructions: destructions)
  let under_values: retained.PlanBudget = retained.PlanBudget(eligible: true, functions: 1, values: values - 1, allocations: allocations, destructions: destructions)
  let under_allocations: retained.PlanBudget = retained.PlanBudget(eligible: true, functions: 1, values: values, allocations: allocations - 1, destructions: destructions)
  let under_destructions: retained.PlanBudget = retained.PlanBudget(eligible: true, functions: 1, values: values, allocations: allocations, destructions: destructions - 1)
  retained.plan_fits(plan, exact) && ((!retained.plan_fits(plan, functions)) && ((!retained.plan_fits(plan, under_values)) && ((!retained.plan_fits(plan, under_allocations)) && (!retained.plan_fits(plan, under_destructions)))))

fn check_plan_budgets(snapshot: session.Snapshot) -> Bool effects[alloc, partial]:
  let totals: retained.PlanBudget = plan_totals(snapshot.prepared.plan.functions, 0, 0, 0, 0)
  let limit: I64 = maximum(maximum(totals.functions, totals.values), maximum(totals.allocations, totals.destructions))
  let empty: retained.Cache = retained.empty_cache()
  let prior: Vec[retained.StoredLink] = vec.new()
  copy_prior(snapshot.typing.nodes, 0, @prior)
  let mapping: retained.Update = retained.update(empty, snapshot.typing.index, prior)
  let exact: retained.Planned = retained.plan_checked(snapshot.prepared.source, snapshot.prepared.tokens, empty, snapshot.typing.index, mapping, limit)
  let under: retained.Planned = retained.plan_checked(snapshot.prepared.source, snapshot.prepared.tokens, empty, snapshot.typing.index, mapping, limit - 1)
  let kept: Bool = (vec.len(exact.cache.entries) == totals.functions) && ((vec.len(exact.cache.values) == totals.values) && ((vec.len(exact.cache.allocations) == totals.allocations) && (vec.len(exact.cache.destructions) == totals.destructions)))
  let declined: Bool = ((vec.len(under.cache.entries) == 0) && (vec.len(under.cache.slots) == 0)) && ((vec.len(under.cache.values) == 0) && ((vec.len(under.cache.allocations) == 0) && (vec.len(under.cache.destructions) == 0)))
  let same: Bool = same_plans(exact.plan.functions, snapshot.prepared.plan.functions, 0) && same_plans(under.plan.functions, snapshot.prepared.plan.functions, 0)
  let first: memory.FunctionPlan = vec.get(snapshot.prepared.plan.functions, 0)
  (kept && declined) && (same && check_plan_budget_fields(first))

