  let empty: retained.Cache = retained.empty_cache()
  let prior: Vec[retained.StoredLink] = vec.new()
  copy_prior(snapshot.typing.nodes, 0, @prior)
  let mapping: retained.Update = retained.update(empty, snapshot.typing.index, prior)
  let exact: retained.Planned = retained.plan_checked(snapshot.prepared.source, snapshot.prepared.tokens, empty, snapshot.typing.index, mapping, limit)
