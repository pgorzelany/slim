fn range_fixture_bound(snapshot: session.Snapshot, mode: Bytes) -> Bool effects[partial]:
  if equal(mode, "range-depth-known") || equal(mode, "range-depth-unknown"):
    let declaration: retained.Declaration = vec.get(snapshot.typing.index.declarations, 0)
    let body: I64 = syntax.ast_function_body(snapshot.prepared.tokens, declaration.owner.first)
    let fact: ranges.Fact = vec.get(snapshot.prepared.range_view.facts, body)
    if equal(mode, "range-depth-known"):
      fact.lower_known && fact.upper_known
    else:
      (!fact.lower_known) && (!fact.upper_known)
  else:
    if equal(mode, "range-refinement-boundary"):
      let wanted: I64 = (vec.len(snapshot.typing.index.declarations) - 1) * 2
      let expected: I64 = if wanted < 64:
        wanted
      else:
        64
      (snapshot.prepared.range_view.refinements == expected) && same_bool(snapshot.prepared.range_view.refinements_truncated, wanted >= 64)
    else:
      if range_recurrence_mode(mode):
        vec.len(snapshot.prepared.range_view.recurrences) > 0
      else:
        if range_counted_mode(mode) || equal(mode, "range-counted-positive"):
          vec.len(snapshot.prepared.range_view.counted) > 0
        else:
