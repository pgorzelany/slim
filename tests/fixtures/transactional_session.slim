  let exact: retained.PlanBudget = retained.PlanBudget(eligible: true, functions: 1, values: values, allocations: allocations, destructions: destructions)
  let functions: retained.PlanBudget = retained.PlanBudget(eligible: true, functions: 0, values: values, allocations: allocations, destructions: destructions)
  let under_values: retained.PlanBudget = retained.PlanBudget(eligible: true, functions: 1, values: values - 1, allocations: allocations, destructions: destructions)
  let under_allocations: retained.PlanBudget = retained.PlanBudget(eligible: true, functions: 1, values: values, allocations: allocations - 1, destructions: destructions)
  let under_destructions: retained.PlanBudget = retained.PlanBudget(eligible: true, functions: 1, values: values, allocations: allocations, destructions: destructions - 1)
  retained.plan_fits(plan, exact) && ((!retained.plan_fits(plan, functions)) && ((!retained.plan_fits(plan, under_values)) && ((!retained.plan_fits(plan, under_allocations)) && (!retained.plan_fits(plan, under_destructions)))))

fn check_plan_budgets(snapshot: session.Snapshot) -> Bool effects[alloc, partial]:
  let totals: retained.PlanBudget = plan_totals(snapshot.prepared.plan.functions, 0, 0, 0, 0)
