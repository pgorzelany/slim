fn compare(path: Bytes, snapshot: session.Snapshot) -> I64 effects[alloc, io, partial]:
  let clean: project.PreparedProject = project.prepare_project_path(path)
  let kept: project.PreparedProject = snapshot.prepared
  let source: Bool = equal(kept.source, clean.source) && equal(kept.manifest_source, clean.manifest_source)
  let syntax: Bool = same_tokens(kept.tokens, clean.tokens, 0) && (same_tokens(kept.manifest_tokens, clean.manifest_tokens, 0) && same_origins(kept.origins, clean.origins, 0))
  let facts: Bool = same_facts(kept.facts, clean.facts, 0) && (same_numbers(kept.layouts, clean.layouts, 0) && same_issues(kept.issues, clean.issues, 0))
  let plans: Bool = same_plans(kept.plan.functions, clean.plan.functions, 0)
  let clean_ranges: ranges.View = ranges.analyze(clean.source, clean.tokens, clean.facts)
  let range_equal: Bool = kept.range_ready && same_ranges(kept.range_view, clean_ranges)
  let stored: session.Artifact = session.artifact(snapshot)
  let parses: Bool = same_module_parses(snapshot, 0) && same_parse_cache(snapshot.parsing, snapshot.prepared.source, snapshot.revision, 0)
  if (parses && range_equal) && ((kept.status == clean.status) && (source && (syntax && (facts && plans)))):
    if equal(stored.code, project.generate_prepared_project(clean)):
      0
    else:
      12
  else:
    11

