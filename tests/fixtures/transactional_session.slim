fn damage_plan_pools(state: @session.State, mode: Bytes) -> Void effects[alloc, partial]:
  let entries: Vec[retained.PlanEntry] = mem.replace(@state.good.typing.planning.entries, vec.new())
  if vec.len(entries) > 0:
    let entry: retained.PlanEntry = damaged_plan(vec.get(entries, 0), mode)
    vec.set(@entries, 0, entry)
  else:
    void
  let removed_entries: Vec[retained.PlanEntry] = mem.replace(@state.good.typing.planning.entries, entries)
  let values: Vec[retained.PlanValue] = mem.replace(@state.good.typing.planning.values, vec.new())
  damage_plan_values(@values, mode)
  if !equal(mode, "plan-values"):
    let removed: Vec[retained.PlanValue] = mem.replace(@state.good.typing.planning.values, values)
    void
  else:
    void
  let allocations: Vec[memory.AllocationPlan] = mem.replace(@state.good.typing.planning.allocations, vec.new())
  if equal(mode, "plan-allocation-node") && (vec.len(allocations) > 0):
    let row: memory.AllocationPlan = vec.get(allocations, 0)
    vec.set(@allocations, 0, memory.AllocationPlan(site: -1, region: row.region))
  else:
    void
  if !equal(mode, "plan-allocations"):
    let removed: Vec[memory.AllocationPlan] = mem.replace(@state.good.typing.planning.allocations, allocations)
    void
  else:
    void
  let destructions: Vec[memory.DestructionPlan] = mem.replace(@state.good.typing.planning.destructions, vec.new())
  if equal(mode, "plan-destruction-node") && (vec.len(destructions) > 0):
    let row: memory.DestructionPlan = vec.get(destructions, 0)
    vec.set(@destructions, 0, memory.DestructionPlan(region: row.region, end: -1, reverse: row.reverse))
  else:
    void
  if !equal(mode, "plan-destructions"):
    let removed: Vec[memory.DestructionPlan] = mem.replace(@state.good.typing.planning.destructions, destructions)
    void
  else:
    void

