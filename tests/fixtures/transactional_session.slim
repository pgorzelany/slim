  if vec.len(left) == vec.len(right):
    if at >= vec.len(left):
      true
    else:
      let a: ranges.Refinement = vec.get(left, at)
      let b: ranges.Refinement = vec.get(right, at)
      let flags: Bool = same_bool(a.fact.analyzed, b.fact.analyzed) && (same_bool(a.fact.lower_known, b.fact.lower_known) && (same_bool(a.fact.upper_known, b.fact.upper_known) && same_bool(a.fact.total, b.fact.total)))
      let values: Bool = (a.fact.lower == b.fact.lower) && (a.fact.upper == b.fact.upper)
      if flags && (values && ((a.declaration == b.declaration) && (a.parent == b.parent))):
        recur(left, right, at + 1)
      else:
        false
  else:
    false

