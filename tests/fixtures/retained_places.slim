  let stale_owner: identity.DeclarationId = identity.DeclarationId(file: stale_file, slot: owner.slot)
  let stale_place: retained.PlaceId = retained.PlaceId(node: identity.NodeId(declaration: stale_owner, ordinal: place.node.ordinal))
  let foreign_file: identity.FileId = identity.FileId(revision: owner.file.revision, slot: 1)
  let foreign_owner: identity.DeclarationId = identity.DeclarationId(file: foreign_file, slot: owner.slot)
  let foreign: retained.PlaceId = retained.PlaceId(node: identity.NodeId(declaration: foreign_owner, ordinal: place.node.ordinal))
