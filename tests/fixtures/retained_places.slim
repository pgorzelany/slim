fn print_result(result: retained.PlaceResult) -> Void effects[io]:
  match result:
    Invalid(reason):
      io.print_bytes("invalid ")
      io.println(reason)
    Unknown(reason):
      io.print_bytes("unknown ")
      io.println(reason)
    Bounded(budget):
      io.print_bytes("bounded ")
      io.print_i64(budget)
      io.println("")
    Exact(fact):
      io.print_bytes("exact ")
      io.print_i64(fact.place.node.ordinal)
      io.print_bytes(" ")
      io.print_i64(fact.root.node.ordinal)
      io.print_bytes(" ")
      io.print_i64(fact.declaration.ordinal)
      io.print_bytes(" ")
