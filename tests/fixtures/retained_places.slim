fn snapshot(source: Bytes, tokens: Vec[syntax.Token], cache: retained.Cache, declaration: retained.Declaration) -> query.Snapshot effects[partial]:
  let start: I64 = syntax.ast_node_start(tokens, declaration.owner.first)
  let end: I64 = syntax.ast_declaration_end(source, tokens, declaration.owner.first)
  let body: identity.Span = identity.Span(file: declaration.owner.declaration.file, start: start, end: end)
  let interface: identity.Span = identity.Span(file: declaration.owner.declaration.file, start: start, end: start + bytes.len(declaration.interface))
  query.Snapshot(unique: cache.valid, module: cache.index.module, kind: declaration.kind, name: declaration.name, source: source, view: declaration.owner, body: body, interface: interface)

