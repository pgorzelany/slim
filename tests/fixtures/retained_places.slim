  let empty: Vec[retained.Saved] = mem.replace(@cache.nodes, rows)
  let absent_type: Bool = unknown_reason(retained.place_fact(cache, place, 1000000), "missing-checked-type")
  let restored: Vec[retained.Saved] = mem.replace(@cache.nodes, vec.new())
