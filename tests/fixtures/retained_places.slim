      let discarded: Vec[retained.Saved] = mem.replace(@cache.nodes, rows)
      let unknown: Bool = unknown_reason(retained.place_fact(cache, place, 1000000), "missing-checked-binding")
      let restored: Vec[retained.Saved] = mem.replace(@cache.nodes, vec.new())
      vec.set(@restored, root, original)
      let prior: Vec[retained.Saved] = mem.replace(@cache.nodes, restored)
