module zzprobe

# Synthetic token boundary inputs; this probe prints actual production results.
fn tag(row: I64) -> I64 effects[partial]:
  if row < 705:
    (row / 141 - 2) * 1000 + row % 141
  else:
    if row == 705:
      -9223372036854775808
    else:
      if row == 706:
        9223372036854775807
      else:
        -1

fn rows(tokens: @Vec[syntax.Token], targets: Vec[Bytes], row: I64, output: @Vec[U8]) -> Void effects[alloc, partial]:
  if row >= 116820:
    void
  else:
    let variant: I64 = row % 5
    let start: I64 = if variant == 1:
      1
    else:
      if variant == 3:
        7
      else:
        0
    let end: I64 = if variant == 0:
      7
    else:
      if variant == 1:
        4
      else:
        if variant == 4:
          1
        else:
          0
    let token: syntax.Token = syntax.Token(kind: 2, tag: tag(row / 165), start: start, end: end, link: -1, next: 1)
    vec.set(@tokens, 0, token)
    let target: Bytes = vec.get(targets, (row / 5) % 33)
    let value: Bool = syntax.ast_node_text_is("i64.add", tokens, 0, target)
    let byte: U8 = if value:
      i64.to_u8(49)
    else:
      i64.to_u8(48)
    vec.push(@output, byte)
    recur(@tokens, targets, row + 1, @output)

fn missing(tokens: Vec[syntax.Token], targets: Vec[Bytes], row: I64, output: @Vec[U8]) -> Void effects[alloc, partial]:
  if row >= 132:
    void
  else:
    let index: I64 = if row / 33 == 0:
      -9223372036854775808
    else:
      if row / 33 == 1:
        -1
      else:
        if row / 33 == 2:
          1
        else:
          9223372036854775807
    let value: Bool = syntax.ast_node_text_is("i64.add", tokens, index, vec.get(targets, row % 33))
    let byte: U8 = if value:
      i64.to_u8(49)
    else:
      i64.to_u8(48)
    vec.push(@output, byte)
    recur(tokens, targets, row + 1, @output)

fn main(args: Vec[Bytes]) -> I64 effects[alloc, io, partial]:
  let tokens: Vec[syntax.Token] = vec.new()
  vec.push(@tokens, syntax.Token(kind: 2, tag: 31, start: 0, end: 0, link: -1, next: 1))
  if vec.len(args) > 1:
    let arithmetic: Bool = bytes.len(vec.get(args, 1)) == 8
    let start: I64 = if arithmetic:
      -9223372036854775808
    else:
      -1
    let end: I64 = if arithmetic:
      9223372036854775807
    else:
      6
    vec.set(@tokens, 0, syntax.Token(kind: 2, tag: 31, start: start, end: end, link: -1, next: 1))
    let value: Bool = syntax.ast_node_text_is("i64.add", tokens, 0, "i64.add")
    if value:
      0
    else:
      1
