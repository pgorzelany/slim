fn compare(path: Bytes, attempt: project.ProjectAttempt) -> I64 effects[alloc, io, partial]:
  let clean: project.PreparedProject = project.prepare_project_path(path)
  let kept: project.PreparedProject = attempt.prepared
  let source: Bool = equal(kept.source, clean.source) && equal(kept.manifest_source, clean.manifest_source)
  let syntax: Bool = same_tokens(kept.tokens, clean.tokens, 0) && (same_tokens(kept.manifest_tokens, clean.manifest_tokens, 0) && same_origins(kept.origins, clean.origins, 0))
  let facts: Bool = same_facts(kept.facts, clean.facts, 0) && (same_numbers(kept.layouts, clean.layouts, 0) && same_issues(kept.issues, clean.issues, 0))
  let plans: Bool = same_plans(kept.plan.functions, clean.plan.functions, 0)
  if (kept.status == clean.status) && (source && (syntax && (facts && plans))):
    if clean.status == 0:
      let left: Bytes = project.generate_prepared_project(kept)
      let right: Bytes = project.generate_prepared_project(clean)
      if equal(left, right):
        0
      else:
        12
    else:
      if attempt.cache.valid:
        13
      else:
        0
  else:
    11

fn print_work(attempt: project.ProjectAttempt) -> I64 effects[io]:
  io.print_i64(attempt.work.executed)
  io.print_bytes(" ")
  io.print_i64(attempt.work.reused)
  io.print_bytes(" ")
  io.print_i64(attempt.work.imported)
  io.println("")
  0

fn run(before: Bytes, after: Bytes, mode: Bytes) -> I64 effects[alloc, io, partial]:
  let empty: retained.Cache = retained.empty_cache()
  let initial: project.ProjectAttempt = project.prepare_project_retained(before, empty, identity.Revision(epoch: 1, serial: 1), 1000000)
  if initial.prepared.status == 0:
    let compared: I64 = compare(before, initial)
    if compared == 0:
      let serial: I64 = if equal(mode, "stale"):
        1
      else:
        2
      let limit: I64 = if equal(mode, "capacity"):
        0
      else:
        1000000
      let updated: project.ProjectAttempt = project.prepare_project_retained(after, initial.cache, identity.Revision(epoch: 1, serial: serial), limit)
      if equal(mode, "recover"):
        if (updated.prepared.status > 0) && (!updated.cache.valid):
          let recovered: project.ProjectAttempt = project.prepare_project_retained(before, initial.cache, identity.Revision(epoch: 1, serial: 3), 1000000)
          let same: I64 = compare(before, recovered)
          if (same == 0) && (recovered.cache.valid && (recovered.work.executed == 0)):
            print_work(recovered)
          else:
            15
        else:
          16
      else:
        if equal(mode, "check"):
          if (updated.prepared.status > 0) && updated.cache.valid:
            17
          else:
            updated.prepared.status
        else:
          let final: I64 = compare(after, updated)
          let invalid_history: Bool = (equal(mode, "stale") || equal(mode, "capacity")) && updated.cache.valid
          if (final == 0) && (!invalid_history):
            if equal(mode, "emit"):
              if updated.prepared.status == 0:
                let generated: Bytes = project.generate_prepared_project(updated.prepared)
                io.print_bytes(generated)
                0
              else:
                updated.prepared.status
            else:
              print_work(updated)
          else:
            18
    else:
      compared
  else:
    initial.prepared.status

fn main(args: Vec[Bytes]) -> I64 effects[alloc, io, partial]:
  if vec.len(args) == 4:
    run(vec.get(args, 1), vec.get(args, 2), vec.get(args, 3))
  else:
