fn check_boundaries(source: Bytes, cache: retained.Cache) -> I64 effects[alloc, io, partial]:
  let stale: I64 = boundary(source, cache, identity.Revision(epoch: 1, serial: 1), false, false)
  let reset: I64 = boundary(source, cache, identity.Revision(epoch: 2, serial: 1), false, true)
  let recovery: I64 = boundary(source, cache, identity.Revision(epoch: 1, serial: 3), true, true)
  let exact: I64 = capacity_boundary(source, cache, 0, -1)
  let below: I64 = capacity_boundary(source, cache, -1, -1)
  let zero: I64 = capacity_boundary(source, cache, 0, 0)
  let above: I64 = capacity_boundary(source, cache, 0, 1000001)
  let missing_nodes: I64 = missing_metadata(source, cache, false)
  let missing_names: I64 = missing_metadata(source, cache, true)
  ((((stale + reset) + recovery) + (exact + below)) + (zero + above)) + (missing_nodes + missing_names)

