{
  "name": "slim-language-site",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal documentation site for the SLIM programming language.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "generate": "node scripts/generate-content.mjs",
    "predev": "npm run generate",
    "dev": "next dev",
    "prebuild": "npm run generate",
    "build": "next build",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern generated"
  },
  "dependencies": {
    "marked": "16.4.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
