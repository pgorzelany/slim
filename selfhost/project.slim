fn load_project_modules(manifest_path: Bytes manifest_source: Bytes inout manifest_tokens: Vec[syntax/Token] cursor: I64 inout module_tokens: Vec[syntax/Token] inout loaded: Vec[LoadedModule]) -> I64 effects[alloc io partial]:
  let kind: I64 = syntax/ast_node_kind(manifest_tokens cursor)
