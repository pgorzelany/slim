fn append_project_tokens(manifest_source: Bytes inout manifest_tokens: Vec[syntax/Token] module_name: I64 module_source: Bytes inout module_tokens: Vec[syntax/Token] module_items: I64 entry: Bool module_index: I64 index: I64 end: I64 inout output: Vec[U8] inout flat_tokens: Vec[syntax/Token] inout origins: Vec[Origin]) -> Unit effects[alloc partial]:
  let done: Bool = i64.ge(index end)
  match done:
    true:
      unit
    false:
      let kind: I64 = syntax/ast_node_kind(module_tokens index)
      let tag: I64 = syntax/ast_node_tag(module_tokens index)
      let flat_start: I64 = vec.len(output)
      let atom: Bool = i64.eq(kind 2)
      let emitted: Unit = match atom:
        true:
          append_project_atom(manifest_source manifest_tokens module_name module_source module_tokens module_items entry index output)
        false:
          let string_value: Bool = i64.eq(kind 3)
          match string_value:
            true:
              text/append_token(module_source module_tokens index output)
            false:
              unit
      let flat_end: I64 = vec.len(output)
      let copied: Unit = push_flat_token(kind tag flat_start flat_end flat_tokens)
      let start: I64 = syntax/ast_node_start(module_tokens index)
      let finish: I64 = syntax/ast_node_end(module_tokens index)
      let recorded: Unit = append_origin(module_index start finish origins)
      let next: I64 = i64.add(index 1)
      recur(manifest_source manifest_tokens module_name module_source module_tokens module_items entry module_index next end output flat_tokens origins)

fn append_loaded_project_modules(manifest_source: Bytes inout manifest_tokens: Vec[syntax/Token] entry_name: I64 inout module_tokens: Vec[syntax/Token] inout loaded: Vec[LoadedModule] index: I64 inout output: Vec[U8] inout flat_tokens: Vec[syntax/Token] inout origins: Vec[Origin]) -> Unit effects[alloc partial]:
