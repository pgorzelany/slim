  let token_end: I64 = syntax/ast_node_end(tokens path)
  let start: I64 = i64.add(token_start 1)
  let end: I64 = i64.sub(token_end 1)
  let length: I64 = i64.sub(end start)
  let enough: Bool = i64.ge(length 5)
  match enough:
    false:
      true
    true:
      let suffix_start: I64 = i64.sub(end 5)
      let suffix: Bool = syntax/span_equal(source suffix_start end ".slim")
      match suffix:
        false:
          true
        true:
          let segments: Bool = path_segments_valid(source start end start)
          bool.not(segments)

