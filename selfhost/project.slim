      count
    false:
      let module: LoadedModule = vec.get(loaded index)
      let manifest: I64 = get(module manifest)
      let name: I64 = get(module name)
      let module_name: Bytes = token_bytes(manifest_source manifest_tokens name)
      let imports: I64 = i64.add(manifest 4)
      let exports: I64 = syntax/ast_next(manifest_tokens imports)
      let first_export: I64 = i64.add(exports 2)
      let source: Bytes = get(module source)
      let root: I64 = get(module root)
      let module_items: I64 = syntax/ast_module_items(root)
      let reported: I64 = report_export_interfaces(manifest_source manifest_tokens first_export module_name source module_tokens module_items first_export 0)
      let next: I64 = i64.add(index 1)
      let total: I64 = i64.add(count reported)
      recur(manifest_source manifest_tokens module_tokens loaded next total)

fn report_private_type_leaks(manifest_source: Bytes inout manifest_tokens: Vec[syntax/Token] inout module_tokens: Vec[syntax/Token] inout loaded: Vec[LoadedModule]) -> I64 effects[alloc io partial]:
  let errors: I64 = report_private_type_leaks_from(manifest_source manifest_tokens module_tokens loaded 0 0)
  let invalid: Bool = i64.gt(errors 0)
  match invalid:
    true:
      1
    false:
      0
