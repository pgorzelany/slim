  match done:
    true:
      0
    false:
      let name: I64 = i64.add(cursor 2)
      let path: I64 = i64.add(cursor 3)
      let module_path: Bytes = project_module_path(manifest_path manifest_source manifest_tokens path)
      let source_bytes: Vec[U8] = vec.new()
      let source_read: Bool = io.read-file(module_path source_bytes)
      match source_read:
        false:
          let start: I64 = syntax/ast_node_start(manifest_tokens path)
          let end: I64 = syntax/ast_node_end(manifest_tokens path)
          let module_name: Bytes = token_bytes(manifest_source manifest_tokens name)
          report_project_diagnostic("E0409" module_name start end)
        true:
          let source: Bytes = bytes.freeze(source_bytes)
          let root: I64 = vec.len(module_tokens)
          let parsed: syntax/ProgramParse = syntax/parse_program_result(source module_tokens)
          let end: I64 = vec.len(module_tokens)
          let shaped: Bool = validate/module_shape_valid_from(source module_tokens root end)
          let valid: Bool = bool.and(get(parsed valid) shaped)
          match valid:
            false:
              let module_name: Bytes = token_bytes(manifest_source manifest_tokens name)
              match get(parsed valid):
                false:
                  report_project_diagnostic(get(parsed code) module_name get(parsed start) get(parsed end))
                true:
                  let source_end: I64 = bytes.len(source)
                  report_project_diagnostic("E0102" module_name 0 source_end)
            true:
              let linked: Unit = syntax/link_declaration_names_from(source module_tokens root)
              let module: LoadedModule = make LoadedModule(manifest = cursor name = name path = path source = source root = root)
              let pushed: Unit = vec.push(loaded module)
              let next: I64 = syntax/ast_next(manifest_tokens cursor)
              recur(manifest_path manifest_source manifest_tokens next module_tokens loaded)

