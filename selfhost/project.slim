fn cross_span_chars_equal(left: Bytes, left_start: I64, right: Bytes, right_start: I64, index: I64, length: I64) -> Bool effects[partial]:
  let done: Bool = index == length
  if done:
    true
  else:
    let left_index: I64 = left_start + index
    let right_index: I64 = right_start + index
    let left_byte: U8 = bytes.get(left, left_index)
    let right_byte: U8 = bytes.get(right, right_index)
    let left_code: I64 = u8.to_i64(left_byte)
    let right_code: I64 = u8.to_i64(right_byte)
    let same: Bool = left_code == right_code
    if same:
      let next: I64 = index + 1
      recur(left, left_start, right, right_start, next, length)
    else:
      false

fn cross_spans_equal(left: Bytes, left_start: I64, left_end: I64, right: Bytes, right_start: I64, right_end: I64) -> Bool effects[partial]:
  let left_length: I64 = left_end - left_start
  let right_length: I64 = right_end - right_start
  let same_length: Bool = left_length == right_length
  if same_length:
    cross_span_chars_equal(left, left_start, right, right_start, 0, left_length)
  else:
    false

fn last_path_slash(path: Bytes, index: I64, length: I64, last: I64) -> I64 effects[partial]:
  let done: Bool = index >= length
  if done:
    last
  else:
    let byte: U8 = bytes.get(path, index)
    let code: I64 = u8.to_i64(byte)
    let slash: Bool = code == 47
    let next_last: I64 = if slash:
      index + 1
    else:
      last
    let next: I64 = index + 1
    recur(path, next, length, next_last)

fn project_module_path(manifest_path: Bytes, manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], path_token: I64) -> Bytes effects[alloc, partial]:
  let output: Vec[U8] = vec.new()
  let manifest_length: I64 = bytes.len(manifest_path)
  let prefix_end: I64 = last_path_slash(manifest_path, 0, manifest_length, 0)
  text.append_span(manifest_path, 0, prefix_end, @output)
  let token_start_index: I64 = syntax.ast_node_start(manifest_tokens, path_token)
  let content_start: I64 = token_start_index + 1
  let token_end_index: I64 = syntax.ast_node_end(manifest_tokens, path_token)
  let content_end: I64 = token_end_index - 1
  text.append_span(manifest_source, content_start, content_end, @output)
  bytes.freeze(^output)

fn append_namespace_segment(source: Bytes, index: I64, end: I64, output: @Vec[U8]) -> Void effects[alloc, partial]:
  if index >= end:
    void
  else:
    let byte: U8 = bytes.get(source, index)
    let code: I64 = u8.to_i64(byte)
    if code == 95:
      text.append_text(@output, "_0")
    else:
      if code == 46:
        text.append_text(@output, "_1")
      else:
        vec.push(@output, byte)
    recur(source, index + 1, end, @output)

fn append_namespace_pair(module_source: Bytes, module_start: I64, module_end: I64, name_source: Bytes, name_start: I64, name_end: I64, output: @Vec[U8]) -> Void effects[alloc, partial]:
  text.append_text(@output, "p")
  append_namespace_segment(module_source, module_start, module_end, @output)
  text.append_text(@output, "__")
  append_namespace_segment(name_source, name_start, name_end, @output)

fn append_absent_namespace(source: Bytes, start: I64, end: I64, output: @Vec[U8]) -> Void effects[alloc, partial]:
  text.append_text(@output, "u")
  append_namespace_segment(source, start, end, @output)

fn initialize_namespace_roles(count: I64, roles: @Vec[I64]) -> Void effects[alloc, partial]:
  if vec.len(roles) >= count:
    void
  else:
    vec.push(@roles, 0)
    recur(count, @roles)

fn mark_namespace_type(source: Bytes, tokens: Vec[syntax.Token], node: I64, root: I64, roles: @Vec[I64]) -> Void effects[partial]:
  if syntax.ast_node_is_list(tokens, node):
    let composite: Bool = syntax.ast_type_is_vec(source, tokens, node) || (syntax.ast_type_is_arena(source, tokens, node) || syntax.ast_type_is_id(source, tokens, node))
    if composite:
      recur(source, tokens, syntax.ast_type_argument(node), root, @roles)
    else:
      void
  else:
    if syntax.ast_node_is_name(tokens, node) && (syntax.scalar_type_kind(source, tokens, node) < 0):
      vec.set(@roles, node - root, 3)
    else:
      void

fn mark_namespace_nominal(tokens: Vec[syntax.Token], node: I64, root: I64, roles: @Vec[I64]) -> Void effects[partial]:
  if syntax.ast_node_is_name(tokens, node):
    vec.set(@roles, node - root, 4)
  else:
    void

fn mark_namespace_binding_types(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, root: I64, roles: @Vec[I64]) -> Void effects[partial]:
  if syntax.ast_list_done(tokens, cursor):
    void
  else:
    mark_namespace_type(source, tokens, syntax.ast_binding_type(source, tokens, cursor), root, @roles)
    recur(source, tokens, syntax.ast_next(tokens, cursor), root, @roles)

fn mark_namespace_payload_types(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, root: I64, roles: @Vec[I64]) -> Void effects[partial]:
  if syntax.ast_list_done(tokens, cursor):
    void
  else:
    mark_namespace_type(source, tokens, cursor, root, @roles)
    recur(source, tokens, syntax.ast_next(tokens, cursor), root, @roles)

fn mark_namespace_field_types(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, root: I64, roles: @Vec[I64]) -> Void effects[partial]:
  if syntax.ast_list_done(tokens, cursor):
    void
  else:
    mark_namespace_type(source, tokens, syntax.ast_member_value(cursor), root, @roles)
    recur(source, tokens, syntax.ast_next(tokens, cursor), root, @roles)

fn mark_namespace_case_types(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, root: I64, roles: @Vec[I64]) -> Void effects[partial]:
  if syntax.ast_list_done(tokens, cursor):
    void
  else:
    mark_namespace_payload_types(source, tokens, syntax.ast_member_value(cursor), root, @roles)
    recur(source, tokens, syntax.ast_next(tokens, cursor), root, @roles)

fn mark_namespace_form(source: Bytes, tokens: Vec[syntax.Token], node: I64, root: I64, roles: @Vec[I64]) -> Void effects[partial]:
  if syntax.ast_item_is_function(source, tokens, node):
    vec.set(@roles, syntax.ast_item_name(node) - root, 2)
    let params: I64 = syntax.ast_function_parameters(node)
    mark_namespace_binding_types(source, tokens, syntax.ast_parameters_first(params), root, @roles)
    mark_namespace_type(source, tokens, syntax.ast_function_return_type(tokens, node), root, @roles)
  else:
    if syntax.ast_item_is_record(source, tokens, node):
      vec.set(@roles, syntax.ast_item_name(node) - root, 2)
      mark_namespace_field_types(source, tokens, syntax.ast_data_members_first(node), root, @roles)
    else:
      if syntax.ast_item_is_variant(source, tokens, node):
        vec.set(@roles, syntax.ast_item_name(node) - root, 2)
        mark_namespace_case_types(source, tokens, syntax.ast_data_members_first(node), root, @roles)
      else:
        if syntax.ast_expression_is_let(source, tokens, node):
          mark_namespace_type(source, tokens, syntax.ast_let_type(node), root, @roles)
        else:
          if syntax.ast_expression_is_call(source, tokens, node):
            let callee: I64 = syntax.ast_call_callee(node)
            if !typing.builtin_known(source, tokens, callee):
              vec.set(@roles, callee - root, 1)
            else:
              void
          else:
            if syntax.ast_expression_is_make(source, tokens, node):
              mark_namespace_nominal(tokens, syntax.ast_make_type(node), root, @roles)
            else:
              if syntax.ast_expression_is_case(source, tokens, node):
                mark_namespace_nominal(tokens, syntax.ast_case_type(node), root, @roles)
              else:
                void

fn mark_namespace_roles(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, end: I64, root: I64, roles: @Vec[I64]) -> Void effects[partial]:
  if cursor >= end:
    void
  else:
    let form: Bool = syntax.ast_node_is_list(tokens, cursor)
    let tagged: Bool = syntax.ast_node_tag(tokens, cursor) > 0
    if form && tagged:
      mark_namespace_form(source, tokens, cursor, root, @roles)
    else:
      void
    recur(source, tokens, syntax.ast_node_after(cursor), end, root, @roles)

fn project_namespace_roles(source: Bytes, tokens: Vec[syntax.Token], root: I64) -> Vec[I64] effects[alloc, partial]:
  let roles: Vec[I64] = vec.new()
  let end: I64 = syntax.ast_next(tokens, root)
  initialize_namespace_roles(end - root, @roles)
  mark_namespace_roles(source, tokens, syntax.ast_module_items(root), end, root, @roles)
  roles

fn append_project_atom(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], module_name: I64, entry_name: I64, module_source: Bytes, module_tokens: Vec[syntax.Token], root: I64, entry: Bool, roles: Vec[I64], declarations: I64, namespace: NamespaceView, atom: I64, output: @Vec[U8]) -> Void effects[alloc, partial]:
  let start: I64 = syntax.ast_node_start(module_tokens, atom)
  let end: I64 = syntax.ast_node_end(module_tokens, atom)
  let synthetic: Bool = start == end
  if synthetic:
    let parent: I64 = atom - 1
    let tag: I64 = syntax.ast_node_tag(module_tokens, parent)
    if tag == 10:
      text.append_text(@output, "call")
    else:
      text.append_text(@output, "effects")
  else:
    let role: I64 = vec.get(roles, atom - root)
    if role == 0:
      text.append_token(module_source, module_tokens, atom, @output)
    else:
      let dot: I64 = if !(role == 2):
        find_span_dot(module_source, start, end)
      else:
        -1
      if dot >= 0:
        let name_start: I64 = dot + 1
        let entry_start: I64 = syntax.ast_node_start(manifest_tokens, entry_name)
        let entry_end: I64 = syntax.ast_node_end(manifest_tokens, entry_name)
        let target_entry: Bool = cross_spans_equal(manifest_source, entry_start, entry_end, module_source, start, dot)
        let main: Bool = syntax.span_equal(module_source, name_start, end, "main")
        if target_entry && main:
          text.append_text(@output, "main")
        else:
          append_namespace_pair(module_source, start, dot, module_source, name_start, end, @output)
      else:
        let main: Bool = syntax.ast_node_text_is(module_source, module_tokens, atom, "main")
        if entry && main:
          text.append_text(@output, "main")
        else:
          let declaration: I64 = if role == 2:
            atom
          else:
            namespace_lookup(module_source, start, end, declarations, namespace)
          if declaration < 0:
            append_absent_namespace(module_source, start, end, @output)
          else:
            let module_start: I64 = syntax.ast_node_start(manifest_tokens, module_name)
            let module_end: I64 = syntax.ast_node_end(manifest_tokens, module_name)
            append_namespace_pair(manifest_source, module_start, module_end, module_source, start, end, @output)

struct Origin:
  module: I64
  start: I64
  end: I64

struct PreparedProject:
  status: I64
  source: Bytes
  tokens: Vec[syntax.Token]
  origins: Vec[Origin]
  manifest_source: Bytes
  manifest_tokens: Vec[syntax.Token]
  facts: Vec[typing.Fact]
  layouts: Vec[I64]
  issues: Vec[typing.Issue]
  plan: memory.Plan
  range_ready: Bool
  range_view: ranges.View

struct ModuleInput:
  read: Bool
  source: Bytes

struct ProjectInput:
  status: I64
  manifest_source: Bytes
  manifest_tokens: Vec[syntax.Token]
  modules: Vec[ModuleInput]

struct ProjectAttempt:
  transition: retained.Update
  canonical_nodes: I64
  prepared: PreparedProject
  cache: retained.Cache
  work: retained.Work

fn append_origin(module: I64, start: I64, end: I64, origins: @Vec[Origin]) -> Void effects[alloc]:
  let origin: Origin = Origin(module: module, start: start, end: end)
  vec.push(@origins, origin)

fn push_flat_token(kind: I64, tag: I64, start: I64, end: I64, tokens: @Vec[syntax.Token]) -> Void effects[alloc]:
  let token: syntax.Token = syntax.Token(kind: kind, tag: tag, start: start, end: end, link: -1, next: -1)
  vec.push(@tokens, token)

fn append_project_tokens(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], module_name: I64, module_source: Bytes, module_tokens: Vec[syntax.Token], module_items: I64, root: I64, entry_name: I64, entry: Bool, roles: Vec[I64], declarations: I64, namespace: NamespaceView, module_index: I64, index: I64, end: I64, output: @Vec[U8], flat_tokens: @Vec[syntax.Token], origins: @Vec[Origin]) -> Void effects[alloc, partial]:
  let done: Bool = index >= end
  if done:
    void
  else:
    let kind: I64 = syntax.ast_node_kind(module_tokens, index)
    let tag: I64 = syntax.ast_node_encoded_tag(module_tokens, index)
    let flat_start: I64 = vec.len(output)
    let atom: Bool = kind == 2
    if atom:
      append_project_atom(manifest_source, manifest_tokens, module_name, entry_name, module_source, module_tokens, root, entry, roles, declarations, namespace, index, @output)
    else:
      let string_value: Bool = kind == 3
      if string_value:
        text.append_token(module_source, module_tokens, index, @output)
      else:
        void
    let flat_end: I64 = vec.len(output)
    push_flat_token(kind, tag, flat_start, flat_end, @flat_tokens)
    let start: I64 = syntax.ast_node_start(module_tokens, index)
    let finish: I64 = syntax.ast_node_end(module_tokens, index)
    append_origin(module_index, start, finish, @origins)
    let next: I64 = index + 1
    recur(manifest_source, manifest_tokens, module_name, module_source, module_tokens, module_items, root, entry_name, entry, roles, declarations, namespace, module_index, next, end, @output, @flat_tokens, @origins)

fn append_loaded_project_modules(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], entry_name: I64, module_tokens: Vec[syntax.Token], loaded: Vec[LoadedModule], namespace: NamespaceView, index: I64, output: @Vec[U8], flat_tokens: @Vec[syntax.Token], origins: @Vec[Origin]) -> Void effects[alloc, partial]:
  let length: I64 = vec.len(loaded)
  let done: Bool = index >= length
  if done:
    void
  else:
    let module: LoadedModule = vec.get(loaded, index)
    let module_name: I64 = module.name
    let module_source: Bytes = module.source
    let root: I64 = module.root
    let module_items: I64 = syntax.ast_module_items(root)
    let next_form: I64 = syntax.ast_next(module_tokens, root)
    let end: I64 = next_form - 1
    let module_name_start: I64 = syntax.ast_node_start(manifest_tokens, module_name)
    let module_name_end: I64 = syntax.ast_node_end(manifest_tokens, module_name)
    let entry_name_start: I64 = syntax.ast_node_start(manifest_tokens, entry_name)
    let entry_name_end: I64 = syntax.ast_node_end(manifest_tokens, entry_name)
    let entry: Bool = syntax.spans_equal(manifest_source, module_name_start, module_name_end, entry_name_start, entry_name_end)
    let metadata: NamespaceModule = vec.get(namespace.modules, index)
    let roles: Vec[I64] = metadata.roles
    append_project_tokens(manifest_source, manifest_tokens, module_name, module_source, module_tokens, module_items, root, entry_name, entry, roles, metadata.declarations, namespace, index, module_items, end, @output, @flat_tokens, @origins)
    let next: I64 = index + 1
    recur(manifest_source, manifest_tokens, entry_name, module_tokens, loaded, namespace, next, @output, @flat_tokens, @origins)

fn flatten_loaded_source(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], entry_name: I64, module_tokens: Vec[syntax.Token], loaded: Vec[LoadedModule], namespace: NamespaceView, origins: @Vec[Origin]) -> Bytes effects[alloc, partial]:
  let atom_source: Vec[U8] = vec.new()
  let flat_tokens: Vec[syntax.Token] = vec.new()
  push_flat_token(0, 1, 0, 0, @flat_tokens)
  append_origin(-1, 0, 0, @origins)
  push_flat_token(2, 0, 0, 0, @flat_tokens)
  append_origin(-1, 0, 0, @origins)
  let name_start: I64 = vec.len(atom_source)
  text.append_text(@atom_source, "project")
  let name_end: I64 = vec.len(atom_source)
  push_flat_token(2, 0, name_start, name_end, @flat_tokens)
  append_origin(-1, 0, 0, @origins)
  append_loaded_project_modules(manifest_source, manifest_tokens, entry_name, module_tokens, loaded, namespace, 0, @atom_source, @flat_tokens, @origins)
  let close_position: I64 = vec.len(atom_source)
  push_flat_token(1, 0, close_position, close_position, @flat_tokens)
  append_origin(-1, 0, 0, @origins)
  let atoms: Bytes = bytes.freeze(^atom_source)
  syntax.index_ast_boundaries(@flat_tokens)
  let output: Vec[U8] = vec.new()
  format.emit_module(atoms, flat_tokens, @output)
  bytes.freeze(^output)

fn flatten_loaded_project(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], entry_name: I64, module_tokens: Vec[syntax.Token], loaded: Vec[LoadedModule], namespace: NamespaceView, tokens: @Vec[syntax.Token], origins: @Vec[Origin]) -> Bytes effects[alloc, partial]:
  let source: Bytes = flatten_loaded_source(manifest_source, manifest_tokens, entry_name, module_tokens, loaded, namespace, @origins)
  let parsed: Bool = syntax.parse_program(source, @tokens)
  source

fn path_is_project(path: Bytes) -> Bool effects[alloc, io, partial]:
  let source_bytes: Vec[U8] = vec.new()
  let source_read: Bool = io.read_file(path, @source_bytes)
  let source: Bytes = bytes.freeze(^source_bytes)
  let length: I64 = bytes.len(source)
  let available: Bool = length > 0
  let legacy: Bool = if available:
    let first: U8 = bytes.get(source, 0)
    u8.to_i64(first) == 40
  else:
    false
  if legacy:
    let tokens: Vec[syntax.Token] = vec.new()
    syntax.lex_data(source, 0, @tokens)
    syntax.ast_node_text_is(source, tokens, 1, "project")
  else:
    false

fn generate_prepared_project(prepared: PreparedProject) -> Bytes effects[alloc, partial]:
  let source: Bytes = prepared.source
  let tokens: Vec[syntax.Token] = prepared.tokens
  let facts: Vec[typing.Fact] = prepared.facts
  let layouts: Vec[I64] = prepared.layouts
  let plan: memory.Plan = prepared.plan
  let output: Vec[U8] = vec.new()
  if prepared.range_ready:
    codegen.emit_program_view(source, tokens, facts, plan, layouts, prepared.range_view, @output)
  else:
    codegen.emit_program(source, tokens, facts, plan, layouts, @output)
  bytes.freeze(^output)

fn compile_project_path_jobs(path: Bytes, jobs: I64) -> I64 effects[alloc, io, partial]:
  let prepared: PreparedProject = prepare_project_path(path)
  let status: I64 = prepared.status
  let invalid: Bool = status > 0
  if invalid:
    status
  else:
    let manifest_source: Bytes = prepared.manifest_source
    let manifest_tokens: Vec[syntax.Token] = prepared.manifest_tokens
    let schedule: scheduler.Schedule = scheduler.plan(manifest_source, manifest_tokens, jobs)
    let schedule_valid: Bool = schedule.valid
    if schedule_valid:
      let generated: Bytes = generate_prepared_project(prepared)
      io.print_bytes(generated)
      0
    else:
      70

fn compile_project_path(path: Bytes) -> I64 effects[alloc, io, partial]:
  compile_project_path_jobs(path, 1)

fn token_bytes(source: Bytes, tokens: Vec[syntax.Token], index: I64) -> Bytes effects[alloc, partial]:
  let output: Vec[U8] = vec.new()
  let start: I64 = syntax.ast_node_start(tokens, index)
  let end: I64 = syntax.ast_node_end(tokens, index)
  text.append_span(source, start, end, @output)
  bytes.freeze(^output)

fn report_project_diagnostic(code: Bytes, module_name: Bytes, start: I64, end: I64) -> I64 effects[alloc, io, partial]:
  let output: Vec[U8] = vec.new()
  text.append_text(@output, code)
  text.append_text(@output, "@")
  text.append_text(@output, module_name)
  text.append_text(@output, "@")
  text.append_nonnegative_i64(start, @output)
  text.append_text(@output, ":")
  text.append_nonnegative_i64(end, @output)
  text.append_text(@output, "\n")
  let bytes: Bytes = bytes.freeze(^output)
  io.print_bytes(bytes)
  1

fn imports_has_name(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, name_start: I64, name_end: I64) -> Bool effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    false
  else:
    let candidate_start: I64 = syntax.ast_node_start(tokens, cursor)
    let candidate_end: I64 = syntax.ast_node_end(tokens, cursor)
    let same: Bool = syntax.spans_equal(source, candidate_start, candidate_end, name_start, name_end)
    if same:
      true
    else:
      let next: I64 = syntax.ast_node_after(cursor)
      recur(source, tokens, next, name_start, name_end)

fn find_manifest_module(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, name_start: I64, name_end: I64) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    -1
  else:
    let module_name: I64 = cursor + 2
    let candidate_start: I64 = syntax.ast_node_start(tokens, module_name)
    let candidate_end: I64 = syntax.ast_node_end(tokens, module_name)
    let same: Bool = syntax.spans_equal(source, candidate_start, candidate_end, name_start, name_end)
    if same:
      cursor
    else:
      let next: I64 = syntax.ast_next(tokens, cursor)
      recur(source, tokens, next, name_start, name_end)

fn manifest_span_admitted(source: Bytes, start: I64, end: I64) -> Bool:
  if start < 0:
    false
  else:
    if end < start:
      false
    else:
      end <= bytes.len(source)

fn manifest_preflight_imports(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, close: I64, visits: I64) -> I64 effects[partial]:
  let length: I64 = vec.len(tokens)
  if visits >= length:
    -1
  else:
    let next_visits: I64 = visits + 1
    if cursor < 0:
      -1
    else:
      if cursor > close:
        -1
      else:
        if cursor >= length:
          -1
        else:
          let token: syntax.Token = vec.get(tokens, cursor)
          if token.kind == 1:
            if cursor == close:
              next_visits
            else:
              -1
          else:
            if token.kind == 2:
              if manifest_span_admitted(source, token.start, token.end):
                if cursor < close:
                  recur(source, tokens, cursor + 1, close, next_visits)
                else:
                  -1
              else:
                -1
            else:
              -1

fn manifest_preflight_modules(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, outer_close: I64, visits: I64) -> I64 effects[partial]:
  let length: I64 = vec.len(tokens)
  if visits >= length:
    -1
  else:
    let next_visits: I64 = visits + 1
    if cursor < 0:
      -1
    else:
      if cursor >= length:
        -1
      else:
        let module: syntax.Token = vec.get(tokens, cursor)
        if module.kind == 1:
          if cursor == outer_close:
            next_visits
          else:
            -1
        else:
          if !(module.kind == 0):
            -1
          else:
            if (module.next <= cursor) || (module.next > length):
              -1
            else:
              let distance: I64 = module.next - cursor
              if distance < 11:
                -1
              else:
                let module_close: I64 = module.next - 1
                let head: syntax.Token = vec.get(tokens, cursor + 1)
                let name: syntax.Token = vec.get(tokens, cursor + 2)
                let path: syntax.Token = vec.get(tokens, cursor + 3)
                if ((!(head.kind == 2)) || (!(name.kind == 2))) || (!(path.kind == 3)):
                  -1
                else:
                  let name_valid: Bool = manifest_span_admitted(source, name.start, name.end)
                  let path_valid: Bool = manifest_span_admitted(source, path.start, path.end)
                  if name_valid && path_valid:
                    let imports_cursor: I64 = cursor + 4
                    let imports: syntax.Token = vec.get(tokens, imports_cursor)
                    if !(imports.kind == 0):
                      -1
                    else:
                      if (imports.next <= imports_cursor) || (imports.next >= module_close):
                        -1
                      else:
                        let imports_distance: I64 = imports.next - imports_cursor
                        if imports_distance < 3:
                          -1
                        else:
                          let imports_head: syntax.Token = vec.get(tokens, imports_cursor + 1)
                          let imports_close: I64 = imports.next - 1
                          let imports_end: syntax.Token = vec.get(tokens, imports_close)
                          if (!(imports_head.kind == 2)) || (!(imports_end.kind == 1)):
                            -1
                          else:
                            let exports_cursor: I64 = imports.next
                            let exports: syntax.Token = vec.get(tokens, exports_cursor)
                            if !(exports.kind == 0):
                              -1
                            else:
                              if (exports.next <= exports_cursor) || (!(exports.next == module_close)):
                                -1
                              else:
                                let exports_distance: I64 = exports.next - exports_cursor
                                if exports_distance < 3:
                                  -1
                                else:
                                  let exports_head: syntax.Token = vec.get(tokens, exports_cursor + 1)
                                  let exports_end: syntax.Token = vec.get(tokens, exports.next - 1)
                                  let module_end: syntax.Token = vec.get(tokens, module_close)
                                  if ((!(exports_head.kind == 2)) || (!(exports_end.kind == 1))) || (!(module_end.kind == 1)):
                                    -1
                                  else:
                                    let after_imports: I64 = manifest_preflight_imports(source, tokens, imports_cursor + 2, imports_close, next_visits)
                                    if after_imports < 0:
                                      -1
                                    else:
                                      recur(source, tokens, module.next, outer_close, after_imports)
                  else:
                    -1

fn manifest_index_eligible(source: Bytes, tokens: Vec[syntax.Token], modules: I64) -> Bool effects[partial]:
  let length: I64 = vec.len(tokens)
  if length < 8:
    false
  else:
    if !(modules == 7):
      false
    else:
      let root: syntax.Token = vec.get(tokens, 0)
      let outer_close: I64 = length - 1
      let root_end: syntax.Token = vec.get(tokens, outer_close)
      let entry: syntax.Token = vec.get(tokens, 3)
      let entry_end: syntax.Token = vec.get(tokens, 6)
      if (((((root.kind == 0) && (root.next == length)) && (root_end.kind == 1)) && (entry.kind == 0)) && (entry.next == 7)) && (entry_end.kind == 1):
        manifest_preflight_modules(source, tokens, modules, outer_close, 0) >= 0
      else:
        false

fn index_manifest_paths(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, names: @Vec[syntax.NameNode], edges: @Vec[syntax.NameEdge]) -> I64 effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  if kind == 1:
    -1
  else:
    let path: I64 = cursor + 3
    let previous: I64 = syntax.insert_name_chars(source, syntax.ast_node_start(tokens, path), syntax.ast_node_end(tokens, path), path, 0, @names, @edges)
    if previous >= 0:
      path
    else:
      recur(source, tokens, syntax.ast_next(tokens, cursor), @names, @edges)

fn indexed_duplicate_path(source: Bytes, tokens: Vec[syntax.Token], modules: I64) -> I64 effects[alloc, partial]:
  let names: Vec[syntax.NameNode] = vec.new()
  let edges: Vec[syntax.NameEdge] = vec.new()
  let root: I64 = syntax.append_name_node(-1, @names)
  index_manifest_paths(source, tokens, modules, @names, @edges)

fn module_imports_name(source: Bytes, tokens: Vec[syntax.Token], modules: I64, module_name: I64, import_start: I64, import_end: I64) -> Bool effects[partial]:
  let name_start: I64 = syntax.ast_node_start(tokens, module_name)
  let name_end: I64 = syntax.ast_node_end(tokens, module_name)
  let module_form: I64 = find_manifest_module(source, tokens, modules, name_start, name_end)
  let found: Bool = module_form >= 0
  if found:
    let imports_form: I64 = module_form + 4
    let first_import: I64 = imports_form + 2
    imports_has_name(source, tokens, first_import, import_start, import_end)
  else:
    false

fn module_cycle_imports(source: Bytes, tokens: Vec[syntax.Token], modules: I64, module_name: I64, cursor: I64) -> Bool effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    false
  else:
    let import_start: I64 = syntax.ast_node_start(tokens, cursor)
    let import_end: I64 = syntax.ast_node_end(tokens, cursor)
    let reciprocal: Bool = module_imports_name(source, tokens, modules, cursor, import_start, import_end)
    let module_name_start: I64 = syntax.ast_node_start(tokens, module_name)
    let module_name_end: I64 = syntax.ast_node_end(tokens, module_name)
    let target_form: I64 = find_manifest_module(source, tokens, modules, import_start, import_end)
    let target_found: Bool = target_form >= 0
    let imports_source: Bool = if target_found:
      let target_imports: I64 = target_form + 4
      let first_target_import: I64 = target_imports + 2
      imports_has_name(source, tokens, first_target_import, module_name_start, module_name_end)
    else:
      false
    if imports_source:
      true
    else:
      let next: I64 = syntax.ast_node_after(cursor)
      recur(source, tokens, modules, module_name, next)

fn find_reciprocal_cycle(source: Bytes, tokens: Vec[syntax.Token], modules: I64, cursor: I64) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    -1
  else:
    let module_name: I64 = cursor + 2
    let imports_form: I64 = cursor + 4
    let first_import: I64 = imports_form + 2
    let cycle: Bool = module_cycle_imports(source, tokens, modules, module_name, first_import)
    if cycle:
      module_name
    else:
      let next: I64 = syntax.ast_next(tokens, cursor)
      recur(source, tokens, modules, next)

fn find_span_dot(source: Bytes, index: I64, end: I64) -> I64 effects[partial]:
  if index >= end:
    -1
  else:
    let previous: I64 = end - 1
    let code: I64 = u8.to_i64(bytes.get(source, previous))
    if code == 46:
      previous
    else:
      recur(source, index, previous)

fn exports_has_segment(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], cursor: I64, module_source: Bytes, segment_start: I64, segment_end: I64) -> Bool effects[partial]:
  let kind: I64 = syntax.ast_node_kind(manifest_tokens, cursor)
  let done: Bool = kind == 1
  if done:
    false
  else:
    let export_start: I64 = syntax.ast_node_start(manifest_tokens, cursor)
    let export_end: I64 = syntax.ast_node_end(manifest_tokens, cursor)
    let same: Bool = cross_spans_equal(manifest_source, export_start, export_end, module_source, segment_start, segment_end)
    if same:
      true
    else:
      let next: I64 = syntax.ast_node_after(cursor)
      recur(manifest_source, manifest_tokens, next, module_source, segment_start, segment_end)

fn invalid_prepared_project(status: I64) -> PreparedProject effects[alloc]:
  let tokens: Vec[syntax.Token] = vec.new()
  let origins: Vec[Origin] = vec.new()
  let manifest_tokens: Vec[syntax.Token] = vec.new()
  let facts: Vec[typing.Fact] = vec.new()
  let layouts: Vec[I64] = vec.new()
  let issues: Vec[typing.Issue] = vec.new()
  let plan: memory.Plan = memory.empty_plan()
  PreparedProject(status: status, source: "", tokens: tokens, origins: origins, manifest_source: "", manifest_tokens: manifest_tokens, facts: facts, layouts: layouts, issues: issues, plan: plan, range_ready: false, range_view: ranges.empty_view())

fn invalid_project_attempt(status: I64) -> ProjectAttempt effects[alloc]:
  let prepared: PreparedProject = invalid_prepared_project(status)
  let cache: retained.Cache = retained.empty_cache()
  let work: retained.Work = retained.Work(executed: -1, reused: 0, imported: 0, capacity: false)
  ProjectAttempt(transition: retained.empty_update(), canonical_nodes: 0, prepared: prepared, cache: cache, work: work)

fn report_project_issue(issue: typing.Issue, origins: Vec[Origin], manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], loaded: Vec[LoadedModule]) -> I64 effects[alloc, io, partial]:
  let start_origin: Origin = vec.get(origins, issue.start)
  let end_origin: Origin = vec.get(origins, issue.end)
  let module_index: I64 = start_origin.module
  let synthetic: Bool = module_index < 0
  if synthetic:
    report_project_diagnostic(issue.code, "-", start_origin.start, end_origin.end)
  else:
    let module: LoadedModule = vec.get(loaded, module_index)
    let name: I64 = module.name
    let module_name: Bytes = token_bytes(manifest_source, manifest_tokens, name)
    report_project_diagnostic(issue.code, module_name, start_origin.start, end_origin.end)

fn report_project_issues(input: Bytes, tokens: Vec[syntax.Token], issues: Vec[typing.Issue], index: I64, origins: Vec[Origin], manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], loaded: Vec[LoadedModule], count: I64, report: @diagnostics.Reporter) -> I64 effects[alloc, io, partial]:
  let length: I64 = vec.len(issues)
  let done: Bool = index >= length
  if done:
    count
  else:
    let issue: typing.Issue = vec.get(issues, index)
    let reported: I64 = if report.json:
      diagnostics.emit_node(@report, issue.code, input, tokens, issue.start, issue.end, issue.repair)
    else:
      report_project_issue(issue, origins, manifest_source, manifest_tokens, loaded)
    let next: I64 = index + 1
    let total: I64 = count + reported
    recur(input, tokens, issues, next, origins, manifest_source, manifest_tokens, loaded, total, @report)

fn prepare_loaded_project(manifest_source: Bytes, manifest_tokens: ^Vec[syntax.Token], entry: I64, module_tokens: Vec[syntax.Token], loaded: Vec[LoadedModule], namespace: NamespaceView, retain: Bool, strict: Bool, previous: retained.Cache, revision: identity.Revision, token_limit: I64, report: @diagnostics.Reporter) -> ProjectAttempt effects[alloc, io, partial]:
  let origins: Vec[Origin] = vec.new()
  let tokens: Vec[syntax.Token] = vec.new()
  let source: Bytes = flatten_loaded_project(manifest_source, manifest_tokens, entry, module_tokens, loaded, namespace, @tokens, @origins)
  let count: I64 = vec.len(tokens)
  if strict && ((token_limit < 1) || (count > token_limit)):
    let prepared: PreparedProject = invalid_prepared_project(65)
    let cache: retained.Cache = retained.empty_cache()
    let work: retained.Work = retained.Work(executed: -1, reused: 0, imported: 0, capacity: true)
    ProjectAttempt(transition: retained.empty_update(), canonical_nodes: count, prepared: prepared, cache: cache, work: work)
  else:
    check_loaded_project_report(manifest_source, ^manifest_tokens, source, ^tokens, ^origins, loaded, retain, previous, revision, token_limit, @report)

fn check_loaded_project(manifest_source: Bytes, manifest_tokens: ^Vec[syntax.Token], source: Bytes, tokens: ^Vec[syntax.Token], origins: ^Vec[Origin], loaded: Vec[LoadedModule], retain: Bool, previous: retained.Cache, revision: identity.Revision, token_limit: I64) -> ProjectAttempt effects[alloc, io, partial]:
  let report: diagnostics.Reporter = diagnostics.raw(true)
  check_loaded_project_report(manifest_source, ^manifest_tokens, source, ^tokens, ^origins, loaded, retain, previous, revision, token_limit, @report)

fn check_loaded_project_report(manifest_source: Bytes, manifest_tokens: ^Vec[syntax.Token], source: Bytes, tokens: ^Vec[syntax.Token], origins: ^Vec[Origin], loaded: Vec[LoadedModule], retain: Bool, previous: retained.Cache, revision: identity.Revision, token_limit: I64, report: @diagnostics.Reporter) -> ProjectAttempt effects[alloc, io, partial]:
  if report.json:
    install_report_origins(@report, origins, 0)
  else:
    void
  let attempt: check.Attempt = if retain:
    check.check_source_retained(source, @tokens, previous, revision, token_limit)
  else:
    let checked: typing.Checked = if report.json:
      check.check_source_deferred_report(source, @tokens, @report)
    else:
      check.check_source_deferred(source, @tokens)
    check.uncached_attempt(^checked)
  let status: I64 = attempt.checked.status
  let facts: Vec[typing.Fact] = mem.replace(@attempt.checked.view.facts, vec.new())
  let layouts: Vec[I64] = mem.replace(@attempt.checked.view.layouts, vec.new())
  let issues: Vec[typing.Issue] = mem.replace(@attempt.checked.issues, vec.new())
  let plan: memory.Plan = mem.replace(@attempt.checked.plan, memory.empty_plan())
  let reported: I64 = report_project_issues(source, tokens, issues, 0, origins, manifest_source, manifest_tokens, loaded, 0, @report)
  let canonical_nodes: I64 = vec.len(tokens)
  let range_view: ranges.View = mem.replace(@attempt.range_view, ranges.empty_view())
  let prepared: PreparedProject = PreparedProject(status: status, source: source, tokens: tokens, origins: origins, manifest_source: manifest_source, manifest_tokens: manifest_tokens, facts: facts, layouts: layouts, issues: issues, plan: plan, range_ready: attempt.range_ready, range_view: range_view)
  let cache: retained.Cache = mem.replace(@attempt.cache, retained.empty_cache())
  let transition: retained.Update = mem.replace(@attempt.transition, retained.empty_update())
  ProjectAttempt(transition: transition, canonical_nodes: canonical_nodes, prepared: prepared, cache: cache, work: attempt.work)

fn parse_project_manifest(source: Bytes, tokens: @Vec[syntax.Token]) -> I64 effects[alloc, io, partial]:
  let report: diagnostics.Reporter = diagnostics.raw(true)
  parse_project_manifest_report(source, @tokens, @report)

fn parse_project_manifest_report(source: Bytes, tokens: @Vec[syntax.Token], report: @diagnostics.Reporter) -> I64 effects[alloc, io, partial]:
  syntax.lex_data(source, 0, @tokens)
  let version: I64 = 2
  let valid_version: Bool = syntax.ast_node_text_is(source, tokens, version, "1")
  if valid_version:
    let entry_form: I64 = 3
    let modules: I64 = syntax.ast_next(tokens, entry_form)
    let manifest_errors: I64 = report_manifest_rules(source, tokens, entry_form, modules, @report)
    if manifest_errors > 0:
      manifest_errors
    else:
      let cycle: I64 = find_reciprocal_cycle(source, tokens, modules, modules)
      if cycle >= 0:
        emit_project_diagnostic(@report, "manifest", source, "E0413", "-", syntax.ast_node_start(tokens, cycle), syntax.ast_node_end(tokens, cycle))
      else:
        0
  else:
    emit_project_diagnostic(@report, "manifest", source, "E0402", "-", syntax.ast_node_start(tokens, version), syntax.ast_node_end(tokens, version))

fn finish_project_preparation(source: Bytes, tokens: ^Vec[syntax.Token], module_tokens: Vec[syntax.Token], loaded: Vec[LoadedModule], retain: Bool, strict: Bool, previous: retained.Cache, revision: identity.Revision, token_limit: I64, report: @diagnostics.Reporter) -> ProjectAttempt effects[alloc, io, partial]:
  let entry: I64 = 5
  let namespace: NamespaceView = derive_namespace(source, tokens, module_tokens, loaded)
  if report.json:
    install_report_files(@report, source, tokens, loaded)
  else:
    void
  let errors: I64 = report_loaded_project_report(source, tokens, entry, module_tokens, loaded, namespace, @report)
  if errors > 0:
    invalid_project_attempt(errors)
  else:
    prepare_loaded_project(source, ^tokens, entry, module_tokens, loaded, namespace, retain, strict, previous, revision, token_limit, @report)

fn prepare_project_attempt(path: Bytes, retain: Bool, previous: retained.Cache, revision: identity.Revision, token_limit: I64) -> ProjectAttempt effects[alloc, io, partial]:
  let report: diagnostics.Reporter = diagnostics.raw(true)
  prepare_project_attempt_report(path, retain, previous, revision, token_limit, @report)

fn prepare_project_attempt_report(path: Bytes, retain: Bool, previous: retained.Cache, revision: identity.Revision, token_limit: I64, report: @diagnostics.Reporter) -> ProjectAttempt effects[alloc, io, partial]:
  let source_bytes: Vec[U8] = vec.new()
  let source_read: Bool = io.read_file(path, @source_bytes)
  let source: Bytes = bytes.freeze(^source_bytes)
  let tokens: Vec[syntax.Token] = vec.new()
  if source_read:
    let status: I64 = parse_project_manifest_report(source, @tokens, @report)
    if status > 0:
      invalid_project_attempt(status)
    else:
      let modules: I64 = syntax.ast_next(tokens, 3)
      let module_tokens: Vec[syntax.Token] = vec.new()
      let loaded: Vec[LoadedModule] = vec.new()
      let errors: I64 = load_project_modules_report(path, source, tokens, modules, @module_tokens, @loaded, @report)
      if errors > 0:
        invalid_project_attempt(errors)
      else:
        finish_project_preparation(source, ^tokens, module_tokens, loaded, retain, false, previous, revision, token_limit, @report)
  else:
    let reported: I64 = emit_manifest_read_failure(@report, "E0409", "-", 0, 0)
    invalid_project_attempt(1)

fn empty_project_input() -> ProjectInput effects[alloc]:
  let tokens: Vec[syntax.Token] = vec.new()
  let modules: Vec[ModuleInput] = vec.new()
  ProjectInput(status: 1, manifest_source: "", manifest_tokens: tokens, modules: modules)

fn capture_module_inputs(path: Bytes, source: Bytes, tokens: Vec[syntax.Token], cursor: I64, output: @Vec[ModuleInput]) -> Void effects[alloc, io, partial]:
  if syntax.ast_node_kind(tokens, cursor) == 1:
    void
  else:
    let module_path: Bytes = project_module_path(path, source, tokens, cursor + 3)
    let bytes: Vec[U8] = vec.new()
    let read: Bool = io.read_file(module_path, @bytes)
    let content: Bytes = bytes.freeze(^bytes)
    vec.push(@output, ModuleInput(read: read, source: content))
    recur(path, source, tokens, syntax.ast_next(tokens, cursor), @output)

fn capture_project_input(path: Bytes) -> ProjectInput effects[alloc, io, partial]:
  let bytes: Vec[U8] = vec.new()
  let read: Bool = io.read_file(path, @bytes)
  let source: Bytes = bytes.freeze(^bytes)
  let tokens: Vec[syntax.Token] = vec.new()
  let modules: Vec[ModuleInput] = vec.new()
  let status: I64 = if read:
    parse_project_manifest(source, @tokens)
  else:
    report_project_diagnostic("E0409", "-", 0, 0)
  if status == 0:
    capture_module_inputs(path, source, tokens, syntax.ast_next(tokens, 3), @modules)
  else:
    void
  ProjectInput(status: status, manifest_source: source, manifest_tokens: tokens, modules: modules)

fn copy_manifest_tokens(source: Vec[syntax.Token], at: I64, output: @Vec[syntax.Token]) -> Void effects[alloc, partial]:
  if at >= vec.len(source):
    void
  else:
    vec.push(@output, vec.get(source, at))
    recur(source, at + 1, @output)

struct ModuleParses:
  caches: Vec[syntax.ParseCache]
  names: Vec[syntax.NameNode]
  edges: Vec[syntax.NameEdge]

struct ModuleParseWork:
  status: I64
  retained: Bool
  executed: I64
  reused: I64
  imported: I64

fn empty_module_parses() -> ModuleParses effects[alloc]:
  let caches: Vec[syntax.ParseCache] = vec.new()
  let names: Vec[syntax.NameNode] = vec.new()
  let edges: Vec[syntax.NameEdge] = vec.new()
  ModuleParses(caches: caches, names: names, edges: edges)

fn prior_module_parse(input: ProjectInput, cursor: I64, old: ModuleParses) -> I64 effects[partial]:
  if (vec.len(old.names) > 0) && (vec.len(old.edges) > 0):
    let name: I64 = cursor + 2
    let slot: I64 = syntax.lookup_name_chars(input.manifest_source, syntax.ast_node_start(input.manifest_tokens, name), syntax.ast_node_end(input.manifest_tokens, name), 0, old.names, old.edges)
    if (slot >= 0) && (slot < vec.len(old.caches)):
      slot
    else:
      -1
  else:
    -1

fn count_parse_work(before: I64, after: I64) -> I64 effects[partial]:
  if (before < 0) || (after < 0):
    -1
  else:
    before + after

fn load_retained_modules(input: ProjectInput, cursor: I64, at: I64, old: ModuleParses, revision: identity.Revision, config: Bytes, remaining_tokens: I64, remaining_lexemes: I64, capturing: Bool, module_tokens: @Vec[syntax.Token], loaded: @Vec[LoadedModule], caches: @Vec[syntax.ParseCache], names: @Vec[syntax.NameNode], edges: @Vec[syntax.NameEdge], executed: I64, reused: I64, imported: I64) -> ModuleParseWork effects[alloc, io, partial]:
  if syntax.ast_node_kind(input.manifest_tokens, cursor) == 1:
    let status: I64 = if at == vec.len(input.modules):
      0
    else:
      report_project_diagnostic("Q0002", "-", 0, 0)
    ModuleParseWork(status: status, retained: capturing, executed: executed, reused: reused, imported: imported)
  else:
    if at >= vec.len(input.modules):
      let status: I64 = report_project_diagnostic("Q0002", "-", 0, 0)
      ModuleParseWork(status: status, retained: false, executed: executed, reused: reused, imported: imported)
    else:
      let module: ModuleInput = vec.get(input.modules, at)
      if !module.read:
        let status: I64 = load_module_input(input.manifest_source, input.manifest_tokens, cursor, module, @module_tokens, @loaded)
        ModuleParseWork(status: status, retained: false, executed: executed, reused: reused, imported: imported)
      else:
        let root: I64 = vec.len(module_tokens)
        let owner: identity.FileId = if capturing:
          identity.FileId(revision: revision, slot: at + 1)
        else:
          identity.FileId(revision: identity.Revision(epoch: 0, serial: 0), slot: -1)
        let slot: I64 = prior_module_parse(input, cursor, old)
        let empty: syntax.ParseCache = syntax.empty_parse_cache()
        let parsed: syntax.RetainedParse = if slot >= 0:
          let previous: syntax.ParseCache = vec.get(old.caches, slot)
          syntax.parse_program_retained(module.source, @module_tokens, previous, owner, config)
        else:
          syntax.parse_program_retained(module.source, @module_tokens, empty, owner, config)
        let status: I64 = finish_module_parse(input.manifest_source, input.manifest_tokens, cursor, module.source, root, parsed.result, @module_tokens, @loaded)
        let next_executed: I64 = count_parse_work(executed, parsed.executed)
        let next_reused: I64 = reused + parsed.reused
        let next_imported: I64 = imported + parsed.imported
        if status > 0:
          ModuleParseWork(status: status, retained: false, executed: next_executed, reused: next_reused, imported: next_imported)
        else:
          let token_count: I64 = vec.len(parsed.cache.tokens)
          let lexeme_count: I64 = vec.len(parsed.cache.lexemes)
          let keep: Bool = (capturing && parsed.cache.valid) && ((token_count <= remaining_tokens) && (lexeme_count <= remaining_lexemes))
          if keep:
            let name: I64 = cursor + 2
            let previous: I64 = syntax.insert_name_chars(input.manifest_source, syntax.ast_node_start(input.manifest_tokens, name), syntax.ast_node_end(input.manifest_tokens, name), vec.len(caches), 0, @names, @edges)
            let cache: syntax.ParseCache = mem.replace(@parsed.cache, syntax.empty_parse_cache())
            vec.push(@caches, cache)
            recur(input, syntax.ast_next(input.manifest_tokens, cursor), at + 1, old, revision, config, remaining_tokens - token_count, remaining_lexemes - lexeme_count, true, @module_tokens, @loaded, @caches, @names, @edges, next_executed, next_reused, next_imported)
          else:
            recur(input, syntax.ast_next(input.manifest_tokens, cursor), at + 1, old, revision, config, 0, 0, false, @module_tokens, @loaded, @caches, @names, @edges, next_executed, next_reused, next_imported)

struct ParsedProject:
  attempt: ProjectAttempt
  parsing: syntax.ParseCache
  module_parsing: ModuleParses
  executed: I64
  reused: I64
  imported: I64

fn uncached_parsed_project(status: I64, executed: I64, reused: I64, imported: I64) -> ParsedProject effects[alloc]:
  let attempt: ProjectAttempt = invalid_project_attempt(status)
  let parsing: syntax.ParseCache = syntax.empty_parse_cache()
  let module_parsing: ModuleParses = empty_module_parses()
  ParsedProject(attempt: attempt, parsing: parsing, module_parsing: module_parsing, executed: executed, reused: reused, imported: imported)

fn prepare_parsed_project(input: ProjectInput, module_tokens: Vec[syntax.Token], loaded: Vec[LoadedModule], namespace: NamespaceView, module_parsing: ^ModuleParses, module_work: ModuleParseWork, previous: retained.Cache, old_parse: syntax.ParseCache, revision: identity.Revision, token_limit: I64, config: Bytes) -> ParsedProject effects[alloc, io, partial]:
  let origins: Vec[Origin] = vec.new()
  let tokens: Vec[syntax.Token] = vec.new()
  let source: Bytes = flatten_loaded_source(input.manifest_source, input.manifest_tokens, 5, module_tokens, loaded, namespace, @origins)
  let owner: identity.FileId = identity.FileId(revision: revision, slot: 0)
  let parsed: syntax.RetainedParse = syntax.parse_program_retained(source, @tokens, old_parse, owner, config)
  let count: I64 = vec.len(tokens)
  let capacity: Bool = (token_limit < 1) || (count > token_limit)
  let attempt: ProjectAttempt = if (!parsed.result.valid) || capacity:
    let prepared: PreparedProject = invalid_prepared_project(65)
    let cache: retained.Cache = retained.empty_cache()
    let work: retained.Work = retained.Work(executed: -1, reused: 0, imported: 0, capacity: capacity)
    ProjectAttempt(transition: retained.empty_update(), canonical_nodes: count, prepared: prepared, cache: cache, work: work)
  else:
    let manifest_tokens: Vec[syntax.Token] = vec.new()
    copy_manifest_tokens(input.manifest_tokens, 0, @manifest_tokens)
    check_loaded_project(input.manifest_source, ^manifest_tokens, source, ^tokens, ^origins, loaded, true, previous, revision, token_limit)
  let parsing: syntax.ParseCache = mem.replace(@parsed.cache, syntax.empty_parse_cache())
  ParsedProject(attempt: attempt, parsing: parsing, module_parsing: module_parsing, executed: count_parse_work(module_work.executed, parsed.executed), reused: module_work.reused + parsed.reused, imported: module_work.imported + parsed.imported)

fn prepare_project_input(input: ProjectInput, previous: retained.Cache, old_parse: syntax.ParseCache, old_modules: ModuleParses, revision: identity.Revision, token_limit: I64, config: Bytes) -> ParsedProject effects[alloc, io, partial]:
  if input.status > 0:
    uncached_parsed_project(input.status, 0, 0, 0)
  else:
    let module_tokens: Vec[syntax.Token] = vec.new()
    let loaded: Vec[LoadedModule] = vec.new()
    let first: I64 = syntax.ast_next(input.manifest_tokens, 3)
    let caches: Vec[syntax.ParseCache] = vec.new()
    let names: Vec[syntax.NameNode] = vec.new()
    let edges: Vec[syntax.NameEdge] = vec.new()
    let root: I64 = syntax.append_name_node(-1, @names)
    let capturing: Bool = (token_limit >= 1) && (token_limit <= 1000000)
    let work: ModuleParseWork = load_retained_modules(input, first, 0, old_modules, revision, config, token_limit, token_limit, capturing, @module_tokens, @loaded, @caches, @names, @edges, 0, 0, 0)
    if work.status > 0:
      uncached_parsed_project(work.status, work.executed, work.reused, work.imported)
    else:
      let namespace: NamespaceView = derive_namespace(input.manifest_source, input.manifest_tokens, module_tokens, loaded)
      let errors: I64 = report_loaded_project(input.manifest_source, input.manifest_tokens, 5, module_tokens, loaded, namespace)
      if errors > 0:
        uncached_parsed_project(errors, work.executed, work.reused, work.imported)
      else:
        let module_parsing: ModuleParses = if work.retained:
          ModuleParses(caches: caches, names: names, edges: edges)
        else:
          empty_module_parses()
        prepare_parsed_project(input, module_tokens, loaded, namespace, ^module_parsing, work, previous, old_parse, revision, token_limit, config)

fn prepare_project_path(path: Bytes) -> PreparedProject effects[alloc, io, partial]:
  let previous: retained.Cache = retained.empty_cache()
  let revision: identity.Revision = identity.Revision(epoch: 0, serial: 0)
  let attempt: ProjectAttempt = prepare_project_attempt(path, false, previous, revision, 0)
  mem.replace(@attempt.prepared, invalid_prepared_project(0))

fn prepare_project_retained(path: Bytes, previous: retained.Cache, revision: identity.Revision, token_limit: I64) -> ProjectAttempt effects[alloc, io, partial]:
  prepare_project_attempt(path, true, previous, revision, token_limit)

fn check_project_path(path: Bytes) -> I64 effects[alloc, io, partial]:
  let prepared: PreparedProject = prepare_project_path(path)
  prepared.status

fn append_interface_type(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], module_name: I64, module_source: Bytes, module_tokens: Vec[syntax.Token], type_index: I64, output: @Vec[U8]) -> Void effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(module_tokens, type_index)
  let composite: Bool = kind == 0
  if composite:
    let head: I64 = syntax.ast_list_first(type_index)
    let inner: I64 = syntax.ast_type_argument(type_index)
    text.append_text(@output, "(")
    text.append_token(module_source, module_tokens, head, @output)
    text.append_text(@output, " ")
    append_interface_type(manifest_source, manifest_tokens, module_name, module_source, module_tokens, inner, @output)
    text.append_text(@output, ")")
  else:
    let scalar_kind: I64 = syntax.scalar_type_kind(module_source, module_tokens, type_index)
    let scalar: Bool = scalar_kind >= 0
    let start: I64 = syntax.ast_node_start(module_tokens, type_index)
    let end: I64 = syntax.ast_node_end(module_tokens, type_index)
    let dots: I64 = syntax.span_count_byte(module_source, start, end, 46, 0)
    let qualified: Bool = dots > 0
    let raw: Bool = scalar || qualified
    if raw:
      text.append_token(module_source, module_tokens, type_index, @output)
    else:
      text.append_token(manifest_source, manifest_tokens, module_name, @output)
      text.append_text(@output, ".")
      text.append_token(module_source, module_tokens, type_index, @output)

fn append_interface_parameters(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], module_name: I64, module_source: Bytes, module_tokens: Vec[syntax.Token], cursor: I64, first: Bool, output: @Vec[U8]) -> Void effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(module_tokens, cursor)
  let done: Bool = kind == 1
  if done:
    text.append_text(@output, ")")
  else:
    if first:
      void
    else:
      text.append_text(@output, " ")
    let mode: I64 = syntax.ast_binding_mode(module_source, module_tokens, cursor)
    let type_index: I64 = syntax.ast_binding_type(module_source, module_tokens, cursor)
    let storage: I64 = memory.type_storage_kind(module_source, module_tokens, type_index)
    let affine: Bool = storage == 2
    text.append_text(@output, "(")
    if mode == 1:
      text.append_text(@output, "exclusive ")
    else:
      if mode == 2:
        text.append_text(@output, "owned ")
      else:
        if affine:
          text.append_text(@output, "shared ")
        else:
          text.append_text(@output, "copy ")
    append_interface_type(manifest_source, manifest_tokens, module_name, module_source, module_tokens, type_index, @output)
    text.append_text(@output, ")")
    let next: I64 = syntax.ast_next(module_tokens, cursor)
    recur(manifest_source, manifest_tokens, module_name, module_source, module_tokens, next, false, @output)

fn append_interface_effects(module_source: Bytes, module_tokens: Vec[syntax.Token], cursor: I64, output: @Vec[U8]) -> Void effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(module_tokens, cursor)
  let done: Bool = kind == 1
  if done:
    text.append_text(@output, ")")
  else:
    text.append_text(@output, " ")
    text.append_token(module_source, module_tokens, cursor, @output)
    let next: I64 = syntax.ast_node_after(cursor)
    recur(module_source, module_tokens, next, @output)

fn find_export_declaration(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], export_name: I64, module_source: Bytes, module_tokens: Vec[syntax.Token], cursor: I64) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(module_tokens, cursor)
  let done: Bool = kind == 1
  if done:
    -1
  else:
    let name: I64 = syntax.ast_item_name(cursor)
    let export_start: I64 = syntax.ast_node_start(manifest_tokens, export_name)
    let export_end: I64 = syntax.ast_node_end(manifest_tokens, export_name)
    let name_start: I64 = syntax.ast_node_start(module_tokens, name)
    let name_end: I64 = syntax.ast_node_end(module_tokens, name)
    let same: Bool = cross_spans_equal(manifest_source, export_start, export_end, module_source, name_start, name_end)
    if same:
      cursor
    else:
      let next: I64 = syntax.ast_next(module_tokens, cursor)
      recur(manifest_source, manifest_tokens, export_name, module_source, module_tokens, next)

fn append_interface_fields(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], module_name: I64, module_source: Bytes, module_tokens: Vec[syntax.Token], cursor: I64, first: Bool, output: @Vec[U8]) -> Void effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(module_tokens, cursor)
  let done: Bool = kind == 1
  if done:
    text.append_text(@output, ")")
  else:
    if first:
      void
    else:
      text.append_text(@output, " ")
    let name: I64 = syntax.ast_member_name(cursor)
    let type_index: I64 = syntax.ast_member_value(cursor)
    text.append_text(@output, "(")
    text.append_token(module_source, module_tokens, name, @output)
    text.append_text(@output, " ")
    append_interface_type(manifest_source, manifest_tokens, module_name, module_source, module_tokens, type_index, @output)
    text.append_text(@output, ")")
    let next: I64 = syntax.ast_next(module_tokens, cursor)
    recur(manifest_source, manifest_tokens, module_name, module_source, module_tokens, next, false, @output)

fn append_interface_case_types(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], module_name: I64, module_source: Bytes, module_tokens: Vec[syntax.Token], cursor: I64, output: @Vec[U8]) -> Void effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(module_tokens, cursor)
  let done: Bool = kind == 1
  if done:
    void
  else:
    text.append_text(@output, " ")
    append_interface_type(manifest_source, manifest_tokens, module_name, module_source, module_tokens, cursor, @output)
    let next: I64 = syntax.ast_next(module_tokens, cursor)
    recur(manifest_source, manifest_tokens, module_name, module_source, module_tokens, next, @output)

fn append_interface_cases(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], module_name: I64, module_source: Bytes, module_tokens: Vec[syntax.Token], cursor: I64, first: Bool, output: @Vec[U8]) -> Void effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(module_tokens, cursor)
  let done: Bool = kind == 1
  if done:
    text.append_text(@output, ")")
  else:
    if first:
      void
    else:
      text.append_text(@output, " ")
    let name: I64 = syntax.ast_node_after(cursor)
    let first_type: I64 = syntax.ast_member_value(cursor)
    text.append_text(@output, "(")
    text.append_token(module_source, module_tokens, name, @output)
    append_interface_case_types(manifest_source, manifest_tokens, module_name, module_source, module_tokens, first_type, @output)
    text.append_text(@output, ")")
    let next: I64 = syntax.ast_next(module_tokens, cursor)
    recur(manifest_source, manifest_tokens, module_name, module_source, module_tokens, next, false, @output)

fn append_interface_declaration(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], module_name: I64, module_source: Bytes, module_tokens: Vec[syntax.Token], item: I64, output: @Vec[U8]) -> Void effects[alloc, partial]:
  let function_item: Bool = syntax.ast_item_is_function(module_source, module_tokens, item)
  if function_item:
    let name: I64 = syntax.ast_item_name(item)
    let params: I64 = syntax.ast_function_parameters(item)
    let return_type: I64 = syntax.ast_function_return_type(module_tokens, item)
    let effects: I64 = syntax.ast_next(module_tokens, return_type)
    let first_effect: I64 = effects + 2
    text.append_text(@output, "(fn ")
    text.append_token(module_source, module_tokens, name, @output)
    text.append_text(@output, " (")
    let first_parameter: I64 = syntax.ast_parameters_first(params)
    append_interface_parameters(manifest_source, manifest_tokens, module_name, module_source, module_tokens, first_parameter, true, @output)
    text.append_text(@output, " ")
    append_interface_type(manifest_source, manifest_tokens, module_name, module_source, module_tokens, return_type, @output)
    text.append_text(@output, " (effects")
    append_interface_effects(module_source, module_tokens, first_effect, @output)
    text.append_text(@output, ")")
  else:
    let record_item: Bool = syntax.ast_item_is_record(module_source, module_tokens, item)
    let name: I64 = syntax.ast_item_name(item)
    let body: I64 = syntax.ast_data_body(item)
    let first_member: I64 = syntax.ast_data_members_first(item)
    if record_item:
      text.append_text(@output, "(record ")
    else:
      text.append_text(@output, "(variant ")
    text.append_token(module_source, module_tokens, name, @output)
    text.append_text(@output, " (")
    if record_item:
      append_interface_fields(manifest_source, manifest_tokens, module_name, module_source, module_tokens, first_member, true, @output)
    else:
      append_interface_cases(manifest_source, manifest_tokens, module_name, module_source, module_tokens, first_member, true, @output)
    text.append_text(@output, ")")

fn append_interface_exports(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], module_name: I64, cursor: I64, module_source: Bytes, module_tokens: Vec[syntax.Token], module_items: I64, output: @Vec[U8]) -> Void effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(manifest_tokens, cursor)
  let done: Bool = kind == 1
  if done:
    void
  else:
    let item: I64 = find_export_declaration(manifest_source, manifest_tokens, cursor, module_source, module_tokens, module_items)
    text.append_text(@output, " ")
    append_interface_declaration(manifest_source, manifest_tokens, module_name, module_source, module_tokens, item, @output)
    let next: I64 = syntax.ast_node_after(cursor)
    recur(manifest_source, manifest_tokens, module_name, next, module_source, module_tokens, module_items, @output)

fn append_project_interfaces(manifest_path: Bytes, manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], cursor: I64, output: @Vec[U8]) -> Void effects[alloc, io, partial]:
  let kind: I64 = syntax.ast_node_kind(manifest_tokens, cursor)
  let done: Bool = kind == 1
  if done:
    void
  else:
    let module_name: I64 = cursor + 2
    let path_token: I64 = cursor + 3
    let imports_form: I64 = cursor + 4
    let exports_form: I64 = syntax.ast_next(manifest_tokens, imports_form)
    let first_export: I64 = exports_form + 2
    let module_path: Bytes = project_module_path(manifest_path, manifest_source, manifest_tokens, path_token)
    let module_source_bytes: Vec[U8] = vec.new()
    let module_source_read: Bool = io.read_file(module_path, @module_source_bytes)
    let module_source: Bytes = bytes.freeze(^module_source_bytes)
    let module_tokens: Vec[syntax.Token] = vec.new()
    let parsed: Bool = syntax.parse_program(module_source, @module_tokens)
    text.append_text(@output, "(interface 3 ")
    text.append_token(manifest_source, manifest_tokens, module_name, @output)
    let module_items: I64 = syntax.ast_module_items(0)
    append_interface_exports(manifest_source, manifest_tokens, module_name, first_export, module_source, module_tokens, module_items, @output)
    text.append_text(@output, ")\n")
    let next: I64 = syntax.ast_next(manifest_tokens, cursor)
    recur(manifest_path, manifest_source, manifest_tokens, next, @output)

fn interfaces_path(path: Bytes) -> I64 effects[alloc, io, partial]:
  let checked: I64 = check_project_path(path)
  let invalid: Bool = checked > 0
  if invalid:
    checked
  else:
    let source_bytes: Vec[U8] = vec.new()
    let source_read: Bool = io.read_file(path, @source_bytes)
    let source: Bytes = bytes.freeze(^source_bytes)
    let tokens: Vec[syntax.Token] = vec.new()
    syntax.lex_data(source, 0, @tokens)
    let entry_form: I64 = 3
    let modules: I64 = syntax.ast_next(tokens, entry_form)
    let output: Vec[U8] = vec.new()
    append_project_interfaces(path, source, tokens, modules, @output)
    let bytes: Bytes = bytes.freeze(^output)
    io.print_bytes(bytes)
    0

fn span_less_chars(source: Bytes, left: I64, left_end: I64, right: I64, right_end: I64) -> Bool effects[partial]:
  let left_done: Bool = left >= left_end
  let right_done: Bool = right >= right_end
  if left_done:
    !right_done
  else:
    if right_done:
      false
    else:
      let left_byte: U8 = bytes.get(source, left)
      let right_byte: U8 = bytes.get(source, right)
      let left_code: I64 = u8.to_i64(left_byte)
      let right_code: I64 = u8.to_i64(right_byte)
      let equal: Bool = left_code == right_code
      if equal:
        let next_left: I64 = left + 1
        let next_right: I64 = right + 1
        recur(source, next_left, left_end, next_right, right_end)
      else:
        left_code < right_code

fn span_less(source: Bytes, tokens: Vec[syntax.Token], left: I64, right: I64) -> Bool effects[partial]:
  let left_start: I64 = syntax.ast_node_start(tokens, left)
  let left_end: I64 = syntax.ast_node_end(tokens, left)
  let right_start: I64 = syntax.ast_node_start(tokens, right)
  let right_end: I64 = syntax.ast_node_end(tokens, right)
  span_less_chars(source, left_start, left_end, right_start, right_end)

fn find_unsorted_name_list(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, previous: I64) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    -1
  else:
    let first: Bool = previous < 0
    let ordered: Bool = if first:
      true
    else:
      span_less(source, tokens, previous, cursor)
    if ordered:
      let next: I64 = syntax.ast_node_after(cursor)
      recur(source, tokens, next, cursor)
    else:
      cursor

fn find_unsorted_module_lists(source: Bytes, tokens: Vec[syntax.Token], cursor: I64) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    -1
  else:
    let imports: I64 = cursor + 4
    let first_import: I64 = imports + 2
    let invalid_import: I64 = find_unsorted_name_list(source, tokens, first_import, -1)
    if invalid_import >= 0:
      invalid_import
    else:
      let exports: I64 = syntax.ast_next(tokens, imports)
      let first_export: I64 = exports + 2
      let invalid_export: I64 = find_unsorted_name_list(source, tokens, first_export, -1)
      if invalid_export >= 0:
        invalid_export
      else:
        let next: I64 = syntax.ast_next(tokens, cursor)
        recur(source, tokens, next)

fn find_unsorted_module(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, previous: I64) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    -1
  else:
    let name: I64 = cursor + 2
    let first: Bool = previous < 0
    let ordered: Bool = if first:
      true
    else:
      span_less(source, tokens, previous, name)
    if ordered:
      let next: I64 = syntax.ast_next(tokens, cursor)
      recur(source, tokens, next, name)
    else:
      name

fn find_prior_module_name(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, current: I64, name_start: I64, name_end: I64) -> I64 effects[partial]:
  let reached: Bool = cursor == current
  if reached:
    -1
  else:
    let name: I64 = cursor + 2
    let start: I64 = syntax.ast_node_start(tokens, name)
    let end: I64 = syntax.ast_node_end(tokens, name)
    let same: Bool = syntax.spans_equal(source, start, end, name_start, name_end)
    if same:
      name
    else:
      let next: I64 = syntax.ast_next(tokens, cursor)
      recur(source, tokens, next, current, name_start, name_end)

fn find_duplicate_module(source: Bytes, tokens: Vec[syntax.Token], modules: I64, cursor: I64) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    -1
  else:
    let name: I64 = cursor + 2
    let start: I64 = syntax.ast_node_start(tokens, name)
    let end: I64 = syntax.ast_node_end(tokens, name)
    let prior: I64 = find_prior_module_name(source, tokens, modules, cursor, start, end)
    let duplicate: Bool = prior >= 0
    if duplicate:
      name
    else:
      let next: I64 = syntax.ast_next(tokens, cursor)
      recur(source, tokens, modules, next)

fn find_prior_path(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, current: I64, path_start: I64, path_end: I64) -> I64 effects[partial]:
  let reached: Bool = cursor == current
  if reached:
    -1
  else:
    let path: I64 = cursor + 3
    let start: I64 = syntax.ast_node_start(tokens, path)
    let end: I64 = syntax.ast_node_end(tokens, path)
    let same: Bool = syntax.spans_equal(source, start, end, path_start, path_end)
    if same:
      path
    else:
      let next: I64 = syntax.ast_next(tokens, cursor)
      recur(source, tokens, next, current, path_start, path_end)

fn find_duplicate_path(source: Bytes, tokens: Vec[syntax.Token], modules: I64, cursor: I64) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    -1
  else:
    let path: I64 = cursor + 3
    let start: I64 = syntax.ast_node_start(tokens, path)
    let end: I64 = syntax.ast_node_end(tokens, path)
    let prior: I64 = find_prior_path(source, tokens, modules, cursor, start, end)
    let duplicate: Bool = prior >= 0
    if duplicate:
      path
    else:
      let next: I64 = syntax.ast_next(tokens, cursor)
      recur(source, tokens, modules, next)

fn path_segment_valid(source: Bytes, start: I64, end: I64) -> Bool effects[partial]:
  let length: I64 = end - start
  let nonempty: Bool = length > 0
  if nonempty:
    let dot: Bool = syntax.span_equal(source, start, end, ".")
    let parent: Bool = syntax.span_equal(source, start, end, "..")
    let special: Bool = dot || parent
    !special
  else:
    false

fn path_segments_valid(source: Bytes, index: I64, end: I64, segment_start: I64) -> Bool effects[partial]:
  let done: Bool = index >= end
  if done:
    path_segment_valid(source, segment_start, end)
  else:
    let byte: U8 = bytes.get(source, index)
    let code: I64 = u8.to_i64(byte)
    let backslash: Bool = code == 92
    if backslash:
      false
    else:
      let slash: Bool = code == 47
      if slash:
        let valid: Bool = path_segment_valid(source, segment_start, index)
        if valid:
          let next: I64 = index + 1
          recur(source, next, end, next)
        else:
          false
      else:
        let next: I64 = index + 1
        recur(source, next, end, segment_start)

fn path_token_invalid(source: Bytes, tokens: Vec[syntax.Token], path: I64) -> Bool effects[partial]:
  let token_start: I64 = syntax.ast_node_start(tokens, path)
  let token_end: I64 = syntax.ast_node_end(tokens, path)
  let start: I64 = token_start + 1
  let end: I64 = token_end - 1
  let length: I64 = end - start
  let enough: Bool = length >= 5
  if enough:
    let suffix_start: I64 = end - 5
    let suffix: Bool = syntax.span_equal(source, suffix_start, end, ".slim")
    if suffix:
      let segments: Bool = path_segments_valid(source, start, end, start)
      !segments
    else:
      true
  else:
    true

fn find_invalid_path(source: Bytes, tokens: Vec[syntax.Token], cursor: I64) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    -1
  else:
    let path: I64 = cursor + 3
    let invalid: Bool = path_token_invalid(source, tokens, path)
    if invalid:
      path
    else:
      let next: I64 = syntax.ast_next(tokens, cursor)
      recur(source, tokens, next)

fn find_self_import_in(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, name_start: I64, name_end: I64) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    -1
  else:
    let start: I64 = syntax.ast_node_start(tokens, cursor)
    let end: I64 = syntax.ast_node_end(tokens, cursor)
    let same: Bool = syntax.spans_equal(source, start, end, name_start, name_end)
    if same:
      cursor
    else:
      let next: I64 = syntax.ast_node_after(cursor)
      recur(source, tokens, next, name_start, name_end)

fn find_self_import(source: Bytes, tokens: Vec[syntax.Token], cursor: I64) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    -1
  else:
    let name: I64 = cursor + 2
    let name_start: I64 = syntax.ast_node_start(tokens, name)
    let name_end: I64 = syntax.ast_node_end(tokens, name)
    let imports: I64 = cursor + 4
    let first: I64 = imports + 2
    let invalid: I64 = find_self_import_in(source, tokens, first, name_start, name_end)
    let found: Bool = invalid >= 0
    if found:
      invalid
    else:
      let next: I64 = syntax.ast_next(tokens, cursor)
      recur(source, tokens, next)

fn find_unknown_import_in(source: Bytes, tokens: Vec[syntax.Token], modules: I64, cursor: I64) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    -1
  else:
    let start: I64 = syntax.ast_node_start(tokens, cursor)
    let end: I64 = syntax.ast_node_end(tokens, cursor)
    let module: I64 = find_manifest_module(source, tokens, modules, start, end)
    let known: Bool = module >= 0
    if known:
      let next: I64 = syntax.ast_node_after(cursor)
      recur(source, tokens, modules, next)
    else:
      cursor

fn find_unknown_import(source: Bytes, tokens: Vec[syntax.Token], modules: I64, cursor: I64) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    -1
  else:
    let imports: I64 = cursor + 4
    let first: I64 = imports + 2
    let invalid: I64 = find_unknown_import_in(source, tokens, modules, first)
    let found: Bool = invalid >= 0
    if found:
      invalid
    else:
      let next: I64 = syntax.ast_next(tokens, cursor)
      recur(source, tokens, modules, next)

fn report_manifest_rules(source: Bytes, tokens: Vec[syntax.Token], entry_form: I64, modules: I64, report: @diagnostics.Reporter) -> I64 effects[alloc, io, partial]:
  let entry: I64 = entry_form + 2
  let entry_start: I64 = syntax.ast_node_start(tokens, entry)
  let entry_end: I64 = syntax.ast_node_end(tokens, entry)
  let declared: I64 = find_manifest_module(source, tokens, modules, entry_start, entry_end)
  let known_entry: Bool = declared >= 0
  if known_entry:
    let unsorted: I64 = find_unsorted_module(source, tokens, modules, -1)
    let has_unsorted: Bool = unsorted >= 0
    if has_unsorted:
      let start: I64 = syntax.ast_node_start(tokens, unsorted)
      let end: I64 = syntax.ast_node_end(tokens, unsorted)
      let order_report: I64 = emit_project_diagnostic(@report, "manifest", source, "E0406", "-", start, end)
      let duplicate: I64 = find_duplicate_module(source, tokens, modules, modules)
      let same_span: Bool = duplicate == unsorted
      if same_span:
        let duplicate_report: I64 = emit_project_diagnostic(@report, "manifest", source, "E0408", "-", start, end)
        order_report
      else:
        order_report
    else:
      let duplicate_path: I64 = if manifest_index_eligible(source, tokens, modules):
        indexed_duplicate_path(source, tokens, modules)
      else:
        find_duplicate_path(source, tokens, modules, modules)
      let has_duplicate_path: Bool = duplicate_path >= 0
      if has_duplicate_path:
        let start: I64 = syntax.ast_node_start(tokens, duplicate_path)
        let end: I64 = syntax.ast_node_end(tokens, duplicate_path)
        emit_project_diagnostic(@report, "manifest", source, "E0408", "-", start, end)
      else:
        let invalid_path: I64 = find_invalid_path(source, tokens, modules)
        let has_invalid_path: Bool = invalid_path >= 0
        if has_invalid_path:
          let start: I64 = syntax.ast_node_start(tokens, invalid_path)
          let end: I64 = syntax.ast_node_end(tokens, invalid_path)
          emit_project_diagnostic(@report, "manifest", source, "E0407", "-", start, end)
        else:
          let unsorted_list: I64 = find_unsorted_module_lists(source, tokens, modules)
          if unsorted_list >= 0:
            let start: I64 = syntax.ast_node_start(tokens, unsorted_list)
            let end: I64 = syntax.ast_node_end(tokens, unsorted_list)
            emit_project_diagnostic(@report, "manifest", source, "E0406", "-", start, end)
          else:
            let self_import: I64 = find_self_import(source, tokens, modules)
            let has_self: Bool = self_import >= 0
            if has_self:
              let start: I64 = syntax.ast_node_start(tokens, self_import)
              let end: I64 = syntax.ast_node_end(tokens, self_import)
              emit_project_diagnostic(@report, "manifest", source, "E0412", "-", start, end)
            else:
              let unknown_import: I64 = find_unknown_import(source, tokens, modules, modules)
              let has_unknown: Bool = unknown_import >= 0
              if has_unknown:
                let start: I64 = syntax.ast_node_start(tokens, unknown_import)
                let end: I64 = syntax.ast_node_end(tokens, unknown_import)
                emit_project_diagnostic(@report, "manifest", source, "E0411", "-", start, end)
              else:
                0
  else:
    emit_project_diagnostic(@report, "manifest", source, "E0403", "-", entry_start, entry_end)

struct LoadedModule:
  manifest: I64
  name: I64
  path: I64
  source: Bytes
  root: I64

fn finish_module_parse(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], cursor: I64, source: Bytes, root: I64, parsed: syntax.ProgramParse, module_tokens: @Vec[syntax.Token], loaded: @Vec[LoadedModule]) -> I64 effects[alloc, io, partial]:
  let report: diagnostics.Reporter = diagnostics.raw(true)
  finish_module_parse_report(manifest_source, manifest_tokens, cursor, source, root, parsed, @module_tokens, @loaded, @report)

fn finish_module_parse_report(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], cursor: I64, source: Bytes, root: I64, parsed: syntax.ProgramParse, module_tokens: @Vec[syntax.Token], loaded: @Vec[LoadedModule], report: @diagnostics.Reporter) -> I64 effects[alloc, io, partial]:
  let name: I64 = cursor + 2
  let path: I64 = cursor + 3
  let end: I64 = vec.len(module_tokens)
  let shaped: Bool = validate.module_shape_valid_from(source, module_tokens, root, end)
  if parsed.valid && shaped:
    syntax.link_declaration_names_from(source, @module_tokens, root)
    vec.push(@loaded, LoadedModule(manifest: cursor, name: name, path: path, source: source, root: root))
    0
  else:
    let module_name: Bytes = token_bytes(manifest_source, manifest_tokens, name)
    if parsed.valid:
      let count: I64 = end - root
      let repair: typing.Repair = if count > 1000000:
        typing.Repair(expected: typing.TypeRef(kind: -2, form: -1), actual: typing.TypeRef(kind: -2, form: -1), requirement: -1, related: -1, rule: "canonical-node-limit", expected_count: 1000000, actual_count: count, effect: -1)
      else:
        typing.empty_repair()
      emit_parsed_module(@report, manifest_source, manifest_tokens, path, source, "E0102", module_name, 0, bytes.len(source), repair)
    else:
      emit_parsed_module(@report, manifest_source, manifest_tokens, path, source, parsed.code, module_name, parsed.start, parsed.end, typing.empty_repair())

fn load_module_input(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], cursor: I64, input: ModuleInput, module_tokens: @Vec[syntax.Token], loaded: @Vec[LoadedModule]) -> I64 effects[alloc, io, partial]:
  let report: diagnostics.Reporter = diagnostics.raw(true)
  load_module_input_report(manifest_source, manifest_tokens, cursor, input, @module_tokens, @loaded, @report)

fn load_module_input_report(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], cursor: I64, input: ModuleInput, module_tokens: @Vec[syntax.Token], loaded: @Vec[LoadedModule], report: @diagnostics.Reporter) -> I64 effects[alloc, io, partial]:
  let name: I64 = cursor + 2
  let path: I64 = cursor + 3
  if input.read:
    let source: Bytes = input.source
    let root: I64 = vec.len(module_tokens)
    let parsed: syntax.ProgramParse = syntax.parse_program_result(source, @module_tokens)
    finish_module_parse_report(manifest_source, manifest_tokens, cursor, source, root, parsed, @module_tokens, @loaded, @report)
  else:
    let module_name: Bytes = token_bytes(manifest_source, manifest_tokens, name)
    emit_project_diagnostic(@report, "manifest", manifest_source, "E0409", module_name, syntax.ast_node_start(manifest_tokens, path), syntax.ast_node_end(manifest_tokens, path))

fn load_project_modules(manifest_path: Bytes, manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], cursor: I64, module_tokens: @Vec[syntax.Token], loaded: @Vec[LoadedModule]) -> I64 effects[alloc, io, partial]:
  let report: diagnostics.Reporter = diagnostics.raw(true)
  load_project_modules_report(manifest_path, manifest_source, manifest_tokens, cursor, @module_tokens, @loaded, @report)

fn load_project_modules_report(manifest_path: Bytes, manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], cursor: I64, module_tokens: @Vec[syntax.Token], loaded: @Vec[LoadedModule], report: @diagnostics.Reporter) -> I64 effects[alloc, io, partial]:
  if syntax.ast_node_kind(manifest_tokens, cursor) == 1:
    0
  else:
    let module_path: Bytes = project_module_path(manifest_path, manifest_source, manifest_tokens, cursor + 3)
    let bytes: Vec[U8] = vec.new()
    let read: Bool = io.read_file(module_path, @bytes)
    let source: Bytes = bytes.freeze(^bytes)
    let input: ModuleInput = ModuleInput(read: read, source: source)
    let result: I64 = load_module_input_report(manifest_source, manifest_tokens, cursor, input, @module_tokens, @loaded, @report)
    if result == 0:
      recur(manifest_path, manifest_source, manifest_tokens, syntax.ast_next(manifest_tokens, cursor), @module_tokens, @loaded, @report)
    else:
      result

fn report_module_identities(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], module_tokens: Vec[syntax.Token], loaded: Vec[LoadedModule], index: I64, report: @diagnostics.Reporter) -> I64 effects[alloc, io, partial]:
  let length: I64 = vec.len(loaded)
  let done: Bool = index >= length
  if done:
    0
  else:
    let module: LoadedModule = vec.get(loaded, index)
    let name: I64 = module.name
    let source: Bytes = module.source
    let root: I64 = module.root
    let source_name: I64 = syntax.ast_module_name(root)
    let manifest_start: I64 = syntax.ast_node_start(manifest_tokens, name)
    let manifest_end: I64 = syntax.ast_node_end(manifest_tokens, name)
    let source_start: I64 = syntax.ast_node_start(module_tokens, source_name)
    let source_end: I64 = syntax.ast_node_end(module_tokens, source_name)
    let same: Bool = cross_spans_equal(manifest_source, manifest_start, manifest_end, source, source_start, source_end)
    if same:
      let next: I64 = index + 1
      recur(manifest_source, manifest_tokens, module_tokens, loaded, next, @report)
    else:
      let module_name: Bytes = token_bytes(manifest_source, manifest_tokens, name)
      emit_project_diagnostic(@report, "manifest", manifest_source, "E0410", module_name, manifest_start, manifest_end)

fn find_missing_export(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], cursor: I64, module_source: Bytes, module_tokens: Vec[syntax.Token], module_items: I64) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(manifest_tokens, cursor)
  let done: Bool = kind == 1
  if done:
    -1
  else:
    let declaration: I64 = find_export_declaration(manifest_source, manifest_tokens, cursor, module_source, module_tokens, module_items)
    let found: Bool = declaration >= 0
    if found:
      let next: I64 = syntax.ast_node_after(cursor)
      recur(manifest_source, manifest_tokens, next, module_source, module_tokens, module_items)
    else:
      cursor

fn report_missing_exports(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], module_tokens: Vec[syntax.Token], loaded: Vec[LoadedModule], index: I64, report: @diagnostics.Reporter) -> I64 effects[alloc, io, partial]:
  let length: I64 = vec.len(loaded)
  let done: Bool = index >= length
  if done:
    0
  else:
    let module: LoadedModule = vec.get(loaded, index)
    let manifest: I64 = module.manifest
    let name: I64 = module.name
    let imports: I64 = manifest + 4
    let exports: I64 = syntax.ast_next(manifest_tokens, imports)
    let first_export: I64 = exports + 2
    let source: Bytes = module.source
    let root: I64 = module.root
    let module_items: I64 = syntax.ast_module_items(root)
    let missing: I64 = find_missing_export(manifest_source, manifest_tokens, first_export, source, module_tokens, module_items)
    let invalid: Bool = missing >= 0
    if invalid:
      let start: I64 = syntax.ast_node_start(manifest_tokens, missing)
      let end: I64 = syntax.ast_node_end(manifest_tokens, missing)
      let module_name: Bytes = token_bytes(manifest_source, manifest_tokens, name)
      emit_project_diagnostic(@report, "manifest", manifest_source, "E0414", module_name, start, end)
    else:
      let next: I64 = index + 1
      recur(manifest_source, manifest_tokens, module_tokens, loaded, next, @report)

fn find_named_declaration(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, name: Bytes) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    -1
  else:
    let declaration_name: I64 = syntax.ast_item_name(cursor)
    let same: Bool = syntax.ast_node_text_is(source, tokens, declaration_name, name)
    if same:
      cursor
    else:
      let next: I64 = syntax.ast_next(tokens, cursor)
      recur(source, tokens, next, name)

fn loaded_is_entry(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], entry: I64, module: LoadedModule) -> Bool effects[partial]:
  let name: I64 = module.name
  let name_start: I64 = syntax.ast_node_start(manifest_tokens, name)
  let name_end: I64 = syntax.ast_node_end(manifest_tokens, name)
  let entry_start: I64 = syntax.ast_node_start(manifest_tokens, entry)
  let entry_end: I64 = syntax.ast_node_end(manifest_tokens, entry)
  syntax.spans_equal(manifest_source, name_start, name_end, entry_start, entry_end)

fn report_project_mains(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], entry: I64, module_tokens: Vec[syntax.Token], loaded: Vec[LoadedModule], index: I64, report: @diagnostics.Reporter) -> I64 effects[alloc, io, partial]:
  let length: I64 = vec.len(loaded)
  let done: Bool = index >= length
  if done:
    0
  else:
    let module: LoadedModule = vec.get(loaded, index)
    let source: Bytes = module.source
    let root: I64 = module.root
    let module_items: I64 = syntax.ast_module_items(root)
    let main: I64 = find_named_declaration(source, module_tokens, module_items, "main")
    let has_main: Bool = main >= 0
    let is_entry: Bool = loaded_is_entry(manifest_source, manifest_tokens, entry, module)
    if is_entry:
      if has_main:
        let next: I64 = index + 1
        recur(manifest_source, manifest_tokens, entry, module_tokens, loaded, next, @report)
      else:
        let name: I64 = module.name
        let module_name: Bytes = token_bytes(manifest_source, manifest_tokens, name)
        let next_form: I64 = syntax.ast_next(module_tokens, root)
        let closing: I64 = next_form - 1
        let end: I64 = syntax.ast_node_end(module_tokens, closing)
        emit_project_diagnostic(@report, "module", module.source, "E0419", module_name, 0, end)
    else:
      if has_main:
        let start: I64 = syntax.ast_node_start(module_tokens, main)
        let next_form: I64 = syntax.ast_next(module_tokens, main)
        let closing: I64 = next_form - 1
        let end: I64 = syntax.ast_node_end(module_tokens, closing)
        let name: I64 = module.name
        let module_name: Bytes = token_bytes(manifest_source, manifest_tokens, name)
        emit_project_diagnostic(@report, "module", module.source, "E0419", module_name, start, end)
      else:
        let next: I64 = index + 1
        recur(manifest_source, manifest_tokens, entry, module_tokens, loaded, next, @report)

fn find_loaded_segment(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], loaded: Vec[LoadedModule], reference_source: Bytes, segment_start: I64, segment_end: I64, index: I64) -> I64 effects[partial]:
  let length: I64 = vec.len(loaded)
  let done: Bool = index >= length
  if done:
    -1
  else:
    let module: LoadedModule = vec.get(loaded, index)
    let name: I64 = module.name
    let name_start: I64 = syntax.ast_node_start(manifest_tokens, name)
    let name_end: I64 = syntax.ast_node_end(manifest_tokens, name)
    let same: Bool = cross_spans_equal(manifest_source, name_start, name_end, reference_source, segment_start, segment_end)
    if same:
      index
    else:
      let next: I64 = index + 1
      recur(manifest_source, manifest_tokens, loaded, reference_source, segment_start, segment_end, next)

fn find_declaration_segment(declaration_source: Bytes, module_tokens: Vec[syntax.Token], cursor: I64, reference_source: Bytes, segment_start: I64, segment_end: I64) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(module_tokens, cursor)
  let done: Bool = kind == 1
  if done:
    -1
  else:
    let name: I64 = syntax.ast_item_name(cursor)
    let name_start: I64 = syntax.ast_node_start(module_tokens, name)
    let name_end: I64 = syntax.ast_node_end(module_tokens, name)
    let same: Bool = cross_spans_equal(declaration_source, name_start, name_end, reference_source, segment_start, segment_end)
    if same:
      cursor
    else:
      let next: I64 = syntax.ast_next(module_tokens, cursor)
      recur(declaration_source, module_tokens, next, reference_source, segment_start, segment_end)

struct NamespaceModule:
  imports: I64
  exports: I64
  declarations: I64
  roles: Vec[I64]

struct NamespaceView:
  names: Vec[syntax.NameNode]
  edges: Vec[syntax.NameEdge]
  modules: Vec[NamespaceModule]

fn index_namespace_list(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, root: I64, names: @Vec[syntax.NameNode], edges: @Vec[syntax.NameEdge]) -> Void effects[alloc, partial]:
  if syntax.ast_list_done(tokens, cursor):
    void
  else:
    let previous: I64 = syntax.insert_name_chars(source, syntax.ast_node_start(tokens, cursor), syntax.ast_node_end(tokens, cursor), cursor, root, @names, @edges)
    recur(source, tokens, syntax.ast_next(tokens, cursor), root, @names, @edges)

fn index_namespace_declarations(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, root: I64, names: @Vec[syntax.NameNode], edges: @Vec[syntax.NameEdge]) -> Void effects[alloc, partial]:
  if syntax.ast_list_done(tokens, cursor):
    void
  else:
    let name: I64 = syntax.ast_item_name(cursor)
    let previous: I64 = syntax.insert_name_chars(source, syntax.ast_node_start(tokens, name), syntax.ast_node_end(tokens, name), cursor, root, @names, @edges)
    recur(source, tokens, syntax.ast_next(tokens, cursor), root, @names, @edges)

fn index_namespace_modules(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], tokens: Vec[syntax.Token], loaded: Vec[LoadedModule], index: I64, names: @Vec[syntax.NameNode], edges: @Vec[syntax.NameEdge], modules: @Vec[NamespaceModule]) -> Void effects[alloc, partial]:
  if index >= vec.len(loaded):
    void
  else:
    let module: LoadedModule = vec.get(loaded, index)
    let previous: I64 = syntax.insert_name_chars(manifest_source, syntax.ast_node_start(manifest_tokens, module.name), syntax.ast_node_end(manifest_tokens, module.name), index, 0, @names, @edges)
    let imports: I64 = syntax.append_name_node(-1, @names)
    let exports: I64 = syntax.append_name_node(-1, @names)
    let declarations: I64 = syntax.append_name_node(-1, @names)
    let import_form: I64 = module.manifest + 4
    let export_form: I64 = syntax.ast_next(manifest_tokens, import_form)
    index_namespace_list(manifest_source, manifest_tokens, import_form + 2, imports, @names, @edges)
    index_namespace_list(manifest_source, manifest_tokens, export_form + 2, exports, @names, @edges)
    index_namespace_declarations(module.source, tokens, syntax.ast_module_items(module.root), declarations, @names, @edges)
    let roles: Vec[I64] = project_namespace_roles(module.source, tokens, module.root)
    vec.push(@modules, NamespaceModule(imports: imports, exports: exports, declarations: declarations, roles: roles))
    recur(manifest_source, manifest_tokens, tokens, loaded, index + 1, @names, @edges, @modules)

fn derive_namespace(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], tokens: Vec[syntax.Token], loaded: Vec[LoadedModule]) -> NamespaceView effects[alloc, partial]:
  let names: Vec[syntax.NameNode] = vec.new()
  let edges: Vec[syntax.NameEdge] = vec.new()
  let modules: Vec[NamespaceModule] = vec.new()
  let root: I64 = syntax.append_name_node(-1, @names)
  index_namespace_modules(manifest_source, manifest_tokens, tokens, loaded, 0, @names, @edges, @modules)
  NamespaceView(names: names, edges: edges, modules: modules)

fn namespace_lookup(source: Bytes, start: I64, end: I64, root: I64, namespace: NamespaceView) -> I64 effects[partial]:
  syntax.lookup_name_chars(source, start, end, root, namespace.names, namespace.edges)

fn namespace_target_kind(source: Bytes, tokens: Vec[syntax.Token], declaration: I64, role: I64, reference: I64) -> Bool effects[partial]:
  if declaration < 0:
    false
  else:
    let function: Bool = syntax.ast_item_is_function(source, tokens, declaration)
    let record: Bool = syntax.ast_item_is_record(source, tokens, declaration)
    let variant: Bool = syntax.ast_item_is_variant(source, tokens, declaration)
    if role == 1:
      let empty_record: Bool = if record:
        syntax.ast_list_done(tokens, syntax.ast_data_members_first(declaration)) && syntax.ast_list_done(tokens, syntax.ast_call_arguments(reference - 2))
      else:
        false
      function || empty_record
    else:
      if role == 3:
        record || variant
      else:
        let tag: I64 = syntax.ast_node_tag(tokens, reference - 2)
        if tag == 11:
          record
        else:
          variant

fn qualified_reference_status(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], tokens: Vec[syntax.Token], loaded: Vec[LoadedModule], namespace: NamespaceView, current_index: I64, reference: I64, role: I64) -> I64 effects[partial]:
  let current: LoadedModule = vec.get(loaded, current_index)
  let source: Bytes = current.source
  let start: I64 = syntax.ast_node_start(tokens, reference)
  let end: I64 = syntax.ast_node_end(tokens, reference)
  let dot: I64 = find_span_dot(source, start, end)
  if dot < 0:
    0
  else:
    let target_index: I64 = namespace_lookup(source, start, dot, 0, namespace)
    if target_index == current_index:
      1
    else:
      let metadata: NamespaceModule = vec.get(namespace.modules, current_index)
      let imported: I64 = namespace_lookup(source, start, dot, metadata.imports, namespace)
      if (target_index < 0) || (imported < 0):
        2
      else:
        let target_metadata: NamespaceModule = vec.get(namespace.modules, target_index)
        let exported: I64 = namespace_lookup(source, dot + 1, end, target_metadata.exports, namespace)
        if exported < 0:
          3
        else:
          let declaration: I64 = namespace_lookup(source, dot + 1, end, target_metadata.declarations, namespace)
          let target: LoadedModule = vec.get(loaded, target_index)
          if namespace_target_kind(target.source, tokens, declaration, role, reference):
            0
          else:
            3

fn find_invalid_namespace_reference(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], tokens: Vec[syntax.Token], loaded: Vec[LoadedModule], namespace: NamespaceView, index: I64, cursor: I64, end: I64) -> I64 effects[partial]:
  if cursor >= end:
    -1
  else:
    let current: LoadedModule = vec.get(loaded, index)
    let metadata: NamespaceModule = vec.get(namespace.modules, index)
    let role: I64 = vec.get(metadata.roles, cursor - current.root)
    let reference: Bool = (role == 1) || ((role == 3) || (role == 4))
    let status: I64 = if reference:
      qualified_reference_status(manifest_source, manifest_tokens, tokens, loaded, namespace, index, cursor, role)
    else:
      0
    if status > 0:
      cursor
    else:
      recur(manifest_source, manifest_tokens, tokens, loaded, namespace, index, syntax.ast_node_after(cursor), end)

fn report_namespace_references(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], tokens: Vec[syntax.Token], loaded: Vec[LoadedModule], namespace: NamespaceView, index: I64, report: @diagnostics.Reporter) -> I64 effects[alloc, io, partial]:
  if index >= vec.len(loaded):
    0
  else:
    let module: LoadedModule = vec.get(loaded, index)
    let metadata: NamespaceModule = vec.get(namespace.modules, index)
    let first: I64 = syntax.ast_module_items(module.root)
    let end: I64 = syntax.ast_next(tokens, module.root)
    let invalid: I64 = find_invalid_namespace_reference(manifest_source, manifest_tokens, tokens, loaded, namespace, index, first, end)
    if invalid >= 0:
      let role: I64 = vec.get(metadata.roles, invalid - module.root)
      let status: I64 = qualified_reference_status(manifest_source, manifest_tokens, tokens, loaded, namespace, index, invalid, role)
      let code: Bytes = if status == 1:
        "E0417"
      else:
        if status == 2:
          "E0416"
        else:
          "E0415"
      let diagnostic_node: I64 = if role == 3:
        invalid
      else:
        invalid - 2
      let start: I64 = syntax.ast_node_start(tokens, diagnostic_node)
      let closing: I64 = syntax.ast_next(tokens, diagnostic_node) - 1
      let diagnostic_end: I64 = if role == 3:
        syntax.ast_node_end(tokens, invalid)
      else:
        syntax.ast_node_end(tokens, closing)
      let module_name: Bytes = token_bytes(manifest_source, manifest_tokens, module.name)
      emit_project_diagnostic(@report, "module", module.source, code, module_name, start, diagnostic_end)
    else:
      recur(manifest_source, manifest_tokens, tokens, loaded, namespace, index + 1, @report)

fn report_loaded_project(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], entry: I64, module_tokens: Vec[syntax.Token], loaded: Vec[LoadedModule], namespace: NamespaceView) -> I64 effects[alloc, io, partial]:
  let report: diagnostics.Reporter = diagnostics.raw(true)
  report_loaded_project_report(manifest_source, manifest_tokens, entry, module_tokens, loaded, namespace, @report)

fn report_loaded_project_report(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], entry: I64, module_tokens: Vec[syntax.Token], loaded: Vec[LoadedModule], namespace: NamespaceView, report: @diagnostics.Reporter) -> I64 effects[alloc, io, partial]:
  let identities: I64 = report_module_identities(manifest_source, manifest_tokens, module_tokens, loaded, 0, @report)
  let invalid_identity: Bool = identities > 0
  if invalid_identity:
    identities
  else:
    let exports: I64 = report_missing_exports(manifest_source, manifest_tokens, module_tokens, loaded, 0, @report)
    let invalid_export: Bool = exports > 0
    if invalid_export:
      exports
    else:
      let mains: I64 = report_project_mains(manifest_source, manifest_tokens, entry, module_tokens, loaded, 0, @report)
      let invalid_main: Bool = mains > 0
      if invalid_main:
        mains
      else:
        let calls: I64 = report_namespace_references(manifest_source, manifest_tokens, module_tokens, loaded, namespace, 0, @report)
        let invalid_call: Bool = calls > 0
        if invalid_call:
          calls
        else:
          report_private_type_leaks(manifest_source, manifest_tokens, module_tokens, loaded, @report)

fn report_interface_type(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], first_export: I64, module_name: Bytes, module_source: Bytes, module_tokens: Vec[syntax.Token], module_items: I64, type_index: I64, diagnostic_start: I64, diagnostic_end: I64, report: @diagnostics.Reporter) -> I64 effects[alloc, io, partial]:
  let kind: I64 = syntax.ast_node_kind(module_tokens, type_index)
  let composite: Bool = kind == 0
  if composite:
    let inner: I64 = syntax.ast_type_argument(type_index)
    report_interface_type(manifest_source, manifest_tokens, first_export, module_name, module_source, module_tokens, module_items, inner, diagnostic_start, diagnostic_end, @report)
  else:
    let scalar_kind: I64 = syntax.scalar_type_kind(module_source, module_tokens, type_index)
    let scalar: Bool = scalar_kind >= 0
    if scalar:
      0
    else:
      let start: I64 = syntax.ast_node_start(module_tokens, type_index)
      let end: I64 = syntax.ast_node_end(module_tokens, type_index)
      let dots: I64 = syntax.span_count_byte(module_source, start, end, 46, 0)
      let qualified: Bool = dots > 0
      if qualified:
        0
      else:
        let declaration: I64 = find_declaration_segment(module_source, module_tokens, module_items, module_source, start, end)
        let found: Bool = declaration >= 0
        let record_item: Bool = if found:
          syntax.ast_item_is_record(module_source, module_tokens, declaration)
        else:
          false
        let variant_item: Bool = if found:
          syntax.ast_item_is_variant(module_source, module_tokens, declaration)
        else:
          false
        let type_item: Bool = record_item || variant_item
        let exported: Bool = exports_has_segment(manifest_source, manifest_tokens, first_export, module_source, start, end)
        let valid: Bool = type_item && exported
        if valid:
          0
        else:
          emit_project_diagnostic(@report, "manifest", manifest_source, "E0418", module_name, diagnostic_start, diagnostic_end)

fn report_interface_bindings(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], first_export: I64, module_name: Bytes, module_source: Bytes, module_tokens: Vec[syntax.Token], module_items: I64, cursor: I64, diagnostic_start: I64, diagnostic_end: I64, count: I64, report: @diagnostics.Reporter) -> I64 effects[alloc, io, partial]:
  let kind: I64 = syntax.ast_node_kind(module_tokens, cursor)
  let done: Bool = kind == 1
  if done:
    count
  else:
    let type_index: I64 = syntax.ast_binding_type(module_source, module_tokens, cursor)
    let reported: I64 = report_interface_type(manifest_source, manifest_tokens, first_export, module_name, module_source, module_tokens, module_items, type_index, diagnostic_start, diagnostic_end, @report)
    let next: I64 = syntax.ast_next(module_tokens, cursor)
    let total: I64 = count + reported
    recur(manifest_source, manifest_tokens, first_export, module_name, module_source, module_tokens, module_items, next, diagnostic_start, diagnostic_end, total, @report)

fn report_interface_fields(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], first_export: I64, module_name: Bytes, module_source: Bytes, module_tokens: Vec[syntax.Token], module_items: I64, cursor: I64, diagnostic_start: I64, diagnostic_end: I64, count: I64, report: @diagnostics.Reporter) -> I64 effects[alloc, io, partial]:
  let kind: I64 = syntax.ast_node_kind(module_tokens, cursor)
  let done: Bool = kind == 1
  if done:
    count
  else:
    let type_index: I64 = syntax.ast_member_value(cursor)
    let reported: I64 = report_interface_type(manifest_source, manifest_tokens, first_export, module_name, module_source, module_tokens, module_items, type_index, diagnostic_start, diagnostic_end, @report)
    let next: I64 = syntax.ast_next(module_tokens, cursor)
    let total: I64 = count + reported
    recur(manifest_source, manifest_tokens, first_export, module_name, module_source, module_tokens, module_items, next, diagnostic_start, diagnostic_end, total, @report)

fn report_interface_payload(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], first_export: I64, module_name: Bytes, module_source: Bytes, module_tokens: Vec[syntax.Token], module_items: I64, cursor: I64, diagnostic_start: I64, diagnostic_end: I64, count: I64, report: @diagnostics.Reporter) -> I64 effects[alloc, io, partial]:
  let kind: I64 = syntax.ast_node_kind(module_tokens, cursor)
  let done: Bool = kind == 1
  if done:
    count
  else:
    let reported: I64 = report_interface_type(manifest_source, manifest_tokens, first_export, module_name, module_source, module_tokens, module_items, cursor, diagnostic_start, diagnostic_end, @report)
    let next: I64 = syntax.ast_next(module_tokens, cursor)
    let total: I64 = count + reported
    recur(manifest_source, manifest_tokens, first_export, module_name, module_source, module_tokens, module_items, next, diagnostic_start, diagnostic_end, total, @report)

fn report_interface_cases(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], first_export: I64, module_name: Bytes, module_source: Bytes, module_tokens: Vec[syntax.Token], module_items: I64, cursor: I64, diagnostic_start: I64, diagnostic_end: I64, count: I64, report: @diagnostics.Reporter) -> I64 effects[alloc, io, partial]:
  let kind: I64 = syntax.ast_node_kind(module_tokens, cursor)
  let done: Bool = kind == 1
  if done:
    count
  else:
    let first_type: I64 = syntax.ast_member_value(cursor)
    let reported: I64 = report_interface_payload(manifest_source, manifest_tokens, first_export, module_name, module_source, module_tokens, module_items, first_type, diagnostic_start, diagnostic_end, 0, @report)
    let next: I64 = syntax.ast_next(module_tokens, cursor)
    let total: I64 = count + reported
    recur(manifest_source, manifest_tokens, first_export, module_name, module_source, module_tokens, module_items, next, diagnostic_start, diagnostic_end, total, @report)

fn report_export_interfaces(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], first_export: I64, module_name: Bytes, module_source: Bytes, module_tokens: Vec[syntax.Token], module_items: I64, cursor: I64, count: I64, report: @diagnostics.Reporter) -> I64 effects[alloc, io, partial]:
  let kind: I64 = syntax.ast_node_kind(manifest_tokens, cursor)
  let done: Bool = kind == 1
  if done:
    count
  else:
    let item: I64 = find_export_declaration(manifest_source, manifest_tokens, cursor, module_source, module_tokens, module_items)
    let diagnostic_start: I64 = syntax.ast_node_start(manifest_tokens, cursor)
    let diagnostic_end: I64 = syntax.ast_node_end(manifest_tokens, cursor)
    let function_item: Bool = syntax.ast_item_is_function(module_source, module_tokens, item)
    let reported: I64 = if function_item:
      let params: I64 = syntax.ast_function_parameters(item)
      let first_parameter: I64 = syntax.ast_parameters_first(params)
      let parameter_errors: I64 = report_interface_bindings(manifest_source, manifest_tokens, first_export, module_name, module_source, module_tokens, module_items, first_parameter, diagnostic_start, diagnostic_end, 0, @report)
      let return_type: I64 = syntax.ast_function_return_type(module_tokens, item)
      let return_errors: I64 = report_interface_type(manifest_source, manifest_tokens, first_export, module_name, module_source, module_tokens, module_items, return_type, diagnostic_start, diagnostic_end, @report)
      parameter_errors + return_errors
    else:
      let record_item: Bool = syntax.ast_item_is_record(module_source, module_tokens, item)
      let body: I64 = syntax.ast_data_body(item)
      let first_member: I64 = syntax.ast_data_members_first(item)
      if record_item:
        report_interface_fields(manifest_source, manifest_tokens, first_export, module_name, module_source, module_tokens, module_items, first_member, diagnostic_start, diagnostic_end, 0, @report)
      else:
        report_interface_cases(manifest_source, manifest_tokens, first_export, module_name, module_source, module_tokens, module_items, first_member, diagnostic_start, diagnostic_end, 0, @report)
    let next: I64 = syntax.ast_node_after(cursor)
    let total: I64 = count + reported
    recur(manifest_source, manifest_tokens, first_export, module_name, module_source, module_tokens, module_items, next, total, @report)

fn report_private_type_leaks_from(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], module_tokens: Vec[syntax.Token], loaded: Vec[LoadedModule], index: I64, count: I64, report: @diagnostics.Reporter) -> I64 effects[alloc, io, partial]:
  let length: I64 = vec.len(loaded)
  let done: Bool = index >= length
  if done:
    count
  else:
    let module: LoadedModule = vec.get(loaded, index)
    let manifest: I64 = module.manifest
    let name: I64 = module.name
    let module_name: Bytes = token_bytes(manifest_source, manifest_tokens, name)
    let imports: I64 = manifest + 4
    let exports: I64 = syntax.ast_next(manifest_tokens, imports)
    let first_export: I64 = exports + 2
    let source: Bytes = module.source
    let root: I64 = module.root
    let module_items: I64 = syntax.ast_module_items(root)
    let reported: I64 = report_export_interfaces(manifest_source, manifest_tokens, first_export, module_name, source, module_tokens, module_items, first_export, 0, @report)
    let next: I64 = index + 1
    let total: I64 = count + reported
    recur(manifest_source, manifest_tokens, module_tokens, loaded, next, total, @report)

fn report_private_type_leaks(manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], module_tokens: Vec[syntax.Token], loaded: Vec[LoadedModule], report: @diagnostics.Reporter) -> I64 effects[alloc, io, partial]:
  let errors: I64 = report_private_type_leaks_from(manifest_source, manifest_tokens, module_tokens, loaded, 0, 0, @report)
  let invalid: Bool = errors > 0
  if invalid:
    1
  else:
    0

fn bounded_token(source: Bytes, tokens: Vec[syntax.Token], node: I64) -> Bytes effects[alloc, partial]:
  let start: I64 = syntax.ast_node_start(tokens, node)
  let end: I64 = syntax.ast_node_end(tokens, node)
  if (end - start) <= 256:
    token_bytes(source, tokens, node)
  else:
    ""

fn diagnostic_module_source(report: diagnostics.Reporter, manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], path: I64, label: Bytes, content: Bytes) -> diagnostics.Source effects[alloc, partial]:
  let prefix: I64 = last_path_slash(report.path, 0, bytes.len(report.path), 0)
  let path_length: I64 = (syntax.ast_node_end(manifest_tokens, path) - syntax.ast_node_start(manifest_tokens, path)) - 2
  let length: I64 = if path_length <= (9223372036854775807 - prefix):
    prefix + path_length
  else:
    -1
  let pathname: Bytes = if (length >= 0) && (length <= 256):
    project_module_path(report.path, manifest_source, manifest_tokens, path)
  else:
    ""
  let file: diagnostics.Source = diagnostics.source("module", label, pathname, content, true)
  diagnostics.Source(kind: file.kind, label: file.label, path: file.path, content: file.content, available: true, identity_bytes: file.identity_bytes, path_bytes: length)

fn report_files(report: diagnostics.Reporter, manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], loaded: Vec[LoadedModule], index: I64, files: @Vec[diagnostics.Source]) -> Void effects[alloc, partial]:
  if index >= vec.len(loaded):
    void
  else:
    let module: LoadedModule = vec.get(loaded, index)
    let label: Bytes = bounded_token(manifest_source, manifest_tokens, module.name)
    let file: diagnostics.Source = diagnostic_module_source(report, manifest_source, manifest_tokens, module.path, label, module.source)
    let length: I64 = syntax.ast_node_end(manifest_tokens, module.name) - syntax.ast_node_start(manifest_tokens, module.name)
    vec.push(@files, diagnostics.Source(kind: file.kind, label: file.label, path: file.path, content: file.content, available: file.available, identity_bytes: length, path_bytes: file.path_bytes))
    recur(report, manifest_source, manifest_tokens, loaded, index + 1, @files)

fn install_report_files(report: @diagnostics.Reporter, manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], loaded: Vec[LoadedModule]) -> Void effects[alloc, partial]:
  let files: Vec[diagnostics.Source] = vec.new()
  report_files(report, manifest_source, manifest_tokens, loaded, 0, @files)
  let previous: Vec[diagnostics.Source] = mem.replace(@report.files, files)
  void

fn install_report_origins(report: @diagnostics.Reporter, origins: Vec[Origin], index: I64) -> Void effects[alloc, partial]:
  if index >= vec.len(origins):
    void
  else:
    let value: Origin = vec.get(origins, index)
    let output: Vec[diagnostics.Mapping] = mem.replace(@report.origins, vec.new())
    vec.push(@output, diagnostics.Mapping(file: value.module, start: value.start, end: value.end))
    let previous: Vec[diagnostics.Mapping] = mem.replace(@report.origins, output)
    recur(@report, origins, index + 1)

fn find_report_source(report: diagnostics.Reporter, label: Bytes, content: Bytes, index: I64) -> diagnostics.Source effects[partial]:
  if index >= vec.len(report.files):
    diagnostics.source("module", label, "", content, true)
  else:
    let file: diagnostics.Source = vec.get(report.files, index)
    if syntax.span_equal(label, 0, bytes.len(label), file.label):
      file
    else:
      recur(report, label, content, index + 1)

fn emit_project_diagnostic(report: @diagnostics.Reporter, kind: Bytes, content: Bytes, code: Bytes, label: Bytes, start: I64, end: I64) -> I64 effects[alloc, io, partial]:
  if report.json:
    let manifest: Bool = syntax.span_equal(kind, 0, bytes.len(kind), "manifest")
    let file: diagnostics.Source = if manifest:
      diagnostics.source("manifest", "-", report.path, content, true)
    else:
      find_report_source(report, label, content, 0)
    diagnostics.emit_source(@report, code, label, file, start, end, typing.empty_repair())
  else:
    report_project_diagnostic(code, label, start, end)

fn emit_parsed_module(report: @diagnostics.Reporter, manifest_source: Bytes, manifest_tokens: Vec[syntax.Token], path: I64, content: Bytes, code: Bytes, label: Bytes, start: I64, end: I64, repair: typing.Repair) -> I64 effects[alloc, io, partial]:
  if report.json:
    let file: diagnostics.Source = diagnostic_module_source(report, manifest_source, manifest_tokens, path, label, content)
    diagnostics.emit_source(@report, code, label, file, start, end, repair)
  else:
    report_project_diagnostic(code, label, start, end)

fn emit_manifest_read_failure(report: @diagnostics.Reporter, code: Bytes, label: Bytes, start: I64, end: I64) -> I64 effects[alloc, io, partial]:
  if report.json:
    let file: diagnostics.Source = diagnostics.source("manifest", "-", report.path, "", false)
    diagnostics.emit_source(@report, code, label, file, start, end, typing.empty_repair())
  else:
    report_project_diagnostic(code, label, start, end)

fn check_project_json(path: Bytes) -> I64 effects[alloc, io, partial]:
  let report: diagnostics.Reporter = diagnostics.json_reporter(path, true)
  let previous: retained.Cache = retained.empty_cache()
  let revision: identity.Revision = identity.Revision(epoch: 0, serial: 0)
  let attempt: ProjectAttempt = prepare_project_attempt_report(path, false, previous, revision, 0, @report)
  attempt.prepared.status
