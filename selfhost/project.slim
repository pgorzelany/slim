fn report_project_issue(issue: typing/Issue inout origins: Vec[Origin] manifest_source: Bytes inout manifest_tokens: Vec[syntax/Token] inout loaded: Vec[LoadedModule]) -> I64 effects[alloc io partial]:
  let start_origin: Origin = vec.get(origins get(issue start))
  let end_origin: Origin = vec.get(origins get(issue end))
  let module_index: I64 = get(start_origin module)
  let synthetic: Bool = i64.lt(module_index 0)
  match synthetic:
    true:
      report_project_diagnostic(get(issue code) "-" get(start_origin start) get(end_origin end))
    false:
      let module: LoadedModule = vec.get(loaded module_index)
      let name: I64 = get(module name)
      let module_name: Bytes = token_bytes(manifest_source manifest_tokens name)
      report_project_diagnostic(get(issue code) module_name get(start_origin start) get(end_origin end))

fn report_project_issues(inout issues: Vec[typing/Issue] index: I64 inout origins: Vec[Origin] manifest_source: Bytes inout manifest_tokens: Vec[syntax/Token] inout loaded: Vec[LoadedModule] count: I64) -> I64 effects[alloc io partial]:
  let length: I64 = vec.len(issues)
  let done: Bool = i64.ge(index length)
  match done:
    true:
      count
    false:
      let issue: typing/Issue = vec.get(issues index)
      let reported: I64 = report_project_issue(issue origins manifest_source manifest_tokens loaded)
      let next: I64 = i64.add(index 1)
      let total: I64 = i64.add(count reported)
      recur(issues next origins manifest_source manifest_tokens loaded total)

fn prepare_loaded_project(manifest_source: Bytes manifest_tokens: Vec[syntax/Token] entry: I64 inout module_tokens: Vec[syntax/Token] inout loaded: Vec[LoadedModule]) -> PreparedProject effects[alloc io partial]:
  let origins: Vec[Origin] = vec.new()
  let tokens: Vec[syntax/Token] = vec.new()
  let source: Bytes = flatten_loaded_project(manifest_source manifest_tokens entry module_tokens loaded tokens origins)
  let checked: typing/Checked = check/check_source_deferred(source tokens)
  let status: I64 = get(checked status)
  let view: typing/View = get(checked view)
  let facts: Vec[typing/Fact] = get(view facts)
  let issues: Vec[typing/Issue] = get(checked issues)
  let plan: memory/Plan = get(checked plan)
  let reported: I64 = report_project_issues(issues 0 origins manifest_source manifest_tokens loaded 0)
  make PreparedProject(status = status source = source tokens = tokens origins = origins manifest_source = manifest_source manifest_tokens = manifest_tokens facts = facts issues = issues plan = plan)

fn prepare_project_path(path: Bytes) -> PreparedProject effects[alloc io partial]:
  let source_bytes: Vec[U8] = vec.new()
  let source_read: Bool = io.read-file(path source_bytes)
  let source: Bytes = bytes.freeze(source_bytes)
  let tokens: Vec[syntax/Token] = vec.new()
  match source_read:
    false:
      let reported: I64 = report_project_diagnostic("E0409" "-" 0 0)
      invalid_prepared_project(1)
    true:
      let tokenized: Unit = syntax/lex_data(source 0 tokens)
      let version: I64 = 2
      let valid_version: Bool = syntax/ast_node_text_is(source tokens version "1")
      match valid_version:
        false:
          let start: I64 = syntax/ast_node_start(tokens version)
          let end: I64 = syntax/ast_node_end(tokens version)
          let reported: I64 = report_project_diagnostic("E0402" "-" start end)
          invalid_prepared_project(1)
        true:
          let entry_form: I64 = 3
          let entry: I64 = i64.add(entry_form 2)
          let modules: I64 = syntax/ast_next(tokens entry_form)
          let manifest_errors: I64 = report_manifest_rules(source tokens entry_form modules)
          let invalid_manifest: Bool = i64.gt(manifest_errors 0)
          match invalid_manifest:
            true:
              invalid_prepared_project(manifest_errors)
            false:
              let cycle: I64 = find_reciprocal_cycle(source tokens modules modules)
              let has_cycle: Bool = i64.ge(cycle 0)
              match has_cycle:
                true:
                  let start: I64 = syntax/ast_node_start(tokens cycle)
                  let end: I64 = syntax/ast_node_end(tokens cycle)
                  let reported: I64 = report_project_diagnostic("E0413" "-" start end)
                  invalid_prepared_project(1)
                false:
                  let module_tokens: Vec[syntax/Token] = vec.new()
                  let loaded: Vec[LoadedModule] = vec.new()
                  let loaded_modules: I64 = load_project_modules(path source tokens modules module_tokens loaded)
                  let invalid_loading: Bool = i64.gt(loaded_modules 0)
                  match invalid_loading:
                    true:
                      invalid_prepared_project(loaded_modules)
                    false:
                      let project_errors: I64 = report_loaded_project(source tokens entry module_tokens loaded)
                      let invalid_project: Bool = i64.gt(project_errors 0)
                      match invalid_project:
                        true:
                          invalid_prepared_project(project_errors)
                        false:
                          prepare_loaded_project(source tokens entry module_tokens loaded)

fn check_project_path(path: Bytes) -> I64 effects[alloc io partial]:
  let prepared: PreparedProject = prepare_project_path(path)
  get(prepared status)

fn append_interface_type(manifest_source: Bytes inout manifest_tokens: Vec[syntax/Token] module_name: I64 module_source: Bytes inout module_tokens: Vec[syntax/Token] type_index: I64 inout output: Vec[U8]) -> Unit effects[alloc partial]:
  let kind: I64 = syntax/ast_node_kind(module_tokens type_index)
  let composite: Bool = i64.eq(kind 0)
  match composite:
