  let done: Bool = i64.ge(index length)
  match done:
    true:
      unit
    false:
      let module: LoadedModule = vec.get(loaded index)
      let module_name: I64 = get(module name)
      let module_source: Bytes = get(module source)
      let root: I64 = get(module root)
      let module_items: I64 = syntax/ast_module_items(root)
      let next_form: I64 = syntax/ast_next(module_tokens root)
      let end: I64 = i64.sub(next_form 1)
      let module_name_start: I64 = syntax/ast_node_start(manifest_tokens module_name)
      let module_name_end: I64 = syntax/ast_node_end(manifest_tokens module_name)
      let entry_name_start: I64 = syntax/ast_node_start(manifest_tokens entry_name)
      let entry_name_end: I64 = syntax/ast_node_end(manifest_tokens entry_name)
      let entry: Bool = syntax/spans_equal(manifest_source module_name_start module_name_end entry_name_start entry_name_end)
      let appended: Unit = append_project_tokens(manifest_source manifest_tokens module_name module_source module_tokens module_items entry index module_items end output flat_tokens origins)
      let next: I64 = i64.add(index 1)
      recur(manifest_source manifest_tokens entry_name module_tokens loaded next output flat_tokens origins)

fn flatten_loaded_project(manifest_source: Bytes inout manifest_tokens: Vec[syntax/Token] entry_name: I64 inout module_tokens: Vec[syntax/Token] inout loaded: Vec[LoadedModule] inout tokens: Vec[syntax/Token] inout origins: Vec[Origin]) -> Bytes effects[alloc partial]:
  let atom_source: Vec[U8] = vec.new()
  let flat_tokens: Vec[syntax/Token] = vec.new()
  let opened: Unit = push_flat_token(0 1 0 0 flat_tokens)
  let synthetic_open: Unit = append_origin(-1 0 0 origins)
  let marker: Unit = push_flat_token(2 0 0 0 flat_tokens)
  let synthetic_module: Unit = append_origin(-1 0 0 origins)
  let name_start: I64 = vec.len(atom_source)
  let project_name: Unit = text/append_text(atom_source "project")
  let name_end: I64 = vec.len(atom_source)
  let name: Unit = push_flat_token(2 0 name_start name_end flat_tokens)
  let synthetic_name: Unit = append_origin(-1 0 0 origins)
  let modules: Unit = append_loaded_project_modules(manifest_source manifest_tokens entry_name module_tokens loaded 0 atom_source flat_tokens origins)
  let close_position: I64 = vec.len(atom_source)
  let closed: Unit = push_flat_token(1 0 close_position close_position flat_tokens)
  let synthetic_close: Unit = append_origin(-1 0 0 origins)
  let atoms: Bytes = bytes.freeze(atom_source)
  let indexed: Unit = syntax/index_ast_boundaries(flat_tokens)
  let output: Vec[U8] = vec.new()
  let formatted: Unit = format/emit_module(atoms flat_tokens output)
  let source: Bytes = bytes.freeze(output)
  let parsed: Bool = syntax/parse_program(source tokens)
  source

fn path_is_project(path: Bytes) -> Bool effects[alloc io partial]:
  let source_bytes: Vec[U8] = vec.new()
  let source_read: Bool = io.read-file(path source_bytes)
  let source: Bytes = bytes.freeze(source_bytes)
  let length: I64 = bytes.len(source)
  let available: Bool = i64.gt(length 0)
  let legacy: Bool = match available:
    false:
      false
    true:
      let first: U8 = bytes.get(source 0)
      i64.eq(u8.to-i64(first) 40)
  match legacy:
    false:
      false
    true:
      let tokens: Vec[syntax/Token] = vec.new()
      let tokenized: Unit = syntax/lex_data(source 0 tokens)
      syntax/ast_node_text_is(source tokens 1 "project")

