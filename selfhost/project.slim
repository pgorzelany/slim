fn path_segment_valid(source: Bytes start: I64 end: I64) -> Bool effects[partial]:
  let length: I64 = i64.sub(end start)
  let nonempty: Bool = i64.gt(length 0)
  match nonempty:
    false:
      false
    true:
      let dot: Bool = syntax/span_equal(source start end ".")
      let parent: Bool = syntax/span_equal(source start end "..")
      let special: Bool = bool.or(dot parent)
      bool.not(special)

fn path_segments_valid(source: Bytes index: I64 end: I64 segment_start: I64) -> Bool effects[partial]:
  let done: Bool = i64.ge(index end)
  match done:
    true:
      path_segment_valid(source segment_start end)
    false:
      let byte: U8 = bytes.get(source index)
      let code: I64 = u8.to-i64(byte)
      let backslash: Bool = i64.eq(code 92)
      match backslash:
        true:
          false
        false:
          let slash: Bool = i64.eq(code 47)
          match slash:
            true:
              let valid: Bool = path_segment_valid(source segment_start index)
              match valid:
                false:
                  false
                true:
                  let next: I64 = i64.add(index 1)
                  recur(source next end next)
            false:
              let next: I64 = i64.add(index 1)
              recur(source next end segment_start)

fn path_token_invalid(source: Bytes inout tokens: Vec[syntax/Token] path: I64) -> Bool effects[partial]:
