fn cross_span_chars_equal(left: Bytes left_start: I64 right: Bytes right_start: I64 index: I64 length: I64) -> Bool effects[partial]:
  let done: Bool = i64.eq(index length)
  match done:
    true:
      true
    false:
      let left_index: I64 = i64.add(left_start index)
      let right_index: I64 = i64.add(right_start index)
      let left_byte: U8 = bytes.get(left left_index)
      let right_byte: U8 = bytes.get(right right_index)
      let left_code: I64 = u8.to-i64(left_byte)
      let right_code: I64 = u8.to-i64(right_byte)
      let same: Bool = i64.eq(left_code right_code)
      match same:
        true:
          let next: I64 = i64.add(index 1)
          recur(left left_start right right_start next length)
        false:
          false

fn cross_spans_equal(left: Bytes left_start: I64 left_end: I64 right: Bytes right_start: I64 right_end: I64) -> Bool effects[partial]:
  let left_length: I64 = i64.sub(left_end left_start)
  let right_length: I64 = i64.sub(right_end right_start)
  let same_length: Bool = i64.eq(left_length right_length)
  match same_length:
    true:
      cross_span_chars_equal(left left_start right right_start 0 left_length)
    false:
      false

fn last_path_slash(path: Bytes index: I64 length: I64 last: I64) -> I64 effects[partial]:
  let done: Bool = i64.ge(index length)
  match done:
    true:
      last
    false:
      let byte: U8 = bytes.get(path index)
      let code: I64 = u8.to-i64(byte)
      let slash: Bool = i64.eq(code 47)
      let next_last: I64 = match slash:
        true:
          i64.add(index 1)
        false:
          last
      let next: I64 = i64.add(index 1)
      recur(path next length next_last)

fn project_module_path(manifest_path: Bytes manifest_source: Bytes inout manifest_tokens: Vec[syntax/Token] path_token: I64) -> Bytes effects[alloc partial]:
  let output: Vec[U8] = vec.new()
  let manifest_length: I64 = bytes.len(manifest_path)
  let prefix_end: I64 = last_path_slash(manifest_path 0 manifest_length 0)
  let prefix: Unit = text/append_span(manifest_path 0 prefix_end output)
  let token_start_index: I64 = syntax/ast_node_start(manifest_tokens path_token)
  let content_start: I64 = i64.add(token_start_index 1)
  let token_end_index: I64 = syntax/ast_node_end(manifest_tokens path_token)
  let content_end: I64 = i64.sub(token_end_index 1)
  let path: Unit = text/append_span(manifest_source content_start content_end output)
  bytes.freeze(output)

fn append_slash_replaced(source: Bytes index: I64 end: I64 inout output: Vec[U8]) -> Unit effects[alloc partial]:
  let done: Bool = i64.ge(index end)
  match done:
    true:
      unit
    false:
      let byte: U8 = bytes.get(source index)
      let code: I64 = u8.to-i64(byte)
      let slash: Bool = i64.eq(code 47)
      let emitted: Unit = match slash:
        true:
          text/append_text(output "_")
        false:
          vec.push(output byte)
      let next: I64 = i64.add(index 1)
      recur(source next end output)

fn append_project_atom(manifest_source: Bytes inout manifest_tokens: Vec[syntax/Token] module_name: I64 module_source: Bytes inout module_tokens: Vec[syntax/Token] module_items: I64 entry: Bool atom: I64 inout output: Vec[U8]) -> Unit effects[alloc partial]:
  let start: I64 = syntax/ast_node_start(module_tokens atom)
  let end: I64 = syntax/ast_node_end(module_tokens atom)
  let synthetic: Bool = i64.eq(start end)
  match synthetic:
    true:
      let parent: I64 = i64.sub(atom 1)
      let tag: I64 = syntax/ast_node_tag(module_tokens parent)
      let call_marker: Bool = i64.eq(tag 10)
      match call_marker:
        true:
          text/append_text(output "call")
        false:
          text/append_text(output "effects")
    false:
      let slashes: I64 = syntax/span_count_byte(module_source start end 47 0)
      let qualified: Bool = i64.gt(slashes 0)
      match qualified:
        true:
          append_slash_replaced(module_source start end output)
        false:
          let declaration_form: I64 = syntax/ast_node_link(module_tokens atom)
          let declaration: Bool = i64.ge(declaration_form 0)
          let main_name: Bool = syntax/ast_node_text_is(module_source module_tokens atom "main")
          let entry_main: Bool = bool.and(entry main_name)
          let prefix: Bool = match declaration:
            true:
              bool.not(entry_main)
            false:
              false
          match prefix:
            true:
              let named: Unit = text/append_token(manifest_source manifest_tokens module_name output)
              let separator: Unit = text/append_text(output "_")
              text/append_token(module_source module_tokens atom output)
            false:
              text/append_token(module_source module_tokens atom output)

