fn push_flat_token(kind: I64 tag: I64 start: I64 end: I64 inout tokens: Vec[syntax/Token]) -> Unit effects[alloc]:
  let token: syntax/Token = make syntax/Token(kind = kind tag = tag start = start end = end link = -1 next = -1)
