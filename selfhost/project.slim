fn compile_project_path_jobs(path: Bytes jobs: I64) -> I64 effects[alloc io partial]:
  let prepared: PreparedProject = prepare_project_path(path)
  let status: I64 = get(prepared status)
  let invalid: Bool = i64.gt(status 0)
  match invalid:
    true:
      status
    false:
      let manifest_source: Bytes = get(prepared manifest_source)
      let manifest_tokens: Vec[syntax/Token] = get(prepared manifest_tokens)
      let schedule: scheduler/Schedule = scheduler/plan(manifest_source manifest_tokens jobs)
      let schedule_valid: Bool = get(schedule valid)
      match schedule_valid:
        false:
          70
        true:
          let generated: Bytes = generate_prepared_project(prepared)
          let shown: Unit = io.print-bytes(generated)
          0

fn compile_project_path(path: Bytes) -> I64 effects[alloc io partial]:
