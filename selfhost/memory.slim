module memory

struct ValuePlan:
  name: I64
  type_index: I64
  storage: I64
  borrowed: Bool
  declared: I64
  last_use: I64
  escape: I64

struct AllocationPlan:
  site: I64
  region: I64

struct DestructionPlan:
  region: I64
  end: I64
  reverse: Bool

struct FunctionPlan:
  function: I64
  return_storage: I64
  local_region: Bool
  recursive: Bool
  liveness_precise: Bool
  values: Vec[ValuePlan]
  allocations: Vec[AllocationPlan]
  destructions: Vec[DestructionPlan]
  escaping_values: I64

struct Plan:
  functions: Vec[FunctionPlan]

fn function_plan_allocates(plan: FunctionPlan) -> Bool:
  let allocations: Vec[AllocationPlan] = plan.allocations
  let count: I64 = vec.len(allocations)
  count > 0

fn allocation_site_region_range(allocations: Vec[AllocationPlan], site: I64, low: I64, high: I64) -> I64 effects[partial]:
  let done: Bool = low >= high
  if done:
    -1
  else:
    let distance: I64 = high - low
    let half: I64 = distance / 2
    let middle: I64 = low + half
    let plan: AllocationPlan = vec.get(allocations, middle)
    let planned_site: I64 = plan.site
    let same: Bool = site == planned_site
    if same:
      plan.region
    else:
      let before: Bool = site < planned_site
      if before:
        recur(allocations, site, low, middle)
      else:
        let next: I64 = middle + 1
        recur(allocations, site, next, high)

fn allocation_site_region(allocations: Vec[AllocationPlan], site: I64) -> I64 effects[partial]:
  let count: I64 = vec.len(allocations)
  allocation_site_region_range(allocations, site, 0, count)

fn span_has_recur(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, end: I64) -> Bool effects[partial]:
  let done: Bool = cursor >= end
  if done:
    false
  else:
    let same: Bool = syntax.ast_expression_is_recur(source, tokens, cursor)
    if same:
      true
    else:
      let next: I64 = syntax.ast_node_after(cursor)
      recur(source, tokens, next, end)

fn empty_plan() -> Plan effects[alloc]:
  let functions: Vec[FunctionPlan] = vec.new()
  Plan(functions: functions)

fn storage_join(left: I64, right: I64) -> I64:
  let left_greater: Bool = left > right
  if left_greater:
    left
  else:
    right

fn record_storage(source: Bytes, tokens: Vec[syntax.Token], module_items: I64, cursor: I64, depth: I64, current: I64) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    current
  else:
    let type_index: I64 = syntax.ast_member_value(cursor)
    let storage: I64 = type_storage_kind_from(source, tokens, module_items, type_index, depth)
    let joined: I64 = storage_join(current, storage)
    let owned: Bool = joined == 2
    if owned:
      2
    else:
      let next: I64 = syntax.ast_next(tokens, cursor)
      recur(source, tokens, module_items, next, depth, joined)

fn payload_storage(source: Bytes, tokens: Vec[syntax.Token], module_items: I64, cursor: I64, depth: I64, current: I64) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    current
  else:
    let storage: I64 = type_storage_kind_from(source, tokens, module_items, cursor, depth)
    let joined: I64 = storage_join(current, storage)
    let owned: Bool = joined == 2
    if owned:
      2
    else:
      let next: I64 = syntax.ast_next(tokens, cursor)
      recur(source, tokens, module_items, next, depth, joined)

fn variant_storage(source: Bytes, tokens: Vec[syntax.Token], module_items: I64, cursor: I64, depth: I64, current: I64) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    current
  else:
    let payload: I64 = syntax.ast_member_value(cursor)
    let storage: I64 = payload_storage(source, tokens, module_items, payload, depth, current)
    let owned: Bool = storage == 2
    if owned:
      2
    else:
      let next: I64 = syntax.ast_next(tokens, cursor)
      recur(source, tokens, module_items, next, depth, storage)

fn type_storage_kind_from(source: Bytes, tokens: Vec[syntax.Token], module_items: I64, type_index: I64, depth: I64) -> I64 effects[partial]:
  let too_deep: Bool = depth >= 64
  if too_deep:
    2
  else:
    let kind: I64 = syntax.ast_node_kind(tokens, type_index)
    let composite: Bool = kind == 0
    if composite:
      let id_type: Bool = syntax.ast_type_is_id(source, tokens, type_index)
      if id_type:
        0
      else:
        2
    else:
      let scalar_kind: I64 = syntax.scalar_type_kind(source, tokens, type_index)
      let scalar: Bool = scalar_kind >= 0
      if scalar:
        let bytes_type: Bool = scalar_kind == 4
        if bytes_type:
          1
        else:
          0
      else:
        let item_link: I64 = syntax.ast_node_link(tokens, type_index)
        let link_valid: Bool = item_link >= 0
        let item: I64 = if link_valid:
          item_link
        else:
          -1
        let found: Bool = item >= 0
        if found:
          let next_depth: I64 = depth + 1
          let first: I64 = syntax.ast_data_members_first(item)
          let record_item: Bool = syntax.ast_item_is_record(source, tokens, item)
          if record_item:
            record_storage(source, tokens, module_items, first, next_depth, 0)
          else:
            variant_storage(source, tokens, module_items, first, next_depth, 0)
        else:
          2

fn type_storage_kind(source: Bytes, tokens: Vec[syntax.Token], type_index: I64) -> I64 effects[partial]:
  type_storage_kind_from(source, tokens, 3, type_index, 0)

fn parameters_have_exclusive(source: Bytes, tokens: Vec[syntax.Token], cursor: I64) -> Bool effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    false
  else:
    let head: I64 = syntax.ast_list_first(cursor)
    let borrowed: Bool = syntax.ast_binding_is_exclusive(source, tokens, cursor)
    if borrowed:
      true
    else:
      let next: I64 = syntax.ast_next(tokens, cursor)
      recur(source, tokens, next)

fn function_uses_local_region(source: Bytes, tokens: Vec[syntax.Token], function: I64) -> Bool effects[partial]:
  let params: I64 = syntax.ast_function_parameters(function)
  let return_type: I64 = syntax.ast_function_return_type(tokens, function)
  let return_storage: I64 = type_storage_kind(source, tokens, return_type)
  let no_return_storage: Bool = return_storage == 0
  let first_parameter: I64 = syntax.ast_parameters_first(params)
  let output: Bool = parameters_have_exclusive(source, tokens, first_parameter)
  let no_output: Bool = !output
  no_return_storage && no_output

fn last_named_use(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, end: I64, name_start: I64, name_end: I64, last: I64) -> I64 effects[partial]:
  let done: Bool = cursor >= end
  if done:
    last
  else:
    let kind: I64 = syntax.ast_node_kind(tokens, cursor)
    let named: Bool = kind == 2
    let candidate_start: I64 = syntax.ast_node_start(tokens, cursor)
    let candidate_end: I64 = syntax.ast_node_end(tokens, cursor)
    let same: Bool = if named:
      syntax.spans_equal(source, candidate_start, candidate_end, name_start, name_end)
    else:
      false
    let next_last: I64 = if same:
      candidate_end
    else:
      last
    let next: I64 = syntax.ast_node_after(cursor)
    recur(source, tokens, next, end, name_start, name_end, next_last)

fn span_has_name(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, end: I64, name_start: I64, name_end: I64) -> Bool effects[partial]:
  let found: I64 = last_named_use(source, tokens, cursor, end, name_start, name_end, -1)
  found >= 0

fn result_expression(source: Bytes, tokens: Vec[syntax.Token], expr: I64) -> I64 effects[partial]:
  let let_form: Bool = syntax.ast_expression_is_let(source, tokens, expr)
  if let_form:
    recur(source, tokens, syntax.ast_let_body(tokens, expr))
  else:
    let set_form: Bool = syntax.ast_expression_is_set(source, tokens, expr)
    if set_form:
      recur(source, tokens, syntax.ast_set_body(tokens, expr))
    else:
      expr

fn escapes_to_exclusive(source: Bytes, tokens: Vec[syntax.Token], params: I64, cursor: I64, end: I64, name_start: I64, name_end: I64) -> Bool effects[partial]:
  let done: Bool = cursor >= end
  if done:
    false
  else:
    let kind: I64 = syntax.ast_node_kind(tokens, cursor)
    let form: Bool = kind == 0
    if form:
      let head: I64 = syntax.ast_list_first(cursor)
      let call_form: Bool = syntax.ast_expression_is_call(source, tokens, cursor)
      if call_form:
        let callee: I64 = syntax.ast_call_callee(cursor)
        let vector_push: Bool = syntax.ast_node_text_is(source, tokens, callee, "vec.push")
        let arena_add: Bool = syntax.ast_node_text_is(source, tokens, callee, "arena.add")
        let store: Bool = vector_push || arena_add
        if store:
          let target: I64 = syntax.ast_call_arguments(cursor)
          let value: I64 = syntax.ast_next(tokens, target)
          let value_start: I64 = syntax.ast_node_start(tokens, value)
          let value_end: I64 = syntax.ast_node_end(tokens, value)
          let same_value: Bool = syntax.spans_equal(source, value_start, value_end, name_start, name_end)
          let target_exclusive: Bool = if same_value:
            syntax.name_is_exclusive(source, tokens, params, target)
          else:
            false
          if target_exclusive:
            true
          else:
            let next: I64 = syntax.ast_node_after(cursor)
            recur(source, tokens, params, next, end, name_start, name_end)
        else:
          let next: I64 = syntax.ast_node_after(cursor)
          recur(source, tokens, params, next, end, name_start, name_end)
      else:
        let next: I64 = syntax.ast_node_after(cursor)
        recur(source, tokens, params, next, end, name_start, name_end)
    else:
      let next: I64 = syntax.ast_node_after(cursor)
      recur(source, tokens, params, next, end, name_start, name_end)

fn escape_kind(source: Bytes, tokens: Vec[syntax.Token], params: I64, body: I64, body_end: I64, name_start: I64, name_end: I64) -> I64 effects[partial]:
  let result: I64 = result_expression(source, tokens, body)
  let result_end: I64 = syntax.ast_next(tokens, result)
  let result_escape: Bool = span_has_name(source, tokens, result, result_end, name_start, name_end)
  let output_escape: Bool = escapes_to_exclusive(source, tokens, params, body, body_end, name_start, name_end)
  if result_escape:
    if output_escape:
      3
    else:
      1
  else:
    if output_escape:
      2
    else:
      0

fn append_value_plan(source: Bytes, tokens: Vec[syntax.Token], params: I64, body: I64, body_end: I64, name: I64, type_index: I64, borrowed: Bool, declared: I64, values: @Vec[ValuePlan]) -> Void effects[alloc, partial]:
  let name_start: I64 = syntax.ast_node_start(tokens, name)
  let name_end: I64 = syntax.ast_node_end(tokens, name)
  let storage: I64 = type_storage_kind(source, tokens, type_index)
  let plan: ValuePlan = ValuePlan(name: name, type_index: type_index, storage: storage, borrowed: borrowed, declared: declared, last_use: name_end, escape: 0)
  vec.push(@values, plan)

fn append_parameter_plans(source: Bytes, tokens: Vec[syntax.Token], params: I64, body: I64, body_end: I64, cursor: I64, values: @Vec[ValuePlan]) -> Void effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    void
  else:
    let head: I64 = syntax.ast_list_first(cursor)
    let name: I64 = syntax.ast_binding_name(source, tokens, cursor)
    let type_index: I64 = syntax.ast_binding_type(source, tokens, cursor)
    let storage: I64 = type_storage_kind(source, tokens, type_index)
    let affine: Bool = storage == 2
    let mode: I64 = syntax.ast_binding_mode(source, tokens, cursor)
    let borrowed: Bool = affine && (!(mode == 2))
    append_value_plan(source, tokens, params, body, body_end, name, type_index, borrowed, cursor, @values)
    let next: I64 = syntax.ast_next(tokens, cursor)
    recur(source, tokens, params, body, body_end, next, @values)

fn append_local_plans(source: Bytes, tokens: Vec[syntax.Token], params: I64, body: I64, body_end: I64, cursor: I64, values: @Vec[ValuePlan]) -> Void effects[alloc, partial]:
  let done: Bool = cursor >= body_end
  if done:
    void
  else:
    let kind: I64 = syntax.ast_node_kind(tokens, cursor)
    let form: Bool = kind == 0
    let head: I64 = syntax.ast_list_first(cursor)
    let let_form: Bool = if form:
      syntax.ast_expression_is_let(source, tokens, cursor)
    else:
      false
    if let_form:
      let name: I64 = syntax.ast_let_name(cursor)
      let type_index: I64 = syntax.ast_let_type(cursor)
      append_value_plan(source, tokens, params, body, body_end, name, type_index, false, cursor, @values)
    else:
      void
    let next: I64 = syntax.ast_node_after(cursor)
    recur(source, tokens, params, body, body_end, next, @values)

fn append_allocation_plans(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, end: I64, region: I64, allocations: @Vec[AllocationPlan]) -> Void effects[alloc, partial]:
  let done: Bool = cursor >= end
  if done:
    void
  else:
    let kind: I64 = syntax.ast_node_kind(tokens, cursor)
    let form: Bool = kind == 0
    let allocation: Bool = if form:
      let head: I64 = syntax.ast_list_first(cursor)
      let call_form: Bool = syntax.ast_expression_is_call(source, tokens, cursor)
      if call_form:
        let callee: I64 = syntax.ast_call_callee(cursor)
        effects.call_requires(source, tokens, callee, 1)
      else:
        false
    else:
      false
    if allocation:
      let plan: AllocationPlan = AllocationPlan(site: cursor, region: region)
      vec.push(@allocations, plan)
    else:
      void
    let next: I64 = syntax.ast_node_after(cursor)
    recur(source, tokens, next, end, region, @allocations)

fn conservative_escape(return_storage: I64, output: Bool) -> I64:
  let returns: Bool = return_storage > 0
  if returns:
    if output:
      3
    else:
      1
  else:
    if output:
      2
    else:
      0

fn finalize_value_plans(source: Bytes, tokens: Vec[syntax.Token], params: I64, body: I64, body_end: I64, return_storage: I64, output: Bool, values: @Vec[ValuePlan], index: I64) -> Void effects[alloc, partial]:
  let length: I64 = vec.len(values)
  let done: Bool = index >= length
  if done:
    void
  else:
    let value: ValuePlan = vec.get(values, index)
    let name: I64 = value.name
    let name_start: I64 = syntax.ast_node_start(tokens, name)
    let name_end: I64 = syntax.ast_node_end(tokens, name)
    let bounded: Bool = index < 64
    let last_use: I64 = if bounded:
      let declared: I64 = value.declared
      last_named_use(source, tokens, declared, body_end, name_start, name_end, name_end)
    else:
      body_end
    let escape: I64 = if bounded:
      escape_kind(source, tokens, params, body, body_end, name_start, name_end)
    else:
      let storage: I64 = value.storage
      let stored: Bool = storage > 0
      if stored:
        conservative_escape(return_storage, output)
      else:
        0
    let updated: ValuePlan = ValuePlan(name: name, type_index: value.type_index, storage: value.storage, borrowed: value.borrowed, declared: value.declared, last_use: last_use, escape: escape)
    vec.set(@values, index, updated)
    let next: I64 = index + 1
    recur(source, tokens, params, body, body_end, return_storage, output, @values, next)

fn count_escaping_values(values: Vec[ValuePlan], index: I64, count: I64) -> I64 effects[partial]:
  let length: I64 = vec.len(values)
  let done: Bool = index >= length
  if done:
    count
  else:
    let value: ValuePlan = vec.get(values, index)
    let storage: I64 = value.storage
    let escape: I64 = value.escape
    let stored: Bool = storage > 0
    let escapes: Bool = escape > 0
    let escaping: Bool = stored && escapes
    let increment: I64 = if escaping:
      1
    else:
      0
    let total: I64 = count + increment
    let next: I64 = index + 1
    recur(values, next, total)

fn build_function_plan(source: Bytes, tokens: Vec[syntax.Token], function: I64) -> FunctionPlan effects[alloc, partial]:
  let params: I64 = syntax.ast_function_parameters(function)
  let return_type: I64 = syntax.ast_function_return_type(tokens, function)
  let return_storage: I64 = type_storage_kind(source, tokens, return_type)
  let local_region: Bool = function_uses_local_region(source, tokens, function)
  let effects: I64 = syntax.ast_function_effects(tokens, function)
  let body: I64 = syntax.ast_function_body(tokens, function)
  let body_end: I64 = syntax.ast_next(tokens, body)
  let values: Vec[ValuePlan] = vec.new()
  let first_parameter: I64 = syntax.ast_parameters_first(params)
  append_parameter_plans(source, tokens, params, body, body_end, first_parameter, @values)
  append_local_plans(source, tokens, params, body, body_end, body, @values)
  let value_count: I64 = vec.len(values)
  let liveness_precise: Bool = value_count <= 64
  let first_parameter_for_output: I64 = syntax.ast_parameters_first(params)
  let output_escape: Bool = parameters_have_exclusive(source, tokens, first_parameter_for_output)
  finalize_value_plans(source, tokens, params, body, body_end, return_storage, output_escape, @values, 0)
  let allocations: Vec[AllocationPlan] = vec.new()
  let region: I64 = if local_region:
    0
  else:
    1
  append_allocation_plans(source, tokens, body, body_end, region, @allocations)
  let destructions: Vec[DestructionPlan] = vec.new()
  if local_region:
    let plan: DestructionPlan = DestructionPlan(region: 0, end: body_end, reverse: true)
    vec.push(@destructions, plan)
  else:
    void
  let escaping: I64 = count_escaping_values(values, 0, 0)
  let recursive: Bool = span_has_recur(source, tokens, body, body_end)
  FunctionPlan(function: function, return_storage: return_storage, local_region: local_region, recursive: recursive, liveness_precise: liveness_precise, values: values, allocations: allocations, destructions: destructions, escaping_values: escaping)

fn append_function_plans(source: Bytes, tokens: Vec[syntax.Token], declarations: Vec[ir.Declaration], index: I64, functions: @Vec[FunctionPlan]) -> Void effects[alloc, partial]:
  let length: I64 = vec.len(declarations)
  let done: Bool = index >= length
  if done:
    void
  else:
    let declaration: ir.Declaration = vec.get(declarations, index)
    let form: I64 = declaration.form
    let function_item: Bool = syntax.ast_item_is_function(source, tokens, form)
    if function_item:
      let plan: FunctionPlan = build_function_plan(source, tokens, form)
      vec.push(@functions, plan)
    else:
      void
    let next: I64 = index + 1
    recur(source, tokens, declarations, next, @functions)

fn analyze(source: Bytes, tokens: Vec[syntax.Token], declarations: Vec[ir.Declaration]) -> Plan effects[alloc, partial]:
  let functions: Vec[FunctionPlan] = vec.new()
  append_function_plans(source, tokens, declarations, 0, @functions)
  Plan(functions: functions)
