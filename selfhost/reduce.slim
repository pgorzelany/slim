  let output: Vec[U8] = vec.new()
  let formatted: Unit = format/emit_module(atoms reduced_tokens output)
  let next: Bytes = bytes.freeze(output)
  let source_length: I64 = bytes.len(source)
  let same: Bool = syntax/span_equal(source 0 source_length next)
  match same:
    true:
      next
    false:
      let exhausted: Bool = i64.le(remaining 0)
      match exhausted:
        true:
          fallback
        false:
          let next_remaining: I64 = i64.sub(remaining 1)
          recur(next fallback next_remaining)

