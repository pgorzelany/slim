module proof

fn append_i64(value: I64 inout output: Vec[U8]) -> Unit effects[alloc partial]:
  let negative: Bool = i64.lt(value 0)
  match negative:
    true:
      let minus: Unit = text/append_text(output "-")
      let magnitude: I64 = i64.sub(0 value)
      text/append_nonnegative_i64(magnitude output)
    false:
      text/append_nonnegative_i64(value output)

fn emit_rule(node: I64 kind: I64 inout output: Vec[U8]) -> Unit effects[alloc partial]:
  let prefix: Unit = text/append_text(output " (rewrite ")
  let node-text: Unit = append_i64(node output)
  let literal-false: Bool = i64.eq(kind 1)
  let literal-true: Bool = i64.eq(kind 2)
  let literal: Bool = bool.or(literal-false literal-true)
  match literal:
    true:
      text/append_text(output " literal-call (justification total-literal-evaluation))")
    false:
      let identity: Bool = i64.eq(kind 3)
      match identity:
        true:
          text/append_text(output " right-identity (justification total-identity))")
        false:
          let selected: Bool = i64.eq(kind 4)
          match selected:
            true:
              text/append_text(output " literal-match (justification exhaustive-literal-selection))")
            false:
              let dead: Bool = i64.eq(kind 5)
              match dead:
                true:
                  text/append_text(output " dead-scalar-binding (justification unused-immutable-literal))")
                false:
                  let idempotent: Bool = i64.eq(kind 6)
                  match idempotent:
                    true:
                      text/append_text(output " boolean-idempotence (justification repeated-total-atom))")
                    false:
                      let identity-match: Bool = i64.eq(kind 7)
                      match identity-match:
                        true:
                          text/append_text(output " boolean-identity-match (justification total-atom-selection))")
                        false:
                          text/append_text(output " common-match-result (justification total-atom-scrutinee-and-result))")

fn walk_children(source: Bytes inout tokens: Vec[syntax/Token] cursor: I64 remaining: I64 inout output: Vec[U8]) -> I64 effects[alloc partial]:
  let kind: I64 = syntax/ast_node_kind(tokens cursor)
  let done: Bool = i64.eq(kind 1)
  match done:
    true:
      remaining
    false:
      let next_remaining: I64 = walk_form(source tokens cursor remaining output)
      let next: I64 = syntax/ast_next(tokens cursor)
      recur(source tokens next next_remaining output)

fn walk_form(source: Bytes inout tokens: Vec[syntax/Token] form: I64 remaining: I64 inout output: Vec[U8]) -> I64 effects[alloc partial]:
  let exhausted: Bool = i64.le(remaining 0)
  match exhausted:
    true:
      0
    false:
      let kind: I64 = syntax/ast_node_kind(tokens form)
      let composite: Bool = i64.eq(kind 0)
      match composite:
        false:
          remaining
        true:
          let reduction: I64 = reduce/reduction_kind(source tokens form)
          let reducible: Bool = i64.gt(reduction 0)
          let recorded: Unit = match reducible:
            true:
              emit_rule(form reduction output)
            false:
              unit
          let after: I64 = match reducible:
            true:
              i64.sub(remaining 1)
            false:
              remaining
          let first: I64 = syntax/ast_list_first(form)
          walk_children(source tokens first after output)

fn token_count(source: Bytes) -> I64 effects[alloc partial]:
  let tokens: Vec[syntax/Token] = vec.new()
  let parsed: Bool = syntax/parse_program(source tokens)
  vec.len(tokens)

fn emit_metric(name: Bytes value: I64 inout output: Vec[U8]) -> Unit effects[alloc partial]:
  let open: Unit = text/append_text(output " (")
  let named: Unit = text/append_text(output name)
  let space: Unit = text/append_text(output " ")
  let numbered: Unit = append_i64(value output)
  text/append_text(output ")")

fn emit_report(source: Bytes inout tokens: Vec[syntax/Token] inout output: Vec[U8]) -> Unit effects[alloc partial]:
  let canonical: Bytes = reduce/canonicalize(source)
  let normalized: Bytes = reduce/normalize(source)
  let source_bytes: I64 = bytes.len(canonical)
  let result_bytes: I64 = bytes.len(normalized)
  let source_tokens: I64 = token_count(canonical)
  let result_tokens: I64 = token_count(normalized)
  let open: Unit = text/append_text(output "(reduction-proof 2 (guarantee bounded) (cost-model canonical-tokens-v1) (pass-limit 8) (site-limit 64)")
  let source_byte_metric: Unit = emit_metric("source-bytes" source_bytes output)
  let source_token_metric: Unit = emit_metric("source-tokens" source_tokens output)
  let result_byte_metric: Unit = emit_metric("result-bytes" result_bytes output)
  let result_token_metric: Unit = emit_metric("result-tokens" result_tokens output)
  let rewrites_open: Unit = text/append_text(output " (rewrites")
  let remaining: I64 = walk_form(source tokens 0 64 output)
  let rewrites_close: Unit = text/append_text(output ")")
  let truncated: Bool = i64.eq(remaining 0)
  let truncation: Unit = match truncated:
    true:
      text/append_text(output " (sites-truncated true)")
    false:
      text/append_text(output " (sites-truncated false)")
  text/append_text(output ")\n")

fn verify(original: Bytes candidate: Bytes inout output: Vec[U8]) -> Unit effects[alloc partial]:
  let expected: Bytes = reduce/normalize(original)
  let actual: Bytes = reduce/canonicalize(candidate)
  let expected_length: I64 = bytes.len(expected)
  let same: Bool = syntax/span_equal(expected 0 expected_length actual)
  match same:
    true:
      text/append_text(output "(reduction-verification 1 (status verified))\n")
    false:
      text/append_text(output "(reduction-verification 1 (status different))\n")
