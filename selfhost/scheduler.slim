module scheduler

struct Task:
  module: I64
  layer: I64

struct Batch:
  start: I64
  end: I64

struct Schedule:
  valid: Bool
  workers: I64
  tasks: Vec[Task]
  batches: Vec[Batch]

fn collect_modules(tokens: Vec[syntax.Token], cursor: I64, modules: @Vec[I64]) -> Void effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    void
  else:
    vec.push(@modules, cursor)
    let next: I64 = syntax.ast_next(tokens, cursor)
    recur(tokens, next, @modules)

fn fill_pending(length: I64, index: I64, scheduled: @Vec[Bool]) -> Void effects[alloc, partial]:
  let done: Bool = index >= length
  if done:
    void
  else:
    let value: Bool = false
    vec.push(@scheduled, value)
    let next: I64 = index + 1
    recur(length, next, @scheduled)

fn find_module(source: Bytes, tokens: Vec[syntax.Token], modules: Vec[I64], name: I64, index: I64) -> I64 effects[partial]:
  let length: I64 = vec.len(modules)
  let done: Bool = index >= length
  if done:
    -1
  else:
    let module: I64 = vec.get(modules, index)
    let candidate: I64 = module + 2
    let name_start: I64 = syntax.ast_node_start(tokens, name)
    let name_end: I64 = syntax.ast_node_end(tokens, name)
    let candidate_start: I64 = syntax.ast_node_start(tokens, candidate)
    let candidate_end: I64 = syntax.ast_node_end(tokens, candidate)
    let same: Bool = syntax.spans_equal(source, name_start, name_end, candidate_start, candidate_end)
    if same:
      index
    else:
      let next: I64 = index + 1
      recur(source, tokens, modules, name, next)

fn imports_ready(source: Bytes, tokens: Vec[syntax.Token], modules: Vec[I64], scheduled: Vec[Bool], cursor: I64) -> Bool effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    true
  else:
    let dependency: I64 = find_module(source, tokens, modules, cursor, 0)
    let found: Bool = dependency >= 0
    if found:
      let ready: Bool = vec.get(scheduled, dependency)
      if ready:
        let next: I64 = syntax.ast_node_after(cursor)
        recur(source, tokens, modules, scheduled, next)
      else:
        false
    else:
      false

fn collect_ready(source: Bytes, tokens: Vec[syntax.Token], modules: Vec[I64], scheduled: Vec[Bool], index: I64, ready: @Vec[I64]) -> Void effects[alloc, partial]:
  let length: I64 = vec.len(modules)
  let done: Bool = index >= length
  if done:
    void
  else:
    let complete: Bool = vec.get(scheduled, index)
    let pending: Bool = !complete
    let module: I64 = vec.get(modules, index)
    let imports: I64 = module + 4
    let first_import: I64 = imports + 2
    let dependencies_ready: Bool = imports_ready(source, tokens, modules, scheduled, first_import)
    let selectable: Bool = pending && dependencies_ready
    if selectable:
      vec.push(@ready, index)
    else:
      void
    let next: I64 = index + 1
    recur(source, tokens, modules, scheduled, next, @ready)

fn append_tasks(ready: Vec[I64], index: I64, layer: I64, tasks: @Vec[Task]) -> Void effects[alloc, partial]:
  let length: I64 = vec.len(ready)
  let done: Bool = index >= length
  if done:
    void
  else:
    let module: I64 = vec.get(ready, index)
    let task: Task = Task(module: module, layer: layer)
    vec.push(@tasks, task)
    let next: I64 = index + 1
    recur(ready, next, layer, @tasks)

fn append_batches(start: I64, end: I64, workers: I64, batches: @Vec[Batch]) -> Void effects[alloc, partial]:
  let done: Bool = start >= end
  if done:
    void
  else:
    let candidate_end: I64 = start + workers
    let exceeds: Bool = candidate_end > end
    let batch_end: I64 = if exceeds:
      end
    else:
      candidate_end
    let batch: Batch = Batch(start: start, end: batch_end)
    vec.push(@batches, batch)
    recur(batch_end, end, workers, @batches)

fn mark_ready(ready: Vec[I64], index: I64, scheduled: @Vec[Bool]) -> Void effects[partial]:
  let length: I64 = vec.len(ready)
  let done: Bool = index >= length
  if done:
    void
  else:
    let module: I64 = vec.get(ready, index)
    let value: Bool = true
    vec.set(@scheduled, module, value)
    let next: I64 = index + 1
    recur(ready, next, @scheduled)

fn schedule_layers(source: Bytes, tokens: Vec[syntax.Token], modules: Vec[I64], scheduled: @Vec[Bool], completed: I64, layer: I64, workers: I64, tasks: @Vec[Task], batches: @Vec[Batch]) -> Bool effects[alloc, partial]:
  let module_count: I64 = vec.len(modules)
  let done: Bool = completed >= module_count
  if done:
    true
  else:
    let ready: Vec[I64] = vec.new()
    collect_ready(source, tokens, modules, scheduled, 0, @ready)
    let ready_count: I64 = vec.len(ready)
    let progress: Bool = ready_count > 0
    if progress:
      let start: I64 = vec.len(tasks)
      append_tasks(ready, 0, layer, @tasks)
      let end: I64 = vec.len(tasks)
      append_batches(start, end, workers, @batches)
      mark_ready(ready, 0, @scheduled)
      let next_completed: I64 = completed + ready_count
      let next_layer: I64 = layer + 1
      recur(source, tokens, modules, @scheduled, next_completed, next_layer, workers, @tasks, @batches)
    else:
      false

fn bounded_workers(requested: I64, module_count: I64) -> I64:
  let positive: Bool = requested > 0
  let at_least_one: I64 = if positive:
    requested
  else:
    1
  let above_ceiling: Bool = at_least_one > 4
  let implementation_bound: I64 = if above_ceiling:
    4
  else:
    at_least_one
  let above_modules: Bool = implementation_bound > module_count
  if above_modules:
    module_count
  else:
    implementation_bound

fn make_schedule(valid: Bool, workers: I64, tasks: ^Vec[Task], batches: ^Vec[Batch]) -> Schedule:
  Schedule(valid: valid, workers: workers, tasks: tasks, batches: batches)

fn plan(source: Bytes, tokens: Vec[syntax.Token], requested: I64) -> Schedule effects[alloc, partial]:
  let modules: Vec[I64] = vec.new()
  let entry_form: I64 = 3
  let first_module: I64 = syntax.ast_next(tokens, entry_form)
  collect_modules(tokens, first_module, @modules)
  let module_count: I64 = vec.len(modules)
  let workers: I64 = bounded_workers(requested, module_count)
  let scheduled: Vec[Bool] = vec.new()
  fill_pending(module_count, 0, @scheduled)
  let tasks: Vec[Task] = vec.new()
  let batches: Vec[Batch] = vec.new()
  let valid: Bool = schedule_layers(source, tokens, modules, @scheduled, 0, 0, workers, @tasks, @batches)
  make_schedule(valid, workers, ^tasks, ^batches)

fn parse_jobs_from(input: Bytes, index: I64, length: I64, value: I64) -> I64 effects[partial]:
  let done: Bool = index >= length
  if done:
    value
  else:
    let byte: U8 = bytes.get(input, index)
    let code: I64 = u8.to_i64(byte)
    let lower: Bool = code >= 48
    let upper: Bool = code <= 57
    let digit: Bool = lower && upper
    if digit:
      let already_capped: Bool = value >= 4
      let next_value: I64 = if already_capped:
        4
      else:
        let shifted: I64 = value * 10
        let numeric: I64 = code - 48
        let candidate: I64 = shifted + numeric
        let above: Bool = candidate > 4
        if above:
          4
        else:
          candidate
      let next: I64 = index + 1
      recur(input, next, length, next_value)
    else:
      1

fn parse_jobs(input: Bytes) -> I64 effects[partial]:
  let length: I64 = bytes.len(input)
  parse_jobs_from(input, 0, length, 0)
