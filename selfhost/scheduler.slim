module scheduler

record Task:
  module: I64
  layer: I64

record Batch:
  start: I64
  end: I64

record Schedule:
  valid: Bool
  workers: I64
  tasks: Vec[Task]
  batches: Vec[Batch]

fn collect_modules(inout tokens: Vec[syntax/Token] cursor: I64 inout modules: Vec[I64]) -> Unit effects[alloc partial]:
  let kind: I64 = syntax/ast_node_kind(tokens cursor)
  let done: Bool = i64.eq(kind 1)
  match done:
    true:
      unit
    false:
      let pushed: Unit = vec.push(modules cursor)
      let next: I64 = syntax/ast_next(tokens cursor)
      recur(tokens next modules)

fn fill_pending(length: I64 index: I64 inout scheduled: Vec[Bool]) -> Unit effects[alloc partial]:
  let done: Bool = i64.ge(index length)
  match done:
    true:
      unit
    false:
      let value: Bool = false
      let pushed: Unit = vec.push(scheduled value)
      let next: I64 = i64.add(index 1)
      recur(length next scheduled)

fn find_module(source: Bytes inout tokens: Vec[syntax/Token] inout modules: Vec[I64] name: I64 index: I64) -> I64 effects[partial]:
  let length: I64 = vec.len(modules)
  let done: Bool = i64.ge(index length)
  match done:
    true:
      -1
    false:
      let module: I64 = vec.get(modules index)
      let candidate: I64 = i64.add(module 2)
      let name_start: I64 = syntax/ast_node_start(tokens name)
      let name_end: I64 = syntax/ast_node_end(tokens name)
      let candidate_start: I64 = syntax/ast_node_start(tokens candidate)
      let candidate_end: I64 = syntax/ast_node_end(tokens candidate)
      let same: Bool = syntax/spans_equal(source name_start name_end candidate_start candidate_end)
      match same:
        true:
          index
        false:
          let next: I64 = i64.add(index 1)
          recur(source tokens modules name next)

fn imports_ready(source: Bytes inout tokens: Vec[syntax/Token] inout modules: Vec[I64] inout scheduled: Vec[Bool] cursor: I64) -> Bool effects[partial]:
  let kind: I64 = syntax/ast_node_kind(tokens cursor)
  let done: Bool = i64.eq(kind 1)
  match done:
    true:
      true
    false:
      let dependency: I64 = find_module(source tokens modules cursor 0)
      let found: Bool = i64.ge(dependency 0)
      match found:
        false:
          false
        true:
          let ready: Bool = vec.get(scheduled dependency)
          match ready:
            false:
              false
            true:
              let next: I64 = syntax/ast_node_after(cursor)
              recur(source tokens modules scheduled next)

fn collect_ready(source: Bytes inout tokens: Vec[syntax/Token] inout modules: Vec[I64] inout scheduled: Vec[Bool] index: I64 inout ready: Vec[I64]) -> Unit effects[alloc partial]:
  let length: I64 = vec.len(modules)
  let done: Bool = i64.ge(index length)
  match done:
    true:
      unit
    false:
      let complete: Bool = vec.get(scheduled index)
      let pending: Bool = bool.not(complete)
      let module: I64 = vec.get(modules index)
      let imports: I64 = i64.add(module 4)
      let first_import: I64 = i64.add(imports 2)
      let dependencies_ready: Bool = imports_ready(source tokens modules scheduled first_import)
      let selectable: Bool = bool.and(pending dependencies_ready)
      let pushed: Unit = match selectable:
        true:
          vec.push(ready index)
        false:
          unit
      let next: I64 = i64.add(index 1)
      recur(source tokens modules scheduled next ready)

fn append_tasks(inout ready: Vec[I64] index: I64 layer: I64 inout tasks: Vec[Task]) -> Unit effects[alloc partial]:
  let length: I64 = vec.len(ready)
  let done: Bool = i64.ge(index length)
  match done:
    true:
      unit
    false:
      let module: I64 = vec.get(ready index)
      let task: Task = make Task(module = module layer = layer)
      let pushed: Unit = vec.push(tasks task)
      let next: I64 = i64.add(index 1)
      recur(ready next layer tasks)

fn append_batches(start: I64 end: I64 workers: I64 inout batches: Vec[Batch]) -> Unit effects[alloc partial]:
  let done: Bool = i64.ge(start end)
  match done:
    true:
      unit
    false:
      let candidate_end: I64 = i64.add(start workers)
      let exceeds: Bool = i64.gt(candidate_end end)
      let batch_end: I64 = match exceeds:
        true:
          end
        false:
          candidate_end
      let batch: Batch = make Batch(start = start end = batch_end)
      let pushed: Unit = vec.push(batches batch)
      recur(batch_end end workers batches)

fn mark_ready(inout ready: Vec[I64] index: I64 inout scheduled: Vec[Bool]) -> Unit effects[partial]:
  let length: I64 = vec.len(ready)
  let done: Bool = i64.ge(index length)
  match done:
    true:
      unit
    false:
      let module: I64 = vec.get(ready index)
      let value: Bool = true
      let marked: Unit = vec.set(scheduled module value)
      let next: I64 = i64.add(index 1)
      recur(ready next scheduled)

fn schedule_layers(source: Bytes inout tokens: Vec[syntax/Token] inout modules: Vec[I64] inout scheduled: Vec[Bool] completed: I64 layer: I64 workers: I64 inout tasks: Vec[Task] inout batches: Vec[Batch]) -> Bool effects[alloc partial]:
  let module_count: I64 = vec.len(modules)
  let done: Bool = i64.ge(completed module_count)
  match done:
    true:
      true
    false:
      let ready: Vec[I64] = vec.new()
      let collected: Unit = collect_ready(source tokens modules scheduled 0 ready)
      let ready_count: I64 = vec.len(ready)
      let progress: Bool = i64.gt(ready_count 0)
      match progress:
        false:
          false
        true:
          let start: I64 = vec.len(tasks)
          let appended: Unit = append_tasks(ready 0 layer tasks)
          let end: I64 = vec.len(tasks)
          let batched: Unit = append_batches(start end workers batches)
          let marked: Unit = mark_ready(ready 0 scheduled)
          let next_completed: I64 = i64.add(completed ready_count)
          let next_layer: I64 = i64.add(layer 1)
          recur(source tokens modules scheduled next_completed next_layer workers tasks batches)

fn bounded_workers(requested: I64 module_count: I64) -> I64:
  let positive: Bool = i64.gt(requested 0)
  let at_least_one: I64 = match positive:
    true:
      requested
    false:
      1
  let above_ceiling: Bool = i64.gt(at_least_one 4)
  let implementation_bound: I64 = match above_ceiling:
    true:
      4
    false:
      at_least_one
  let above_modules: Bool = i64.gt(implementation_bound module_count)
  match above_modules:
    true:
      module_count
    false:
      implementation_bound

fn make_schedule(valid: Bool workers: I64 tasks: Vec[Task] batches: Vec[Batch]) -> Schedule:
  make Schedule(valid = valid workers = workers tasks = tasks batches = batches)

fn plan(source: Bytes inout tokens: Vec[syntax/Token] requested: I64) -> Schedule effects[alloc partial]:
  let modules: Vec[I64] = vec.new()
  let entry_form: I64 = 3
  let first_module: I64 = syntax/ast_next(tokens entry_form)
  let collected: Unit = collect_modules(tokens first_module modules)
  let module_count: I64 = vec.len(modules)
  let workers: I64 = bounded_workers(requested module_count)
  let scheduled: Vec[Bool] = vec.new()
  let initialized: Unit = fill_pending(module_count 0 scheduled)
  let tasks: Vec[Task] = vec.new()
  let batches: Vec[Batch] = vec.new()
  let valid: Bool = schedule_layers(source tokens modules scheduled 0 0 workers tasks batches)
  make_schedule(valid workers tasks batches)

fn parse_jobs_from(input: Bytes index: I64 length: I64 value: I64) -> I64 effects[partial]:
  let done: Bool = i64.ge(index length)
  match done:
    true:
      value
    false:
      let byte: U8 = bytes.get(input index)
      let code: I64 = u8.to-i64(byte)
      let lower: Bool = i64.ge(code 48)
      let upper: Bool = i64.le(code 57)
      let digit: Bool = bool.and(lower upper)
      match digit:
        false:
          1
        true:
          let already_capped: Bool = i64.ge(value 4)
          let next_value: I64 = match already_capped:
            true:
              4
            false:
              let shifted: I64 = i64.mul(value 10)
              let numeric: I64 = i64.sub(code 48)
              let candidate: I64 = i64.add(shifted numeric)
              let above: Bool = i64.gt(candidate 4)
              match above:
                true:
                  4
                false:
                  candidate
          let next: I64 = i64.add(index 1)
          recur(input next length next_value)

fn parse_jobs(input: Bytes) -> I64 effects[partial]:
  let length: I64 = bytes.len(input)
  parse_jobs_from(input 0 length 0)
