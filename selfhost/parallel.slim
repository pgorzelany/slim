module parallel

record Blockers:
  declared-effects: Bool
  exclusive-borrow: Bool
  mutation: Bool
  checked-trap: Bool
  allocation-or-io: Bool
  recurrence: Bool
  callee-not-safe: Bool
  call-cycle: Bool
  function-limit: Bool
  edge-limit: Bool
  missing-typed-fact: Bool

record FunctionFact:
  item: I64
  name: I64
  status: I64
  reason: I64
  blockers: Blockers
  first_edge: I64
  edge_count: I64
  body: I64
  body_tokens: I64

record CallEdge:
  caller: I64
  callee: I64

record Scan:
  reason: I64
  blockers: Blockers
  calls: I64
  complete: Bool

record Evaluation:
  status: I64
  reason: I64
  calls: I64

record Site:
  site: I64
  first: I64
  second: I64
  join: I64
  first-work: I64
  second-work: I64
  allocates: Bool
  explicit: Bool
  executable: Bool

record Schedule:
  candidates: I64
  selected: I64
  reported: I64
  executable: I64
  executed: I64
  selected_until: I64

record View:
  facts: Vec[FunctionFact]
  sites: Vec[Site]
  functions: I64
  exact: Bool
  schedule: Schedule

fn empty_blockers() -> Blockers:
  make Blockers(declared-effects = false exclusive-borrow = false mutation = false checked-trap = false allocation-or-io = false recurrence = false callee-not-safe = false call-cycle = false function-limit = false edge-limit = false missing-typed-fact = false)

fn add_blocker(blockers: Blockers reason: I64) -> Blockers:
  make Blockers(declared-effects = bool.or(get(blockers declared-effects) i64.eq(reason 1)) exclusive-borrow = bool.or(get(blockers exclusive-borrow) i64.eq(reason 2)) mutation = bool.or(get(blockers mutation) i64.eq(reason 3)) checked-trap = bool.or(get(blockers checked-trap) i64.eq(reason 4)) allocation-or-io = bool.or(get(blockers allocation-or-io) i64.eq(reason 5)) recurrence = bool.or(get(blockers recurrence) i64.eq(reason 6)) callee-not-safe = bool.or(get(blockers callee-not-safe) i64.eq(reason 7)) call-cycle = bool.or(get(blockers call-cycle) i64.eq(reason 8)) function-limit = bool.or(get(blockers function-limit) i64.eq(reason 9)) edge-limit = bool.or(get(blockers edge-limit) i64.eq(reason 10)) missing-typed-fact = bool.or(get(blockers missing-typed-fact) i64.eq(reason 11)))

