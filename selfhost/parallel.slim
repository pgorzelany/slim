      let space: Unit = text/append_text(output " ")
      text/append_text(output name)
    false:
      unit

fn emit_blockers(blockers: Blockers inout output: Vec[U8]) -> Unit effects[alloc partial]:
  let open: Unit = text/append_text(output " (blockers")
  let declared: Unit = emit_blocker(get(blockers declared-effects) "declared-effects" output)
  let borrowed: Unit = emit_blocker(get(blockers exclusive-borrow) "exclusive-borrow" output)
  let mutation: Unit = emit_blocker(get(blockers mutation) "mutation" output)
  let trap: Unit = emit_blocker(get(blockers checked-trap) "checked-trap" output)
  let effect: Unit = emit_blocker(get(blockers allocation-or-io) "allocation-or-io" output)
  let recurrence: Unit = emit_blocker(get(blockers recurrence) "recurrence" output)
  let callee: Unit = emit_blocker(get(blockers callee-not-safe) "callee-not-safe" output)
  let cycle: Unit = emit_blocker(get(blockers call-cycle) "call-cycle" output)
  let function_limit: Unit = emit_blocker(get(blockers function-limit) "function-limit" output)
  let edge_limit: Unit = emit_blocker(get(blockers edge-limit) "edge-limit" output)
  let missing: Unit = emit_blocker(get(blockers missing-typed-fact) "missing-typed-fact" output)
  text/append_text(output ")")

fn emit_function_fact(source: Bytes inout tokens: Vec[syntax/Token] fact: FunctionFact inout output: Vec[U8]) -> Unit effects[alloc partial]:
  let open: Unit = text/append_text(output " (function-parallel-safety ")
  let item: Unit = append_i64(get(fact item) output)
  let space: Unit = text/append_text(output " ")
  let name: Unit = text/append_token(source tokens get(fact name) output)
  let safe: Bool = i64.eq(get(fact status) 1)
  let unavailable: Bool = i64.eq(get(fact status) 2)
  let status_text: Unit = match safe:
    true:
      text/append_text(output " (guarantee exact) (status safe)")
    false:
      match unavailable:
        true:
          text/append_text(output " (guarantee exact) (status unavailable) (reason ")
        false:
          text/append_text(output " (guarantee unknown) (status unknown) (reason ")
  let reason_text: Unit = match safe:
    true:
      unit
    false:
      let emitted: Unit = emit_reason(get(fact reason) output)
      text/append_text(output ")")
  let blockers: Unit = emit_blockers(get(fact blockers) output)
  let tokens_prefix: Unit = text/append_text(output " (body-tokens ")
  let tokens_text: Unit = append_i64(get(fact body_tokens) output)
  text/append_text(output "))")

fn emit_function_facts(source: Bytes inout tokens: Vec[syntax/Token] inout facts: Vec[FunctionFact] index: I64 inout output: Vec[U8]) -> Unit effects[alloc partial]:
  let count: I64 = vec.len(facts)
  let done: Bool = i64.ge(index count)
  match done:
    true:
      unit
    false:
      let fact: FunctionFact = vec.get(facts index)
      let emitted: Unit = emit_function_fact(source tokens fact output)
      let next: I64 = i64.add(index 1)
      recur(source tokens facts next output)

fn direct-user-call(source: Bytes inout tokens: Vec[syntax/Token] expr: I64) -> Bool effects[partial]:
  let kind: I64 = syntax/ast_node_kind(tokens expr)
  let form: Bool = i64.eq(kind 0)
  let head: I64 = syntax/ast_list_first(expr)
  let call-form: Bool = match form:
    true:
      syntax/ast_expression_is_call(source tokens expr)
    false:
      false
  let callee: I64 = syntax/ast_call_callee(expr)
  let builtin: Bool = match call-form:
    true:
      typing/builtin_known(source tokens callee)
    false:
      true
  let linked: I64 = match call-form:
    true:
      syntax/ast_node_link(tokens callee)
    false:
      -1
  bool.and(call-form bool.and(bool.not(builtin) i64.ge(linked 0)))

fn arguments-atomic(inout tokens: Vec[syntax/Token] cursor: I64) -> Bool effects[partial]:
  let kind: I64 = syntax/ast_node_kind(tokens cursor)
  let done: Bool = i64.eq(kind 1)
  match done:
    true:
      true
    false:
      let atom: Bool = i64.eq(kind 2)
      let string: Bool = i64.eq(kind 3)
      let scalar: Bool = bool.or(atom string)
      match scalar:
        false:
          false
        true:
          let next: I64 = syntax/ast_next(tokens cursor)
          recur(tokens next)

fn call-work(source: Bytes inout tokens: Vec[syntax/Token] inout range-view: ranges/View expr: I64) -> ranges/Work effects[partial]:
  let direct: Bool = direct-user-call(source tokens expr)
  match direct:
    false:
      make ranges/Work(known = false iterations = 0)
    true:
      let callee: I64 = syntax/ast_call_callee(expr)
      let item: I64 = syntax/ast_node_link(tokens callee)
      let arguments: I64 = syntax/ast_call_arguments(expr)
      ranges/recurrence-work(source tokens range-view item arguments)

fn work-value(work: ranges/Work) -> I64:
  match get(work known):
    true:
      get(work iterations)
    false:
      -1

fn emit-work(work: I64 inout output: Vec[U8]) -> Unit effects[alloc partial]:
  let known: Bool = i64.ge(work 0)
  match known:
    true:
      append_i64(work output)
    false:
      text/append_text(output "unknown")

fn work-profitable(work: ranges/Work) -> Bool:
  bool.and(get(work known) i64.ge(get(work iterations) 1000000))

fn capture-ready(source: Bytes inout tokens: Vec[syntax/Token] expr: I64) -> Bool effects[partial]:
  let direct: Bool = direct-user-call(source tokens expr)
  let arguments: I64 = syntax/ast_call_arguments(expr)
  let atomic: Bool = match direct:
    true:
      arguments-atomic(tokens arguments)
    false:
      false
  bool.and(direct atomic)

fn leading-let-site(source: Bytes inout tokens: Vec[syntax/Token] cursor: I64 site: I64) -> Bool effects[partial]:
  let found: Bool = i64.eq(cursor site)
  match found:
    true:
      true
    false:
      let kind: I64 = syntax/ast_node_kind(tokens cursor)
      let form: Bool = i64.eq(kind 0)
      let head: I64 = syntax/ast_list_first(cursor)
      let let-form: Bool = match form:
        true:
          syntax/ast_expression_is_let(source tokens cursor)
        false:
          false
      match let-form:
        false:
          false
        true:
          let type-index: I64 = syntax/ast_let_type(cursor)
          let value: I64 = syntax/ast_let_value(tokens cursor)
          let body: I64 = syntax/ast_let_body(tokens cursor)
          recur(source tokens body site)

fn collect-sites-in-function(source: Bytes inout tokens: Vec[syntax/Token] inout typed-facts: Vec[typing/Fact] inout range-view: ranges/View inout range-facts: Vec[ranges/Fact] inout facts: Vec[FunctionFact] root: I64 index: I64 end: I64 inout sites: Vec[Site] schedule: Schedule) -> Schedule effects[alloc partial]:
  let done: Bool = i64.ge(index end)
  match done:
    true:
      schedule
    false:
      let kind: I64 = syntax/ast_node_kind(tokens index)
      let form: Bool = i64.eq(kind 0)
      let head: I64 = syntax/ast_list_first(index)
      let let-form: Bool = match form:
        true:
          syntax/ast_expression_is_let(source tokens index)
        false:
          false
      let name: I64 = syntax/ast_let_name(index)
      let type-index: I64 = syntax/ast_let_type(index)
      let value: I64 = match let-form:
        true:
          syntax/ast_let_value(tokens index)
        false:
          index
      let body: I64 = match let-form:
        true:
          syntax/ast_let_body(tokens index)
        false:
          index
      let body-kind: I64 = match let-form:
        true:
          syntax/ast_node_kind(tokens body)
        false:
          -1
      let body-form: Bool = i64.eq(body-kind 0)
      let body-head: I64 = syntax/ast_list_first(body)
      let adjacent-let: Bool = match body-form:
        true:
          syntax/ast_expression_is_let(source tokens body)
        false:
          false
      let inner-type: I64 = syntax/ast_let_type(body)
      let inner-value: I64 = match adjacent-let:
        true:
          syntax/ast_let_value(tokens body)
        false:
          body
      let inner-body: I64 = match adjacent-let:
        true:
          syntax/ast_let_body(tokens body)
        false:
          body
      let first-eval: Evaluation = match adjacent-let:
        true:
          evaluate_expression(source tokens typed-facts range-facts facts value)
        false:
          make Evaluation(status = 0 reason = 0 calls = 0)
      let second-eval: Evaluation = match adjacent-let:
        true:
          evaluate_expression(source tokens typed-facts range-facts facts inner-value)
        false:
          make Evaluation(status = 0 reason = 0 calls = 0)
      let both-safe: Bool = bool.and(i64.eq(get(first-eval status) 1) i64.eq(get(second-eval status) 1))
      let both-calls: Bool = bool.and(i64.gt(get(first-eval calls) 0) i64.gt(get(second-eval calls) 0))
      let inner-end: I64 = match adjacent-let:
        true:
          syntax/ast_next(tokens inner-value)
        false:
          inner-value
      let dependent: Bool = match adjacent-let:
        true:
          expression_uses_binding(tokens inner-value inner-end name)
        false:
          true
      let independent: Bool = bool.not(dependent)
      let eligible: Bool = bool.and(adjacent-let bool.and(both-safe bool.and(both-calls independent)))
      let after-previous: Bool = i64.ge(index get(schedule selected_until))
      let selected: Bool = bool.and(eligible after-previous)
      let under-limit: Bool = i64.lt(get(schedule reported) 64)
      let reported: Bool = bool.and(selected under-limit)
      let first-work: ranges/Work = match adjacent-let:
        true:
          call-work(source tokens range-view value)
        false:
          make ranges/Work(known = false iterations = 0)
      let second-work: ranges/Work = match adjacent-let:
        true:
          call-work(source tokens range-view inner-value)
        false:
          make ranges/Work(known = false iterations = 0)
      let first-capture: Bool = match adjacent-let:
        true:
          capture-ready(source tokens value)
        false:
          false
      let second-capture: Bool = match adjacent-let:
        true:
          capture-ready(source tokens inner-value)
        false:
          false
      let captures: Bool = bool.and(first-capture second-capture)
      let profitable: Bool = bool.and(work-profitable(first-work) work-profitable(second-work))
      let leading: Bool = match adjacent-let:
        true:
          leading-let-site(source tokens root index)
        false:
          false
      let executable: Bool = bool.and(selected bool.and(leading bool.and(captures profitable)))
      let stored: Unit = match reported:
        false:
          unit
        true:
          let site: Site = make Site(site = index first = value second = inner-value join = inner-body first-work = work-value(first-work) second-work = work-value(second-work) allocates = false explicit = false executable = executable)
          vec.push(sites site)
      let next-candidates: I64 = match eligible:
        true:
          i64.add(get(schedule candidates) 1)
        false:
          get(schedule candidates)
      let next-selected: I64 = match selected:
        true:
          i64.add(get(schedule selected) 1)
        false:
          get(schedule selected)
      let next-reported: I64 = match reported:
        true:
          i64.add(get(schedule reported) 1)
        false:
          get(schedule reported)
      let next-executable: I64 = match executable:
        true:
          i64.add(get(schedule executable) 1)
        false:
          get(schedule executable)
      let executed: Bool = bool.and(executable reported)
      let next-executed: I64 = match executed:
        true:
          i64.add(get(schedule executed) 1)
        false:
          get(schedule executed)
      let next-until: I64 = match selected:
        true:
          inner-body
        false:
          get(schedule selected_until)
      let next-schedule: Schedule = make Schedule(candidates = next-candidates selected = next-selected reported = next-reported executable = next-executable executed = next-executed selected_until = next-until)
      let next: I64 = syntax/ast_node_after(index)
      recur(source tokens typed-facts range-view range-facts facts root next end sites next-schedule)

fn collect-sites(source: Bytes inout tokens: Vec[syntax/Token] inout typed-facts: Vec[typing/Fact] inout range-view: ranges/View inout range-facts: Vec[ranges/Fact] inout facts: Vec[FunctionFact] index: I64 inout sites: Vec[Site] schedule: Schedule) -> Schedule effects[alloc partial]:
  let fact-count: I64 = vec.len(facts)
  let done: Bool = i64.ge(index fact-count)
  match done:
    true:
      schedule
    false:
      let fact: FunctionFact = vec.get(facts index)
      let end: I64 = syntax/ast_next(tokens get(fact body))
      let next-schedule: Schedule = collect-sites-in-function(source tokens typed-facts range-view range-facts facts get(fact body) get(fact body) end sites schedule)
      let next: I64 = i64.add(index 1)
      recur(source tokens typed-facts range-view range-facts facts next sites next-schedule)

fn append-explicit-site(source: Bytes inout tokens: Vec[syntax/Token] index: I64 inout sites: Vec[Site] schedule: Schedule) -> Schedule effects[alloc partial]:
  let first-let: I64 = syntax/ast_fork_body(index)
  let first-type: I64 = syntax/ast_let_type(first-let)
  let first-value: I64 = syntax/ast_let_value(tokens first-let)
  let second-let: I64 = syntax/ast_let_body(tokens first-let)
  let second-type: I64 = syntax/ast_let_type(second-let)
  let second-value: I64 = syntax/ast_let_value(tokens second-let)
  let join: I64 = syntax/ast_let_body(tokens second-let)
  let under-limit: Bool = i64.lt(get(schedule reported) 64)
  let stored: Unit = match under-limit:
    false:
      unit
    true:
      let site: Site = make Site(site = index first = first-value second = second-value join = join first-work = -1 second-work = -1 allocates = bool.or(effects/call_requires(source tokens syntax/ast_call_callee(first-value) 1) effects/call_requires(source tokens syntax/ast_call_callee(second-value) 1)) explicit = true executable = true)
      vec.push(sites site)
  let next-candidates: I64 = i64.add(get(schedule candidates) 1)
  let next-selected: I64 = i64.add(get(schedule selected) 1)
  let next-reported: I64 = match under-limit:
    true:
      i64.add(get(schedule reported) 1)
    false:
      get(schedule reported)
  let next-executable: I64 = match under-limit:
    true:
      i64.add(get(schedule executable) 1)
    false:
      get(schedule executable)
  let next-executed: I64 = match under-limit:
    true:
      i64.add(get(schedule executed) 1)
    false:
      get(schedule executed)
  make Schedule(candidates = next-candidates selected = next-selected reported = next-reported executable = next-executable executed = next-executed selected_until = get(schedule selected_until))

fn collect-explicit-sites-in-function(source: Bytes inout tokens: Vec[syntax/Token] index: I64 end: I64 inout sites: Vec[Site] schedule: Schedule) -> Schedule effects[alloc partial]:
  let done: Bool = i64.ge(index end)
  match done:
    true:
      schedule
    false:
      let kind: I64 = syntax/ast_node_kind(tokens index)
      let form: Bool = i64.eq(kind 0)
      let head: I64 = syntax/ast_list_first(index)
      let fork-form: Bool = match form:
        true:
          syntax/ast_expression_is_fork(source tokens index)
        false:
          false
      let next-schedule: Schedule = match fork-form:
        true:
          append-explicit-site(source tokens index sites schedule)
        false:
          schedule
      let next: I64 = syntax/ast_node_after(index)
      recur(source tokens next end sites next-schedule)

fn collect-explicit-sites(source: Bytes inout tokens: Vec[syntax/Token] inout facts: Vec[FunctionFact] index: I64 inout sites: Vec[Site] schedule: Schedule) -> Schedule effects[alloc partial]:
  let fact-count: I64 = vec.len(facts)
  let done: Bool = i64.ge(index fact-count)
  match done:
    true:
      schedule
    false:
      let fact: FunctionFact = vec.get(facts index)
      let end: I64 = syntax/ast_next(tokens get(fact body))
      let next-schedule: Schedule = collect-explicit-sites-in-function(source tokens get(fact body) end sites schedule)
      let next: I64 = i64.add(index 1)
      recur(source tokens facts next sites next-schedule)

fn edge_complete(inout facts: Vec[FunctionFact] index: I64) -> Bool effects[partial]:
  let count: I64 = vec.len(facts)
  let done: Bool = i64.ge(index count)
  match done:
    true:
      true
    false:
      let fact: FunctionFact = vec.get(facts index)
      let limited: Bool = i64.eq(get(fact reason) 10)
      match limited:
        true:
          false
        false:
          let next: I64 = i64.add(index 1)
          recur(facts next)

fn analyze(source: Bytes inout tokens: Vec[syntax/Token] inout typed-facts: Vec[typing/Fact] inout range-view: ranges/View) -> View effects[alloc partial]:
  let range-facts: Vec[ranges/Fact] = get(range-view facts)
  let facts: Vec[FunctionFact] = vec.new()
  let edges: Vec[CallEdge] = vec.new()
  let total: I64 = collect_functions(source tokens typed-facts range-facts 3 facts edges 0)
  let linked: Unit = link_edges(facts edges 0)
  let resolved: Unit = resolve_graph(facts edges 0)
  let finalized: Unit = finalize_unknowns(facts edges 0)
  let enriched: Unit = enrich_graph_blockers(facts edges 0)
  let functions-bounded: Bool = i64.le(total 64)
  let edges-bounded: Bool = edge_complete(facts 0)
  let exact: Bool = bool.and(functions-bounded edges-bounded)
  let sites: Vec[Site] = vec.new()
  let initial: Schedule = make Schedule(candidates = 0 selected = 0 reported = 0 executable = 0 executed = 0 selected_until = -1)
  let explicit-schedule: Schedule = collect-explicit-sites(source tokens facts 0 sites initial)
  let schedule: Schedule = collect-sites(source tokens typed-facts range-view range-facts facts 0 sites explicit-schedule)
  make View(facts = facts sites = sites functions = total exact = exact schedule = schedule)

fn emit_site_intent(site: Site inout output: Vec[U8]) -> Unit effects[alloc partial]:
  match get(site explicit):
    true:
      text/append_text(output " (intent explicit)")
    false:
      text/append_text(output " (intent automatic)")

fn emit_site_profitability(site: Site inout output: Vec[U8]) -> Unit effects[alloc partial]:
  match get(site explicit):
    true:
      text/append_text(output " (profitability explicit) (profitable true) (target-tier posix-v1)")
    false:
      match get(site executable):
        true:
          text/append_text(output " (profitability exact) (profitable true) (target-tier posix-v1) (minimum-task-iterations 1000000)")
        false:
          let work-known: Bool = bool.and(i64.ge(get(site first-work) 0) i64.ge(get(site second-work) 0))
          match work-known:
            true:
              text/append_text(output " (profitability exact) (profitable false) (profitability-reason below-posix-v1-threshold)")
            false:
              text/append_text(output " (profitability unknown) (profitability-reason target-work-unavailable)")

fn emit_fork_site(inout tokens: Vec[syntax/Token] site: Site inout output: Vec[U8]) -> Unit effects[alloc partial]:
  let first: I64 = get(site first)
  let second: I64 = get(site second)
  let first-end: I64 = syntax/ast_next(tokens first)
  let second-end: I64 = syntax/ast_next(tokens second)
  let open: Unit = text/append_text(output " (fork-site ")
  let site-text: Unit = append_i64(get(site site) output)
  let intent: Unit = emit_site_intent(site output)
  let tasks-prefix: Unit = text/append_text(output " (guarantee exact) (tasks ")
  let first-text: Unit = append_i64(first output)
  let task-space: Unit = text/append_text(output " ")
  let second-text: Unit = append_i64(second output)
  let join-prefix: Unit = text/append_text(output ") (join ")
  let join-text: Unit = append_i64(get(site join) output)
  let proof: Unit = text/append_text(output ") (race-free true) (deadlock-free true)")
  let profitability: Unit = emit_site_profitability(site output)
  let work-prefix: Unit = text/append_text(output " (task-work ")
  let first-work: Unit = emit-work(get(site first-work) output)
  let work-space: Unit = text/append_text(output " ")
  let second-work: Unit = emit-work(get(site second-work) output)
  let token-prefix: Unit = text/append_text(output ") (task-tokens ")
  let first-size: Unit = append_i64(i64.sub(first-end first) output)
  let size-space: Unit = text/append_text(output " ")
  let second-size: Unit = append_i64(i64.sub(second-end second) output)
  match get(site executable):
    true:
      text/append_text(output ") (execution selected))")
    false:
      text/append_text(output ") (execution not-selected))")

fn emit_sites(inout tokens: Vec[syntax/Token] inout sites: Vec[Site] index: I64 inout output: Vec[U8]) -> Unit effects[alloc partial]:
  let count: I64 = vec.len(sites)
  let done: Bool = i64.ge(index count)
  match done:
    true:
      unit
    false:
      let site: Site = vec.get(sites index)
      let emitted: Unit = emit_fork_site(tokens site output)
      let next: I64 = i64.add(index 1)
      recur(tokens sites next output)

fn emit_module_facts(source: Bytes inout tokens: Vec[syntax/Token] view: View inout output: Vec[U8]) -> Unit effects[alloc partial]:
  let facts: Vec[FunctionFact] = get(view facts)
  let sites: Vec[Site] = get(view sites)
  let schedule: Schedule = get(view schedule)
  let open: Unit = text/append_text(output " (parallelism (guarantee ")
  let guarantee: Unit = match get(view exact):
    true:
      text/append_text(output "exact")
    false:
      text/append_text(output "bounded")
  let limits: Unit = text/append_text(output ") (function-limit 64) (edge-limit 4096) (resolution-pass-limit 64) (schedule-limit 64) (profitability-model posix-v1) (minimum-task-iterations 1000000) (functions")
  let function-output: Unit = emit_function_facts(source tokens facts 0 output)
  let sites-open: Unit = text/append_text(output ") (fork-sites")
  let site-output: Unit = emit_sites(tokens sites 0 output)
  let sites-close: Unit = text/append_text(output ") (schedule (policy lexical-earliest-nonoverlap) (guarantee ")
  let schedule-exact: Bool = i64.eq(get(schedule selected) get(schedule reported))
  let schedule-guarantee: Unit = match schedule-exact:
    true:
      text/append_text(output "exact")
    false:
      text/append_text(output "bounded")
  let candidates-prefix: Unit = text/append_text(output ") (candidate-sites ")
  let candidates-text: Unit = append_i64(get(schedule candidates) output)
  let selected-prefix: Unit = text/append_text(output ") (selected-sites ")
  let selected-text: Unit = append_i64(get(schedule selected) output)
  let reported-prefix: Unit = text/append_text(output ") (reported-sites ")
  let reported-text: Unit = append_i64(get(schedule reported) output)
  let executable-prefix: Unit = text/append_text(output ") (executable-sites ")
  let executable-text: Unit = append_i64(get(schedule executable) output)
  let executed-prefix: Unit = text/append_text(output ") (executed-sites ")
  let executed-text: Unit = append_i64(get(schedule executed) output)
  let eligible-prefix: Unit = text/append_text(output ")) (eligible-sites ")
  let eligible-text: Unit = append_i64(get(schedule candidates) output)
  let any: Bool = i64.gt(get(schedule executed) 0)
  match any:
    true:
      text/append_text(output ") (execution (guarantee exact) (status enabled) (tier posix-v1-with-serial-fallback)))")
    false:
      text/append_text(output ") (execution (guarantee exact) (status disabled) (reason no-profitable-capture-safe-site)))")
