module parallel

struct Blockers:
  declared_effects: Bool
  exclusive_borrow: Bool
  mutation: Bool
  checked_trap: Bool
  allocation_or_io: Bool
  recurrence: Bool
  callee_not_safe: Bool
  call_cycle: Bool
  function_limit: Bool
  edge_limit: Bool
  missing_typed_fact: Bool

struct FunctionFact:
  item: I64
  name: I64
  status: I64
  reason: I64
  blockers: Blockers
  first_edge: I64
  edge_count: I64
  body: I64
  body_tokens: I64

struct CallEdge:
  caller: I64
  callee: I64

struct Scan:
  reason: I64
  blockers: Blockers
  calls: I64
  complete: Bool

struct Evaluation:
  status: I64
  reason: I64
  calls: I64

struct Site:
  site: I64
  first: I64
  second: I64
  join: I64
  first_work: I64
  second_work: I64
  allocates: Bool
  explicit: Bool
  executable: Bool

struct Schedule:
  candidates: I64
  selected: I64
  reported: I64
  executable: I64
  executed: I64
  selected_until: I64

struct View:
  facts: Vec[FunctionFact]
  sites: Vec[Site]
  functions: I64
  exact: Bool
  schedule: Schedule

fn empty_blockers() -> Blockers:
  Blockers(declared_effects: false, exclusive_borrow: false, mutation: false, checked_trap: false, allocation_or_io: false, recurrence: false, callee_not_safe: false, call_cycle: false, function_limit: false, edge_limit: false, missing_typed_fact: false)

fn add_blocker(blockers: Blockers, reason: I64) -> Blockers:
  Blockers(declared_effects: blockers.declared_effects || (reason == 1), exclusive_borrow: blockers.exclusive_borrow || (reason == 2), mutation: blockers.mutation || (reason == 3), checked_trap: blockers.checked_trap || (reason == 4), allocation_or_io: blockers.allocation_or_io || (reason == 5), recurrence: blockers.recurrence || (reason == 6), callee_not_safe: blockers.callee_not_safe || (reason == 7), call_cycle: blockers.call_cycle || (reason == 8), function_limit: blockers.function_limit || (reason == 9), edge_limit: blockers.edge_limit || (reason == 10), missing_typed_fact: blockers.missing_typed_fact || (reason == 11))

fn first_reason(current: I64, candidate: I64) -> I64:
  let present: Bool = current > 0
  if present:
    current
  else:
    candidate

fn merge_status(current: I64, candidate: I64) -> I64:
  let current_unavailable: Bool = current == 2
  if current_unavailable:
    2
  else:
    let candidate_unavailable: Bool = candidate == 2
    if candidate_unavailable:
      2
    else:
      let either_unknown: Bool = (current == 0) || (candidate == 0)
      if either_unknown:
        0
      else:
        1

fn typed_expression(inout facts: Vec[typing.Fact], expr: I64) -> Bool effects[partial]:
  let typed: typing.TypeRef = typing.fact_type(facts, expr)
  typed.kind >= -1

fn call_hazard(source: Bytes, inout tokens: Vec[syntax.Token], inout range_facts: Vec[ranges.Fact], expr: I64, callee: I64) -> I64 effects[partial]:
  let alloc: Bool = effects.call_requires(source, tokens, callee, 1)
  let io: Bool = effects.call_requires(source, tokens, callee, 2)
  let effectful: Bool = alloc || io
  if effectful:
    5
  else:
    let trapping: Bool = ranges.callee_is_checked_trap(source, tokens, callee)
    let proven_total: Bool = if trapping:
      ranges.fact_total(range_facts, expr)
    else:
      false
    let effective_trap: Bool = trapping && (!proven_total)
    if effective_trap:
      4
    else:
      0

fn append_edge(caller: I64, callee: I64, inout edges: Vec[CallEdge]) -> Bool effects[alloc, partial]:
  let count: I64 = vec.len(edges)
  let bounded: Bool = count < 4096
  if bounded:
    let edge: CallEdge = CallEdge(caller: caller, callee: callee)
    vec.push(edges, edge)
    true
  else:
    false

fn collect_span(source: Bytes, inout tokens: Vec[syntax.Token], inout range_facts: Vec[ranges.Fact], index: I64, end: I64, caller: I64, inout edges: Vec[CallEdge], reason: I64, blockers: Blockers, calls: I64, complete: Bool) -> Scan effects[alloc, partial]:
  let done: Bool = index >= end
  if done:
    Scan(reason: reason, blockers: blockers, calls: calls, complete: complete)
  else:
    let kind: I64 = syntax.ast_node_kind(tokens, index)
    let form: Bool = kind == 0
    let head: I64 = syntax.ast_list_first(index)
    let set_form: Bool = if form:
      syntax.ast_expression_is_set(source, tokens, index)
    else:
      false
    let recur_form: Bool = if form:
      syntax.ast_expression_is_recur(source, tokens, index)
    else:
      false
    let recur_total: Bool = if recur_form:
      ranges.fact_total(range_facts, index)
    else:
      false
    let unsafe_recur: Bool = recur_form && (!recur_total)
    let call_form: Bool = if form:
      syntax.ast_expression_is_call(source, tokens, index)
    else:
      false
    let callee: I64 = syntax.ast_call_callee(index)
    let hazard: I64 = if set_form:
      3
    else:
      if unsafe_recur:
        6
      else:
        if call_form:
          call_hazard(source, tokens, range_facts, index, callee)
        else:
          0
    let next_reason: I64 = first_reason(reason, hazard)
    let next_blockers: Blockers = add_blocker(blockers, hazard)
    let builtin: Bool = if call_form:
      typing.builtin_known(source, tokens, callee)
    else:
      true
    let user_call: Bool = call_form && (!builtin)
    let callee_item: I64 = if user_call:
      syntax.ast_node_link(tokens, callee)
    else:
      -1
    let appended: Bool = if user_call:
      append_edge(caller, callee_item, edges)
    else:
      true
    let next_calls: I64 = if user_call:
      calls + 1
    else:
      calls
    let next_complete: Bool = complete && appended
    let next: I64 = syntax.ast_node_after(index)
    recur(source, tokens, range_facts, next, end, caller, edges, next_reason, next_blockers, next_calls, next_complete)

fn params_have_inout(source: Bytes, inout tokens: Vec[syntax.Token], cursor: I64) -> Bool effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    false
  else:
    let head: I64 = syntax.ast_list_first(cursor)
    let borrowed: Bool = syntax.ast_binding_is_inout(source, tokens, cursor)
    if borrowed:
      true
    else:
      let next: I64 = syntax.ast_next(tokens, cursor)
      recur(source, tokens, next)

fn collect_function(source: Bytes, inout tokens: Vec[syntax.Token], inout typed_facts: Vec[typing.Fact], inout range_facts: Vec[ranges.Fact], item: I64, inout facts: Vec[FunctionFact], inout edges: Vec[CallEdge]) -> Void effects[alloc, partial]:
  let fact_index: I64 = vec.len(facts)
  let name: I64 = syntax.ast_item_name(item)
  let params: I64 = syntax.ast_function_parameters(item)
  let return_type: I64 = syntax.ast_function_return_type(tokens, item)
  let effects_form: I64 = syntax.ast_function_effects(tokens, item)
  let body: I64 = syntax.ast_next(tokens, effects_form)
  let body_end: I64 = syntax.ast_next(tokens, body)
  let first_edge: I64 = vec.len(edges)
  let scanned: Scan = collect_span(source, tokens, range_facts, body, body_end, fact_index, edges, 0, empty_blockers(), 0, true)
  let edge_end: I64 = vec.len(edges)
  let edge_count: I64 = edge_end - first_edge
  let first_param: I64 = syntax.ast_parameters_first(params)
  let borrowed: Bool = params_have_inout(source, tokens, first_param)
  let typed: Bool = typed_expression(typed_facts, body)
  let local_reason: I64 = if typed:
    if borrowed:
      2
    else:
      scanned.reason
  else:
    11
  let scanned_blockers: Blockers = scanned.blockers
  let borrowed_blockers: Blockers = if borrowed:
    add_blocker(scanned_blockers, 2)
  else:
    scanned_blockers
  let typed_blockers: Blockers = if typed:
    borrowed_blockers
  else:
    add_blocker(borrowed_blockers, 11)
  let complete: Bool = scanned.complete
  let blockers: Blockers = if complete:
    typed_blockers
  else:
    add_blocker(typed_blockers, 10)
  let reason: I64 = if complete:
    local_reason
  else:
    first_reason(local_reason, 10)
  let reason_present: Bool = reason > 0
  let unknown_reason: Bool = (reason == 10) || (reason == 11)
  let status: I64 = if reason_present:
    if unknown_reason:
      0
    else:
      2
  else:
    let no_calls: Bool = scanned.calls == 0
    if no_calls:
      1
    else:
      0
  let fact: FunctionFact = FunctionFact(item: item, name: name, status: status, reason: reason, blockers: blockers, first_edge: first_edge, edge_count: edge_count, body: body, body_tokens: body_end - body)
  vec.push(facts, fact)

fn collect_functions(source: Bytes, inout tokens: Vec[syntax.Token], inout typed_facts: Vec[typing.Fact], inout range_facts: Vec[ranges.Fact], cursor: I64, inout facts: Vec[FunctionFact], inout edges: Vec[CallEdge], total: I64) -> I64 effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    total
  else:
    let function_item: Bool = syntax.ast_item_is_function(source, tokens, cursor)
    let next_total: I64 = if function_item:
      total + 1
    else:
      total
    let count: I64 = vec.len(facts)
    let bounded: Bool = count < 64
    let selected: Bool = function_item && bounded
    if selected:
      collect_function(source, tokens, typed_facts, range_facts, cursor, facts, edges)
    else:
      void
    let next: I64 = syntax.ast_next(tokens, cursor)
    recur(source, tokens, typed_facts, range_facts, next, facts, edges, next_total)

fn find_fact_item(inout facts: Vec[FunctionFact], item: I64, index: I64) -> I64 effects[partial]:
  let count: I64 = vec.len(facts)
  let done: Bool = index >= count
  if done:
    -1
  else:
    let fact: FunctionFact = vec.get(facts, index)
    let same: Bool = fact.item == item
    if same:
      index
    else:
      let next: I64 = index + 1
      recur(facts, item, next)

fn link_edges(inout facts: Vec[FunctionFact], inout edges: Vec[CallEdge], index: I64) -> Void effects[partial]:
  let count: I64 = vec.len(edges)
  let done: Bool = index >= count
  if done:
    void
  else:
    let edge: CallEdge = vec.get(edges, index)
    let callee_index: I64 = find_fact_item(facts, edge.callee, 0)
    let updated: CallEdge = CallEdge(caller: edge.caller, callee: callee_index)
    vec.set(edges, index, updated)
    let next: I64 = index + 1
    recur(facts, edges, next)

fn resolve_edges(inout facts: Vec[FunctionFact], inout edges: Vec[CallEdge], index: I64, end: I64, status: I64, reason: I64) -> Evaluation effects[partial]:
  let done: Bool = index >= end
  if done:
    Evaluation(status: status, reason: reason, calls: 0)
  else:
    let edge: CallEdge = vec.get(edges, index)
    let callee_index: I64 = edge.callee
    let missing: Bool = callee_index < 0
    let candidate_status: I64 = if missing:
      0
    else:
      let callee: FunctionFact = vec.get(facts, callee_index)
      callee.status
    let candidate_reason: I64 = if missing:
      9
    else:
      let callee: FunctionFact = vec.get(facts, callee_index)
      let unavailable: Bool = callee.status == 2
      if unavailable:
        7
      else:
        let known_reason: Bool = callee.reason > 0
        if known_reason:
          callee.reason
        else:
          8
    let next_status: I64 = merge_status(status, candidate_status)
    let next_reason: I64 = if next_status == status:
      first_reason(reason, candidate_reason)
    else:
      candidate_reason
    let next: I64 = index + 1
    recur(facts, edges, next, end, next_status, next_reason)

fn resolve_fact(inout facts: Vec[FunctionFact], inout edges: Vec[CallEdge], index: I64) -> Bool effects[partial]:
  let fact: FunctionFact = vec.get(facts, index)
  let unresolved: Bool = fact.status == 0
  let no_reason: Bool = fact.reason == 0
  let eligible: Bool = unresolved && no_reason
  if eligible:
    let end: I64 = fact.first_edge + fact.edge_count
    let resolution: Evaluation = resolve_edges(facts, edges, fact.first_edge, end, 1, 0)
    let changed: Bool = !(resolution.status == 0)
    if changed:
      let safe: Bool = resolution.status == 1
      let blockers: Blockers = if safe:
        fact.blockers
      else:
        add_blocker(fact.blockers, resolution.reason)
      let updated: FunctionFact = FunctionFact(item: fact.item, name: fact.name, status: resolution.status, reason: resolution.reason, blockers: blockers, first_edge: fact.first_edge, edge_count: fact.edge_count, body: fact.body, body_tokens: fact.body_tokens)
      vec.set(facts, index, updated)
      true
    else:
      false
  else:
    false

fn resolve_pass(inout facts: Vec[FunctionFact], inout edges: Vec[CallEdge], index: I64, changes: I64) -> I64 effects[partial]:
  let count: I64 = vec.len(facts)
  let done: Bool = index >= count
  if done:
    changes
  else:
    let changed: Bool = resolve_fact(facts, edges, index)
    let next_changes: I64 = if changed:
      changes + 1
    else:
      changes
    let next: I64 = index + 1
    recur(facts, edges, next, next_changes)

fn resolve_graph(inout facts: Vec[FunctionFact], inout edges: Vec[CallEdge], pass: I64) -> Void effects[partial]:
  let exhausted: Bool = pass >= 64
  if exhausted:
    void
  else:
    let changes: I64 = resolve_pass(facts, edges, 0, 0)
    let stable: Bool = changes == 0
    if stable:
      void
    else:
      let next: I64 = pass + 1
      recur(facts, edges, next)

fn finalize_unknowns(inout facts: Vec[FunctionFact], inout edges: Vec[CallEdge], index: I64) -> Void effects[partial]:
  let count: I64 = vec.len(facts)
  let done: Bool = index >= count
  if done:
    void
  else:
    let fact: FunctionFact = vec.get(facts, index)
    let unknown: Bool = fact.status == 0
    let absent: Bool = fact.reason == 0
    let needs_reason: Bool = unknown && absent
    if needs_reason:
      let end: I64 = fact.first_edge + fact.edge_count
      let resolution: Evaluation = resolve_edges(facts, edges, fact.first_edge, end, 1, 0)
      let reason: I64 = if resolution.reason > 0:
        resolution.reason
      else:
        8
      let next_fact: FunctionFact = FunctionFact(item: fact.item, name: fact.name, status: 0, reason: reason, blockers: add_blocker(fact.blockers, reason), first_edge: fact.first_edge, edge_count: fact.edge_count, body: fact.body, body_tokens: fact.body_tokens)
      vec.set(facts, index, next_fact)
    else:
      void
    let next: I64 = index + 1
    recur(facts, edges, next)

fn graph_blockers(inout facts: Vec[FunctionFact], inout edges: Vec[CallEdge], index: I64, end: I64, blockers: Blockers) -> Blockers effects[partial]:
  let done: Bool = index >= end
  if done:
    blockers
  else:
    let edge: CallEdge = vec.get(edges, index)
    let callee_index: I64 = edge.callee
    let missing: Bool = callee_index < 0
    let reason: I64 = if missing:
      9
    else:
      let callee: FunctionFact = vec.get(facts, callee_index)
      let unavailable: Bool = callee.status == 2
      let unknown: Bool = callee.status == 0
      if unavailable:
        7
      else:
        if unknown:
          let known: Bool = callee.reason > 0
          if known:
            callee.reason
          else:
            8
        else:
          0
    let next_blockers: Blockers = add_blocker(blockers, reason)
    let next: I64 = index + 1
    recur(facts, edges, next, end, next_blockers)

fn enrich_graph_blockers(inout facts: Vec[FunctionFact], inout edges: Vec[CallEdge], index: I64) -> Void effects[partial]:
  let count: I64 = vec.len(facts)
  let done: Bool = index >= count
  if done:
    void
  else:
    let fact: FunctionFact = vec.get(facts, index)
    let end: I64 = fact.first_edge + fact.edge_count
    let blockers: Blockers = graph_blockers(facts, edges, fact.first_edge, end, fact.blockers)
    let updated: FunctionFact = FunctionFact(item: fact.item, name: fact.name, status: fact.status, reason: fact.reason, blockers: blockers, first_edge: fact.first_edge, edge_count: fact.edge_count, body: fact.body, body_tokens: fact.body_tokens)
    vec.set(facts, index, updated)
    let next: I64 = index + 1
    recur(facts, edges, next)

fn evaluate_span(source: Bytes, inout tokens: Vec[syntax.Token], inout range_facts: Vec[ranges.Fact], inout facts: Vec[FunctionFact], index: I64, end: I64, status: I64, reason: I64, calls: I64) -> Evaluation effects[partial]:
  let done: Bool = index >= end
  if done:
    Evaluation(status: status, reason: reason, calls: calls)
  else:
    let kind: I64 = syntax.ast_node_kind(tokens, index)
    let form: Bool = kind == 0
    let head: I64 = syntax.ast_list_first(index)
    let set_form: Bool = if form:
      syntax.ast_expression_is_set(source, tokens, index)
    else:
      false
    let recur_form: Bool = if form:
      syntax.ast_expression_is_recur(source, tokens, index)
    else:
      false
    let call_form: Bool = if form:
      syntax.ast_expression_is_call(source, tokens, index)
    else:
      false
    let callee: I64 = syntax.ast_call_callee(index)
    let hazard: I64 = if set_form:
      3
    else:
      if recur_form:
        6
      else:
        if call_form:
          call_hazard(source, tokens, range_facts, index, callee)
        else:
          0
    let builtin: Bool = if call_form:
      typing.builtin_known(source, tokens, callee)
    else:
      true
    let user_call: Bool = call_form && (!builtin)
    let callee_item: I64 = if user_call:
      syntax.ast_node_link(tokens, callee)
    else:
      -1
    let fact_index: I64 = if user_call:
      find_fact_item(facts, callee_item, 0)
    else:
      -1
    let missing: Bool = user_call && (fact_index < 0)
    let callee_status: I64 = if missing:
      0
    else:
      if user_call:
        let callee_fact: FunctionFact = vec.get(facts, fact_index)
        callee_fact.status
      else:
        1
    let callee_reason: I64 = if missing:
      9
    else:
      if user_call:
        let callee_fact: FunctionFact = vec.get(facts, fact_index)
        if callee_fact.status == 2:
          7
        else:
          callee_fact.reason
      else:
        0
    let local_status: I64 = if hazard > 0:
      2
    else:
      callee_status
    let local_reason: I64 = if hazard > 0:
      hazard
    else:
      callee_reason
    let next_status: I64 = merge_status(status, local_status)
    let next_reason: I64 = if next_status == status:
      first_reason(reason, local_reason)
    else:
      local_reason
    let next_calls: I64 = if user_call:
      calls + 1
    else:
      calls
    let next: I64 = syntax.ast_node_after(index)
    recur(source, tokens, range_facts, facts, next, end, next_status, next_reason, next_calls)

fn evaluate_expression(source: Bytes, inout tokens: Vec[syntax.Token], inout typed_facts: Vec[typing.Fact], inout range_facts: Vec[ranges.Fact], inout facts: Vec[FunctionFact], expr: I64) -> Evaluation effects[partial]:
  let typed: Bool = typed_expression(typed_facts, expr)
  if typed:
    let end: I64 = syntax.ast_next(tokens, expr)
    evaluate_span(source, tokens, range_facts, facts, expr, end, 1, 0, 0)
  else:
    Evaluation(status: 0, reason: 11, calls: 0)

fn expression_uses_binding(inout tokens: Vec[syntax.Token], index: I64, end: I64, declaration: I64) -> Bool effects[partial]:
  let done: Bool = index >= end
  if done:
    false
  else:
    let linked: I64 = typing.linked_binding_declaration(tokens, index)
    let same: Bool = linked == declaration
    if same:
      true
    else:
      let next: I64 = syntax.ast_node_after(index)
      recur(tokens, next, end, declaration)

fn append_i64(value: I64, inout output: Vec[U8]) -> Void effects[alloc, partial]:
  text.append_nonnegative_i64(value, output)

fn emit_reason(reason: I64, inout output: Vec[U8]) -> Void effects[alloc, partial]:
  if reason == 1:
    text.append_text(output, "declared-effects")
  else:
    if reason == 2:
      text.append_text(output, "exclusive-borrow")
    else:
      if reason == 3:
        text.append_text(output, "mutation")
      else:
        if reason == 4:
          text.append_text(output, "checked-trap")
        else:
          if reason == 5:
            text.append_text(output, "allocation-or-io")
          else:
            if reason == 6:
              text.append_text(output, "recurrence")
            else:
              if reason == 7:
                text.append_text(output, "callee-not-safe")
              else:
                if reason == 8:
                  text.append_text(output, "call-cycle")
                else:
                  if reason == 9:
                    text.append_text(output, "function-limit")
                  else:
                    if reason == 10:
                      text.append_text(output, "edge-limit")
                    else:
                      text.append_text(output, "missing-typed-fact")

fn emit_blocker(present: Bool, name: Bytes, inout output: Vec[U8]) -> Void effects[alloc, partial]:
  if present:
    text.append_text(output, " ")
    text.append_text(output, name)
  else:
    void

fn emit_blockers(blockers: Blockers, inout output: Vec[U8]) -> Void effects[alloc, partial]:
  text.append_text(output, " (blockers")
  emit_blocker(blockers.declared_effects, "declared-effects", output)
  emit_blocker(blockers.exclusive_borrow, "exclusive-borrow", output)
  emit_blocker(blockers.mutation, "mutation", output)
  emit_blocker(blockers.checked_trap, "checked-trap", output)
  emit_blocker(blockers.allocation_or_io, "allocation-or-io", output)
  emit_blocker(blockers.recurrence, "recurrence", output)
  emit_blocker(blockers.callee_not_safe, "callee-not-safe", output)
  emit_blocker(blockers.call_cycle, "call-cycle", output)
  emit_blocker(blockers.function_limit, "function-limit", output)
  emit_blocker(blockers.edge_limit, "edge-limit", output)
  emit_blocker(blockers.missing_typed_fact, "missing-typed-fact", output)
  text.append_text(output, ")")

fn emit_function_fact(source: Bytes, inout tokens: Vec[syntax.Token], fact: FunctionFact, inout output: Vec[U8]) -> Void effects[alloc, partial]:
  text.append_text(output, " (function-parallel-safety ")
  append_i64(fact.item, output)
  text.append_text(output, " ")
  text.append_token(source, tokens, fact.name, output)
  let safe: Bool = fact.status == 1
  let unavailable: Bool = fact.status == 2
  if safe:
    text.append_text(output, " (guarantee exact) (status safe)")
  else:
    if unavailable:
      text.append_text(output, " (guarantee exact) (status unavailable) (reason ")
    else:
      text.append_text(output, " (guarantee unknown) (status unknown) (reason ")
  if safe:
    void
  else:
    emit_reason(fact.reason, output)
    text.append_text(output, ")")
  emit_blockers(fact.blockers, output)
  text.append_text(output, " (body-tokens ")
  append_i64(fact.body_tokens, output)
  text.append_text(output, "))")

fn emit_function_facts(source: Bytes, inout tokens: Vec[syntax.Token], inout facts: Vec[FunctionFact], index: I64, inout output: Vec[U8]) -> Void effects[alloc, partial]:
  let count: I64 = vec.len(facts)
  let done: Bool = index >= count
  if done:
    void
  else:
    let fact: FunctionFact = vec.get(facts, index)
    emit_function_fact(source, tokens, fact, output)
    let next: I64 = index + 1
    recur(source, tokens, facts, next, output)

fn direct_user_call(source: Bytes, inout tokens: Vec[syntax.Token], expr: I64) -> Bool effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, expr)
  let form: Bool = kind == 0
  let head: I64 = syntax.ast_list_first(expr)
  let call_form: Bool = if form:
    syntax.ast_expression_is_call(source, tokens, expr)
  else:
    false
  let callee: I64 = syntax.ast_call_callee(expr)
  let builtin: Bool = if call_form:
    typing.builtin_known(source, tokens, callee)
  else:
    true
  let linked: I64 = if call_form:
    syntax.ast_node_link(tokens, callee)
  else:
    -1
  call_form && ((!builtin) && (linked >= 0))

fn arguments_atomic(inout tokens: Vec[syntax.Token], cursor: I64) -> Bool effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    true
  else:
    let atom: Bool = kind == 2
    let string: Bool = kind == 3
    let scalar: Bool = atom || string
    if scalar:
      let next: I64 = syntax.ast_next(tokens, cursor)
      recur(tokens, next)
    else:
      false

fn call_work(source: Bytes, inout tokens: Vec[syntax.Token], inout range_view: ranges.View, expr: I64) -> ranges.Work effects[partial]:
  let direct: Bool = direct_user_call(source, tokens, expr)
  if direct:
    let callee: I64 = syntax.ast_call_callee(expr)
    let item: I64 = syntax.ast_node_link(tokens, callee)
    let arguments: I64 = syntax.ast_call_arguments(expr)
    ranges.recurrence_work(source, tokens, range_view, item, arguments)
  else:
    ranges.Work(known: false, iterations: 0)

fn work_value(work: ranges.Work) -> I64:
  if work.known:
    work.iterations
  else:
    -1

fn emit_work(work: I64, inout output: Vec[U8]) -> Void effects[alloc, partial]:
  let known: Bool = work >= 0
  if known:
    append_i64(work, output)
  else:
    text.append_text(output, "unknown")

fn work_profitable(work: ranges.Work) -> Bool:
  work.known && (work.iterations >= 1000000)

fn capture_ready(source: Bytes, inout tokens: Vec[syntax.Token], expr: I64) -> Bool effects[partial]:
  let direct: Bool = direct_user_call(source, tokens, expr)
  let arguments: I64 = syntax.ast_call_arguments(expr)
  let atomic: Bool = if direct:
    arguments_atomic(tokens, arguments)
  else:
    false
  direct && atomic

fn leading_let_site(source: Bytes, inout tokens: Vec[syntax.Token], cursor: I64, site: I64) -> Bool effects[partial]:
  let found: Bool = cursor == site
  if found:
    true
  else:
    let kind: I64 = syntax.ast_node_kind(tokens, cursor)
    let form: Bool = kind == 0
    let head: I64 = syntax.ast_list_first(cursor)
    let let_form: Bool = if form:
      syntax.ast_expression_is_let(source, tokens, cursor)
    else:
      false
    if let_form:
      let type_index: I64 = syntax.ast_let_type(cursor)
      let value: I64 = syntax.ast_let_value(tokens, cursor)
      let body: I64 = syntax.ast_let_body(tokens, cursor)
      recur(source, tokens, body, site)
    else:
      false

fn collect_sites_in_function(source: Bytes, inout tokens: Vec[syntax.Token], inout typed_facts: Vec[typing.Fact], inout range_view: ranges.View, inout range_facts: Vec[ranges.Fact], inout facts: Vec[FunctionFact], root: I64, index: I64, end: I64, inout sites: Vec[Site], schedule: Schedule) -> Schedule effects[alloc, partial]:
  let done: Bool = index >= end
  if done:
    schedule
  else:
    let kind: I64 = syntax.ast_node_kind(tokens, index)
    let form: Bool = kind == 0
    let head: I64 = syntax.ast_list_first(index)
    let let_form: Bool = if form:
      syntax.ast_expression_is_let(source, tokens, index)
    else:
      false
    let name: I64 = syntax.ast_let_name(index)
    let type_index: I64 = syntax.ast_let_type(index)
    let value: I64 = if let_form:
      syntax.ast_let_value(tokens, index)
    else:
      index
    let body: I64 = if let_form:
      syntax.ast_let_body(tokens, index)
    else:
      index
    let body_kind: I64 = if let_form:
      syntax.ast_node_kind(tokens, body)
    else:
      -1
    let body_form: Bool = body_kind == 0
    let body_head: I64 = syntax.ast_list_first(body)
    let adjacent_let: Bool = if body_form:
      syntax.ast_expression_is_let(source, tokens, body)
    else:
      false
    let inner_type: I64 = syntax.ast_let_type(body)
    let inner_value: I64 = if adjacent_let:
      syntax.ast_let_value(tokens, body)
    else:
      body
    let inner_body: I64 = if adjacent_let:
      syntax.ast_let_body(tokens, body)
    else:
      body
    let first_eval: Evaluation = if adjacent_let:
      evaluate_expression(source, tokens, typed_facts, range_facts, facts, value)
    else:
      Evaluation(status: 0, reason: 0, calls: 0)
    let second_eval: Evaluation = if adjacent_let:
      evaluate_expression(source, tokens, typed_facts, range_facts, facts, inner_value)
    else:
      Evaluation(status: 0, reason: 0, calls: 0)
    let both_safe: Bool = (first_eval.status == 1) && (second_eval.status == 1)
    let both_calls: Bool = (first_eval.calls > 0) && (second_eval.calls > 0)
    let inner_end: I64 = if adjacent_let:
      syntax.ast_next(tokens, inner_value)
    else:
      inner_value
    let dependent: Bool = if adjacent_let:
      expression_uses_binding(tokens, inner_value, inner_end, name)
    else:
      true
    let independent: Bool = !dependent
    let eligible: Bool = adjacent_let && (both_safe && (both_calls && independent))
    let after_previous: Bool = index >= schedule.selected_until
    let selected: Bool = eligible && after_previous
    let under_limit: Bool = schedule.reported < 64
    let reported: Bool = selected && under_limit
    let first_work: ranges.Work = if adjacent_let:
      call_work(source, tokens, range_view, value)
    else:
      ranges.Work(known: false, iterations: 0)
    let second_work: ranges.Work = if adjacent_let:
      call_work(source, tokens, range_view, inner_value)
    else:
      ranges.Work(known: false, iterations: 0)
    let first_capture: Bool = if adjacent_let:
      capture_ready(source, tokens, value)
    else:
      false
    let second_capture: Bool = if adjacent_let:
      capture_ready(source, tokens, inner_value)
    else:
      false
    let captures: Bool = first_capture && second_capture
    let profitable: Bool = work_profitable(first_work) && work_profitable(second_work)
    let leading: Bool = if adjacent_let:
      leading_let_site(source, tokens, root, index)
    else:
      false
    let executable: Bool = selected && (leading && (captures && profitable))
    if reported:
      let site: Site = Site(site: index, first: value, second: inner_value, join: inner_body, first_work: work_value(first_work), second_work: work_value(second_work), allocates: false, explicit: false, executable: executable)
      vec.push(sites, site)
    else:
      void
    let next_candidates: I64 = if eligible:
      schedule.candidates + 1
    else:
      schedule.candidates
    let next_selected: I64 = if selected:
      schedule.selected + 1
    else:
      schedule.selected
    let next_reported: I64 = if reported:
      schedule.reported + 1
    else:
      schedule.reported
    let next_executable: I64 = if executable:
      schedule.executable + 1
    else:
      schedule.executable
    let executed: Bool = executable && reported
    let next_executed: I64 = if executed:
      schedule.executed + 1
    else:
      schedule.executed
    let next_until: I64 = if selected:
      inner_body
    else:
      schedule.selected_until
    let next_schedule: Schedule = Schedule(candidates: next_candidates, selected: next_selected, reported: next_reported, executable: next_executable, executed: next_executed, selected_until: next_until)
    let next: I64 = syntax.ast_node_after(index)
    recur(source, tokens, typed_facts, range_view, range_facts, facts, root, next, end, sites, next_schedule)

fn collect_sites(source: Bytes, inout tokens: Vec[syntax.Token], inout typed_facts: Vec[typing.Fact], inout range_view: ranges.View, inout range_facts: Vec[ranges.Fact], inout facts: Vec[FunctionFact], index: I64, inout sites: Vec[Site], schedule: Schedule) -> Schedule effects[alloc, partial]:
  let fact_count: I64 = vec.len(facts)
  let done: Bool = index >= fact_count
  if done:
    schedule
  else:
    let fact: FunctionFact = vec.get(facts, index)
    let end: I64 = syntax.ast_next(tokens, fact.body)
    let next_schedule: Schedule = collect_sites_in_function(source, tokens, typed_facts, range_view, range_facts, facts, fact.body, fact.body, end, sites, schedule)
    let next: I64 = index + 1
    recur(source, tokens, typed_facts, range_view, range_facts, facts, next, sites, next_schedule)

fn append_explicit_site(source: Bytes, inout tokens: Vec[syntax.Token], index: I64, inout sites: Vec[Site], schedule: Schedule) -> Schedule effects[alloc, partial]:
  let first_let: I64 = syntax.ast_fork_body(index)
  let first_type: I64 = syntax.ast_let_type(first_let)
  let first_value: I64 = syntax.ast_let_value(tokens, first_let)
  let second_let: I64 = syntax.ast_let_body(tokens, first_let)
  let second_type: I64 = syntax.ast_let_type(second_let)
  let second_value: I64 = syntax.ast_let_value(tokens, second_let)
  let join: I64 = syntax.ast_let_body(tokens, second_let)
  let under_limit: Bool = schedule.reported < 64
  if under_limit:
    let site: Site = Site(site: index, first: first_value, second: second_value, join: join, first_work: -1, second_work: -1, allocates: effects.call_requires(source, tokens, syntax.ast_call_callee(first_value), 1) || effects.call_requires(source, tokens, syntax.ast_call_callee(second_value), 1), explicit: true, executable: true)
    vec.push(sites, site)
  else:
    void
  let next_candidates: I64 = schedule.candidates + 1
  let next_selected: I64 = schedule.selected + 1
  let next_reported: I64 = if under_limit:
    schedule.reported + 1
  else:
    schedule.reported
  let next_executable: I64 = if under_limit:
    schedule.executable + 1
  else:
    schedule.executable
  let next_executed: I64 = if under_limit:
    schedule.executed + 1
  else:
    schedule.executed
  Schedule(candidates: next_candidates, selected: next_selected, reported: next_reported, executable: next_executable, executed: next_executed, selected_until: schedule.selected_until)

fn collect_explicit_sites_in_function(source: Bytes, inout tokens: Vec[syntax.Token], index: I64, end: I64, inout sites: Vec[Site], schedule: Schedule) -> Schedule effects[alloc, partial]:
  let done: Bool = index >= end
  if done:
    schedule
  else:
    let kind: I64 = syntax.ast_node_kind(tokens, index)
    let form: Bool = kind == 0
    let head: I64 = syntax.ast_list_first(index)
    let fork_form: Bool = if form:
      syntax.ast_expression_is_fork(source, tokens, index)
    else:
      false
    let next_schedule: Schedule = if fork_form:
      append_explicit_site(source, tokens, index, sites, schedule)
    else:
      schedule
    let next: I64 = syntax.ast_node_after(index)
    recur(source, tokens, next, end, sites, next_schedule)

fn collect_explicit_sites(source: Bytes, inout tokens: Vec[syntax.Token], inout facts: Vec[FunctionFact], index: I64, inout sites: Vec[Site], schedule: Schedule) -> Schedule effects[alloc, partial]:
  let fact_count: I64 = vec.len(facts)
  let done: Bool = index >= fact_count
  if done:
    schedule
  else:
    let fact: FunctionFact = vec.get(facts, index)
    let end: I64 = syntax.ast_next(tokens, fact.body)
    let next_schedule: Schedule = collect_explicit_sites_in_function(source, tokens, fact.body, end, sites, schedule)
    let next: I64 = index + 1
    recur(source, tokens, facts, next, sites, next_schedule)

fn edge_complete(inout facts: Vec[FunctionFact], index: I64) -> Bool effects[partial]:
  let count: I64 = vec.len(facts)
  let done: Bool = index >= count
  if done:
    true
  else:
    let fact: FunctionFact = vec.get(facts, index)
    let limited: Bool = fact.reason == 10
    if limited:
      false
    else:
      let next: I64 = index + 1
      recur(facts, next)

fn analyze(source: Bytes, inout tokens: Vec[syntax.Token], inout typed_facts: Vec[typing.Fact], inout range_view: ranges.View) -> View effects[alloc, partial]:
  let range_facts: Vec[ranges.Fact] = range_view.facts
  let facts: Vec[FunctionFact] = vec.new()
  let edges: Vec[CallEdge] = vec.new()
  let total: I64 = collect_functions(source, tokens, typed_facts, range_facts, 3, facts, edges, 0)
  link_edges(facts, edges, 0)
  resolve_graph(facts, edges, 0)
  finalize_unknowns(facts, edges, 0)
  enrich_graph_blockers(facts, edges, 0)
  let functions_bounded: Bool = total <= 64
  let edges_bounded: Bool = edge_complete(facts, 0)
  let exact: Bool = functions_bounded && edges_bounded
  let sites: Vec[Site] = vec.new()
  let initial: Schedule = Schedule(candidates: 0, selected: 0, reported: 0, executable: 0, executed: 0, selected_until: -1)
  let explicit_schedule: Schedule = collect_explicit_sites(source, tokens, facts, 0, sites, initial)
  let schedule: Schedule = collect_sites(source, tokens, typed_facts, range_view, range_facts, facts, 0, sites, explicit_schedule)
  View(facts: facts, sites: sites, functions: total, exact: exact, schedule: schedule)

fn emit_site_intent(site: Site, inout output: Vec[U8]) -> Void effects[alloc, partial]:
  if site.explicit:
    text.append_text(output, " (intent explicit)")
  else:
    text.append_text(output, " (intent automatic)")

fn emit_site_profitability(site: Site, inout output: Vec[U8]) -> Void effects[alloc, partial]:
  if site.explicit:
    text.append_text(output, " (profitability explicit) (profitable true) (target-tier posix-v1)")
  else:
    if site.executable:
      text.append_text(output, " (profitability exact) (profitable true) (target-tier posix-v1) (minimum-task-iterations 1000000)")
    else:
      let work_known: Bool = (site.first_work >= 0) && (site.second_work >= 0)
      if work_known:
        text.append_text(output, " (profitability exact) (profitable false) (profitability-reason below-posix-v1-threshold)")
      else:
        text.append_text(output, " (profitability unknown) (profitability-reason target-work-unavailable)")

fn emit_fork_site(inout tokens: Vec[syntax.Token], site: Site, inout output: Vec[U8]) -> Void effects[alloc, partial]:
  let first: I64 = site.first
  let second: I64 = site.second
  let first_end: I64 = syntax.ast_next(tokens, first)
  let second_end: I64 = syntax.ast_next(tokens, second)
  text.append_text(output, " (fork-site ")
  append_i64(site.site, output)
  emit_site_intent(site, output)
  text.append_text(output, " (guarantee exact) (tasks ")
  append_i64(first, output)
  text.append_text(output, " ")
  append_i64(second, output)
  text.append_text(output, ") (join ")
  append_i64(site.join, output)
  text.append_text(output, ") (race-free true) (deadlock-free true)")
  emit_site_profitability(site, output)
  text.append_text(output, " (task-work ")
  emit_work(site.first_work, output)
  text.append_text(output, " ")
  emit_work(site.second_work, output)
  text.append_text(output, ") (task-tokens ")
  append_i64(first_end - first, output)
  text.append_text(output, " ")
  append_i64(second_end - second, output)
  if site.executable:
    text.append_text(output, ") (execution selected))")
  else:
    text.append_text(output, ") (execution not-selected))")

fn emit_sites(inout tokens: Vec[syntax.Token], inout sites: Vec[Site], index: I64, inout output: Vec[U8]) -> Void effects[alloc, partial]:
  let count: I64 = vec.len(sites)
  let done: Bool = index >= count
  if done:
    void
  else:
    let site: Site = vec.get(sites, index)
    emit_fork_site(tokens, site, output)
    let next: I64 = index + 1
    recur(tokens, sites, next, output)

fn emit_module_facts(source: Bytes, inout tokens: Vec[syntax.Token], view: View, inout output: Vec[U8]) -> Void effects[alloc, partial]:
  let facts: Vec[FunctionFact] = view.facts
  let sites: Vec[Site] = view.sites
  let schedule: Schedule = view.schedule
  text.append_text(output, " (parallelism (guarantee ")
  if view.exact:
    text.append_text(output, "exact")
  else:
    text.append_text(output, "bounded")
  text.append_text(output, ") (function-limit 64) (edge-limit 4096) (resolution-pass-limit 64) (schedule-limit 64) (profitability-model posix-v1) (minimum-task-iterations 1000000) (functions")
  emit_function_facts(source, tokens, facts, 0, output)
  text.append_text(output, ") (fork-sites")
  emit_sites(tokens, sites, 0, output)
  text.append_text(output, ") (schedule (policy lexical-earliest-nonoverlap) (guarantee ")
  let schedule_exact: Bool = schedule.selected == schedule.reported
  if schedule_exact:
    text.append_text(output, "exact")
  else:
    text.append_text(output, "bounded")
  text.append_text(output, ") (candidate-sites ")
  append_i64(schedule.candidates, output)
  text.append_text(output, ") (selected-sites ")
  append_i64(schedule.selected, output)
  text.append_text(output, ") (reported-sites ")
  append_i64(schedule.reported, output)
  text.append_text(output, ") (executable-sites ")
  append_i64(schedule.executable, output)
  text.append_text(output, ") (executed-sites ")
  append_i64(schedule.executed, output)
  text.append_text(output, ")) (eligible-sites ")
  append_i64(schedule.candidates, output)
  let any: Bool = schedule.executed > 0
  if any:
    text.append_text(output, ") (execution (guarantee exact) (status enabled) (tier posix-v1-with-serial-fallback)))")
  else:
    text.append_text(output, ") (execution (guarantee exact) (status disabled) (reason no-profitable-capture-safe-site)))")
