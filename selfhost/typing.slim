module typing

record TypeRef:
  kind: I64
  form: I64

record Fact:
  type: TypeRef

record Issue:
  code: Bytes
  start: I64
  end: I64
  blocks_inference: Bool

record View:
  facts: Vec[Fact]
  issues: Vec[Issue]

record Checked:
  status: I64
  view: View
  issues: Vec[Issue]
  plan: memory/Plan

record Binding:
  name: I64
  type: I64
  borrowed: Bool
  moved: Bool
  parent: I64

record ScopeNode:
  value: I64
  first_edge: I64

record ScopeEdge:
  code: I64
  child: I64
  next_edge: I64

record ScopeChange:
  node: I64
  previous: I64

fn empty_view() -> View effects[alloc]:
  let facts: Vec[Fact] = vec.new()
  let issues: Vec[Issue] = vec.new()
  make View(facts = facts issues = issues)

fn append_scope_node(value: I64 inout nodes: Vec[ScopeNode]) -> I64 effects[alloc]:
  let index: I64 = vec.len(nodes)
  let node: ScopeNode = make ScopeNode(value = value first_edge = -1)
  let pushed: Unit = vec.push(nodes node)
  index

fn find_scope_edge(inout edges: Vec[ScopeEdge] cursor: I64 code: I64) -> I64 effects[partial]:
  let done: Bool = i64.lt(cursor 0)
  match done:
    true:
      -1
    false:
      let edge: ScopeEdge = vec.get(edges cursor)
      let same: Bool = i64.eq(get(edge code) code)
      match same:
        true:
          get(edge child)
        false:
          recur(edges get(edge next_edge) code)

fn ensure_scope_child(inout nodes: Vec[ScopeNode] inout edges: Vec[ScopeEdge] parent: I64 code: I64) -> I64 effects[alloc partial]:
  let node: ScopeNode = vec.get(nodes parent)
  let found: I64 = find_scope_edge(edges get(node first_edge) code)
  let present: Bool = i64.ge(found 0)
  match present:
    true:
      found
    false:
      let child: I64 = append_scope_node(-1 nodes)
      let edge_index: I64 = vec.len(edges)
      let edge: ScopeEdge = make ScopeEdge(code = code child = child next_edge = get(node first_edge))
      let pushed: Unit = vec.push(edges edge)
      let updated: ScopeNode = make ScopeNode(value = get(node value) first_edge = edge_index)
      let stored: Unit = vec.set(nodes parent updated)
      child

fn ensure_scope_chars(source: Bytes index: I64 end: I64 node: I64 inout nodes: Vec[ScopeNode] inout edges: Vec[ScopeEdge]) -> I64 effects[alloc partial]:
  let done: Bool = i64.ge(index end)
  match done:
    true:
      node
    false:
      let byte: U8 = bytes.get(source index)
      let code: I64 = u8.to-i64(byte)
      let child: I64 = ensure_scope_child(nodes edges node code)
      let next: I64 = i64.add(index 1)
      recur(source next end child nodes edges)

fn lookup_scope_chars(source: Bytes index: I64 end: I64 node: I64 inout nodes: Vec[ScopeNode] inout edges: Vec[ScopeEdge]) -> I64 effects[partial]:
  let done: Bool = i64.ge(index end)
  match done:
    true:
      let current: ScopeNode = vec.get(nodes node)
      get(current value)
    false:
      let byte: U8 = bytes.get(source index)
      let code: I64 = u8.to-i64(byte)
      let current: ScopeNode = vec.get(nodes node)
      let child: I64 = find_scope_edge(edges get(current first_edge) code)
      let missing: Bool = i64.lt(child 0)
      match missing:
        true:
          -1
        false:
          let next: I64 = i64.add(index 1)
          recur(source next end child nodes edges)

fn lookup_scope_token(source: Bytes inout tokens: Vec[syntax/Token] token: I64 inout nodes: Vec[ScopeNode] inout edges: Vec[ScopeEdge]) -> I64 effects[partial]:
  let start: I64 = syntax/ast_node_start(tokens token)
  let end: I64 = syntax/ast_node_end(tokens token)
  lookup_scope_chars(source start end 0 nodes edges)

fn bind_scope_token(source: Bytes inout tokens: Vec[syntax/Token] token: I64 value: I64 borrowed: Bool inout nodes: Vec[ScopeNode] inout edges: Vec[ScopeEdge] inout changes: Vec[ScopeChange]) -> Unit effects[alloc partial]:
  let start: I64 = syntax/ast_node_start(tokens token)
  let end: I64 = syntax/ast_node_end(tokens token)
  let node_index: I64 = ensure_scope_chars(source start end 0 nodes edges)
  let node: ScopeNode = vec.get(nodes node_index)
  let change: ScopeChange = make ScopeChange(node = node_index previous = get(node value))
  let saved: Unit = vec.push(changes change)
  let known_type: Bool = i64.ge(value 0)
  let type_value: I64 = match known_type:
    true:
      value
    false:
      0
  let type_scaled: I64 = i64.mul(type_value 2)
  let borrowed_value: I64 = match borrowed:
    true:
      1
    false:
      0
  let type_mode: I64 = i64.add(type_scaled borrowed_value)
  let base: I64 = i64.add(vec.len(tokens) 1)
  let scaled: I64 = i64.mul(type_mode base)
  let packed: I64 = i64.add(scaled token)
  let updated: ScopeNode = make ScopeNode(value = packed first_edge = get(node first_edge))
  vec.set(nodes node_index updated)

fn rollback_scopes(mark: I64 index: I64 inout nodes: Vec[ScopeNode] inout changes: Vec[ScopeChange]) -> Unit effects[partial]:
  let done: Bool = i64.le(index mark)
  match done:
    true:
      unit
    false:
      let previous_index: I64 = i64.sub(index 1)
      let change: ScopeChange = vec.get(changes previous_index)
      let node_index: I64 = get(change node)
      let node: ScopeNode = vec.get(nodes node_index)
      let restored: ScopeNode = make ScopeNode(value = get(change previous) first_edge = get(node first_edge))
      let stored: Unit = vec.set(nodes node_index restored)
      recur(mark previous_index nodes changes)

fn link_local_atom(source: Bytes inout tokens: Vec[syntax/Token] atom: I64 inout nodes: Vec[ScopeNode] inout edges: Vec[ScopeEdge]) -> Unit effects[partial]:
  let packed: I64 = lookup_scope_token(source tokens atom nodes edges)
  let found: Bool = i64.ge(packed 0)
  match found:
    false:
      unit
    true:
      let negative: I64 = i64.sub(0 packed)
      let encoded: I64 = i64.sub(negative 2)
      syntax/ast_node_set_link(tokens atom encoded)

fn link_local_forms(source: Bytes inout tokens: Vec[syntax/Token] cursor: I64 inout nodes: Vec[ScopeNode] inout edges: Vec[ScopeEdge] inout changes: Vec[ScopeChange]) -> Unit effects[alloc partial]:
  let kind: I64 = syntax/ast_node_kind(tokens cursor)
  let done: Bool = i64.eq(kind 1)
  match done:
    true:
      unit
    false:
      let linked: Unit = link_local_expr(source tokens cursor nodes edges changes)
      let next: I64 = syntax/ast_next(tokens cursor)
      recur(source tokens next nodes edges changes)

fn link_local_fields(source: Bytes inout tokens: Vec[syntax/Token] cursor: I64 inout nodes: Vec[ScopeNode] inout edges: Vec[ScopeEdge] inout changes: Vec[ScopeChange]) -> Unit effects[alloc partial]:
  let kind: I64 = syntax/ast_node_kind(tokens cursor)
  let done: Bool = i64.eq(kind 1)
  match done:
    true:
      unit
    false:
      let value: I64 = syntax/ast_member_value(cursor)
      let linked: Unit = link_local_expr(source tokens value nodes edges changes)
      let next: I64 = syntax/ast_next(tokens cursor)
      recur(source tokens next nodes edges changes)

fn shadow_payload_names(source: Bytes inout tokens: Vec[syntax/Token] cursor: I64 inout nodes: Vec[ScopeNode] inout edges: Vec[ScopeEdge] inout changes: Vec[ScopeChange]) -> Unit effects[alloc partial]:
  let kind: I64 = syntax/ast_node_kind(tokens cursor)
  let done: Bool = i64.eq(kind 1)
  match done:
    true:
      unit
    false:
      let shadowed: Unit = bind_scope_token(source tokens cursor -2 false nodes edges changes)
      let next: I64 = syntax/ast_next(tokens cursor)
      recur(source tokens next nodes edges changes)

fn link_local_arms(source: Bytes inout tokens: Vec[syntax/Token] cursor: I64 inout nodes: Vec[ScopeNode] inout edges: Vec[ScopeEdge] inout changes: Vec[ScopeChange]) -> Unit effects[alloc partial]:
  let kind: I64 = syntax/ast_node_kind(tokens cursor)
  let done: Bool = i64.eq(kind 1)
  match done:
    true:
      unit
    false:
      let mark: I64 = vec.len(changes)
      let first: I64 = syntax/ast_arm_bindings(tokens cursor)
      let body: I64 = syntax/ast_arm_body(tokens cursor)
      let payload: Bool = i64.lt(first body)
      let shadowed: Unit = match payload:
        false:
          unit
        true:
          shadow_payload_names(source tokens syntax/ast_list_first(first) nodes edges changes)
      let linked: Unit = link_local_expr(source tokens body nodes edges changes)
      let end: I64 = vec.len(changes)
      let restored: Unit = rollback_scopes(mark end nodes changes)
      let next: I64 = syntax/ast_next(tokens cursor)
      recur(source tokens next nodes edges changes)

fn link_local_let(source: Bytes inout tokens: Vec[syntax/Token] expr: I64 inout nodes: Vec[ScopeNode] inout edges: Vec[ScopeEdge] inout changes: Vec[ScopeChange]) -> Unit effects[alloc partial]:
  let name: I64 = syntax/ast_let_name(expr)
  let type: I64 = syntax/ast_let_type(expr)
  let value: I64 = syntax/ast_let_value(tokens expr)
  let body: I64 = syntax/ast_let_body(tokens expr)
  let linked_value: Unit = link_local_expr(source tokens value nodes edges changes)
  let mark: I64 = vec.len(changes)
  let bound: Unit = bind_scope_token(source tokens name type false nodes edges changes)
  let linked_body: Unit = link_local_expr(source tokens body nodes edges changes)
  let end: I64 = vec.len(changes)
  rollback_scopes(mark end nodes changes)

fn link_local_set(source: Bytes inout tokens: Vec[syntax/Token] expr: I64 inout nodes: Vec[ScopeNode] inout edges: Vec[ScopeEdge] inout changes: Vec[ScopeChange]) -> Unit effects[alloc partial]:
  let name: I64 = syntax/ast_set_name(expr)
  let linked_name: Unit = link_local_atom(source tokens name nodes edges)
  let value: I64 = syntax/ast_set_value(expr)
  let body: I64 = syntax/ast_set_body(tokens expr)
  let linked_value: Unit = link_local_expr(source tokens value nodes edges changes)
  link_local_expr(source tokens body nodes edges changes)

fn link_local_data(source: Bytes inout tokens: Vec[syntax/Token] expr: I64 inout nodes: Vec[ScopeNode] inout edges: Vec[ScopeEdge] inout changes: Vec[ScopeChange]) -> Unit effects[alloc partial]:
  let make_form: Bool = syntax/ast_expression_is_make(source tokens expr)
  match make_form:
    true:
      link_local_fields(source tokens syntax/ast_make_fields(expr) nodes edges changes)
    false:
      let get_form: Bool = syntax/ast_expression_is_get(source tokens expr)
      match get_form:
        true:
          link_local_expr(source tokens syntax/ast_get_value(expr) nodes edges changes)
        false:
          let case_form: Bool = syntax/ast_expression_is_case(source tokens expr)
          match case_form:
            true:
              link_local_forms(source tokens syntax/ast_case_payload(tokens expr) nodes edges changes)
            false:
              let match_form: Bool = syntax/ast_expression_is_match(source tokens expr)
              match match_form:
                true:
                  let value: I64 = syntax/ast_match_value(expr)
                  let linked: Unit = link_local_expr(source tokens value nodes edges changes)
                  link_local_arms(source tokens syntax/ast_match_arms(tokens expr) nodes edges changes)
                false:
                  let fork_form: Bool = syntax/ast_expression_is_fork(source tokens expr)
                  match fork_form:
                    true:
                      link_local_expr(source tokens syntax/ast_fork_body(expr) nodes edges changes)
                    false:
                      link_local_forms(source tokens syntax/ast_recur_arguments(expr) nodes edges changes)

fn link_local_form(source: Bytes inout tokens: Vec[syntax/Token] expr: I64 inout nodes: Vec[ScopeNode] inout edges: Vec[ScopeEdge] inout changes: Vec[ScopeChange]) -> Unit effects[alloc partial]:
  let let_form: Bool = syntax/ast_expression_is_let(source tokens expr)
  match let_form:
    true:
      link_local_let(source tokens expr nodes edges changes)
    false:
      let set_form: Bool = syntax/ast_expression_is_set(source tokens expr)
      match set_form:
        true:
          link_local_set(source tokens expr nodes edges changes)
        false:
          let call_form: Bool = syntax/ast_expression_is_call(source tokens expr)
          match call_form:
            true:
              link_local_forms(source tokens syntax/ast_call_arguments(expr) nodes edges changes)
            false:
              link_local_data(source tokens expr nodes edges changes)

fn link_local_expr(source: Bytes inout tokens: Vec[syntax/Token] expr: I64 inout nodes: Vec[ScopeNode] inout edges: Vec[ScopeEdge] inout changes: Vec[ScopeChange]) -> Unit effects[alloc partial]:
  let kind: I64 = syntax/ast_node_kind(tokens expr)
  let form: Bool = i64.eq(kind 0)
  match form:
    true:
      link_local_form(source tokens expr nodes edges changes)
    false:
      let atom: Bool = i64.eq(kind 2)
      match atom:
        true:
          link_local_atom(source tokens expr nodes edges)
        false:
          unit

fn bind_link_parameters(source: Bytes inout tokens: Vec[syntax/Token] cursor: I64 inout nodes: Vec[ScopeNode] inout edges: Vec[ScopeEdge] inout changes: Vec[ScopeChange]) -> Unit effects[alloc partial]:
  let kind: I64 = syntax/ast_node_kind(tokens cursor)
  let done: Bool = i64.eq(kind 1)
  match done:
    true:
      unit
    false:
      let name: I64 = parameter_name(source tokens cursor)
      let type: I64 = parameter_type(source tokens cursor)
      let borrowed: Bool = parameter_is_inout(source tokens cursor)
      let bound: Unit = bind_scope_token(source tokens name type borrowed nodes edges changes)
      let next: I64 = syntax/ast_next(tokens cursor)
      recur(source tokens next nodes edges changes)

fn link_function_locals(source: Bytes inout tokens: Vec[syntax/Token] item: I64) -> Unit effects[alloc partial]:
  let nodes: Vec[ScopeNode] = vec.new()
  let edges: Vec[ScopeEdge] = vec.new()
  let changes: Vec[ScopeChange] = vec.new()
  let root: I64 = append_scope_node(-1 nodes)
  let params: I64 = syntax/ast_function_parameters(item)
  let bound: Unit = bind_link_parameters(source tokens syntax/ast_parameters_first(params) nodes edges changes)
  let return_type: I64 = syntax/ast_function_return_type(tokens item)
  let effects: I64 = syntax/ast_function_effects(tokens item)
  let body: I64 = syntax/ast_function_body(tokens item)
  link_local_expr(source tokens body nodes edges changes)

fn link_declaration_locals(source: Bytes inout tokens: Vec[syntax/Token] inout declarations: Vec[ir/Declaration] index: I64) -> Unit effects[alloc partial]:
  let count: I64 = vec.len(declarations)
  let done: Bool = i64.ge(index count)
  match done:
    true:
      unit
    false:
      let declaration: ir/Declaration = vec.get(declarations index)
      let item: I64 = get(declaration form)
      let function: Bool = syntax/ast_item_is_function(source tokens item)
      let linked: Unit = match function:
        true:
          link_function_locals(source tokens item)
        false:
          unit
      let next: I64 = i64.add(index 1)
      recur(source tokens declarations next)

fn invalid_type(token: I64) -> TypeRef:
  make TypeRef(kind = -2 form = token)

fn initialize_facts(inout tokens: Vec[syntax/Token] expr: I64 inout facts: Vec[Fact]) -> Unit effects[alloc partial]:
  let length: I64 = vec.len(tokens)
  let done: Bool = i64.ge(expr length)
  match done:
    true:
      unit
    false:
      let type: TypeRef = invalid_type(expr)
      let fact: Fact = make Fact(type = type)
      let pushed: Unit = vec.push(facts fact)
      let next: I64 = syntax/ast_node_after(expr)
      recur(tokens next facts)

fn fact_type(inout facts: Vec[Fact] expr: I64) -> TypeRef effects[partial]:
  let nonnegative: Bool = i64.ge(expr 0)
  let length: I64 = vec.len(facts)
  let below: Bool = i64.lt(expr length)
  let bounded: Bool = bool.and(nonnegative below)
  match bounded:
    false:
      invalid_type(expr)
    true:
      let fact: Fact = vec.get(facts expr)
      get(fact type)

fn linked_binding_is_inout(inout tokens: Vec[syntax/Token] name: I64) -> Bool effects[partial]:
  let link: I64 = syntax/ast_node_link(tokens name)
  let encoded: Bool = i64.lt(link -1)
  match encoded:
    false:
      false
    true:
      let positive: I64 = i64.sub(0 link)
      let packed: I64 = i64.sub(positive 2)
      let base: I64 = i64.add(vec.len(tokens) 1)
      let type_mode: I64 = i64.div(packed base)
      let mode: I64 = i64.rem(type_mode 2)
      i64.eq(mode 1)

fn linked_binding_declaration(inout tokens: Vec[syntax/Token] name: I64) -> I64 effects[partial]:
  let link: I64 = syntax/ast_node_link(tokens name)
  let encoded: Bool = i64.lt(link -1)
  match encoded:
    false:
      -1
    true:
      let positive: I64 = i64.sub(0 link)
      let packed: I64 = i64.sub(positive 2)
      let base: I64 = i64.add(vec.len(tokens) 1)
      i64.rem(packed base)

fn scalar_type(kind: I64 token: I64) -> TypeRef:
  make TypeRef(kind = kind form = token)

fn source_type(source: Bytes inout tokens: Vec[syntax/Token] form: I64) -> TypeRef effects[partial]:
  let kind: I64 = syntax/scalar_type_kind(source tokens form)
  make TypeRef(kind = kind form = form)

fn type_valid(type: TypeRef) -> Bool:
  i64.ge(get(type kind) -1)

fn append_issue(code: Bytes start: I64 end: I64 inout issues: Vec[Issue]) -> Unit effects[alloc]:
  let issue: Issue = make Issue(code = code start = start end = end blocks_inference = true)
  vec.push(issues issue)

fn append_ownership_issue(code: Bytes token: I64 inout issues: Vec[Issue]) -> Unit effects[alloc]:
  let issue: Issue = make Issue(code = code start = token end = token blocks_inference = false)
  vec.push(issues issue)

fn issues_block_inference(inout issues: Vec[Issue]) -> Bool effects[partial]:
  let count: I64 = vec.len(issues)
  let present: Bool = i64.gt(count 0)
  match present:
    false:
      false
    true:
      let last: I64 = i64.sub(count 1)
      let issue: Issue = vec.get(issues last)
      get(issue blocks_inference)

fn record_issue(code: Bytes token: I64 inout issues: Vec[Issue]) -> Unit effects[alloc partial]:
  let blocked: Bool = issues_block_inference(issues)
  match blocked:
    true:
      unit
    false:
      append_issue(code token token issues)

fn type_forms_equal(source: Bytes inout tokens: Vec[syntax/Token] left: I64 right: I64) -> Bool effects[partial]:
  let left_kind: I64 = syntax/ast_node_kind(tokens left)
  let right_kind: I64 = syntax/ast_node_kind(tokens right)
  let same_kind: Bool = i64.eq(left_kind right_kind)
  match same_kind:
    false:
      false
    true:
      let form: Bool = i64.eq(left_kind 0)
      match form:
        true:
          type_lists_equal(source tokens syntax/ast_list_first(left) syntax/ast_list_first(right))
        false:
          let left_start: I64 = syntax/ast_node_start(tokens left)
          let left_end: I64 = syntax/ast_node_end(tokens left)
          let right_start: I64 = syntax/ast_node_start(tokens right)
          let right_end: I64 = syntax/ast_node_end(tokens right)
          syntax/spans_equal(source left_start left_end right_start right_end)

fn type_lists_equal(source: Bytes inout tokens: Vec[syntax/Token] left: I64 right: I64) -> Bool effects[partial]:
  let left_kind: I64 = syntax/ast_node_kind(tokens left)
  let right_kind: I64 = syntax/ast_node_kind(tokens right)
  let left_done: Bool = i64.eq(left_kind 1)
  let right_done: Bool = i64.eq(right_kind 1)
  let either_done: Bool = bool.or(left_done right_done)
  match either_done:
    true:
      bool.and(left_done right_done)
    false:
      let same: Bool = type_forms_equal(source tokens left right)
      match same:
        false:
          false
        true:
          let next_left: I64 = syntax/ast_next(tokens left)
          let next_right: I64 = syntax/ast_next(tokens right)
          recur(source tokens next_left next_right)

fn types_equal(source: Bytes inout tokens: Vec[syntax/Token] left: TypeRef right: TypeRef) -> Bool effects[partial]:
  let left_kind: I64 = get(left kind)
  let right_kind: I64 = get(right kind)
  let left_scalar: Bool = i64.ge(left_kind 0)
  let right_scalar: Bool = i64.ge(right_kind 0)
  let either_scalar: Bool = bool.or(left_scalar right_scalar)
  match either_scalar:
    true:
      let both: Bool = bool.and(left_scalar right_scalar)
      let same: Bool = i64.eq(left_kind right_kind)
      bool.and(both same)
    false:
      type_forms_equal(source tokens get(left form) get(right form))

fn type_matches_form(source: Bytes inout tokens: Vec[syntax/Token] actual: TypeRef expected: I64) -> Bool effects[partial]:
  let expected_type: TypeRef = source_type(source tokens expected)
  types_equal(source tokens actual expected_type)

fn add_fact(expr: I64 type: TypeRef inout facts: Vec[Fact]) -> Unit effects[alloc partial]:
  let valid: Bool = type_valid(type)
  match valid:
    true:
      let fact: Fact = make Fact(type = type)
      vec.set(facts expr fact)
    false:
      unit

fn finish_type(source: Bytes inout tokens: Vec[syntax/Token] expr: I64 expected: I64 actual: TypeRef inout facts: Vec[Fact] inout issues: Vec[Issue]) -> TypeRef effects[alloc partial]:
  let valid: Bool = type_valid(actual)
  let contextual: Bool = i64.ge(expected 0)
  let compare: Bool = bool.and(valid contextual)
  let same: Bool = match compare:
    true:
      type_matches_form(source tokens actual expected)
    false:
      true
  match same:
    false:
      let noted: Unit = record_issue("E0344" expr issues)
      invalid_type(expr)
    true:
      let noted: Unit = add_fact(expr actual facts)
      fact_type(facts expr)

fn parameter_is_inout(source: Bytes inout tokens: Vec[syntax/Token] parameter: I64) -> Bool effects[partial]:
  syntax/ast_binding_is_inout(source tokens parameter)

fn parameter_name(source: Bytes inout tokens: Vec[syntax/Token] parameter: I64) -> I64 effects[partial]:
  syntax/ast_binding_name(source tokens parameter)

fn parameter_type(source: Bytes inout tokens: Vec[syntax/Token] parameter: I64) -> I64 effects[partial]:
  syntax/ast_binding_type(source tokens parameter)

fn add_binding(inout tokens: Vec[syntax/Token] name: I64 type: I64 borrowed: Bool parent: I64 inout bindings: Vec[Binding]) -> I64 effects[alloc partial]:
  let index: I64 = vec.len(bindings)
  let linked: Unit = syntax/ast_node_set_link(tokens name index)
  let binding: Binding = make Binding(name = name type = type borrowed = borrowed moved = false parent = parent)
  let pushed: Unit = vec.push(bindings binding)
  index

fn bind_parameters(source: Bytes inout tokens: Vec[syntax/Token] cursor: I64 parent: I64 inout bindings: Vec[Binding]) -> I64 effects[alloc partial]:
  let kind: I64 = syntax/ast_node_kind(tokens cursor)
  let done: Bool = i64.eq(kind 1)
  match done:
    true:
      parent
    false:
      let name: I64 = parameter_name(source tokens cursor)
      let type: I64 = parameter_type(source tokens cursor)
      let borrowed: Bool = parameter_is_inout(source tokens cursor)
      let next_parent: I64 = add_binding(tokens name type borrowed parent bindings)
      let next: I64 = syntax/ast_next(tokens cursor)
      recur(source tokens next next_parent bindings)

fn find_binding_type(source: Bytes inout tokens: Vec[syntax/Token] inout bindings: Vec[Binding] parent: I64 name: I64) -> I64 effects[partial]:
  let link: I64 = syntax/ast_node_link(tokens name)
  let encoded: Bool = i64.lt(link -1)
  let decoded_type: I64 = match encoded:
    true:
      let positive: I64 = i64.sub(0 link)
      let packed: I64 = i64.sub(positive 2)
      let base: I64 = i64.add(vec.len(tokens) 1)
      let type_mode: I64 = i64.div(packed base)
      i64.div(type_mode 2)
    false:
      -1
  let linked_type: Bool = i64.gt(decoded_type 0)
  match linked_type:
    true:
      decoded_type
    false:
      let done: Bool = i64.lt(parent 0)
      match done:
        true:
          -1
        false:
          let binding: Binding = vec.get(bindings parent)
          let candidate: I64 = get(binding name)
          let name_start: I64 = syntax/ast_node_start(tokens name)
          let name_end: I64 = syntax/ast_node_end(tokens name)
          let candidate_start: I64 = syntax/ast_node_start(tokens candidate)
