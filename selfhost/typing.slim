  let value_valid: Bool = type_valid(value_type)
  let body_valid: Bool = type_valid(body_type)
  let valid: Bool = bool.and(value_valid body_valid)
  match valid:
    true:
      body_type
    false:
      invalid_type(expr)

fn infer_set(source: Bytes inout tokens: Vec[syntax/Token] expr: I64 expected: I64 parent: I64 params: I64 return_type: I64 inout bindings: Vec[Binding] inout facts: Vec[Fact] inout issues: Vec[Issue]) -> TypeRef effects[alloc partial]:
  let name: I64 = syntax/ast_set_name(expr)
  let type: I64 = find_binding_type(source tokens bindings parent name)
  let found: Bool = i64.ge(type 0)
  match found:
    false:
      let noted: Unit = record_issue("E0314" name issues)
      invalid_type(expr)
    true:
      let value: I64 = syntax/ast_set_value(expr)
      let body: I64 = syntax/ast_set_body(tokens expr)
      let value_type: TypeRef = infer_expr(source tokens value type parent params return_type bindings facts issues)
      let body_type: TypeRef = infer_expr(source tokens body expected parent params return_type bindings facts issues)
      let valid: Bool = bool.and(type_valid(value_type) type_valid(body_type))
      match valid:
        true:
          body_type
        false:
          invalid_type(expr)

fn infer_form(source: Bytes inout tokens: Vec[syntax/Token] expr: I64 expected: I64 parent: I64 params: I64 return_type: I64 inout bindings: Vec[Binding] inout facts: Vec[Fact] inout issues: Vec[Issue]) -> TypeRef effects[alloc partial]:
  let let_form: Bool = syntax/ast_expression_is_let(source tokens expr)
  match let_form:
    true:
      infer_let(source tokens expr expected parent params return_type bindings facts issues)
    false:
      let set_form: Bool = syntax/ast_expression_is_set(source tokens expr)
      match set_form:
        true:
          infer_set(source tokens expr expected parent params return_type bindings facts issues)
        false:
          let call_form: Bool = syntax/ast_expression_is_call(source tokens expr)
          match call_form:
            true:
              infer_call(source tokens expr expected parent params return_type bindings facts issues)
            false:
              let make_form: Bool = syntax/ast_expression_is_make(source tokens expr)
              match make_form:
                true:
                  infer_make(source tokens expr parent params return_type bindings facts issues)
                false:
                  let get_form: Bool = syntax/ast_expression_is_get(source tokens expr)
                  match get_form:
                    true:
                      infer_get(source tokens expr parent params return_type bindings facts issues)
                    false:
                      let case_form: Bool = syntax/ast_expression_is_case(source tokens expr)
                      match case_form:
                        true:
                          infer_case(source tokens expr parent params return_type bindings facts issues)
                        false:
                          let match_form: Bool = syntax/ast_expression_is_match(source tokens expr)
                          match match_form:
                            true:
                              infer_match_ordered(source tokens expr expected parent params return_type bindings facts issues)
                            false:
                              let fork_form: Bool = syntax/ast_expression_is_fork(source tokens expr)
                              match fork_form:
                                true:
                                  infer_fork(source tokens expr expected parent params return_type bindings facts issues)
                                false:
                                  infer_recur(source tokens expr parent params return_type bindings facts issues)

fn infer_expr(source: Bytes inout tokens: Vec[syntax/Token] expr: I64 expected: I64 parent: I64 params: I64 return_type: I64 inout bindings: Vec[Binding] inout facts: Vec[Fact] inout issues: Vec[Issue]) -> TypeRef effects[alloc partial]:
  let failed: Bool = issues_block_inference(issues)
  match failed:
    true:
      invalid_type(expr)
    false:
      let kind: I64 = syntax/ast_node_kind(tokens expr)
      let form: Bool = i64.eq(kind 0)
      let actual: TypeRef = match form:
        true:
          infer_form(source tokens expr expected parent params return_type bindings facts issues)
        false:
          infer_atom(source tokens expr parent bindings issues)
      finish_type(source tokens expr expected actual facts issues)

fn type_form_wellformed(source: Bytes inout tokens: Vec[syntax/Token] type: I64) -> Bool effects[partial]:
  let scalar: I64 = syntax/scalar_type_kind(source tokens type)
  let scalar_type: Bool = i64.ge(scalar 0)
  match scalar_type:
    true:
      true
    false:
      let kind: I64 = syntax/ast_node_kind(tokens type)
      let atom: Bool = i64.eq(kind 2)
      match atom:
        true:
          let item: I64 = linked_item(tokens type)
          let record: Bool = item_has_kind(source tokens item 1)
          let variant: Bool = item_has_kind(source tokens item 2)
          bool.or(record variant)
        false:
          let form: Bool = i64.eq(kind 0)
          match form:
            false:
              false
            true:
              let vec_type: Bool = syntax/ast_type_is_vec(source tokens type)
              let arena_type: Bool = syntax/ast_type_is_arena(source tokens type)
              let id_type: Bool = syntax/ast_type_is_id(source tokens type)
              let constructor: Bool = bool.or(vec_type bool.or(arena_type id_type))
              let inner: I64 = syntax/ast_type_argument(type)
              let inner_valid: Bool = type_form_wellformed(source tokens inner)
              let next: I64 = syntax/ast_next(tokens inner)
              let next_kind: I64 = syntax/ast_node_kind(tokens next)
              let exact: Bool = i64.eq(next_kind 1)
              bool.and(constructor bool.and(inner_valid exact))

fn check_type_form(source: Bytes inout tokens: Vec[syntax/Token] type: I64 inout issues: Vec[Issue]) -> Bool effects[alloc partial]:
  let valid: Bool = type_form_wellformed(source tokens type)
  match valid:
    true:
      true
    false:
      let noted: Unit = record_issue("E0354" type issues)
      false

fn check_type_forms(source: Bytes inout tokens: Vec[syntax/Token] cursor: I64 inout issues: Vec[Issue]) -> Unit effects[alloc partial]:
  let kind: I64 = syntax/ast_node_kind(tokens cursor)
  let done: Bool = i64.eq(kind 1)
  match done:
    true:
      unit
    false:
      let valid: Bool = check_type_form(source tokens cursor issues)
      let next: I64 = syntax/ast_next(tokens cursor)
      recur(source tokens next issues)

fn check_parameter_types(source: Bytes inout tokens: Vec[syntax/Token] cursor: I64 inout issues: Vec[Issue]) -> Unit effects[alloc partial]:
  let kind: I64 = syntax/ast_node_kind(tokens cursor)
  let done: Bool = i64.eq(kind 1)
  match done:
    true:
      unit
    false:
      let type: I64 = parameter_type(source tokens cursor)
      let valid: Bool = check_type_form(source tokens type issues)
      let next: I64 = syntax/ast_next(tokens cursor)
      recur(source tokens next issues)

fn check_record_types(source: Bytes inout tokens: Vec[syntax/Token] cursor: I64 inout issues: Vec[Issue]) -> Unit effects[alloc partial]:
  let kind: I64 = syntax/ast_node_kind(tokens cursor)
  let done: Bool = i64.eq(kind 1)
  match done:
    true:
      unit
    false:
      let type: I64 = syntax/ast_member_value(cursor)
      let valid: Bool = check_type_form(source tokens type issues)
      let next: I64 = syntax/ast_next(tokens cursor)
      recur(source tokens next issues)

fn check_variant_types(source: Bytes inout tokens: Vec[syntax/Token] cursor: I64 inout issues: Vec[Issue]) -> Unit effects[alloc partial]:
  let kind: I64 = syntax/ast_node_kind(tokens cursor)
  let done: Bool = i64.eq(kind 1)
  match done:
    true:
      unit
    false:
      let payload: I64 = syntax/ast_member_value(cursor)
      let valid: Unit = check_type_forms(source tokens payload issues)
      let next: I64 = syntax/ast_next(tokens cursor)
      recur(source tokens next issues)

fn type_is_vec_bytes(source: Bytes inout tokens: Vec[syntax/Token] type: I64) -> Bool effects[partial]:
  let kind: I64 = syntax/ast_node_kind(tokens type)
  let form: Bool = i64.eq(kind 0)
  match form:
    false:
      false
    true:
      let vector: Bool = syntax/ast_type_is_vec(source tokens type)
      let inner: I64 = syntax/ast_type_argument(type)
      let inner_kind: I64 = syntax/scalar_type_kind(source tokens inner)
      let bytes_type: Bool = i64.eq(inner_kind 4)
      let next: I64 = syntax/ast_next(tokens inner)
      let next_kind: I64 = syntax/ast_node_kind(tokens next)
      let exact: Bool = i64.eq(next_kind 1)
      bool.and(vector bool.and(bytes_type exact))

fn main_signature_valid(source: Bytes inout tokens: Vec[syntax/Token] item: I64) -> Bool effects[partial]:
  let params: I64 = syntax/ast_function_parameters(item)
  let first: I64 = syntax/ast_parameters_first(params)
  let count: I64 = form_count(tokens first 0)
  let one: Bool = i64.eq(count 1)
  match one:
    false:
      false
    true:
      let borrowed: Bool = parameter_is_inout(source tokens first)
      let plain: Bool = bool.not(borrowed)
      let name: I64 = parameter_name(source tokens first)
      let named: Bool = syntax/ast_node_text_is(source tokens name "args")
      let type: I64 = parameter_type(source tokens first)
      let vector: Bool = type_is_vec_bytes(source tokens type)
      let return_type: I64 = syntax/ast_function_return_type(tokens item)
      let return_kind: I64 = syntax/scalar_type_kind(source tokens return_type)
      let returns_i64: Bool = i64.eq(return_kind 3)
      bool.and(plain bool.and(named bool.and(vector returns_i64)))

fn check_declaration_types(source: Bytes inout tokens: Vec[syntax/Token] inout declarations: Vec[ir/Declaration] index: I64 inout issues: Vec[Issue]) -> Unit effects[alloc partial]:
  let count: I64 = vec.len(declarations)
  let done: Bool = i64.ge(index count)
  match done:
    true:
      unit
    false:
      let declaration: ir/Declaration = vec.get(declarations index)
      let item: I64 = get(declaration form)
      let function: Bool = syntax/ast_item_is_function(source tokens item)
      let record: Bool = syntax/ast_item_is_record(source tokens item)
      let checked: Unit = match function:
        true:
          let params: I64 = syntax/ast_function_parameters(item)
          let parameter_types: Unit = check_parameter_types(source tokens syntax/ast_parameters_first(params) issues)
          let return_type: I64 = syntax/ast_function_return_type(tokens item)
          let returned: Bool = check_type_form(source tokens return_type issues)
          let name: I64 = syntax/ast_item_name(item)
          let main: Bool = syntax/ast_node_text_is(source tokens name "main")
          let signature: Bool = match main:
            true:
              main_signature_valid(source tokens item)
            false:
              true
          match signature:
            true:
              unit
            false:
              record_issue("E0355" name issues)
        false:
          let first_member: I64 = syntax/ast_data_members_first(item)
          match record:
            true:
              check_record_types(source tokens first_member issues)
            false:
              check_variant_types(source tokens first_member issues)
      let next: I64 = i64.add(index 1)
      recur(source tokens declarations next issues)

fn ownership_result_expr(source: Bytes inout tokens: Vec[syntax/Token] expr: I64) -> I64 effects[partial]:
  let kind: I64 = syntax/ast_node_kind(tokens expr)
  let form: Bool = i64.eq(kind 0)
  match form:
    false:
      expr
    true:
      let let_form: Bool = syntax/ast_expression_is_let(source tokens expr)
      match let_form:
        true:
          recur(source tokens syntax/ast_let_body(tokens expr))
        false:
          let set_form: Bool = syntax/ast_expression_is_set(source tokens expr)
          match set_form:
            true:
              recur(source tokens syntax/ast_set_body(tokens expr))
            false:
              expr

fn append_inout_return_issue(source: Bytes inout tokens: Vec[syntax/Token] return_type: I64 body: I64 inout issues: Vec[Issue]) -> Unit effects[alloc partial]:
  let storage: I64 = memory/type_storage_kind(source tokens return_type)
  let owned: Bool = i64.eq(storage 2)
  match owned:
    false:
      unit
    true:
      let result: I64 = ownership_result_expr(source tokens body)
      let kind: I64 = syntax/ast_node_kind(tokens result)
      let named: Bool = i64.eq(kind 2)
      match named:
        false:
          unit
        true:
          let borrowed: Bool = linked_binding_is_inout(tokens result)
          match borrowed:
            false:
              unit
            true:
              append_ownership_issue("E0347" result issues)

fn check_functions(source: Bytes inout tokens: Vec[syntax/Token] inout declarations: Vec[ir/Declaration] index: I64 inout bindings: Vec[Binding] inout facts: Vec[Fact] inout issues: Vec[Issue]) -> Unit effects[alloc partial]:
  let count: I64 = vec.len(declarations)
  let done: Bool = i64.ge(index count)
  let failed: Bool = issues_block_inference(issues)
  let stop: Bool = bool.or(done failed)
  match stop:
    true:
      unit
    false:
      let declaration: ir/Declaration = vec.get(declarations index)
      let item: I64 = get(declaration form)
      let function: Bool = syntax/ast_item_is_function(source tokens item)
      let checked: Unit = match function:
        false:
          unit
        true:
          let params: I64 = syntax/ast_function_parameters(item)
          let parent: I64 = bind_parameters(source tokens syntax/ast_parameters_first(params) -1 bindings)
          let return_type: I64 = syntax/ast_function_return_type(tokens item)
          let effects: I64 = syntax/ast_function_effects(tokens item)
          let body: I64 = syntax/ast_function_body(tokens item)
          let typed: TypeRef = infer_expr(source tokens body return_type parent params return_type bindings facts issues)
          let valid: Bool = type_valid(typed)
          let returned: Unit = match valid:
            true:
              append_inout_return_issue(source tokens return_type body issues)
            false:
              unit
          unit
      let next: I64 = i64.add(index 1)
      recur(source tokens declarations next bindings facts issues)

fn analyze(source: Bytes inout tokens: Vec[syntax/Token] inout declarations: Vec[ir/Declaration]) -> View effects[alloc partial]:
  let linked: Unit = syntax/link_declaration_names(source tokens)
  let locals: Unit = link_declaration_locals(source tokens declarations 0)
  let bindings: Vec[Binding] = vec.new()
  let facts: Vec[Fact] = vec.new()
  let initialized: Unit = initialize_facts(tokens 0 facts)
  let issues: Vec[Issue] = vec.new()
  let declarations_checked: Unit = check_declaration_types(source tokens declarations 0 issues)
  let functions_checked: Unit = check_functions(source tokens declarations 0 bindings facts issues)
  make View(facts = facts issues = issues)
