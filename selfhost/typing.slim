      let encoded: Bool = i64.lt(link -1)
      match encoded:
        false:
          true
        true:
          let positive: I64 = i64.sub(0 link)
          let packed: I64 = i64.sub(positive 2)
          let base: I64 = i64.add(vec.len(tokens) 1)
          let declaration: I64 = i64.rem(packed base)
          let binding_index: I64 = syntax/ast_node_link(tokens declaration)
          let found: Bool = i64.ge(binding_index 0)
          match found:
            false:
              true
            true:
              let binding: Binding = vec.get(bindings binding_index)
              let moved: Bool = get(binding moved)
              match moved:
                true:
                  let noted: Unit = append_ownership_issue("E0315" argument issues)
                  true
                false:
                  let borrowed: Bool = get(binding borrowed)
                  match borrowed:
                    true:
                      let noted: Unit = append_ownership_issue("E0347" argument issues)
                      true
                    false:
                      let updated: Binding = make Binding(name = get(binding name) type = get(binding type) borrowed = borrowed moved = true parent = get(binding parent))
                      let stored: Unit = vec.set(bindings binding_index updated)
                      true

