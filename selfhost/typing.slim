module typing

struct TypeRef:
  kind: I64
  form: I64

# Type kinds -2..4 occupy the low three bits after adding two. A checked
# binding adds 8 * (mode + 1), with mode 0..2. Tags are therefore 0..30;
# zero high bits mean no binding evidence. Facts retain two I64 words.
struct Fact:
  tag: I64
  form: I64

struct Issue:
  code: Bytes
  start: I64
  end: I64
  blocks_inference: Bool

struct View:
  facts: Vec[Fact]
  issues: Vec[Issue]
  layouts: Vec[I64]

struct Checked:
  status: I64
  view: View
  issues: Vec[Issue]
  plan: memory.Plan

struct Binding:
  name: I64
  type: I64
  mode: I64
  mutable: Bool
  move_scope: I64
  owner: I64
  parent: I64
  access_call: I64
  access_mode: I64

# RFC-0141 continuation phases: 0 binding initializer, 1 binding body,
# 2 assignment value, 3 assignment body, 4 branch scrutinee, 5 branch arm,
# 6 parallel body (preserve exact invalid-result source),
# 7 projection owner; 8 record field, 9 variant payload. In phases 8/9,
# type/before are the source/definition cursors. Branch pools are touched only
# in phases 4/5. Phases 10/11 await a user-call/recur argument, using the
# active argument record; type retains the resolved parameter type, and before
# is unused. Phase 12 awaits a built-in
# operand; type is its pool index. Phases 13 unary scalar, 14 uniform first,
# 15 bytes.get first, 16 uniform second, 17 bytes.get second store operand kind
# in type, result kind in before, and completed mode/prefix validity in valid.
# Scalar phases use no built-in pool. Completed forms finish and pop directly.
# In phase 2 valid stores the target's
# affine flag, type its checked type, and before the pre-value issue count.
# Phases 1/3 use valid for completed-prefix validity. Phases 0/1/3/4/5/6/7
# do not use type/before; all other interpretations are specified above.
# Parent belongs to this invocation's binding store. The active frame is a
# scalar machine parameter; the vector stores suspended parents only. Popped
# slots are reused, and a one-frame traversal needs no vector allocation.
struct Pending:
  expr: I64
  expected: I64
  parent: I64
  phase: I64
  valid: Bool
  type: I64
  before: I64

struct AssignmentTarget:
  type: I64
  affine: Bool

# The active branch record is a scalar machine parameter. Only suspended
# branch ancestors occupy reused vector slots; a nonnested branch allocates no
# branch vector backing. Pending.type is unused in phases 4/5.
# The old arm loop uses terminal recur; its post-recur validity expression
# is unreachable. Preserve its first-result/exhaustiveness behavior exactly.
# Source errors remain in the ordered issue vector and cannot publish a snapshot.
struct BranchState:
  variant: I64
  cursor: I64
  case_cursor: I64
  source_mode: I64
  source_owner: I64
  branch_scope: I64
  enclosing_scope: I64
  first: TypeRef
  has_first: Bool
  seen_true: Bool
  seen_false: Bool
  move_valid: Bool
  arm_scope: I64

struct BranchNext:
  state: BranchState
  done: Bool
  body: I64
  parent: I64
  result: TypeRef

struct BoundValue:
  parent: I64
  valid: Bool

struct ScopeNode:
  value: I64
  first_edge: I64

struct ScopeEdge:
  code: I64
  child: I64
  next_edge: I64

struct ScopeChange:
  node: I64
  previous: I64

fn empty_view() -> View effects[alloc]:
  let facts: Vec[Fact] = vec.new()
  let issues: Vec[Issue] = vec.new()
  let layouts: Vec[I64] = vec.new()
  View(facts: facts, issues: issues, layouts: layouts)

fn append_scope_node(value: I64, nodes: @Vec[ScopeNode]) -> I64 effects[alloc]:
  let index: I64 = vec.len(nodes)
  let node: ScopeNode = ScopeNode(value: value, first_edge: -1)
  vec.push(@nodes, node)
  index

fn find_scope_edge(edges: Vec[ScopeEdge], cursor: I64, code: I64) -> I64 effects[partial]:
  let done: Bool = cursor < 0
  if done:
    -1
  else:
    let edge: ScopeEdge = vec.get(edges, cursor)
    let same: Bool = edge.code == code
    if same:
      edge.child
    else:
      recur(edges, edge.next_edge, code)

fn ensure_scope_child(nodes: @Vec[ScopeNode], edges: @Vec[ScopeEdge], parent: I64, code: I64) -> I64 effects[alloc, partial]:
  let node: ScopeNode = vec.get(nodes, parent)
  let found: I64 = find_scope_edge(edges, node.first_edge, code)
  let present: Bool = found >= 0
  if present:
    found
  else:
    let child: I64 = append_scope_node(-1, @nodes)
    let edge_index: I64 = vec.len(edges)
    let edge: ScopeEdge = ScopeEdge(code: code, child: child, next_edge: node.first_edge)
    vec.push(@edges, edge)
    let updated: ScopeNode = ScopeNode(value: node.value, first_edge: edge_index)
    vec.set(@nodes, parent, updated)
    child

fn ensure_scope_chars(source: Bytes, index: I64, end: I64, node: I64, nodes: @Vec[ScopeNode], edges: @Vec[ScopeEdge]) -> I64 effects[alloc, partial]:
  let done: Bool = index >= end
  if done:
    node
  else:
    let byte: U8 = bytes.get(source, index)
    let code: I64 = u8.to_i64(byte)
    let child: I64 = ensure_scope_child(@nodes, @edges, node, code)
    let next: I64 = index + 1
    recur(source, next, end, child, @nodes, @edges)

fn lookup_scope_chars(source: Bytes, index: I64, end: I64, node: I64, nodes: Vec[ScopeNode], edges: Vec[ScopeEdge]) -> I64 effects[partial]:
  let done: Bool = index >= end
  if done:
    let current: ScopeNode = vec.get(nodes, node)
    current.value
  else:
    let byte: U8 = bytes.get(source, index)
    let code: I64 = u8.to_i64(byte)
    let current: ScopeNode = vec.get(nodes, node)
    let child: I64 = find_scope_edge(edges, current.first_edge, code)
    let missing: Bool = child < 0
    if missing:
      -1
    else:
      let next: I64 = index + 1
      recur(source, next, end, child, nodes, edges)

fn lookup_scope_token(source: Bytes, tokens: Vec[syntax.Token], token: I64, nodes: Vec[ScopeNode], edges: Vec[ScopeEdge]) -> I64 effects[partial]:
  let start: I64 = syntax.ast_node_start(tokens, token)
  let end: I64 = syntax.ast_node_end(tokens, token)
  lookup_scope_chars(source, start, end, 0, nodes, edges)

fn bind_scope_token(source: Bytes, tokens: Vec[syntax.Token], token: I64, value: I64, mode: I64, nodes: @Vec[ScopeNode], edges: @Vec[ScopeEdge], changes: @Vec[ScopeChange]) -> Void effects[alloc, partial]:
  let start: I64 = syntax.ast_node_start(tokens, token)
  let end: I64 = syntax.ast_node_end(tokens, token)
  let node_index: I64 = ensure_scope_chars(source, start, end, 0, @nodes, @edges)
  let node: ScopeNode = vec.get(nodes, node_index)
  let change: ScopeChange = ScopeChange(node: node_index, previous: node.value)
  vec.push(@changes, change)
  let known_type: Bool = value >= 0
  let type_value: I64 = if known_type:
    value
  else:
    0
  let type_scaled: I64 = type_value * 3
  let type_mode: I64 = type_scaled + mode
  let base: I64 = vec.len(tokens) + 1
  let scaled: I64 = type_mode * base
  let packed: I64 = scaled + token
  let updated: ScopeNode = ScopeNode(value: packed, first_edge: node.first_edge)
  vec.set(@nodes, node_index, updated)

fn rollback_scopes(mark: I64, index: I64, nodes: @Vec[ScopeNode], changes: Vec[ScopeChange]) -> Void effects[partial]:
  let done: Bool = index <= mark
  if done:
    void
  else:
    let previous_index: I64 = index - 1
    let change: ScopeChange = vec.get(changes, previous_index)
    let node_index: I64 = change.node
    let node: ScopeNode = vec.get(nodes, node_index)
    let restored: ScopeNode = ScopeNode(value: change.previous, first_edge: node.first_edge)
    vec.set(@nodes, node_index, restored)
    recur(mark, previous_index, @nodes, changes)

fn link_local_atom(source: Bytes, tokens: @Vec[syntax.Token], atom: I64, nodes: Vec[ScopeNode], edges: Vec[ScopeEdge]) -> Void effects[partial]:
  let packed: I64 = lookup_scope_token(source, tokens, atom, nodes, edges)
  let found: Bool = packed >= 0
  if found:
    let negative: I64 = 0 - packed
    let encoded: I64 = negative - 2
    syntax.ast_node_set_link(@tokens, atom, encoded)
  else:
    void

fn link_local_forms(source: Bytes, tokens: @Vec[syntax.Token], cursor: I64, nodes: @Vec[ScopeNode], edges: @Vec[ScopeEdge], changes: @Vec[ScopeChange]) -> Void effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    void
  else:
    link_local_expr(source, @tokens, cursor, @nodes, @edges, @changes)
    let next: I64 = syntax.ast_next(tokens, cursor)
    recur(source, @tokens, next, @nodes, @edges, @changes)

fn link_local_fields(source: Bytes, tokens: @Vec[syntax.Token], cursor: I64, nodes: @Vec[ScopeNode], edges: @Vec[ScopeEdge], changes: @Vec[ScopeChange]) -> Void effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    void
  else:
    let value: I64 = syntax.ast_member_value(cursor)
    link_local_expr(source, @tokens, value, @nodes, @edges, @changes)
    let next: I64 = syntax.ast_next(tokens, cursor)
    recur(source, @tokens, next, @nodes, @edges, @changes)

fn shadow_payload_names(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, nodes: @Vec[ScopeNode], edges: @Vec[ScopeEdge], changes: @Vec[ScopeChange]) -> Void effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    void
  else:
    bind_scope_token(source, tokens, cursor, -2, 0, @nodes, @edges, @changes)
    let next: I64 = syntax.ast_next(tokens, cursor)
    recur(source, tokens, next, @nodes, @edges, @changes)

fn link_local_arms(source: Bytes, tokens: @Vec[syntax.Token], cursor: I64, nodes: @Vec[ScopeNode], edges: @Vec[ScopeEdge], changes: @Vec[ScopeChange]) -> Void effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    void
  else:
    let mark: I64 = vec.len(changes)
    let first: I64 = syntax.ast_arm_bindings(tokens, cursor)
    let body: I64 = syntax.ast_arm_body(tokens, cursor)
    let payload: Bool = first < body
    if payload:
      shadow_payload_names(source, tokens, syntax.ast_list_first(first), @nodes, @edges, @changes)
    else:
      void
    link_local_expr(source, @tokens, body, @nodes, @edges, @changes)
    let end: I64 = vec.len(changes)
    rollback_scopes(mark, end, @nodes, changes)
    let next: I64 = syntax.ast_next(tokens, cursor)
    recur(source, @tokens, next, @nodes, @edges, @changes)

fn link_local_let(source: Bytes, tokens: @Vec[syntax.Token], expr: I64, nodes: @Vec[ScopeNode], edges: @Vec[ScopeEdge], changes: @Vec[ScopeChange]) -> Void effects[alloc, partial]:
  let name: I64 = syntax.ast_let_name(expr)
  let type: I64 = syntax.ast_let_type(expr)
  let value: I64 = syntax.ast_let_value(tokens, expr)
  let body: I64 = syntax.ast_let_body(tokens, expr)
  link_local_expr(source, @tokens, value, @nodes, @edges, @changes)
  let mark: I64 = vec.len(changes)
  bind_scope_token(source, tokens, name, type, 0, @nodes, @edges, @changes)
  link_local_expr(source, @tokens, body, @nodes, @edges, @changes)
  let end: I64 = vec.len(changes)
  rollback_scopes(mark, end, @nodes, changes)

fn link_local_set(source: Bytes, tokens: @Vec[syntax.Token], expr: I64, nodes: @Vec[ScopeNode], edges: @Vec[ScopeEdge], changes: @Vec[ScopeChange]) -> Void effects[alloc, partial]:
  let name: I64 = syntax.ast_set_name(expr)
  link_local_atom(source, @tokens, name, nodes, edges)
  let value: I64 = syntax.ast_set_value(expr)
  let body: I64 = syntax.ast_set_body(tokens, expr)
  link_local_expr(source, @tokens, value, @nodes, @edges, @changes)
  link_local_expr(source, @tokens, body, @nodes, @edges, @changes)

fn link_local_data(source: Bytes, tokens: @Vec[syntax.Token], expr: I64, nodes: @Vec[ScopeNode], edges: @Vec[ScopeEdge], changes: @Vec[ScopeChange]) -> Void effects[alloc, partial]:
  let make_form: Bool = syntax.ast_expression_is_make(source, tokens, expr)
  if make_form:
    link_local_fields(source, @tokens, syntax.ast_make_fields(expr), @nodes, @edges, @changes)
  else:
    let get_form: Bool = syntax.ast_expression_is_get(source, tokens, expr)
    if get_form:
      link_local_expr(source, @tokens, syntax.ast_get_value(expr), @nodes, @edges, @changes)
    else:
      let case_form: Bool = syntax.ast_expression_is_case(source, tokens, expr)
      if case_form:
        let payload: I64 = syntax.ast_case_payload(tokens, expr)
        link_local_forms(source, @tokens, payload, @nodes, @edges, @changes)
      else:
        let match_form: Bool = syntax.ast_expression_is_match(source, tokens, expr)
        if match_form:
          let value: I64 = syntax.ast_match_value(expr)
          link_local_expr(source, @tokens, value, @nodes, @edges, @changes)
          let arms: I64 = syntax.ast_match_arms(tokens, expr)
          link_local_arms(source, @tokens, arms, @nodes, @edges, @changes)
        else:
          let fork_form: Bool = syntax.ast_expression_is_fork(source, tokens, expr)
          if fork_form:
            link_local_expr(source, @tokens, syntax.ast_fork_body(expr), @nodes, @edges, @changes)
          else:
            link_local_forms(source, @tokens, syntax.ast_recur_arguments(expr), @nodes, @edges, @changes)

fn link_local_form(source: Bytes, tokens: @Vec[syntax.Token], expr: I64, nodes: @Vec[ScopeNode], edges: @Vec[ScopeEdge], changes: @Vec[ScopeChange]) -> Void effects[alloc, partial]:
  let let_form: Bool = syntax.ast_expression_is_let(source, tokens, expr)
  if let_form:
    link_local_let(source, @tokens, expr, @nodes, @edges, @changes)
  else:
    let set_form: Bool = syntax.ast_expression_is_set(source, tokens, expr)
    if set_form:
      link_local_set(source, @tokens, expr, @nodes, @edges, @changes)
    else:
      let call_form: Bool = syntax.ast_expression_is_call(source, tokens, expr)
      if call_form:
        link_local_forms(source, @tokens, syntax.ast_call_arguments(expr), @nodes, @edges, @changes)
      else:
        link_local_data(source, @tokens, expr, @nodes, @edges, @changes)

fn link_local_expr(source: Bytes, tokens: @Vec[syntax.Token], expr: I64, nodes: @Vec[ScopeNode], edges: @Vec[ScopeEdge], changes: @Vec[ScopeChange]) -> Void effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, expr)
  let form: Bool = kind == 0
  if form:
    link_local_form(source, @tokens, expr, @nodes, @edges, @changes)
  else:
    let atom: Bool = kind == 2
    if atom:
      link_local_atom(source, @tokens, expr, nodes, edges)
    else:
      void

fn bind_link_parameters(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, nodes: @Vec[ScopeNode], edges: @Vec[ScopeEdge], changes: @Vec[ScopeChange]) -> Void effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    void
  else:
    let name: I64 = parameter_name(source, tokens, cursor)
    let type: I64 = parameter_type(source, tokens, cursor)
    let mode: I64 = parameter_borrow_mode(source, tokens, cursor)
    bind_scope_token(source, tokens, name, type, mode, @nodes, @edges, @changes)
    let next: I64 = syntax.ast_next(tokens, cursor)
    recur(source, tokens, next, @nodes, @edges, @changes)

fn link_function_locals(source: Bytes, tokens: @Vec[syntax.Token], item: I64) -> Void effects[alloc, partial]:
  let nodes: Vec[ScopeNode] = vec.new()
  let edges: Vec[ScopeEdge] = vec.new()
  let changes: Vec[ScopeChange] = vec.new()
  let root: I64 = append_scope_node(-1, @nodes)
  let params: I64 = syntax.ast_function_parameters(item)
  bind_link_parameters(source, tokens, syntax.ast_parameters_first(params), @nodes, @edges, @changes)
  let return_type: I64 = syntax.ast_function_return_type(tokens, item)
  let effects: I64 = syntax.ast_function_effects(tokens, item)
  let body: I64 = syntax.ast_function_body(tokens, item)
  link_local_expr(source, @tokens, body, @nodes, @edges, @changes)

fn link_declaration_locals(source: Bytes, tokens: @Vec[syntax.Token], declarations: Vec[ir.Declaration], index: I64) -> Void effects[alloc, partial]:
  let count: I64 = vec.len(declarations)
  let done: Bool = index >= count
  if done:
    void
  else:
    let declaration: ir.Declaration = vec.get(declarations, index)
    let item: I64 = declaration.form
    let function: Bool = syntax.ast_item_is_function(source, tokens, item)
    if function:
      link_function_locals(source, @tokens, item)
    else:
      void
    let next: I64 = index + 1
    recur(source, @tokens, declarations, next)

fn invalid_type(token: I64) -> TypeRef:
  TypeRef(kind: -2, form: token)

fn initialize_facts(tokens: Vec[syntax.Token], expr: I64, facts: @Vec[Fact]) -> Void effects[alloc, partial]:
  let length: I64 = vec.len(tokens)
  let done: Bool = expr >= length
  if done:
    void
  else:
    let type: TypeRef = invalid_type(expr)
    let fact: Fact = Fact(tag: type.kind + 2, form: type.form)
    vec.push(@facts, fact)
    let next: I64 = syntax.ast_node_after(expr)
    recur(tokens, next, @facts)

fn fact_type(facts: Vec[Fact], expr: I64) -> TypeRef effects[partial]:
  let nonnegative: Bool = expr >= 0
  let length: I64 = vec.len(facts)
  let below: Bool = expr < length
  let bounded: Bool = nonnegative && below
  if bounded:
    let fact: Fact = vec.get(facts, expr)
    TypeRef(kind: (fact.tag % 8) - 2, form: fact.form)
  else:
    invalid_type(expr)

fn fact_borrow_mode(fact: Fact) -> I64:
  (fact.tag / 8) - 1

fn linked_binding_borrow_mode(tokens: Vec[syntax.Token], name: I64) -> I64 effects[partial]:
  let link: I64 = syntax.ast_node_link(tokens, name)
  let encoded: Bool = link < -1
  if encoded:
    let positive: I64 = 0 - link
    let packed: I64 = positive - 2
    let base: I64 = vec.len(tokens) + 1
    let type_mode: I64 = packed / base
    type_mode % 3
  else:
    0

fn linked_binding_is_exclusive(tokens: Vec[syntax.Token], name: I64) -> Bool effects[partial]:
  linked_binding_borrow_mode(tokens, name) == 2

fn linked_binding_declaration(tokens: Vec[syntax.Token], name: I64) -> I64 effects[partial]:
  let link: I64 = syntax.ast_node_link(tokens, name)
  let encoded: Bool = link < -1
  if encoded:
    let positive: I64 = 0 - link
    let packed: I64 = positive - 2
    let base: I64 = vec.len(tokens) + 1
    packed % base
  else:
    -1

fn scalar_type(kind: I64, token: I64) -> TypeRef:
  TypeRef(kind: kind, form: token)

fn source_type(source: Bytes, tokens: Vec[syntax.Token], form: I64) -> TypeRef effects[partial]:
  let kind: I64 = syntax.scalar_type_kind(source, tokens, form)
  TypeRef(kind: kind, form: form)

fn type_valid(type: TypeRef) -> Bool:
  type.kind >= -1

fn append_issue(code: Bytes, start: I64, end: I64, issues: @Vec[Issue]) -> Void effects[alloc]:
  let issue: Issue = Issue(code: code, start: start, end: end, blocks_inference: true)
  vec.push(@issues, issue)

fn append_ownership_issue(code: Bytes, token: I64, issues: @Vec[Issue]) -> Void effects[alloc]:
  let issue: Issue = Issue(code: code, start: token, end: token, blocks_inference: false)
  vec.push(@issues, issue)

fn issues_block_inference(issues: Vec[Issue]) -> Bool effects[partial]:
  let count: I64 = vec.len(issues)
  let present: Bool = count > 0
  if present:
    let last: I64 = count - 1
    let issue: Issue = vec.get(issues, last)
    issue.blocks_inference
  else:
    false

fn record_issue(code: Bytes, token: I64, issues: @Vec[Issue]) -> Void effects[alloc, partial]:
  let blocked: Bool = issues_block_inference(issues)
  if blocked:
    void
  else:
    append_issue(code, token, token, @issues)

fn type_forms_equal(source: Bytes, tokens: Vec[syntax.Token], left: I64, right: I64) -> Bool effects[partial]:
  let left_kind: I64 = syntax.ast_node_kind(tokens, left)
  let right_kind: I64 = syntax.ast_node_kind(tokens, right)
  let same_kind: Bool = left_kind == right_kind
  if same_kind:
    let form: Bool = left_kind == 0
    if form:
      type_lists_equal(source, tokens, syntax.ast_list_first(left), syntax.ast_list_first(right))
    else:
      let left_start: I64 = syntax.ast_node_start(tokens, left)
      let left_end: I64 = syntax.ast_node_end(tokens, left)
      let right_start: I64 = syntax.ast_node_start(tokens, right)
      let right_end: I64 = syntax.ast_node_end(tokens, right)
      syntax.spans_equal(source, left_start, left_end, right_start, right_end)
  else:
    false

fn type_lists_equal(source: Bytes, tokens: Vec[syntax.Token], left: I64, right: I64) -> Bool effects[partial]:
  let left_kind: I64 = syntax.ast_node_kind(tokens, left)
  let right_kind: I64 = syntax.ast_node_kind(tokens, right)
  let left_done: Bool = left_kind == 1
  let right_done: Bool = right_kind == 1
  let either_done: Bool = left_done || right_done
  if either_done:
    left_done && right_done
  else:
    let same: Bool = type_forms_equal(source, tokens, left, right)
    if same:
      let next_left: I64 = syntax.ast_next(tokens, left)
      let next_right: I64 = syntax.ast_next(tokens, right)
      recur(source, tokens, next_left, next_right)
    else:
      false

fn types_equal(source: Bytes, tokens: Vec[syntax.Token], left: TypeRef, right: TypeRef) -> Bool effects[partial]:
  let left_kind: I64 = left.kind
  let right_kind: I64 = right.kind
  let left_scalar: Bool = left_kind >= 0
  let right_scalar: Bool = right_kind >= 0
  let either_scalar: Bool = left_scalar || right_scalar
  if either_scalar:
    let both: Bool = left_scalar && right_scalar
    let same: Bool = left_kind == right_kind
    both && same
  else:
    type_forms_equal(source, tokens, left.form, right.form)

fn type_matches_form(source: Bytes, tokens: Vec[syntax.Token], actual: TypeRef, expected: I64) -> Bool effects[partial]:
  let expected_type: TypeRef = source_type(source, tokens, expected)
  types_equal(source, tokens, actual, expected_type)

fn add_fact(expr: I64, type: TypeRef, facts: @Vec[Fact]) -> Void effects[alloc, partial]:
  let valid: Bool = type_valid(type)
  if valid:
    let fact: Fact = Fact(tag: type.kind + 2, form: type.form)
    vec.set(@facts, expr, fact)
  else:
    void

fn finish_type(source: Bytes, tokens: Vec[syntax.Token], expr: I64, expected: I64, actual: TypeRef, facts: @Vec[Fact], issues: @Vec[Issue]) -> TypeRef effects[alloc, partial]:
  let valid: Bool = type_valid(actual)
  let contextual: Bool = expected >= 0
  let compare: Bool = valid && contextual
  let same: Bool = if compare:
    type_matches_form(source, tokens, actual, expected)
  else:
    true
  if same:
    add_fact(expr, actual, @facts)
    fact_type(facts, expr)
  else:
    record_issue("E0344", expr, @issues)
    invalid_type(expr)

fn parameter_is_exclusive(source: Bytes, tokens: Vec[syntax.Token], parameter: I64) -> Bool effects[partial]:
  syntax.ast_binding_is_exclusive(source, tokens, parameter)

fn parameter_name(source: Bytes, tokens: Vec[syntax.Token], parameter: I64) -> I64 effects[partial]:
  syntax.ast_binding_name(source, tokens, parameter)

fn parameter_type(source: Bytes, tokens: Vec[syntax.Token], parameter: I64) -> I64 effects[partial]:
  syntax.ast_binding_type(source, tokens, parameter)

fn parameter_borrow_mode(source: Bytes, tokens: Vec[syntax.Token], parameter: I64) -> I64 effects[partial]:
  let declared: I64 = syntax.ast_binding_mode(source, tokens, parameter)
  if declared == 1:
    2
  else:
    if declared == 2:
      0
    else:
      let type: I64 = parameter_type(source, tokens, parameter)
      let storage: I64 = memory.type_storage_kind(source, tokens, type)
      let affine: Bool = storage == 2
      if affine:
        1
      else:
        0

fn add_binding(tokens: @Vec[syntax.Token], name: I64, type: I64, mode: I64, owner: I64, mutable: Bool, parent: I64, bindings: @Vec[Binding]) -> I64 effects[alloc, partial]:
  let index: I64 = vec.len(bindings)
  syntax.ast_node_set_link(@tokens, name, index)
  let resolved_owner: I64 = if owner == -1:
    index
  else:
    owner
  let binding: Binding = Binding(name: name, type: type, mode: mode, mutable: mutable, move_scope: -1, owner: resolved_owner, parent: parent, access_call: -1, access_mode: 0)
  vec.push(@bindings, binding)
  index

fn bind_parameters(source: Bytes, tokens: @Vec[syntax.Token], cursor: I64, parent: I64, bindings: @Vec[Binding]) -> I64 effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    parent
  else:
    let name: I64 = parameter_name(source, tokens, cursor)
    let type: I64 = parameter_type(source, tokens, cursor)
    let mode: I64 = parameter_borrow_mode(source, tokens, cursor)
    let declared_mutable: Bool = syntax.ast_binding_is_mutable(source, tokens, cursor)
    let mutable: Bool = (mode == 2) || declared_mutable
    let next_parent: I64 = add_binding(@tokens, name, type, mode, -1, mutable, parent, @bindings)
    let next: I64 = syntax.ast_next(tokens, cursor)
    recur(source, @tokens, next, next_parent, @bindings)

fn find_binding_type(source: Bytes, tokens: Vec[syntax.Token], bindings: Vec[Binding], parent: I64, name: I64) -> I64 effects[partial]:
  let link: I64 = syntax.ast_node_link(tokens, name)
  let encoded: Bool = link < -1
  let decoded_type: I64 = if encoded:
    let positive: I64 = 0 - link
    let packed: I64 = positive - 2
    let base: I64 = vec.len(tokens) + 1
    let type_mode: I64 = packed / base
    type_mode / 3
  else:
    -1
  let linked_type: Bool = decoded_type > 0
  if linked_type:
    decoded_type
  else:
    let done: Bool = parent < 0
    if done:
      -1
    else:
      let binding: Binding = vec.get(bindings, parent)
      let candidate: I64 = binding.name
      let name_start: I64 = syntax.ast_node_start(tokens, name)
      let name_end: I64 = syntax.ast_node_end(tokens, name)
      let candidate_start: I64 = syntax.ast_node_start(tokens, candidate)
      let candidate_end: I64 = syntax.ast_node_end(tokens, candidate)
      let same: Bool = syntax.spans_equal(source, name_start, name_end, candidate_start, candidate_end)
      if same:
        binding.type
      else:
        recur(source, tokens, bindings, binding.parent, name)

fn linked_binding_index(tokens: Vec[syntax.Token], name: I64) -> I64 effects[partial]:
  let declaration: I64 = linked_binding_declaration(tokens, name)
  let found: Bool = declaration >= 0
  if found:
    syntax.ast_node_link(tokens, declaration)
  else:
    -1

fn find_binding_mutable(tokens: Vec[syntax.Token], bindings: Vec[Binding], name: I64) -> Bool effects[partial]:
  let binding_index: I64 = linked_binding_index(tokens, name)
  let found: Bool = binding_index >= 0
  if found:
    let binding: Binding = vec.get(bindings, binding_index)
    binding.mutable
  else:
    false

fn advance_binding(bindings: @Vec[Binding], index: I64, scopes: @Vec[ownership.Scope], frames: @Vec[ownership.Frame]) -> I64 effects[alloc, partial]:
  let binding: Binding = vec.get(bindings, index)
  let frame: I64 = ownership.advance(@scopes, @frames, binding.move_scope)
  vec.set(@bindings, index, Binding(name: binding.name, type: binding.type, mode: binding.mode, mutable: binding.mutable, move_scope: frame, owner: binding.owner, parent: binding.parent, access_call: binding.access_call, access_mode: binding.access_mode))
  frame

fn find_binding_moved(tokens: Vec[syntax.Token], bindings: @Vec[Binding], name: I64, scopes: @Vec[ownership.Scope], frames: @Vec[ownership.Frame]) -> Bool effects[alloc, partial]:
  let index: I64 = linked_binding_index(tokens, name)
  if index >= 0:
    let binding: Binding = vec.get(bindings, index)
    if binding.move_scope < 0:
      false
    else:
      let frame: I64 = advance_binding(@bindings, index, @scopes, @frames)
      let state: ownership.Frame = vec.get(frames, frame)
      state.moved
  else:
    false

fn reinitialize_binding(bindings: @Vec[Binding], index: I64, scopes: @Vec[ownership.Scope], frames: @Vec[ownership.Frame]) -> Void effects[alloc, partial]:
  let binding: Binding = vec.get(bindings, index)
  if binding.move_scope < 0:
    void
  else:
    let frame: I64 = advance_binding(@bindings, index, @scopes, @frames)
    ownership.set_moved(@frames, frame, false)

fn mark_named_move(tokens: Vec[syntax.Token], argument: I64, bindings: @Vec[Binding], issues: @Vec[Issue], scopes: @Vec[ownership.Scope], frames: @Vec[ownership.Frame]) -> Bool effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, argument)
  let named: Bool = kind == 2
  if named:
    let binding_index: I64 = linked_binding_index(tokens, argument)
    let found: Bool = binding_index >= 0
    if found:
      let binding: Binding = vec.get(bindings, binding_index)
      let moved: Bool = find_binding_moved(tokens, @bindings, argument, @scopes, @frames)
      if moved:
        true
      else:
        let borrowed: Bool = binding.mode > 0
        let loan: Bool = named_loan_conflict(tokens, bindings, binding_index, argument, true)
        if loan:
          record_issue("E0349", argument, @issues)
          false
        else:
          if borrowed:
            append_ownership_issue("E0347", argument, @issues)
            true
          else:
            let frame: I64 = advance_binding(@bindings, binding_index, @scopes, @frames)
            ownership.set_moved(@frames, frame, true)
            true
    else:
      true
  else:
    true

# Only result edges carry the transferred value: let/set continuations and
# exclusive alternatives. Initializers and statement prefixes have already
# been checked at their own destinations and must not be transferred again.
fn mark_result_arms(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, bindings: @Vec[Binding], issues: @Vec[Issue], scopes: @Vec[ownership.Scope], frames: @Vec[ownership.Frame]) -> Bool effects[alloc, partial]:
  if syntax.ast_node_kind(tokens, cursor) == 1:
    true
  else:
    let body: I64 = syntax.ast_arm_body(tokens, cursor)
    let moved: Bool = mark_result_move(source, tokens, body, @bindings, @issues, @scopes, @frames)
    let next: I64 = syntax.ast_next(tokens, cursor)
    recur(source, tokens, next, @bindings, @issues, @scopes, @frames)

fn mark_result_move(source: Bytes, tokens: Vec[syntax.Token], value: I64, bindings: @Vec[Binding], issues: @Vec[Issue], scopes: @Vec[ownership.Scope], frames: @Vec[ownership.Frame]) -> Bool effects[alloc, partial]:
  let result: I64 = ownership_result_expr(source, tokens, value)
  let kind: I64 = syntax.ast_node_kind(tokens, result)
  if kind == 2:
    mark_named_move(tokens, result, @bindings, @issues, @scopes, @frames)
  else:
    let branch: Bool = if kind == 0:
      syntax.ast_expression_is_match(source, tokens, result)
    else:
      false
    if branch:
      let arms: I64 = syntax.ast_match_arms(tokens, result)
      mark_result_arms(source, tokens, arms, @bindings, @issues, @scopes, @frames)
    else:
      true

fn named_binding_mode(tokens: Vec[syntax.Token], argument: I64, bindings: Vec[Binding]) -> I64 effects[partial]:
  let binding_index: I64 = linked_binding_index(tokens, argument)
  let found: Bool = binding_index >= 0
  if found:
    let binding: Binding = vec.get(bindings, binding_index)
    binding.mode
  else:
    -1

fn check_exclusive_argument(tokens: Vec[syntax.Token], argument: I64, bindings: Vec[Binding], issues: @Vec[Issue]) -> Bool effects[alloc, partial]:
  let actual_mode: I64 = syntax.ast_argument_mode(tokens, argument)
  let exclusive: Bool = actual_mode == 1
  if exclusive:
    let kind: I64 = syntax.ast_node_kind(tokens, argument)
    let named: Bool = kind == 2
    if named:
      let binding_mode: I64 = named_binding_mode(tokens, argument, bindings)
      let shared: Bool = binding_mode == 1
      let binding_index: I64 = linked_binding_index(tokens, argument)
      let found: Bool = binding_index >= 0
      let unknown_owner: Bool = if found:
        let binding: Binding = vec.get(bindings, binding_index)
        binding.owner < 0
      else:
        false
      let invalid: Bool = shared || unknown_owner
      if invalid:
        append_ownership_issue("E0347", argument, @issues)
        false
      else:
        true
    else:
      append_ownership_issue("E0348", argument, @issues)
      false
  else:
    true

# The first two binding slots hold conservative unknown-owner and restricted
# loan summaries. Normal bindings start at two. Canonical form intervals make
# completed calls and local scopes inactive without copying or explicit pops.
fn loan_active(tokens: Vec[syntax.Token], loan: I64, node: I64) -> Bool effects[partial]:
  if (loan >= 0) && (loan <= node):
    control.scope_contains(control.scope(tokens, loan), node)
  else:
    false

fn retain_loan(tokens: Vec[syntax.Token], index: I64, call: I64, mode: I64, bindings: @Vec[Binding]) -> Void effects[alloc, partial]:
  let owner: Binding = vec.get(bindings, index)
  if loan_active(tokens, owner.access_call, call):
    void
  else:
    let updated: Binding = Binding(name: owner.name, type: owner.type, mode: owner.mode, mutable: owner.mutable, move_scope: owner.move_scope, owner: owner.owner, parent: owner.parent, access_call: call, access_mode: mode)
    vec.set(@bindings, index, updated)

fn check_argument_overlap(tokens: Vec[syntax.Token], argument: I64, owner_index: I64, call: I64, unknown_prior: Bool, restricted_prior: Bool, bindings: @Vec[Binding], issues: @Vec[Issue], activate: Bool) -> Bool effects[alloc, partial]:
  let actual_mode: I64 = syntax.ast_argument_mode(tokens, argument)
  check_loan_overlap(tokens, argument, actual_mode, owner_index, call, unknown_prior, restricted_prior, @bindings, @issues, activate)

fn check_loan_overlap(tokens: Vec[syntax.Token], argument: I64, actual_mode: I64, owner_index: I64, call: I64, unknown_prior: Bool, restricted_prior: Bool, bindings: @Vec[Binding], issues: @Vec[Issue], activate: Bool) -> Bool effects[alloc, partial]:
  let current_restricted: Bool = actual_mode > 0
  let unknown_current: Bool = owner_index == -2
  let unknown: Binding = vec.get(bindings, 0)
  let restricted: Binding = vec.get(bindings, 1)
  let unknown_active: Bool = loan_active(tokens, unknown.access_call, call)
  let restricted_active: Bool = loan_active(tokens, restricted.access_call, call)
  let unknown_conflict: Bool = (unknown_current && (restricted_prior || restricted_active)) || (current_restricted && (unknown_prior || unknown_active))
  let known: Bool = owner_index >= 2
  let previous: I64 = if known:
    let owner: Binding = vec.get(bindings, owner_index)
    owner.access_call
  else:
    -1
  let prior_restricted: Bool = if known:
    let owner: Binding = vec.get(bindings, owner_index)
    owner.access_mode > 0
  else:
    false
  let active: Bool = loan_active(tokens, previous, call)
  let known_conflict: Bool = active && (prior_restricted || current_restricted)
  if unknown_conflict || known_conflict:
    let nested_known: Bool = known_conflict && (previous < call)
    let nested_unknown: Bool = current_restricted && (unknown_active && (unknown.access_call < call))
    let nested_restricted: Bool = unknown_current && (restricted_active && (restricted.access_call < call))
    if nested_known || (nested_unknown || nested_restricted):
      record_issue("E0349", argument, @issues)
    else:
      append_ownership_issue("E0349", argument, @issues)
    false
  else:
    if activate:
      if known:
        retain_loan(tokens, owner_index, call, actual_mode, @bindings)
      else:
        if unknown_current:
          retain_loan(tokens, 0, call, actual_mode, @bindings)
        else:
          void
      if current_restricted && (known || unknown_current):
        retain_loan(tokens, 1, call, actual_mode, @bindings)
      else:
        void
    else:
      void
    true

fn named_loan_conflict(tokens: Vec[syntax.Token], bindings: Vec[Binding], index: I64, node: I64, moving: Bool) -> Bool effects[partial]:
  let binding: Binding = vec.get(bindings, index)
  let owner_index: I64 = binding.owner
  let unknown: Binding = vec.get(bindings, 0)
  let restricted: Binding = vec.get(bindings, 1)
  let global_conflict: Bool = if moving:
    loan_active(tokens, unknown.access_call, node)
  else:
    (owner_index == -2) && loan_active(tokens, restricted.access_call, node)
  let known_conflict: Bool = if owner_index >= 2:
    let owner: Binding = vec.get(bindings, owner_index)
    loan_active(tokens, owner.access_call, node) && (moving || (owner.access_mode == 1))
  else:
    false
  global_conflict || known_conflict

fn expression_is_storage_read(source: Bytes, tokens: Vec[syntax.Token], value: I64) -> Bool effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, value)
  let call: Bool = if kind == 0:
    syntax.ast_expression_is_call(source, tokens, value)
  else:
    false
  if call:
    let callee: I64 = syntax.ast_call_callee(value)
    let vector_get: Bool = syntax.ast_node_text_is(source, tokens, callee, "vec.get")
    let arena_get: Bool = syntax.ast_node_text_is(source, tokens, callee, "arena.get")
    vector_get || arena_get
  else:
    false

fn merge_borrow_modes(left: I64, right: I64) -> I64:
  let shared: Bool = (left == 1) || (right == 1)
  if shared:
    1
  else:
    let exclusive: Bool = (left == 2) || (right == 2)
    if exclusive:
      2
    else:
      0

fn arm_values_borrow_mode(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, bindings: Vec[Binding], mode: I64) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    mode
  else:
    let body: I64 = syntax.ast_arm_body(tokens, cursor)
    let body_mode: I64 = value_borrow_mode(source, tokens, body, bindings)
    let merged: I64 = merge_borrow_modes(mode, body_mode)
    let next: I64 = syntax.ast_next(tokens, cursor)
    recur(source, tokens, next, bindings, merged)

fn value_borrow_mode(source: Bytes, tokens: Vec[syntax.Token], value: I64, bindings: Vec[Binding]) -> I64 effects[partial]:
  let result: I64 = ownership_result_expr(source, tokens, value)
  if !(result == value):
    recur(source, tokens, result, bindings)
  else:
    let kind: I64 = syntax.ast_node_kind(tokens, value)
    let named: Bool = kind == 2
    if named:
      named_binding_mode(tokens, value, bindings)
    else:
      let get_form: Bool = if kind == 0:
        syntax.ast_expression_is_get(source, tokens, value)
      else:
        false
      if get_form:
        1
      else:
        let match_form: Bool = if kind == 0:
          syntax.ast_expression_is_match(source, tokens, value)
        else:
          false
        if match_form:
          arm_values_borrow_mode(source, tokens, syntax.ast_match_arms(tokens, value), bindings, 0)
        else:
          let storage_read: Bool = expression_is_storage_read(source, tokens, value)
          if storage_read:
            1
          else:
            0

fn arm_values_borrow_owner(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, bindings: Vec[Binding], owner: I64, present: Bool) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    owner
  else:
    let body: I64 = syntax.ast_arm_body(tokens, cursor)
    let body_owner: I64 = value_borrow_owner(source, tokens, body, bindings)
    let same: Bool = present && (owner == body_owner)
    let merged: I64 = if present:
      if same:
        owner
      else:
        -2
    else:
      body_owner
    let next: I64 = syntax.ast_next(tokens, cursor)
    recur(source, tokens, next, bindings, merged, true)

fn value_borrow_owner(source: Bytes, tokens: Vec[syntax.Token], value: I64, bindings: Vec[Binding]) -> I64 effects[partial]:
  let result: I64 = ownership_result_expr(source, tokens, value)
  if !(result == value):
    recur(source, tokens, result, bindings)
  else:
    let kind: I64 = syntax.ast_node_kind(tokens, value)
    let named: Bool = kind == 2
    if named:
      let binding_index: I64 = linked_binding_index(tokens, value)
      let found: Bool = binding_index >= 0
      if found:
        let binding: Binding = vec.get(bindings, binding_index)
        binding.owner
      else:
        -1
    else:
      let get_form: Bool = if kind == 0:
        syntax.ast_expression_is_get(source, tokens, value)
      else:
        false
      if get_form:
        let owner: I64 = value_borrow_owner(source, tokens, syntax.ast_get_value(value), bindings)
        if owner == -1:
          -2
        else:
          owner
      else:
        let match_form: Bool = if kind == 0:
          syntax.ast_expression_is_match(source, tokens, value)
        else:
          false
        if match_form:
          arm_values_borrow_owner(source, tokens, syntax.ast_match_arms(tokens, value), bindings, -1, false)
        else:
          let storage_read: Bool = expression_is_storage_read(source, tokens, value)
          if storage_read:
            let first: I64 = syntax.ast_call_arguments(value)
            recur(source, tokens, first, bindings)
          else:
            -1

fn check_storage_move(source: Bytes, tokens: Vec[syntax.Token], value: I64, type: I64, bindings: @Vec[Binding], issues: @Vec[Issue], scopes: @Vec[ownership.Scope], frames: @Vec[ownership.Frame]) -> Bool effects[alloc, partial]:
  let storage: I64 = memory.type_storage_kind(source, tokens, type)
  let affine: Bool = storage == 2
  if affine:
    let mode: I64 = value_borrow_mode(source, tokens, value, bindings)
    let borrowed: Bool = mode > 0
    if borrowed:
      append_ownership_issue("E0347", value, @issues)
      false
    else:
      mark_result_move(source, tokens, value, @bindings, @issues, @scopes, @frames)
  else:
    true

fn form_count(tokens: Vec[syntax.Token], cursor: I64, count: I64) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    count
  else:
    let next: I64 = syntax.ast_next(tokens, cursor)
    recur(tokens, next, count + 1)

fn expect_arity(tokens: Vec[syntax.Token], cursor: I64, expected: I64, token: I64, issues: @Vec[Issue]) -> Bool effects[alloc, partial]:
  let actual: I64 = form_count(tokens, cursor, 0)
  let same: Bool = actual == expected
  if same:
    true
  else:
    record_issue("E0351", token, @issues)
    false

fn expect_kind(actual: TypeRef, kind: I64, token: I64, issues: @Vec[Issue]) -> Bool effects[alloc, partial]:
  let valid: Bool = type_valid(actual)
  let same_kind: Bool = actual.kind == kind
  let same: Bool = valid && same_kind
  if same:
    true
  else:
    record_issue("E0344", token, @issues)
    false

fn builtin_group_math(source: Bytes, tokens: Vec[syntax.Token], callee: I64) -> Bool effects[partial]:
  let a: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.add")
  let b: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.sub")
  let c: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.mul")
  let d: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.div")
  let e: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.rem")
  a || (b || (c || (d || e)))

fn builtin_group_compare(source: Bytes, tokens: Vec[syntax.Token], callee: I64) -> Bool effects[partial]:
  let a: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.eq")
  let b: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.lt")
  let c: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.le")
  let d: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.gt")
  let e: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.ge")
  a || (b || (c || (d || e)))

fn builtin_group_scalar(source: Bytes, tokens: Vec[syntax.Token], callee: I64) -> Bool effects[partial]:
  let a: Bool = syntax.ast_node_text_is(source, tokens, callee, "bool.not")
  let b: Bool = syntax.ast_node_text_is(source, tokens, callee, "bool.and")
  let c: Bool = syntax.ast_node_text_is(source, tokens, callee, "bool.or")
  let d: Bool = syntax.ast_node_text_is(source, tokens, callee, "u8.to_i64")
  let e: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.to_u8")
  a || (b || (c || (d || e)))

fn builtin_group_bytes_io(source: Bytes, tokens: Vec[syntax.Token], callee: I64) -> Bool effects[partial]:
  let a: Bool = syntax.ast_node_text_is(source, tokens, callee, "bytes.len")
  let b: Bool = syntax.ast_node_text_is(source, tokens, callee, "bytes.get")
  let c: Bool = syntax.ast_node_text_is(source, tokens, callee, "bytes.freeze")
  let d: Bool = syntax.ast_node_text_is(source, tokens, callee, "io.print_i64")
  let e: Bool = syntax.ast_node_text_is(source, tokens, callee, "io.print_bytes")
  let f: Bool = syntax.ast_node_text_is(source, tokens, callee, "io.println")
  let g: Bool = syntax.ast_node_text_is(source, tokens, callee, "io.read_file")
  let h: Bool = syntax.ast_node_text_is(source, tokens, callee, "io.monotonic_ms")
  let i: Bool = syntax.ast_node_text_is(source, tokens, callee, "io.tcp_exchange")
  a || (b || (c || (d || (e || (f || (g || (h || i)))))))

fn builtin_group_storage(source: Bytes, tokens: Vec[syntax.Token], callee: I64) -> Bool effects[partial]:
  let a: Bool = syntax.ast_node_text_is(source, tokens, callee, "vec.new")
  let b: Bool = syntax.ast_node_text_is(source, tokens, callee, "vec.len")
  let c: Bool = syntax.ast_node_text_is(source, tokens, callee, "vec.get")
  let d: Bool = syntax.ast_node_text_is(source, tokens, callee, "vec.push")
  let e: Bool = syntax.ast_node_text_is(source, tokens, callee, "vec.set")
  let f: Bool = syntax.ast_node_text_is(source, tokens, callee, "arena.new")
  let g: Bool = syntax.ast_node_text_is(source, tokens, callee, "arena.add")
  let h: Bool = syntax.ast_node_text_is(source, tokens, callee, "arena.get")
  a || (b || (c || (d || (e || (f || (g || h))))))

fn builtin_known(source: Bytes, tokens: Vec[syntax.Token], callee: I64) -> Bool effects[partial]:
  let math: Bool = builtin_group_math(source, tokens, callee)
  let compare: Bool = builtin_group_compare(source, tokens, callee)
  let scalar: Bool = builtin_group_scalar(source, tokens, callee)
  let bytes_io: Bool = builtin_group_bytes_io(source, tokens, callee)
  let storage: Bool = builtin_group_storage(source, tokens, callee)
  let replace: Bool = syntax.ast_node_text_is(source, tokens, callee, "mem.replace")
  replace || (math || (compare || (scalar || (bytes_io || storage))))

# The operation is the already decoded built-in shape. Reuse it for each
# operand instead of repeating callee spelling checks. Operations 5/6/7 reserve
# their first operand, 9 consumes it, and 10/11 reserve output positions 1/5.
fn builtin_argument_mode(operation: I64, position: I64) -> I64:
  let first: Bool = position == 0
  let exclusive_first: Bool = first && ((operation == 5) || ((operation == 6) || (operation == 7)))
  let freeze: Bool = first && (operation == 9)
  let read_output: Bool = (position == 1) && (operation == 10)
  let network_output: Bool = (position == 5) && (operation == 11)
  if exclusive_first || (read_output || network_output):
    1
  else:
    if freeze:
      2
    else:
      0

fn check_builtin_argument_modes(tokens: Vec[syntax.Token], operation: I64, argument: I64, position: I64, bindings: Vec[Binding], issues: @Vec[Issue]) -> Bool effects[alloc, partial]:
  let done: Bool = syntax.ast_node_kind(tokens, argument) == 1
  if done:
    true
  else:
    let expected: I64 = builtin_argument_mode(operation, position)
    let actual: I64 = syntax.ast_argument_mode(tokens, argument)
    let mode_same: Bool = expected == actual
    let capability: Bool = check_exclusive_argument(tokens, argument, bindings, @issues)
    let same: Bool = mode_same && capability
    if same:
      let next: I64 = syntax.ast_next(tokens, argument)
      recur(tokens, operation, next, position + 1, bindings, @issues)
    else:
      if mode_same:
        void
      else:
        append_ownership_issue("E0360", argument, @issues)
      let next: I64 = syntax.ast_next(tokens, argument)
      let remaining: Bool = recur(tokens, operation, next, position + 1, bindings, @issues)
      remaining && false

fn result_is_composite(source: Bytes, tokens: Vec[syntax.Token], type: TypeRef, constructor: I64) -> Bool effects[partial]:
  let valid: Bool = type_valid(type)
  let source_kind: Bool = type.kind == -1
  let possible: Bool = valid && source_kind
  if possible:
    let form: I64 = type.form
    let vector_kind: Bool = constructor == 0
    if vector_kind:
      syntax.ast_type_is_vec(source, tokens, form)
    else:
      let arena_kind: Bool = constructor == 1
      if arena_kind:
        syntax.ast_type_is_arena(source, tokens, form)
      else:
        syntax.ast_type_is_id(source, tokens, form)
  else:
    false

fn linked_item(tokens: Vec[syntax.Token], name: I64) -> I64 effects[partial]:
  syntax.ast_node_link(tokens, name)

fn item_has_kind(source: Bytes, tokens: Vec[syntax.Token], item: I64, kind: I64) -> Bool effects[partial]:
  let present: Bool = item >= 0
  if present:
    let function_kind: Bool = kind == 0
    if function_kind:
      syntax.ast_item_is_function(source, tokens, item)
    else:
      let record_kind: Bool = kind == 1
      if record_kind:
        syntax.ast_item_is_record(source, tokens, item)
      else:
        syntax.ast_item_is_variant(source, tokens, item)
  else:
    false

fn find_named_form(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, name: I64) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    -1
  else:
    let candidate: I64 = syntax.ast_node_after(cursor)
    let name_start: I64 = syntax.ast_node_start(tokens, name)
    let name_end: I64 = syntax.ast_node_end(tokens, name)
    let candidate_start: I64 = syntax.ast_node_start(tokens, candidate)
    let candidate_end: I64 = syntax.ast_node_end(tokens, candidate)
    let same: Bool = syntax.spans_equal(source, name_start, name_end, candidate_start, candidate_end)
    if same:
      cursor
    else:
      let next: I64 = syntax.ast_next(tokens, cursor)
      recur(source, tokens, next, name)

fn integer_digits_at_most(source: Bytes, start: I64, bound: Bytes, at: I64) -> Bool effects[partial]:
  if at == 19:
    true
  else:
    let digit: I64 = u8.to_i64(bytes.get(source, start + at))
    let limit: I64 = u8.to_i64(bytes.get(bound, at))
    if digit == limit:
      recur(source, start, bound, at + 1)
    else:
      digit < limit

fn integer_in_i64_range(source: Bytes, tokens: Vec[syntax.Token], expr: I64) -> Bool effects[partial]:
  let start: I64 = syntax.integer_digits_start(source, tokens, expr)
  let length: I64 = syntax.ast_node_end(tokens, expr) - start
  if length == 19:
    let negative: Bool = u8.to_i64(bytes.get(source, syntax.ast_node_start(tokens, expr))) == 45
    let bound: Bytes = if negative:
      "9223372036854775808"
    else:
      "9223372036854775807"
    integer_digits_at_most(source, start, bound, 0)
  else:
    length < 19

fn infer_atom(source: Bytes, tokens: Vec[syntax.Token], expr: I64, parent: I64, bindings: @Vec[Binding], issues: @Vec[Issue], scopes: @Vec[ownership.Scope], frames: @Vec[ownership.Frame]) -> TypeRef effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, expr)
  let string_value: Bool = kind == 3
  if string_value:
    scalar_type(4, expr)
  else:
    let true_value: Bool = syntax.ast_node_text_is(source, tokens, expr, "true")
    let false_value: Bool = syntax.ast_node_text_is(source, tokens, expr, "false")
    let bool_value: Bool = true_value || false_value
    if bool_value:
      scalar_type(1, expr)
    else:
      let void_value: Bool = syntax.ast_node_text_is(source, tokens, expr, "void")
      if void_value:
        scalar_type(0, expr)
      else:
        let number: Bool = syntax.first_byte_is_number(source, tokens, expr)
        if number:
          if integer_in_i64_range(source, tokens, expr):
            void
          else:
            record_issue("E0361", expr, @issues)
          scalar_type(3, expr)
        else:
          let type: I64 = find_binding_type(source, tokens, bindings, parent, expr)
          let found: Bool = type >= 0
          if found:
            let binding_index: I64 = linked_binding_index(tokens, expr)
            let loan: Bool = if binding_index >= 2:
              named_loan_conflict(tokens, bindings, binding_index, expr, false)
            else:
              false
            if loan:
              record_issue("E0349", expr, @issues)
            else:
              void
            let moved: Bool = find_binding_moved(tokens, @bindings, expr, @scopes, @frames)
            if moved:
              append_ownership_issue("E0315", expr, @issues)
              source_type(source, tokens, type)
            else:
              source_type(source, tokens, type)
          else:
            record_issue("E0314", expr, @issues)
            invalid_type(expr)

fn infer_collection_new(source: Bytes, tokens: Vec[syntax.Token], expr: I64, arguments: I64, expected: I64, constructor: I64, issues: @Vec[Issue]) -> TypeRef effects[alloc, partial]:
  let arity: Bool = expect_arity(tokens, arguments, 0, syntax.ast_call_callee(expr), @issues)
  let contextual: Bool = expected >= 0
  let expected_type: TypeRef = if contextual:
    source_type(source, tokens, expected)
  else:
    invalid_type(expr)
  let composite: Bool = if contextual:
    result_is_composite(source, tokens, expected_type, constructor)
  else:
    false
  let valid: Bool = arity && composite
  if valid:
    expected_type
  else:
    record_issue("E0344", expr, @issues)
    invalid_type(expr)

fn infer_zero_scalar_builtin(tokens: Vec[syntax.Token], expr: I64, arguments: I64, result_kind: I64, issues: @Vec[Issue]) -> TypeRef effects[alloc, partial]:
  let arity: Bool = expect_arity(tokens, arguments, 0, syntax.ast_call_callee(expr), @issues)
  if arity:
    scalar_type(result_kind, expr)
  else:
    invalid_type(expr)

fn check_recursive_argument_identity(source: Bytes, tokens: Vec[syntax.Token], argument: I64, parameter: I64, recursive: Bool, issues: @Vec[Issue]) -> Bool effects[alloc, partial]:
  let borrowed: Bool = parameter_is_exclusive(source, tokens, parameter)
  let required: Bool = recursive && borrowed
  if required:
    let parameter_token: I64 = parameter_name(source, tokens, parameter)
    let parameter_start: I64 = syntax.ast_node_start(tokens, parameter_token)
    let parameter_end: I64 = syntax.ast_node_end(tokens, parameter_token)
    let argument_start: I64 = syntax.ast_node_start(tokens, argument)
    let argument_end: I64 = syntax.ast_node_end(tokens, argument)
    let same: Bool = syntax.spans_equal(source, parameter_start, parameter_end, argument_start, argument_end)
    if same:
      true
    else:
      append_issue("E0350", argument, argument, @issues)
      false
  else:
    true

fn check_owned_argument(source: Bytes, tokens: Vec[syntax.Token], argument: I64, parameter: I64, recursive: Bool, bindings: @Vec[Binding], issues: @Vec[Issue], scopes: @Vec[ownership.Scope], frames: @Vec[ownership.Frame]) -> Bool effects[alloc, partial]:
  let mode: I64 = syntax.ast_node_mode(tokens, parameter)
  let transfer: Bool = mode == 2
  if transfer:
    check_owned_value(source, tokens, argument, recursive, @bindings, @issues, @scopes, @frames)
  else:
    true

fn check_owned_value(source: Bytes, tokens: Vec[syntax.Token], argument: I64, recursive: Bool, bindings: @Vec[Binding], issues: @Vec[Issue], scopes: @Vec[ownership.Scope], frames: @Vec[ownership.Frame]) -> Bool effects[alloc, partial]:
  let source_mode: I64 = value_borrow_mode(source, tokens, argument, bindings)
  let borrowed: Bool = source_mode > 0
  let kind: I64 = syntax.ast_node_kind(tokens, argument)
  let named: Bool = kind == 2
  let binding_index: I64 = if named:
    linked_binding_index(tokens, argument)
  else:
    -1
  let whole_owner: Bool = binding_index >= 0
  let owner_index: I64 = value_borrow_owner(source, tokens, argument, bindings)
  let fresh: Bool = owner_index == -1
  let movable: Bool = (!borrowed) && (whole_owner || fresh)
  if movable:
    if recursive:
      true
    else:
      mark_named_move(tokens, argument, @bindings, @issues, @scopes, @frames)
  else:
    append_ownership_issue("E0347", argument, @issues)
    false

fn check_argument_mode(tokens: Vec[syntax.Token], argument: I64, parameter: I64, issues: @Vec[Issue]) -> Bool effects[alloc, partial]:
  let actual: I64 = syntax.ast_argument_mode(tokens, argument)
  let expected: I64 = syntax.ast_node_mode(tokens, parameter)
  let same: Bool = actual == expected
  if same:
    true
  else:
    append_ownership_issue("E0360", argument, @issues)
    false

# The argument record captures pre-child owner identity and registration gates.
# Those facts cannot be recomputed after nested inference changes bindings/loans.
# Prefix validity is not accumulated: the old terminal-recur loop returns only
# the list-end arity result, retaining every earlier ordered diagnostic.
struct ArgumentState:
  argument: I64
  parameter: I64
  owner: I64
  before: I64
  mode_matches: Bool
  capable: Bool
  allowed: Bool
  unknown: Bool
  restricted: Bool

struct ArgumentNext:
  state: ArgumentState
  done: Bool
  expected: I64
  result: TypeRef

fn argument_state(argument: I64, parameter: I64, unknown: Bool, restricted: Bool) -> ArgumentState:
  ArgumentState(argument: argument, parameter: parameter, owner: -1, before: 0, mode_matches: false, capable: false, allowed: true, unknown: unknown, restricted: restricted)

fn prepare_arguments(source: Bytes, tokens: Vec[syntax.Token], expr: I64, recursive: Bool, params: I64, issues: @Vec[Issue]) -> ArgumentState effects[alloc, partial]:
  let structure: control.Invocation = control.invocation(expr, recursive)
  if recursive:
    argument_state(structure.arguments, syntax.ast_parameters_first(params), false, false)
  else:
    let item: I64 = linked_item(tokens, structure.callee)
    if item_has_kind(source, tokens, item, 0):
      argument_state(structure.arguments, syntax.ast_parameters_first(syntax.ast_function_parameters(item)), false, false)
    else:
      record_issue("E0314", structure.callee, @issues)
      argument_state(-1, -1, false, false)

fn next_argument(source: Bytes, tokens: Vec[syntax.Token], expr: I64, recursive: Bool, return_type: I64, state: ArgumentState, bindings: @Vec[Binding], issues: @Vec[Issue]) -> ArgumentNext effects[alloc, partial]:
  if state.argument < 0:
    ArgumentNext(state: state, done: true, expected: -1, result: invalid_type(expr))
  else:
    let structure: control.Invocation = control.invocation(expr, recursive)
    let arguments_done: Bool = syntax.ast_list_done(tokens, state.argument)
    let parameters_done: Bool = syntax.ast_list_done(tokens, state.parameter)
    if arguments_done || parameters_done:
      if arguments_done && parameters_done:
        let type: I64 = if recursive:
          return_type
        else:
          syntax.ast_function_return_type(tokens, linked_item(tokens, structure.callee))
        ArgumentNext(state: state, done: true, expected: -1, result: source_type(source, tokens, type))
      else:
        record_issue("E0351", structure.callee, @issues)
        ArgumentNext(state: state, done: true, expected: -1, result: invalid_type(expr))
    else:
      let expected: I64 = parameter_type(source, tokens, state.parameter)
      let mode_matches: Bool = check_argument_mode(tokens, state.argument, state.parameter, @issues)
      let capable: Bool = check_exclusive_argument(tokens, state.argument, bindings, @issues)
      let owner: I64 = if mode_matches:
        value_borrow_owner(source, tokens, state.argument, bindings)
      else:
        -1
      let allowed: Bool = if mode_matches:
        check_argument_overlap(tokens, state.argument, owner, expr, state.unknown, state.restricted, @bindings, @issues, false)
      else:
        true
      let identity: Bool = check_recursive_argument_identity(source, tokens, state.argument, state.parameter, recursive, @issues)
      let next: ArgumentState = ArgumentState(argument: state.argument, parameter: state.parameter, owner: owner, before: vec.len(issues), mode_matches: mode_matches, capable: capable, allowed: allowed, unknown: state.unknown, restricted: state.restricted)
      ArgumentNext(state: next, done: false, expected: expected, result: invalid_type(state.argument))

fn finish_argument(source: Bytes, tokens: Vec[syntax.Token], expr: I64, recursive: Bool, state: ArgumentState, expected: I64, actual: TypeRef, bindings: @Vec[Binding], issues: @Vec[Issue], scopes: @Vec[ownership.Scope], frames: @Vec[ownership.Frame]) -> ArgumentState effects[alloc, partial]:
  let actual_valid: Bool = type_valid(actual)
  let moved: Bool = if actual_valid:
    check_owned_argument(source, tokens, state.argument, state.parameter, recursive, @bindings, @issues, @scopes, @frames)
  else:
    true
  # The parameter type was resolved before this child. Child inference changes
  # local bindings/loans and use links, never the callee parameter declaration.
  let storage: I64 = memory.type_storage_kind(source, tokens, expected)
  let register: Bool = state.mode_matches && (state.capable && (state.allowed && (actual_valid && (moved && ((storage == 2) && (vec.len(issues) == state.before))))))
  if register:
    let owner: I64 = value_borrow_owner(source, tokens, state.argument, bindings)
    let registered: Bool = check_argument_overlap(tokens, state.argument, owner, expr, state.unknown, state.restricted, @bindings, @issues, true)
    void
  else:
    void
  let argument: control.Member = control.member(tokens, state.argument, false)
  let parameter: I64 = syntax.ast_next(tokens, state.parameter)
  let mode: I64 = syntax.ast_argument_mode(tokens, state.argument)
  argument_state(argument.next, parameter, state.unknown || (state.mode_matches && (state.owner == -2)), state.restricted || (state.mode_matches && (mode > 0)))

# Like pending/branch scratch, only suspended argument contexts use storage.
# The active argument retains its exact pre-child owner and registration gates.
fn push_argument(state: ArgumentState, depth: I64, limit: I64, arguments: @Vec[ArgumentState]) -> I64 effects[alloc, partial]:
  let permitted: I64 = if (depth >= 0) && (depth < limit):
    1
  else:
    0
  let checked_depth: I64 = depth / permitted
  if checked_depth > 0:
    let at: I64 = checked_depth - 1
    if at < vec.len(arguments):
      vec.set(@arguments, at, state)
    else:
      vec.push(@arguments, state)
  else:
    void
  checked_depth + 1

fn user_call(source: Bytes, tokens: Vec[syntax.Token], expr: I64) -> Bool effects[partial]:
  let structure: control.Invocation = control.invocation(expr, false)
  if syntax.ast_node_text_is(source, tokens, structure.callee, "mem.replace"):
    false
  else:
    !builtin_known(source, tokens, structure.callee)

# Built-in operations: 1 uniform scalars, 2 bytes.get, 3 vec.len, 4 vec.get,
# 5 vec.push, 6 vec.set, 7 arena.add, 8 arena.get, 9 bytes.freeze,
# 10 io.read_file, 11 io.tcp_exchange, 12 mem.replace. Operation 100 is a
# zero-argument scalar; 101/102 are contextual Vec/Arena construction.
# phase is the current argument ordinal. The remaining fields retain only
# pre-child gates or results needed by later operands of this same call.
struct BuiltinState:
  operation: I64
  phase: I64
  argument: I64
  kind: I64
  result_kind: I64
  count: I64
  element: I64
  valid: Bool
  modes_valid: Bool
  allowed: Bool
  before: I64
  result: TypeRef

struct BuiltinNext:
  state: BuiltinState
  done: Bool
  expected: I64
  result: TypeRef

fn builtin_state(operation: I64, argument: I64, kind: I64, result_kind: I64, count: I64, modes_valid: Bool) -> BuiltinState:
  BuiltinState(operation: operation, phase: 0, argument: argument, kind: kind, result_kind: result_kind, count: count, element: -1, valid: true, modes_valid: modes_valid, allowed: true, before: 0, result: invalid_type(argument))

fn advance_builtin(state: BuiltinState, phase: I64, argument: I64, kind: I64, element: I64, valid: Bool, result: TypeRef) -> BuiltinState:
  BuiltinState(operation: state.operation, phase: phase, argument: argument, kind: kind, result_kind: state.result_kind, count: state.count, element: element, valid: valid, modes_valid: state.modes_valid, allowed: true, before: 0, result: result)

fn builtin_child(state: BuiltinState, expected: I64) -> BuiltinNext:
  BuiltinNext(state: state, done: false, expected: expected, result: invalid_type(state.argument))

fn complete_builtin(state: BuiltinState, expr: I64, actual: TypeRef) -> BuiltinNext:
  let result: TypeRef = if state.modes_valid:
    actual
  else:
    invalid_type(expr)
  BuiltinNext(state: state, done: true, expected: -1, result: result)

fn builtin_shape(source: Bytes, tokens: Vec[syntax.Token], callee: I64, argument: I64, modes: Bool) -> BuiltinState effects[partial]:
  if builtin_group_math(source, tokens, callee):
    builtin_state(1, argument, 3, 3, 2, modes)
  else:
    if builtin_group_compare(source, tokens, callee):
      builtin_state(1, argument, 3, 1, 2, modes)
    else:
      if syntax.ast_node_text_is(source, tokens, callee, "bool.not"):
        builtin_state(1, argument, 1, 1, 1, modes)
      else:
        if syntax.ast_node_text_is(source, tokens, callee, "bool.and") || syntax.ast_node_text_is(source, tokens, callee, "bool.or"):
          builtin_state(1, argument, 1, 1, 2, modes)
        else:
          if syntax.ast_node_text_is(source, tokens, callee, "u8.to_i64"):
            builtin_state(1, argument, 2, 3, 1, modes)
          else:
            if syntax.ast_node_text_is(source, tokens, callee, "i64.to_u8"):
              builtin_state(1, argument, 3, 2, 1, modes)
            else:
              if syntax.ast_node_text_is(source, tokens, callee, "bytes.len"):
                builtin_state(1, argument, 4, 3, 1, modes)
              else:
                if syntax.ast_node_text_is(source, tokens, callee, "bytes.get"):
                  builtin_state(2, argument, 4, 2, 2, modes)
                else:
                  if syntax.ast_node_text_is(source, tokens, callee, "bytes.freeze"):
                    builtin_state(9, argument, -1, 4, 1, modes)
                  else:
                    if syntax.ast_node_text_is(source, tokens, callee, "io.print_i64"):
                      builtin_state(1, argument, 3, 0, 1, modes)
                    else:
                      if syntax.ast_node_text_is(source, tokens, callee, "io.print_bytes") || syntax.ast_node_text_is(source, tokens, callee, "io.println"):
                        builtin_state(1, argument, 4, 0, 1, modes)
                      else:
                        if syntax.ast_node_text_is(source, tokens, callee, "io.read_file"):
                          builtin_state(10, argument, 4, 1, 2, modes)
                        else:
                          if syntax.ast_node_text_is(source, tokens, callee, "io.tcp_exchange"):
                            builtin_state(11, argument, 4, 1, 6, modes)
                          else:
                            if syntax.ast_node_text_is(source, tokens, callee, "io.monotonic_ms"):
                              builtin_state(100, argument, -1, 3, 0, modes)
                            else:
                              if syntax.ast_node_text_is(source, tokens, callee, "vec.new"):
                                builtin_state(101, argument, -1, -1, 0, modes)
                              else:
                                if syntax.ast_node_text_is(source, tokens, callee, "arena.new"):
                                  builtin_state(102, argument, -1, -1, 0, modes)
                                else:
                                  if syntax.ast_node_text_is(source, tokens, callee, "vec.len"):
                                    builtin_state(3, argument, -1, 3, 1, modes)
                                  else:
                                    if syntax.ast_node_text_is(source, tokens, callee, "vec.get"):
                                      builtin_state(4, argument, -1, -1, 2, modes)
                                    else:
                                      if syntax.ast_node_text_is(source, tokens, callee, "vec.push"):
                                        builtin_state(5, argument, -1, 0, 2, modes)
                                      else:
                                        if syntax.ast_node_text_is(source, tokens, callee, "vec.set"):
                                          builtin_state(6, argument, -1, 0, 3, modes)
                                        else:
                                          if syntax.ast_node_text_is(source, tokens, callee, "arena.add"):
                                            builtin_state(7, argument, -1, -1, 2, modes)
                                          else:
                                            builtin_state(8, argument, -1, -1, 2, modes)

fn reserve_builtin_operand(source: Bytes, tokens: Vec[syntax.Token], expr: I64, state: BuiltinState, bindings: @Vec[Binding], issues: @Vec[Issue]) -> BuiltinNext effects[alloc, partial]:
  let owner: I64 = value_borrow_owner(source, tokens, state.argument, bindings)
  let allowed: Bool = check_argument_overlap(tokens, state.argument, owner, expr, false, false, @bindings, @issues, false)
  let reserved: BuiltinState = BuiltinState(operation: state.operation, phase: state.phase, argument: state.argument, kind: state.kind, result_kind: state.result_kind, count: state.count, element: state.element, valid: state.valid, modes_valid: state.modes_valid, allowed: allowed, before: vec.len(issues), result: state.result)
  builtin_child(reserved, -1)

fn finish_builtin_operand(source: Bytes, tokens: Vec[syntax.Token], expr: I64, state: BuiltinState, actual: TypeRef, bindings: @Vec[Binding], issues: @Vec[Issue]) -> Void effects[alloc, partial]:
  if state.allowed && (type_valid(actual) && (vec.len(issues) == state.before)):
    let owner: I64 = value_borrow_owner(source, tokens, state.argument, bindings)
    let registered: Bool = check_argument_overlap(tokens, state.argument, owner, expr, false, false, @bindings, @issues, true)
    void
  else:
    void

fn prepare_replacement(tokens: Vec[syntax.Token], source: Bytes, expr: I64, argument: I64, issues: @Vec[Issue]) -> BuiltinNext effects[alloc, partial]:
  let state: BuiltinState = builtin_state(12, argument, -1, -1, 2, true)
  if expect_arity(tokens, argument, 2, syntax.ast_call_callee(expr), @issues):
    let value: I64 = syntax.ast_next(tokens, argument)
    let root: I64 = replacement_root(source, tokens, argument)
    if root < 0:
      append_ownership_issue("E0348", argument, @issues)
      complete_builtin(state, expr, invalid_type(expr))
    else:
      let place_mode: Bool = syntax.ast_argument_mode(tokens, argument) == 1
      let value_mode: Bool = syntax.ast_argument_mode(tokens, value) == 0
      if place_mode:
        void
      else:
        append_ownership_issue("E0360", argument, @issues)
      if value_mode:
        void
      else:
        append_ownership_issue("E0360", value, @issues)
      let prepared: BuiltinState = BuiltinState(operation: 12, phase: 0, argument: argument, kind: -1, result_kind: -1, count: 2, element: root, valid: place_mode && value_mode, modes_valid: true, allowed: true, before: vec.len(issues), result: invalid_type(expr))
      builtin_child(prepared, -1)
  else:
    complete_builtin(state, expr, invalid_type(expr))

fn prepare_builtin(source: Bytes, tokens: Vec[syntax.Token], expr: I64, expected: I64, bindings: @Vec[Binding], issues: @Vec[Issue]) -> BuiltinNext effects[alloc, partial]:
  let structure: control.Invocation = control.invocation(expr, false)
  if syntax.ast_node_text_is(source, tokens, structure.callee, "mem.replace"):
    prepare_replacement(tokens, source, expr, structure.arguments, @issues)
  else:
    # Shape classification reads only the validated callee and emits no issue.
    # Every mode/capability diagnostic still precedes the arity and child checks.
    let shape: BuiltinState = builtin_shape(source, tokens, structure.callee, structure.arguments, true)
    let modes: Bool = check_builtin_argument_modes(tokens, shape.operation, structure.arguments, 0, bindings, @issues)
    let state: BuiltinState = builtin_state(shape.operation, shape.argument, shape.kind, shape.result_kind, shape.count, modes)
    if state.operation >= 101:
      let actual: TypeRef = infer_collection_new(source, tokens, expr, structure.arguments, expected, state.operation - 101, @issues)
      complete_builtin(state, expr, actual)
    else:
      if state.operation == 100:
        let actual: TypeRef = infer_zero_scalar_builtin(tokens, expr, structure.arguments, state.result_kind, @issues)
        complete_builtin(state, expr, actual)
      else:
        if expect_arity(tokens, structure.arguments, state.count, structure.callee, @issues):
          if (state.operation >= 3) && (state.operation <= 8):
            reserve_builtin_operand(source, tokens, expr, state, @bindings, @issues)
          else:
            builtin_child(state, -1)
        else:
          complete_builtin(state, expr, invalid_type(expr))

fn finish_scalar_operand(tokens: Vec[syntax.Token], frame: Pending, actual: TypeRef, issues: @Vec[Issue]) -> Bool effects[alloc, partial]:
  let structure: control.Invocation = control.invocation(frame.expr, false)
  let argument: I64 = if frame.phase >= 16:
    let first: control.Member = control.member(tokens, structure.arguments, false)
    first.next
  else:
    structure.arguments
  expect_kind(actual, frame.type, argument, @issues)

fn finish_scalar_builtin(source: Bytes, tokens: Vec[syntax.Token], expr: I64, state: BuiltinState, actual: TypeRef, bindings: @Vec[Binding], issues: @Vec[Issue]) -> BuiltinNext effects[alloc, partial]:
  let current: Bool = expect_kind(actual, state.kind, state.argument, @issues)
  let valid: Bool = state.valid && current
  let phase: I64 = state.phase + 1
  let argument: control.Member = control.member(tokens, state.argument, false)
  let kind: I64 = if (state.operation == 11) && (phase == 2):
    4
  else:
    3
  let next: BuiltinState = advance_builtin(state, phase, argument.next, kind, -1, valid, actual)
  if phase == (state.count - 1):
    reserve_builtin_operand(source, tokens, expr, next, @bindings, @issues)
  else:
    builtin_child(next, -1)

fn finish_collection_builtin(source: Bytes, tokens: Vec[syntax.Token], expr: I64, state: BuiltinState, actual: TypeRef, bindings: @Vec[Binding], issues: @Vec[Issue]) -> BuiltinNext effects[alloc, partial]:
  finish_builtin_operand(source, tokens, expr, state, actual, @bindings, @issues)
  let constructor: I64 = if state.operation >= 7:
    1
  else:
    0
  if result_is_composite(source, tokens, actual, constructor):
    let element: I64 = actual.form + 2
    if state.operation == 3:
      complete_builtin(state, expr, scalar_type(3, expr))
    else:
      let argument: control.Member = control.member(tokens, state.argument, false)
      let next: BuiltinState = advance_builtin(state, 1, argument.next, 3, element, true, actual)
      let expected: I64 = if (state.operation == 5) || (state.operation == 7):
        element
      else:
        -1
      builtin_child(next, expected)
  else:
    record_issue("E0344", state.argument, @issues)
    complete_builtin(state, expr, invalid_type(expr))

fn finish_collection_value(source: Bytes, tokens: Vec[syntax.Token], expr: I64, expected: I64, state: BuiltinState, actual: TypeRef, bindings: @Vec[Binding], issues: @Vec[Issue], scopes: @Vec[ownership.Scope], frames: @Vec[ownership.Frame]) -> BuiltinNext effects[alloc, partial]:
  if (state.operation == 4) || ((state.operation == 6) && (state.phase == 1)):
    let index_ok: Bool = expect_kind(actual, 3, state.argument, @issues)
    if state.operation == 4:
      let result: TypeRef = if index_ok:
        source_type(source, tokens, state.element)
      else:
        invalid_type(expr)
      complete_builtin(state, expr, result)
    else:
      let argument: control.Member = control.member(tokens, state.argument, false)
      let next: BuiltinState = advance_builtin(state, 2, argument.next, -1, state.element, index_ok, actual)
      builtin_child(next, state.element)
  else:
    if state.operation == 8:
      let id_ok: Bool = result_is_composite(source, tokens, actual, 2)
      let same_inner: Bool = if id_ok:
        type_forms_equal(source, tokens, state.element, actual.form + 2)
      else:
        false
      if same_inner:
        complete_builtin(state, expr, source_type(source, tokens, state.element))
      else:
        record_issue("E0344", state.argument, @issues)
        complete_builtin(state, expr, invalid_type(expr))
    else:
      let value_valid: Bool = type_valid(actual)
      let moved: Bool = check_storage_move(source, tokens, state.argument, state.element, @bindings, @issues, @scopes, @frames)
      if state.operation == 7:
        let contextual: Bool = expected >= 0
        let expected_type: TypeRef = if contextual:
          source_type(source, tokens, expected)
        else:
          invalid_type(expr)
        let id_ok: Bool = if contextual:
          result_is_composite(source, tokens, expected_type, 2)
        else:
          false
        let same_inner: Bool = if id_ok:
          type_forms_equal(source, tokens, state.element, syntax.ast_type_argument(expected))
        else:
          false
        if value_valid && (moved && same_inner):
          complete_builtin(state, expr, expected_type)
        else:
          record_issue("E0344", expr, @issues)
          complete_builtin(state, expr, invalid_type(expr))
      else:
        let result: TypeRef = if state.valid && (value_valid && moved):
          scalar_type(0, expr)
        else:
          invalid_type(expr)
        complete_builtin(state, expr, result)

fn finish_byte_vector(source: Bytes, tokens: Vec[syntax.Token], expr: I64, state: BuiltinState, actual: TypeRef, bindings: @Vec[Binding], issues: @Vec[Issue], scopes: @Vec[ownership.Scope], frames: @Vec[ownership.Frame]) -> BuiltinNext effects[alloc, partial]:
  if state.operation == 9:
    void
  else:
    finish_builtin_operand(source, tokens, expr, state, actual, @bindings, @issues)
  let vector_ok: Bool = result_is_composite(source, tokens, actual, 0)
  let inner_kind: I64 = if vector_ok:
    syntax.scalar_type_kind(source, tokens, actual.form + 2)
  else:
    -1
  let valid: Bool = state.valid && (vector_ok && (inner_kind == 2))
  if valid:
    if state.operation == 9:
      let moved: Bool = check_owned_value(source, tokens, state.argument, false, @bindings, @issues, @scopes, @frames)
      let result: TypeRef = if moved:
        scalar_type(4, expr)
      else:
        invalid_type(expr)
      complete_builtin(state, expr, result)
    else:
      complete_builtin(state, expr, scalar_type(1, expr))
  else:
    record_issue("E0344", state.argument, @issues)
    complete_builtin(state, expr, invalid_type(expr))

fn finish_replacement(source: Bytes, tokens: Vec[syntax.Token], expr: I64, state: BuiltinState, actual: TypeRef, bindings: @Vec[Binding], issues: @Vec[Issue], scopes: @Vec[ownership.Scope], frames: @Vec[ownership.Frame]) -> BuiltinNext effects[alloc, partial]:
  if state.phase == 0:
    let affine: Bool = type_valid(actual) && (memory.type_storage_kind(source, tokens, actual.form) == 2)
    let mode: I64 = named_binding_mode(tokens, state.element, bindings)
    let owner: I64 = value_borrow_owner(source, tokens, state.element, bindings)
    let capable: Bool = (mode == 0) || (mode == 2)
    let known: Bool = owner >= 2
    if !affine:
      record_issue("E0344", state.argument, @issues)
    else:
      void
    if !(capable && known):
      append_ownership_issue("E0347", state.argument, @issues)
    else:
      void
    let valid_place: Bool = state.valid && (affine && (capable && (known && (state.before == vec.len(issues)))))
    if valid_place:
      let loan: Bool = check_loan_overlap(tokens, state.argument, 1, owner, expr, false, false, @bindings, @issues, true)
      if loan:
        let argument: control.Member = control.member(tokens, state.argument, false)
        let next: BuiltinState = advance_builtin(state, 1, argument.next, -1, actual.form, true, actual)
        builtin_child(next, actual.form)
      else:
        complete_builtin(state, expr, invalid_type(expr))
    else:
      complete_builtin(state, expr, invalid_type(expr))
  else:
    let transferred: Bool = check_storage_move(source, tokens, state.argument, state.element, @bindings, @issues, @scopes, @frames)
    let result: TypeRef = if type_valid(actual) && transferred:
      state.result
    else:
      invalid_type(expr)
    complete_builtin(state, expr, result)

fn finish_builtin(source: Bytes, tokens: Vec[syntax.Token], expr: I64, expected: I64, state: BuiltinState, actual: TypeRef, bindings: @Vec[Binding], issues: @Vec[Issue], scopes: @Vec[ownership.Scope], frames: @Vec[ownership.Frame]) -> BuiltinNext effects[alloc, partial]:
  if state.operation == 12:
    finish_replacement(source, tokens, expr, state, actual, @bindings, @issues, @scopes, @frames)
  else:
    if (state.operation == 9) || (((state.operation == 10) || (state.operation == 11)) && (state.phase == (state.count - 1))):
      finish_byte_vector(source, tokens, expr, state, actual, @bindings, @issues, @scopes, @frames)
    else:
      if state.operation >= 10:
        finish_scalar_builtin(source, tokens, expr, state, actual, @bindings, @issues)
      else:
        if state.phase == 0:
          finish_collection_builtin(source, tokens, expr, state, actual, @bindings, @issues)
        else:
          finish_collection_value(source, tokens, expr, expected, state, actual, @bindings, @issues, @scopes, @frames)

fn push_builtin(state: BuiltinState, depth: I64, limit: I64, builtins: @Vec[BuiltinState]) -> I64 effects[alloc, partial]:
  let permitted: I64 = if (depth >= 0) && (depth < limit):
    1
  else:
    0
  let at: I64 = depth / permitted
  if at < vec.len(builtins):
    vec.set(@builtins, at, state)
  else:
    vec.push(@builtins, state)
  at


fn replacement_root(source: Bytes, tokens: Vec[syntax.Token], place: I64) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, place)
  if kind == 2:
    place
  else:
    if (kind == 0) && syntax.ast_expression_is_get(source, tokens, place):
      recur(source, tokens, syntax.ast_get_value(place))
    else:
      -1

# Aggregate lists advance in canonical order. Like the baseline terminal-recur
# loops, completion depends on matching list ends/names, while every inferred
# member still performs its storage-transfer check, including rejected children.
struct Members:
  cursor: I64
  definition: I64

struct MemberNext:
  done: Bool
  value: I64
  expected: I64
  result: TypeRef

fn prepare_members(source: Bytes, tokens: @Vec[syntax.Token], expr: I64, record: Bool, issues: @Vec[Issue]) -> Members effects[alloc, partial]:
  let structure: control.Construction = control.construction(tokens, expr, record)
  let item: I64 = linked_item(tokens, structure.type)
  let kind: I64 = if record:
    1
  else:
    2
  if item_has_kind(source, tokens, item, kind):
    let definitions: I64 = syntax.ast_data_members_first(item)
    if record:
      Members(cursor: structure.members, definition: definitions)
    else:
      let case_form: I64 = find_named_form(source, tokens, definitions, structure.name)
      if case_form >= 0:
        syntax.ast_node_set_link(@tokens, expr, case_form)
        Members(cursor: structure.members, definition: syntax.ast_member_value(case_form))
      else:
        record_issue("E0352", structure.name, @issues)
        Members(cursor: -1, definition: -1)
  else:
    record_issue("E0352", structure.type, @issues)
    Members(cursor: -1, definition: -1)

fn next_member(source: Bytes, tokens: @Vec[syntax.Token], frame: Pending, issues: @Vec[Issue]) -> MemberNext effects[alloc, partial]:
  if frame.type < 0:
    MemberNext(done: true, value: frame.expr, expected: -1, result: invalid_type(frame.expr))
  else:
    let record: Bool = frame.phase == 8
    let structure: control.Construction = control.construction(tokens, frame.expr, record)
    let cursor_done: Bool = syntax.ast_list_done(tokens, frame.type)
    let definition_done: Bool = syntax.ast_list_done(tokens, frame.before)
    if cursor_done || definition_done:
      if cursor_done && definition_done:
        MemberNext(done: true, value: frame.expr, expected: -1, result: source_type(source, tokens, structure.type))
      else:
        record_issue("E0351", structure.name, @issues)
        MemberNext(done: true, value: frame.expr, expected: -1, result: invalid_type(frame.expr))
    else:
      let provided: control.Member = control.member(tokens, frame.type, record)
      let definition: control.Member = control.member(tokens, frame.before, record)
      let same_name: Bool = if record:
        syntax.spans_equal(source, syntax.ast_node_start(tokens, provided.name), syntax.ast_node_end(tokens, provided.name), syntax.ast_node_start(tokens, definition.name), syntax.ast_node_end(tokens, definition.name))
      else:
        true
      if same_name:
        if record:
          syntax.ast_node_set_link(@tokens, frame.type, frame.before)
        else:
          void
        MemberNext(done: false, value: provided.value, expected: definition.value, result: invalid_type(frame.expr))
      else:
        record_issue("E0352", provided.name, @issues)
        MemberNext(done: true, value: frame.expr, expected: -1, result: invalid_type(frame.expr))

fn project_value(source: Bytes, tokens: Vec[syntax.Token], expr: I64, owner: TypeRef, issues: @Vec[Issue]) -> TypeRef effects[alloc, partial]:
  let structure: control.Projection = control.projection(tokens, expr)
  let value: I64 = structure.value
  let field: I64 = structure.field
  let source_type: Bool = owner.kind == -1
  if source_type:
    let item: I64 = linked_item(tokens, owner.form)
    let record: Bool = item_has_kind(source, tokens, item, 1)
    if record:
      let definition: I64 = find_named_form(source, tokens, syntax.ast_data_members_first(item), field)
      let known: Bool = definition >= 0
      if known:
        source_type(source, tokens, syntax.ast_member_value(definition))
      else:
        record_issue("E0352", field, @issues)
        invalid_type(expr)
    else:
      record_issue("E0344", value, @issues)
      invalid_type(expr)
  else:
    record_issue("E0344", value, @issues)
    invalid_type(expr)

fn bind_payload_names(source: Bytes, tokens: @Vec[syntax.Token], name: I64, type: I64, source_mode: I64, source_owner: I64, parent: I64, case_name: I64, arm: I64, bindings: @Vec[Binding], issues: @Vec[Issue]) -> I64 effects[alloc, partial]:
  let name_kind: I64 = syntax.ast_node_kind(tokens, name)
  let type_kind: I64 = syntax.ast_node_kind(tokens, type)
  let names_done: Bool = name_kind == 1
  let types_done: Bool = type_kind == 1
  let either_done: Bool = names_done || types_done
  if either_done:
    let both: Bool = names_done && types_done
    if both:
      parent
    else:
      record_issue("E0351", case_name, @issues)
      -2
  else:
    let mutable: Bool = syntax.ast_pattern_name_is_mutable(tokens, name)
    let storage: I64 = memory.type_storage_kind(source, tokens, type)
    let affine: Bool = storage == 2
    let borrowed: Bool = affine && (source_mode > 0)
    let mode: I64 = if borrowed:
      1
    else:
      0
    let owner: I64 = if mode > 0:
      source_owner
    else:
      -1
    let loan_valid: Bool = if borrowed:
      check_loan_overlap(tokens, name, 0, source_owner, arm, false, false, @bindings, @issues, true)
    else:
      true
    if loan_valid:
      let next_parent: I64 = add_binding(@tokens, name, type, mode, owner, mutable, parent, @bindings)
      let next_name: I64 = syntax.ast_next(tokens, name)
      let next_type: I64 = syntax.ast_next(tokens, type)
      recur(source, @tokens, next_name, next_type, source_mode, source_owner, next_parent, case_name, arm, @bindings, @issues)
    else:
      -2

fn case_name_matches(source: Bytes, tokens: Vec[syntax.Token], case_form: I64, pattern: I64) -> Bool effects[partial]:
  let declared: I64 = syntax.ast_member_name(case_form)
  let declared_start: I64 = syntax.ast_node_start(tokens, declared)
  let declared_end: I64 = syntax.ast_node_end(tokens, declared)
  let pattern_start: I64 = syntax.ast_node_start(tokens, pattern)
  let pattern_end: I64 = syntax.ast_node_end(tokens, pattern)
  syntax.spans_equal(source, declared_start, declared_end, pattern_start, pattern_end)

fn ordered_arm_parent(source: Bytes, tokens: @Vec[syntax.Token], cursor: I64, case_cursor: I64, pattern: I64, boolean_match: Bool, source_mode: I64, source_owner: I64, parent: I64, bindings: @Vec[Binding], issues: @Vec[Issue]) -> I64 effects[alloc, partial]:
  if boolean_match:
    parent
  else:
    let same: Bool = case_name_matches(source, tokens, case_cursor, pattern)
    if same:
      syntax.ast_node_set_link(@tokens, cursor, case_cursor)
      let payload_type: I64 = syntax.ast_member_value(case_cursor)
      let payload_kind: I64 = syntax.ast_node_kind(tokens, payload_type)
      let empty: Bool = payload_kind == 1
      if empty:
        parent
      else:
        let names_form: I64 = syntax.ast_arm_bindings(tokens, cursor)
        bind_payload_names(source, @tokens, syntax.ast_list_first(names_form), payload_type, source_mode, source_owner, parent, pattern, cursor, @bindings, @issues)
    else:
      record_issue("E0352", pattern, @issues)
      -2

fn empty_branch(expr: I64) -> BranchState:
  BranchState(variant: -2, cursor: -1, case_cursor: -1, source_mode: -1, source_owner: -1, branch_scope: -1, enclosing_scope: -1, first: invalid_type(expr), has_first: false, seen_true: false, seen_false: false, move_valid: false, arm_scope: -1)

fn prepare_branch(source: Bytes, tokens: Vec[syntax.Token], expr: I64, scrutinee: TypeRef, bindings: @Vec[Binding], issues: @Vec[Issue], scopes: @Vec[ownership.Scope], frames: @Vec[ownership.Frame]) -> BranchState effects[alloc, partial]:
  let structure: control.Branch = control.branch(tokens, expr)
  let value: I64 = structure.value
  let source_mode: I64 = value_borrow_mode(source, tokens, value, bindings)
  let source_owner: I64 = if source_mode > 0:
    value_borrow_owner(source, tokens, value, bindings)
  else:
    -1
  let boolean_match: Bool = scrutinee.kind == 1
  let if_form: Bool = syntax.ast_expression_is_if(tokens, expr)
  let familiar_match: Bool = syntax.ast_expression_is_familiar_match(tokens, expr)
  let familiar_control: Bool = if_form || familiar_match
  let familiar_kind_valid: Bool = if if_form:
    boolean_match
  else:
    !boolean_match
  let control_kind_valid: Bool = if familiar_control:
    familiar_kind_valid
  else:
    true
  let variant_item: I64 = if boolean_match:
    -1
  else:
    linked_item(tokens, scrutinee.form)
  let variant_shape: Bool = if boolean_match:
    true
  else:
    item_has_kind(source, tokens, variant_item, 2)
  let variant: Bool = control_kind_valid && variant_shape
  if variant:
    let affine: Bool = if boolean_match:
      false
    else:
      memory.type_storage_kind(source, tokens, scrutinee.form) == 2
    let move_valid: Bool = if affine && (source_mode == 0):
      mark_result_move(source, tokens, value, @bindings, @issues, @scopes, @frames)
    else:
      true
    let first_arm: I64 = structure.arms
    let first_case: I64 = if boolean_match:
      -1
    else:
      syntax.ast_data_members_first(variant_item)
    let enclosing_scope: I64 = ownership.current(scopes)
    let arm_count: I64 = control.arm_count(tokens, first_arm, 0)
    let branch_scope: I64 = ownership.begin(@scopes, arm_count)
    BranchState(variant: variant_item, cursor: first_arm, case_cursor: first_case, source_mode: source_mode, source_owner: source_owner, branch_scope: branch_scope, enclosing_scope: enclosing_scope, first: invalid_type(expr), has_first: false, seen_true: false, seen_false: false, move_valid: move_valid, arm_scope: -1)
  else:
    record_issue("E0344", value, @issues)
    empty_branch(expr)

fn push_branch(state: BranchState, depth: I64, limit: I64, branches: @Vec[BranchState]) -> I64 effects[alloc, partial]:
  let permitted: I64 = if (depth >= 0) && (depth < limit):
    1
  else:
    0
  let checked_depth: I64 = depth / permitted
  if checked_depth > 0:
    let at: I64 = checked_depth - 1
    if at < vec.len(branches):
      vec.set(@branches, at, state)
    else:
      vec.push(@branches, state)
  else:
    void
  checked_depth + 1

fn end_branch(frame: Pending, state: BranchState, actual: TypeRef, scopes: @Vec[ownership.Scope]) -> BranchNext effects[partial]:
  ownership.end(@scopes, state.branch_scope, state.enclosing_scope)
  let result: TypeRef = if !state.move_valid:
    invalid_type(frame.expr)
  else:
    actual
  BranchNext(state: state, done: true, body: frame.expr, parent: frame.parent, result: result)

fn next_branch_arm(source: Bytes, tokens: @Vec[syntax.Token], frame: Pending, state: BranchState, bindings: @Vec[Binding], issues: @Vec[Issue], scopes: @Vec[ownership.Scope]) -> BranchNext effects[alloc, partial]:
  let arms_done: Bool = syntax.ast_node_kind(tokens, state.cursor) == 1
  let boolean_match: Bool = state.variant < 0
  let cases_done: Bool = if boolean_match:
    true
  else:
    syntax.ast_node_kind(tokens, state.case_cursor) == 1
  if arms_done:
    let exact: Bool = if boolean_match:
      state.seen_true && state.seen_false
    else:
      cases_done
    let actual: TypeRef = if exact:
      state.first
    else:
      record_issue("E0351", syntax.ast_expression_marker(frame.expr), @issues)
      invalid_type(frame.expr)
    end_branch(frame, state, actual, @scopes)
  else:
    if (!boolean_match) && cases_done:
      record_issue("E0351", syntax.ast_expression_marker(frame.expr), @issues)
      end_branch(frame, state, invalid_type(frame.expr), @scopes)
    else:
      let structure: control.Arm = control.arm(tokens, state.cursor)
      let pattern: I64 = structure.pattern
      let true_pattern: Bool = if boolean_match:
        syntax.ast_node_text_is(source, tokens, pattern, "true")
      else:
        false
      let false_pattern: Bool = if boolean_match:
        syntax.ast_node_text_is(source, tokens, pattern, "false")
      else:
        false
      let pattern_known: Bool = if boolean_match:
        true_pattern || false_pattern
      else:
        case_name_matches(source, tokens, state.case_cursor, pattern)
      let duplicate: Bool = (true_pattern && state.seen_true) || (false_pattern && state.seen_false)
      let pattern_valid: Bool = pattern_known && (!duplicate)
      let pattern_code: Bytes = if boolean_match:
        "E0335"
      else:
        "E0352"
      if pattern_valid:
        void
      else:
        record_issue(pattern_code, pattern, @issues)
      let arm_parent: I64 = ordered_arm_parent(source, @tokens, state.cursor, state.case_cursor, pattern, boolean_match, state.source_mode, state.source_owner, frame.parent, @bindings, @issues)
      # The branch remains current between source arms, including after a nested
      # branch finishes. Payload binding above precedes the availability scope.
      let arm_scope: I64 = ownership.begin(@scopes, 0)
      let next: BranchState = BranchState(variant: state.variant, cursor: state.cursor, case_cursor: state.case_cursor, source_mode: state.source_mode, source_owner: state.source_owner, branch_scope: state.branch_scope, enclosing_scope: state.enclosing_scope, first: state.first, has_first: state.has_first, seen_true: state.seen_true || true_pattern, seen_false: state.seen_false || false_pattern, move_valid: state.move_valid, arm_scope: arm_scope)
      BranchNext(state: next, done: false, body: structure.body, parent: arm_parent, result: invalid_type(structure.body))

fn finish_branch_arm(source: Bytes, tokens: Vec[syntax.Token], frame: Pending, actual: TypeRef, state: BranchState, issues: @Vec[Issue], scopes: @Vec[ownership.Scope]) -> BranchState effects[alloc, partial]:
  let structure: control.Arm = control.arm(tokens, state.cursor)
  ownership.end(@scopes, state.arm_scope, state.branch_scope)
  let same_type: Bool = if state.has_first && (frame.expected < 0):
    types_equal(source, tokens, state.first, actual)
  else:
    true
  if same_type:
    void
  else:
    record_issue("E0344", structure.body, @issues)
  let first: TypeRef = if state.has_first:
    state.first
  else:
    actual
  let next_case: I64 = if state.variant < 0:
    -1
  else:
    syntax.ast_next(tokens, state.case_cursor)
  let next: BranchState = BranchState(variant: state.variant, cursor: structure.next, case_cursor: next_case, source_mode: state.source_mode, source_owner: state.source_owner, branch_scope: state.branch_scope, enclosing_scope: state.enclosing_scope, first: first, has_first: true, seen_true: state.seen_true, seen_false: state.seen_false, move_valid: state.move_valid, arm_scope: -1)
  next

fn bind_value(source: Bytes, tokens: @Vec[syntax.Token], expr: I64, parent: I64, value_type: TypeRef, bindings: @Vec[Binding], issues: @Vec[Issue], scopes: @Vec[ownership.Scope], frames: @Vec[ownership.Frame]) -> BoundValue effects[alloc, partial]:
  let structure: control.Binding = control.binding(tokens, expr)
  let name: I64 = structure.name
  let type: I64 = structure.type
  let value: I64 = structure.value
  let statement: Bool = syntax.ast_expression_is_statement(tokens, expr)
  let stored_void: Bool = (!statement) && type_contains_void(source, tokens, type)
  let value_void: Bool = type_valid(value_type) && (value_type.kind == 0)
  let discarded: Bool = statement && (!value_void)
  if stored_void:
    record_issue("E0358", type, @issues)
  else:
    void
  if discarded:
    record_issue("E0357", value, @issues)
  else:
    void
  let mutable: Bool = syntax.ast_let_is_mutable(source, tokens, expr)
  let storage: I64 = memory.type_storage_kind(source, tokens, type)
  let affine: Bool = storage == 2
  let source_mode: I64 = value_borrow_mode(source, tokens, value, bindings)
  let borrowed: Bool = affine && (source_mode > 0)
  let mode: I64 = if borrowed:
    1
  else:
    0
  let owner: I64 = if borrowed:
    value_borrow_owner(source, tokens, value, bindings)
  else:
    -1
  let move_valid: Bool = if affine && (!borrowed):
    mark_result_move(source, tokens, value, @bindings, @issues, @scopes, @frames)
  else:
    true
  let loan_valid: Bool = if borrowed && type_valid(value_type):
    check_argument_overlap(tokens, value, owner, expr, false, false, @bindings, @issues, true)
  else:
    true
  let next_parent: I64 = add_binding(@tokens, name, type, mode, owner, mutable, parent, @bindings)
  let value_valid: Bool = type_valid(value_type)
  let placement_valid: Bool = !(stored_void || discarded)
  let valid: Bool = placement_valid && (move_valid && (loan_valid && value_valid))
  BoundValue(parent: next_parent, valid: valid)

fn prepare_set(source: Bytes, tokens: Vec[syntax.Token], expr: I64, parent: I64, bindings: Vec[Binding], issues: @Vec[Issue]) -> AssignmentTarget effects[alloc, partial]:
  let structure: control.Assignment = control.assignment(tokens, expr)
  let name: I64 = structure.name
  let type: I64 = find_binding_type(source, tokens, bindings, parent, name)
  let found: Bool = type >= 0
  if found:
    let familiar: Bool = syntax.ast_assignment_is_familiar(tokens, expr)
    let declared_mutable: Bool = find_binding_mutable(tokens, bindings, name)
    let mutable: Bool = (!familiar) || declared_mutable
    if mutable:
      let affine: Bool = memory.type_storage_kind(source, tokens, type) == 2
      let binding_index: I64 = linked_binding_index(tokens, name)
      let loan: Bool = if affine && (binding_index >= 0):
        named_loan_conflict(tokens, bindings, binding_index, name, true)
      else:
        false
      if loan:
        record_issue("E0349", name, @issues)
        AssignmentTarget(type: -1, affine: false)
      else:
        AssignmentTarget(type: type, affine: affine)
    else:
      record_issue("E0359", name, @issues)
      AssignmentTarget(type: -1, affine: false)
  else:
    record_issue("E0314", name, @issues)
    AssignmentTarget(type: -1, affine: false)

fn assign_value(source: Bytes, tokens: Vec[syntax.Token], frame: Pending, value_type: TypeRef, bindings: @Vec[Binding], issues: @Vec[Issue], scopes: @Vec[ownership.Scope], frames: @Vec[ownership.Frame]) -> Bool effects[alloc, partial]:
  let structure: control.Assignment = control.assignment(tokens, frame.expr)
  let binding_index: I64 = linked_binding_index(tokens, structure.name)
  let move_valid: Bool = check_storage_move(source, tokens, structure.value, frame.type, @bindings, @issues, @scopes, @frames)
  if frame.valid && ((binding_index >= 0) && (move_valid && (type_valid(value_type) && (frame.before == vec.len(issues))))):
    reinitialize_binding(@bindings, binding_index, @scopes, @frames)
  else:
    void
  move_valid && type_valid(value_type)

# A live frame names a distinct suspended canonical expression ancestor. Hence
# depth is less than the root subtree's canonical node count before push.
# An impossible internal frame overflow traps; it cannot approve source by
# returning an invalid type without a diagnostic. Ordinary source gets no new
# configurable size ceiling. Existing runtime allocation failure stays status 71.
fn push_pending(parent: Pending, depth: I64, limit: I64, pending: @Vec[Pending]) -> I64 effects[alloc, partial]:
  let permitted: I64 = if (depth >= 0) && (depth < limit):
    1
  else:
    0
  let checked_depth: I64 = depth / permitted
  if checked_depth > 0:
    let at: I64 = checked_depth - 1
    if at < vec.len(pending):
      vec.set(@pending, at, parent)
    else:
      vec.push(@pending, parent)
  else:
    void
  checked_depth + 1

# Binding phases are initializer -> install binding -> body -> finish.
# Assignment phases are target reservation -> value -> transfer/restore -> body
# -> finish. Every child is a strict canonical descendant. Completion pops a
# frame; it never follows a runtime recurrence.
fn infer_control_walk(source: Bytes, tokens: @Vec[syntax.Token], expr: I64, expected: I64, parent: I64, params: I64, return_type: I64, returning: Bool, result: TypeRef, depth: I64, limit: I64, top: Pending, branch_depth: I64, branch_top: BranchState, argument_depth: I64, argument_top: ArgumentState, builtin_depth: I64, builtins: @Vec[BuiltinState], arguments: @Vec[ArgumentState], branches: @Vec[BranchState], pending: @Vec[Pending], bindings: @Vec[Binding], facts: @Vec[Fact], issues: @Vec[Issue], scopes: @Vec[ownership.Scope], frames: @Vec[ownership.Frame]) -> TypeRef effects[alloc, partial]:
  let failed: Bool = if returning:
    false
  else:
    issues_block_inference(issues)
  let kind: I64 = if returning || failed:
    -1
  else:
    control.expression_kind(source, tokens, expr)
  let atomic: Bool = kind == 0
  let ready: Bool = returning || (failed || atomic)
  let current_result: TypeRef = if failed:
    invalid_type(expr)
  else:
    if atomic:
      let inferred: TypeRef = infer_atom(source, tokens, expr, parent, @bindings, @issues, @scopes, @frames)
      finish_type(source, tokens, expr, expected, inferred, @facts, @issues)
    else:
      result
  if ready:
    if depth == 0:
      current_result
    else:
      let at: I64 = depth - 1
      let frame: Pending = top
      if frame.phase >= 13:
        let operand_ok: Bool = finish_scalar_operand(tokens, frame, current_result, @issues)
        let valid: Bool = frame.valid && operand_ok
        if (frame.phase == 14) || (frame.phase == 15):
          let structure: control.Invocation = control.invocation(frame.expr, false)
          let first: control.Member = control.member(tokens, structure.arguments, false)
          let kind: I64 = if frame.phase == 15:
            3
          else:
            frame.type
          let phase: I64 = if frame.phase == 15:
            17
          else:
            16
          let next_top: Pending = Pending(expr: frame.expr, expected: frame.expected, parent: frame.parent, phase: phase, valid: valid, type: kind, before: frame.before)
          recur(source, @tokens, first.next, -1, frame.parent, params, return_type, false, current_result, depth, limit, next_top, branch_depth, branch_top, argument_depth, argument_top, builtin_depth, @builtins, @arguments, @branches, @pending, @bindings, @facts, @issues, @scopes, @frames)
        else:
          let actual: TypeRef = if valid:
            scalar_type(frame.before, frame.expr)
          else:
            invalid_type(frame.expr)
          let finished: TypeRef = finish_type(source, tokens, frame.expr, frame.expected, actual, @facts, @issues)
          if at == 0:
            finished
          else:
            let enclosing: Pending = vec.get(pending, at - 1)
            recur(source, @tokens, frame.expr, frame.expected, frame.parent, params, return_type, true, finished, at, limit, enclosing, branch_depth, branch_top, argument_depth, argument_top, builtin_depth, @builtins, @arguments, @branches, @pending, @bindings, @facts, @issues, @scopes, @frames)
      else:
        if frame.phase == 12:
          let state: BuiltinState = vec.get(builtins, frame.type)
          let request: BuiltinNext = finish_builtin(source, tokens, frame.expr, frame.expected, state, current_result, @bindings, @issues, @scopes, @frames)
          if request.done:
            let finished: TypeRef = finish_type(source, tokens, frame.expr, frame.expected, request.result, @facts, @issues)
            if at == 0:
              finished
            else:
              let enclosing: Pending = vec.get(pending, at - 1)
              recur(source, @tokens, frame.expr, frame.expected, frame.parent, params, return_type, true, finished, at, limit, enclosing, branch_depth, branch_top, argument_depth, argument_top, builtin_depth - 1, @builtins, @arguments, @branches, @pending, @bindings, @facts, @issues, @scopes, @frames)
          else:
            vec.set(@builtins, frame.type, request.state)
            recur(source, @tokens, request.state.argument, request.expected, frame.parent, params, return_type, !request.state.allowed, request.result, depth, limit, top, branch_depth, branch_top, argument_depth, argument_top, builtin_depth, @builtins, @arguments, @branches, @pending, @bindings, @facts, @issues, @scopes, @frames)
        else:
          if (frame.phase == 10) || (frame.phase == 11):
            let recursive: Bool = frame.phase == 11
            let state: ArgumentState = argument_top
            let advanced: ArgumentState = finish_argument(source, tokens, frame.expr, recursive, state, frame.type, current_result, @bindings, @issues, @scopes, @frames)
            let request: ArgumentNext = next_argument(source, tokens, frame.expr, recursive, return_type, advanced, @bindings, @issues)
            if request.done:
              let kept_depth: I64 = argument_depth - 1
              let kept_argument: ArgumentState = if kept_depth > 0:
                vec.get(arguments, kept_depth - 1)
              else:
                request.state
              let finished: TypeRef = finish_type(source, tokens, frame.expr, frame.expected, request.result, @facts, @issues)
              if at == 0:
                finished
              else:
                let enclosing: Pending = vec.get(pending, at - 1)
                recur(source, @tokens, frame.expr, frame.expected, frame.parent, params, return_type, true, finished, at, limit, enclosing, branch_depth, branch_top, kept_depth, kept_argument, builtin_depth, @builtins, @arguments, @branches, @pending, @bindings, @facts, @issues, @scopes, @frames)
            else:
              let next_top: Pending = Pending(expr: frame.expr, expected: frame.expected, parent: frame.parent, phase: frame.phase, valid: true, type: request.expected, before: 0)
              recur(source, @tokens, request.state.argument, request.expected, frame.parent, params, return_type, !request.state.allowed, request.result, depth, limit, next_top, branch_depth, branch_top, argument_depth, request.state, builtin_depth, @builtins, @arguments, @branches, @pending, @bindings, @facts, @issues, @scopes, @frames)
          else:
            if (frame.phase == 8) || (frame.phase == 9):
              let record: Bool = frame.phase == 8
              let provided: control.Member = control.member(tokens, frame.type, record)
              let definition: control.Member = control.member(tokens, frame.before, record)
              let moved: Bool = check_storage_move(source, tokens, provided.value, definition.value, @bindings, @issues, @scopes, @frames)
              let advanced: Pending = Pending(expr: frame.expr, expected: frame.expected, parent: frame.parent, phase: frame.phase, valid: true, type: provided.next, before: definition.next)
              let request: MemberNext = next_member(source, @tokens, advanced, @issues)
              if request.done:
                let finished: TypeRef = finish_type(source, tokens, frame.expr, frame.expected, request.result, @facts, @issues)
                if at == 0:
                  finished
                else:
                  let enclosing: Pending = vec.get(pending, at - 1)
                  recur(source, @tokens, frame.expr, frame.expected, frame.parent, params, return_type, true, finished, at, limit, enclosing, branch_depth, branch_top, argument_depth, argument_top, builtin_depth, @builtins, @arguments, @branches, @pending, @bindings, @facts, @issues, @scopes, @frames)
              else:
                recur(source, @tokens, request.value, request.expected, frame.parent, params, return_type, false, request.result, depth, limit, advanced, branch_depth, branch_top, argument_depth, argument_top, builtin_depth, @builtins, @arguments, @branches, @pending, @bindings, @facts, @issues, @scopes, @frames)
            else:
              if (frame.phase == 4) || (frame.phase == 5):
                let state: BranchState = if frame.phase == 4:
                  prepare_branch(source, tokens, frame.expr, current_result, @bindings, @issues, @scopes, @frames)
                else:
                  finish_branch_arm(source, tokens, frame, current_result, branch_top, @issues, @scopes)
                if state.variant >= -1:
                  let next_depth: I64 = if frame.phase == 4:
                    push_branch(branch_top, branch_depth, limit, @branches)
                  else:
                    branch_depth
                  let request: BranchNext = next_branch_arm(source, @tokens, frame, state, @bindings, @issues, @scopes)
                  if request.done:
                    let kept_depth: I64 = next_depth - 1
                    let kept_branch: BranchState = if kept_depth > 0:
                      vec.get(branches, kept_depth - 1)
                    else:
                      request.state
                    let finished: TypeRef = finish_type(source, tokens, frame.expr, frame.expected, request.result, @facts, @issues)
                    if at == 0:
                      finished
                    else:
                      let enclosing: Pending = vec.get(pending, at - 1)
                      recur(source, @tokens, frame.expr, frame.expected, frame.parent, params, return_type, true, finished, at, limit, enclosing, kept_depth, kept_branch, argument_depth, argument_top, builtin_depth, @builtins, @arguments, @branches, @pending, @bindings, @facts, @issues, @scopes, @frames)
                  else:
                    let next_top: Pending = Pending(expr: frame.expr, expected: frame.expected, parent: frame.parent, phase: 5, valid: true, type: -1, before: 0)
                    recur(source, @tokens, request.body, frame.expected, request.parent, params, return_type, false, request.result, depth, limit, next_top, next_depth, request.state, argument_depth, argument_top, builtin_depth, @builtins, @arguments, @branches, @pending, @bindings, @facts, @issues, @scopes, @frames)
                else:
                  let finished: TypeRef = finish_type(source, tokens, frame.expr, frame.expected, invalid_type(frame.expr), @facts, @issues)
                  if at == 0:
                    finished
                  else:
                    let enclosing: Pending = vec.get(pending, at - 1)
                    recur(source, @tokens, frame.expr, frame.expected, frame.parent, params, return_type, true, finished, at, limit, enclosing, branch_depth, branch_top, argument_depth, argument_top, builtin_depth, @builtins, @arguments, @branches, @pending, @bindings, @facts, @issues, @scopes, @frames)
              else:
                if frame.phase == 0:
                  let bound: BoundValue = bind_value(source, @tokens, frame.expr, frame.parent, current_result, @bindings, @issues, @scopes, @frames)
                  let structure: control.Binding = control.binding(tokens, frame.expr)
                  let next_top: Pending = Pending(expr: frame.expr, expected: frame.expected, parent: bound.parent, phase: 1, valid: bound.valid, type: -1, before: 0)
                  recur(source, @tokens, structure.body, frame.expected, bound.parent, params, return_type, false, current_result, depth, limit, next_top, branch_depth, branch_top, argument_depth, argument_top, builtin_depth, @builtins, @arguments, @branches, @pending, @bindings, @facts, @issues, @scopes, @frames)
                else:
                  if frame.phase == 2:
                    let valid: Bool = assign_value(source, tokens, frame, current_result, @bindings, @issues, @scopes, @frames)
                    let structure: control.Assignment = control.assignment(tokens, frame.expr)
                    let next_top: Pending = Pending(expr: frame.expr, expected: frame.expected, parent: frame.parent, phase: 3, valid: valid, type: -1, before: 0)
                    recur(source, @tokens, structure.body, frame.expected, frame.parent, params, return_type, false, current_result, depth, limit, next_top, branch_depth, branch_top, argument_depth, argument_top, builtin_depth, @builtins, @arguments, @branches, @pending, @bindings, @facts, @issues, @scopes, @frames)
                  else:
                    let completed: TypeRef = if frame.phase == 7:
                      project_value(source, tokens, frame.expr, current_result, @issues)
                    else:
                      current_result
                    let passthrough: Bool = (frame.phase == 6) || (frame.phase == 7)
                    let valid: Bool = passthrough || (frame.valid && type_valid(current_result))
                    let actual: TypeRef = if valid:
                      completed
                    else:
                      invalid_type(frame.expr)
                    let finished: TypeRef = finish_type(source, tokens, frame.expr, frame.expected, actual, @facts, @issues)
                    if at == 0:
                      finished
                    else:
                      let enclosing: Pending = vec.get(pending, at - 1)
                      recur(source, @tokens, frame.expr, frame.expected, frame.parent, params, return_type, true, finished, at, limit, enclosing, branch_depth, branch_top, argument_depth, argument_top, builtin_depth, @builtins, @arguments, @branches, @pending, @bindings, @facts, @issues, @scopes, @frames)
  else:
    if kind == 1:
      let structure: control.Binding = control.binding(tokens, expr)
      let value_expected: I64 = if syntax.ast_expression_is_statement(tokens, expr):
        -1
      else:
        structure.type
      let frame: Pending = Pending(expr: expr, expected: expected, parent: parent, phase: 0, valid: true, type: -1, before: 0)
      let next: I64 = push_pending(top, depth, limit, @pending)
      recur(source, @tokens, structure.value, value_expected, parent, params, return_type, false, current_result, next, limit, frame, branch_depth, branch_top, argument_depth, argument_top, builtin_depth, @builtins, @arguments, @branches, @pending, @bindings, @facts, @issues, @scopes, @frames)
    else:
      if kind == 2:
        let target: AssignmentTarget = prepare_set(source, tokens, expr, parent, bindings, @issues)
        if target.type >= 0:
          let structure: control.Assignment = control.assignment(tokens, expr)
          let frame: Pending = Pending(expr: expr, expected: expected, parent: parent, phase: 2, valid: target.affine, type: target.type, before: vec.len(issues))
          let next: I64 = push_pending(top, depth, limit, @pending)
          recur(source, @tokens, structure.value, target.type, parent, params, return_type, false, current_result, next, limit, frame, branch_depth, branch_top, argument_depth, argument_top, builtin_depth, @builtins, @arguments, @branches, @pending, @bindings, @facts, @issues, @scopes, @frames)
        else:
          let actual: TypeRef = finish_type(source, tokens, expr, expected, invalid_type(expr), @facts, @issues)
          recur(source, @tokens, expr, expected, parent, params, return_type, true, actual, depth, limit, top, branch_depth, branch_top, argument_depth, argument_top, builtin_depth, @builtins, @arguments, @branches, @pending, @bindings, @facts, @issues, @scopes, @frames)
      else:
        if kind == 3:
          let structure: control.Branch = control.branch(tokens, expr)
          let frame: Pending = Pending(expr: expr, expected: expected, parent: parent, phase: 4, valid: true, type: -1, before: 0)
          let next: I64 = push_pending(top, depth, limit, @pending)
          recur(source, @tokens, structure.value, -1, parent, params, return_type, false, current_result, next, limit, frame, branch_depth, branch_top, argument_depth, argument_top, builtin_depth, @builtins, @arguments, @branches, @pending, @bindings, @facts, @issues, @scopes, @frames)
        else:
          if kind == 4:
            let structure: control.Projection = control.projection(tokens, expr)
            let frame: Pending = Pending(expr: expr, expected: expected, parent: parent, phase: 7, valid: true, type: -1, before: 0)
            let next: I64 = push_pending(top, depth, limit, @pending)
            recur(source, @tokens, structure.value, -1, parent, params, return_type, false, current_result, next, limit, frame, branch_depth, branch_top, argument_depth, argument_top, builtin_depth, @builtins, @arguments, @branches, @pending, @bindings, @facts, @issues, @scopes, @frames)
          else:
            if kind == 5:
              let structure: control.Unary = control.fork(expr)
              let arity: Bool = expect_arity(tokens, structure.value, 1, syntax.ast_expression_marker(expr), @issues)
              if arity:
                let frame: Pending = Pending(expr: expr, expected: expected, parent: parent, phase: 6, valid: true, type: -1, before: 0)
                let next: I64 = push_pending(top, depth, limit, @pending)
                recur(source, @tokens, structure.value, expected, parent, params, return_type, false, current_result, next, limit, frame, branch_depth, branch_top, argument_depth, argument_top, builtin_depth, @builtins, @arguments, @branches, @pending, @bindings, @facts, @issues, @scopes, @frames)
              else:
                let actual: TypeRef = finish_type(source, tokens, expr, expected, invalid_type(expr), @facts, @issues)
                recur(source, @tokens, expr, expected, parent, params, return_type, true, actual, depth, limit, top, branch_depth, branch_top, argument_depth, argument_top, builtin_depth, @builtins, @arguments, @branches, @pending, @bindings, @facts, @issues, @scopes, @frames)
            else:
              let record: Bool = kind == 6
              let variant: Bool = kind == 7
              if record || variant:
                let members: Members = prepare_members(source, @tokens, expr, record, @issues)
                let phase: I64 = if record:
                  8
                else:
                  9
                let frame: Pending = Pending(expr: expr, expected: expected, parent: parent, phase: phase, valid: true, type: members.cursor, before: members.definition)
                let request: MemberNext = next_member(source, @tokens, frame, @issues)
                if request.done:
                  let actual: TypeRef = finish_type(source, tokens, expr, expected, request.result, @facts, @issues)
                  recur(source, @tokens, expr, expected, parent, params, return_type, true, actual, depth, limit, top, branch_depth, branch_top, argument_depth, argument_top, builtin_depth, @builtins, @arguments, @branches, @pending, @bindings, @facts, @issues, @scopes, @frames)
                else:
                  let next: I64 = push_pending(top, depth, limit, @pending)
                  recur(source, @tokens, request.value, request.expected, parent, params, return_type, false, current_result, next, limit, frame, branch_depth, branch_top, argument_depth, argument_top, builtin_depth, @builtins, @arguments, @branches, @pending, @bindings, @facts, @issues, @scopes, @frames)
              else:
                let ordinary_user: Bool = if kind == 8:
                  user_call(source, tokens, expr)
                else:
                  false
                if (kind == 9) || ordinary_user:
                  let recursive: Bool = kind == 9
                  let initial: ArgumentState = prepare_arguments(source, tokens, expr, recursive, params, @issues)
                  let request: ArgumentNext = next_argument(source, tokens, expr, recursive, return_type, initial, @bindings, @issues)
                  if request.done:
                    let actual: TypeRef = finish_type(source, tokens, expr, expected, request.result, @facts, @issues)
                    recur(source, @tokens, expr, expected, parent, params, return_type, true, actual, depth, limit, top, branch_depth, branch_top, argument_depth, argument_top, builtin_depth, @builtins, @arguments, @branches, @pending, @bindings, @facts, @issues, @scopes, @frames)
                  else:
                    let phase: I64 = if recursive:
                      11
                    else:
                      10
                    let next_arguments: I64 = push_argument(argument_top, argument_depth, limit, @arguments)
                    let frame: Pending = Pending(expr: expr, expected: expected, parent: parent, phase: phase, valid: true, type: request.expected, before: 0)
                    let next: I64 = push_pending(top, depth, limit, @pending)
                    recur(source, @tokens, request.state.argument, request.expected, parent, params, return_type, !request.state.allowed, request.result, next, limit, frame, branch_depth, branch_top, next_arguments, request.state, builtin_depth, @builtins, @arguments, @branches, @pending, @bindings, @facts, @issues, @scopes, @frames)
                else:
                  let request: BuiltinNext = prepare_builtin(source, tokens, expr, expected, @bindings, @issues)
                  if request.done:
                    let actual: TypeRef = finish_type(source, tokens, expr, expected, request.result, @facts, @issues)
                    recur(source, @tokens, expr, expected, parent, params, return_type, true, actual, depth, limit, top, branch_depth, branch_top, argument_depth, argument_top, builtin_depth, @builtins, @arguments, @branches, @pending, @bindings, @facts, @issues, @scopes, @frames)
                  else:
                    if request.state.operation <= 2:
                      let phase: I64 = if request.state.count == 1:
                        13
                      else:
                        if request.state.operation == 2:
                          15
                        else:
                          14
                      let frame: Pending = Pending(expr: expr, expected: expected, parent: parent, phase: phase, valid: request.state.modes_valid, type: request.state.kind, before: request.state.result_kind)
                      let next: I64 = push_pending(top, depth, limit, @pending)
                      recur(source, @tokens, request.state.argument, -1, parent, params, return_type, false, request.result, next, limit, frame, branch_depth, branch_top, argument_depth, argument_top, builtin_depth, @builtins, @arguments, @branches, @pending, @bindings, @facts, @issues, @scopes, @frames)
                    else:
                      let index: I64 = push_builtin(request.state, builtin_depth, limit, @builtins)
                      let frame: Pending = Pending(expr: expr, expected: expected, parent: parent, phase: 12, valid: true, type: index, before: 0)
                      let next: I64 = push_pending(top, depth, limit, @pending)
                      recur(source, @tokens, request.state.argument, request.expected, parent, params, return_type, !request.state.allowed, request.result, next, limit, frame, branch_depth, branch_top, argument_depth, argument_top, builtin_depth + 1, @builtins, @arguments, @branches, @pending, @bindings, @facts, @issues, @scopes, @frames)

fn infer_expr(source: Bytes, tokens: @Vec[syntax.Token], expr: I64, expected: I64, parent: I64, params: I64, return_type: I64, bindings: @Vec[Binding], facts: @Vec[Fact], issues: @Vec[Issue], scopes: @Vec[ownership.Scope], frames: @Vec[ownership.Frame]) -> TypeRef effects[alloc, partial]:
  let failed: Bool = issues_block_inference(issues)
  if failed:
    invalid_type(expr)
  else:
    let kind: I64 = syntax.ast_node_kind(tokens, expr)
    let form: Bool = kind == 0
    if form:
      let pending: Vec[Pending] = vec.new()
      let branches: Vec[BranchState] = vec.new()
      let arguments: Vec[ArgumentState] = vec.new()
      let builtins: Vec[BuiltinState] = vec.new()
      let limit: I64 = syntax.ast_next(tokens, expr) - expr
      let top: Pending = Pending(expr: expr, expected: expected, parent: parent, phase: 0, valid: true, type: -1, before: 0)
      infer_control_walk(source, @tokens, expr, expected, parent, params, return_type, false, invalid_type(expr), 0, limit, top, 0, empty_branch(expr), 0, argument_state(-1, -1, false, false), 0, @builtins, @arguments, @branches, @pending, @bindings, @facts, @issues, @scopes, @frames)
    else:
      let actual: TypeRef = infer_atom(source, tokens, expr, parent, @bindings, @issues, @scopes, @frames)
      finish_type(source, tokens, expr, expected, actual, @facts, @issues)

fn type_form_wellformed(source: Bytes, tokens: Vec[syntax.Token], type: I64) -> Bool effects[partial]:
  let scalar: I64 = syntax.scalar_type_kind(source, tokens, type)
  let scalar_type: Bool = scalar >= 0
  if scalar_type:
    true
  else:
    let kind: I64 = syntax.ast_node_kind(tokens, type)
    let atom: Bool = kind == 2
    if atom:
      let item: I64 = linked_item(tokens, type)
      let record: Bool = item_has_kind(source, tokens, item, 1)
      let variant: Bool = item_has_kind(source, tokens, item, 2)
      record || variant
    else:
      let form: Bool = kind == 0
      if form:
        let vec_type: Bool = syntax.ast_type_is_vec(source, tokens, type)
        let arena_type: Bool = syntax.ast_type_is_arena(source, tokens, type)
        let id_type: Bool = syntax.ast_type_is_id(source, tokens, type)
        let constructor: Bool = vec_type || (arena_type || id_type)
        let inner: I64 = syntax.ast_type_argument(type)
        let inner_valid: Bool = type_form_wellformed(source, tokens, inner)
        let next: I64 = syntax.ast_next(tokens, inner)
        let next_kind: I64 = syntax.ast_node_kind(tokens, next)
        let exact: Bool = next_kind == 1
        constructor && (inner_valid && exact)
      else:
        false

fn type_contains_void(source: Bytes, tokens: Vec[syntax.Token], type: I64) -> Bool effects[partial]:
  let scalar: I64 = syntax.scalar_type_kind(source, tokens, type)
  if scalar == 0:
    true
  else:
    let kind: I64 = syntax.ast_node_kind(tokens, type)
    if kind == 0:
      type_contains_void(source, tokens, syntax.ast_type_argument(type))
    else:
      false

fn check_type_form(source: Bytes, tokens: Vec[syntax.Token], type: I64, issues: @Vec[Issue]) -> Bool effects[alloc, partial]:
  let valid: Bool = type_form_wellformed(source, tokens, type)
  if valid:
    true
  else:
    record_issue("E0354", type, @issues)
    false

fn check_type_forms(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, issues: @Vec[Issue]) -> Void effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    void
  else:
    let valid: Bool = check_type_form(source, tokens, cursor, @issues)
    let stored_void: Bool = type_contains_void(source, tokens, cursor)
    if stored_void:
      record_issue("E0358", cursor, @issues)
    else:
      void
    let next: I64 = syntax.ast_next(tokens, cursor)
    recur(source, tokens, next, @issues)

fn check_parameter_types(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, issues: @Vec[Issue]) -> Void effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    void
  else:
    let type: I64 = parameter_type(source, tokens, cursor)
    let valid: Bool = check_type_form(source, tokens, type, @issues)
    let stored_void: Bool = type_contains_void(source, tokens, type)
    let mode: I64 = syntax.ast_binding_mode(source, tokens, cursor)
    let storage: I64 = memory.type_storage_kind(source, tokens, type)
    let affine: Bool = storage == 2
    let mode_valid: Bool = (mode == 0) || affine
    if stored_void:
      record_issue("E0358", type, @issues)
    else:
      void
    if mode_valid:
      void
    else:
      append_ownership_issue("E0360", cursor, @issues)
    let next: I64 = syntax.ast_next(tokens, cursor)
    recur(source, tokens, next, @issues)

fn check_record_types(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, issues: @Vec[Issue]) -> Void effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    void
  else:
    let type: I64 = syntax.ast_member_value(cursor)
    let valid: Bool = check_type_form(source, tokens, type, @issues)
    let stored_void: Bool = type_contains_void(source, tokens, type)
    if stored_void:
      record_issue("E0358", type, @issues)
    else:
      void
    let next: I64 = syntax.ast_next(tokens, cursor)
    recur(source, tokens, next, @issues)

fn check_variant_types(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, issues: @Vec[Issue]) -> Void effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    void
  else:
    let payload: I64 = syntax.ast_member_value(cursor)
    check_type_forms(source, tokens, payload, @issues)
    let next: I64 = syntax.ast_next(tokens, cursor)
    recur(source, tokens, next, @issues)

fn type_is_vec_bytes(source: Bytes, tokens: Vec[syntax.Token], type: I64) -> Bool effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, type)
  let form: Bool = kind == 0
  if form:
    let vector: Bool = syntax.ast_type_is_vec(source, tokens, type)
    let inner: I64 = syntax.ast_type_argument(type)
    let inner_kind: I64 = syntax.scalar_type_kind(source, tokens, inner)
    let bytes_type: Bool = inner_kind == 4
    let next: I64 = syntax.ast_next(tokens, inner)
    let next_kind: I64 = syntax.ast_node_kind(tokens, next)
    let exact: Bool = next_kind == 1
    vector && (bytes_type && exact)
  else:
    false

fn main_signature_valid(source: Bytes, tokens: Vec[syntax.Token], item: I64) -> Bool effects[partial]:
  let params: I64 = syntax.ast_function_parameters(item)
  let first: I64 = syntax.ast_parameters_first(params)
  let count: I64 = form_count(tokens, first, 0)
  let one: Bool = count == 1
  if one:
    let borrowed: Bool = parameter_is_exclusive(source, tokens, first)
    let plain: Bool = !borrowed
    let name: I64 = parameter_name(source, tokens, first)
    let named: Bool = syntax.ast_node_text_is(source, tokens, name, "args")
    let type: I64 = parameter_type(source, tokens, first)
    let vector: Bool = type_is_vec_bytes(source, tokens, type)
    let return_type: I64 = syntax.ast_function_return_type(tokens, item)
    let return_kind: I64 = syntax.scalar_type_kind(source, tokens, return_type)
    let returns_i64: Bool = return_kind == 3
    plain && (named && (vector && returns_i64))
  else:
    false

# Inline storage must form an acyclic graph. Collection and Id constructors
# break inline layout recursion. Each data declaration and field is visited
# once; shared dependencies reuse the completed mark instead of expanding paths.
fn initialize_layout_marks(length: I64, marks: @Vec[I64]) -> Void effects[alloc, partial]:
  if vec.len(marks) >= length:
    void
  else:
    vec.push(@marks, 0)
    recur(length, @marks)

fn inline_layout_mark(marks: Vec[I64], item: I64) -> I64 effects[partial]:
  if item < vec.len(marks):
    vec.get(marks, item)
  else:
    0

fn check_inline_layout_type(source: Bytes, tokens: Vec[syntax.Token], type: I64, marks: @Vec[I64], issues: @Vec[Issue], layouts: @Vec[I64]) -> Void effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, type)
  let scalar: I64 = syntax.scalar_type_kind(source, tokens, type)
  if (kind == 2) && (scalar < 0):
    let item: I64 = linked_item(tokens, type)
    let record: Bool = item_has_kind(source, tokens, item, 1)
    let variant: Bool = item_has_kind(source, tokens, item, 2)
    if record || variant:
      let mark: I64 = inline_layout_mark(marks, item)
      if mark == 1:
        record_issue("E0354", type, @issues)
      else:
        check_inline_layout_item(source, tokens, item, @marks, @issues, @layouts)
    else:
      void
  else:
    void

fn check_inline_layout_payload(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, marks: @Vec[I64], issues: @Vec[Issue], layouts: @Vec[I64]) -> Void effects[alloc, partial]:
  if syntax.ast_node_kind(tokens, cursor) == 1:
    void
  else:
    check_inline_layout_type(source, tokens, cursor, @marks, @issues, @layouts)
    let next: I64 = syntax.ast_next(tokens, cursor)
    recur(source, tokens, next, @marks, @issues, @layouts)

fn check_inline_layout_members(source: Bytes, tokens: Vec[syntax.Token], cursor: I64, record: Bool, marks: @Vec[I64], issues: @Vec[Issue], layouts: @Vec[I64]) -> Void effects[alloc, partial]:
  if syntax.ast_node_kind(tokens, cursor) == 1:
    void
  else:
    let value: I64 = syntax.ast_member_value(cursor)
    if record:
      check_inline_layout_type(source, tokens, value, @marks, @issues, @layouts)
    else:
      check_inline_layout_payload(source, tokens, value, @marks, @issues, @layouts)
    let next: I64 = syntax.ast_next(tokens, cursor)
    recur(source, tokens, next, record, @marks, @issues, @layouts)

fn check_inline_layout_item(source: Bytes, tokens: Vec[syntax.Token], item: I64, marks: @Vec[I64], issues: @Vec[Issue], layouts: @Vec[I64]) -> Void effects[alloc, partial]:
  if inline_layout_mark(marks, item) == 0:
    initialize_layout_marks(item + 1, @marks)
    vec.set(@marks, item, 1)
    let record: Bool = syntax.ast_item_is_record(source, tokens, item)
    let members: I64 = syntax.ast_data_members_first(item)
    check_inline_layout_members(source, tokens, members, record, @marks, @issues, @layouts)
    vec.set(@marks, item, 2)
    vec.push(@layouts, item)
  else:
    void

fn check_inline_layouts(source: Bytes, tokens: Vec[syntax.Token], declarations: Vec[ir.Declaration], index: I64, marks: @Vec[I64], issues: @Vec[Issue], layouts: @Vec[I64]) -> Void effects[alloc, partial]:
  if index >= vec.len(declarations):
    void
  else:
    let declaration: ir.Declaration = vec.get(declarations, index)
    let item: I64 = declaration.form
    if syntax.ast_item_is_function(source, tokens, item):
      void
    else:
      check_inline_layout_item(source, tokens, item, @marks, @issues, @layouts)
    recur(source, tokens, declarations, index + 1, @marks, @issues, @layouts)

fn check_declaration_types(source: Bytes, tokens: Vec[syntax.Token], declarations: Vec[ir.Declaration], index: I64, issues: @Vec[Issue]) -> Void effects[alloc, partial]:
  let count: I64 = vec.len(declarations)
  let done: Bool = index >= count
  if done:
    void
  else:
    let declaration: ir.Declaration = vec.get(declarations, index)
    let item: I64 = declaration.form
    let name: I64 = declaration.name
    let first_declaration: I64 = syntax.ast_node_link(tokens, name)
    let duplicate: Bool = (first_declaration >= 0) && (first_declaration < item)
    if duplicate:
      record_issue("E0352", name, @issues)
    else:
      void
    let function: Bool = syntax.ast_item_is_function(source, tokens, item)
    let record: Bool = syntax.ast_item_is_record(source, tokens, item)
    if function:
      let params: I64 = syntax.ast_function_parameters(item)
      check_parameter_types(source, tokens, syntax.ast_parameters_first(params), @issues)
      let return_type: I64 = syntax.ast_function_return_type(tokens, item)
      let returned: Bool = check_type_form(source, tokens, return_type, @issues)
      let main: Bool = syntax.ast_node_text_is(source, tokens, name, "main")
      let signature: Bool = if main:
        main_signature_valid(source, tokens, item)
      else:
        true
      if signature:
        void
      else:
        record_issue("E0355", name, @issues)
    else:
      let first_member: I64 = syntax.ast_data_members_first(item)
      if record:
        check_record_types(source, tokens, first_member, @issues)
      else:
        check_variant_types(source, tokens, first_member, @issues)
    let next: I64 = index + 1
    recur(source, tokens, declarations, next, @issues)

fn ownership_result_expr(source: Bytes, tokens: Vec[syntax.Token], expr: I64) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, expr)
  let form: Bool = kind == 0
  if form:
    let let_form: Bool = syntax.ast_expression_is_let(source, tokens, expr)
    if let_form:
      recur(source, tokens, syntax.ast_let_body(tokens, expr))
    else:
      let set_form: Bool = syntax.ast_expression_is_set(source, tokens, expr)
      if set_form:
        recur(source, tokens, syntax.ast_set_body(tokens, expr))
      else:
        let fork_form: Bool = syntax.ast_expression_is_fork(source, tokens, expr)
        if fork_form:
          recur(source, tokens, syntax.ast_fork_body(expr))
        else:
          expr
  else:
    expr

fn result_is_borrowed(source: Bytes, tokens: Vec[syntax.Token], result: I64, bindings: Vec[Binding]) -> Bool effects[partial]:
  value_borrow_mode(source, tokens, result, bindings) > 0

fn append_borrowed_return_issue(source: Bytes, tokens: Vec[syntax.Token], return_type: I64, body: I64, bindings: Vec[Binding], issues: @Vec[Issue]) -> Void effects[alloc, partial]:
  let storage: I64 = memory.type_storage_kind(source, tokens, return_type)
  let owned: Bool = storage == 2
  if owned:
    let result: I64 = ownership_result_expr(source, tokens, body)
    let borrowed: Bool = result_is_borrowed(source, tokens, result, bindings)
    if borrowed:
      append_ownership_issue("E0347", result, @issues)
    else:
      void
  else:
    void

fn check_function(source: Bytes, tokens: @Vec[syntax.Token], item: I64, facts: @Vec[Fact], issues: @Vec[Issue]) -> Void effects[alloc, partial]:
  let scopes: Vec[ownership.Scope] = vec.new()
  let initial_scope: ownership.Scope = ownership.Scope(parent: 1, rank: 0, ancestor: 1, depth: 0, alternatives: 0, arms: 0)
  vec.push(@scopes, initial_scope)
  vec.push(@scopes, initial_scope)
  let frames: Vec[ownership.Frame] = vec.new()
  let bindings: Vec[Binding] = vec.new()
  let loan_slot: Binding = Binding(name: -1, type: -1, mode: 0, mutable: false, move_scope: -1, owner: -1, parent: -1, access_call: -1, access_mode: 0)
  vec.push(@bindings, loan_slot)
  vec.push(@bindings, loan_slot)
  let params: I64 = syntax.ast_function_parameters(item)
  let parent: I64 = bind_parameters(source, @tokens, syntax.ast_parameters_first(params), -1, @bindings)
  let return_type: I64 = syntax.ast_function_return_type(tokens, item)
  let effects: I64 = syntax.ast_function_effects(tokens, item)
  let body: I64 = syntax.ast_function_body(tokens, item)
  let typed: TypeRef = infer_expr(source, @tokens, body, return_type, parent, params, return_type, @bindings, @facts, @issues, @scopes, @frames)
  let valid: Bool = type_valid(typed)
  if valid:
    append_borrowed_return_issue(source, tokens, return_type, body, bindings, @issues)
  else:
    void
  retain_binding_facts(source, tokens, bindings, 2, @facts)

fn check_functions(source: Bytes, tokens: @Vec[syntax.Token], declarations: Vec[ir.Declaration], index: I64, facts: @Vec[Fact], issues: @Vec[Issue]) -> Void effects[alloc, partial]:
  let count: I64 = vec.len(declarations)
  let done: Bool = index >= count
  let failed: Bool = issues_block_inference(issues)
  let stop: Bool = done || failed
  if stop:
    void
  else:
    let declaration: ir.Declaration = vec.get(declarations, index)
    let item: I64 = declaration.form
    let function: Bool = syntax.ast_item_is_function(source, tokens, item)
    if function:
      check_function(source, @tokens, item, @facts, @issues)
    else:
      void
    let next: I64 = index + 1
    recur(source, @tokens, declarations, next, @facts, @issues)

fn retain_binding_facts(source: Bytes, tokens: Vec[syntax.Token], bindings: Vec[Binding], index: I64, facts: @Vec[Fact]) -> Void effects[partial]:
  if index >= vec.len(bindings):
    void
  else:
    let binding: Binding = vec.get(bindings, index)
    let type: TypeRef = source_type(source, tokens, binding.type)
    let tag: I64 = (((binding.mode + 1) * 8) + type.kind) + 2
    vec.set(@facts, binding.name, Fact(tag: tag, form: type.form))
    recur(source, tokens, bindings, index + 1, @facts)

fn prepare(source: Bytes, tokens: @Vec[syntax.Token], declarations: Vec[ir.Declaration]) -> View effects[alloc, partial]:
  syntax.link_declaration_names(source, @tokens)
  link_declaration_locals(source, @tokens, declarations, 0)
  let facts: Vec[Fact] = vec.new()
  initialize_facts(tokens, 0, @facts)
  let issues: Vec[Issue] = vec.new()
  let layout_marks: Vec[I64] = vec.new()
  let layouts: Vec[I64] = vec.new()
  check_inline_layouts(source, tokens, declarations, 0, @layout_marks, @issues, @layouts)
  if issues_block_inference(issues):
    void
  else:
    check_declaration_types(source, tokens, declarations, 0, @issues)
  View(facts: facts, issues: issues, layouts: layouts)

fn analyze(source: Bytes, tokens: @Vec[syntax.Token], declarations: Vec[ir.Declaration]) -> View effects[alloc, partial]:
  let view: View = prepare(source, @tokens, declarations)
  let facts: Vec[Fact] = mem.replace(@view.facts, vec.new())
  let issues: Vec[Issue] = mem.replace(@view.issues, vec.new())
  let layouts: Vec[I64] = mem.replace(@view.layouts, vec.new())
  check_functions(source, @tokens, declarations, 0, @facts, @issues)
  View(facts: facts, issues: issues, layouts: layouts)
