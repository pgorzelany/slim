module fragments

struct Span:
  start: I64
  end: I64
  checksum: I64

struct Entry:
  declaration: identity.DeclarationId
  plan: I64
  counted: I64
  prototype: Span
  body: Span

struct Wrapper:
  declaration: identity.DeclarationId
  site: I64
  task: I64
  span: Span

struct Cache:
  revision: identity.Revision
  entries: Vec[Entry]
  slots: Vec[I64]
  wrappers: Vec[Wrapper]
  sites: Vec[parallel.Site]
  prototype_start: I64
  wrapper_start: I64
  body_start: I64
  footer_start: I64
  code_bytes: I64
  seal: I64

struct Generated:
  code: Bytes
  history: Cache
  checksum: I64

fn empty_span() -> Span:
  Span(start: 0, end: 0, checksum: 0)

fn empty_cache() -> Cache effects[alloc]:
  let entries: Vec[Entry] = vec.new()
  let slots: Vec[I64] = vec.new()
  let wrappers: Vec[Wrapper] = vec.new()
  let sites: Vec[parallel.Site] = vec.new()
  Cache(revision: identity.Revision(epoch: 0, serial: 0), entries: entries, slots: slots, wrappers: wrappers, sites: sites, prototype_start: 0, wrapper_start: 0, body_start: 0, footer_start: 0, code_bytes: 0, seal: 0)

fn same_bool(left: Bool, right: Bool) -> Bool:
  if left:
    right
  else:
    !right

fn same_range(left: ranges.Fact, right: ranges.Fact) -> Bool:
  (same_bool(left.analyzed, right.analyzed) && same_bool(left.lower_known, right.lower_known)) && ((left.lower == right.lower) && (same_bool(left.upper_known, right.upper_known) && ((left.upper == right.upper) && same_bool(left.total, right.total))))

fn same_ranges(old: Vec[ranges.Fact], current: Vec[ranges.Fact], before: identity.View, owner: identity.View, at: I64) -> Bool effects[partial]:
  if at >= owner.count:
    true
  else:
    if same_range(vec.get(old, before.first + at), vec.get(current, owner.first + at)):
      recur(old, current, before, owner, at + 1)
    else:
      false

fn local_node(node: I64, owner: identity.View) -> Bool effects[partial]:
  (node >= owner.first) && (node < (owner.first + owner.count))

fn same_local_node(left: I64, right: I64, before: identity.View, owner: identity.View) -> Bool effects[partial]:
  if local_node(left, before) && local_node(right, owner):
    (left - before.first) == (right - owner.first)
  else:
    false

fn same_allocations(old: Vec[memory.AllocationPlan], current: Vec[memory.AllocationPlan], before: identity.View, owner: identity.View, at: I64) -> Bool effects[partial]:
  if at >= vec.len(old):
    vec.len(old) == vec.len(current)
  else:
    if at < vec.len(current):
      let left: memory.AllocationPlan = vec.get(old, at)
      let right: memory.AllocationPlan = vec.get(current, at)
      if (left.region == right.region) && same_local_node(left.site, right.site, before, owner):
        recur(old, current, before, owner, at + 1)
      else:
        false
    else:
      false

fn same_plan(old: memory.FunctionPlan, current: memory.FunctionPlan, before: identity.View, owner: identity.View) -> Bool effects[partial]:
  let aligned: Bool = (old.function == before.first) && (current.function == owner.first)
  let flags: Bool = same_bool(old.local_region, current.local_region) && same_bool(old.recursive, current.recursive)
  if aligned && flags:
    same_allocations(old.allocations, current.allocations, before, owner, 0)
  else:
    false

fn same_counted(old: Vec[ranges.Counted], current: Vec[ranges.Counted], previous: I64, index: I64, before: identity.View, owner: identity.View) -> Bool effects[partial]:
  if previous == -1:
    index == -1
  else:
    let valid: Bool = ((previous >= 0) && (previous < vec.len(old))) && ((index >= 0) && (index < vec.len(current)))
    if valid:
      let left: ranges.Counted = vec.get(old, previous)
      let right: ranges.Counted = vec.get(current, index)
      let aligned: Bool = (left.item == before.first) && (right.item == owner.first)
      let numbers: Bool = ((left.start == right.start) && (left.bound == right.bound)) && ((left.step == right.step) && (left.iterations == right.iterations))
      let controller: Bool = same_local_node(left.controller, right.controller, before, owner)
      let body: Bool = same_local_node(left.body, right.body, before, owner)
      let base: Bool = same_local_node(left.base, right.base, before, owner)
      aligned && (numbers && (controller && (body && base)))
    else:
      false

fn next_site(sites: Vec[parallel.Site], owner: identity.View, at: I64) -> I64 effects[partial]:
  if at >= vec.len(sites):
    -1
  else:
    let site: parallel.Site = vec.get(sites, at)
    if local_node(site.site, owner):
      at
    else:
      recur(sites, owner, at + 1)

fn same_site(left: parallel.Site, right: parallel.Site, before: identity.View, owner: identity.View) -> Bool effects[partial]:
  let first: Bool = same_local_node(left.first, right.first, before, owner)
  let second: Bool = same_local_node(left.second, right.second, before, owner)
  let join: Bool = same_local_node(left.join, right.join, before, owner)
  let site: Bool = same_local_node(left.site, right.site, before, owner)
  let work: Bool = (left.first_work == right.first_work) && (left.second_work == right.second_work)
  let flags: Bool = same_bool(left.allocates, right.allocates) && (same_bool(left.explicit, right.explicit) && same_bool(left.executable, right.executable))
  first && (second && (join && (site && (work && flags))))

fn same_sites(old: Vec[parallel.Site], current: Vec[parallel.Site], before: identity.View, owner: identity.View, old_at: I64, at: I64) -> Bool effects[partial]:
  let previous: I64 = next_site(old, before, old_at)
  let index: I64 = next_site(current, owner, at)
  if previous == -1:
    index == -1
  else:
    if index >= 0:
      if same_site(vec.get(old, previous), vec.get(current, index), before, owner):
        recur(old, current, before, owner, previous + 1, index + 1)
      else:
        false
    else:
      false

# Bounded metadata integrity, not authentication of externally supplied state.
# Reducing each signed input before addition keeps even extreme corrupt words
# inside the arithmetic domain. The running sum is always below this modulus.
fn seal_word(sum: I64, value: I64) -> I64 effects[partial]:
  let word: I64 = value % 1000000007
  ((sum * 97) + (word + 1000000007)) % 1000000007

fn seal_bool(sum: I64, value: Bool) -> I64 effects[partial]:
  let word: I64 = if value:
    1
  else:
    0
  seal_word(sum, word)

fn seal_revision(sum: I64, revision: identity.Revision) -> I64 effects[partial]:
  seal_word(seal_word(sum, revision.epoch), revision.serial)

fn seal_declaration(sum: I64, declaration: identity.DeclarationId) -> I64 effects[partial]:
  let revision: I64 = seal_revision(sum, declaration.file.revision)
  seal_word(seal_word(revision, declaration.file.slot), declaration.slot)

fn seal_span(sum: I64, span: Span) -> I64 effects[partial]:
  seal_word(seal_word(seal_word(sum, span.start), span.end), span.checksum)

fn seal_entries(entries: Vec[Entry], at: I64, sum: I64) -> I64 effects[partial]:
  if at >= vec.len(entries):
    sum
  else:
    let entry: Entry = vec.get(entries, at)
    let owner: I64 = seal_declaration(sum, entry.declaration)
    let indices: I64 = seal_word(seal_word(owner, entry.plan), entry.counted)
    let spans: I64 = seal_span(seal_span(indices, entry.prototype), entry.body)
    recur(entries, at + 1, spans)

fn seal_slots(slots: Vec[I64], at: I64, sum: I64) -> I64 effects[partial]:
  if at >= vec.len(slots):
    sum
  else:
    recur(slots, at + 1, seal_word(sum, vec.get(slots, at)))

fn seal_wrappers(wrappers: Vec[Wrapper], at: I64, sum: I64) -> I64 effects[partial]:
  if at >= vec.len(wrappers):
    sum
  else:
    let wrapper: Wrapper = vec.get(wrappers, at)
    let owner: I64 = seal_declaration(sum, wrapper.declaration)
    let site: I64 = seal_word(seal_word(owner, wrapper.site), wrapper.task)
    recur(wrappers, at + 1, seal_span(site, wrapper.span))

fn seal_sites(sites: Vec[parallel.Site], at: I64, sum: I64) -> I64 effects[partial]:
  if at >= vec.len(sites):
    sum
  else:
    let site: parallel.Site = vec.get(sites, at)
    let nodes: I64 = seal_word(seal_word(seal_word(seal_word(sum, site.site), site.first), site.second), site.join)
    let work: I64 = seal_word(seal_word(nodes, site.first_work), site.second_work)
    let flags: I64 = seal_bool(seal_bool(seal_bool(work, site.allocates), site.explicit), site.executable)
    recur(sites, at + 1, flags)

fn metadata_seal(history: Cache) -> I64 effects[partial]:
  let owner: I64 = seal_revision(140, history.revision)
  let counts: I64 = seal_word(seal_word(seal_word(seal_word(owner, vec.len(history.entries)), vec.len(history.slots)), vec.len(history.wrappers)), vec.len(history.sites))
  let sections: I64 = seal_word(seal_word(seal_word(seal_word(counts, history.prototype_start), history.wrapper_start), history.body_start), history.footer_start)
  let size: I64 = seal_word(sections, history.code_bytes)
  let entries: I64 = seal_entries(history.entries, 0, size)
  let slots: I64 = seal_slots(history.slots, 0, entries)
  let wrappers: I64 = seal_wrappers(history.wrappers, 0, slots)
  seal_sites(history.sites, 0, wrappers)

fn span_valid(span: Span, size: I64) -> Bool:
  (span.start >= 0) && ((span.end > span.start) && ((span.end <= size) && (span.checksum >= 0)))

fn span_intact(code: Bytes, span: Span) -> Bool effects[partial]:
  if (bytes.len(code) <= 67108864) && span_valid(span, bytes.len(code)):
    cache.weighted_checksum(code, span.start, span.end, 0) == span.checksum
  else:
    false

fn prepared_ready(prepared: project.PreparedProject, checked: retained.Cache) -> Bool effects[partial]:
  let count: I64 = vec.len(checked.nodes)
  let sizes: Bool = (vec.len(prepared.tokens) == count) && ((vec.len(prepared.facts) == count) && (vec.len(prepared.range_view.facts) == count))
  ((prepared.status == 0) && prepared.range_ready) && (checked.valid && (((count > 0) && (count <= 1000000)) && (sizes && retained.equal(prepared.source, checked.index.source))))

fn entry_frames_valid(history: Cache, before: retained.Cache, prepared: project.PreparedProject, at: I64, plan: I64, counted: I64, prototype: I64, body: I64) -> Bool effects[partial]:
  if at >= vec.len(before.index.declarations):
    let counts: Bool = (plan == vec.len(history.entries)) && (counted == vec.len(prepared.range_view.counted))
    counts && (((prototype + 1) == history.wrapper_start) && (body == history.footer_start))
  else:
    let declaration: retained.Declaration = vec.get(before.index.declarations, at)
    let slot: I64 = vec.get(history.slots, at)
    let owner: identity.View = declaration.owner
    if !identity.valid_view(owner, vec.len(before.nodes)):
      false
    else:
      let selected: I64 = codegen.counted_record_index(prepared.range_view.counted, owner.first, counted)
      if declaration.kind == 0:
        if (slot == plan) && (plan < vec.len(history.entries)):
          let entry: Entry = vec.get(history.entries, plan)
          let aligned: Bool = identity.same_declaration(entry.declaration, owner.declaration) && ((entry.plan == plan) && (entry.counted == selected))
          let spans: Bool = span_valid(entry.prototype, history.code_bytes) && span_valid(entry.body, history.code_bytes)
          let positions: Bool = (entry.prototype.start == prototype) && (entry.body.start == body)
          if (selected >= -1) && (aligned && (spans && positions)):
            let next_counted: I64 = if selected >= 0:
              counted + 1
            else:
              counted
            recur(history, before, prepared, at + 1, plan + 1, next_counted, entry.prototype.end, entry.body.end)
          else:
            false
        else:
          false
      else:
        if (slot == -1) && (selected == -1):
          recur(history, before, prepared, at + 1, plan, counted, prototype, body)
        else:
          false

fn wrapper_frames_valid(history: Cache, before: retained.Cache, site_at: I64, task: I64, at: I64, position: I64) -> Bool effects[partial]:
  if site_at >= vec.len(history.sites):
    (at == vec.len(history.wrappers)) && (position == history.body_start)
  else:
    let site: parallel.Site = vec.get(history.sites, site_at)
    if !site.executable:
      recur(history, before, site_at + 1, 0, at, position)
    else:
      if (site.site < 0) || (site.site >= vec.len(before.index.owners)):
        false
      else:
        let slot: I64 = vec.get(before.index.owners, site.site)
        if (slot < 0) || (slot >= vec.len(before.index.declarations)):
          false
        else:
          let declaration: retained.Declaration = vec.get(before.index.declarations, slot)
          if (declaration.kind == 0) && (at < vec.len(history.wrappers)):
            let wrapper: Wrapper = vec.get(history.wrappers, at)
            let params: I64 = syntax.ast_function_parameters(declaration.owner.first)
            let aligned: Bool = identity.same_declaration(wrapper.declaration, declaration.owner.declaration) && ((wrapper.site == (site.site - params)) && (wrapper.task == task))
            let span: Bool = span_valid(wrapper.span, history.code_bytes) && (wrapper.span.start == position)
            if aligned && span:
              if task == 0:
                recur(history, before, site_at, 1, at + 1, wrapper.span.end)
              else:
                recur(history, before, site_at + 1, 0, at + 1, wrapper.span.end)
            else:
              false
          else:
            false

fn cache_ready(history: Cache, code: Bytes, before: retained.Cache, prepared: project.PreparedProject) -> Bool effects[partial]:
  let size: I64 = bytes.len(code)
  let count: I64 = vec.len(before.index.declarations)
  let bounded: Bool = ((count > 0) && (count <= 1000000)) && ((vec.len(history.entries) <= count) && ((vec.len(history.slots) == count) && ((vec.len(history.wrappers) <= 128) && (vec.len(history.sites) <= 64))))
  let code_size: Bool = ((size > 0) && (size <= 67108864)) && (history.code_bytes == size)
  let revision: Bool = identity.same_revision(history.revision, before.index.revision)
  let sections: Bool = (history.prototype_start >= 0) && ((history.prototype_start <= history.wrapper_start) && ((history.wrapper_start <= history.body_start) && ((history.body_start <= history.footer_start) && (history.footer_start < size))))
  if bounded && (code_size && (revision && sections)):
    if metadata_seal(history) == history.seal:
      let counts: Bool = vec.len(history.entries) == vec.len(prepared.plan.functions)
      if counts && entry_frames_valid(history, before, prepared, 0, 0, 0, history.prototype_start, history.body_start):
        wrapper_frames_valid(history, before, 0, 0, 0, history.wrapper_start)
      else:
        false
    else:
      false
  else:
    false

fn reusable_entry(previous: project.PreparedProject, before: retained.Cache, old_code: Bytes, history: Cache, current: project.PreparedProject, checked: retained.Cache, mapping: retained.Update, sites: Vec[parallel.Site], at: I64, plan: I64, counted: I64) -> I64 effects[partial]:
  if retained.same_checked_function(before, checked, mapping, at):
    let previous_slot: I64 = vec.get(mapping.before, at)
    let old_entry: I64 = vec.get(history.slots, previous_slot)
    if (old_entry < 0) || (old_entry >= vec.len(history.entries)):
      -1
    else:
      let entry: Entry = vec.get(history.entries, old_entry)
      let old_declaration: retained.Declaration = vec.get(before.index.declarations, previous_slot)
      let declaration: retained.Declaration = vec.get(checked.index.declarations, at)
      let old_plan: memory.FunctionPlan = vec.get(previous.plan.functions, entry.plan)
      let new_plan: memory.FunctionPlan = vec.get(current.plan.functions, plan)
      let plans: Bool = same_plan(old_plan, new_plan, old_declaration.owner, declaration.owner)
      let counts: Bool = same_counted(previous.range_view.counted, current.range_view.counted, entry.counted, counted, old_declaration.owner, declaration.owner)
      if plans && counts:
        let range_equal: Bool = same_ranges(previous.range_view.facts, current.range_view.facts, old_declaration.owner, declaration.owner, 0)
        let sites_equal: Bool = same_sites(history.sites, sites, old_declaration.owner, declaration.owner, 0, 0)
        if range_equal && sites_equal:
          if span_intact(old_code, entry.prototype) && span_intact(old_code, entry.body):
            old_entry
          else:
            -1
        else:
          -1
      else:
        -1
  else:
    -1

