      vec.push(@entries, row)
      vec.push(@slots, plan)
      vec.push(@reused, prior)
      plan + 1
    else:
      vec.push(@slots, -1)
      plan
    let next_counted: I64 = if selected >= 0:
      counted + 1
    else:
      if selected == -1:
        counted
      else:
        at / 0
    recur(previous, before, old_code, history, current, checked, mapping, sites, eligible, at + 1, next_plan, next_counted, @entries, @slots, @reused)

# The caller has validated the old span. Hash the actual bytes while copying to
# their current positions; no old checksum enters the new artifact checksum.
fn append_checked_bytes(code: Bytes, at: I64, end: I64, position: I64, sum: I64, output: @Vec[U8]) -> I64 effects[alloc, partial]:
  if at >= end:
    sum
  else:
    let byte: U8 = bytes.get(code, at)
    vec.push(@output, byte)
    let next: I64 = position + 1
    let checksum: I64 = sum + (u8.to_i64(byte) * next)
    recur(code, at + 1, end, next, checksum, @output)

fn append_fragment(code: Bytes, span: Span, output: @Vec[U8]) -> I64 effects[alloc, partial]:
  let start: I64 = vec.len(output)
  let length: I64 = span.end - span.start
  if (start <= 67108864) && (length <= (67108864 - start)):
    append_checked_bytes(code, span.start, span.end, start, 0, @output)
  else:
    text.append_span(code, span.start, span.end, @output)
    -1

fn with_prototype(entry: Entry, span: Span) -> Entry:
  Entry(declaration: entry.declaration, plan: entry.plan, counted: entry.counted, prototype: span, body: entry.body)

fn with_body(entry: Entry, span: Span) -> Entry:
  Entry(declaration: entry.declaration, plan: entry.plan, counted: entry.counted, prototype: entry.prototype, body: span)

fn emit_prototypes(old_code: Bytes, history: Cache, current: project.PreparedProject, checked: retained.Cache, reused: Vec[I64], entries: @Vec[Entry], at: I64, output: @Vec[U8]) -> Void effects[alloc, partial]:
  if at >= vec.len(entries):
    text.append_text(@output, "\n")
  else:
    let entry: Entry = vec.get(entries, at)
    let declaration: retained.Declaration = vec.get(checked.index.declarations, entry.declaration.slot)
    let previous: I64 = vec.get(reused, at)
    let start: I64 = vec.len(output)
    let checksum: I64 = if previous >= 0:
      let old_entry: Entry = vec.get(history.entries, previous)
      append_fragment(old_code, old_entry.prototype, @output)
    else:
      codegen.emit_prototype(current.source, current.tokens, declaration.owner.first, @output)
      -1
    let span: Span = Span(start: start, end: vec.len(output), checksum: checksum)
    vec.set(@entries, at, with_prototype(entry, span))
    recur(old_code, history, current, checked, reused, @entries, at + 1, @output)

fn find_wrapper(history: Cache, owner: identity.DeclarationId, site: I64, task: I64, at: I64) -> I64 effects[partial]:
  if at >= vec.len(history.wrappers):
    -1
  else:
    let wrapper: Wrapper = vec.get(history.wrappers, at)
    if identity.same_declaration(wrapper.declaration, owner) && ((wrapper.site == site) && (wrapper.task == task)):
      at
    else:
      recur(history, owner, site, task, at + 1)

fn emit_wrappers(old_code: Bytes, history: Cache, current: project.PreparedProject, checked: retained.Cache, sites: Vec[parallel.Site], reused: Vec[I64], entries: Vec[Entry], slots: Vec[I64], at: I64, task: I64, wrappers: @Vec[Wrapper], output: @Vec[U8]) -> Void effects[alloc, partial]:
  if at >= vec.len(sites):
    void
  else:
    let site: parallel.Site = vec.get(sites, at)
    if !site.executable:
      recur(old_code, history, current, checked, sites, reused, entries, slots, at + 1, 0, @wrappers, @output)
    else:
      let slot: I64 = vec.get(checked.index.owners, site.site)
      let declaration: retained.Declaration = vec.get(checked.index.declarations, slot)
      let entry_index: I64 = vec.get(slots, slot)
      let params: I64 = syntax.ast_function_parameters(declaration.owner.first)
      let local_site: I64 = site.site - params
      let old_entry_index: I64 = vec.get(reused, entry_index)
      let previous: I64 = if old_entry_index >= 0:
        let old_entry: Entry = vec.get(history.entries, old_entry_index)
        find_wrapper(history, old_entry.declaration, local_site, task, 0)
      else:
        -1
      let import: Bool = if previous >= 0:
        let prior: Wrapper = vec.get(history.wrappers, previous)
        span_intact(old_code, prior.span)
      else:
        false
      let start: I64 = vec.len(output)
      let checksum: I64 = if import:
        let prior: Wrapper = vec.get(history.wrappers, previous)
        append_fragment(old_code, prior.span, @output)
      else:
        let expression: I64 = if task == 0:
          site.first
        else:
          site.second
        codegen.emit_parallel_call_wrapper(current.source, current.tokens, current.facts, params, site.site, expression, task, @output)
        -1
      let span: Span = Span(start: start, end: vec.len(output), checksum: checksum)
      vec.push(@wrappers, Wrapper(declaration: declaration.owner.declaration, site: local_site, task: task, span: span))
      if task == 0:
        recur(old_code, history, current, checked, sites, reused, entries, slots, at, 1, @wrappers, @output)
      else:
        recur(old_code, history, current, checked, sites, reused, entries, slots, at + 1, 0, @wrappers, @output)

fn emit_bodies(old_code: Bytes, history: Cache, current: project.PreparedProject, checked: retained.Cache, sites: Vec[parallel.Site], reused: Vec[I64], entries: @Vec[Entry], at: I64, output: @Vec[U8]) -> Void effects[alloc, partial]:
  if at >= vec.len(entries):
    void
  else:
    let entry: Entry = vec.get(entries, at)
    let declaration: retained.Declaration = vec.get(checked.index.declarations, entry.declaration.slot)
    let previous: I64 = vec.get(reused, at)
    let start: I64 = vec.len(output)
    let checksum: I64 = if previous >= 0:
      let old_entry: Entry = vec.get(history.entries, previous)
      append_fragment(old_code, old_entry.body, @output)
    else:
      let plan: memory.FunctionPlan = vec.get(current.plan.functions, entry.plan)
      codegen.emit_function(current.source, current.tokens, current.facts, sites, current.range_view.counted, syntax.ast_module_items(0), declaration.owner.first, plan, entry.counted, @output, current.range_view.facts)
      -1
    let span: Span = Span(start: start, end: vec.len(output), checksum: checksum)
    vec.set(@entries, at, with_body(entry, span))
    recur(old_code, history, current, checked, sites, reused, @entries, at + 1, @output)

fn checksummed_span(code: Bytes, span: Span) -> Span effects[partial]:
  if span.checksum >= 0:
    span
  else:
    Span(start: span.start, end: span.end, checksum: cache.weighted_checksum(code, span.start, span.end, 0))

fn checksum_entries(code: Bytes, entries: @Vec[Entry], at: I64) -> Void effects[partial]:
  if at >= vec.len(entries):
    void
  else:
    let entry: Entry = vec.get(entries, at)
    let prototype: Span = checksummed_span(code, entry.prototype)
    let body: Span = checksummed_span(code, entry.body)
    vec.set(@entries, at, with_body(with_prototype(entry, prototype), body))
    recur(code, @entries, at + 1)

fn checksum_wrappers(code: Bytes, wrappers: @Vec[Wrapper], at: I64) -> Void effects[partial]:
  if at >= vec.len(wrappers):
    void
  else:
    let wrapper: Wrapper = vec.get(wrappers, at)
    let span: Span = checksummed_span(code, wrapper.span)
    vec.set(@wrappers, at, Wrapper(declaration: wrapper.declaration, site: wrapper.site, task: wrapper.task, span: span))
    recur(code, @wrappers, at + 1)

fn assemble(previous: project.PreparedProject, before: retained.Cache, old_code: Bytes, history: Cache, current: project.PreparedProject, checked: retained.Cache, mapping: retained.Update, sites: ^Vec[parallel.Site], eligible: Bool) -> Generated effects[alloc, partial]:
  let entries: Vec[Entry] = vec.new()
  let slots: Vec[I64] = vec.new()
  let reused: Vec[I64] = vec.new()
  build_entries(previous, before, old_code, history, current, checked, mapping, sites, eligible, 0, 0, 0, @entries, @slots, @reused)
  let output: Vec[U8] = vec.new()
  codegen.emit_program_prefix(current.source, current.tokens, current.layouts, sites, @output)
  let prototype_start: I64 = vec.len(output)
  emit_prototypes(old_code, history, current, checked, reused, @entries, 0, @output)
  let wrapper_start: I64 = vec.len(output)
  let wrappers: Vec[Wrapper] = vec.new()
  emit_wrappers(old_code, history, current, checked, sites, reused, entries, slots, 0, 0, @wrappers, @output)
  let body_start: I64 = vec.len(output)
  emit_bodies(old_code, history, current, checked, sites, reused, @entries, 0, @output)
  let footer_start: I64 = vec.len(output)
  codegen.emit_program_footer(@output)
  let code: Bytes = bytes.freeze(^output)
  let length: I64 = bytes.len(code)
  let next: Cache = if (length > 0) && (length <= 67108864):
    checksum_entries(code, @entries, 0)
    checksum_wrappers(code, @wrappers, 0)
    let next: Cache = Cache(revision: checked.index.revision, entries: entries, slots: slots, wrappers: wrappers, sites: sites, prototype_start: prototype_start, wrapper_start: wrapper_start, body_start: body_start, footer_start: footer_start, code_bytes: length, seal: 0)
    seal_cache(^next)
  else:
    empty_cache()
  let checksum: I64 = if (length > 0) && (next.code_bytes == length):
    assembly_checksum(code, next)
  else:
    -1
  Generated(code: code, history: next, checksum: checksum)

fn generate(previous: project.PreparedProject, before: retained.Cache, old_code: Bytes, history: Cache, current: project.PreparedProject, checked: retained.Cache, mapping: retained.Update, eligible: Bool, limit: I64) -> Generated effects[alloc, partial]:
  let ready: Bool = prepared_ready(current, checked) && ((limit >= 1) && (limit <= 1000000))
  if ready:
    let analysis: parallel.View = parallel.analyze(current.source, current.tokens, current.facts, current.range_view)
    let sites: Vec[parallel.Site] = mem.replace(@analysis.sites, vec.new())
    let records: I64 = (vec.len(checked.index.declarations) + vec.len(current.plan.functions)) + (3 * vec.len(sites))
    if (records <= limit) && (vec.len(sites) <= 64):
      let reuse: Bool = if eligible && retained.transition_ready(before, checked, mapping):
        if prepared_ready(previous, before):
          cache_ready(history, old_code, before, previous)
        else:
          false
      else:
        false
      assemble(previous, before, old_code, history, current, checked, mapping, ^sites, reuse)
    else:
      let output: Vec[U8] = vec.new()
      codegen.emit_program_sites(current.source, current.tokens, current.facts, current.plan, current.layouts, current.range_view, sites, @output)
      Generated(code: bytes.freeze(^output), history: empty_cache(), checksum: -1)
  else:
    Generated(code: project.generate_prepared_project(current), history: empty_cache(), checksum: -1)

fn seal_cache(history: ^Cache) -> Cache effects[alloc, partial]:
  let seal: I64 = metadata_seal(history)
  let entries: Vec[Entry] = mem.replace(@history.entries, vec.new())
  let slots: Vec[I64] = mem.replace(@history.slots, vec.new())
  let wrappers: Vec[Wrapper] = mem.replace(@history.wrappers, vec.new())
  let sites: Vec[parallel.Site] = mem.replace(@history.sites, vec.new())
  Cache(revision: history.revision, entries: entries, slots: slots, wrappers: wrappers, sites: sites, prototype_start: history.prototype_start, wrapper_start: history.wrapper_start, body_start: history.body_start, footer_start: history.footer_start, code_bytes: history.code_bytes, seal: seal)

fn rebase_entries(old: Vec[Entry], checked: retained.Cache, at: I64, output: @Vec[Entry]) -> Void effects[alloc, partial]:
  if at >= vec.len(old):
    void
  else:
    let entry: Entry = vec.get(old, at)
    let declaration: retained.Declaration = vec.get(checked.index.declarations, entry.declaration.slot)
    vec.push(@output, Entry(declaration: declaration.owner.declaration, plan: entry.plan, counted: entry.counted, prototype: entry.prototype, body: entry.body))
    recur(old, checked, at + 1, @output)

fn rebase_wrappers(old: Vec[Wrapper], checked: retained.Cache, at: I64, output: @Vec[Wrapper]) -> Void effects[alloc, partial]:
  if at >= vec.len(old):
    void
  else:
    let wrapper: Wrapper = vec.get(old, at)
    let declaration: retained.Declaration = vec.get(checked.index.declarations, wrapper.declaration.slot)
    vec.push(@output, Wrapper(declaration: declaration.owner.declaration, site: wrapper.site, task: wrapper.task, span: wrapper.span))
    recur(old, checked, at + 1, @output)

fn copy_slots(old: Vec[I64], at: I64, output: @Vec[I64]) -> Void effects[alloc, partial]:
  if at >= vec.len(old):
    void
  else:
    vec.push(@output, vec.get(old, at))
    recur(old, at + 1, @output)

fn copy_sites(old: Vec[parallel.Site], at: I64, output: @Vec[parallel.Site]) -> Void effects[alloc, partial]:
  if at >= vec.len(old):
    void
  else:
    vec.push(@output, vec.get(old, at))
    recur(old, at + 1, @output)

fn identical_positions(before: retained.Cache, checked: retained.Cache, at: I64) -> Bool effects[partial]:
  if at >= vec.len(before.index.declarations):
    vec.len(before.index.declarations) == vec.len(checked.index.declarations)
  else:
    if at < vec.len(checked.index.declarations):
      let old: retained.Declaration = vec.get(before.index.declarations, at)
      let current: retained.Declaration = vec.get(checked.index.declarations, at)
      let position: Bool = (old.owner.first == current.owner.first) && (old.owner.count == current.owner.count)
      let name: Bool = (old.kind == current.kind) && retained.equal(old.name, current.name)
      if position && name:
        recur(before, checked, at + 1)
      else:
        false
    else:
      false

# The session has already accepted whole-artifact reuse under identical flattened
# source and configuration. Rebind only metadata; do not generate or copy C.
fn rebase(history: Cache, code: Bytes, previous: project.PreparedProject, before: retained.Cache, current: project.PreparedProject, checked: retained.Cache) -> Cache effects[alloc, partial]:
  if prepared_ready(previous, before) && prepared_ready(current, checked):
    if retained.equal(previous.source, current.source) && identical_positions(before, checked, 0):
      if cache_ready(history, code, before, previous):
        let entries: Vec[Entry] = vec.new()
        let slots: Vec[I64] = vec.new()
        let wrappers: Vec[Wrapper] = vec.new()
        let sites: Vec[parallel.Site] = vec.new()
        rebase_entries(history.entries, checked, 0, @entries)
        copy_slots(history.slots, 0, @slots)
        rebase_wrappers(history.wrappers, checked, 0, @wrappers)
        copy_sites(history.sites, 0, @sites)
        let next: Cache = Cache(revision: checked.index.revision, entries: entries, slots: slots, wrappers: wrappers, sites: sites, prototype_start: history.prototype_start, wrapper_start: history.wrapper_start, body_start: history.body_start, footer_start: history.footer_start, code_bytes: history.code_bytes, seal: 0)
        seal_cache(^next)
      else:
        empty_cache()
    else:
      empty_cache()
  else:
    empty_cache()

# Only freshly checksummed, emitter-owned intervals enter these sums. They are
# disjoint parts of one at-most-64-MiB artifact, so every nonnegative partial sum
# is bounded by 256 * n * (n + 1) / 2 < 2^63. No optional-history checksum is
# trusted here: each value was computed from actual bytes during the current
# copy or by checksummed_span after the sole producer wrote fresh bytes.
fn entry_checksum_sum(entries: Vec[Entry], at: I64, sum: I64) -> I64 effects[partial]:
  if at >= vec.len(entries):
    sum
  else:
    let entry: Entry = vec.get(entries, at)
    recur(entries, at + 1, (sum + entry.prototype.checksum) + entry.body.checksum)

fn wrapper_checksum_sum(wrappers: Vec[Wrapper], at: I64, sum: I64) -> I64 effects[partial]:
  if at >= vec.len(wrappers):
    sum
  else:
    let wrapper: Wrapper = vec.get(wrappers, at)
    recur(wrappers, at + 1, sum + wrapper.span.checksum)

# Prototype spans exclude the one trailing newline. The sole section sequence
# covers header, prototypes, newline, wrappers, bodies and footer exactly once.
fn assembly_checksum(code: Bytes, history: Cache) -> I64 effects[partial]:
  let prefix: I64 = cache.weighted_checksum(code, 0, history.prototype_start, 0)
  let separator: I64 = cache.weighted_checksum(code, history.wrapper_start - 1, history.wrapper_start, prefix)
  let footer: I64 = cache.weighted_checksum(code, history.footer_start, history.code_bytes, separator)
  let entries: I64 = entry_checksum_sum(history.entries, 0, footer)
  wrapper_checksum_sum(history.wrappers, 0, entries)
