fn verify_paths(original_path: Bytes candidate_path: Bytes) -> I64 effects[alloc io partial]:
  let original_project: Bool = project/path_is_project(original_path)
  let candidate_project: Bool = project/path_is_project(candidate_path)
  let any_project: Bool = bool.or(original_project candidate_project)
  match any_project:
    true:
      let shown: Unit = io.println("E0410@0:0")
      1
    false:
      let original_checked: I64 = check/check_path_all(original_path)
      let original_invalid: Bool = i64.gt(original_checked 0)
      match original_invalid:
        true:
          original_checked
        false:
          let candidate_checked: I64 = check/check_path_all(candidate_path)
          let candidate_invalid: Bool = i64.gt(candidate_checked 0)
          match candidate_invalid:
            true:
              candidate_checked
            false:
              let original_bytes: Vec[U8] = vec.new()
              let original_read: Bool = io.read-file(original_path original_bytes)
              let candidate_bytes: Vec[U8] = vec.new()
              let candidate_read: Bool = io.read-file(candidate_path candidate_bytes)
              let both_read: Bool = bool.and(original_read candidate_read)
              match both_read:
                false:
                  let shown: Unit = io.println("E0409@0:0")
                  1
                true:
                  let original: Bytes = bytes.freeze(original_bytes)
                  let candidate: Bytes = bytes.freeze(candidate_bytes)
                  let output: Vec[U8] = vec.new()
                  let verified: Unit = proof/verify(original candidate output)
                  let result: Bytes = bytes.freeze(output)
                  let shown: Unit = io.print-bytes(result)
                  0

fn equivalent_paths(left_path: Bytes right_path: Bytes) -> I64 effects[alloc io partial]:
  let left_project: Bool = project/path_is_project(left_path)
  let right_project: Bool = project/path_is_project(right_path)
  let any_project: Bool = bool.or(left_project right_project)
  match any_project:
    true:
      let shown: Unit = io.println("E0410@0:0")
      1
    false:
      let left_checked: I64 = check/check_path_all(left_path)
      let left_invalid: Bool = i64.gt(left_checked 0)
      match left_invalid:
        true:
          left_checked
        false:
          let right_checked: I64 = check/check_path_all(right_path)
          let right_invalid: Bool = i64.gt(right_checked 0)
          match right_invalid:
            true:
              right_checked
            false:
              let left_bytes: Vec[U8] = vec.new()
              let left_read: Bool = io.read-file(left_path left_bytes)
              let right_bytes: Vec[U8] = vec.new()
              let right_read: Bool = io.read-file(right_path right_bytes)
              let both_read: Bool = bool.and(left_read right_read)
              match both_read:
                false:
                  let shown: Unit = io.println("E0409@0:0")
                  1
                true:
                  let left: Bytes = bytes.freeze(left_bytes)
                  let right: Bytes = bytes.freeze(right_bytes)
                  let left_tokens: Vec[syntax/Token] = vec.new()
                  let left_parsed: Bool = syntax/parse_program(left left_tokens)
                  let right_tokens: Vec[syntax/Token] = vec.new()
                  let right_parsed: Bool = syntax/parse_program(right right_tokens)
                  let output: Vec[U8] = vec.new()
                  let compared: Unit = equivalence/emit_comparison(left left_tokens right right_tokens output)
                  let result: Bytes = bytes.freeze(output)
                  let shown: Unit = io.print-bytes(result)
                  0

