fn verify_paths(original_path: Bytes, candidate_path: Bytes) -> I64 effects[alloc, io, partial]:
  let original_project: Bool = project.path_is_project(original_path)
  let candidate_project: Bool = project.path_is_project(candidate_path)
  let any_project: Bool = original_project || candidate_project
  if any_project:
    io.println("E0410@0:0")
    1
  else:
    let original_checked: I64 = check.check_path_all(original_path)
    let original_invalid: Bool = original_checked > 0
    if original_invalid:
      original_checked
    else:
      let candidate_checked: I64 = check.check_path_all(candidate_path)
      let candidate_invalid: Bool = candidate_checked > 0
      if candidate_invalid:
        candidate_checked
      else:
        let original_bytes: Vec[U8] = vec.new()
        let original_read: Bool = io.read_file(original_path, original_bytes)
        let candidate_bytes: Vec[U8] = vec.new()
        let candidate_read: Bool = io.read_file(candidate_path, candidate_bytes)
        let both_read: Bool = original_read && candidate_read
        if both_read:
          let original: Bytes = bytes.freeze(original_bytes)
          let candidate: Bytes = bytes.freeze(candidate_bytes)
          let output: Vec[U8] = vec.new()
          proof.verify(original, candidate, output)
          let result: Bytes = bytes.freeze(output)
          io.print_bytes(result)
          0
        else:
          io.println("E0409@0:0")
          1

fn equivalent_paths(left_path: Bytes, right_path: Bytes) -> I64 effects[alloc, io, partial]:
  let left_project: Bool = project.path_is_project(left_path)
  let right_project: Bool = project.path_is_project(right_path)
  let any_project: Bool = left_project || right_project
  if any_project:
    io.println("E0410@0:0")
    1
  else:
    let left_checked: I64 = check.check_path_all(left_path)
    let left_invalid: Bool = left_checked > 0
    if left_invalid:
      left_checked
    else:
      let right_checked: I64 = check.check_path_all(right_path)
      let right_invalid: Bool = right_checked > 0
      if right_invalid:
        right_checked
      else:
        let left_bytes: Vec[U8] = vec.new()
        let left_read: Bool = io.read_file(left_path, left_bytes)
        let right_bytes: Vec[U8] = vec.new()
        let right_read: Bool = io.read_file(right_path, right_bytes)
        let both_read: Bool = left_read && right_read
        if both_read:
          let left: Bytes = bytes.freeze(left_bytes)
          let right: Bytes = bytes.freeze(right_bytes)
          let left_tokens: Vec[syntax.Token] = vec.new()
          let left_parsed: Bool = syntax.parse_program(left, left_tokens)
          let right_tokens: Vec[syntax.Token] = vec.new()
          let right_parsed: Bool = syntax.parse_program(right, right_tokens)
          let output: Vec[U8] = vec.new()
          equivalence.emit_comparison(left, left_tokens, right, right_tokens, output)
          let result: Bytes = bytes.freeze(output)
          io.print_bytes(result)
          0
        else:
          io.println("E0409@0:0")
          1

fn edit_paths(source_path: Bytes, patch_path: Bytes) -> I64 effects[alloc, io, partial]:
  let project_input: Bool = project.path_is_project(source_path)
  if project_input:
    io.println("E0410@0:0")
    1
  else:
    let checked: I64 = check.check_path_all(source_path)
    let invalid: Bool = checked > 0
    if invalid:
      checked
    else:
      let source_bytes: Vec[U8] = vec.new()
      let source_read: Bool = io.read_file(source_path, source_bytes)
      let patch_bytes: Vec[U8] = vec.new()
      let patch_read: Bool = io.read_file(patch_path, patch_bytes)
      let both_read: Bool = source_read && patch_read
      if both_read:
        let source: Bytes = bytes.freeze(source_bytes)
        let patch: Bytes = bytes.freeze(patch_bytes)
        let tokens: Vec[syntax.Token] = vec.new()
        let parsed: Bool = syntax.parse_program(source, tokens)
        let output: Vec[U8] = vec.new()
        let edited: Bool = edit.emit_candidate(source, tokens, patch, output)
        if edited:
          let result: Bytes = bytes.freeze(output)
          io.print_bytes(result)
          0
        else:
          io.println("E0411@0:0")
          1
      else:
        io.println("E0409@0:0")
        1

fn run_proof_command(inout args: Vec[Bytes], arg_count: I64) -> I64 effects[alloc, io, partial]:
  let enough: Bool = arg_count >= 3
  if enough:
    let source_path: Bytes = vec.get(args, 2)
    proof_path(source_path)
  else:
    io.println("usage: slimc prove-reduction SOURCE")
    64

fn run_verify_command(inout args: Vec[Bytes], arg_count: I64) -> I64 effects[alloc, io, partial]:
  let enough: Bool = arg_count >= 4
  if enough:
    let original_path: Bytes = vec.get(args, 2)
    let candidate_path: Bytes = vec.get(args, 3)
    verify_paths(original_path, candidate_path)
  else:
    io.println("usage: slimc verify-reduction ORIGINAL REDUCED")
    64

fn run_equivalent_command(inout args: Vec[Bytes], arg_count: I64) -> I64 effects[alloc, io, partial]:
  let enough: Bool = arg_count >= 4
  if enough:
    let left_path: Bytes = vec.get(args, 2)
    let right_path: Bytes = vec.get(args, 3)
    equivalent_paths(left_path, right_path)
  else:
    io.println("usage: slimc equivalent LEFT RIGHT")
    64

fn run_edit_command(inout args: Vec[Bytes], arg_count: I64) -> I64 effects[alloc, io, partial]:
  let enough: Bool = arg_count >= 4
  if enough:
    let source_path: Bytes = vec.get(args, 2)
    let patch_path: Bytes = vec.get(args, 3)
    edit_paths(source_path, patch_path)
  else:
    io.println("usage: slimc edit SOURCE PATCH")
    64

fn run_evidence(inout args: Vec[Bytes], arg_count: I64, command: Bytes) -> I64 effects[alloc, io, partial]:
  let command_length: I64 = bytes.len(command)
  let proving: Bool = syntax.span_equal(command, 0, command_length, "prove-reduction")
  if proving:
    run_proof_command(args, arg_count)
  else:
    let verifying: Bool = syntax.span_equal(command, 0, command_length, "verify-reduction")
    if verifying:
      run_verify_command(args, arg_count)
    else:
      let comparing: Bool = syntax.span_equal(command, 0, command_length, "equivalent")
      if comparing:
        run_equivalent_command(args, arg_count)
      else:
        run_edit_command(args, arg_count)

fn compile_command_path(inout args: Vec[Bytes], arg_count: I64, path: Bytes) -> I64 effects[alloc, io, partial]:
  let project: Bool = project.path_is_project(path)
  if project:
    let enough: Bool = arg_count >= 4
    let scheduled: Bool = if enough:
      let option: Bytes = vec.get(args, 2)
      let option_length: I64 = bytes.len(option)
      syntax.span_equal(option, 0, option_length, "--jobs")
    else:
      false
    let jobs: I64 = if scheduled:
      let requested: Bytes = vec.get(args, 3)
      scheduler.parse_jobs(requested)
    else:
      1
    project.compile_project_path_jobs(path, jobs)
  else:
    compile_path(path)

fn run_compile(inout args: Vec[Bytes], arg_count: I64, path: Bytes) -> I64 effects[alloc, io, partial]:
  let length: I64 = bytes.len(path)
  let proving: Bool = syntax.span_equal(path, 0, length, "prove-reduction")
  let verifying: Bool = syntax.span_equal(path, 0, length, "verify-reduction")
  let comparing: Bool = syntax.span_equal(path, 0, length, "equivalent")
  let editing: Bool = syntax.span_equal(path, 0, length, "edit")
  let first: Bool = proving || verifying
  let second: Bool = comparing || editing
  let evidence: Bool = first || second
  if evidence:
    run_evidence(args, arg_count, path)
  else:
    compile_command_path(args, arg_count, path)

fn run_cache(inout args: Vec[Bytes], arg_count: I64) -> I64 effects[alloc, io, partial]:
  let has_paths: Bool = arg_count >= 4
  if has_paths:
    let manifest_path: Bytes = vec.get(args, 2)
    let cache_path: Bytes = vec.get(args, 3)
    cache.run(manifest_path, cache_path)
  else:
    io.println("usage: slimc cache MANIFEST CACHE")
    64

fn run_session(inout args: Vec[Bytes], arg_count: I64) -> I64 effects[alloc, io, partial]:
  let has_paths: Bool = arg_count >= 4
  if has_paths:
    let initial_path: Bytes = vec.get(args, 2)
    let updated_path: Bytes = vec.get(args, 3)
    let recovering: Bool = arg_count >= 5
    if recovering:
      let recovered_path: Bytes = vec.get(args, 4)
      session.run_recovery(initial_path, updated_path, recovered_path)
    else:
      session.run(initial_path, updated_path)
  else:
    io.println("usage: slimc session INITIAL UPDATED [RECOVERED]")
    64

fn run_transform(inout args: Vec[Bytes], arg_count: I64, analysis_mode: Bool, usage: Bytes) -> I64 effects[alloc, io, partial]:
  let has_source: Bool = arg_count >= 3
  if has_source:
    let source_path: Bytes = vec.get(args, 2)
    transform_path(source_path, analysis_mode)
  else:
    io.println(usage)
    64

fn run(args: Vec[Bytes]) -> I64 effects[alloc, io, partial]:
  let arg_count: I64 = vec.len(args)
  let enough: Bool = arg_count >= 2
  if enough:
    let command: Bytes = vec.get(args, 1)
    let command_length: I64 = bytes.len(command)
    let formatting: Bool = syntax.span_equal(command, 0, command_length, "fmt")
    if formatting:
      let has_path: Bool = arg_count >= 3
      if has_path:
        let path: Bytes = vec.get(args, 2)
        format_path(path)
      else:
        io.println("usage: slimc fmt SOURCE")
        64
    else:
      let checking: Bool = syntax.span_equal(command, 0, command_length, "check")
      if checking:
        let has_source: Bool = arg_count >= 3
        if has_source:
          let source_path: Bytes = vec.get(args, 2)
          check_input_path(source_path)
        else:
          io.println("usage: slimc check SOURCE")
          64
      else:
        let reducing: Bool = syntax.span_equal(command, 0, command_length, "reduce")
        if reducing:
          run_transform(args, arg_count, false, "usage: slimc reduce SOURCE")
        else:
          let analyzing: Bool = syntax.span_equal(command, 0, command_length, "analyze")
          if analyzing:
            run_transform(args, arg_count, true, "usage: slimc analyze SOURCE")
          else:
            let interface_command: Bool = syntax.span_equal(command, 0, command_length, "interfaces")
            if interface_command:
              let has_manifest: Bool = arg_count >= 3
              if has_manifest:
                let manifest_path: Bytes = vec.get(args, 2)
                project.interfaces_path(manifest_path)
              else:
                io.println("usage: slimc interfaces MANIFEST")
                64
            else:
              let cache_command: Bool = syntax.span_equal(command, 0, command_length, "cache")
              if cache_command:
                run_cache(args, arg_count)
              else:
                let session_command: Bool = syntax.span_equal(command, 0, command_length, "session")
                if session_command:
                  run_session(args, arg_count)
                else:
                  run_compile(args, arg_count, command)
  else:
    io.println("usage: slimc SOURCE | slimc check SOURCE | slimc fmt SOURCE | slimc reduce SOURCE | slimc analyze SOURCE")
    64
