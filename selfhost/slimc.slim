module compiler

fn check_input_path(path: Bytes) -> I64 effects[alloc, io, partial]:
  let project: Bool = project.path_is_project(path)
  if project:
    project.check_project_path(path)
  else:
    check.check_path_all(path)

fn format_path(path: Bytes) -> I64 effects[alloc, io, partial]:
  let project: Bool = project.path_is_project(path)
  let input_bytes: Vec[U8] = vec.new()
  let input_read: Bool = io.read_file(path, input_bytes)
  if input_read:
    let input: Bytes = bytes.freeze(input_bytes)
    if project:
      let status: I64 = project.check_project_path(path)
      let invalid: Bool = status > 0
      if invalid:
        status
      else:
        io.print_bytes(input)
        0
    else:
      let tokens: Vec[syntax.Token] = vec.new()
      let parsed: syntax.ProgramParse = syntax.parse_program_result(input, tokens)
      if parsed.valid:
        let valid: Bool = validate.module_shape_valid(input, tokens)
        if valid:
          let output: Vec[U8] = vec.new()
          format.emit_module(input, tokens, output)
          let bytes: Bytes = bytes.freeze(output)
          io.print_bytes(bytes)
          0
        else:
          io.println("E0102@0:0")
          1
      else:
        check.report_program_parse(parsed)
  else:
    io.println("E0409@0:0")
    1

fn analyze_project_path(path: Bytes) -> I64 effects[alloc, io, partial]:
  let prepared: project.PreparedProject = project.prepare_project_path(path)
  let status: I64 = prepared.status
  let invalid: Bool = status > 0
  if invalid:
    status
  else:
    let source: Bytes = prepared.source
    let tokens: Vec[syntax.Token] = prepared.tokens
    let typed_facts: Vec[typing.Fact] = prepared.facts
    let output: Vec[U8] = vec.new()
    analysis.emit_module(source, tokens, typed_facts, output)
    let result: Bytes = bytes.freeze(output)
    io.print_bytes(result)
    0

fn transform_path(path: Bytes, analysis_mode: Bool) -> I64 effects[alloc, io, partial]:
  let project: Bool = project.path_is_project(path)
  if project:
    if analysis_mode:
      analyze_project_path(path)
    else:
      io.println("E0410@0:0")
      1
  else:
    let input_bytes: Vec[U8] = vec.new()
    let input_read: Bool = io.read_file(path, input_bytes)
    if input_read:
      let input: Bytes = bytes.freeze(input_bytes)
      let tokens: Vec[syntax.Token] = vec.new()
      let parsed: syntax.ProgramParse = syntax.parse_program_result(input, tokens)
      if parsed.valid:
        let checked: typing.Checked = check.check_source(input, tokens)
        let status: I64 = checked.status
        let invalid: Bool = status > 0
        if invalid:
          status
        else:
          let view: typing.View = checked.view
          let typed_facts: Vec[typing.Fact] = view.facts
          let output: Vec[U8] = vec.new()
          if analysis_mode:
            analysis.emit_module(input, tokens, typed_facts, output)
          else:
            reduce.emit_normal_form(input, output)
          let result: Bytes = bytes.freeze(output)
          io.print_bytes(result)
          0
      else:
        check.report_program_parse(parsed)
    else:
      io.println("E0409@0:0")
      1

