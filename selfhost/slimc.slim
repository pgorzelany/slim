      let parsed: syntax.ProgramParse = syntax.parse_program_result(input, tokens)
      if parsed.valid:
        let checked: typing.Checked = check.check_source(input, tokens)
        let status: I64 = checked.status
        let invalid: Bool = status > 0
        if invalid:
          status
        else:
          let view: typing.View = checked.view
          let facts: Vec[typing.Fact] = view.facts
          let plan: memory.Plan = checked.plan
          let output: Vec[U8] = vec.new()
          codegen.emit_program(input, tokens, facts, plan, output)
          let generated: Bytes = bytes.freeze(output)
          io.print_bytes(generated)
          0
      else:
