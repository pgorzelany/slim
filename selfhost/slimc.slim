      edit_paths(source_path patch_path)

fn run_evidence(inout args: Vec[Bytes] arg_count: I64 command: Bytes) -> I64 effects[alloc io partial]:
  let command_length: I64 = bytes.len(command)
  let proving: Bool = syntax/span_equal(command 0 command_length "prove-reduction")
  match proving:
    true:
      run_proof_command(args arg_count)
    false:
      let verifying: Bool = syntax/span_equal(command 0 command_length "verify-reduction")
      match verifying:
        true:
          run_verify_command(args arg_count)
        false:
          let comparing: Bool = syntax/span_equal(command 0 command_length "equivalent")
          match comparing:
            true:
              run_equivalent_command(args arg_count)
            false:
              run_edit_command(args arg_count)

fn compile_command_path(inout args: Vec[Bytes] arg_count: I64 path: Bytes) -> I64 effects[alloc io partial]:
  let project: Bool = project/path_is_project(path)
  match project:
    false:
      compile_path(path)
    true:
      let enough: Bool = i64.ge(arg_count 4)
      let scheduled: Bool = match enough:
        false:
          false
        true:
          let option: Bytes = vec.get(args 2)
          let option_length: I64 = bytes.len(option)
          syntax/span_equal(option 0 option_length "--jobs")
      let jobs: I64 = match scheduled:
        false:
          1
        true:
          let requested: Bytes = vec.get(args 3)
          scheduler/parse_jobs(requested)
      project/compile_project_path_jobs(path jobs)

fn run_compile(inout args: Vec[Bytes] arg_count: I64 path: Bytes) -> I64 effects[alloc io partial]:
  let length: I64 = bytes.len(path)
  let proving: Bool = syntax/span_equal(path 0 length "prove-reduction")
  let verifying: Bool = syntax/span_equal(path 0 length "verify-reduction")
  let comparing: Bool = syntax/span_equal(path 0 length "equivalent")
  let editing: Bool = syntax/span_equal(path 0 length "edit")
  let first: Bool = bool.or(proving verifying)
  let second: Bool = bool.or(comparing editing)
  let evidence: Bool = bool.or(first second)
  match evidence:
    true:
      run_evidence(args arg_count path)
    false:
      compile_command_path(args arg_count path)

fn run_cache(inout args: Vec[Bytes] arg_count: I64) -> I64 effects[alloc io partial]:
  let has_paths: Bool = i64.ge(arg_count 4)
  match has_paths:
    false:
      let usage: Unit = io.println("usage: slimc cache MANIFEST CACHE")
      64
    true:
      let manifest_path: Bytes = vec.get(args 2)
      let cache_path: Bytes = vec.get(args 3)
      cache/run(manifest_path cache_path)

fn run_session(inout args: Vec[Bytes] arg_count: I64) -> I64 effects[alloc io partial]:
  let has_paths: Bool = i64.ge(arg_count 4)
  match has_paths:
    false:
      let usage: Unit = io.println("usage: slimc session INITIAL UPDATED [RECOVERED]")
      64
    true:
      let initial_path: Bytes = vec.get(args 2)
      let updated_path: Bytes = vec.get(args 3)
      let recovering: Bool = i64.ge(arg_count 5)
      match recovering:
        false:
          session/run(initial_path updated_path)
        true:
          let recovered_path: Bytes = vec.get(args 4)
          session/run_recovery(initial_path updated_path recovered_path)

fn run_transform(inout args: Vec[Bytes] arg_count: I64 analysis_mode: Bool usage: Bytes) -> I64 effects[alloc io partial]:
  let has_source: Bool = i64.ge(arg_count 3)
  match has_source:
    false:
      let shown: Unit = io.println(usage)
      64
    true:
      let source_path: Bytes = vec.get(args 2)
      transform_path(source_path analysis_mode)

fn run(args: Vec[Bytes]) -> I64 effects[alloc io partial]:
  let arg_count: I64 = vec.len(args)
  let enough: Bool = i64.ge(arg_count 2)
  match enough:
    false:
      let usage: Unit = io.println("usage: slimc SOURCE | slimc check SOURCE | slimc fmt SOURCE | slimc reduce SOURCE | slimc analyze SOURCE")
      64
    true:
      let command: Bytes = vec.get(args 1)
      let command_length: I64 = bytes.len(command)
      let formatting: Bool = syntax/span_equal(command 0 command_length "fmt")
      match formatting:
        true:
          let has_path: Bool = i64.ge(arg_count 3)
          match has_path:
            true:
              let path: Bytes = vec.get(args 2)
              format_path(path)
            false:
              let usage: Unit = io.println("usage: slimc fmt SOURCE")
              64
        false:
          let checking: Bool = syntax/span_equal(command 0 command_length "check")
          match checking:
            true:
              let has_source: Bool = i64.ge(arg_count 3)
              match has_source:
                true:
                  let source_path: Bytes = vec.get(args 2)
                  check_input_path(source_path)
                false:
                  let usage: Unit = io.println("usage: slimc check SOURCE")
                  64
            false:
              let reducing: Bool = syntax/span_equal(command 0 command_length "reduce")
              match reducing:
                true:
                  run_transform(args arg_count false "usage: slimc reduce SOURCE")
                false:
                  let analyzing: Bool = syntax/span_equal(command 0 command_length "analyze")
                  match analyzing:
                    true:
                      run_transform(args arg_count true "usage: slimc analyze SOURCE")
                    false:
                      let interface_command: Bool = syntax/span_equal(command 0 command_length "interfaces")
                      match interface_command:
                        true:
                          let has_manifest: Bool = i64.ge(arg_count 3)
                          match has_manifest:
                            true:
                              let manifest_path: Bytes = vec.get(args 2)
                              project/interfaces_path(manifest_path)
                            false:
                              let usage: Unit = io.println("usage: slimc interfaces MANIFEST")
                              64
                        false:
                          let cache_command: Bool = syntax/span_equal(command 0 command_length "cache")
                          match cache_command:
                            true:
                              run_cache(args arg_count)
                            false:
                              let session_command: Bool = syntax/span_equal(command 0 command_length "session")
                              match session_command:
                                true:
                                  run_session(args arg_count)
                                false:
                                  run_compile(args arg_count command)
