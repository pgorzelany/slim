module compiler

fn check_input_path(path: Bytes) -> I64 effects[alloc io partial]:
  let project: Bool = project/path_is_project(path)
  match project:
    true:
      project/check_project_path(path)
    false:
      check/check_path_all(path)

fn format_path(path: Bytes) -> I64 effects[alloc io partial]:
  let project: Bool = project/path_is_project(path)
  let input_bytes: Vec[U8] = vec.new()
  let input_read: Bool = io.read-file(path input_bytes)
  match input_read:
    false:
      let shown: Unit = io.println("E0409@0:0")
      1
    true:
      let input: Bytes = bytes.freeze(input_bytes)
      match project:
        true:
          let status: I64 = project/check_project_path(path)
          let invalid: Bool = i64.gt(status 0)
          match invalid:
            true:
              status
            false:
              let shown: Unit = io.print-bytes(input)
              0
        false:
          let tokens: Vec[syntax/Token] = vec.new()
          let parsed: syntax/ProgramParse = syntax/parse_program_result(input tokens)
          match get(parsed valid):
            false:
              check/report_program_parse(parsed)
            true:
              let valid: Bool = validate/module_shape_valid(input tokens)
              match valid:
                false:
                  let shown: Unit = io.println("E0102@0:0")
                  1
                true:
                  let output: Vec[U8] = vec.new()
                  let formatted: Unit = format/emit_module(input tokens output)
                  let bytes: Bytes = bytes.freeze(output)
                  let shown: Unit = io.print-bytes(bytes)
                  0

fn analyze_project_path(path: Bytes) -> I64 effects[alloc io partial]:
  let prepared: project/PreparedProject = project/prepare_project_path(path)
  let status: I64 = get(prepared status)
  let invalid: Bool = i64.gt(status 0)
  match invalid:
    true:
      status
    false:
      let source: Bytes = get(prepared source)
      let tokens: Vec[syntax/Token] = get(prepared tokens)
      let typed_facts: Vec[typing/Fact] = get(prepared facts)
      let output: Vec[U8] = vec.new()
      let analyzed: Unit = analysis/emit_module(source tokens typed_facts output)
      let result: Bytes = bytes.freeze(output)
      let shown: Unit = io.print-bytes(result)
      0

fn transform_path(path: Bytes analysis_mode: Bool) -> I64 effects[alloc io partial]:
  let project: Bool = project/path_is_project(path)
  match project:
    true:
      match analysis_mode:
        true:
          analyze_project_path(path)
        false:
          let shown: Unit = io.println("E0410@0:0")
          1
    false:
      let input_bytes: Vec[U8] = vec.new()
      let input_read: Bool = io.read-file(path input_bytes)
      match input_read:
        false:
          let shown: Unit = io.println("E0409@0:0")
          1
        true:
          let input: Bytes = bytes.freeze(input_bytes)
          let tokens: Vec[syntax/Token] = vec.new()
          let parsed: syntax/ProgramParse = syntax/parse_program_result(input tokens)
          match get(parsed valid):
            false:
              check/report_program_parse(parsed)
            true:
              let checked: typing/Checked = check/check_source(input tokens)
              let status: I64 = get(checked status)
              let invalid: Bool = i64.gt(status 0)
              match invalid:
                true:
                  status
                false:
                  let view: typing/View = get(checked view)
                  let typed_facts: Vec[typing/Fact] = get(view facts)
                  let output: Vec[U8] = vec.new()
                  let transformed: Unit = match analysis_mode:
                    true:
                      analysis/emit_module(input tokens typed_facts output)
                    false:
                      reduce/emit_normal_form(input output)
                  let result: Bytes = bytes.freeze(output)
                  let shown: Unit = io.print-bytes(result)
                  0

