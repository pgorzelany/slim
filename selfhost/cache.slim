module cache

record Key:
  valid: Bool
  bytes: Bytes

record Number:
  valid: Bool
  value: I64
  next: I64

record Probe:
  valid: Bool
  artifact_start: I64
  artifact_end: I64

fn valid_number(value: I64 next: I64) -> Number:
  make Number(valid = true value = value next = next)

fn invalid_number(next: I64) -> Number:
  make Number(valid = false value = 0 next = next)

fn invalid_key() -> Key:
  make Key(valid = false bytes = "")

fn make_key(flag: Bool content: Bytes) -> Key:
  make Key(valid = flag bytes = content)

fn append_u64(value: I64 divisor: I64 remaining: I64 inout output: Vec[U8]) -> Unit effects[alloc partial]:
  let done: Bool = i64.eq(remaining 0)
  match done:
    true:
      unit
    false:
      let quotient: I64 = i64.div(value divisor)
      let code: I64 = i64.rem(quotient 256)
      let byte: U8 = i64.to-u8(code)
      let pushed: Unit = vec.push(output byte)
      let next_divisor: I64 = i64.div(divisor 256)
      let next_remaining: I64 = i64.sub(remaining 1)
      recur(value next_divisor next_remaining output)

fn read_bounded_u64_from(source: Bytes index: I64 remaining: I64 limit: I64 value: I64) -> Number effects[partial]:
  let done: Bool = i64.eq(remaining 0)
  match done:
    true:
      valid_number(value index)
    false:
      let length: I64 = bytes.len(source)
      let available: Bool = i64.lt(index length)
      match available:
        false:
          invalid_number(index)
        true:
          let byte: U8 = bytes.get(source index)
          let code: I64 = u8.to-i64(byte)
          let maximum_prefix: I64 = i64.div(limit 256)
          let below: Bool = i64.lt(value maximum_prefix)
          let equal: Bool = i64.eq(value maximum_prefix)
          let maximum_byte: I64 = i64.rem(limit 256)
          let byte_fits: Bool = i64.le(code maximum_byte)
          let equal_fits: Bool = bool.and(equal byte_fits)
          let fits: Bool = bool.or(below equal_fits)
          match fits:
            false:
              invalid_number(index)
            true:
              let shifted: I64 = i64.mul(value 256)
              let next_value: I64 = i64.add(shifted code)
              let next_index: I64 = i64.add(index 1)
              let next_remaining: I64 = i64.sub(remaining 1)
              recur(source next_index next_remaining limit next_value)

fn read_bounded_u64(source: Bytes index: I64 limit: I64) -> Number effects[partial]:
  read_bounded_u64_from(source index 8 limit 0)

fn weighted_checksum(source: Bytes index: I64 end: I64 sum: I64) -> I64 effects[partial]:
  let done: Bool = i64.ge(index end)
  match done:
    true:
      sum
    false:
      let byte: U8 = bytes.get(source index)
      let code: I64 = u8.to-i64(byte)
      let position: I64 = i64.add(index 1)
      let weighted: I64 = i64.mul(code position)
      let next_sum: I64 = i64.add(sum weighted)
      let next: I64 = i64.add(index 1)
      recur(source next end next_sum)

fn append_module_key(manifest_path: Bytes manifest_source: Bytes inout manifest_tokens: Vec[syntax/Token] cursor: I64 inout output: Vec[U8]) -> Bool effects[alloc io partial]:
  let kind: I64 = syntax/ast_node_kind(manifest_tokens cursor)
  let done: Bool = i64.eq(kind 1)
  match done:
    true:
      true
    false:
      let path_token: I64 = i64.add(cursor 3)
      let module_path: Bytes = project/project_module_path(manifest_path manifest_source manifest_tokens path_token)
      let source_bytes: Vec[U8] = vec.new()
      let read: Bool = io.read-file(module_path source_bytes)
      let source: Bytes = bytes.freeze(source_bytes)
      match read:
        false:
          false
        true:
          let source_length: I64 = bytes.len(source)
          let current: I64 = vec.len(output)
          let framing_room: I64 = i64.sub(67108864 current)
          let has_frame: Bool = i64.ge(framing_room 8)
          let content_room: I64 = match has_frame:
            true:
              i64.sub(framing_room 8)
            false:
              0
          let fits: Bool = i64.le(source_length content_room)
          let valid: Bool = bool.and(has_frame fits)
          match valid:
            false:
              false
            true:
              let length_bytes: Unit = append_u64(source_length 72057594037927936 8 output)
              let content: Unit = text/append_text(output source)
              let next: I64 = syntax/ast_next(manifest_tokens cursor)
              recur(manifest_path manifest_source manifest_tokens next output)

fn project_key(manifest_path: Bytes) -> Key effects[alloc io partial]:
  let manifest_bytes: Vec[U8] = vec.new()
  let read: Bool = io.read-file(manifest_path manifest_bytes)
  let manifest_source: Bytes = bytes.freeze(manifest_bytes)
  match read:
    false:
      invalid_key()
    true:
      let manifest_length: I64 = bytes.len(manifest_source)
      let maximum_manifest: I64 = 67108856
      let manifest_fits: Bool = i64.le(manifest_length maximum_manifest)
      match manifest_fits:
        false:
          invalid_key()
        true:
          let manifest_tokens: Vec[syntax/Token] = vec.new()
          let tokenized: Unit = syntax/lex_data(manifest_source 0 manifest_tokens)
          let output: Vec[U8] = vec.new()
          let length_bytes: Unit = append_u64(manifest_length 72057594037927936 8 output)
          let manifest: Unit = text/append_text(output manifest_source)
          let entry_form: I64 = 3
          let modules: I64 = syntax/ast_next(manifest_tokens entry_form)
          let valid: Bool = append_module_key(manifest_path manifest_source manifest_tokens modules output)
          let bytes: Bytes = bytes.freeze(output)
          make_key(valid bytes)

fn encode(key: Bytes artifact: Bytes) -> Bytes effects[alloc partial]:
  let key_length: I64 = bytes.len(key)
  let artifact_length: I64 = bytes.len(artifact)
  let prefix: Vec[U8] = vec.new()
  let magic: Unit = text/append_text(prefix "SLIMCACHE\x00")
  let schema: U8 = i64.to-u8(1)
  let schema_byte: Unit = vec.push(prefix schema)
  let key_length_bytes: Unit = append_u64(key_length 72057594037927936 8 prefix)
  let artifact_length_bytes: Unit = append_u64(artifact_length 72057594037927936 8 prefix)
  let key_bytes: Unit = text/append_text(prefix key)
  let artifact_bytes: Unit = text/append_text(prefix artifact)
  let prefix_bytes: Bytes = bytes.freeze(prefix)
  let prefix_length: I64 = bytes.len(prefix_bytes)
  let checksum: I64 = weighted_checksum(prefix_bytes 0 prefix_length 0)
  let output: Vec[U8] = vec.new()
  let copied: Unit = text/append_text(output prefix_bytes)
  let checksum_bytes: Unit = append_u64(checksum 72057594037927936 8 output)
  bytes.freeze(output)

fn invalid_probe() -> Probe:
  make Probe(valid = false artifact_start = 0 artifact_end = 0)

fn probe(cache: Bytes key: Bytes) -> Probe effects[partial]:
  let length: I64 = bytes.len(cache)
  let minimum: Bool = i64.ge(length 35)
  match minimum:
    false:
      invalid_probe()
    true:
      let magic: Bytes = "SLIMCACHE\x00"
      let magic_equal: Bool = project/cross_span_chars_equal(cache 0 magic 0 0 10)
      let schema_byte: U8 = bytes.get(cache 10)
      let schema_code: I64 = u8.to-i64(schema_byte)
      let schema_equal: Bool = i64.eq(schema_code 1)
      let header_valid: Bool = bool.and(magic_equal schema_equal)
      let key_number: Number = read_bounded_u64(cache 11 67108864)
      let key_valid: Bool = get(key_number valid)
      let key_length: I64 = get(key_number value)
      let artifact_number: Number = read_bounded_u64(cache 19 67108864)
      let artifact_valid: Bool = get(artifact_number valid)
      let lengths_valid: Bool = bool.and(key_valid artifact_valid)
      let artifact_length: I64 = get(artifact_number value)
      let artifact_start: I64 = i64.add(27 key_length)
      let artifact_end: I64 = i64.add(artifact_start artifact_length)
      let expected_length: I64 = i64.add(artifact_end 8)
      let exact_length: Bool = i64.eq(length expected_length)
      let expected_key_length: I64 = bytes.len(key)
      let same_key_length: Bool = i64.eq(key_length expected_key_length)
      let key_equal: Bool = match same_key_length:
        true:
          project/cross_span_chars_equal(cache 27 key 0 0 key_length)
        false:
          false
      let checksum: I64 = match exact_length:
        true:
          weighted_checksum(cache 0 artifact_end 0)
        false:
          0
      let checksum_number: Number = match exact_length:
        true:
          read_bounded_u64(cache artifact_end 2296836751160866950)
        false:
          invalid_number(0)
      let checksum_valid: Bool = get(checksum_number valid)
      let expected_checksum: I64 = get(checksum_number value)
      let checksum_equal: Bool = i64.eq(checksum expected_checksum)
      let first: Bool = bool.and(header_valid lengths_valid)
      let second: Bool = bool.and(exact_length key_equal)
      let third: Bool = bool.and(checksum_valid checksum_equal)
      let prefix_valid: Bool = bool.and(first second)
      let valid: Bool = bool.and(prefix_valid third)
      make Probe(valid = valid artifact_start = artifact_start artifact_end = artifact_end)

fn emit_hit(cache: Bytes probe: Probe) -> I64 effects[alloc io partial]:
  let output: Vec[U8] = vec.new()
  let marker: Unit = text/append_text(output "H")
  let start: I64 = get(probe artifact_start)
  let end: I64 = get(probe artifact_end)
  let artifact: Unit = text/append_span(cache start end output)
  let bytes: Bytes = bytes.freeze(output)
  let shown: Unit = io.print-bytes(bytes)
  0

fn emit_miss(manifest_path: Bytes key: Bytes) -> I64 effects[alloc io partial]:
  let prepared: project/PreparedProject = project/prepare_project_path(manifest_path)
  let status: I64 = get(prepared status)
  let invalid: Bool = i64.gt(status 0)
  match invalid:
    true:
      status
    false:
      let artifact: Bytes = project/generate_prepared_project(prepared)
      let entry: Bytes = encode(key artifact)
      let output: Vec[U8] = vec.new()
      let marker: Unit = text/append_text(output "M")
      let cache_bytes: Unit = text/append_text(output entry)
      let bytes: Bytes = bytes.freeze(output)
      let shown: Unit = io.print-bytes(bytes)
      0

fn run(manifest_path: Bytes cache_path: Bytes) -> I64 effects[alloc io partial]:
  let key_result: Key = project_key(manifest_path)
  let key_valid: Bool = get(key_result valid)
  match key_valid:
    false:
      project/check_project_path(manifest_path)
    true:
      let key: Bytes = get(key_result bytes)
      let cache_bytes: Vec[U8] = vec.new()
      let cache_read: Bool = io.read-file(cache_path cache_bytes)
      let cache: Bytes = bytes.freeze(cache_bytes)
      let cache_probe: Probe = match cache_read:
        true:
          probe(cache key)
        false:
          invalid_probe()
      let hit: Bool = get(cache_probe valid)
      match hit:
        true:
          emit_hit(cache cache_probe)
        false:
          emit_miss(manifest_path key)
