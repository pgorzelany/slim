module cache

struct Key:
  valid: Bool
  bytes: Bytes

struct Number:
  valid: Bool
  value: I64
  next: I64

struct Probe:
  valid: Bool
  artifact_start: I64
  artifact_end: I64

fn valid_number(value: I64, next: I64) -> Number:
  Number(valid: true, value: value, next: next)

fn invalid_number(next: I64) -> Number:
  Number(valid: false, value: 0, next: next)

fn invalid_key() -> Key:
  Key(valid: false, bytes: "")

fn make_key(flag: Bool, content: Bytes) -> Key:
  Key(valid: flag, bytes: content)

fn append_u64(value: I64, divisor: I64, remaining: I64, inout output: Vec[U8]) -> Void effects[alloc, partial]:
  let done: Bool = remaining == 0
  if done:
    void
  else:
    let quotient: I64 = value / divisor
    let code: I64 = quotient % 256
    let byte: U8 = i64.to_u8(code)
    vec.push(output, byte)
    let next_divisor: I64 = divisor / 256
    let next_remaining: I64 = remaining - 1
    recur(value, next_divisor, next_remaining, output)

fn read_bounded_u64_from(source: Bytes, index: I64, remaining: I64, limit: I64, value: I64) -> Number effects[partial]:
  let done: Bool = remaining == 0
  if done:
    valid_number(value, index)
  else:
    let length: I64 = bytes.len(source)
    let available: Bool = index < length
    if available:
      let byte: U8 = bytes.get(source, index)
      let code: I64 = u8.to_i64(byte)
      let maximum_prefix: I64 = limit / 256
      let below: Bool = value < maximum_prefix
      let equal: Bool = value == maximum_prefix
      let maximum_byte: I64 = limit % 256
      let byte_fits: Bool = code <= maximum_byte
      let equal_fits: Bool = equal && byte_fits
      let fits: Bool = below || equal_fits
      if fits:
        let shifted: I64 = value * 256
        let next_value: I64 = shifted + code
        let next_index: I64 = index + 1
        let next_remaining: I64 = remaining - 1
        recur(source, next_index, next_remaining, limit, next_value)
      else:
        invalid_number(index)
    else:
      invalid_number(index)

fn read_bounded_u64(source: Bytes, index: I64, limit: I64) -> Number effects[partial]:
  read_bounded_u64_from(source, index, 8, limit, 0)

fn weighted_checksum(source: Bytes, index: I64, end: I64, sum: I64) -> I64 effects[partial]:
  let done: Bool = index >= end
  if done:
    sum
  else:
    let byte: U8 = bytes.get(source, index)
    let code: I64 = u8.to_i64(byte)
    let position: I64 = index + 1
    let weighted: I64 = code * position
    let next_sum: I64 = sum + weighted
    let next: I64 = index + 1
    recur(source, next, end, next_sum)

fn append_module_key(manifest_path: Bytes, manifest_source: Bytes, inout manifest_tokens: Vec[syntax.Token], cursor: I64, inout output: Vec[U8]) -> Bool effects[alloc, io, partial]:
  let kind: I64 = syntax.ast_node_kind(manifest_tokens, cursor)
  let done: Bool = kind == 1
  if done:
    true
  else:
    let path_token: I64 = cursor + 3
    let module_path: Bytes = project.project_module_path(manifest_path, manifest_source, manifest_tokens, path_token)
    let source_bytes: Vec[U8] = vec.new()
    let read: Bool = io.read_file(module_path, source_bytes)
    let source: Bytes = bytes.freeze(source_bytes)
    if read:
      let source_length: I64 = bytes.len(source)
      let current: I64 = vec.len(output)
      let framing_room: I64 = 67108864 - current
      let has_frame: Bool = framing_room >= 8
      let content_room: I64 = if has_frame:
        framing_room - 8
      else:
        0
      let fits: Bool = source_length <= content_room
      let valid: Bool = has_frame && fits
      if valid:
        append_u64(source_length, 72057594037927936, 8, output)
        text.append_text(output, source)
        let next: I64 = syntax.ast_next(manifest_tokens, cursor)
        recur(manifest_path, manifest_source, manifest_tokens, next, output)
      else:
        false
    else:
      false

fn project_key(manifest_path: Bytes) -> Key effects[alloc, io, partial]:
  let manifest_bytes: Vec[U8] = vec.new()
  let read: Bool = io.read_file(manifest_path, manifest_bytes)
  let manifest_source: Bytes = bytes.freeze(manifest_bytes)
  if read:
    let manifest_length: I64 = bytes.len(manifest_source)
    let maximum_manifest: I64 = 67108856
    let manifest_fits: Bool = manifest_length <= maximum_manifest
    if manifest_fits:
      let manifest_tokens: Vec[syntax.Token] = vec.new()
      syntax.lex_data(manifest_source, 0, manifest_tokens)
      let output: Vec[U8] = vec.new()
      append_u64(manifest_length, 72057594037927936, 8, output)
      text.append_text(output, manifest_source)
      let entry_form: I64 = 3
      let modules: I64 = syntax.ast_next(manifest_tokens, entry_form)
      let valid: Bool = append_module_key(manifest_path, manifest_source, manifest_tokens, modules, output)
      let bytes: Bytes = bytes.freeze(output)
      make_key(valid, bytes)
    else:
      invalid_key()
  else:
    invalid_key()

fn encode(key: Bytes, artifact: Bytes) -> Bytes effects[alloc, partial]:
  let key_length: I64 = bytes.len(key)
  let artifact_length: I64 = bytes.len(artifact)
  let prefix: Vec[U8] = vec.new()
  text.append_text(prefix, "SLIMCACHE\x00")
  let schema: U8 = i64.to_u8(2)
  vec.push(prefix, schema)
  append_u64(key_length, 72057594037927936, 8, prefix)
  append_u64(artifact_length, 72057594037927936, 8, prefix)
  text.append_text(prefix, key)
  text.append_text(prefix, artifact)
  let prefix_bytes: Bytes = bytes.freeze(prefix)
  let prefix_length: I64 = bytes.len(prefix_bytes)
  let checksum: I64 = weighted_checksum(prefix_bytes, 0, prefix_length, 0)
  let output: Vec[U8] = vec.new()
  text.append_text(output, prefix_bytes)
  append_u64(checksum, 72057594037927936, 8, output)
  bytes.freeze(output)

fn invalid_probe() -> Probe:
  Probe(valid: false, artifact_start: 0, artifact_end: 0)

fn probe(cache: Bytes, key: Bytes) -> Probe effects[partial]:
  let length: I64 = bytes.len(cache)
  let minimum: Bool = length >= 35
  if minimum:
    let magic: Bytes = "SLIMCACHE\x00"
    let magic_equal: Bool = project.cross_span_chars_equal(cache, 0, magic, 0, 0, 10)
    let schema_byte: U8 = bytes.get(cache, 10)
    let schema_code: I64 = u8.to_i64(schema_byte)
    let schema_equal: Bool = schema_code == 2
    let header_valid: Bool = magic_equal && schema_equal
    let key_number: Number = read_bounded_u64(cache, 11, 67108864)
    let key_valid: Bool = key_number.valid
    let key_length: I64 = key_number.value
    let artifact_number: Number = read_bounded_u64(cache, 19, 67108864)
    let artifact_valid: Bool = artifact_number.valid
    let lengths_valid: Bool = key_valid && artifact_valid
    let artifact_length: I64 = artifact_number.value
    let artifact_start: I64 = 27 + key_length
    let artifact_end: I64 = artifact_start + artifact_length
    let expected_length: I64 = artifact_end + 8
    let exact_length: Bool = length == expected_length
    let expected_key_length: I64 = bytes.len(key)
    let same_key_length: Bool = key_length == expected_key_length
    let key_equal: Bool = if same_key_length:
      project.cross_span_chars_equal(cache, 27, key, 0, 0, key_length)
    else:
      false
    let checksum: I64 = if exact_length:
      weighted_checksum(cache, 0, artifact_end, 0)
    else:
      0
    let checksum_number: Number = if exact_length:
      read_bounded_u64(cache, artifact_end, 2296836751160866950)
    else:
      invalid_number(0)
    let checksum_valid: Bool = checksum_number.valid
    let expected_checksum: I64 = checksum_number.value
    let checksum_equal: Bool = checksum == expected_checksum
    let first: Bool = header_valid && lengths_valid
    let second: Bool = exact_length && key_equal
    let third: Bool = checksum_valid && checksum_equal
    let prefix_valid: Bool = first && second
    let valid: Bool = prefix_valid && third
    Probe(valid: valid, artifact_start: artifact_start, artifact_end: artifact_end)
  else:
    invalid_probe()

fn emit_hit(cache: Bytes, probe: Probe) -> I64 effects[alloc, io, partial]:
  let output: Vec[U8] = vec.new()
  text.append_text(output, "H")
  let start: I64 = probe.artifact_start
  let end: I64 = probe.artifact_end
  text.append_span(cache, start, end, output)
  let bytes: Bytes = bytes.freeze(output)
  io.print_bytes(bytes)
  0

fn emit_miss(manifest_path: Bytes, key: Bytes) -> I64 effects[alloc, io, partial]:
  let prepared: project.PreparedProject = project.prepare_project_path(manifest_path)
  let status: I64 = prepared.status
  let invalid: Bool = status > 0
  if invalid:
    status
  else:
    let artifact: Bytes = project.generate_prepared_project(prepared)
    let entry: Bytes = encode(key, artifact)
    let output: Vec[U8] = vec.new()
    text.append_text(output, "M")
    text.append_text(output, entry)
    let bytes: Bytes = bytes.freeze(output)
    io.print_bytes(bytes)
    0

fn run(manifest_path: Bytes, cache_path: Bytes) -> I64 effects[alloc, io, partial]:
  let key_result: Key = project_key(manifest_path)
  let key_valid: Bool = key_result.valid
  if key_valid:
    let key: Bytes = key_result.bytes
    let cache_bytes: Vec[U8] = vec.new()
    let cache_read: Bool = io.read_file(cache_path, cache_bytes)
    let cache: Bytes = bytes.freeze(cache_bytes)
    let cache_probe: Probe = if cache_read:
      probe(cache, key)
    else:
      invalid_probe()
    let hit: Bool = cache_probe.valid
    if hit:
      emit_hit(cache, cache_probe)
    else:
      emit_miss(manifest_path, key)
  else:
    project.check_project_path(manifest_path)
