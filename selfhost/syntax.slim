fn ast_form_has_tag(source: Bytes, inout tokens: Vec[Token], expr: I64, tag: I64, legacy_head: Bytes) -> Bool effects[partial]:
  let form: Bool = token_kind(tokens, expr) == 0
  if form:
    let actual: I64 = token_tag(tokens, expr)
    let tagged: Bool = actual == tag
    if tagged:
      true
    else:
      let legacy: Bool = actual == 0
      if legacy:
        token_equal(source, tokens, expr + 1, legacy_head)
      else:
        false
  else:
    false

fn ast_expression_is_let(source: Bytes, inout tokens: Vec[Token], expr: I64) -> Bool effects[partial]:
  let binding: Bool = ast_form_has_tag(source, tokens, expr, 9, "let")
  let statement: Bool = ast_node_tag(tokens, expr) == 18
  binding || statement

fn ast_expression_is_statement(inout tokens: Vec[Token], expr: I64) -> Bool effects[partial]:
