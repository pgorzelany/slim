                  false
                true:
                  i64.gt(lexeme_line(lexemes body_start) line)
              let body_ready: Bool = bool.and(same_depth later_line)
              match body_ready:
                false:
                  parse_failure(body_start)
                true:
                  let body: Parse = parse_block(source lexemes body_start depth tokens)
                  match get(body valid):
                    false:
                      body
                    true:
                      let finished: Unit = finish_form_after_tokens(tokens)
                      body

fn parse_block(source: Bytes inout lexemes: Vec[Lexeme] index: I64 depth: I64 inout tokens: Vec[Token]) -> Parse effects[alloc partial]:
  let available: Bool = lexeme_index_valid(lexemes index)
  match available:
    false:
      parse_failure(index)
    true:
      let exact: Bool = lexeme_at_indent(lexemes index depth)
      match exact:
        false:
          parse_failure(index)
        true:
          let let_form: Bool = lexeme_equal(source lexemes index "let")
          match let_form:
            true:
              parse_let_block(source lexemes index depth tokens)
            false:
              let set_form: Bool = lexeme_equal(source lexemes index "set")
              match set_form:
                true:
                  parse_set_block(source lexemes index depth tokens)
                false:
                  parse_expression(source lexemes index tokens)

fn parse_expression(source: Bytes inout lexemes: Vec[Lexeme] index: I64 inout tokens: Vec[Token]) -> Parse effects[alloc partial]:
  let kind: I64 = lexeme_kind(lexemes index)
  let string_value: Bool = i64.eq(kind 1)
  match string_value:
    true:
      let pushed: Bool = push_scalar_lexeme(lexemes index tokens)
      parse_success(i64.add(index 1))
    false:
      let name: Bool = i64.eq(kind 0)
      match name:
        false:
          parse_failure(index)
        true:
          let make_form: Bool = lexeme_equal(source lexemes index "make")
          match make_form:
            true:
              parse_make_expression(source lexemes index tokens)
            false:
              let get_form: Bool = lexeme_equal(source lexemes index "get")
              match get_form:
                true:
                  parse_get_expression(source lexemes index tokens)
                false:
                  let case_form: Bool = lexeme_equal(source lexemes index "case")
                  match case_form:
                    true:
                      parse_case_expression(source lexemes index tokens)
                    false:
                      let recur_form: Bool = lexeme_equal(source lexemes index "recur")
                      match recur_form:
                        true:
                          parse_recur_expression(source lexemes index tokens)
                        false:
                          let match_form: Bool = lexeme_equal(source lexemes index "match")
                          match match_form:
                            true:
                              parse_match_expression(source lexemes index tokens)
                            false:
                              let fork_form: Bool = lexeme_equal(source lexemes index "fork")
                              match fork_form:
                                true:
                                  parse_fork_expression(source lexemes index tokens)
                                false:
                                  let let_form: Bool = lexeme_equal(source lexemes index "let")
                                  let set_form: Bool = lexeme_equal(source lexemes index "set")
                                  let continuation: Bool = bool.or(let_form set_form)
                                  match continuation:
                                    true:
                                      parse_failure(index)
                                    false:
                                      let following: I64 = i64.add(index 1)
                                      let called: Bool = lexeme_is_kind(lexemes following 2)
                                      match called:
                                        true:
                                          parse_call_expression(source lexemes index tokens)
                                        false:
                                          let pushed: Bool = push_name_lexeme(lexemes index tokens)
                                          parse_success(following)

fn parse_record_members(source: Bytes inout lexemes: Vec[Lexeme] index: I64 depth: I64 inout tokens: Vec[Token]) -> Parse effects[alloc partial]:
  let available: Bool = lexeme_index_valid(lexemes index)
  let same_depth: Bool = match available:
    false:
      false
    true:
      lexeme_at_indent(lexemes index depth)
  match same_depth:
    false:
      let finished: Unit = finish_form_after_tokens(tokens)
      parse_success(index)
    true:
      let line: I64 = lexeme_line(lexemes index)
      let member: I64 = begin_plain_form(lexemes index tokens)
      let named: Bool = push_name_lexeme(lexemes index tokens)
      match named:
        false:
          parse_failure(index)
        true:
          let colon: I64 = i64.add(index 1)
          let has_colon: Bool = lexeme_is_kind(lexemes colon 6)
          match has_colon:
            false:
              parse_failure(colon)
            true:
              let type_result: Parse = parse_type(source lexemes i64.add(colon 1) tokens)
              match get(type_result valid):
                false:
                  type_result
                true:
                  let next: I64 = get(type_result next)
                  let line_finished: Bool = match lexeme_index_valid(lexemes next):
                    false:
                      true
                    true:
                      i64.gt(lexeme_line(lexemes next) line)
                  match line_finished:
                    false:
                      parse_failure(next)
                    true:
                      let closed: Unit = finish_form_after_tokens(tokens)
                      recur(source lexemes next depth tokens)

fn parse_variant_payload_types(source: Bytes inout lexemes: Vec[Lexeme] index: I64 line: I64 inout tokens: Vec[Token]) -> Parse effects[alloc partial]:
  let close: Bool = lexeme_is_kind(lexemes index 3)
  match close:
    true:
      let same_line: Bool = lexeme_on_line(lexemes index line)
      match same_line:
        false:
          parse_failure(index)
        true:
          let finished: Unit = finish_form_at(lexemes index tokens)
          parse_success(i64.add(index 1))
    false:
      let same_line: Bool = lexeme_on_line(lexemes index line)
      match same_line:
        false:
          parse_failure(index)
        true:
          let type_result: Parse = parse_type(source lexemes index tokens)
          match get(type_result valid):
            false:
              type_result
            true:
              recur(source lexemes get(type_result next) line tokens)

fn parse_variant_members(source: Bytes inout lexemes: Vec[Lexeme] index: I64 depth: I64 inout tokens: Vec[Token]) -> Parse effects[alloc partial]:
  let available: Bool = lexeme_index_valid(lexemes index)
  let same_depth: Bool = match available:
    false:
      false
    true:
      lexeme_at_indent(lexemes index depth)
  match same_depth:
    false:
      let finished: Unit = finish_form_after_tokens(tokens)
      parse_success(index)
    true:
      let line: I64 = lexeme_line(lexemes index)
      let member: I64 = begin_plain_form(lexemes index tokens)
      let named: Bool = push_name_lexeme(lexemes index tokens)
      match named:
        false:
          parse_failure(index)
        true:
          let payload: I64 = i64.add(index 1)
          let has_payload: Bool = lexeme_is_kind(lexemes payload 2)
          let parsed: Parse = match has_payload:
            true:
              parse_variant_payload_types(source lexemes i64.add(payload 1) line tokens)
            false:
              let closed: Unit = finish_form_after_tokens(tokens)
              parse_success(payload)
          match get(parsed valid):
            false:
              parsed
            true:
              let next: I64 = get(parsed next)
              let line_finished: Bool = match lexeme_index_valid(lexemes next):
                false:
                  true
                true:
                  i64.gt(lexeme_line(lexemes next) line)
              match line_finished:
                false:
                  parse_failure(next)
                true:
                  recur(source lexemes next depth tokens)

fn parse_data_item(source: Bytes inout lexemes: Vec[Lexeme] index: I64 tag: I64 inout tokens: Vec[Token]) -> Parse effects[alloc partial]:
  let line: I64 = lexeme_line(lexemes index)
  let item: I64 = begin_tagged_form(lexemes index tag tokens)
  let marker: Bool = push_name_lexeme(lexemes index tokens)
  let name: I64 = i64.add(index 1)
  let named: Bool = push_name_lexeme(lexemes name tokens)
  match named:
    false:
      parse_failure(name)
    true:
      let colon: I64 = i64.add(name 1)
      let has_colon: Bool = lexeme_is_kind(lexemes colon 6)
      let same_line: Bool = lexeme_on_line(lexemes colon line)
      let header: Bool = bool.and(has_colon same_line)
      match header:
        false:
          parse_failure(colon)
        true:
          let body: I64 = begin_plain_form(lexemes colon tokens)
          let first: I64 = i64.add(colon 1)
          let members: Parse = match i64.eq(tag 3):
            true:
              parse_record_members(source lexemes first 1 tokens)
            false:
              parse_variant_members(source lexemes first 1 tokens)
          match get(members valid):
            false:
              members
            true:
              let finished: Unit = finish_form_after_tokens(tokens)
              members

fn parse_function_item(source: Bytes inout lexemes: Vec[Lexeme] index: I64 inout tokens: Vec[Token]) -> Parse effects[alloc partial]:
  let line: I64 = lexeme_line(lexemes index)
  let item: I64 = begin_tagged_form(lexemes index 2 tokens)
  let marker: Bool = push_name_lexeme(lexemes index tokens)
  let name: I64 = i64.add(index 1)
  let named: Bool = push_name_lexeme(lexemes name tokens)
  match named:
    false:
      parse_failure(name)
    true:
      let parameters: I64 = i64.add(name 1)
      let params: Parse = parse_parameters(source lexemes parameters line tokens)
      match get(params valid):
        false:
          params
        true:
          let arrow: I64 = get(params next)
          let has_arrow: Bool = lexeme_is_kind(lexemes arrow 9)
          let arrow_line: Bool = lexeme_on_line(lexemes arrow line)
          let arrow_valid: Bool = bool.and(has_arrow arrow_line)
          match arrow_valid:
            false:
              parse_failure(arrow)
            true:
              let return_start: I64 = i64.add(arrow 1)
              let return_type: Parse = parse_type(source lexemes return_start tokens)
              match get(return_type valid):
                false:
                  return_type
                true:
                  let after_return: I64 = get(return_type next)
                  let explicit: Bool = lexeme_equal(source lexemes after_return "effects")
                  let effects_result: Parse = match explicit:
                    true:
                      parse_effects(source lexemes after_return line tokens)
                    false:
                      let synthesized: Unit = synthesize_empty_effects(lexemes after_return tokens)
                      parse_success(after_return)
                  match get(effects_result valid):
                    false:
                      effects_result
                    true:
                      let colon: I64 = get(effects_result next)
                      let has_colon: Bool = lexeme_is_kind(lexemes colon 6)
                      let colon_line: Bool = lexeme_on_line(lexemes colon line)
                      let header: Bool = bool.and(has_colon colon_line)
                      match header:
                        false:
                          parse_failure(colon)
                        true:
                          let body_start: I64 = i64.add(colon 1)
                          let body: Parse = parse_block(source lexemes body_start 1 tokens)
                          match get(body valid):
                            false:
                              body
                            true:
                              let finished: Unit = finish_form_after_tokens(tokens)
                              body

fn parse_item(source: Bytes inout lexemes: Vec[Lexeme] index: I64 inout tokens: Vec[Token]) -> Parse effects[alloc partial]:
  let top_level: Bool = lexeme_at_indent(lexemes index 0)
  match top_level:
    false:
      parse_failure(index)
    true:
      let function_item: Bool = lexeme_equal(source lexemes index "fn")
      match function_item:
        true:
          parse_function_item(source lexemes index tokens)
        false:
          let record_item: Bool = lexeme_equal(source lexemes index "record")
          match record_item:
            true:
              parse_data_item(source lexemes index 3 tokens)
            false:
              let variant_item: Bool = lexeme_equal(source lexemes index "variant")
              match variant_item:
                true:
                  parse_data_item(source lexemes index 4 tokens)
                false:
                  parse_failure(index)

fn parse_items(source: Bytes inout lexemes: Vec[Lexeme] index: I64 inout tokens: Vec[Token]) -> Parse effects[alloc partial]:
  let available: Bool = lexeme_index_valid(lexemes index)
  match available:
    false:
      parse_success(index)
    true:
      let item: Parse = parse_item(source lexemes index tokens)
      match get(item valid):
        false:
          item
        true:
          recur(source lexemes get(item next) tokens)

fn parse_module(source: Bytes inout lexemes: Vec[Lexeme] inout tokens: Vec[Token]) -> Parse effects[alloc partial]:
  let module_name: Bool = lexeme_equal(source lexemes 0 "module")
  let top_level: Bool = lexeme_at_indent(lexemes 0 0)
  let header_start: Bool = bool.and(module_name top_level)
  match header_start:
    false:
      parse_failure(0)
    true:
      let root: I64 = begin_tagged_form(lexemes 0 1 tokens)
      let marker: Bool = push_name_lexeme(lexemes 0 tokens)
      let name: Bool = push_name_lexeme(lexemes 1 tokens)
      let same_line: Bool = lexeme_on_line(lexemes 1 lexeme_line(lexemes 0))
      let header: Bool = bool.and(name same_line)
      match header:
        false:
          parse_failure(1)
        true:
          let items: Parse = parse_items(source lexemes 2 tokens)
          match get(items valid):
            false:
              items
            true:
              let length: I64 = bytes.len(source)
              let closed: Unit = push_token(tokens 1 length length)
              items

fn parse_program_result(source: Bytes inout tokens: Vec[Token]) -> ProgramParse effects[alloc partial]:
  let lexemes: Vec[Lexeme] = vec.new()
  let lexical: LexResult = lex_modern(source lexemes)
  match get(lexical valid):
    false:
      make ProgramParse(valid = false code = get(lexical code) start = get(lexical start) end = get(lexical end))
    true:
      let jump: I64 = indentation_jump(lexemes 0 -1 0)
      let skipped: Bool = i64.ge(jump 0)
      match skipped:
        true:
          let width: I64 = i64.mul(lexeme_indent(lexemes jump) 2)
          let end: I64 = lexeme_start(lexemes jump)
          let start: I64 = i64.sub(end width)
          make ProgramParse(valid = false code = "E0105" start = start end = end)
        false:
          let first_token: I64 = vec.len(tokens)
          let parsed: Parse = parse_module(source lexemes tokens)
          let complete: Bool = i64.eq(get(parsed next) vec.len(lexemes))
          let valid: Bool = bool.and(get(parsed valid) complete)
          match valid:
            false:
              let failure: I64 = get(parsed next)
              let available: Bool = lexeme_index_valid(lexemes failure)
              let start: I64 = match available:
                true:
                  lexeme_start(lexemes failure)
                false:
                  bytes.len(source)
              let end: I64 = match available:
                true:
                  lexeme_end(lexemes failure)
                false:
                  start
              make ProgramParse(valid = false code = "E0102" start = start end = end)
            true:
              let indexed: Unit = index-form-boundaries(tokens first_token)
              let length: I64 = bytes.len(source)
              make ProgramParse(valid = true code = "" start = length end = length)

fn parse_program(source: Bytes inout tokens: Vec[Token]) -> Bool effects[alloc partial]:
  let result: ProgramParse = parse_program_result(source tokens)
  get(result valid)

fn token_equal(source: Bytes inout tokens: Vec[Token] index: I64 text: Bytes) -> Bool effects[partial]:
