fn binding_is_inout(source: Bytes inout tokens: Vec[Token] params: I64 cursor: I64 name_start: I64 name_end: I64) -> Bool effects[partial]:
  let kind: I64 = token_kind(tokens cursor)
  let done: Bool = i64.eq(kind 1)
  match done:
    true:
      false
    false:
      let head: I64 = i64.add(cursor 1)
      let is_inout: Bool = token_equal(source tokens head "inout")
      match is_inout:
        true:
          let name_index: I64 = i64.add(cursor 2)
          let candidate_start: I64 = token_start(tokens name_index)
          let candidate_end: I64 = token_end(tokens name_index)
          let same: Bool = spans_equal(source candidate_start candidate_end name_start name_end)
          match same:
            true:
              true
            false:
              let next: I64 = skip_form(tokens cursor)
              recur(source tokens params next name_start name_end)
        false:
          let next: I64 = skip_form(tokens cursor)
          recur(source tokens params next name_start name_end)

fn name_is_inout(source: Bytes inout tokens: Vec[Token] params: I64 name: I64) -> Bool effects[partial]:
  let cursor: I64 = i64.add(params 1)
  let name_start: I64 = token_start(tokens name)
  let name_end: I64 = token_end(tokens name)
  binding_is_inout(source tokens params cursor name_start name_end)

fn first_byte_is_number(source: Bytes inout tokens: Vec[Token] index: I64) -> Bool effects[partial]:
  let valid_token: Bool = token_index_valid(tokens index)
  match valid_token:
    false:
      false
    true:
      let start: I64 = token_start(tokens index)
      let length: I64 = bytes.len(source)
      let available: Bool = i64.lt(start length)
      match available:
        false:
          false
        true:
          let byte: U8 = bytes.get(source start)
          let code: I64 = u8.to-i64(byte)
          let minus: Bool = i64.eq(code 45)
          let lower: Bool = i64.ge(code 48)
          let upper: Bool = i64.le(code 57)
          let digit: Bool = bool.and(lower upper)
          bool.or(minus digit)

fn span_count_byte(source: Bytes index: I64 end: I64 code: I64 count: I64) -> I64 effects[partial]:
  let done: Bool = i64.ge(index end)
  match done:
    true:
      count
    false:
      let byte: U8 = bytes.get(source index)
      let current: I64 = u8.to-i64(byte)
      let same: Bool = i64.eq(current code)
      let next_count: I64 = match same:
        true:
          i64.add(count 1)
        false:
          count
      let next: I64 = i64.add(index 1)
      recur(source next end code next_count)

fn scalar_type_kind(source: Bytes inout tokens: Vec[Token] type_index: I64) -> I64 effects[partial]:
  let unit_type: Bool = token_equal(source tokens type_index "Unit")
  match unit_type:
    true:
      0
    false:
      let bool_type: Bool = token_equal(source tokens type_index "Bool")
      match bool_type:
        true:
          1
        false:
          let u8_type: Bool = token_equal(source tokens type_index "U8")
          match u8_type:
            true:
              2
            false:
              let i64_type: Bool = token_equal(source tokens type_index "I64")
              match i64_type:
                true:
                  3
                false:
                  let bytes_type: Bool = token_equal(source tokens type_index "Bytes")
                  match bytes_type:
                    true:
                      4
                    false:
                      -1

fn declaration_kind(source: Bytes inout tokens: Vec[Token] form: I64) -> ir/DeclarationKind effects[partial]:
  let head: I64 = i64.add(form 1)
  let function: Bool = token_equal(source tokens head "fn")
  match function:
    true:
      let kind: ir/DeclarationKind = case ir/DeclarationKind::Function()
      kind
    false:
      let record: Bool = token_equal(source tokens head "record")
      match record:
        true:
          let kind: ir/DeclarationKind = case ir/DeclarationKind::Record()
          kind
        false:
          let kind: ir/DeclarationKind = case ir/DeclarationKind::Variant()
          kind

fn append_name_node(value: I64 inout nodes: Vec[NameNode]) -> I64 effects[alloc]:
  let index: I64 = vec.len(nodes)
  let node: NameNode = make NameNode(value = value first_edge = -1)
  let pushed: Unit = vec.push(nodes node)
  index

fn find_name_edge(inout edges: Vec[NameEdge] cursor: I64 code: I64) -> I64 effects[partial]:
  let exhausted: Bool = i64.lt(cursor 0)
  match exhausted:
    true:
      -1
    false:
      let edge: NameEdge = vec.get(edges cursor)
      let same: Bool = i64.eq(get(edge code) code)
      match same:
        true:
          get(edge child)
        false:
          recur(edges get(edge next_edge) code)

fn name_child(inout nodes: Vec[NameNode] inout edges: Vec[NameEdge] parent: I64 code: I64) -> I64 effects[alloc partial]:
  let node: NameNode = vec.get(nodes parent)
  let found: I64 = find_name_edge(edges get(node first_edge) code)
  let present: Bool = i64.ge(found 0)
  match present:
    true:
      found
    false:
      let child: I64 = append_name_node(-1 nodes)
      let edge_index: I64 = vec.len(edges)
      let edge: NameEdge = make NameEdge(code = code child = child next_edge = get(node first_edge))
      let pushed: Unit = vec.push(edges edge)
      let updated: NameNode = make NameNode(value = get(node value) first_edge = edge_index)
      let stored: Unit = vec.set(nodes parent updated)
      child

fn insert_name_chars(source: Bytes index: I64 end: I64 value: I64 node: I64 inout nodes: Vec[NameNode] inout edges: Vec[NameEdge]) -> Unit effects[alloc partial]:
  let done: Bool = i64.ge(index end)
  match done:
    true:
      let current: NameNode = vec.get(nodes node)
      let updated: NameNode = make NameNode(value = value first_edge = get(current first_edge))
      vec.set(nodes node updated)
    false:
      let byte: U8 = bytes.get(source index)
      let code: I64 = u8.to-i64(byte)
      let child: I64 = name_child(nodes edges node code)
      let next: I64 = i64.add(index 1)
      recur(source next end value child nodes edges)

fn insert_name_token(source: Bytes inout tokens: Vec[Token] token: I64 value: I64 inout nodes: Vec[NameNode] inout edges: Vec[NameEdge]) -> Unit effects[alloc partial]:
  let start: I64 = token_start(tokens token)
  let end: I64 = token_end(tokens token)
  insert_name_chars(source start end value 0 nodes edges)

fn index_names_from(source: Bytes inout tokens: Vec[Token] cursor: I64 inout nodes: Vec[NameNode] inout edges: Vec[NameEdge]) -> Unit effects[alloc partial]:
  let length: I64 = vec.len(tokens)
  let exhausted: Bool = i64.ge(cursor length)
  match exhausted:
    true:
      unit
    false:
      let kind: I64 = token_kind(tokens cursor)
      let done: Bool = i64.eq(kind 1)
      match done:
        true:
          unit
        false:
          let name: I64 = i64.add(cursor 2)
          let inserted: Unit = insert_name_token(source tokens name cursor nodes edges)
          let next: I64 = skip_form(tokens cursor)
          recur(source tokens next nodes edges)

fn lookup_name_chars(source: Bytes index: I64 end: I64 node: I64 inout nodes: Vec[NameNode] inout edges: Vec[NameEdge]) -> I64 effects[partial]:
  let done: Bool = i64.ge(index end)
  match done:
    true:
      let current: NameNode = vec.get(nodes node)
      get(current value)
    false:
      let byte: U8 = bytes.get(source index)
      let code: I64 = u8.to-i64(byte)
      let current: NameNode = vec.get(nodes node)
      let child: I64 = find_name_edge(edges get(current first_edge) code)
      let missing: Bool = i64.lt(child 0)
      match missing:
        true:
          -1
        false:
          let next: I64 = i64.add(index 1)
          recur(source next end child nodes edges)

fn lookup_name_token(source: Bytes inout tokens: Vec[Token] token: I64 inout nodes: Vec[NameNode] inout edges: Vec[NameEdge]) -> I64 effects[partial]:
  let start: I64 = token_start(tokens token)
  let end: I64 = token_end(tokens token)
  lookup_name_chars(source start end 0 nodes edges)

fn link_name_tokens(source: Bytes inout tokens: Vec[Token] index: I64 end: I64 inout nodes: Vec[NameNode] inout edges: Vec[NameEdge]) -> Unit effects[partial]:
  let done: Bool = i64.ge(index end)
  match done:
    true:
      unit
    false:
      let kind: I64 = token_kind(tokens index)
      let atom: Bool = i64.eq(kind 2)
      let value: I64 = match atom:
        true:
          lookup_name_token(source tokens index nodes edges)
        false:
          -1
      let found: Bool = i64.ge(value 0)
      let linked: Unit = match found:
        true:
          set_token_link(tokens index value)
        false:
          unit
      let next: I64 = i64.add(index 1)
      recur(source tokens next end nodes edges)

fn link_declaration_names_from(source: Bytes inout tokens: Vec[Token] module_root: I64) -> Unit effects[alloc partial]:
  let nodes: Vec[NameNode] = vec.new()
  let edges: Vec[NameEdge] = vec.new()
  let root: I64 = append_name_node(-1 nodes)
  let first: I64 = i64.add(module_root 3)
  let indexed: Unit = index_names_from(source tokens first nodes edges)
  let end: I64 = skip_form(tokens module_root)
  link_name_tokens(source tokens first end nodes edges)

fn link_declaration_names(source: Bytes inout tokens: Vec[Token]) -> Unit effects[alloc partial]:
  link_declaration_names_from(source tokens 0)

fn index_declarations_from(source: Bytes inout tokens: Vec[Token] cursor: I64 inout declarations: Vec[ir/Declaration]) -> Unit effects[alloc partial]:
  let token: I64 = token_kind(tokens cursor)
  let done: Bool = i64.eq(token 1)
  match done:
    true:
      unit
    false:
      let form: Bool = i64.eq(token 0)
      match form:
        false:
          let next: I64 = i64.add(cursor 1)
          recur(source tokens next declarations)
        true:
          let next: I64 = skip_form(tokens cursor)
          let name: I64 = i64.add(cursor 2)
          let kind: ir/DeclarationKind = declaration_kind(source tokens cursor)
          let declaration: ir/Declaration = make ir/Declaration(kind = kind form = cursor name = name next = next)
          let pushed: Unit = vec.push(declarations declaration)
          recur(source tokens next declarations)

fn index_declarations(source: Bytes inout tokens: Vec[Token]) -> Vec[ir/Declaration] effects[alloc partial]:
  let declarations: Vec[ir/Declaration] = vec.new()
  let indexed: Unit = index_declarations_from(source tokens 3 declarations)
  declarations
