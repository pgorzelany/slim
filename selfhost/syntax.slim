  span_equal(source start end text)

fn skip_nested(inout tokens: Vec[Token] index: I64 depth: I64) -> I64 effects[partial]:
  let length: I64 = vec.len(tokens)
  let exhausted: Bool = i64.ge(index length)
  match exhausted:
    true:
      length
    false:
      let kind: I64 = token_kind(tokens index)
      let left: Bool = i64.eq(kind 0)
      let right: Bool = i64.eq(kind 1)
      match left:
        true:
          let next_depth: I64 = i64.add(depth 1)
          let next: I64 = i64.add(index 1)
          recur(tokens next next_depth)
        false:
          match right:
            true:
              let next_depth: I64 = i64.sub(depth 1)
              let next: I64 = i64.add(index 1)
              let done: Bool = i64.eq(next_depth 0)
              match done:
                true:
                  next
                false:
                  recur(tokens next next_depth)
            false:
              let next: I64 = i64.add(index 1)
              recur(tokens next depth)

fn skip_form(inout tokens: Vec[Token] index: I64) -> I64 effects[partial]:
  let kind: I64 = token_kind(tokens index)
  let left: Bool = i64.eq(kind 0)
  match left:
    true:
      let indexed: I64 = token_next(tokens index)
      let known: Bool = i64.ge(indexed 0)
      match known:
        true:
          indexed
        false:
          let following: I64 = i64.add(index 1)
          skip_nested(tokens following 1)
    false:
      i64.add(index 1)

