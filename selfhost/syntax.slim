fn ast_expression_is_match(source: Bytes, inout tokens: Vec[Token], expr: I64) -> Bool effects[partial]:
  let enum_match: Bool = ast_form_has_tag(source, tokens, expr, 14, "match")
  let familiar_match: Bool = ast_node_tag(tokens, expr) == 20
  let if_form: Bool = ast_node_tag(tokens, expr) == 19
  enum_match || (familiar_match || if_form)

