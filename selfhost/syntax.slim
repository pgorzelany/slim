fn binding_is_inout(source: Bytes, inout tokens: Vec[Token], params: I64, cursor: I64, name_start: I64, name_end: I64) -> Bool effects[partial]:
  let kind: I64 = token_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    false
  else:
    let head: I64 = cursor + 1
    let is_inout: Bool = token_equal(source, tokens, head, "inout")
    if is_inout:
      let name_index: I64 = cursor + 2
      let candidate_start: I64 = token_start(tokens, name_index)
      let candidate_end: I64 = token_end(tokens, name_index)
      let same: Bool = spans_equal(source, candidate_start, candidate_end, name_start, name_end)
      if same:
        true
      else:
        let next: I64 = skip_form(tokens, cursor)
        recur(source, tokens, params, next, name_start, name_end)
    else:
      let next: I64 = skip_form(tokens, cursor)
      recur(source, tokens, params, next, name_start, name_end)

fn name_is_inout(source: Bytes, inout tokens: Vec[Token], params: I64, name: I64) -> Bool effects[partial]:
  let cursor: I64 = params + 1
  let name_start: I64 = token_start(tokens, name)
  let name_end: I64 = token_end(tokens, name)
  binding_is_inout(source, tokens, params, cursor, name_start, name_end)

fn first_byte_is_number(source: Bytes, inout tokens: Vec[Token], index: I64) -> Bool effects[partial]:
  let valid_token: Bool = token_index_valid(tokens, index)
  if valid_token:
    let start: I64 = token_start(tokens, index)
    let length: I64 = bytes.len(source)
    let available: Bool = start < length
    if available:
      let byte: U8 = bytes.get(source, start)
      let code: I64 = u8.to_i64(byte)
      let minus: Bool = code == 45
      let lower: Bool = code >= 48
      let upper: Bool = code <= 57
      let digit: Bool = lower && upper
      minus || digit
    else:
      false
  else:
    false

fn span_count_byte(source: Bytes, index: I64, end: I64, code: I64, count: I64) -> I64 effects[partial]:
  let done: Bool = index >= end
  if done:
    count
  else:
    let byte: U8 = bytes.get(source, index)
    let current: I64 = u8.to_i64(byte)
    let same: Bool = current == code
    let next_count: I64 = if same:
      count + 1
    else:
      count
    let next: I64 = index + 1
    recur(source, next, end, code, next_count)

fn scalar_type_kind(source: Bytes, inout tokens: Vec[Token], type_index: I64) -> I64 effects[partial]:
  let void_type: Bool = token_equal(source, tokens, type_index, "Void")
  if void_type:
    0
  else:
    let bool_type: Bool = token_equal(source, tokens, type_index, "Bool")
    if bool_type:
      1
    else:
      let u8_type: Bool = token_equal(source, tokens, type_index, "U8")
      if u8_type:
        2
      else:
        let i64_type: Bool = token_equal(source, tokens, type_index, "I64")
        if i64_type:
          3
        else:
          let bytes_type: Bool = token_equal(source, tokens, type_index, "Bytes")
          if bytes_type:
            4
          else:
            -1

fn declaration_kind(source: Bytes, inout tokens: Vec[Token], form: I64) -> ir.DeclarationKind effects[partial]:
  let head: I64 = form + 1
  let function: Bool = token_equal(source, tokens, head, "fn")
  if function:
    let kind: ir.DeclarationKind = ir.DeclarationKind::Function()
    kind
  else:
    let record: Bool = token_equal(source, tokens, head, "struct")
    if record:
      let kind: ir.DeclarationKind = ir.DeclarationKind::Record()
      kind
    else:
      let kind: ir.DeclarationKind = ir.DeclarationKind::Variant()
      kind

fn append_name_node(value: I64, inout nodes: Vec[NameNode]) -> I64 effects[alloc]:
  let index: I64 = vec.len(nodes)
  let node: NameNode = NameNode(value: value, first_edge: -1)
  vec.push(nodes, node)
  index

fn find_name_edge(inout edges: Vec[NameEdge], cursor: I64, code: I64) -> I64 effects[partial]:
  let exhausted: Bool = cursor < 0
  if exhausted:
    -1
  else:
    let edge: NameEdge = vec.get(edges, cursor)
    let same: Bool = edge.code == code
    if same:
      edge.child
    else:
      recur(edges, edge.next_edge, code)

fn name_child(inout nodes: Vec[NameNode], inout edges: Vec[NameEdge], parent: I64, code: I64) -> I64 effects[alloc, partial]:
  let node: NameNode = vec.get(nodes, parent)
  let found: I64 = find_name_edge(edges, node.first_edge, code)
  let present: Bool = found >= 0
  if present:
    found
  else:
    let child: I64 = append_name_node(-1, nodes)
    let edge_index: I64 = vec.len(edges)
    let edge: NameEdge = NameEdge(code: code, child: child, next_edge: node.first_edge)
    vec.push(edges, edge)
    let updated: NameNode = NameNode(value: node.value, first_edge: edge_index)
    vec.set(nodes, parent, updated)
    child

fn insert_name_chars(source: Bytes, index: I64, end: I64, value: I64, node: I64, inout nodes: Vec[NameNode], inout edges: Vec[NameEdge]) -> Void effects[alloc, partial]:
  let done: Bool = index >= end
  if done:
    let current: NameNode = vec.get(nodes, node)
    let updated: NameNode = NameNode(value: value, first_edge: current.first_edge)
    vec.set(nodes, node, updated)
  else:
    let byte: U8 = bytes.get(source, index)
    let code: I64 = u8.to_i64(byte)
    let child: I64 = name_child(nodes, edges, node, code)
    let next: I64 = index + 1
    recur(source, next, end, value, child, nodes, edges)

fn insert_name_token(source: Bytes, inout tokens: Vec[Token], token: I64, value: I64, inout nodes: Vec[NameNode], inout edges: Vec[NameEdge]) -> Void effects[alloc, partial]:
  let start: I64 = token_start(tokens, token)
  let end: I64 = token_end(tokens, token)
  insert_name_chars(source, start, end, value, 0, nodes, edges)

fn index_names_from(source: Bytes, inout tokens: Vec[Token], cursor: I64, inout nodes: Vec[NameNode], inout edges: Vec[NameEdge]) -> Void effects[alloc, partial]:
  let length: I64 = vec.len(tokens)
  let exhausted: Bool = cursor >= length
  if exhausted:
    void
  else:
    let kind: I64 = token_kind(tokens, cursor)
    let done: Bool = kind == 1
    if done:
      void
    else:
      let name: I64 = cursor + 2
      insert_name_token(source, tokens, name, cursor, nodes, edges)
      let next: I64 = skip_form(tokens, cursor)
      recur(source, tokens, next, nodes, edges)

fn lookup_name_chars(source: Bytes, index: I64, end: I64, node: I64, inout nodes: Vec[NameNode], inout edges: Vec[NameEdge]) -> I64 effects[partial]:
  let done: Bool = index >= end
  if done:
    let current: NameNode = vec.get(nodes, node)
    current.value
  else:
    let byte: U8 = bytes.get(source, index)
    let code: I64 = u8.to_i64(byte)
    let current: NameNode = vec.get(nodes, node)
    let child: I64 = find_name_edge(edges, current.first_edge, code)
    let missing: Bool = child < 0
    if missing:
      -1
    else:
      let next: I64 = index + 1
      recur(source, next, end, child, nodes, edges)

fn lookup_name_token(source: Bytes, inout tokens: Vec[Token], token: I64, inout nodes: Vec[NameNode], inout edges: Vec[NameEdge]) -> I64 effects[partial]:
  let start: I64 = token_start(tokens, token)
  let end: I64 = token_end(tokens, token)
  lookup_name_chars(source, start, end, 0, nodes, edges)

fn link_name_tokens(source: Bytes, inout tokens: Vec[Token], index: I64, end: I64, inout nodes: Vec[NameNode], inout edges: Vec[NameEdge]) -> Void effects[partial]:
  let done: Bool = index >= end
  if done:
    void
  else:
    let kind: I64 = token_kind(tokens, index)
    let atom: Bool = kind == 2
    let value: I64 = if atom:
      lookup_name_token(source, tokens, index, nodes, edges)
    else:
      -1
    let found: Bool = value >= 0
    if found:
      set_token_link(tokens, index, value)
    else:
      void
    let next: I64 = index + 1
    recur(source, tokens, next, end, nodes, edges)

fn classify_empty_record_calls(source: Bytes, inout tokens: Vec[Token], index: I64, end: I64) -> Void effects[partial]:
  let done: Bool = index >= end
  if done:
    void
  else:
    let call: Bool = (token_kind(tokens, index) == 0) && (token_tag(tokens, index) == 10)
    let callee: I64 = index + 2
    let declaration: I64 = if call:
      token_link(tokens, callee)
    else:
      -1
    let found: Bool = declaration >= 0
    let record: Bool = if found:
      ast_item_is_record(source, tokens, declaration)
    else:
      false
    let arguments: I64 = callee + 1
    let empty: Bool = if call:
      token_kind(tokens, arguments) == 1
    else:
      false
    if record && empty:
      set_token_tag(tokens, index, 11)
      set_token_tag(tokens, index + 1, 111)
    else:
      void
    let next: I64 = index + 1
    recur(source, tokens, next, end)

fn link_declaration_names_from(source: Bytes, inout tokens: Vec[Token], module_root: I64) -> Void effects[alloc, partial]:
  let nodes: Vec[NameNode] = vec.new()
  let edges: Vec[NameEdge] = vec.new()
  let root: I64 = append_name_node(-1, nodes)
  let first: I64 = module_root + 3
  index_names_from(source, tokens, first, nodes, edges)
  let end: I64 = skip_form(tokens, module_root)
  link_name_tokens(source, tokens, first, end, nodes, edges)
  classify_empty_record_calls(source, tokens, first, end)

fn link_declaration_names(source: Bytes, inout tokens: Vec[Token]) -> Void effects[alloc, partial]:
  link_declaration_names_from(source, tokens, 0)

fn index_declarations_from(source: Bytes, inout tokens: Vec[Token], cursor: I64, inout declarations: Vec[ir.Declaration]) -> Void effects[alloc, partial]:
  let token: I64 = token_kind(tokens, cursor)
  let done: Bool = token == 1
  if done:
    void
  else:
    let form: Bool = token == 0
    if form:
      let next: I64 = skip_form(tokens, cursor)
      let name: I64 = cursor + 2
      let kind: ir.DeclarationKind = declaration_kind(source, tokens, cursor)
      let declaration: ir.Declaration = ir.Declaration(kind: kind, form: cursor, name: name, next: next)
      vec.push(declarations, declaration)
      recur(source, tokens, next, declarations)
    else:
      let next: I64 = cursor + 1
      recur(source, tokens, next, declarations)

fn index_declarations(source: Bytes, inout tokens: Vec[Token]) -> Vec[ir.Declaration] effects[alloc, partial]:
  let declarations: Vec[ir.Declaration] = vec.new()
  index_declarations_from(source, tokens, 3, declarations)
  declarations
