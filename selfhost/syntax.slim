module syntax

record Token:
  kind: I64
  tag: I64
  start: I64
  end: I64
  link: I64
  next: I64

record Lexeme:
  kind: I64
  start: I64
  end: I64
  line: I64
  indent: I64

record Parse:
  valid: Bool
  next: I64

record ProgramParse:
  valid: Bool
  code: Bytes
  start: I64
  end: I64

record LexResult:
  valid: Bool
  code: Bytes
  start: I64
  end: I64

record NameNode:
  value: I64
  first_edge: I64

record NameEdge:
  code: I64
  child: I64
  next_edge: I64

fn token_index_valid(inout tokens: Vec[Token] index: I64) -> Bool:
  let nonnegative: Bool = i64.ge(index 0)
  let length: I64 = vec.len(tokens)
  let below: Bool = i64.lt(index length)
  bool.and(nonnegative below)

fn token_kind(inout tokens: Vec[Token] index: I64) -> I64 effects[partial]:
  let valid: Bool = token_index_valid(tokens index)
  match valid:
    false:
      -1
    true:
      let token: Token = vec.get(tokens index)
      get(token kind)

fn token_tag(inout tokens: Vec[Token] index: I64) -> I64 effects[partial]:
  let valid: Bool = token_index_valid(tokens index)
  match valid:
    false:
      -1
    true:
      let token: Token = vec.get(tokens index)
      get(token tag)

fn token_start(inout tokens: Vec[Token] index: I64) -> I64 effects[partial]:
  let valid: Bool = token_index_valid(tokens index)
  match valid:
    false:
      0
    true:
      let token: Token = vec.get(tokens index)
      get(token start)

fn token_end(inout tokens: Vec[Token] index: I64) -> I64 effects[partial]:
  let valid: Bool = token_index_valid(tokens index)
  match valid:
    false:
      0
    true:
      let token: Token = vec.get(tokens index)
      get(token end)

fn token_link(inout tokens: Vec[Token] index: I64) -> I64 effects[partial]:
  let valid: Bool = token_index_valid(tokens index)
  match valid:
    false:
      -1
    true:
      let token: Token = vec.get(tokens index)
      get(token link)

fn token_next(inout tokens: Vec[Token] index: I64) -> I64 effects[partial]:
  let valid: Bool = token_index_valid(tokens index)
  match valid:
    false:
      -1
    true:
      let token: Token = vec.get(tokens index)
      get(token next)

fn set_token_link(inout tokens: Vec[Token] index: I64 link: I64) -> Unit effects[partial]:
  let token: Token = vec.get(tokens index)
  let updated: Token = make Token(kind = get(token kind) tag = get(token tag) start = get(token start) end = get(token end) link = link next = get(token next))
  vec.set(tokens index updated)

fn set-token-next(inout tokens: Vec[Token] index: I64 next: I64) -> Unit effects[partial]:
  let token: Token = vec.get(tokens index)
  let updated: Token = make Token(kind = get(token kind) tag = get(token tag) start = get(token start) end = get(token end) link = get(token link) next = next)
  vec.set(tokens index updated)

fn span_equal_chars(source: Bytes start: I64 text: Bytes index: I64 length: I64) -> Bool effects[partial]:
  let done: Bool = i64.eq(index length)
  match done:
    true:
      true
    false:
      let source_index: I64 = i64.add(start index)
      let source_byte: U8 = bytes.get(source source_index)
      let text_byte: U8 = bytes.get(text index)
      let source_code: I64 = u8.to-i64(source_byte)
      let text_code: I64 = u8.to-i64(text_byte)
      let same: Bool = i64.eq(source_code text_code)
      match same:
        true:
          let next: I64 = i64.add(index 1)
          recur(source start text next length)
        false:
          false

fn span_equal(source: Bytes start: I64 end: I64 text: Bytes) -> Bool effects[partial]:
  let span_length: I64 = i64.sub(end start)
  let text_length: I64 = bytes.len(text)
  let same_length: Bool = i64.eq(span_length text_length)
  match same_length:
    true:
      span_equal_chars(source start text 0 span_length)
    false:
      false

fn spans_equal_chars(source: Bytes left_start: I64 right_start: I64 index: I64 length: I64) -> Bool effects[partial]:
  let done: Bool = i64.eq(index length)
  match done:
    true:
      true
    false:
      let left_index: I64 = i64.add(left_start index)
      let right_index: I64 = i64.add(right_start index)
      let left_byte: U8 = bytes.get(source left_index)
      let right_byte: U8 = bytes.get(source right_index)
      let left_code: I64 = u8.to-i64(left_byte)
      let right_code: I64 = u8.to-i64(right_byte)
      let same: Bool = i64.eq(left_code right_code)
      match same:
        true:
          let next: I64 = i64.add(index 1)
          recur(source left_start right_start next length)
        false:
          false

fn spans_equal(source: Bytes left_start: I64 left_end: I64 right_start: I64 right_end: I64) -> Bool effects[partial]:
  let left_length: I64 = i64.sub(left_end left_start)
  let right_length: I64 = i64.sub(right_end right_start)
  let same_length: Bool = i64.eq(left_length right_length)
  match same_length:
    true:
      spans_equal_chars(source left_start right_start 0 left_length)
    false:
      false

fn is_delimiter(code: I64) -> Bool:
  let whitespace: Bool = i64.le(code 32)
  let left: Bool = i64.eq(code 40)
  let right: Bool = i64.eq(code 41)
  let comment: Bool = i64.eq(code 59)
  let quote: Bool = i64.eq(code 34)
  let any_paren: Bool = bool.or(left right)
  let any_control: Bool = bool.or(whitespace comment)
  let any_delimiter: Bool = bool.or(any_paren any_control)
  bool.or(any_delimiter quote)

fn scan_atom(input: Bytes index: I64 length: I64) -> I64 effects[partial]:
  let done: Bool = i64.ge(index length)
  match done:
    true:
      index
    false:
      let byte: U8 = bytes.get(input index)
      let code: I64 = u8.to-i64(byte)
      let delimiter: Bool = is_delimiter(code)
      match delimiter:
        true:
          index
        false:
          let next: I64 = i64.add(index 1)
          recur(input next length)

fn scan_string(input: Bytes index: I64 length: I64) -> I64 effects[partial]:
  let done: Bool = i64.ge(index length)
  match done:
    true:
      index
    false:
      let byte: U8 = bytes.get(input index)
      let code: I64 = u8.to-i64(byte)
      let escape: Bool = i64.eq(code 92)
      match escape:
        true:
          let next: I64 = i64.add(index 2)
          recur(input next length)
        false:
          let quote: Bool = i64.eq(code 34)
          match quote:
            true:
              i64.add(index 1)
            false:
              let next: I64 = i64.add(index 1)
              recur(input next length)

fn scan_comment(input: Bytes index: I64 length: I64) -> I64 effects[partial]:
  let done: Bool = i64.ge(index length)
  match done:
    true:
      index
    false:
      let byte: U8 = bytes.get(input index)
      let code: I64 = u8.to-i64(byte)
      let newline: Bool = i64.eq(code 10)
      match newline:
        true:
          i64.add(index 1)
        false:
          let next: I64 = i64.add(index 1)
          recur(input next length)

fn push_tagged_token(inout tokens: Vec[Token] kind: I64 tag: I64 start: I64 end: I64) -> Unit effects[alloc]:
  let index: I64 = vec.len(tokens)
  let left: Bool = i64.eq(kind 0)
  let following: I64 = match left:
    true:
      -1
    false:
      i64.add(index 1)
  let token: Token = make Token(kind = kind tag = tag start = start end = end link = -1 next = following)
  vec.push(tokens token)

fn push_token(inout tokens: Vec[Token] kind: I64 start: I64 end: I64) -> Unit effects[alloc]:
  push_tagged_token(tokens kind 0 start end)

fn store-form-open(inout stack: Vec[I64] depth: I64 index: I64) -> Unit effects[alloc partial]:
  let length: I64 = vec.len(stack)
  let existing: Bool = i64.lt(depth length)
  match existing:
    true:
      vec.set(stack depth index)
    false:
      vec.push(stack index)

fn index-form-boundaries-from(inout tokens: Vec[Token] index: I64 length: I64 depth: I64 inout stack: Vec[I64]) -> Unit effects[alloc partial]:
  let done: Bool = i64.ge(index length)
  match done:
    true:
      unit
    false:
      let kind: I64 = token_kind(tokens index)
      let left: Bool = i64.eq(kind 0)
      let right: Bool = i64.eq(kind 1)
      let following: I64 = i64.add(index 1)
      match left:
        true:
          let stored: Unit = store-form-open(stack depth index)
          let next-depth: I64 = i64.add(depth 1)
          recur(tokens following length next-depth stack)
        false:
          match right:
            false:
              recur(tokens following length depth stack)
            true:
              let nested: Bool = i64.gt(depth 0)
              match nested:
                false:
                  recur(tokens following length depth stack)
                true:
                  let next-depth: I64 = i64.sub(depth 1)
                  let open: I64 = vec.get(stack next-depth)
                  let stored: Unit = set-token-next(tokens open following)
                  recur(tokens following length next-depth stack)

fn index-form-boundaries(inout tokens: Vec[Token] first-token: I64) -> Unit effects[alloc partial]:
  let stack: Vec[I64] = vec.new()
  let length: I64 = vec.len(tokens)
  index-form-boundaries-from(tokens first-token length 0 stack)

fn index_ast_boundaries(inout tokens: Vec[Token]) -> Unit effects[alloc partial]:
  index-form-boundaries(tokens 0)

fn lex-from(input: Bytes index: I64 first-token: I64 inout tokens: Vec[Token]) -> Unit effects[alloc partial]:
  let length: I64 = bytes.len(input)
  let done: Bool = i64.ge(index length)
  match done:
    true:
      index-form-boundaries(tokens first-token)
    false:
      let byte: U8 = bytes.get(input index)
      let code: I64 = u8.to-i64(byte)
      let whitespace: Bool = i64.le(code 32)
      match whitespace:
        true:
          let next: I64 = i64.add(index 1)
          recur(input next first-token tokens)
        false:
          let comment: Bool = i64.eq(code 59)
          match comment:
            true:
              let content_start: I64 = i64.add(index 1)
              let next: I64 = scan_comment(input content_start length)
              recur(input next first-token tokens)
            false:
              let left: Bool = i64.eq(code 40)
              match left:
                true:
                  let next: I64 = i64.add(index 1)
                  let pushed: Unit = push_token(tokens 0 index next)
                  recur(input next first-token tokens)
                false:
                  let right: Bool = i64.eq(code 41)
                  match right:
                    true:
                      let next: I64 = i64.add(index 1)
                      let pushed: Unit = push_token(tokens 1 index next)
                      recur(input next first-token tokens)
                    false:
                      let quote: Bool = i64.eq(code 34)
                      match quote:
                        true:
                          let content_start: I64 = i64.add(index 1)
                          let next: I64 = scan_string(input content_start length)
                          let pushed: Unit = push_token(tokens 3 index next)
                          recur(input next first-token tokens)
                        false:
                          let next: I64 = scan_atom(input index length)
                          let pushed: Unit = push_token(tokens 2 index next)
                          recur(input next first-token tokens)

fn lex_data(input: Bytes index: I64 inout tokens: Vec[Token]) -> Unit effects[alloc partial]:
  let first_token: I64 = vec.len(tokens)
  lex-from(input index first_token tokens)

fn lexeme_index_valid(inout lexemes: Vec[Lexeme] index: I64) -> Bool:
  let nonnegative: Bool = i64.ge(index 0)
  let length: I64 = vec.len(lexemes)
  let below: Bool = i64.lt(index length)
  bool.and(nonnegative below)

fn lexeme_kind(inout lexemes: Vec[Lexeme] index: I64) -> I64 effects[partial]:
  let valid: Bool = lexeme_index_valid(lexemes index)
  match valid:
    false:
      -1
    true:
      let lexeme: Lexeme = vec.get(lexemes index)
      get(lexeme kind)

fn lexeme_start(inout lexemes: Vec[Lexeme] index: I64) -> I64 effects[partial]:
  let valid: Bool = lexeme_index_valid(lexemes index)
  match valid:
    false:
      0
    true:
      let lexeme: Lexeme = vec.get(lexemes index)
      get(lexeme start)

fn lexeme_end(inout lexemes: Vec[Lexeme] index: I64) -> I64 effects[partial]:
  let valid: Bool = lexeme_index_valid(lexemes index)
  match valid:
    false:
      0
    true:
      let lexeme: Lexeme = vec.get(lexemes index)
      get(lexeme end)

fn lexeme_line(inout lexemes: Vec[Lexeme] index: I64) -> I64 effects[partial]:
  let valid: Bool = lexeme_index_valid(lexemes index)
  match valid:
    false:
      -1
    true:
      let lexeme: Lexeme = vec.get(lexemes index)
      get(lexeme line)

fn lexeme_indent(inout lexemes: Vec[Lexeme] index: I64) -> I64 effects[partial]:
  let valid: Bool = lexeme_index_valid(lexemes index)
  match valid:
    false:
      -1
    true:
      let lexeme: Lexeme = vec.get(lexemes index)
      get(lexeme indent)

fn lexeme_equal(source: Bytes inout lexemes: Vec[Lexeme] index: I64 text: Bytes) -> Bool effects[partial]:
  let valid: Bool = lexeme_index_valid(lexemes index)
  match valid:
    false:
      false
    true:
      span_equal(source lexeme_start(lexemes index) lexeme_end(lexemes index) text)

fn push_lexeme(inout lexemes: Vec[Lexeme] kind: I64 start: I64 end: I64 line: I64 indent: I64) -> Unit effects[alloc]:
  let lexeme: Lexeme = make Lexeme(kind = kind start = start end = end line = line indent = indent)
  vec.push(lexemes lexeme)

fn modern_arrow_at(input: Bytes index: I64 length: I64) -> Bool effects[partial]:
  let following: I64 = i64.add(index 1)
  let available: Bool = i64.lt(following length)
  match available:
    false:
      false
    true:
      let first: U8 = bytes.get(input index)
      let second: U8 = bytes.get(input following)
      let first_code: I64 = u8.to-i64(first)
      let second_code: I64 = u8.to-i64(second)
      let dash: Bool = i64.eq(first_code 45)
      let greater: Bool = i64.eq(second_code 62)
      bool.and(dash greater)

fn modern_atom_delimiter(code: I64) -> Bool:
  let whitespace: Bool = i64.le(code 32)
  let left_round: Bool = i64.eq(code 40)
  let right_round: Bool = i64.eq(code 41)
  let left_square: Bool = i64.eq(code 91)
  let right_square: Bool = i64.eq(code 93)
  let colon: Bool = i64.eq(code 58)
  let equal: Bool = i64.eq(code 61)
  let comment: Bool = i64.eq(code 35)
  let quote: Bool = i64.eq(code 34)
  let first: Bool = bool.or(whitespace left_round)
  let second: Bool = bool.or(right_round left_square)
  let third: Bool = bool.or(right_square colon)
  let fourth: Bool = bool.or(equal comment)
  bool.or(bool.or(first second) bool.or(bool.or(third fourth) quote))

fn modern_scan_atom(input: Bytes index: I64 length: I64) -> I64 effects[partial]:
  let done: Bool = i64.ge(index length)
  match done:
    true:
      index
    false:
      let byte: U8 = bytes.get(input index)
      let code: I64 = u8.to-i64(byte)
      let delimiter: Bool = modern_atom_delimiter(code)
      let arrow: Bool = modern_arrow_at(input index length)
      let forbidden: Bool = modern_forbidden(code)
      let stop: Bool = bool.or(bool.or(delimiter arrow) forbidden)
      match stop:
        true:
          index
        false:
          let next: I64 = i64.add(index 1)
          recur(input next length)

fn modern_forbidden(code: I64) -> Bool:
  let comma: Bool = i64.eq(code 44)
  let left_brace: Bool = i64.eq(code 123)
  let right_brace: Bool = i64.eq(code 125)
  let semicolon: Bool = i64.eq(code 59)
  bool.or(bool.or(comma left_brace) bool.or(right_brace semicolon))

fn modern_push_fixed(index: I64 length: I64 line: I64 indent: I64 kind: I64 width: I64 inout lexemes: Vec[Lexeme]) -> I64 effects[alloc]:
  let end: I64 = i64.add(index width)
  let within: Bool = i64.le(end length)
  match within:
    false:
      -1
    true:
      let pushed: Unit = push_lexeme(lexemes kind index end line indent)
      end

fn modern_push_string(input: Bytes index: I64 length: I64 line: I64 indent: I64 inout lexemes: Vec[Lexeme]) -> I64 effects[alloc partial]:
  let content: I64 = i64.add(index 1)
  let end: I64 = scan_string(input content length)
  let within: Bool = i64.le(end length)
  match within:
    false:
      -1
    true:
      let nonempty: Bool = i64.gt(end content)
      match nonempty:
        false:
          -1
        true:
          let last: I64 = i64.sub(end 1)
          let byte: U8 = bytes.get(input last)
          let code: I64 = u8.to-i64(byte)
          let terminated: Bool = i64.eq(code 34)
          match terminated:
            false:
              -1
            true:
              let pushed: Unit = push_lexeme(lexemes 1 index end line indent)
              end

fn modern_push_atom(input: Bytes index: I64 length: I64 line: I64 indent: I64 inout lexemes: Vec[Lexeme]) -> I64 effects[alloc partial]:
  let end: I64 = modern_scan_atom(input index length)
  let progress: Bool = i64.gt(end index)
  match progress:
    false:
      -1
    true:
      let pushed: Unit = push_lexeme(lexemes 0 index end line indent)
      end

fn lex_modern_token(input: Bytes index: I64 length: I64 line: I64 indent: I64 inout lexemes: Vec[Lexeme]) -> I64 effects[alloc partial]:
  let byte: U8 = bytes.get(input index)
  let code: I64 = u8.to-i64(byte)
  let forbidden: Bool = modern_forbidden(code)
  match forbidden:
    true:
      -1
    false:
      let quote: Bool = i64.eq(code 34)
      match quote:
        true:
          modern_push_string(input index length line indent lexemes)
        false:
          let left_round: Bool = i64.eq(code 40)
          match left_round:
            true:
              modern_push_fixed(index length line indent 2 1 lexemes)
            false:
              let right_round: Bool = i64.eq(code 41)
              match right_round:
                true:
                  modern_push_fixed(index length line indent 3 1 lexemes)
                false:
                  let left_square: Bool = i64.eq(code 91)
                  match left_square:
                    true:
                      modern_push_fixed(index length line indent 4 1 lexemes)
                    false:
                      let right_square: Bool = i64.eq(code 93)
                      match right_square:
                        true:
                          modern_push_fixed(index length line indent 5 1 lexemes)
                        false:
                          let colon: Bool = i64.eq(code 58)
                          match colon:
                            true:
                              let following: I64 = i64.add(index 1)
                              let double: Bool = match i64.lt(following length):
                                false:
                                  false
                                true:
                                  let next_byte: U8 = bytes.get(input following)
                                  i64.eq(u8.to-i64(next_byte) 58)
                              match double:
                                true:
                                  modern_push_fixed(index length line indent 7 2 lexemes)
                                false:
                                  modern_push_fixed(index length line indent 6 1 lexemes)
                            false:
                              let equal: Bool = i64.eq(code 61)
                              match equal:
                                true:
                                  modern_push_fixed(index length line indent 8 1 lexemes)
                                false:
                                  let arrow: Bool = modern_arrow_at(input index length)
                                  match arrow:
                                    true:
                                      modern_push_fixed(index length line indent 9 2 lexemes)
                                    false:
                                      modern_push_atom(input index length line indent lexemes)

fn lex_success(position: I64) -> LexResult:
  make LexResult(valid = true code = "" start = position end = position)

fn lex_failure(code: Bytes start: I64 end: I64) -> LexResult:
  make LexResult(valid = false code = code start = start end = end)

fn lex_modern_from(input: Bytes index: I64 length: I64 line: I64 at_line_start: Bool indent_spaces: I64 inout lexemes: Vec[Lexeme]) -> LexResult effects[alloc partial]:
  let done: Bool = i64.ge(index length)
  match done:
    true:
      lex_success(length)
    false:
      let byte: U8 = bytes.get(input index)
      let code: I64 = u8.to-i64(byte)
      let tab: Bool = i64.eq(code 9)
      match tab:
        true:
          lex_failure("E0103" index i64.add(index 1))
        false:
          let newline: Bool = i64.eq(code 10)
          match newline:
            true:
              let next: I64 = i64.add(index 1)
              let next_line: I64 = i64.add(line 1)
              recur(input next length next_line true 0 lexemes)
            false:
              let comment: Bool = i64.eq(code 35)
              match comment:
                true:
                  let next: I64 = scan_comment(input i64.add(index 1) length)
                  let next_line: I64 = i64.add(line 1)
                  recur(input next length next_line true 0 lexemes)
                false:
                  let leading_space: Bool = bool.and(at_line_start i64.eq(code 32))
                  match leading_space:
                    true:
                      let next: I64 = i64.add(index 1)
                      let next_spaces: I64 = i64.add(indent_spaces 1)
                      recur(input next length line true next_spaces lexemes)
                    false:
                      let whitespace: Bool = i64.le(code 32)
                      match whitespace:
                        true:
                          let next: I64 = i64.add(index 1)
                          recur(input next length line false indent_spaces lexemes)
                        false:
                          let remainder: I64 = i64.rem(indent_spaces 2)
                          let even: Bool = i64.eq(remainder 0)
                          match even:
                            false:
                              let start: I64 = i64.sub(index indent_spaces)
                              lex_failure("E0104" start index)
                            true:
                              let indent: I64 = i64.div(indent_spaces 2)
                              let next: I64 = lex_modern_token(input index length line indent lexemes)
                              let progress: Bool = i64.gt(next index)
                              match progress:
                                false:
                                  let forbidden: Bool = modern_forbidden(code)
                                  let quote: Bool = i64.eq(code 34)
                                  let diagnostic: Bytes = match forbidden:
                                    true:
                                      "E0106"
                                    false:
                                      match quote:
                                        true:
                                          "E0107"
                                        false:
                                          "E0102"
                                  lex_failure(diagnostic index i64.add(index 1))
                                true:
                                  recur(input next length line false indent_spaces lexemes)

fn lex_modern(input: Bytes inout lexemes: Vec[Lexeme]) -> LexResult effects[alloc partial]:
  let length: I64 = bytes.len(input)
  lex_modern_from(input 0 length 0 true 0 lexemes)

fn indentation_jump(inout lexemes: Vec[Lexeme] index: I64 previous_line: I64 previous_indent: I64) -> I64 effects[partial]:
  let length: I64 = vec.len(lexemes)
  let done: Bool = i64.ge(index length)
  match done:
    true:
      -1
    false:
      let line: I64 = lexeme_line(lexemes index)
      let new_line: Bool = i64.gt(line previous_line)
      match new_line:
        false:
          let next: I64 = i64.add(index 1)
          recur(lexemes next previous_line previous_indent)
        true:
          let indent: I64 = lexeme_indent(lexemes index)
          let first: Bool = i64.lt(previous_line 0)
          let maximum: I64 = match first:
            true:
              0
            false:
              i64.add(previous_indent 1)
          let skipped: Bool = i64.gt(indent maximum)
          match skipped:
            true:
              index
            false:
              let next: I64 = i64.add(index 1)
              recur(lexemes next line indent)

