module syntax

struct Token:
  kind: I64
  tag: I64
  start: I64
  end: I64
  link: I64
  next: I64

struct Lexeme:
  kind: I64
  start: I64
  end: I64
  line: I64
  indent: I64

struct Parse:
  valid: Bool
  next: I64
  code: Bytes

struct ExprParse:
  valid: Bool
  next: I64
  node: I64
  code: Bytes

struct ExprNode:
  kind: I64
  start: I64
  end: I64
  auxiliary: I64
  first_edge: I64
  last_edge: I64

struct ExprEdge:
  node: I64
  name: I64
  next_edge: I64

struct EdgeList:
  first: I64
  last: I64
  count: I64

struct ArgumentParse:
  valid: Bool
  next: I64
  first: I64
  last: I64
  count: I64
