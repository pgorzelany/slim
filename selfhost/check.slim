fn append_form_issue(code: Bytes, form: I64, inout tokens: Vec[syntax.Token], inout issues: Vec[typing.Issue]) -> I64 effects[alloc, partial]:
  let next: I64 = syntax.ast_next(tokens, form)
  let closing: I64 = next - 1
  typing.append_issue(code, form, closing, issues)
  1

fn append_token_issue(code: Bytes, token: I64, inout issues: Vec[typing.Issue]) -> I64 effects[alloc]:
  typing.append_issue(code, token, token, issues)
  1

fn check_path_inout_alias(input: Bytes, inout tokens: Vec[syntax.Token], inout declarations: Vec[ir.Declaration], inout issues: Vec[typing.Issue]) -> I64 effects[alloc, partial]:
  let duplicate: I64 = find_inout_alias_items(input, tokens, syntax.ast_module_items(0), declarations, 0)
  let has_duplicate: Bool = duplicate >= 0
  if has_duplicate:
    append_token_issue("E0349", duplicate, issues)
  else:
    0

fn check_path_fork(input: Bytes, inout tokens: Vec[syntax.Token], inout declarations: Vec[ir.Declaration], inout issues: Vec[typing.Issue]) -> I64 effects[alloc, partial]:
  let fork: I64 = find_invalid_fork(input, tokens, 3)
  let invalid: Bool = fork >= 0
  if invalid:
    append_form_issue("E0356", fork, tokens, issues)
  else:
    check_path_inout(input, tokens, declarations, issues)

fn check_path_inout(input: Bytes, inout tokens: Vec[syntax.Token], inout declarations: Vec[ir.Declaration], inout issues: Vec[typing.Issue]) -> I64 effects[alloc, partial]:
  let effects: I64 = check_path_effects(input, tokens, declarations, issues)
  let prior_error: Bool = effects > 0
  if prior_error:
    effects
  else:
    let temporary: I64 = find_inout_temporary_items(input, tokens, syntax.ast_module_items(0), declarations, 0)
    let has_temporary: Bool = temporary >= 0
    if has_temporary:
      append_form_issue("E0348", temporary, tokens, issues)
    else:
      check_path_inout_alias(input, tokens, declarations, issues)

fn boolean_arms_have(source: Bytes, inout tokens: Vec[syntax.Token], cursor: I64, pattern: Bytes) -> Bool effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    false
  else:
    let arm_pattern: I64 = syntax.ast_arm_pattern(cursor)
    let found: Bool = syntax.ast_node_text_is(source, tokens, arm_pattern, pattern)
    if found:
      true
    else:
      let next: I64 = syntax.ast_next(tokens, cursor)
      recur(source, tokens, next, pattern)

fn boolean_match_incomplete(source: Bytes, inout tokens: Vec[syntax.Token], expr: I64) -> Bool effects[partial]:
  let value: I64 = syntax.ast_match_value(expr)
  let true_value: Bool = syntax.ast_node_text_is(source, tokens, value, "true")
  let false_value: Bool = syntax.ast_node_text_is(source, tokens, value, "false")
  let boolean_value: Bool = true_value || false_value
  if boolean_value:
    let arms: I64 = syntax.ast_match_arms(tokens, expr)
    let has_true: Bool = boolean_arms_have(source, tokens, arms, "true")
    let has_false: Bool = boolean_arms_have(source, tokens, arms, "false")
    let complete: Bool = has_true && has_false
    !complete
  else:
    false

fn find_nonexhaustive_in_span(source: Bytes, inout tokens: Vec[syntax.Token], cursor: I64, end: I64) -> I64 effects[partial]:
  let done: Bool = cursor >= end
  if done:
    -1
  else:
    let kind: I64 = syntax.ast_node_kind(tokens, cursor)
    let form: Bool = kind == 0
    let head: I64 = syntax.ast_list_first(cursor)
    let match_form: Bool = if form:
      syntax.ast_expression_is_match(source, tokens, cursor)
    else:
      false
    let incomplete: Bool = if match_form:
      boolean_match_incomplete(source, tokens, cursor)
    else:
      false
    if incomplete:
      cursor
    else:
      let next: I64 = syntax.ast_node_after(cursor)
      recur(source, tokens, next, end)

fn find_nonexhaustive_items(source: Bytes, inout tokens: Vec[syntax.Token], module_items: I64, inout declarations: Vec[ir.Declaration], index: I64) -> I64 effects[partial]:
  let declaration_count: I64 = vec.len(declarations)
  let done: Bool = index >= declaration_count
  if done:
    -1
  else:
    let declaration: ir.Declaration = vec.get(declarations, index)
    let cursor: I64 = declaration.form
    let function_item: Bool = syntax.ast_item_is_function(source, tokens, cursor)
    let incomplete: I64 = if function_item:
      let params: I64 = syntax.ast_function_parameters(cursor)
      let return_type: I64 = syntax.ast_function_return_type(tokens, cursor)
      let effects: I64 = syntax.ast_function_effects(tokens, cursor)
      let body: I64 = syntax.ast_function_body(tokens, cursor)
      let body_end: I64 = syntax.ast_next(tokens, body)
      find_nonexhaustive_in_span(source, tokens, body, body_end)
    else:
      -1
    let found: Bool = incomplete >= 0
    if found:
      incomplete
    else:
      let next: I64 = index + 1
      recur(source, tokens, module_items, declarations, next)

fn fork_parameters_safe(source: Bytes, inout tokens: Vec[syntax.Token], cursor: I64) -> Bool effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    true
  else:
    let borrowed: Bool = parameter_is_inout(source, tokens, cursor)
    let type: I64 = syntax.ast_binding_type(source, tokens, cursor)
    let scalar: I64 = syntax.scalar_type_kind(source, tokens, type)
    let safe: Bool = (!borrowed) && (scalar >= 0)
    if safe:
      let next: I64 = syntax.ast_next(tokens, cursor)
      recur(source, tokens, next)
    else:
      false

fn fork_arguments_safe(source: Bytes, inout tokens: Vec[syntax.Token], arguments: I64, parameters: I64) -> Bool effects[partial]:
  let argument_kind: I64 = syntax.ast_node_kind(tokens, arguments)
  let parameter_kind: I64 = syntax.ast_node_kind(tokens, parameters)
  let arguments_done: Bool = argument_kind == 1
  let parameters_done: Bool = parameter_kind == 1
  let either_done: Bool = arguments_done || parameters_done
  if either_done:
    arguments_done && parameters_done
  else:
    let atom: Bool = argument_kind == 2
    let string_value: Bool = argument_kind == 3
    let atomic: Bool = atom || string_value
    let borrowed: Bool = parameter_is_inout(source, tokens, parameters)
    let type: I64 = syntax.ast_binding_type(source, tokens, parameters)
    let scalar: I64 = syntax.scalar_type_kind(source, tokens, type)
    let safe: Bool = atomic && ((!borrowed) && (scalar >= 0))
    if safe:
      let next_argument: I64 = syntax.ast_next(tokens, arguments)
      let next_parameter: I64 = syntax.ast_next(tokens, parameters)
      recur(source, tokens, next_argument, next_parameter)
    else:
      false

fn fork_builtin_safe(source: Bytes, inout tokens: Vec[syntax.Token], callee: I64) -> Bool effects[partial]:
  let tcp: Bool = syntax.ast_node_text_is(source, tokens, callee, "io.tcp_exchange")
  let clock: Bool = syntax.ast_node_text_is(source, tokens, callee, "io.monotonic_ms")
  let vec_new: Bool = syntax.ast_node_text_is(source, tokens, callee, "vec.new")
  let vec_len: Bool = syntax.ast_node_text_is(source, tokens, callee, "vec.len")
  let bool_not: Bool = syntax.ast_node_text_is(source, tokens, callee, "bool.not")
  let bool_and: Bool = syntax.ast_node_text_is(source, tokens, callee, "bool.and")
  let bool_or: Bool = syntax.ast_node_text_is(source, tokens, callee, "bool.or")
  let i64_eq: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.eq")
  let i64_lt: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.lt")
  let i64_le: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.le")
  let i64_gt: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.gt")
  let i64_ge: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.ge")
  let bytes_len: Bool = syntax.ast_node_text_is(source, tokens, callee, "bytes.len")
  let u8_i64: Bool = syntax.ast_node_text_is(source, tokens, callee, "u8.to_i64")
  let host: Bool = tcp || clock
  let booleans: Bool = bool_not || (bool_and || bool_or)
  let compares: Bool = i64_eq || (i64_lt || (i64_le || (i64_gt || i64_ge)))
  let storage: Bool = vec_new || (vec_len || (bytes_len || u8_i64))
  host || (booleans || (compares || storage))

fn fork_task_body_scan(source: Bytes, inout tokens: Vec[syntax.Token], index: I64, end: I64, state: I64) -> I64 effects[partial]:
  let done: Bool = index >= end
  if done:
    state
  else:
    let kind: I64 = syntax.ast_node_kind(tokens, index)
    let form: Bool = kind == 0
    let head: I64 = syntax.ast_list_first(index)
    let set_form: Bool = if form:
      syntax.ast_expression_is_set(source, tokens, index)
    else:
      false
    let recur_form: Bool = if form:
      syntax.ast_expression_is_recur(source, tokens, index)
    else:
      false
    let fork_form: Bool = if form:
      syntax.ast_expression_is_fork(source, tokens, index)
    else:
      false
    let forbidden: Bool = set_form || (recur_form || fork_form)
    let call_form: Bool = if form:
      syntax.ast_expression_is_call(source, tokens, index)
    else:
      false
    let callee: I64 = syntax.ast_call_callee(index)
    let builtin_safe: Bool = if call_form:
      fork_builtin_safe(source, tokens, callee)
    else:
      true
    let tcp: Bool = if call_form:
      syntax.ast_node_text_is(source, tokens, callee, "io.tcp_exchange")
    else:
      false
    let clock: Bool = if call_form:
      syntax.ast_node_text_is(source, tokens, callee, "io.monotonic_ms")
    else:
      false
    let host: Bool = tcp || clock
    let safe: Bool = (!forbidden) && builtin_safe
    let next_state: I64 = if safe:
      if host:
        2
      else:
        state
    else:
      0
    if safe:
      let next: I64 = syntax.ast_node_after(index)
      recur(source, tokens, next, end, next_state)
    else:
      0

fn fork_call_valid(source: Bytes, inout tokens: Vec[syntax.Token], expr: I64) -> Bool effects[partial]:
  let callee: I64 = syntax.ast_call_callee(expr)
  let builtin: Bool = builtin_is_known(source, tokens, callee)
  let item: I64 = syntax.ast_node_link(tokens, callee)
  let linked: Bool = item >= 0
  let direct: Bool = (!builtin) && linked
  if direct:
    let params: I64 = syntax.ast_function_parameters(item)
    let parameters_safe: Bool = fork_parameters_safe(source, tokens, syntax.ast_parameters_first(params))
    let arguments: I64 = syntax.ast_call_arguments(expr)
    let arguments_safe: Bool = fork_arguments_safe(source, tokens, arguments, syntax.ast_parameters_first(params))
    let return_type: I64 = syntax.ast_function_return_type(tokens, item)
    let effect_form: I64 = syntax.ast_function_effects(tokens, item)
    let first_effect: I64 = syntax.ast_effects_first(effect_form)
    let has_io: Bool = effects.list_has(source, tokens, first_effect, 2)
    let has_partial: Bool = effects.list_has(source, tokens, first_effect, 3)
    let effects_safe: Bool = has_io && (!has_partial)
    let body: I64 = syntax.ast_function_body(tokens, item)
    let end: I64 = syntax.ast_next(tokens, body)
    let body_state: I64 = fork_task_body_scan(source, tokens, body, end, 1)
    let body_safe: Bool = body_state == 2
    parameters_safe && (arguments_safe && (effects_safe && body_safe))
  else:
    false

fn fork_task_valid(source: Bytes, inout tokens: Vec[syntax.Token], expr: I64) -> Bool effects[partial]:
  let call_form: Bool = syntax.ast_expression_is_call(source, tokens, expr)
  if call_form:
    fork_call_valid(source, tokens, expr)
  else:
    false

fn fork_arguments_use_name(source: Bytes, inout tokens: Vec[syntax.Token], cursor: I64, name: I64) -> Bool effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    false
  else:
    let start: I64 = syntax.ast_node_start(tokens, cursor)
    let end: I64 = syntax.ast_node_end(tokens, cursor)
    let name_start: I64 = syntax.ast_node_start(tokens, name)
    let name_end: I64 = syntax.ast_node_end(tokens, name)
    let same: Bool = syntax.spans_equal(source, start, end, name_start, name_end)
    if same:
      true
    else:
      let next: I64 = syntax.ast_next(tokens, cursor)
      recur(source, tokens, next, name)

fn fork_second_let_valid(source: Bytes, inout tokens: Vec[syntax.Token], first_name: I64, first_value: I64, second: I64) -> Bool effects[partial]:
  let second_value: I64 = syntax.ast_let_value(tokens, second)
  let second_body: I64 = syntax.ast_let_body(tokens, second)
  let after_body: I64 = syntax.ast_next(tokens, second_body)
  let exact: Bool = syntax.ast_list_done(tokens, after_body)
  let first_task: Bool = fork_task_valid(source, tokens, first_value)
  let second_task: Bool = fork_task_valid(source, tokens, second_value)
  if second_task:
    let second_arguments: I64 = syntax.ast_call_arguments(second_value)
    let dependent: Bool = fork_arguments_use_name(source, tokens, second_arguments, first_name)
    let independent: Bool = !dependent
    exact && (first_task && independent)
  else:
    false

fn fork_first_let_valid(source: Bytes, inout tokens: Vec[syntax.Token], first: I64) -> Bool effects[partial]:
  let first_name: I64 = syntax.ast_let_name(first)
  let first_value: I64 = syntax.ast_let_value(tokens, first)
  let second: I64 = syntax.ast_let_body(tokens, first)
  let after_second: I64 = syntax.ast_next(tokens, second)
  let exact: Bool = syntax.ast_list_done(tokens, after_second)
  let second_let: Bool = syntax.ast_expression_is_let(source, tokens, second)
  if second_let:
    exact && fork_second_let_valid(source, tokens, first_name, first_value, second)
  else:
    false

fn fork_leading_expression(source: Bytes, inout tokens: Vec[syntax.Token], cursor: I64, site: I64) -> Bool effects[partial]:
  let found: Bool = cursor == site
  if found:
    true
  else:
    let let_form: Bool = syntax.ast_expression_is_let(source, tokens, cursor)
    if let_form:
      let body: I64 = syntax.ast_let_body(tokens, cursor)
      recur(source, tokens, body, site)
    else:
      false

fn fork_leading_items(source: Bytes, inout tokens: Vec[syntax.Token], cursor: I64, site: I64) -> Bool effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    false
  else:
    let function_item: Bool = syntax.ast_item_is_function(source, tokens, cursor)
    let leading: Bool = if function_item:
      let params: I64 = syntax.ast_function_parameters(cursor)
      let return_type: I64 = syntax.ast_function_return_type(tokens, cursor)
      let effects_form: I64 = syntax.ast_function_effects(tokens, cursor)
      let body: I64 = syntax.ast_next(tokens, effects_form)
      fork_leading_expression(source, tokens, body, site)
    else:
      false
    if leading:
      true
    else:
      let next: I64 = syntax.ast_next(tokens, cursor)
      recur(source, tokens, next, site)

fn fork_form_valid(source: Bytes, inout tokens: Vec[syntax.Token], expr: I64) -> Bool effects[partial]:
  let first: I64 = syntax.ast_fork_body(expr)
  let after_first: I64 = syntax.ast_next(tokens, first)
  let exact: Bool = syntax.ast_list_done(tokens, after_first)
  let first_let: Bool = syntax.ast_expression_is_let(source, tokens, first)
  if first_let:
    let shape: Bool = exact && fork_first_let_valid(source, tokens, first)
    let leading: Bool = fork_leading_items(source, tokens, syntax.ast_module_items(0), expr)
    shape && leading
  else:
    false

fn find_invalid_fork(source: Bytes, inout tokens: Vec[syntax.Token], index: I64) -> I64 effects[partial]:
  let count: I64 = vec.len(tokens)
  let done: Bool = index >= count
  if done:
    -1
  else:
    let kind: I64 = syntax.ast_node_kind(tokens, index)
    let form: Bool = kind == 0
    let head: I64 = syntax.ast_list_first(index)
    let fork_form: Bool = if form:
      syntax.ast_expression_is_fork(source, tokens, index)
    else:
      false
    let valid: Bool = if fork_form:
      fork_form_valid(source, tokens, index)
    else:
      true
    if valid:
      let next: I64 = syntax.ast_node_after(index)
      recur(source, tokens, next)
    else:
      index

fn check_path_exhaustive(input: Bytes, inout tokens: Vec[syntax.Token], inout declarations: Vec[ir.Declaration], inout issues: Vec[typing.Issue]) -> I64 effects[alloc, io, partial]:
  let checked: I64 = check_path_project(input, tokens, declarations)
  let prior_error: Bool = checked > 0
  if prior_error:
    checked
  else:
    let incomplete: I64 = find_nonexhaustive_items(input, tokens, syntax.ast_module_items(0), declarations, 0)
    let invalid: Bool = incomplete >= 0
    if invalid:
      append_form_issue("E0336", incomplete, tokens, issues)
    else:
      0

fn call_missing_effect(source: Bytes, inout tokens: Vec[syntax.Token], module_items: I64, declared_effects: I64, callee: I64, effect_code: I64) -> Bool effects[partial]:
  let done: Bool = effect_code > 3
  if done:
    false
  else:
    let required: Bool = effects.call_requires(source, tokens, callee, effect_code)
    let first_declared: I64 = syntax.ast_effects_first(declared_effects)
    let declared: Bool = effects.list_has(source, tokens, first_declared, effect_code)
    let not_declared: Bool = !declared
    let missing: Bool = required && not_declared
    if missing:
      true
    else:
      let next: I64 = effect_code + 1
      recur(source, tokens, module_items, declared_effects, callee, next)

fn find_missing_effect_in_span(source: Bytes, inout tokens: Vec[syntax.Token], module_items: I64, declared_effects: I64, cursor: I64, end: I64) -> I64 effects[partial]:
  let done: Bool = cursor >= end
  if done:
    -1
  else:
    let kind: I64 = syntax.ast_node_kind(tokens, cursor)
    let form: Bool = kind == 0
    let head: I64 = syntax.ast_list_first(cursor)
    let call_form: Bool = if form:
      syntax.ast_expression_is_call(source, tokens, cursor)
    else:
      false
    let missing: Bool = if call_form:
      let callee: I64 = syntax.ast_call_callee(cursor)
      call_missing_effect(source, tokens, module_items, declared_effects, callee, 1)
    else:
      false
    if missing:
      cursor
    else:
      let next: I64 = syntax.ast_node_after(cursor)
      recur(source, tokens, module_items, declared_effects, next, end)

fn find_missing_effect_items(source: Bytes, inout tokens: Vec[syntax.Token], module_items: I64, inout declarations: Vec[ir.Declaration], index: I64) -> I64 effects[partial]:
  let declaration_count: I64 = vec.len(declarations)
  let done: Bool = index >= declaration_count
  if done:
    -1
  else:
    let declaration: ir.Declaration = vec.get(declarations, index)
    let cursor: I64 = declaration.form
    let function_item: Bool = syntax.ast_item_is_function(source, tokens, cursor)
    let missing: I64 = if function_item:
      let params: I64 = syntax.ast_function_parameters(cursor)
      let return_type: I64 = syntax.ast_function_return_type(tokens, cursor)
      let declared_effects: I64 = syntax.ast_function_effects(tokens, cursor)
      let body: I64 = syntax.ast_next(tokens, declared_effects)
      let body_end: I64 = syntax.ast_next(tokens, body)
      find_missing_effect_in_span(source, tokens, module_items, declared_effects, body, body_end)
    else:
      -1
    let found: Bool = missing >= 0
    if found:
      missing
    else:
      let next: I64 = index + 1
      recur(source, tokens, module_items, declarations, next)

fn check_path_effects(input: Bytes, inout tokens: Vec[syntax.Token], inout declarations: Vec[ir.Declaration], inout issues: Vec[typing.Issue]) -> I64 effects[alloc, partial]:
  let missing: I64 = find_missing_effect_items(input, tokens, syntax.ast_module_items(0), declarations, 0)
  let invalid: Bool = missing >= 0
  if invalid:
    append_form_issue("E0343", missing, tokens, issues)
  else:
    0

fn find_overqualified(source: Bytes, inout tokens: Vec[syntax.Token], index: I64, length: I64) -> I64 effects[partial]:
  let done: Bool = index >= length
  if done:
    -1
  else:
    let kind: I64 = syntax.ast_node_kind(tokens, index)
    let atom: Bool = kind == 2
    let start: I64 = syntax.ast_node_start(tokens, index)
    let end: I64 = syntax.ast_node_end(tokens, index)
    let slashes: I64 = if atom:
      syntax.span_count_byte(source, start, end, 47, 0)
    else:
      0
    let invalid: Bool = slashes > 1
    if invalid:
      index
    else:
      let next: I64 = index + 1
      recur(source, tokens, next, length)

fn check_path_project(input: Bytes, inout tokens: Vec[syntax.Token], inout declarations: Vec[ir.Declaration]) -> I64 effects[alloc, io, partial]:
  let core: I64 = check_path_full(input, tokens, declarations)
  let core_error: Bool = core > 0
  if core_error:
    core
  else:
    let token_count: I64 = vec.len(tokens)
    let invalid_token: I64 = find_overqualified(input, tokens, 0, token_count)
    let invalid: Bool = invalid_token >= 0
    if invalid:
      let start: I64 = syntax.ast_node_start(tokens, invalid_token)
      let end: I64 = syntax.ast_node_end(tokens, invalid_token)
      report_diagnostic("E0228", start, end)
    else:
      0

fn atom_type_kind(source: Bytes, inout tokens: Vec[syntax.Token], expr: I64) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, expr)
  let string_value: Bool = kind == 3
  if string_value:
    4
  else:
    let true_value: Bool = syntax.ast_node_text_is(source, tokens, expr, "true")
    let false_value: Bool = syntax.ast_node_text_is(source, tokens, expr, "false")
    let bool_value: Bool = true_value || false_value
    if bool_value:
      1
    else:
      let void_value: Bool = syntax.ast_node_text_is(source, tokens, expr, "void")
      if void_value:
        0
      else:
        let number: Bool = syntax.first_byte_is_number(source, tokens, expr)
        if number:
          3
        else:
          -1

fn report_issue(inout tokens: Vec[syntax.Token], issue: typing.Issue) -> I64 effects[alloc, io, partial]:
  let start_token: I64 = issue.start
  let end_token: I64 = issue.end
  let start: I64 = syntax.ast_node_start(tokens, start_token)
  let end: I64 = syntax.ast_node_end(tokens, end_token)
  report_diagnostic(issue.code, start, end)

fn report_issues(inout tokens: Vec[syntax.Token], inout issues: Vec[typing.Issue], index: I64, count: I64) -> I64 effects[alloc, io, partial]:
  let length: I64 = vec.len(issues)
  let done: Bool = index >= length
  if done:
    let invalid: Bool = count > 0
    if invalid:
      1
    else:
      0
  else:
    let issue: typing.Issue = vec.get(issues, index)
    let reported: I64 = report_issue(tokens, issue)
    let next: I64 = index + 1
    let total: I64 = count + reported
    recur(tokens, issues, next, total)

fn find_unterminated(inout tokens: Vec[syntax.Token], index: I64, length: I64, depth: I64, form_start: I64) -> I64 effects[partial]:
  let done: Bool = index >= length
  if done:
    let open: Bool = depth > 0
    if open:
      form_start
    else:
      -1
  else:
    let kind: I64 = syntax.ast_node_kind(tokens, index)
    let left: Bool = kind == 0
    let right: Bool = kind == 1
    let at_root: Bool = depth == 0
    let root_left: Bool = left && at_root
    let next_start: I64 = if root_left:
      syntax.ast_node_start(tokens, index)
    else:
      form_start
    let increased: I64 = if left:
      depth + 1
    else:
      depth
    let next_depth: I64 = if right:
      increased - 1
    else:
      increased
    let next: I64 = syntax.ast_node_after(index)
    recur(tokens, next, length, next_depth, next_start)

fn append_diagnostic_identity(diagnostic: Diagnostic, inout output: Vec[U8]) -> Void effects[alloc, partial]:
  let code: Bytes = diagnostic.code
  let start: I64 = diagnostic.start
  let end: I64 = diagnostic.end
  text.append_text(output, code)
  text.append_text(output, "@")
  text.append_nonnegative_i64(start, output)
  text.append_text(output, ":")
  text.append_nonnegative_i64(end, output)
  text.append_text(output, "\n")

fn check_path(input: Bytes, inout tokens: Vec[syntax.Token], inout declarations: Vec[ir.Declaration]) -> I64 effects[alloc, io, partial]:
  let token_count: I64 = vec.len(tokens)
  let unterminated: I64 = find_unterminated(tokens, 0, token_count, 0, 0)
  let delimiters_valid: Bool = unterminated < 0
  let shape_valid: Bool = validate.executable_shape_valid(input, tokens)
  let valid: Bool = delimiters_valid && shape_valid
  if valid:
    0
  else:
    let input_length: I64 = bytes.len(input)
    let diagnostic: Diagnostic = Diagnostic(code: "E0102", start: 0, end: input_length)
    let output: Vec[U8] = vec.new()
    append_diagnostic_identity(diagnostic, output)
    let bytes: Bytes = bytes.freeze(output)
    io.print_bytes(bytes)
    1

fn last_form_in_list(inout tokens: Vec[syntax.Token], cursor: I64, previous: I64) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    previous
  else:
    let next: I64 = syntax.ast_next(tokens, cursor)
    let old_cursor: I64 = cursor
    recur(tokens, next, old_cursor)

fn known_expr_head(source: Bytes, inout tokens: Vec[syntax.Token], expr: I64) -> Bool effects[partial]:
  let let_form: Bool = syntax.ast_expression_is_let(source, tokens, expr)
  let call_form: Bool = syntax.ast_expression_is_call(source, tokens, expr)
  let make_form: Bool = syntax.ast_expression_is_make(source, tokens, expr)
  let get_form: Bool = syntax.ast_expression_is_get(source, tokens, expr)
  let case_form: Bool = syntax.ast_expression_is_case(source, tokens, expr)
  let match_form: Bool = syntax.ast_expression_is_match(source, tokens, expr)
  let recur_form: Bool = syntax.ast_expression_is_recur(source, tokens, expr)
  let set_form: Bool = syntax.ast_expression_is_set(source, tokens, expr)
  let fork_form: Bool = syntax.ast_expression_is_fork(source, tokens, expr)
  let first: Bool = let_form || call_form
  let second: Bool = make_form || get_form
  let third: Bool = case_form || match_form
  let fourth: Bool = recur_form || set_form
  let left: Bool = first || second
  let right: Bool = third || fourth
  left || (right || fork_form)

fn find_unknown_pair(source: Bytes, inout tokens: Vec[syntax.Token], value: I64, body: I64) -> I64 effects[partial]:
  let value_unknown: I64 = find_unknown_expr(source, tokens, value)
  let found: Bool = value_unknown >= 0
  if found:
    value_unknown
  else:
    find_unknown_expr(source, tokens, body)

fn find_unknown_control(source: Bytes, inout tokens: Vec[syntax.Token], expr: I64) -> I64 effects[partial]:
  let match_form: Bool = syntax.ast_expression_is_match(source, tokens, expr)
  if match_form:
    let value: I64 = syntax.ast_match_value(expr)
    let first_arm: I64 = syntax.ast_match_arms(tokens, expr)
    let value_unknown: I64 = find_unknown_expr(source, tokens, value)
    let found: Bool = value_unknown >= 0
    if found:
      value_unknown
    else:
      find_unknown_arms(source, tokens, first_arm)
  else:
    let call_form: Bool = syntax.ast_expression_is_call(source, tokens, expr)
    let first: I64 = if call_form:
      syntax.ast_call_arguments(expr)
    else:
      syntax.ast_recur_arguments(expr)
    find_unknown_forms(source, tokens, first)

fn find_unknown_data(source: Bytes, inout tokens: Vec[syntax.Token], expr: I64) -> I64 effects[partial]:
  let make_form: Bool = syntax.ast_expression_is_make(source, tokens, expr)
  if make_form:
    find_unknown_fields(source, tokens, syntax.ast_make_fields(expr))
  else:
    let get_form: Bool = syntax.ast_expression_is_get(source, tokens, expr)
    if get_form:
      find_unknown_expr(source, tokens, syntax.ast_get_value(expr))
    else:
      let case_form: Bool = syntax.ast_expression_is_case(source, tokens, expr)
      if case_form:
        find_unknown_forms(source, tokens, syntax.ast_case_payload(tokens, expr))
      else:
        find_unknown_control(source, tokens, expr)

fn find_unknown_known(source: Bytes, inout tokens: Vec[syntax.Token], expr: I64) -> I64 effects[partial]:
  let let_form: Bool = syntax.ast_expression_is_let(source, tokens, expr)
  if let_form:
    find_unknown_pair(source, tokens, syntax.ast_let_value(tokens, expr), syntax.ast_let_body(tokens, expr))
  else:
    let set_form: Bool = syntax.ast_expression_is_set(source, tokens, expr)
    if set_form:
      find_unknown_pair(source, tokens, syntax.ast_set_value(expr), syntax.ast_set_body(tokens, expr))
    else:
      let fork_form: Bool = syntax.ast_expression_is_fork(source, tokens, expr)
      if fork_form:
        find_unknown_expr(source, tokens, syntax.ast_fork_body(expr))
      else:
        find_unknown_data(source, tokens, expr)

fn find_unknown_expr(source: Bytes, inout tokens: Vec[syntax.Token], expr: I64) -> I64 effects[partial]:
  let scalar: Bool = syntax.ast_node_is_scalar(tokens, expr)
  if scalar:
    -1
  else:
    let known: Bool = known_expr_head(source, tokens, expr)
    if known:
      find_unknown_known(source, tokens, expr)
    else:
      syntax.ast_expression_marker(expr)

fn find_unknown_forms(source: Bytes, inout tokens: Vec[syntax.Token], cursor: I64) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    -1
  else:
    let unknown: I64 = find_unknown_expr(source, tokens, cursor)
    let found: Bool = unknown >= 0
    if found:
      unknown
    else:
      let next: I64 = syntax.ast_next(tokens, cursor)
      recur(source, tokens, next)

fn find_unknown_fields(source: Bytes, inout tokens: Vec[syntax.Token], cursor: I64) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    -1
  else:
    let value: I64 = syntax.ast_member_value(cursor)
    let unknown: I64 = find_unknown_expr(source, tokens, value)
    let found: Bool = unknown >= 0
    if found:
      unknown
    else:
      let next: I64 = syntax.ast_next(tokens, cursor)
      recur(source, tokens, next)

fn find_unknown_arms(source: Bytes, inout tokens: Vec[syntax.Token], cursor: I64) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    -1
  else:
    let first: I64 = syntax.ast_arm_pattern(cursor)
    let body: I64 = last_form_in_list(tokens, first, first)
    let unknown: I64 = find_unknown_expr(source, tokens, body)
    let found: Bool = unknown >= 0
    if found:
      unknown
    else:
      let next: I64 = syntax.ast_next(tokens, cursor)
      recur(source, tokens, next)

fn find_unknown_items(source: Bytes, inout tokens: Vec[syntax.Token], inout declarations: Vec[ir.Declaration], index: I64) -> I64 effects[partial]:
  let count: I64 = vec.len(declarations)
  let done: Bool = index >= count
  if done:
    -1
  else:
    let declaration: ir.Declaration = vec.get(declarations, index)
    let cursor: I64 = declaration.form
    let function_item: Bool = syntax.ast_item_is_function(source, tokens, cursor)
    let unknown: I64 = if function_item:
      let params: I64 = syntax.ast_function_parameters(cursor)
      let return_type: I64 = syntax.ast_function_return_type(tokens, cursor)
      let effects: I64 = syntax.ast_function_effects(tokens, cursor)
      let body: I64 = syntax.ast_function_body(tokens, cursor)
      find_unknown_expr(source, tokens, body)
    else:
      -1
    let found: Bool = unknown >= 0
    if found:
      unknown
    else:
      let next: I64 = index + 1
      recur(source, tokens, declarations, next)

fn report_diagnostic(code: Bytes, start: I64, end: I64) -> I64 effects[alloc, io, partial]:
  let diagnostic: Diagnostic = Diagnostic(code: code, start: start, end: end)
  let output: Vec[U8] = vec.new()
  append_diagnostic_identity(diagnostic, output)
  let bytes: Bytes = bytes.freeze(output)
  io.print_bytes(bytes)
  1

fn report_program_parse(parsed: syntax.ProgramParse) -> I64 effects[alloc, io, partial]:
  report_diagnostic(parsed.code, parsed.start, parsed.end)

fn check_path_full(input: Bytes, inout tokens: Vec[syntax.Token], inout declarations: Vec[ir.Declaration]) -> I64 effects[alloc, io, partial]:
  let lexical: I64 = check_path(input, tokens, declarations)
  let lexical_error: Bool = lexical > 0
  if lexical_error:
    lexical
  else:
    let unknown: I64 = find_unknown_items(input, tokens, declarations, 0)
    let invalid: Bool = unknown >= 0
    if invalid:
      let start: I64 = syntax.ast_node_start(tokens, unknown)
      let end: I64 = syntax.ast_node_end(tokens, unknown)
      report_diagnostic("E0221", start, end)
    else:
      0
