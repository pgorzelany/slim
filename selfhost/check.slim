module check

struct Diagnostic:
  code: Bytes
  start: I64
  end: I64

fn parameter_has_name(source: Bytes, inout tokens: Vec[syntax.Token], parameter: I64, name_start: I64, name_end: I64) -> Bool effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, parameter)
  let done: Bool = kind == 1
  if done:
    false
  else:
    let parameter_name: I64 = recur_parameter_name(source, tokens, parameter)
    let candidate_start: I64 = syntax.ast_node_start(tokens, parameter_name)
    let candidate_end: I64 = syntax.ast_node_end(tokens, parameter_name)
    let same: Bool = syntax.spans_equal(source, candidate_start, candidate_end, name_start, name_end)
    if same:
      true
    else:
      let next: I64 = syntax.ast_next(tokens, parameter)
      recur(source, tokens, next, name_start, name_end)

fn prior_let_has_name(source: Bytes, inout tokens: Vec[syntax.Token], cursor: I64, end: I64, name_start: I64, name_end: I64) -> Bool effects[partial]:
  let done: Bool = cursor >= end
  if done:
    false
  else:
    let kind: I64 = syntax.ast_node_kind(tokens, cursor)
    let form: Bool = kind == 0
    let head: I64 = syntax.ast_list_first(cursor)
    let let_form: Bool = if form:
      syntax.ast_expression_is_let(source, tokens, cursor)
    else:
      false
    let candidate: I64 = syntax.ast_let_name(cursor)
    let candidate_start: I64 = syntax.ast_node_start(tokens, candidate)
    let candidate_end: I64 = syntax.ast_node_end(tokens, candidate)
    let same: Bool = if let_form:
      syntax.spans_equal(source, candidate_start, candidate_end, name_start, name_end)
    else:
      false
    if same:
      true
    else:
      let next: I64 = syntax.ast_node_after(cursor)
      recur(source, tokens, next, end, name_start, name_end)

fn match_name_is_known(source: Bytes, inout tokens: Vec[syntax.Token], params: I64, body_start: I64, name: I64) -> Bool effects[partial]:
  let actual: I64 = atom_type_kind(source, tokens, name)
  let scalar: Bool = actual >= 0
  if scalar:
    true
  else:
    let name_start: I64 = syntax.ast_node_start(tokens, name)
    let name_end: I64 = syntax.ast_node_end(tokens, name)
    let first_parameter: I64 = syntax.ast_parameters_first(params)
    let parameter: Bool = parameter_has_name(source, tokens, first_parameter, name_start, name_end)
    if parameter:
      true
    else:
      prior_let_has_name(source, tokens, body_start, name, name_start, name_end)

fn append_boolean_match_arms(source: Bytes, inout tokens: Vec[syntax.Token], params: I64, body_start: I64, expected: I64, cursor: I64, seen_true: Bool, seen_false: Bool, inout issues: Vec[typing.Issue], count: I64) -> I64 effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    count
  else:
    let pattern: I64 = syntax.ast_arm_pattern(cursor)
    let true_pattern: Bool = syntax.ast_node_text_is(source, tokens, pattern, "true")
    let false_pattern: Bool = syntax.ast_node_text_is(source, tokens, pattern, "false")
    let duplicate: Bool = if true_pattern:
      seen_true
    else:
      if false_pattern:
        seen_false
      else:
        false
    let next: I64 = syntax.ast_next(tokens, cursor)
    let duplicate_report: I64 = if duplicate:
      append_form_issue("E0335", cursor, tokens, issues)
    else:
      0
    let first: I64 = syntax.ast_arm_pattern(cursor)
    let body: I64 = last_form_in_list(tokens, first, first)
    let body_kind: I64 = syntax.ast_node_kind(tokens, body)
    let named: Bool = body_kind == 2
    let known: Bool = if named:
      match_name_is_known(source, tokens, params, body_start, body)
    else:
      true
    let unknown: Bool = !known
    let unknown_report: I64 = if unknown:
      append_token_issue("E0314", body, issues)
    else:
      0
    let actual: I64 = atom_type_kind(source, tokens, body)
    let expected_known: Bool = expected >= 0
    let actual_known: Bool = actual >= 0
    let both_known: Bool = expected_known && actual_known
    let same_type: Bool = expected == actual
    let different: Bool = !same_type
    let mismatch: Bool = both_known && different
    let mismatch_report: I64 = if mismatch:
      append_token_issue("E0344", body, issues)
    else:
      0
    let first_total: I64 = duplicate_report + unknown_report
    let reported: I64 = first_total + mismatch_report
    let total: I64 = count + reported
    let next_seen_true: Bool = seen_true || true_pattern
    let next_seen_false: Bool = seen_false || false_pattern
    recur(source, tokens, params, body_start, expected, next, next_seen_true, next_seen_false, issues, total)

fn append_boolean_match_span(source: Bytes, inout tokens: Vec[syntax.Token], params: I64, body_start: I64, expected: I64, cursor: I64, end: I64, inout issues: Vec[typing.Issue], count: I64) -> I64 effects[alloc, partial]:
  let done: Bool = cursor >= end
  if done:
    count
  else:
    let kind: I64 = syntax.ast_node_kind(tokens, cursor)
    let form: Bool = kind == 0
    let head: I64 = syntax.ast_list_first(cursor)
    let match_form: Bool = if form:
      syntax.ast_expression_is_match(source, tokens, cursor)
    else:
      false
    let incomplete: Bool = if match_form:
      boolean_match_incomplete(source, tokens, cursor)
    else:
      false
    let reported: I64 = if incomplete:
      let value: I64 = syntax.ast_match_value(cursor)
      let arms: I64 = syntax.ast_match_arms(tokens, cursor)
      append_boolean_match_arms(source, tokens, params, body_start, expected, arms, false, false, issues, 0)
    else:
      0
    let next: I64 = syntax.ast_node_after(cursor)
    let total: I64 = count + reported
    recur(source, tokens, params, body_start, expected, next, end, issues, total)

fn append_boolean_match_items(source: Bytes, inout tokens: Vec[syntax.Token], inout declarations: Vec[ir.Declaration], inout issues: Vec[typing.Issue], index: I64, count: I64) -> I64 effects[alloc, partial]:
  let declaration_count: I64 = vec.len(declarations)
  let done: Bool = index >= declaration_count
  if done:
    count
  else:
    let declaration: ir.Declaration = vec.get(declarations, index)
    let cursor: I64 = declaration.form
    let function_item: Bool = syntax.ast_item_is_function(source, tokens, cursor)
    let reported: I64 = if function_item:
      let params: I64 = syntax.ast_function_parameters(cursor)
      let return_type: I64 = syntax.ast_function_return_type(tokens, cursor)
      let expected: I64 = syntax.scalar_type_kind(source, tokens, return_type)
      let effects: I64 = syntax.ast_function_effects(tokens, cursor)
      let body: I64 = syntax.ast_function_body(tokens, cursor)
      let body_end: I64 = syntax.ast_next(tokens, body)
      append_boolean_match_span(source, tokens, params, body, expected, body, body_end, issues, 0)
    else:
      0
    let next: I64 = index + 1
    let total: I64 = count + reported
    recur(source, tokens, declarations, issues, next, total)

fn check_source_mode(input: Bytes, inout tokens: Vec[syntax.Token], render_typed: Bool) -> typing.Checked effects[alloc, io, partial]:
  let valid: Bool = validate.executable_shape_valid(input, tokens)
  if valid:
    let declarations: Vec[ir.Declaration] = syntax.index_declarations(input, tokens)
    let syntax_issues: Vec[typing.Issue] = vec.new()
    let syntax_status: I64 = check_path_exhaustive(input, tokens, declarations, syntax_issues)
    let syntax_error: Bool = syntax_status > 0
    if syntax_error:
      let recovered: I64 = append_boolean_match_items(input, tokens, declarations, syntax_issues, 0, 0)
      let rendered: I64 = if render_typed:
        report_issues(tokens, syntax_issues, 0, 0)
      else:
        0
      let view: typing.View = typing.empty_view()
      let plan: memory.Plan = memory.empty_plan()
      typing.Checked(status: syntax_status, view: view, issues: syntax_issues, plan: plan)
    else:
      let view: typing.View = typing.analyze(input, tokens, declarations)
      let plan: memory.Plan = memory.analyze(input, tokens, declarations)
      let issues: Vec[typing.Issue] = view.issues
      let issue_count: I64 = vec.len(issues)
      let typed_error: Bool = issue_count > 0
      let checked: I64 = if typed_error:
        if render_typed:
          report_issues(tokens, issues, 0, 0)
        else:
          1
      else:
        check_path_fork(input, tokens, declarations, issues)
      let prior_error: Bool = checked > 0
      let status: I64 = if prior_error:
        let recovered: I64 = if typed_error:
          0
        else:
          let rendered: I64 = if render_typed:
            report_issues(tokens, issues, 0, 0)
          else:
            0
          let additional: I64 = append_boolean_match_items(input, tokens, declarations, issues, 0, 0)
          rendered + additional
        checked
      else:
        0
      typing.Checked(status: status, view: view, issues: issues, plan: plan)
  else:
    let declarations: Vec[ir.Declaration] = vec.new()
    let status: I64 = check_path(input, tokens, declarations)
    let view: typing.View = typing.empty_view()
    let issues: Vec[typing.Issue] = vec.new()
    let plan: memory.Plan = memory.empty_plan()
    typing.Checked(status: status, view: view, issues: issues, plan: plan)

fn check_source(input: Bytes, inout tokens: Vec[syntax.Token]) -> typing.Checked effects[alloc, io, partial]:
  check_source_mode(input, tokens, true)

fn check_source_deferred(input: Bytes, inout tokens: Vec[syntax.Token]) -> typing.Checked effects[alloc, io, partial]:
  check_source_mode(input, tokens, false)

fn check_source_all(input: Bytes, inout tokens: Vec[syntax.Token]) -> I64 effects[alloc, io, partial]:
  let checked: typing.Checked = check_source(input, tokens)
  checked.status

fn check_path_all(path: Bytes) -> I64 effects[alloc, io, partial]:
  let input_bytes: Vec[U8] = vec.new()
  let input_read: Bool = io.read_file(path, input_bytes)
  if input_read:
    let input: Bytes = bytes.freeze(input_bytes)
    let tokens: Vec[syntax.Token] = vec.new()
    let parsed: syntax.ProgramParse = syntax.parse_program_result(input, tokens)
    if parsed.valid:
      check_source_all(input, tokens)
    else:
      report_diagnostic(parsed.code, parsed.start, parsed.end)
  else:
    io.println("E0409@0:0")
    1

fn recur_parameter_name(source: Bytes, inout tokens: Vec[syntax.Token], parameter: I64) -> I64 effects[partial]:
  syntax.ast_binding_name(source, tokens, parameter)

fn builtin_group_math(source: Bytes, inout tokens: Vec[syntax.Token], callee: I64) -> Bool effects[partial]:
  let a: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.add")
  let b: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.sub")
  let c: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.mul")
  let d: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.div")
  let e: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.rem")
  let first: Bool = a || b
  let second: Bool = c || d
  let left: Bool = first || second
  left || e

fn builtin_group_compare(source: Bytes, inout tokens: Vec[syntax.Token], callee: I64) -> Bool effects[partial]:
  let a: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.eq")
  let b: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.lt")
  let c: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.le")
  let d: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.gt")
  let e: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.ge")
  let first: Bool = a || b
  let second: Bool = c || d
  let left: Bool = first || second
  left || e

fn builtin_group_scalar(source: Bytes, inout tokens: Vec[syntax.Token], callee: I64) -> Bool effects[partial]:
  let a: Bool = syntax.ast_node_text_is(source, tokens, callee, "bool.not")
  let b: Bool = syntax.ast_node_text_is(source, tokens, callee, "bool.and")
  let c: Bool = syntax.ast_node_text_is(source, tokens, callee, "bool.or")
  let d: Bool = syntax.ast_node_text_is(source, tokens, callee, "u8.to_i64")
  let e: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.to_u8")
  let first: Bool = a || b
  let second: Bool = c || d
  let left: Bool = first || second
  left || e

fn builtin_group_bytes_io(source: Bytes, inout tokens: Vec[syntax.Token], callee: I64) -> Bool effects[partial]:
  let a: Bool = syntax.ast_node_text_is(source, tokens, callee, "bytes.len")
  let b: Bool = syntax.ast_node_text_is(source, tokens, callee, "bytes.get")
  let c: Bool = syntax.ast_node_text_is(source, tokens, callee, "bytes.freeze")
  let d: Bool = syntax.ast_node_text_is(source, tokens, callee, "io.print_i64")
  let e: Bool = syntax.ast_node_text_is(source, tokens, callee, "io.print_bytes")
  let f: Bool = syntax.ast_node_text_is(source, tokens, callee, "io.println")
  let g: Bool = syntax.ast_node_text_is(source, tokens, callee, "io.read_file")
  let first: Bool = a || b
  let second: Bool = c || d
  let third: Bool = e || f
  let left: Bool = first || second
  let right: Bool = third || g
  left || right

fn builtin_group_storage(source: Bytes, inout tokens: Vec[syntax.Token], callee: I64) -> Bool effects[partial]:
  let a: Bool = syntax.ast_node_text_is(source, tokens, callee, "vec.new")
  let b: Bool = syntax.ast_node_text_is(source, tokens, callee, "vec.len")
  let c: Bool = syntax.ast_node_text_is(source, tokens, callee, "vec.get")
  let d: Bool = syntax.ast_node_text_is(source, tokens, callee, "vec.push")
