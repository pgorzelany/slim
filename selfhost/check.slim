fn builtin_is_known(source: Bytes inout tokens: Vec[syntax/Token] callee: I64) -> Bool effects[partial]:
  let math: Bool = builtin_group_math(source tokens callee)
  let compare: Bool = builtin_group_compare(source tokens callee)
  let scalar: Bool = builtin_group_scalar(source tokens callee)
  let bytes_io: Bool = builtin_group_bytes_io(source tokens callee)
  let storage: Bool = builtin_group_storage(source tokens callee)
  let first: Bool = bool.or(math compare)
  let second: Bool = bool.or(scalar bytes_io)
  let left: Bool = bool.or(first second)
  bool.or(left storage)

fn linked_function_params(inout tokens: Vec[syntax/Token] callee: I64) -> I64 effects[partial]:
  let item: I64 = syntax/ast_node_link(tokens callee)
  let found: Bool = i64.ge(item 0)
  match found:
    true:
      syntax/ast_function_parameters(item)
    false:
      -1

fn parameter_is_inout(source: Bytes inout tokens: Vec[syntax/Token] parameter: I64) -> Bool effects[partial]:
  syntax/ast_binding_is_inout(source tokens parameter)

fn find_inout_temporary_args(source: Bytes inout tokens: Vec[syntax/Token] argument: I64 parameter: I64) -> I64 effects[partial]:
  let kind: I64 = syntax/ast_node_kind(tokens parameter)
  let done: Bool = i64.eq(kind 1)
  match done:
    true:
      -1
    false:
      let borrowed: Bool = parameter_is_inout(source tokens parameter)
      let argument_kind: I64 = syntax/ast_node_kind(tokens argument)
      let named: Bool = i64.eq(argument_kind 2)
      let not_named: Bool = bool.not(named)
      let invalid: Bool = bool.and(borrowed not_named)
      match invalid:
        true:
          argument
        false:
          let next_argument: I64 = syntax/ast_next(tokens argument)
          let next_parameter: I64 = syntax/ast_next(tokens parameter)
          recur(source tokens next_argument next_parameter)

fn find_inout_temporary_call(source: Bytes inout tokens: Vec[syntax/Token] module_items: I64 cursor: I64) -> I64 effects[partial]:
  let callee: I64 = syntax/ast_call_callee(cursor)
  let builtin: Bool = builtin_is_known(source tokens callee)
  match builtin:
    true:
      -1
    false:
      let params: I64 = linked_function_params(tokens callee)
      let found: Bool = i64.ge(params 0)
      match found:
        false:
          -1
        true:
          let argument: I64 = syntax/ast_call_arguments(cursor)
          let parameter: I64 = syntax/ast_parameters_first(params)
          find_inout_temporary_args(source tokens argument parameter)

fn find_inout_temporary_span(source: Bytes inout tokens: Vec[syntax/Token] module_items: I64 cursor: I64 end: I64) -> I64 effects[partial]:
  let done: Bool = i64.ge(cursor end)
  match done:
