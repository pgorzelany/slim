      let effects: I64 = syntax.ast_function_effects(tokens, cursor)
      let body: I64 = syntax.ast_function_body(tokens, cursor)
      let body_end: I64 = syntax.ast_next(tokens, body)
      find_inout_temporary_span(source, tokens, module_items, body, body_end)
    else:
      -1
    let found: Bool = invalid >= 0
    if found:
      invalid
    else:
      let next: I64 = index + 1
      recur(source, tokens, module_items, declarations, next)

fn prior_inout_alias(source: Bytes, inout tokens: Vec[syntax.Token], argument: I64, parameter: I64, current_argument: I64, name_start: I64, name_end: I64) -> Bool effects[partial]:
  let reached: Bool = argument == current_argument
  if reached:
    false
  else:
    let borrowed: Bool = parameter_is_inout(source, tokens, parameter)
    let kind: I64 = syntax.ast_node_kind(tokens, argument)
    let named: Bool = kind == 2
    let comparable: Bool = borrowed && named
    let candidate_start: I64 = syntax.ast_node_start(tokens, argument)
    let candidate_end: I64 = syntax.ast_node_end(tokens, argument)
    let same: Bool = if comparable:
      syntax.spans_equal(source, candidate_start, candidate_end, name_start, name_end)
    else:
      false
    if same:
      true
    else:
      let next_argument: I64 = syntax.ast_next(tokens, argument)
      let next_parameter: I64 = syntax.ast_next(tokens, parameter)
      recur(source, tokens, next_argument, next_parameter, current_argument, name_start, name_end)

fn find_inout_alias_args(source: Bytes, inout tokens: Vec[syntax.Token], first_argument: I64, first_parameter: I64, argument: I64, parameter: I64) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, parameter)
  let done: Bool = kind == 1
  if done:
    -1
  else:
    let borrowed: Bool = parameter_is_inout(source, tokens, parameter)
    let argument_kind: I64 = syntax.ast_node_kind(tokens, argument)
    let named: Bool = argument_kind == 2
    let comparable: Bool = borrowed && named
    let name_start: I64 = syntax.ast_node_start(tokens, argument)
    let name_end: I64 = syntax.ast_node_end(tokens, argument)
    let duplicate: Bool = if comparable:
      prior_inout_alias(source, tokens, first_argument, first_parameter, argument, name_start, name_end)
    else:
      false
    if duplicate:
      argument
    else:
      let next_argument: I64 = syntax.ast_next(tokens, argument)
      let next_parameter: I64 = syntax.ast_next(tokens, parameter)
      recur(source, tokens, first_argument, first_parameter, next_argument, next_parameter)

fn find_inout_alias_call(source: Bytes, inout tokens: Vec[syntax.Token], module_items: I64, cursor: I64) -> I64 effects[partial]:
  let callee: I64 = syntax.ast_call_callee(cursor)
  let builtin: Bool = builtin_is_known(source, tokens, callee)
  if builtin:
    -1
  else:
    let params: I64 = linked_function_params(tokens, callee)
    let found: Bool = params >= 0
    if found:
      let argument: I64 = syntax.ast_call_arguments(cursor)
      let parameter: I64 = syntax.ast_parameters_first(params)
      find_inout_alias_args(source, tokens, argument, parameter, argument, parameter)
    else:
      -1

fn find_inout_alias_span(source: Bytes, inout tokens: Vec[syntax.Token], module_items: I64, cursor: I64, end: I64) -> I64 effects[partial]:
  let done: Bool = cursor >= end
