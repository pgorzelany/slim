    false:
      let params: I64 = linked_function_params(tokens callee)
      let found: Bool = i64.ge(params 0)
      match found:
        false:
          -1
        true:
          let argument: I64 = syntax/ast_call_arguments(cursor)
          let parameter: I64 = syntax/ast_parameters_first(params)
          find_inout_alias_args(source tokens argument parameter argument parameter)

