      64
  let open: Unit = text/append_text(output " (counted-loops (fact-limit 64) (facts")
  let emitted: Unit = emit-counted-facts(source tokens counted 0 limit output)
  let count_prefix: Unit = text/append_text(output ") (counted-loop-count ")
  let count_text: Unit = append-i64(count output)
  let reported_prefix: Unit = text/append_text(output ") (reported-facts ")
  let reported: Unit = append-i64(limit output)
  let truncated_prefix: Unit = text/append_text(output ") (facts-truncated ")
  let truncated: Unit = match within_limit:
    true:
      text/append_text(output "false")
    false:
      text/append_text(output "true")
  let guarantee_prefix: Unit = text/append_text(output ") (guarantee ")
  let guarantee: Unit = match within_limit:
    true:
      text/append_text(output "exact")
    false:
      text/append_text(output "bounded")
  text/append_text(output "))")

fn emit-module-facts(source: Bytes inout tokens: Vec[syntax/Token] inout view: View inout output: Vec[U8]) -> Unit effects[alloc partial]:
  let facts: Vec[Fact] = get(view facts)
  let open: Unit = text/append_text(output " (integer-proofs (domain -1000000000 1000000000) (refinement-limit 64) (parameter-pass-limit 4) (refinements ")
  let refinements: Unit = append-i64(get(view refinements) output)
  let truncation-prefix: Unit = text/append_text(output ") (refinements-truncated ")
  let truncation: Unit = match get(view refinements-truncated):
    true:
      text/append_text(output "true")
    false:
      text/append_text(output "false")
  let sites-open: Unit = text/append_text(output ") (checked-site-report-limit 64) (checked-sites")
  let site-count: I64 = emit-sites(source tokens facts 0 output 0 0)
  let sites-close: Unit = text/append_text(output ") (checked-site-count ")
  let count: Unit = append-i64(site-count output)
  let guarantee: Unit = match i64.le(site-count 64):
    true:
      text/append_text(output ") (guarantee exact))")
    false:
      text/append_text(output ") (guarantee bounded))")
  let counted_evidence: Unit = emit-counted-evidence(source tokens view output)
  emit-resource-evidence(source tokens view output)

fn retained-profile-count(inout recurrences: Vec[Recurrence]) -> I64 effects[partial]:
  let count: I64 = vec.len(recurrences)
  let bounded: Bool = i64.le(count 16)
  match bounded:
    true:
      count
    false:
      16

fn find-retained-profile(inout recurrences: Vec[Recurrence] item: I64 index: I64 limit: I64) -> I64 effects[partial]:
  let done: Bool = i64.ge(index limit)
  match done:
    true:
      -1
    false:
      let profile: Recurrence = vec.get(recurrences index)
      let same: Bool = i64.eq(get(profile item) item)
      match same:
        true:
          index
        false:
          let next: I64 = i64.add(index 1)
          recur(recurrences item next limit)

fn emit-resource-profile(source: Bytes inout tokens: Vec[syntax/Token] profile: Recurrence inout output: Vec[U8]) -> Unit effects[alloc partial]:
  let open: Unit = text/append_text(output " (recurrence-profile ")
  let item: Unit = append-i64(get(profile item) output)
  let name-space: Unit = text/append_text(output " ")
  let name-index: I64 = i64.add(get(profile item) 2)
  let name: Unit = text/append_token(source tokens name-index output)
  let guarantee: Unit = text/append_text(output " (guarantee exact) (controller-position ")
  let position: Unit = append-i64(get(profile position) output)
  let bound-prefix: Unit = text/append_text(output ") (stop-bound ")
  let bound: Unit = append-i64(get(profile bound) output)
  let step-prefix: Unit = text/append_text(output ") (step ")
  let step: Unit = append-i64(get(profile step) output)
  text/append_text(output "))")

fn emit-resource-profiles(source: Bytes inout tokens: Vec[syntax/Token] inout recurrences: Vec[Recurrence] index: I64 limit: I64 inout output: Vec[U8]) -> Unit effects[alloc partial]:
  let done: Bool = i64.ge(index limit)
  match done:
    true:
      unit
    false:
      let profile: Recurrence = vec.get(recurrences index)
      let emitted: Unit = emit-resource-profile(source tokens profile output)
      let next: I64 = i64.add(index 1)
      recur(source tokens recurrences next limit output)

fn emit-resource-call-work(source: Bytes inout tokens: Vec[syntax/Token] expr: I64 item: I64 work: Work inout output: Vec[U8]) -> Unit effects[alloc partial]:
  let open: Unit = text/append_text(output " (call-work ")
  let site: Unit = append-i64(expr output)
  let item-space: Unit = text/append_text(output " ")
  let item-text: Unit = append-i64(item output)
  let name-space: Unit = text/append_text(output " ")
  let name-index: I64 = syntax/ast_item_name(item)
  let name: Unit = text/append_token(source tokens name-index output)
  match get(work known):
    true:
      let guarantee: Unit = text/append_text(output " (guarantee exact) (iterations ")
      let iterations: Unit = append-i64(get(work iterations) output)
      text/append_text(output "))")
    false:
      text/append_text(output " (guarantee unknown) (reason nonliteral-controller))")

fn advance-resource-scan(scan: ResourceScan work: Work reported: Bool) -> ResourceScan:
  let next-profiled: I64 = i64.add(get(scan profiled) 1)
  let next-reported: I64 = match reported:
    true:
      i64.add(get(scan reported) 1)
    false:
      get(scan reported)
  let known: Bool = get(work known)
  let next-exact: I64 = match known:
    true:
      i64.add(get(scan exact-sites) 1)
    false:
      get(scan exact-sites)
  let next-unknown: I64 = match known:
    true:
      get(scan unknown-sites)
    false:
      i64.add(get(scan unknown-sites) 1)
  let iterations: I64 = get(work iterations)
  let larger: Bool = match known:
    true:
      i64.gt(iterations get(scan maximum))
    false:
      false
  let next-maximum: I64 = match larger:
    true:
      iterations
    false:
      get(scan maximum)
  make ResourceScan(profiled = next-profiled reported = next-reported exact-sites = next-exact unknown-sites = next-unknown maximum = next-maximum)

fn scan-resource-call(source: Bytes inout tokens: Vec[syntax/Token] inout view: View inout recurrences: Vec[Recurrence] profile-limit: I64 expr: I64 scan: ResourceScan inout output: Vec[U8]) -> ResourceScan effects[alloc partial]:
  let callee: I64 = syntax/ast_call_callee(expr)
  let builtin: Bool = typing/builtin_known(source tokens callee)
  match builtin:
    true:
      scan
    false:
      let item: I64 = syntax/ast_node_link(tokens callee)
      let linked: Bool = i64.ge(item 0)
      match linked:
        false:
          scan
        true:
          let profile-index: I64 = find-retained-profile(recurrences item 0 profile-limit)
          let profiled: Bool = i64.ge(profile-index 0)
          match profiled:
            false:
              scan
            true:
              let arguments: I64 = syntax/ast_call_arguments(expr)
              let work: Work = recurrence-work(source tokens view item arguments)
              let room: Bool = i64.lt(get(scan reported) 64)
              let emitted: Unit = match room:
                true:
                  emit-resource-call-work(source tokens expr item work output)
                false:
                  unit
              advance-resource-scan(scan work room)

fn scan-resource-calls(source: Bytes inout tokens: Vec[syntax/Token] inout view: View inout recurrences: Vec[Recurrence] profile-limit: I64 index: I64 scan: ResourceScan inout output: Vec[U8]) -> ResourceScan effects[alloc partial]:
  let length: I64 = vec.len(tokens)
  let done: Bool = i64.ge(index length)
  match done:
    true:
      scan
    false:
      let kind: I64 = syntax/ast_node_kind(tokens index)
      let form: Bool = i64.eq(kind 0)
      let head: I64 = syntax/ast_list_first(index)
      let call-form: Bool = match form:
        true:
          syntax/ast_expression_is_call(source tokens index)
        false:
          false
      let next-scan: ResourceScan = match call-form:
        true:
          scan-resource-call(source tokens view recurrences profile-limit index scan output)
        false:
          scan
      let next: I64 = syntax/ast_node_after(index)
      recur(source tokens view recurrences profile-limit next next-scan output)

fn emit-resource-bool(value: Bool inout output: Vec[U8]) -> Unit effects[alloc partial]:
  match value:
    true:
      text/append_text(output "true")
    false:
      text/append_text(output "false")

fn emit-resource-evidence(source: Bytes inout tokens: Vec[syntax/Token] inout view: View inout output: Vec[U8]) -> Unit effects[alloc partial]:
  let recurrences: Vec[Recurrence] = get(view recurrences)
  let profile-count: I64 = vec.len(recurrences)
  let retained: I64 = retained-profile-count(recurrences)
  let profiles-truncated: Bool = i64.gt(profile-count retained)
  let open: Unit = text/append_text(output " (resource-evidence (profile-limit 16) (call-site-report-limit 64) (recurrence-profiles")
  let profiles: Unit = emit-resource-profiles(source tokens recurrences 0 retained output)
  let profile-count-prefix: Unit = text/append_text(output ") (recurrence-profile-count ")
  let profile-count-text: Unit = append-i64(profile-count output)
  let retained-prefix: Unit = text/append_text(output ") (reported-recurrence-profiles ")
  let retained-text: Unit = append-i64(retained output)
  let truncated-prefix: Unit = text/append_text(output ") (recurrence-profiles-truncated ")
  let truncated-text: Unit = emit-resource-bool(profiles-truncated output)
  let range-truncated-prefix: Unit = text/append_text(output ") (range-refinements-truncated ")
  let range-truncated-text: Unit = emit-resource-bool(get(view refinements-truncated) output)
  let calls-open: Unit = text/append_text(output ") (call-work-sites")
  let initial: ResourceScan = make ResourceScan(profiled = 0 reported = 0 exact-sites = 0 unknown-sites = 0 maximum = 0)
  let scan: ResourceScan = scan-resource-calls(source tokens view recurrences retained 0 initial output)
  let profiled-prefix: Unit = text/append_text(output ") (profiled-call-site-count ")
  let profiled-text: Unit = append-i64(get(scan profiled) output)
  let reported-prefix: Unit = text/append_text(output ") (reported-call-site-count ")
  let reported-text: Unit = append-i64(get(scan reported) output)
  let exact-prefix: Unit = text/append_text(output ") (exact-call-work-sites ")
  let exact-text: Unit = append-i64(get(scan exact-sites) output)
  let unknown-prefix: Unit = text/append_text(output ") (unknown-call-work-sites ")
  let unknown-text: Unit = append-i64(get(scan unknown-sites) output)
  let maximum-prefix: Unit = text/append_text(output ") (maximum-exact-iterations ")
  let maximum-text: Unit = append-i64(get(scan maximum) output)
  let calls-truncated: Bool = i64.gt(get(scan profiled) get(scan reported))
  let bounded: Bool = bool.or(get(view refinements-truncated) bool.or(profiles-truncated calls-truncated))
  let guarantee-prefix: Unit = text/append_text(output ") (guarantee ")
  let guarantee: Unit = match bounded:
    true:
      text/append_text(output "bounded")
    false:
      text/append_text(output "exact")
  text/append_text(output "))")
