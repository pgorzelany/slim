fn advance_resource_scan(scan: ResourceScan, work: Work, reported: Bool) -> ResourceScan:
  let next_profiled: I64 = scan.profiled + 1
  let next_reported: I64 = if reported:
    scan.reported + 1
  else:
    scan.reported
  let known: Bool = work.known
  let next_exact: I64 = if known:
    scan.exact_sites + 1
  else:
    scan.exact_sites
  let next_unknown: I64 = if known:
    scan.unknown_sites
  else:
    scan.unknown_sites + 1
  let iterations: I64 = work.iterations
  let larger: Bool = if known:
    iterations > scan.maximum
  else:
    false
  let next_maximum: I64 = if larger:
    iterations
  else:
    scan.maximum
  ResourceScan(profiled: next_profiled, reported: next_reported, exact_sites: next_exact, unknown_sites: next_unknown, maximum: next_maximum)

fn scan_resource_call(source: Bytes, inout tokens: Vec[syntax.Token], inout view: View, inout recurrences: Vec[Recurrence], profile_limit: I64, expr: I64, scan: ResourceScan, inout output: Vec[U8]) -> ResourceScan effects[alloc, partial]:
  let callee: I64 = syntax.ast_call_callee(expr)
  let builtin: Bool = typing.builtin_known(source, tokens, callee)
  if builtin:
    scan
  else:
    let item: I64 = syntax.ast_node_link(tokens, callee)
    let linked: Bool = item >= 0
    if linked:
      let profile_index: I64 = find_retained_profile(recurrences, item, 0, profile_limit)
      let profiled: Bool = profile_index >= 0
      if profiled:
        let arguments: I64 = syntax.ast_call_arguments(expr)
        let work: Work = recurrence_work(source, tokens, view, item, arguments)
        let room: Bool = scan.reported < 64
        if room:
          emit_resource_call_work(source, tokens, expr, item, work, output)
        else:
          void
        advance_resource_scan(scan, work, room)
      else:
        scan
    else:
      scan

fn scan_resource_calls(source: Bytes, inout tokens: Vec[syntax.Token], inout view: View, inout recurrences: Vec[Recurrence], profile_limit: I64, index: I64, scan: ResourceScan, inout output: Vec[U8]) -> ResourceScan effects[alloc, partial]:
  let length: I64 = vec.len(tokens)
  let done: Bool = index >= length
  if done:
    scan
  else:
    let kind: I64 = syntax.ast_node_kind(tokens, index)
    let form: Bool = kind == 0
    let head: I64 = syntax.ast_list_first(index)
    let call_form: Bool = if form:
      syntax.ast_expression_is_call(source, tokens, index)
    else:
      false
    let next_scan: ResourceScan = if call_form:
      scan_resource_call(source, tokens, view, recurrences, profile_limit, index, scan, output)
    else:
      scan
    let next: I64 = syntax.ast_node_after(index)
    recur(source, tokens, view, recurrences, profile_limit, next, next_scan, output)

fn emit_resource_bool(value: Bool, inout output: Vec[U8]) -> Void effects[alloc, partial]:
  if value:
    text.append_text(output, "true")
  else:
    text.append_text(output, "false")

fn emit_resource_evidence(source: Bytes, inout tokens: Vec[syntax.Token], inout view: View, inout output: Vec[U8]) -> Void effects[alloc, partial]:
  let recurrences: Vec[Recurrence] = view.recurrences
  let profile_count: I64 = vec.len(recurrences)
  let retained: I64 = retained_profile_count(recurrences)
  let profiles_truncated: Bool = profile_count > retained
  text.append_text(output, " (resource-evidence (profile-limit 16) (call-site-report-limit 64) (recurrence-profiles")
  emit_resource_profiles(source, tokens, recurrences, 0, retained, output)
  text.append_text(output, ") (recurrence-profile-count ")
  append_i64(profile_count, output)
  text.append_text(output, ") (reported-recurrence-profiles ")
  append_i64(retained, output)
  text.append_text(output, ") (recurrence-profiles-truncated ")
  emit_resource_bool(profiles_truncated, output)
  text.append_text(output, ") (range-refinements-truncated ")
  emit_resource_bool(view.refinements_truncated, output)
  text.append_text(output, ") (call-work-sites")
  let initial: ResourceScan = ResourceScan(profiled: 0, reported: 0, exact_sites: 0, unknown_sites: 0, maximum: 0)
  let scan: ResourceScan = scan_resource_calls(source, tokens, view, recurrences, retained, 0, initial, output)
  text.append_text(output, ") (profiled-call-site-count ")
  append_i64(scan.profiled, output)
  text.append_text(output, ") (reported-call-site-count ")
  append_i64(scan.reported, output)
  text.append_text(output, ") (exact-call-work-sites ")
  append_i64(scan.exact_sites, output)
  text.append_text(output, ") (unknown-call-work-sites ")
  append_i64(scan.unknown_sites, output)
  text.append_text(output, ") (maximum-exact-iterations ")
  append_i64(scan.maximum, output)
  let calls_truncated: Bool = scan.profiled > scan.reported
  let bounded: Bool = view.refinements_truncated || (profiles_truncated || calls_truncated)
  text.append_text(output, ") (guarantee ")
  if bounded:
    text.append_text(output, "bounded")
  else:
    text.append_text(output, "exact")
  text.append_text(output, "))")
