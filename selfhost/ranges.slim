module ranges

record Fact:
  analyzed: Bool
  lower-known: Bool
  lower: I64
  upper-known: Bool
  upper: I64
  total: Bool

record Parsed:
  valid: Bool
  value: I64

record Refinement:
  declaration: I64
  fact: Fact
  parent: I64

record Summary:
  total: Bool

record ArmSummary:
  present: Bool
  fact: Fact

record Constraint:
  valid: Bool
  declaration: I64
  true-kind: I64
  true-bound: I64
  false-kind: I64
  false-bound: I64

record Descent:
  valid: Bool
  position: I64
  step: I64

record Recurrence:
  item: I64
  position: I64
  bound: I64
  step: I64

record CountScan:
  valid: Bool
  count: I64

record AccScan:
  valid: Bool
  changed: Bool
  maximum: I64

record Counted:
  item: I64
  controller: I64
  start: I64
  bound: I64
  step: I64
  iterations: I64
  base: I64
  body: I64

record Work:
  known: Bool
  iterations: I64

record View:
  facts: Vec[Fact]
  refinements: I64
  refinements-truncated: Bool
  recurrences: Vec[Recurrence]
  counted: Vec[Counted]

record ResourceScan:
  profiled: I64
  reported: I64
  exact-sites: I64
  unknown-sites: I64
  maximum: I64

fn unknown(analyzed: Bool total: Bool) -> Fact:
  make Fact(analyzed = analyzed lower-known = false lower = 0 upper-known = false upper = 0 total = total)

fn bounded(lower-known: Bool lower: I64 upper-known: Bool upper: I64 total: Bool) -> Fact:
  make Fact(analyzed = true lower-known = lower-known lower = lower upper-known = upper-known upper = upper total = total)

fn exact(value: I64) -> Fact:
  bounded(true value true value true)

fn initialize-facts(length: I64 index: I64 inout facts: Vec[Fact]) -> Unit effects[alloc partial]:
  let done: Bool = i64.ge(index length)
  match done:
    true:
      unit
    false:
      let fact: Fact = unknown(false false)
      let pushed: Unit = vec.push(facts fact)
      let next: I64 = i64.add(index 1)
      recur(length next facts)

fn fact-at(inout facts: Vec[Fact] index: I64) -> Fact effects[partial]:
  let nonnegative: Bool = i64.ge(index 0)
  let length: I64 = vec.len(facts)
  let below: Bool = i64.lt(index length)
  let valid: Bool = bool.and(nonnegative below)
  match valid:
    true:
      vec.get(facts index)
    false:
      unknown(false false)

fn set-fact(index: I64 fact: Fact inout facts: Vec[Fact]) -> Fact effects[partial]:
  let stored: Unit = vec.set(facts index fact)
  fact

fn fact-total(inout facts: Vec[Fact] expr: I64) -> Bool effects[partial]:
  let fact: Fact = fact-at(facts expr)
  bool.and(get(fact analyzed) get(fact total))

fn fact-exact(fact: Fact) -> Bool:
  let both: Bool = bool.and(get(fact lower-known) get(fact upper-known))
  let same: Bool = i64.eq(get(fact lower) get(fact upper))
  bool.and(both same)

fn minimum(left: I64 right: I64) -> I64:
  match i64.le(left right):
    true:
      left
    false:
      right

fn maximum(left: I64 right: I64) -> I64:
  match i64.ge(left right):
    true:
      left
    false:
      right

fn parse-digits(source: Bytes index: I64 end: I64 value: I64) -> Parsed effects[partial]:
  let done: Bool = i64.ge(index end)
  match done:
    true:
      make Parsed(valid = true value = value)
    false:
      let byte: U8 = bytes.get(source index)
      let code: I64 = u8.to-i64(byte)
      let lower: Bool = i64.ge(code 48)
      let upper: Bool = i64.le(code 57)
      let digit: Bool = bool.and(lower upper)
      match digit:
        false:
          make Parsed(valid = false value = 0)
        true:
          let numeric: I64 = i64.sub(code 48)
          let prefix-too-large: Bool = i64.gt(value 100000000)
          let prefix-at-limit: Bool = i64.eq(value 100000000)
          let nonzero-digit: Bool = i64.gt(numeric 0)
          let limit-tail: Bool = bool.and(prefix-at-limit nonzero-digit)
          let too-large: Bool = bool.or(prefix-too-large limit-tail)
          match too-large:
            true:
              make Parsed(valid = false value = 0)
            false:
              let shifted: I64 = i64.mul(value 10)
              let next-value: I64 = i64.add(shifted numeric)
              let next: I64 = i64.add(index 1)
              recur(source next end next-value)

fn parse-literal(source: Bytes inout tokens: Vec[syntax/Token] token: I64) -> Parsed effects[partial]:
  let start: I64 = syntax/ast_node_start(tokens token)
  let end: I64 = syntax/ast_node_end(tokens token)
  let first: U8 = bytes.get(source start)
  let code: I64 = u8.to-i64(first)
  let negative: Bool = i64.eq(code 45)
  let digit-start: I64 = match negative:
    true:
      i64.add(start 1)
    false:
      start
  let present: Bool = i64.lt(digit-start end)
  match present:
    false:
      make Parsed(valid = false value = 0)
    true:
      let parsed: Parsed = parse-digits(source digit-start end 0)
      let valid: Bool = get(parsed valid)
      match valid:
        false:
          parsed
        true:
          let magnitude: I64 = get(parsed value)
          let value: I64 = match negative:
            true:
              i64.sub(0 magnitude)
            false:
              magnitude
          make Parsed(valid = true value = value)

fn lookup-refinement(inout refinements: Vec[Refinement] parent: I64 declaration: I64) -> Fact effects[partial]:
  let done: Bool = i64.lt(parent 0)
  match done:
    true:
      unknown(false false)
    false:
      let refinement: Refinement = vec.get(refinements parent)
      let same: Bool = i64.eq(get(refinement declaration) declaration)
      match same:
        true:
          get(refinement fact)
        false:
          recur(refinements get(refinement parent) declaration)

fn lookup-binding(inout tokens: Vec[syntax/Token] inout facts: Vec[Fact] inout refinements: Vec[Refinement] parent: I64 atom: I64) -> Fact effects[partial]:
  let declaration: I64 = typing/linked_binding_declaration(tokens atom)
  let refined: Fact = lookup-refinement(refinements parent declaration)
  let present: Bool = get(refined analyzed)
  match present:
    true:
      refined
    false:
      fact-at(facts declaration)

fn parameter-name(source: Bytes inout tokens: Vec[syntax/Token] parameter: I64) -> I64 effects[partial]:
  syntax/ast_binding_name(source tokens parameter)

fn initialize-booleans(length: I64 index: I64 value: Bool inout values: Vec[Bool]) -> Unit effects[alloc partial]:
  match i64.ge(index length):
    true:
      unit
    false:
      let pushed: Unit = vec.push(values value)
      recur(length i64.add(index 1) value values)

fn mark-parameter-invariants(source: Bytes inout tokens: Vec[syntax/Token] cursor: I64 inout invariants: Vec[Bool]) -> Unit effects[partial]:
  match i64.eq(syntax/ast_node_kind(tokens cursor) 1):
    true:
      unit
    false:
      let name: I64 = parameter-name(source tokens cursor)
      let marked: Unit = vec.set(invariants name true)
      recur(source tokens syntax/ast_next(tokens cursor) invariants)

fn invalidate-recur-arguments(source: Bytes inout tokens: Vec[syntax/Token] parameter: I64 argument: I64 inout invariants: Vec[Bool]) -> Unit effects[partial]:
  match i64.eq(syntax/ast_node_kind(tokens parameter) 1):
    true:
      unit
    false:
      let name: I64 = parameter-name(source tokens parameter)
      let argument-kind: I64 = syntax/ast_node_kind(tokens argument)
      let atom: Bool = i64.eq(argument-kind 2)
      let linked: I64 = match atom:
        true:
          typing/linked_binding_declaration(tokens argument)
        false:
          -1
      let unchanged: Bool = i64.eq(linked name)
      let invalidated: Unit = match unchanged:
        true:
          unit
        false:
          vec.set(invariants name false)
      recur(source tokens syntax/ast_next(tokens parameter) syntax/ast_next(tokens argument) invariants)

fn scan-recur-invariants(source: Bytes inout tokens: Vec[syntax/Token] cursor: I64 end: I64 params: I64 inout invariants: Vec[Bool]) -> Unit effects[partial]:
  match i64.ge(cursor end):
    true:
      unit
    false:
      let recur-form: Bool = syntax/ast_expression_is_recur(source tokens cursor)
      let invalidated: Unit = match recur-form:
        true:
          invalidate-recur-arguments(source tokens syntax/ast_parameters_first(params) syntax/ast_recur_arguments(cursor) invariants)
        false:
          unit
      recur(source tokens syntax/ast_node_after(cursor) end params invariants)

fn collect-function-invariants(source: Bytes inout tokens: Vec[syntax/Token] item: I64 inout invariants: Vec[Bool]) -> Unit effects[partial]:
  let params: I64 = syntax/ast_function_parameters(item)
  let marked: Unit = mark-parameter-invariants(source tokens syntax/ast_parameters_first(params) invariants)
  let return-type: I64 = syntax/ast_function_return_type(tokens item)
  let effects-form: I64 = syntax/ast_function_effects(tokens item)
  let body: I64 = syntax/ast_next(tokens effects-form)
  scan-recur-invariants(source tokens body syntax/ast_next(tokens body) params invariants)

fn collect-parameter-invariants(source: Bytes inout tokens: Vec[syntax/Token] cursor: I64 inout invariants: Vec[Bool]) -> Unit effects[partial]:
  match i64.eq(syntax/ast_node_kind(tokens cursor) 1):
    true:
      unit
    false:
      let function-item: Bool = syntax/ast_item_is_function(source tokens cursor)
      let collected: Unit = match function-item:
        true:
          collect-function-invariants(source tokens cursor invariants)
        false:
          unit
      recur(source tokens syntax/ast_next(tokens cursor) invariants)

fn merge-parameter-fact(existing: Fact candidate: Fact invariant: Bool) -> Fact:
  match invariant:
    false:
      unknown(true true)
    true:
      let candidate-bounded: Bool = all-bounded(candidate)
      let candidate-total: Bool = get(candidate total)
      let usable: Bool = bool.and(candidate-bounded candidate-total)
      match usable:
        false:
          unknown(true true)
        true:
          match get(existing analyzed):
            false:
              candidate
            true:
              let existing-bounded: Bool = all-bounded(existing)
              match existing-bounded:
                true:
                  join-facts(existing candidate true)
                false:
                  unknown(true true)

fn collect-call-arguments(source: Bytes inout tokens: Vec[syntax/Token] inout facts: Vec[Fact] inout invariants: Vec[Bool] parameter: I64 argument: I64 inout parameter-facts: Vec[Fact]) -> Unit effects[partial]:
  match i64.eq(syntax/ast_node_kind(tokens parameter) 1):
    true:
      unit
    false:
      let name: I64 = parameter-name(source tokens parameter)
      let invariant: Bool = vec.get(invariants name)
      let existing: Fact = fact-at(parameter-facts name)
      let candidate: Fact = fact-at(facts argument)
      let merged: Fact = merge-parameter-fact(existing candidate invariant)
      let stored: Unit = vec.set(parameter-facts name merged)
      let next-parameter: I64 = syntax/ast_next(tokens parameter)
      let last: Bool = i64.eq(syntax/ast_node_kind(tokens next-parameter) 1)
      match last:
        true:
          unit
        false:
          let next-argument: I64 = syntax/ast_next(tokens argument)
          recur(source tokens facts invariants next-parameter next-argument parameter-facts)

fn scan-parameter-calls(source: Bytes inout tokens: Vec[syntax/Token] inout facts: Vec[Fact] inout invariants: Vec[Bool] cursor: I64 length: I64 inout parameter-facts: Vec[Fact]) -> Unit effects[partial]:
  match i64.ge(cursor length):
    true:
      unit
    false:
      let kind: I64 = syntax/ast_node_kind(tokens cursor)
      let form: Bool = i64.eq(kind 0)
      let head: I64 = syntax/ast_list_first(cursor)
      let call-form: Bool = match form:
        true:
          syntax/ast_expression_is_call(source tokens cursor)
        false:
          false
      let callee: I64 = syntax/ast_call_callee(cursor)
      let declaration: I64 = match call-form:
        true:
          syntax/ast_node_link(tokens callee)
        false:
          -1
      let user: Bool = i64.ge(declaration 0)
      let collected: Unit = match user:
        true:
          collect-call-arguments(source tokens facts invariants syntax/ast_parameters_first(syntax/ast_function_parameters(declaration)) syntax/ast_call_arguments(cursor) parameter-facts)
        false:
          unit
      recur(source tokens facts invariants syntax/ast_node_after(cursor) length parameter-facts)

fn initialize-parameters(source: Bytes inout tokens: Vec[syntax/Token] cursor: I64 inout facts: Vec[Fact] inout parameter-facts: Vec[Fact]) -> Unit effects[partial]:
  let kind: I64 = syntax/ast_node_kind(tokens cursor)
  let done: Bool = i64.eq(kind 1)
  match done:
    true:
      unit
    false:
      let head: I64 = syntax/ast_list_first(cursor)
      let borrowed: Bool = syntax/ast_binding_is_inout(source tokens cursor)
      let name: I64 = syntax/ast_binding_name(source tokens cursor)
      let candidate: Fact = fact-at(parameter-facts name)
      let known: Bool = all-bounded(candidate)
      let binding: Fact = match known:
        true:
          candidate
        false:
          unknown(true true)
      let stored: Unit = vec.set(facts name binding)
      let next: I64 = syntax/ast_next(tokens cursor)
      recur(source tokens next facts parameter-facts)

fn all-bounded(fact: Fact) -> Bool:
  bool.and(get(fact lower-known) get(fact upper-known))

fn in-domain(value: I64) -> Bool:
  let lower: Bool = i64.ge(value -1000000000)
  let upper: Bool = i64.le(value 1000000000)
  bool.and(lower upper)

fn add-exact(base: Fact constant: I64 arguments-total: Bool) -> Fact:
  let positive: Bool = i64.ge(constant 0)
  let safety-bound: I64 = match positive:
    true:
      i64.sub(1000000000 constant)
    false:
      i64.sub(-1000000000 constant)
  let safe: Bool = match positive:
    true:
      bool.and(get(base upper-known) i64.le(get(base upper) safety-bound))
    false:
      bool.and(get(base lower-known) i64.ge(get(base lower) safety-bound))
  let lower-known: Bool = get(base lower-known)
  let upper-known: Bool = get(base upper-known)
  let lower: I64 = match lower-known:
    true:
      i64.add(get(base lower) constant)
    false:
      0
  let upper: I64 = match upper-known:
    true:
      i64.add(get(base upper) constant)
    false:
      0
  let lower-inside: Bool = match lower-known:
    true:
      in-domain(lower)
    false:
      false
  let upper-inside: Bool = match upper-known:
    true:
      in-domain(upper)
    false:
      false
  let total: Bool = bool.and(arguments-total safe)
  bounded(lower-inside lower upper-inside upper total)

fn add-bounded(left: Fact right: Fact arguments-total: Bool) -> Fact:
  let bounded-operands: Bool = bool.and(all-bounded(left) all-bounded(right))
  let left-lower-inside: Bool = in-domain(get(left lower))
  let left-upper-inside: Bool = in-domain(get(left upper))
  let right-lower-inside: Bool = in-domain(get(right lower))
  let right-upper-inside: Bool = in-domain(get(right upper))
  let left-inside: Bool = bool.and(left-lower-inside left-upper-inside)
  let right-inside: Bool = bool.and(right-lower-inside right-upper-inside)
  let ready: Bool = bool.and(bounded-operands bool.and(left-inside right-inside))
  let lower: I64 = match ready:
    true:
      i64.add(get(left lower) get(right lower))
    false:
      0
  let upper: I64 = match ready:
    true:
      i64.add(get(left upper) get(right upper))
    false:
      0
  let result-inside: Bool = match ready:
    true:
      bool.and(in-domain(lower) in-domain(upper))
    false:
      false
  match result-inside:
    true:
      bounded(true lower true upper arguments-total)
    false:
      unknown(true false)

fn add-facts(left: Fact right: Fact arguments-total: Bool) -> Fact:
  let right-exact: Bool = fact-exact(right)
  match right-exact:
    true:
      add-exact(left get(right lower) arguments-total)
    false:
      let left-exact: Bool = fact-exact(left)
      match left-exact:
        true:
          add-exact(right get(left lower) arguments-total)
        false:
          add-bounded(left right arguments-total)

fn subtract-facts(left: Fact right: Fact arguments-total: Bool) -> Fact:
  let right-exact: Bool = fact-exact(right)
  match right-exact:
    true:
      let constant: I64 = i64.sub(0 get(right lower))
      add-exact(left constant arguments-total)
    false:
      unknown(true false)

fn min-four(a: I64 b: I64 c: I64 d: I64) -> I64:
  minimum(minimum(a b) minimum(c d))

fn max-four(a: I64 b: I64 c: I64 d: I64) -> I64:
  maximum(maximum(a b) maximum(c d))

fn multiply-facts(left: Fact right: Fact arguments-total: Bool) -> Fact:
  let bounded-left: Bool = all-bounded(left)
  let bounded-right: Bool = all-bounded(right)
  let ready: Bool = bool.and(bounded-left bounded-right)
  match ready:
    false:
      unknown(true false)
    true:
      let a: I64 = i64.mul(get(left lower) get(right lower))
      let b: I64 = i64.mul(get(left lower) get(right upper))
      let c: I64 = i64.mul(get(left upper) get(right lower))
      let d: I64 = i64.mul(get(left upper) get(right upper))
      let lower: I64 = min-four(a b c d)
      let upper: I64 = max-four(a b c d)
      let inside: Bool = bool.and(in-domain(lower) in-domain(upper))
      let total: Bool = bool.and(arguments-total inside)
      match inside:
        true:
          bounded(true lower true upper total)
        false:
          unknown(true false)

fn absolute-domain-value(value: I64) -> I64:
  match i64.lt(value 0):
    true:
      i64.sub(0 value)
    false:
      value

fn quotient-fact(left: Fact right: Fact total: Bool) -> Fact effects[partial]:
  let a: I64 = i64.div(get(left lower) get(right lower))
  let b: I64 = i64.div(get(left lower) get(right upper))
  let c: I64 = i64.div(get(left upper) get(right lower))
  let d: I64 = i64.div(get(left upper) get(right upper))
  let lower: I64 = min-four(a b c d)
  let upper: I64 = max-four(a b c d)
  bounded(true lower true upper total)

fn remainder-fact(left: Fact right: Fact total: Bool) -> Fact:
  let lower-magnitude: I64 = absolute-domain-value(get(right lower))
  let upper-magnitude: I64 = absolute-domain-value(get(right upper))
  let magnitude: I64 = maximum(lower-magnitude upper-magnitude)
  let limit: I64 = i64.sub(magnitude 1)
  let left-nonnegative: Bool = match get(left lower-known):
    true:
      i64.ge(get(left lower) 0)
    false:
      false
  let left-nonpositive: Bool = match get(left upper-known):
    true:
      i64.le(get(left upper) 0)
    false:
      false
  let lower: I64 = match left-nonnegative:
    true:
      0
    false:
      i64.sub(0 limit)
  let upper: I64 = match left-nonpositive:
    true:
      0
    false:
      limit
  bounded(true lower true upper total)

fn divide-facts(left: Fact right: Fact arguments-total: Bool remainder: Bool) -> Fact effects[partial]:
  let bounded-left: Bool = all-bounded(left)
  let bounded-right: Bool = all-bounded(right)
  let positive: Bool = match bounded-right:
    true:
      i64.gt(get(right lower) 0)
    false:
      false
  let negative: Bool = match bounded-right:
    true:
      i64.lt(get(right upper) 0)
    false:
      false
  let nonzero: Bool = bool.or(positive negative)
  let minus-one-lower: Bool = match bounded-right:
    true:
      i64.le(get(right lower) -1)
    false:
      true
  let minus-one-upper: Bool = match bounded-right:
    true:
      i64.ge(get(right upper) -1)
    false:
      true
  let minus-one-possible: Bool = bool.and(minus-one-lower minus-one-upper)
  let overflow-safe: Bool = bool.or(bool.not(minus-one-possible) bounded-left)
  let safe: Bool = bool.and(bounded-right bool.and(nonzero overflow-safe))
  let total: Bool = bool.and(arguments-total safe)
  let left-exact: Bool = fact-exact(left)
  let right-exact: Bool = fact-exact(right)
  let exact-both: Bool = bool.and(left-exact right-exact)
  let computable: Bool = bool.and(safe exact-both)
  match computable:
    true:
      let value: I64 = match remainder:
        true:
          i64.rem(get(left lower) get(right lower))
        false:
          i64.div(get(left lower) get(right lower))
      bounded(true value true value total)
    false:
      match safe:
        false:
          unknown(true false)
        true:
          match remainder:
            true:
              remainder-fact(left right total)
            false:
              match bounded-left:
                true:
                  quotient-fact(left right total)
                false:
                  unknown(true total)

fn to-u8-fact(argument: Fact arguments-total: Bool) -> Fact:
  let bounded-argument: Bool = all-bounded(argument)
  let nonnegative: Bool = match bounded-argument:
    true:
      i64.ge(get(argument lower) 0)
    false:
      false
  let byte-sized: Bool = match bounded-argument:
    true:
      i64.le(get(argument upper) 255)
    false:
      false
  let safe: Bool = bool.and(nonnegative byte-sized)
  unknown(true bool.and(arguments-total safe))

fn callee-is-checked-trap(source: Bytes inout tokens: Vec[syntax/Token] callee: I64) -> Bool effects[partial]:
  let add-call: Bool = syntax/ast_node_text_is(source tokens callee "i64.add")
  let sub-call: Bool = syntax/ast_node_text_is(source tokens callee "i64.sub")
  let mul-call: Bool = syntax/ast_node_text_is(source tokens callee "i64.mul")
  let div-call: Bool = syntax/ast_node_text_is(source tokens callee "i64.div")
  let rem-call: Bool = syntax/ast_node_text_is(source tokens callee "i64.rem")
  let to-byte: Bool = syntax/ast_node_text_is(source tokens callee "i64.to-u8")
  let bytes-get: Bool = syntax/ast_node_text_is(source tokens callee "bytes.get")
  let vec-get: Bool = syntax/ast_node_text_is(source tokens callee "vec.get")
  let vec-set: Bool = syntax/ast_node_text_is(source tokens callee "vec.set")
  let arena-get: Bool = syntax/ast_node_text_is(source tokens callee "arena.get")
  bool.or(add-call bool.or(sub-call bool.or(mul-call bool.or(div-call bool.or(rem-call bool.or(to-byte bool.or(bytes-get bool.or(vec-get bool.or(vec-set arena-get)))))))))

fn expression-atom(source: Bytes inout tokens: Vec[syntax/Token] inout typed-facts: Vec[typing/Fact] inout facts: Vec[Fact] inout refinements: Vec[Refinement] parent: I64 expr: I64) -> Fact effects[partial]:
  let typed: typing/TypeRef = typing/fact_type(typed-facts expr)
  let integer: Bool = i64.eq(get(typed kind) 3)
  match integer:
    false:
      set-fact(expr unknown(true true) facts)
    true:
      let numeric: Bool = syntax/first_byte_is_number(source tokens expr)
      match numeric:
        true:
          let parsed: Parsed = parse-literal(source tokens expr)
          let fact: Fact = match get(parsed valid):
            true:
              exact(get(parsed value))
            false:
              unknown(true true)
          set-fact(expr fact facts)
        false:
          let binding: Fact = lookup-binding(tokens facts refinements parent expr)
          let lower-known: Bool = get(binding lower-known)
          let lower: I64 = get(binding lower)
          let upper-known: Bool = get(binding upper-known)
          let upper: I64 = get(binding upper)
          let fact: Fact = bounded(lower-known lower upper-known upper true)
          set-fact(expr fact facts)

fn analyze-forms(source: Bytes inout tokens: Vec[syntax/Token] inout typed-facts: Vec[typing/Fact] cursor: I64 inout facts: Vec[Fact] inout refinements: Vec[Refinement] parent: I64 total: Bool) -> Summary effects[alloc partial]:
  let kind: I64 = syntax/ast_node_kind(tokens cursor)
  let done: Bool = i64.eq(kind 1)
  match done:
    true:
      make Summary(total = total)
    false:
      let fact: Fact = analyze-expression(source tokens typed-facts cursor facts refinements parent)
      let next-total: Bool = bool.and(total get(fact total))
      let next: I64 = syntax/ast_next(tokens cursor)
      recur(source tokens typed-facts next facts refinements parent next-total)

fn analyze-fields(source: Bytes inout tokens: Vec[syntax/Token] inout typed-facts: Vec[typing/Fact] cursor: I64 inout facts: Vec[Fact] inout refinements: Vec[Refinement] parent: I64 total: Bool) -> Summary effects[alloc partial]:
  let kind: I64 = syntax/ast_node_kind(tokens cursor)
  let done: Bool = i64.eq(kind 1)
  match done:
    true:
      make Summary(total = total)
    false:
      let value: I64 = syntax/ast_member_value(cursor)
      let fact: Fact = analyze-expression(source tokens typed-facts value facts refinements parent)
      let next-total: Bool = bool.and(total get(fact total))
      let next: I64 = syntax/ast_next(tokens cursor)
      recur(source tokens typed-facts next facts refinements parent next-total)

fn call-fact(source: Bytes inout tokens: Vec[syntax/Token] inout facts: Vec[Fact] expr: I64 callee: I64 arguments: I64 arguments-total: Bool) -> Fact effects[partial]:
  let add-call: Bool = syntax/ast_node_text_is(source tokens callee "i64.add")
  let sub-call: Bool = syntax/ast_node_text_is(source tokens callee "i64.sub")
  let mul-call: Bool = syntax/ast_node_text_is(source tokens callee "i64.mul")
  let div-call: Bool = syntax/ast_node_text_is(source tokens callee "i64.div")
  let rem-call: Bool = syntax/ast_node_text_is(source tokens callee "i64.rem")
  let arithmetic-left: Bool = bool.or(add-call sub-call)
  let arithmetic-right: Bool = bool.or(mul-call bool.or(div-call rem-call))
  let arithmetic: Bool = bool.or(arithmetic-left arithmetic-right)
  match arithmetic:
    true:
      let second: I64 = syntax/ast_next(tokens arguments)
      let left: Fact = fact-at(facts arguments)
      let right: Fact = fact-at(facts second)
      match add-call:
        true:
          add-facts(left right arguments-total)
        false:
          match sub-call:
            true:
              subtract-facts(left right arguments-total)
            false:
              match mul-call:
                true:
                  multiply-facts(left right arguments-total)
                false:
                  match div-call:
                    true:
                      divide-facts(left right arguments-total false)
                    false:
                      divide-facts(left right arguments-total true)
    false:
      let to-byte: Bool = syntax/ast_node_text_is(source tokens callee "i64.to-u8")
      match to-byte:
        true:
          let left: Fact = fact-at(facts arguments)
          to-u8-fact(left arguments-total)
        false:
          let checked: Bool = callee-is-checked-trap(source tokens callee)
          match checked:
            true:
              unknown(true false)
            false:
              let builtin: Bool = typing/builtin_known(source tokens callee)
              let alloc: Bool = effects/call_requires(source tokens callee 1)
              let io: Bool = effects/call_requires(source tokens callee 2)
              let effectful: Bool = bool.or(alloc io)
              let safe: Bool = bool.and(builtin bool.not(effectful))
              let total: Bool = bool.and(arguments-total safe)
              let u8-to-i64: Bool = syntax/ast_node_text_is(source tokens callee "u8.to-i64")
              match u8-to-i64:
                true:
                  bounded(true 0 true 255 total)
                false:
                  unknown(true total)

fn analyze-user-call-arguments(source: Bytes inout tokens: Vec[syntax/Token] inout typed-facts: Vec[typing/Fact] inout facts: Vec[Fact] inout refinements: Vec[Refinement] parent: I64 parameter: I64 argument: I64 total: Bool) -> Summary effects[alloc partial]:
  let kind: I64 = syntax/ast_node_kind(tokens parameter)
  let done: Bool = i64.eq(kind 1)
  match done:
    true:
      make Summary(total = total)
    false:
      let fact: Fact = analyze-expression(source tokens typed-facts argument facts refinements parent)
      let next-total: Bool = bool.and(total get(fact total))
      let next-parameter: I64 = syntax/ast_next(tokens parameter)
      let last: Bool = i64.eq(syntax/ast_node_kind(tokens next-parameter) 1)
      match last:
        true:
          make Summary(total = next-total)
        false:
          let next-argument: I64 = syntax/ast_next(tokens argument)
          recur(source tokens typed-facts facts refinements parent next-parameter next-argument next-total)

fn analyze-call(source: Bytes inout tokens: Vec[syntax/Token] inout typed-facts: Vec[typing/Fact] inout facts: Vec[Fact] inout refinements: Vec[Refinement] parent: I64 expr: I64) -> Fact effects[alloc partial]:
  let callee: I64 = syntax/ast_call_callee(expr)
  let arguments: I64 = syntax/ast_call_arguments(expr)
  let declaration: I64 = syntax/ast_node_link(tokens callee)
  let user: Bool = i64.ge(declaration 0)
  let summary: Summary = match user:
    true:
      let params: I64 = syntax/ast_function_parameters(declaration)
      let first-parameter: I64 = syntax/ast_parameters_first(params)
      analyze-user-call-arguments(source tokens typed-facts facts refinements parent first-parameter arguments true)
    false:
      analyze-forms(source tokens typed-facts arguments facts refinements parent true)
  let fact: Fact = call-fact(source tokens facts expr callee arguments get(summary total))
  set-fact(expr fact facts)

fn analyze-let(source: Bytes inout tokens: Vec[syntax/Token] inout typed-facts: Vec[typing/Fact] inout facts: Vec[Fact] inout refinements: Vec[Refinement] parent: I64 expr: I64) -> Fact effects[alloc partial]:
  let name: I64 = syntax/ast_let_name(expr)
  let type-index: I64 = syntax/ast_let_type(expr)
  let value: I64 = syntax/ast_let_value(tokens expr)
  let body: I64 = syntax/ast_let_body(tokens expr)
  let value-fact: Fact = analyze-expression(source tokens typed-facts value facts refinements parent)
  let binding: Fact = bounded(get(value-fact lower-known) get(value-fact lower) get(value-fact upper-known) get(value-fact upper) true)
  let stored: Unit = vec.set(facts name binding)
  let body-fact: Fact = analyze-expression(source tokens typed-facts body facts refinements parent)
  let total: Bool = bool.and(get(value-fact total) get(body-fact total))
  let fact: Fact = bounded(get(body-fact lower-known) get(body-fact lower) get(body-fact upper-known) get(body-fact upper) total)
  set-fact(expr fact facts)

fn last-child(inout tokens: Vec[syntax/Token] cursor: I64 previous: I64) -> I64 effects[partial]:
  let kind: I64 = syntax/ast_node_kind(tokens cursor)
  let done: Bool = i64.eq(kind 1)
  match done:
    true:
      previous
    false:
      let next: I64 = syntax/ast_next(tokens cursor)
      recur(tokens next cursor)

fn invalid-constraint() -> Constraint:
  make Constraint(valid = false declaration = -1 true-kind = -1 true-bound = 0 false-kind = -1 false-bound = 0)

fn comparison-constraint(source: Bytes inout tokens: Vec[syntax/Token] inout facts: Vec[Fact] expr: I64) -> Constraint effects[partial]:
  let kind: I64 = syntax/ast_node_kind(tokens expr)
  let form: Bool = i64.eq(kind 0)
  match form:
    false:
      invalid-constraint()
    true:
      let call-form: Bool = syntax/ast_expression_is_call(source tokens expr)
      match call-form:
        false:
          invalid-constraint()
        true:
          let callee: I64 = syntax/ast_call_callee(expr)
          let left: I64 = syntax/ast_call_arguments(expr)
          let right: I64 = syntax/ast_next(tokens left)
          let declaration: I64 = typing/linked_binding_declaration(tokens left)
          let linked: Bool = i64.ge(declaration 0)
          let right-fact: Fact = fact-at(facts right)
          let exact-right: Bool = fact-exact(right-fact)
          let ready: Bool = bool.and(linked exact-right)
          match ready:
            false:
              invalid-constraint()
            true:
              let bound: I64 = get(right-fact lower)
              let lt-call: Bool = syntax/ast_node_text_is(source tokens callee "i64.lt")
              match lt-call:
                true:
                  match i64.gt(bound -1000000000):
                    true:
                      make Constraint(valid = true declaration = declaration true-kind = 1 true-bound = i64.sub(bound 1) false-kind = 0 false-bound = bound)
                    false:
                      invalid-constraint()
                false:
                  let le-call: Bool = syntax/ast_node_text_is(source tokens callee "i64.le")
                  match le-call:
                    true:
                      match i64.lt(bound 1000000000):
                        true:
                          make Constraint(valid = true declaration = declaration true-kind = 1 true-bound = bound false-kind = 0 false-bound = i64.add(bound 1))
                        false:
                          invalid-constraint()
                    false:
                      let gt-call: Bool = syntax/ast_node_text_is(source tokens callee "i64.gt")
                      match gt-call:
                        true:
                          match i64.lt(bound 1000000000):
                            true:
                              make Constraint(valid = true declaration = declaration true-kind = 0 true-bound = i64.add(bound 1) false-kind = 1 false-bound = bound)
                            false:
                              invalid-constraint()
                        false:
                          let ge-call: Bool = syntax/ast_node_text_is(source tokens callee "i64.ge")
                          match ge-call:
                            true:
                              match i64.gt(bound -1000000000):
                                true:
                                  make Constraint(valid = true declaration = declaration true-kind = 0 true-bound = bound false-kind = 1 false-bound = i64.sub(bound 1))
                                false:
                                  invalid-constraint()
                            false:
                              invalid-constraint()

fn refine-fact(base: Fact kind: I64 bound: I64) -> Fact:
  let lower-refinement: Bool = i64.eq(kind 0)
  match lower-refinement:
    true:
      let had-lower: Bool = get(base lower-known)
      let lower: I64 = match had-lower:
        true:
          maximum(get(base lower) bound)
        false:
          bound
      bounded(true lower get(base upper-known) get(base upper) true)
    false:
      let upper-refinement: Bool = i64.eq(kind 1)
      match upper-refinement:
        true:
          let had-upper: Bool = get(base upper-known)
          let upper: I64 = match had-upper:
            true:
              minimum(get(base upper) bound)
            false:
              bound
          bounded(get(base lower-known) get(base lower) true upper true)
        false:
          base

fn push-refinement(inout facts: Vec[Fact] inout refinements: Vec[Refinement] parent: I64 declaration: I64 kind: I64 bound: I64) -> I64 effects[alloc partial]:
  let count: I64 = vec.len(refinements)
  let room: Bool = i64.lt(count 64)
  match room:
    false:
      parent
    true:
      let base-refined: Fact = lookup-refinement(refinements parent declaration)
      let has-refined: Bool = get(base-refined analyzed)
      let base: Fact = match has-refined:
        true:
          base-refined
        false:
          fact-at(facts declaration)
      let next-fact: Fact = refine-fact(base kind bound)
      let refinement: Refinement = make Refinement(declaration = declaration fact = next-fact parent = parent)
      let pushed: Unit = vec.push(refinements refinement)
      count

fn arm-parent(source: Bytes inout tokens: Vec[syntax/Token] inout facts: Vec[Fact] inout refinements: Vec[Refinement] parent: I64 pattern: I64 constraint: Constraint) -> I64 effects[alloc partial]:
  let valid: Bool = get(constraint valid)
  match valid:
    false:
      parent
    true:
      let true-pattern: Bool = syntax/ast_node_text_is(source tokens pattern "true")
      let false-pattern: Bool = syntax/ast_node_text_is(source tokens pattern "false")
      let applicable: Bool = bool.or(true-pattern false-pattern)
      match applicable:
        false:
          parent
        true:
          let refinement-kind: I64 = match true-pattern:
            true:
              get(constraint true-kind)
            false:
              get(constraint false-kind)
          let refinement-bound: I64 = match true-pattern:
            true:
              get(constraint true-bound)
            false:
              get(constraint false-bound)
          push-refinement(facts refinements parent get(constraint declaration) refinement-kind refinement-bound)

fn join-facts(left: Fact right: Fact total: Bool) -> Fact:
  let lower-known: Bool = bool.and(get(left lower-known) get(right lower-known))
  let lower: I64 = match lower-known:
    true:
      minimum(get(left lower) get(right lower))
    false:
      0
  let upper-known: Bool = bool.and(get(left upper-known) get(right upper-known))
  let upper: I64 = match upper-known:
    true:
      maximum(get(left upper) get(right upper))
    false:
      0
  bounded(lower-known lower upper-known upper total)

fn analyze-arms(source: Bytes inout tokens: Vec[syntax/Token] inout typed-facts: Vec[typing/Fact] cursor: I64 inout facts: Vec[Fact] inout refinements: Vec[Refinement] parent: I64 constraint: Constraint summary: ArmSummary) -> ArmSummary effects[alloc partial]:
  let kind: I64 = syntax/ast_node_kind(tokens cursor)
  let done: Bool = i64.eq(kind 1)
  match done:
    true:
      summary
    false:
      let pattern: I64 = syntax/ast_arm_pattern(cursor)
      let first: I64 = syntax/ast_arm_pattern(cursor)
      let body: I64 = last-child(tokens first first)
      let scoped-parent: I64 = arm-parent(source tokens facts refinements parent pattern constraint)
      let body-fact: Fact = analyze-expression(source tokens typed-facts body facts refinements scoped-parent)
      let next-fact: Fact = match get(summary present):
        true:
          let prior: Fact = get(summary fact)
          let both-total: Bool = bool.and(get(prior total) get(body-fact total))
          join-facts(prior body-fact both-total)
        false:
          body-fact
      let next-summary: ArmSummary = make ArmSummary(present = true fact = next-fact)
      let next: I64 = syntax/ast_next(tokens cursor)
      recur(source tokens typed-facts next facts refinements parent constraint next-summary)

fn analyze-match(source: Bytes inout tokens: Vec[syntax/Token] inout typed-facts: Vec[typing/Fact] inout facts: Vec[Fact] inout refinements: Vec[Refinement] parent: I64 expr: I64) -> Fact effects[alloc partial]:
  let value: I64 = syntax/ast_match_value(expr)
  let value-fact: Fact = analyze-expression(source tokens typed-facts value facts refinements parent)
  let constraint: Constraint = comparison-constraint(source tokens facts value)
  let first-arm: I64 = syntax/ast_match_arms(tokens expr)
  let initial: Fact = unknown(true true)
  let initial-summary: ArmSummary = make ArmSummary(present = false fact = initial)
  let summary: ArmSummary = analyze-arms(source tokens typed-facts first-arm facts refinements parent constraint initial-summary)
  let arms-fact: Fact = get(summary fact)
  let total: Bool = bool.and(get(value-fact total) get(arms-fact total))
  let fact: Fact = bounded(get(arms-fact lower-known) get(arms-fact lower) get(arms-fact upper-known) get(arms-fact upper) total)
  set-fact(expr fact facts)

fn analyze-set(source: Bytes inout tokens: Vec[syntax/Token] inout typed-facts: Vec[typing/Fact] inout facts: Vec[Fact] inout refinements: Vec[Refinement] parent: I64 expr: I64) -> Fact effects[alloc partial]:
  let value: I64 = syntax/ast_set_value(expr)
  let body: I64 = syntax/ast_set_body(tokens expr)
  let value-fact: Fact = analyze-expression(source tokens typed-facts value facts refinements parent)
  let body-fact: Fact = analyze-expression(source tokens typed-facts body facts refinements parent)
  let total: Bool = bool.and(get(value-fact total) get(body-fact total))
  let fact: Fact = bounded(get(body-fact lower-known) get(body-fact lower) get(body-fact upper-known) get(body-fact upper) total)
  set-fact(expr fact facts)

fn analyze-data(source: Bytes inout tokens: Vec[syntax/Token] inout typed-facts: Vec[typing/Fact] inout facts: Vec[Fact] inout refinements: Vec[Refinement] parent: I64 expr: I64) -> Fact effects[alloc partial]:
  let make-form: Bool = syntax/ast_expression_is_make(source tokens expr)
  let summary: Summary = match make-form:
    true:
      analyze-fields(source tokens typed-facts syntax/ast_make_fields(expr) facts refinements parent true)
    false:
      let get-form: Bool = syntax/ast_expression_is_get(source tokens expr)
      match get-form:
        true:
          let value: I64 = syntax/ast_get_value(expr)
          let fact: Fact = analyze-expression(source tokens typed-facts value facts refinements parent)
          make Summary(total = get(fact total))
        false:
          let case-form: Bool = syntax/ast_expression_is_case(source tokens expr)
          let first: I64 = match case-form:
            true:
              syntax/ast_case_payload(tokens expr)
            false:
              syntax/ast_fork_body(expr)
          analyze-forms(source tokens typed-facts first facts refinements parent true)
  set-fact(expr unknown(true get(summary total)) facts)

fn analyze-expression(source: Bytes inout tokens: Vec[syntax/Token] inout typed-facts: Vec[typing/Fact] expr: I64 inout facts: Vec[Fact] inout refinements: Vec[Refinement] parent: I64) -> Fact effects[alloc partial]:
  let kind: I64 = syntax/ast_node_kind(tokens expr)
  let form: Bool = i64.eq(kind 0)
  match form:
    false:
      expression-atom(source tokens typed-facts facts refinements parent expr)
    true:
      let let-form: Bool = syntax/ast_expression_is_let(source tokens expr)
      match let-form:
        true:
          analyze-let(source tokens typed-facts facts refinements parent expr)
        false:
          let call-form: Bool = syntax/ast_expression_is_call(source tokens expr)
          match call-form:
            true:
              analyze-call(source tokens typed-facts facts refinements parent expr)
            false:
              let match-form: Bool = syntax/ast_expression_is_match(source tokens expr)
              match match-form:
                true:
                  analyze-match(source tokens typed-facts facts refinements parent expr)
                false:
                  let set-form: Bool = syntax/ast_expression_is_set(source tokens expr)
                  match set-form:
                    true:
                      analyze-set(source tokens typed-facts facts refinements parent expr)
                    false:
                      let recur-form: Bool = syntax/ast_expression_is_recur(source tokens expr)
                      match recur-form:
                        true:
                          let summary: Summary = analyze-forms(source tokens typed-facts syntax/ast_recur_arguments(expr) facts refinements parent true)
                          set-fact(expr unknown(true false) facts)
                        false:
                          analyze-data(source tokens typed-facts facts refinements parent expr)

fn boolean-arm-body(source: Bytes inout tokens: Vec[syntax/Token] cursor: I64 pattern: Bytes) -> I64 effects[partial]:
  let kind: I64 = syntax/ast_node_kind(tokens cursor)
  let done: Bool = i64.eq(kind 1)
  match done:
    true:
      -1
    false:
      let pattern-token: I64 = syntax/ast_arm_pattern(cursor)
      let same: Bool = syntax/ast_node_text_is(source tokens pattern-token pattern)
      match same:
        true:
          last-child(tokens pattern-token pattern-token)
        false:
          let next: I64 = syntax/ast_next(tokens cursor)
          recur(source tokens next pattern)

fn tail-expression(source: Bytes inout tokens: Vec[syntax/Token] expr: I64) -> I64 effects[partial]:
  let let-form: Bool = syntax/ast_expression_is_let(source tokens expr)
  match let-form:
    false:
      expr
    true:
      recur(source tokens syntax/ast_let_body(tokens expr))

fn prefix-total-to-tail(source: Bytes inout tokens: Vec[syntax/Token] inout facts: Vec[Fact] expr: I64 tail: I64) -> Bool effects[partial]:
  let done: Bool = i64.eq(expr tail)
  match done:
    true:
      true
    false:
      let let-form: Bool = syntax/ast_expression_is_let(source tokens expr)
      match let-form:
        false:
          false
        true:
          let value: I64 = syntax/ast_let_value(tokens expr)
          let body: I64 = syntax/ast_let_body(tokens expr)
          let value-total: Bool = fact-total(facts value)
          let rest-total: Bool = recur(source tokens facts body tail)
          bool.and(value-total rest-total)

fn forms-total(inout tokens: Vec[syntax/Token] inout facts: Vec[Fact] cursor: I64) -> Bool effects[partial]:
  let kind: I64 = syntax/ast_node_kind(tokens cursor)
  let done: Bool = i64.eq(kind 1)
  match done:
    true:
      true
    false:
      let current-total: Bool = fact-total(facts cursor)
      let next: I64 = syntax/ast_next(tokens cursor)
      let rest-total: Bool = recur(tokens facts next)
      bool.and(current-total rest-total)

fn parameter-position(source: Bytes inout tokens: Vec[syntax/Token] cursor: I64 declaration: I64 position: I64) -> I64 effects[partial]:
  let kind: I64 = syntax/ast_node_kind(tokens cursor)
  let done: Bool = i64.eq(kind 1)
  match done:
    true:
      -1
    false:
      let head: I64 = syntax/ast_list_first(cursor)
      let borrowed: Bool = syntax/ast_binding_is_inout(source tokens cursor)
      let name: I64 = syntax/ast_binding_name(source tokens cursor)
      let same: Bool = i64.eq(name declaration)
      match same:
        true:
          position
        false:
          let next: I64 = syntax/ast_next(tokens cursor)
          let next-position: I64 = i64.add(position 1)
          recur(source tokens next declaration next-position)

fn form-at(inout tokens: Vec[syntax/Token] cursor: I64 position: I64) -> I64 effects[partial]:
  let done: Bool = i64.eq(position 0)
  match done:
    true:
      cursor
    false:
      let next: I64 = syntax/ast_next(tokens cursor)
      let next-position: I64 = i64.sub(position 1)
      recur(tokens next next-position)

fn promote-total(inout facts: Vec[Fact] expr: I64) -> Fact effects[partial]:
  let prior: Fact = fact-at(facts expr)
  let promoted: Fact = bounded(get(prior lower-known) get(prior lower) get(prior upper-known) get(prior upper) true)
  set-fact(expr promoted facts)

fn decreasing-controller(source: Bytes inout tokens: Vec[syntax/Token] inout facts: Vec[Fact] params: I64 declaration: I64 recur-expr: I64) -> Descent effects[partial]:
  let first-param: I64 = syntax/ast_parameters_first(params)
  let position: I64 = parameter-position(source tokens first-param declaration 0)
  let found: Bool = i64.ge(position 0)
  match found:
    false:
      make Descent(valid = false position = -1 step = 0)
    true:
      let first-argument: I64 = syntax/ast_recur_arguments(recur-expr)
      let update: I64 = form-at(tokens first-argument position)
      let subtraction: Bool = syntax/ast_expression_is_call(source tokens update)
      let callee: I64 = syntax/ast_call_callee(update)
      let sub-call: Bool = syntax/ast_node_text_is(source tokens callee "i64.sub")
      let left: I64 = syntax/ast_call_arguments(update)
      let right: I64 = syntax/ast_next(tokens left)
      let linked: I64 = typing/linked_binding_declaration(tokens left)
      let same-controller: Bool = i64.eq(linked declaration)
      let step: Fact = fact-at(facts right)
      let exact-step: Bool = fact-exact(step)
      let positive-step: Bool = match exact-step:
        true:
          i64.gt(get(step lower) 0)
        false:
          false
      let update-total: Bool = fact-total(facts update)
      let arguments-total: Bool = forms-total(tokens facts first-argument)
      let valid: Bool = bool.and(subtraction bool.and(sub-call bool.and(same-controller bool.and(positive-step bool.and(update-total arguments-total)))))
      let step-value: I64 = match valid:
        true:
          get(step lower)
        false:
          0
      make Descent(valid = valid position = position step = step-value)

fn counted-update-valid(source: Bytes inout tokens: Vec[syntax/Token] controller: I64 position: I64 recur-form: I64) -> Bool effects[partial]:
  let arguments: I64 = syntax/ast_recur_arguments(recur-form)
  let argument: I64 = form-at(tokens arguments position)
  let call-form: Bool = syntax/ast_expression_is_call(source tokens argument)
  let callee: I64 = syntax/ast_call_callee(argument)
  let addition: Bool = match call-form:
    true:
      syntax/ast_node_text_is(source tokens callee "i64.add")
    false:
      false
  let left: I64 = syntax/ast_call_arguments(argument)
  let right: I64 = syntax/ast_next(tokens left)
  let linked: I64 = match addition:
    true:
      typing/linked_binding_declaration(tokens left)
    false:
      -1
  let same: Bool = i64.eq(linked controller)
  let parsed: Parsed = parse-literal(source tokens right)
  let one: Bool = match get(parsed valid):
    true:
      i64.eq(get(parsed value) 1)
    false:
      false
  bool.and(addition bool.and(same one))

fn scan-counted-recurrences(source: Bytes inout tokens: Vec[syntax/Token] controller: I64 position: I64 cursor: I64 end: I64 count: I64) -> CountScan effects[partial]:
  let done: Bool = i64.ge(cursor end)
  match done:
    true:
      make CountScan(valid = true count = count)
    false:
      let recur-form: Bool = syntax/ast_expression_is_recur(source tokens cursor)
      let fork-form: Bool = syntax/ast_expression_is_fork(source tokens cursor)
      let supported: Bool = bool.not(fork-form)
      let valid: Bool = match recur-form:
        true:
          counted-update-valid(source tokens controller position cursor)
        false:
          supported
      match valid:
        false:
          make CountScan(valid = false count = count)
        true:
          let increment: I64 = match recur-form:
            true:
              1
            false:
              0
          let next-count: I64 = i64.add(count increment)
          let next: I64 = syntax/ast_node_after(cursor)
          recur(source tokens controller position next end next-count)

