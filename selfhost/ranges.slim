module ranges

struct Fact:
  analyzed: Bool
  lower_known: Bool
  lower: I64
  upper_known: Bool
  upper: I64
  total: Bool

struct Parsed:
  valid: Bool
  value: I64

struct Refinement:
  declaration: I64
  fact: Fact
  parent: I64

struct Summary:
  total: Bool

struct ArmSummary:
  present: Bool
  fact: Fact

struct Constraint:
  valid: Bool
  declaration: I64
  true_kind: I64
  true_bound: I64
  false_kind: I64
  false_bound: I64

struct Descent:
  valid: Bool
  position: I64
  step: I64

struct Recurrence:
  item: I64
  position: I64
  bound: I64
  step: I64

struct CountScan:
  valid: Bool
  count: I64

struct AccScan:
  valid: Bool
  changed: Bool
  maximum: I64

struct Counted:
  item: I64
  controller: I64
  start: I64
  bound: I64
  step: I64
  iterations: I64
  base: I64
  body: I64

struct Work:
  known: Bool
  iterations: I64

struct View:
  facts: Vec[Fact]
  refinements: I64
  refinements_truncated: Bool
  recurrences: Vec[Recurrence]
  counted: Vec[Counted]

struct ResourceScan:
  profiled: I64
  reported: I64
  exact_sites: I64
  unknown_sites: I64
  maximum: I64

fn unknown(analyzed: Bool, total: Bool) -> Fact:
  Fact(analyzed: analyzed, lower_known: false, lower: 0, upper_known: false, upper: 0, total: total)

fn bounded(lower_known: Bool, lower: I64, upper_known: Bool, upper: I64, total: Bool) -> Fact:
  Fact(analyzed: true, lower_known: lower_known, lower: lower, upper_known: upper_known, upper: upper, total: total)

fn exact(value: I64) -> Fact:
  bounded(true, value, true, value, true)

fn initialize_facts(length: I64, index: I64, inout facts: Vec[Fact]) -> Void effects[alloc, partial]:
  let done: Bool = index >= length
  if done:
    void
  else:
    let fact: Fact = unknown(false, false)
    vec.push(facts, fact)
    let next: I64 = index + 1
    recur(length, next, facts)

fn fact_at(inout facts: Vec[Fact], index: I64) -> Fact effects[partial]:
  let nonnegative: Bool = index >= 0
  let length: I64 = vec.len(facts)
  let below: Bool = index < length
  let valid: Bool = nonnegative && below
  if valid:
    vec.get(facts, index)
  else:
    unknown(false, false)

fn set_fact(index: I64, fact: Fact, inout facts: Vec[Fact]) -> Fact effects[partial]:
  vec.set(facts, index, fact)
  fact

fn fact_total(inout facts: Vec[Fact], expr: I64) -> Bool effects[partial]:
  let fact: Fact = fact_at(facts, expr)
  fact.analyzed && fact.total

fn fact_exact(fact: Fact) -> Bool:
  let both: Bool = fact.lower_known && fact.upper_known
  let same: Bool = fact.lower == fact.upper
  both && same

fn minimum(left: I64, right: I64) -> I64:
  if left <= right:
    left
  else:
    right

fn maximum(left: I64, right: I64) -> I64:
  if left >= right:
    left
  else:
    right

fn parse_digits(source: Bytes, index: I64, end: I64, value: I64) -> Parsed effects[partial]:
  let done: Bool = index >= end
  if done:
    Parsed(valid: true, value: value)
  else:
    let byte: U8 = bytes.get(source, index)
    let code: I64 = u8.to_i64(byte)
    let lower: Bool = code >= 48
    let upper: Bool = code <= 57
    let digit: Bool = lower && upper
    if digit:
      let numeric: I64 = code - 48
      let prefix_too_large: Bool = value > 100000000
      let prefix_at_limit: Bool = value == 100000000
      let nonzero_digit: Bool = numeric > 0
      let limit_tail: Bool = prefix_at_limit && nonzero_digit
      let too_large: Bool = prefix_too_large || limit_tail
      if too_large:
        Parsed(valid: false, value: 0)
      else:
        let shifted: I64 = value * 10
        let next_value: I64 = shifted + numeric
        let next: I64 = index + 1
        recur(source, next, end, next_value)
    else:
      Parsed(valid: false, value: 0)

fn parse_literal(source: Bytes, inout tokens: Vec[syntax.Token], token: I64) -> Parsed effects[partial]:
  let start: I64 = syntax.ast_node_start(tokens, token)
  let end: I64 = syntax.ast_node_end(tokens, token)
  let first: U8 = bytes.get(source, start)
  let code: I64 = u8.to_i64(first)
  let negative: Bool = code == 45
  let digit_start: I64 = if negative:
    start + 1
  else:
    start
  let present: Bool = digit_start < end
  if present:
    let parsed: Parsed = parse_digits(source, digit_start, end, 0)
    let valid: Bool = parsed.valid
    if valid:
      let magnitude: I64 = parsed.value
      let value: I64 = if negative:
        0 - magnitude
      else:
        magnitude
      Parsed(valid: true, value: value)
    else:
      parsed
  else:
    Parsed(valid: false, value: 0)

fn lookup_refinement(inout refinements: Vec[Refinement], parent: I64, declaration: I64) -> Fact effects[partial]:
  let done: Bool = parent < 0
  if done:
    unknown(false, false)
  else:
    let refinement: Refinement = vec.get(refinements, parent)
    let same: Bool = refinement.declaration == declaration
    if same:
      refinement.fact
    else:
      recur(refinements, refinement.parent, declaration)

fn lookup_binding(inout tokens: Vec[syntax.Token], inout facts: Vec[Fact], inout refinements: Vec[Refinement], parent: I64, atom: I64) -> Fact effects[partial]:
  let declaration: I64 = typing.linked_binding_declaration(tokens, atom)
  let refined: Fact = lookup_refinement(refinements, parent, declaration)
  let present: Bool = refined.analyzed
  if present:
    refined
  else:
    fact_at(facts, declaration)

fn parameter_name(source: Bytes, inout tokens: Vec[syntax.Token], parameter: I64) -> I64 effects[partial]:
  syntax.ast_binding_name(source, tokens, parameter)

fn initialize_booleans(length: I64, index: I64, value: Bool, inout values: Vec[Bool]) -> Void effects[alloc, partial]:
  if index >= length:
    void
  else:
    vec.push(values, value)
    recur(length, index + 1, value, values)

fn mark_parameter_invariants(source: Bytes, inout tokens: Vec[syntax.Token], cursor: I64, inout invariants: Vec[Bool]) -> Void effects[partial]:
  if syntax.ast_node_kind(tokens, cursor) == 1:
    void
  else:
    let name: I64 = parameter_name(source, tokens, cursor)
    vec.set(invariants, name, true)
    recur(source, tokens, syntax.ast_next(tokens, cursor), invariants)

fn invalidate_recur_arguments(source: Bytes, inout tokens: Vec[syntax.Token], parameter: I64, argument: I64, inout invariants: Vec[Bool]) -> Void effects[partial]:
  if syntax.ast_node_kind(tokens, parameter) == 1:
    void
  else:
    let name: I64 = parameter_name(source, tokens, parameter)
    let argument_kind: I64 = syntax.ast_node_kind(tokens, argument)
    let atom: Bool = argument_kind == 2
    let linked: I64 = if atom:
      typing.linked_binding_declaration(tokens, argument)
    else:
      -1
    let unchanged: Bool = linked == name
    if unchanged:
      void
    else:
      vec.set(invariants, name, false)
    recur(source, tokens, syntax.ast_next(tokens, parameter), syntax.ast_next(tokens, argument), invariants)

fn scan_recur_invariants(source: Bytes, inout tokens: Vec[syntax.Token], cursor: I64, end: I64, params: I64, inout invariants: Vec[Bool]) -> Void effects[partial]:
  if cursor >= end:
    void
  else:
    let recur_form: Bool = syntax.ast_expression_is_recur(source, tokens, cursor)
    if recur_form:
      invalidate_recur_arguments(source, tokens, syntax.ast_parameters_first(params), syntax.ast_recur_arguments(cursor), invariants)
    else:
      void
    recur(source, tokens, syntax.ast_node_after(cursor), end, params, invariants)

fn collect_function_invariants(source: Bytes, inout tokens: Vec[syntax.Token], item: I64, inout invariants: Vec[Bool]) -> Void effects[partial]:
  let params: I64 = syntax.ast_function_parameters(item)
  mark_parameter_invariants(source, tokens, syntax.ast_parameters_first(params), invariants)
  let return_type: I64 = syntax.ast_function_return_type(tokens, item)
  let effects_form: I64 = syntax.ast_function_effects(tokens, item)
  let body: I64 = syntax.ast_next(tokens, effects_form)
  scan_recur_invariants(source, tokens, body, syntax.ast_next(tokens, body), params, invariants)

fn collect_parameter_invariants(source: Bytes, inout tokens: Vec[syntax.Token], cursor: I64, inout invariants: Vec[Bool]) -> Void effects[partial]:
  if syntax.ast_node_kind(tokens, cursor) == 1:
    void
  else:
    let function_item: Bool = syntax.ast_item_is_function(source, tokens, cursor)
    if function_item:
      collect_function_invariants(source, tokens, cursor, invariants)
    else:
      void
    recur(source, tokens, syntax.ast_next(tokens, cursor), invariants)

fn merge_parameter_fact(existing: Fact, candidate: Fact, invariant: Bool) -> Fact:
  if invariant:
    let candidate_bounded: Bool = all_bounded(candidate)
    let candidate_total: Bool = candidate.total
    let usable: Bool = candidate_bounded && candidate_total
    if usable:
      if existing.analyzed:
        let existing_bounded: Bool = all_bounded(existing)
        if existing_bounded:
          join_facts(existing, candidate, true)
        else:
          unknown(true, true)
      else:
        candidate
    else:
      unknown(true, true)
  else:
    unknown(true, true)

fn collect_call_arguments(source: Bytes, inout tokens: Vec[syntax.Token], inout facts: Vec[Fact], inout invariants: Vec[Bool], parameter: I64, argument: I64, inout parameter_facts: Vec[Fact]) -> Void effects[partial]:
  if syntax.ast_node_kind(tokens, parameter) == 1:
    void
  else:
    let name: I64 = parameter_name(source, tokens, parameter)
    let invariant: Bool = vec.get(invariants, name)
    let existing: Fact = fact_at(parameter_facts, name)
    let candidate: Fact = fact_at(facts, argument)
    let merged: Fact = merge_parameter_fact(existing, candidate, invariant)
    vec.set(parameter_facts, name, merged)
    let next_parameter: I64 = syntax.ast_next(tokens, parameter)
    let last: Bool = syntax.ast_node_kind(tokens, next_parameter) == 1
    if last:
      void
    else:
      let next_argument: I64 = syntax.ast_next(tokens, argument)
      recur(source, tokens, facts, invariants, next_parameter, next_argument, parameter_facts)

fn scan_parameter_calls(source: Bytes, inout tokens: Vec[syntax.Token], inout facts: Vec[Fact], inout invariants: Vec[Bool], cursor: I64, length: I64, inout parameter_facts: Vec[Fact]) -> Void effects[partial]:
  if cursor >= length:
    void
  else:
    let kind: I64 = syntax.ast_node_kind(tokens, cursor)
    let form: Bool = kind == 0
    let head: I64 = syntax.ast_list_first(cursor)
    let call_form: Bool = if form:
      syntax.ast_expression_is_call(source, tokens, cursor)
    else:
      false
    let callee: I64 = syntax.ast_call_callee(cursor)
    let declaration: I64 = if call_form:
      syntax.ast_node_link(tokens, callee)
    else:
      -1
    let user: Bool = declaration >= 0
    if user:
      collect_call_arguments(source, tokens, facts, invariants, syntax.ast_parameters_first(syntax.ast_function_parameters(declaration)), syntax.ast_call_arguments(cursor), parameter_facts)
    else:
      void
    recur(source, tokens, facts, invariants, syntax.ast_node_after(cursor), length, parameter_facts)

fn initialize_parameters(source: Bytes, inout tokens: Vec[syntax.Token], cursor: I64, inout facts: Vec[Fact], inout parameter_facts: Vec[Fact]) -> Void effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    void
  else:
    let head: I64 = syntax.ast_list_first(cursor)
    let borrowed: Bool = syntax.ast_binding_is_inout(source, tokens, cursor)
    let name: I64 = syntax.ast_binding_name(source, tokens, cursor)
    let candidate: Fact = fact_at(parameter_facts, name)
    let known: Bool = all_bounded(candidate)
    let binding: Fact = if known:
      candidate
    else:
      unknown(true, true)
    vec.set(facts, name, binding)
    let next: I64 = syntax.ast_next(tokens, cursor)
    recur(source, tokens, next, facts, parameter_facts)

fn all_bounded(fact: Fact) -> Bool:
  fact.lower_known && fact.upper_known

fn in_domain(value: I64) -> Bool:
  let lower: Bool = value >= -1000000000
  let upper: Bool = value <= 1000000000
  lower && upper

fn add_exact(base: Fact, constant: I64, arguments_total: Bool) -> Fact:
  let positive: Bool = constant >= 0
  let safety_bound: I64 = if positive:
    1000000000 - constant
  else:
    -1000000000 - constant
  let safe: Bool = if positive:
    base.upper_known && (base.upper <= safety_bound)
  else:
    base.lower_known && (base.lower >= safety_bound)
  let lower_known: Bool = base.lower_known
  let upper_known: Bool = base.upper_known
  let lower: I64 = if lower_known:
    base.lower + constant
  else:
    0
  let upper: I64 = if upper_known:
    base.upper + constant
  else:
    0
  let lower_inside: Bool = if lower_known:
    in_domain(lower)
  else:
    false
  let upper_inside: Bool = if upper_known:
    in_domain(upper)
  else:
    false
  let total: Bool = arguments_total && safe
  bounded(lower_inside, lower, upper_inside, upper, total)

fn add_bounded(left: Fact, right: Fact, arguments_total: Bool) -> Fact:
  let bounded_operands: Bool = all_bounded(left) && all_bounded(right)
  let left_lower_inside: Bool = in_domain(left.lower)
  let left_upper_inside: Bool = in_domain(left.upper)
  let right_lower_inside: Bool = in_domain(right.lower)
  let right_upper_inside: Bool = in_domain(right.upper)
  let left_inside: Bool = left_lower_inside && left_upper_inside
  let right_inside: Bool = right_lower_inside && right_upper_inside
  let ready: Bool = bounded_operands && (left_inside && right_inside)
  let lower: I64 = if ready:
    left.lower + right.lower
  else:
    0
  let upper: I64 = if ready:
    left.upper + right.upper
  else:
    0
  let result_inside: Bool = if ready:
    in_domain(lower) && in_domain(upper)
  else:
    false
  if result_inside:
    bounded(true, lower, true, upper, arguments_total)
  else:
    unknown(true, false)

fn add_facts(left: Fact, right: Fact, arguments_total: Bool) -> Fact:
  let right_exact: Bool = fact_exact(right)
  if right_exact:
    add_exact(left, right.lower, arguments_total)
  else:
    let left_exact: Bool = fact_exact(left)
    if left_exact:
      add_exact(right, left.lower, arguments_total)
    else:
      add_bounded(left, right, arguments_total)

fn subtract_facts(left: Fact, right: Fact, arguments_total: Bool) -> Fact:
  let right_exact: Bool = fact_exact(right)
  if right_exact:
    let constant: I64 = 0 - right.lower
    add_exact(left, constant, arguments_total)
  else:
    unknown(true, false)

fn min_four(a: I64, b: I64, c: I64, d: I64) -> I64:
  minimum(minimum(a, b), minimum(c, d))

fn max_four(a: I64, b: I64, c: I64, d: I64) -> I64:
  maximum(maximum(a, b), maximum(c, d))

fn multiply_facts(left: Fact, right: Fact, arguments_total: Bool) -> Fact:
  let bounded_left: Bool = all_bounded(left)
  let bounded_right: Bool = all_bounded(right)
  let ready: Bool = bounded_left && bounded_right
  if ready:
    let a: I64 = left.lower * right.lower
    let b: I64 = left.lower * right.upper
    let c: I64 = left.upper * right.lower
    let d: I64 = left.upper * right.upper
    let lower: I64 = min_four(a, b, c, d)
    let upper: I64 = max_four(a, b, c, d)
    let inside: Bool = in_domain(lower) && in_domain(upper)
    let total: Bool = arguments_total && inside
    if inside:
      bounded(true, lower, true, upper, total)
    else:
      unknown(true, false)
  else:
    unknown(true, false)

fn absolute_domain_value(value: I64) -> I64:
  if value < 0:
    0 - value
  else:
    value

fn quotient_fact(left: Fact, right: Fact, total: Bool) -> Fact effects[partial]:
  let a: I64 = left.lower / right.lower
  let b: I64 = left.lower / right.upper
  let c: I64 = left.upper / right.lower
  let d: I64 = left.upper / right.upper
  let lower: I64 = min_four(a, b, c, d)
  let upper: I64 = max_four(a, b, c, d)
  bounded(true, lower, true, upper, total)

fn remainder_fact(left: Fact, right: Fact, total: Bool) -> Fact:
  let lower_magnitude: I64 = absolute_domain_value(right.lower)
  let upper_magnitude: I64 = absolute_domain_value(right.upper)
  let magnitude: I64 = maximum(lower_magnitude, upper_magnitude)
  let limit: I64 = magnitude - 1
  let left_nonnegative: Bool = if left.lower_known:
    left.lower >= 0
  else:
    false
  let left_nonpositive: Bool = if left.upper_known:
    left.upper <= 0
  else:
    false
  let lower: I64 = if left_nonnegative:
    0
  else:
    0 - limit
  let upper: I64 = if left_nonpositive:
    0
  else:
    limit
  bounded(true, lower, true, upper, total)

fn divide_facts(left: Fact, right: Fact, arguments_total: Bool, remainder: Bool) -> Fact effects[partial]:
  let bounded_left: Bool = all_bounded(left)
  let bounded_right: Bool = all_bounded(right)
  let positive: Bool = if bounded_right:
    right.lower > 0
  else:
    false
  let negative: Bool = if bounded_right:
    right.upper < 0
  else:
    false
  let nonzero: Bool = positive || negative
  let minus_one_lower: Bool = if bounded_right:
    right.lower <= -1
  else:
    true
  let minus_one_upper: Bool = if bounded_right:
    right.upper >= -1
  else:
    true
  let minus_one_possible: Bool = minus_one_lower && minus_one_upper
  let overflow_safe: Bool = (!minus_one_possible) || bounded_left
  let safe: Bool = bounded_right && (nonzero && overflow_safe)
  let total: Bool = arguments_total && safe
  let left_exact: Bool = fact_exact(left)
  let right_exact: Bool = fact_exact(right)
  let exact_both: Bool = left_exact && right_exact
  let computable: Bool = safe && exact_both
  if computable:
    let value: I64 = if remainder:
      left.lower % right.lower
    else:
      left.lower / right.lower
    bounded(true, value, true, value, total)
  else:
    if safe:
      if remainder:
        remainder_fact(left, right, total)
      else:
        if bounded_left:
          quotient_fact(left, right, total)
        else:
          unknown(true, total)
    else:
      unknown(true, false)

fn to_u8_fact(argument: Fact, arguments_total: Bool) -> Fact:
  let bounded_argument: Bool = all_bounded(argument)
  let nonnegative: Bool = if bounded_argument:
    argument.lower >= 0
  else:
    false
  let byte_sized: Bool = if bounded_argument:
    argument.upper <= 255
  else:
    false
  let safe: Bool = nonnegative && byte_sized
  unknown(true, arguments_total && safe)

fn callee_is_checked_trap(source: Bytes, inout tokens: Vec[syntax.Token], callee: I64) -> Bool effects[partial]:
  let add_call: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.add")
  let sub_call: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.sub")
  let mul_call: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.mul")
  let div_call: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.div")
  let rem_call: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.rem")
  let to_byte: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.to_u8")
  let bytes_get: Bool = syntax.ast_node_text_is(source, tokens, callee, "bytes.get")
  let vec_get: Bool = syntax.ast_node_text_is(source, tokens, callee, "vec.get")
  let vec_set: Bool = syntax.ast_node_text_is(source, tokens, callee, "vec.set")
  let arena_get: Bool = syntax.ast_node_text_is(source, tokens, callee, "arena.get")
  add_call || (sub_call || (mul_call || (div_call || (rem_call || (to_byte || (bytes_get || (vec_get || (vec_set || arena_get))))))))

fn expression_atom(source: Bytes, inout tokens: Vec[syntax.Token], inout typed_facts: Vec[typing.Fact], inout facts: Vec[Fact], inout refinements: Vec[Refinement], parent: I64, expr: I64) -> Fact effects[partial]:
  let typed: typing.TypeRef = typing.fact_type(typed_facts, expr)
  let integer: Bool = typed.kind == 3
  if integer:
    let numeric: Bool = syntax.first_byte_is_number(source, tokens, expr)
    if numeric:
      let parsed: Parsed = parse_literal(source, tokens, expr)
      let fact: Fact = if parsed.valid:
        exact(parsed.value)
      else:
        unknown(true, true)
      set_fact(expr, fact, facts)
    else:
      let binding: Fact = lookup_binding(tokens, facts, refinements, parent, expr)
      let lower_known: Bool = binding.lower_known
      let lower: I64 = binding.lower
      let upper_known: Bool = binding.upper_known
      let upper: I64 = binding.upper
      let fact: Fact = bounded(lower_known, lower, upper_known, upper, true)
      set_fact(expr, fact, facts)
  else:
    set_fact(expr, unknown(true, true), facts)

fn analyze_forms(source: Bytes, inout tokens: Vec[syntax.Token], inout typed_facts: Vec[typing.Fact], cursor: I64, inout facts: Vec[Fact], inout refinements: Vec[Refinement], parent: I64, total: Bool) -> Summary effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    Summary(total: total)
  else:
    let fact: Fact = analyze_expression(source, tokens, typed_facts, cursor, facts, refinements, parent)
    let next_total: Bool = total && fact.total
    let next: I64 = syntax.ast_next(tokens, cursor)
    recur(source, tokens, typed_facts, next, facts, refinements, parent, next_total)

fn analyze_fields(source: Bytes, inout tokens: Vec[syntax.Token], inout typed_facts: Vec[typing.Fact], cursor: I64, inout facts: Vec[Fact], inout refinements: Vec[Refinement], parent: I64, total: Bool) -> Summary effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    Summary(total: total)
  else:
    let value: I64 = syntax.ast_member_value(cursor)
    let fact: Fact = analyze_expression(source, tokens, typed_facts, value, facts, refinements, parent)
    let next_total: Bool = total && fact.total
    let next: I64 = syntax.ast_next(tokens, cursor)
    recur(source, tokens, typed_facts, next, facts, refinements, parent, next_total)

fn call_fact(source: Bytes, inout tokens: Vec[syntax.Token], inout facts: Vec[Fact], expr: I64, callee: I64, arguments: I64, arguments_total: Bool) -> Fact effects[partial]:
  let add_call: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.add")
  let sub_call: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.sub")
  let mul_call: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.mul")
  let div_call: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.div")
  let rem_call: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.rem")
  let arithmetic_left: Bool = add_call || sub_call
  let arithmetic_right: Bool = mul_call || (div_call || rem_call)
  let arithmetic: Bool = arithmetic_left || arithmetic_right
  if arithmetic:
    let second: I64 = syntax.ast_next(tokens, arguments)
    let left: Fact = fact_at(facts, arguments)
    let right: Fact = fact_at(facts, second)
    if add_call:
      add_facts(left, right, arguments_total)
    else:
      if sub_call:
        subtract_facts(left, right, arguments_total)
      else:
        if mul_call:
          multiply_facts(left, right, arguments_total)
        else:
          if div_call:
            divide_facts(left, right, arguments_total, false)
          else:
            divide_facts(left, right, arguments_total, true)
  else:
    let to_byte: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.to_u8")
    if to_byte:
      let left: Fact = fact_at(facts, arguments)
      to_u8_fact(left, arguments_total)
    else:
      let checked: Bool = callee_is_checked_trap(source, tokens, callee)
      if checked:
        unknown(true, false)
      else:
        let builtin: Bool = typing.builtin_known(source, tokens, callee)
        let alloc: Bool = effects.call_requires(source, tokens, callee, 1)
        let io: Bool = effects.call_requires(source, tokens, callee, 2)
        let effectful: Bool = alloc || io
        let safe: Bool = builtin && (!effectful)
        let total: Bool = arguments_total && safe
        let u8_to_i64: Bool = syntax.ast_node_text_is(source, tokens, callee, "u8.to_i64")
        if u8_to_i64:
          bounded(true, 0, true, 255, total)
        else:
          unknown(true, total)

fn analyze_user_call_arguments(source: Bytes, inout tokens: Vec[syntax.Token], inout typed_facts: Vec[typing.Fact], inout facts: Vec[Fact], inout refinements: Vec[Refinement], parent: I64, parameter: I64, argument: I64, total: Bool) -> Summary effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, parameter)
  let done: Bool = kind == 1
  if done:
    Summary(total: total)
  else:
    let fact: Fact = analyze_expression(source, tokens, typed_facts, argument, facts, refinements, parent)
    let next_total: Bool = total && fact.total
    let next_parameter: I64 = syntax.ast_next(tokens, parameter)
    let last: Bool = syntax.ast_node_kind(tokens, next_parameter) == 1
    if last:
      Summary(total: next_total)
    else:
      let next_argument: I64 = syntax.ast_next(tokens, argument)
      recur(source, tokens, typed_facts, facts, refinements, parent, next_parameter, next_argument, next_total)

fn analyze_call(source: Bytes, inout tokens: Vec[syntax.Token], inout typed_facts: Vec[typing.Fact], inout facts: Vec[Fact], inout refinements: Vec[Refinement], parent: I64, expr: I64) -> Fact effects[alloc, partial]:
  let callee: I64 = syntax.ast_call_callee(expr)
  let arguments: I64 = syntax.ast_call_arguments(expr)
  let declaration: I64 = syntax.ast_node_link(tokens, callee)
  let user: Bool = declaration >= 0
  let summary: Summary = if user:
    let params: I64 = syntax.ast_function_parameters(declaration)
    let first_parameter: I64 = syntax.ast_parameters_first(params)
    analyze_user_call_arguments(source, tokens, typed_facts, facts, refinements, parent, first_parameter, arguments, true)
  else:
    analyze_forms(source, tokens, typed_facts, arguments, facts, refinements, parent, true)
  let fact: Fact = call_fact(source, tokens, facts, expr, callee, arguments, summary.total)
  set_fact(expr, fact, facts)

fn analyze_let(source: Bytes, inout tokens: Vec[syntax.Token], inout typed_facts: Vec[typing.Fact], inout facts: Vec[Fact], inout refinements: Vec[Refinement], parent: I64, expr: I64) -> Fact effects[alloc, partial]:
  let name: I64 = syntax.ast_let_name(expr)
  let type_index: I64 = syntax.ast_let_type(expr)
  let value: I64 = syntax.ast_let_value(tokens, expr)
  let body: I64 = syntax.ast_let_body(tokens, expr)
  let value_fact: Fact = analyze_expression(source, tokens, typed_facts, value, facts, refinements, parent)
  let binding: Fact = bounded(value_fact.lower_known, value_fact.lower, value_fact.upper_known, value_fact.upper, true)
  vec.set(facts, name, binding)
  let body_fact: Fact = analyze_expression(source, tokens, typed_facts, body, facts, refinements, parent)
  let total: Bool = value_fact.total && body_fact.total
  let fact: Fact = bounded(body_fact.lower_known, body_fact.lower, body_fact.upper_known, body_fact.upper, total)
  set_fact(expr, fact, facts)

fn last_child(inout tokens: Vec[syntax.Token], cursor: I64, previous: I64) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    previous
  else:
    let next: I64 = syntax.ast_next(tokens, cursor)
    recur(tokens, next, cursor)

fn invalid_constraint() -> Constraint:
  Constraint(valid: false, declaration: -1, true_kind: -1, true_bound: 0, false_kind: -1, false_bound: 0)

fn comparison_constraint(source: Bytes, inout tokens: Vec[syntax.Token], inout facts: Vec[Fact], expr: I64) -> Constraint effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, expr)
  let form: Bool = kind == 0
  if form:
    let call_form: Bool = syntax.ast_expression_is_call(source, tokens, expr)
    if call_form:
      let callee: I64 = syntax.ast_call_callee(expr)
      let left: I64 = syntax.ast_call_arguments(expr)
      let right: I64 = syntax.ast_next(tokens, left)
      let declaration: I64 = typing.linked_binding_declaration(tokens, left)
      let linked: Bool = declaration >= 0
      let right_fact: Fact = fact_at(facts, right)
      let exact_right: Bool = fact_exact(right_fact)
      let ready: Bool = linked && exact_right
      if ready:
        let bound: I64 = right_fact.lower
        let lt_call: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.lt")
        if lt_call:
          if bound > -1000000000:
            Constraint(valid: true, declaration: declaration, true_kind: 1, true_bound: bound - 1, false_kind: 0, false_bound: bound)
          else:
            invalid_constraint()
        else:
          let le_call: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.le")
          if le_call:
            if bound < 1000000000:
              Constraint(valid: true, declaration: declaration, true_kind: 1, true_bound: bound, false_kind: 0, false_bound: bound + 1)
            else:
              invalid_constraint()
          else:
            let gt_call: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.gt")
            if gt_call:
              if bound < 1000000000:
                Constraint(valid: true, declaration: declaration, true_kind: 0, true_bound: bound + 1, false_kind: 1, false_bound: bound)
              else:
                invalid_constraint()
            else:
              let ge_call: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.ge")
              if ge_call:
                if bound > -1000000000:
                  Constraint(valid: true, declaration: declaration, true_kind: 0, true_bound: bound, false_kind: 1, false_bound: bound - 1)
                else:
                  invalid_constraint()
              else:
                invalid_constraint()
      else:
        invalid_constraint()
    else:
      invalid_constraint()
  else:
    invalid_constraint()

fn refine_fact(base: Fact, kind: I64, bound: I64) -> Fact:
  let lower_refinement: Bool = kind == 0
  if lower_refinement:
    let had_lower: Bool = base.lower_known
    let lower: I64 = if had_lower:
      maximum(base.lower, bound)
    else:
      bound
    bounded(true, lower, base.upper_known, base.upper, true)
  else:
    let upper_refinement: Bool = kind == 1
    if upper_refinement:
      let had_upper: Bool = base.upper_known
      let upper: I64 = if had_upper:
        minimum(base.upper, bound)
      else:
        bound
      bounded(base.lower_known, base.lower, true, upper, true)
    else:
      base

fn push_refinement(inout facts: Vec[Fact], inout refinements: Vec[Refinement], parent: I64, declaration: I64, kind: I64, bound: I64) -> I64 effects[alloc, partial]:
  let count: I64 = vec.len(refinements)
  let room: Bool = count < 64
  if room:
    let base_refined: Fact = lookup_refinement(refinements, parent, declaration)
    let has_refined: Bool = base_refined.analyzed
    let base: Fact = if has_refined:
      base_refined
    else:
      fact_at(facts, declaration)
    let next_fact: Fact = refine_fact(base, kind, bound)
    let refinement: Refinement = Refinement(declaration: declaration, fact: next_fact, parent: parent)
    vec.push(refinements, refinement)
    count
  else:
    parent

fn arm_parent(source: Bytes, inout tokens: Vec[syntax.Token], inout facts: Vec[Fact], inout refinements: Vec[Refinement], parent: I64, pattern: I64, constraint: Constraint) -> I64 effects[alloc, partial]:
  let valid: Bool = constraint.valid
  if valid:
    let true_pattern: Bool = syntax.ast_node_text_is(source, tokens, pattern, "true")
    let false_pattern: Bool = syntax.ast_node_text_is(source, tokens, pattern, "false")
    let applicable: Bool = true_pattern || false_pattern
    if applicable:
      let refinement_kind: I64 = if true_pattern:
        constraint.true_kind
      else:
        constraint.false_kind
      let refinement_bound: I64 = if true_pattern:
        constraint.true_bound
      else:
        constraint.false_bound
      push_refinement(facts, refinements, parent, constraint.declaration, refinement_kind, refinement_bound)
    else:
      parent
  else:
    parent

fn join_facts(left: Fact, right: Fact, total: Bool) -> Fact:
  let lower_known: Bool = left.lower_known && right.lower_known
  let lower: I64 = if lower_known:
    minimum(left.lower, right.lower)
  else:
    0
  let upper_known: Bool = left.upper_known && right.upper_known
  let upper: I64 = if upper_known:
    maximum(left.upper, right.upper)
  else:
    0
  bounded(lower_known, lower, upper_known, upper, total)

fn analyze_arms(source: Bytes, inout tokens: Vec[syntax.Token], inout typed_facts: Vec[typing.Fact], cursor: I64, inout facts: Vec[Fact], inout refinements: Vec[Refinement], parent: I64, constraint: Constraint, summary: ArmSummary) -> ArmSummary effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    summary
  else:
    let pattern: I64 = syntax.ast_arm_pattern(cursor)
    let first: I64 = syntax.ast_arm_pattern(cursor)
    let body: I64 = last_child(tokens, first, first)
    let scoped_parent: I64 = arm_parent(source, tokens, facts, refinements, parent, pattern, constraint)
    let body_fact: Fact = analyze_expression(source, tokens, typed_facts, body, facts, refinements, scoped_parent)
    let next_fact: Fact = if summary.present:
      let prior: Fact = summary.fact
      let both_total: Bool = prior.total && body_fact.total
      join_facts(prior, body_fact, both_total)
    else:
      body_fact
    let next_summary: ArmSummary = ArmSummary(present: true, fact: next_fact)
    let next: I64 = syntax.ast_next(tokens, cursor)
    recur(source, tokens, typed_facts, next, facts, refinements, parent, constraint, next_summary)

fn analyze_match(source: Bytes, inout tokens: Vec[syntax.Token], inout typed_facts: Vec[typing.Fact], inout facts: Vec[Fact], inout refinements: Vec[Refinement], parent: I64, expr: I64) -> Fact effects[alloc, partial]:
  let value: I64 = syntax.ast_match_value(expr)
  let value_fact: Fact = analyze_expression(source, tokens, typed_facts, value, facts, refinements, parent)
  let constraint: Constraint = comparison_constraint(source, tokens, facts, value)
  let first_arm: I64 = syntax.ast_match_arms(tokens, expr)
  let initial: Fact = unknown(true, true)
  let initial_summary: ArmSummary = ArmSummary(present: false, fact: initial)
  let summary: ArmSummary = analyze_arms(source, tokens, typed_facts, first_arm, facts, refinements, parent, constraint, initial_summary)
  let arms_fact: Fact = summary.fact
  let total: Bool = value_fact.total && arms_fact.total
  let fact: Fact = bounded(arms_fact.lower_known, arms_fact.lower, arms_fact.upper_known, arms_fact.upper, total)
  set_fact(expr, fact, facts)

fn analyze_set(source: Bytes, inout tokens: Vec[syntax.Token], inout typed_facts: Vec[typing.Fact], inout facts: Vec[Fact], inout refinements: Vec[Refinement], parent: I64, expr: I64) -> Fact effects[alloc, partial]:
  let value: I64 = syntax.ast_set_value(expr)
  let body: I64 = syntax.ast_set_body(tokens, expr)
  let value_fact: Fact = analyze_expression(source, tokens, typed_facts, value, facts, refinements, parent)
  let body_fact: Fact = analyze_expression(source, tokens, typed_facts, body, facts, refinements, parent)
  let total: Bool = value_fact.total && body_fact.total
  let fact: Fact = bounded(body_fact.lower_known, body_fact.lower, body_fact.upper_known, body_fact.upper, total)
  set_fact(expr, fact, facts)

fn analyze_data(source: Bytes, inout tokens: Vec[syntax.Token], inout typed_facts: Vec[typing.Fact], inout facts: Vec[Fact], inout refinements: Vec[Refinement], parent: I64, expr: I64) -> Fact effects[alloc, partial]:
  let make_form: Bool = syntax.ast_expression_is_make(source, tokens, expr)
  let summary: Summary = if make_form:
    analyze_fields(source, tokens, typed_facts, syntax.ast_make_fields(expr), facts, refinements, parent, true)
  else:
    let get_form: Bool = syntax.ast_expression_is_get(source, tokens, expr)
    if get_form:
      let value: I64 = syntax.ast_get_value(expr)
      let fact: Fact = analyze_expression(source, tokens, typed_facts, value, facts, refinements, parent)
      Summary(total: fact.total)
    else:
      let case_form: Bool = syntax.ast_expression_is_case(source, tokens, expr)
      let first: I64 = if case_form:
        syntax.ast_case_payload(tokens, expr)
      else:
        syntax.ast_fork_body(expr)
      analyze_forms(source, tokens, typed_facts, first, facts, refinements, parent, true)
  set_fact(expr, unknown(true, summary.total), facts)

fn analyze_expression(source: Bytes, inout tokens: Vec[syntax.Token], inout typed_facts: Vec[typing.Fact], expr: I64, inout facts: Vec[Fact], inout refinements: Vec[Refinement], parent: I64) -> Fact effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, expr)
  let form: Bool = kind == 0
  if form:
    let let_form: Bool = syntax.ast_expression_is_let(source, tokens, expr)
    if let_form:
      analyze_let(source, tokens, typed_facts, facts, refinements, parent, expr)
    else:
      let call_form: Bool = syntax.ast_expression_is_call(source, tokens, expr)
      if call_form:
        analyze_call(source, tokens, typed_facts, facts, refinements, parent, expr)
      else:
        let match_form: Bool = syntax.ast_expression_is_match(source, tokens, expr)
        if match_form:
          analyze_match(source, tokens, typed_facts, facts, refinements, parent, expr)
        else:
          let set_form: Bool = syntax.ast_expression_is_set(source, tokens, expr)
          if set_form:
            analyze_set(source, tokens, typed_facts, facts, refinements, parent, expr)
          else:
            let recur_form: Bool = syntax.ast_expression_is_recur(source, tokens, expr)
            if recur_form:
              let summary: Summary = analyze_forms(source, tokens, typed_facts, syntax.ast_recur_arguments(expr), facts, refinements, parent, true)
              set_fact(expr, unknown(true, false), facts)
            else:
              analyze_data(source, tokens, typed_facts, facts, refinements, parent, expr)
  else:
    expression_atom(source, tokens, typed_facts, facts, refinements, parent, expr)

fn boolean_arm_body(source: Bytes, inout tokens: Vec[syntax.Token], cursor: I64, pattern: Bytes) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    -1
  else:
    let pattern_token: I64 = syntax.ast_arm_pattern(cursor)
    let same: Bool = syntax.ast_node_text_is(source, tokens, pattern_token, pattern)
    if same:
      last_child(tokens, pattern_token, pattern_token)
    else:
      let next: I64 = syntax.ast_next(tokens, cursor)
      recur(source, tokens, next, pattern)

fn tail_expression(source: Bytes, inout tokens: Vec[syntax.Token], expr: I64) -> I64 effects[partial]:
  let let_form: Bool = syntax.ast_expression_is_let(source, tokens, expr)
  if let_form:
    recur(source, tokens, syntax.ast_let_body(tokens, expr))
  else:
    expr

fn prefix_total_to_tail(source: Bytes, inout tokens: Vec[syntax.Token], inout facts: Vec[Fact], expr: I64, tail: I64) -> Bool effects[partial]:
  let done: Bool = expr == tail
  if done:
    true
  else:
    let let_form: Bool = syntax.ast_expression_is_let(source, tokens, expr)
    if let_form:
      let value: I64 = syntax.ast_let_value(tokens, expr)
      let body: I64 = syntax.ast_let_body(tokens, expr)
      let value_total: Bool = fact_total(facts, value)
      let rest_total: Bool = recur(source, tokens, facts, body, tail)
      value_total && rest_total
    else:
      false

fn forms_total(inout tokens: Vec[syntax.Token], inout facts: Vec[Fact], cursor: I64) -> Bool effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    true
  else:
    let current_total: Bool = fact_total(facts, cursor)
    let next: I64 = syntax.ast_next(tokens, cursor)
    let rest_total: Bool = recur(tokens, facts, next)
    current_total && rest_total

fn parameter_position(source: Bytes, inout tokens: Vec[syntax.Token], cursor: I64, declaration: I64, position: I64) -> I64 effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    -1
  else:
    let head: I64 = syntax.ast_list_first(cursor)
    let borrowed: Bool = syntax.ast_binding_is_inout(source, tokens, cursor)
    let name: I64 = syntax.ast_binding_name(source, tokens, cursor)
    let same: Bool = name == declaration
    if same:
      position
    else:
      let next: I64 = syntax.ast_next(tokens, cursor)
      let next_position: I64 = position + 1
      recur(source, tokens, next, declaration, next_position)

fn form_at(inout tokens: Vec[syntax.Token], cursor: I64, position: I64) -> I64 effects[partial]:
  let done: Bool = position == 0
  if done:
    cursor
  else:
    let next: I64 = syntax.ast_next(tokens, cursor)
    let next_position: I64 = position - 1
    recur(tokens, next, next_position)

fn promote_total(inout facts: Vec[Fact], expr: I64) -> Fact effects[partial]:
  let prior: Fact = fact_at(facts, expr)
  let promoted: Fact = bounded(prior.lower_known, prior.lower, prior.upper_known, prior.upper, true)
  set_fact(expr, promoted, facts)

fn decreasing_controller(source: Bytes, inout tokens: Vec[syntax.Token], inout facts: Vec[Fact], params: I64, declaration: I64, recur_expr: I64) -> Descent effects[partial]:
  let first_param: I64 = syntax.ast_parameters_first(params)
  let position: I64 = parameter_position(source, tokens, first_param, declaration, 0)
  let found: Bool = position >= 0
  if found:
    let first_argument: I64 = syntax.ast_recur_arguments(recur_expr)
    let update: I64 = form_at(tokens, first_argument, position)
    let subtraction: Bool = syntax.ast_expression_is_call(source, tokens, update)
    let callee: I64 = syntax.ast_call_callee(update)
    let sub_call: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.sub")
    let left: I64 = syntax.ast_call_arguments(update)
    let right: I64 = syntax.ast_next(tokens, left)
    let linked: I64 = typing.linked_binding_declaration(tokens, left)
    let same_controller: Bool = linked == declaration
    let step: Fact = fact_at(facts, right)
    let exact_step: Bool = fact_exact(step)
    let positive_step: Bool = if exact_step:
      step.lower > 0
    else:
      false
    let update_total: Bool = fact_total(facts, update)
    let arguments_total: Bool = forms_total(tokens, facts, first_argument)
    let valid: Bool = subtraction && (sub_call && (same_controller && (positive_step && (update_total && arguments_total))))
    let step_value: I64 = if valid:
      step.lower
    else:
      0
    Descent(valid: valid, position: position, step: step_value)
  else:
    Descent(valid: false, position: -1, step: 0)

fn counted_update_valid(source: Bytes, inout tokens: Vec[syntax.Token], controller: I64, position: I64, recur_form: I64) -> Bool effects[partial]:
  let arguments: I64 = syntax.ast_recur_arguments(recur_form)
  let argument: I64 = form_at(tokens, arguments, position)
  let call_form: Bool = syntax.ast_expression_is_call(source, tokens, argument)
  let callee: I64 = syntax.ast_call_callee(argument)
  let addition: Bool = if call_form:
    syntax.ast_node_text_is(source, tokens, callee, "i64.add")
  else:
    false
  let left: I64 = syntax.ast_call_arguments(argument)
  let right: I64 = syntax.ast_next(tokens, left)
  let linked: I64 = if addition:
    typing.linked_binding_declaration(tokens, left)
  else:
    -1
  let same: Bool = linked == controller
  let parsed: Parsed = parse_literal(source, tokens, right)
  let one: Bool = if parsed.valid:
    parsed.value == 1
  else:
    false
  addition && (same && one)

fn scan_counted_recurrences(source: Bytes, inout tokens: Vec[syntax.Token], controller: I64, position: I64, cursor: I64, end: I64, count: I64) -> CountScan effects[partial]:
  let done: Bool = cursor >= end
  if done:
    CountScan(valid: true, count: count)
  else:
    let recur_form: Bool = syntax.ast_expression_is_recur(source, tokens, cursor)
    let fork_form: Bool = syntax.ast_expression_is_fork(source, tokens, cursor)
    let supported: Bool = !fork_form
    let valid: Bool = if recur_form:
      counted_update_valid(source, tokens, controller, position, cursor)
    else:
      supported
    if valid:
      let increment: I64 = if recur_form:
        1
      else:
        0
      let next_count: I64 = count + increment
      let next: I64 = syntax.ast_node_after(cursor)
      recur(source, tokens, controller, position, next, end, next_count)
    else:
      CountScan(valid: false, count: count)

fn mark_counted_updates(source: Bytes, inout tokens: Vec[syntax.Token], inout facts: Vec[Fact], position: I64, cursor: I64, end: I64) -> Void effects[partial]:
  let done: Bool = cursor >= end
  if done:
    void
  else:
    let recur_form: Bool = syntax.ast_expression_is_recur(source, tokens, cursor)
    if recur_form:
      let arguments: I64 = syntax.ast_recur_arguments(cursor)
      let update: I64 = form_at(tokens, arguments, position)
      let promoted: Fact = promote_total(facts, update)
      void
    else:
      void
    let next: I64 = syntax.ast_node_after(cursor)
    recur(source, tokens, facts, position, next, end)

fn counted_accumulator_update(source: Bytes, inout tokens: Vec[syntax.Token], inout facts: Vec[Fact], declaration: I64, position: I64, recur_form: I64) -> AccScan effects[partial]:
  let arguments: I64 = syntax.ast_recur_arguments(recur_form)
  let argument: I64 = form_at(tokens, arguments, position)
  let kind: I64 = syntax.ast_node_kind(tokens, argument)
  let atom: Bool = kind == 2
  if atom:
    let linked: I64 = typing.linked_binding_declaration(tokens, argument)
    let same: Bool = linked == declaration
    AccScan(valid: same, changed: false, maximum: 0)
  else:
    let call_form: Bool = syntax.ast_expression_is_call(source, tokens, argument)
    let callee: I64 = syntax.ast_call_callee(argument)
    let addition: Bool = if call_form:
      syntax.ast_node_text_is(source, tokens, callee, "i64.add")
    else:
      false
    let left: I64 = syntax.ast_call_arguments(argument)
    let right: I64 = syntax.ast_next(tokens, left)
    let linked: I64 = if addition:
      typing.linked_binding_declaration(tokens, left)
    else:
      -1
    let same: Bool = linked == declaration
    let delta: Fact = fact_at(facts, right)
    let known: Bool = delta.lower_known && delta.upper_known
    let total: Bool = delta.total
    let nonnegative: Bool = delta.lower >= 0
    let ordered: Bool = delta.lower <= delta.upper
    let small: Bool = delta.upper <= 16
    let valid: Bool = addition && (same && (known && (total && (nonnegative && (ordered && small)))))
    AccScan(valid: valid, changed: valid, maximum: delta.upper)

fn scan_counted_accumulator(source: Bytes, inout tokens: Vec[syntax.Token], inout facts: Vec[Fact], declaration: I64, position: I64, cursor: I64, end: I64, valid: Bool, changed: Bool, maximum: I64) -> AccScan effects[partial]:
  let done: Bool = cursor >= end
  if done:
    AccScan(valid: valid, changed: changed, maximum: maximum)
  else:
    let recur_form: Bool = syntax.ast_expression_is_recur(source, tokens, cursor)
    let update: AccScan = if recur_form:
      counted_accumulator_update(source, tokens, facts, declaration, position, cursor)
    else:
      AccScan(valid: true, changed: false, maximum: 0)
    let next_valid: Bool = valid && update.valid
    let next_changed: Bool = changed || update.changed
    let larger: Bool = update.maximum > maximum
    let next_maximum: I64 = if larger:
      update.maximum
    else:
      maximum
    let next: I64 = syntax.ast_node_after(cursor)
    recur(source, tokens, facts, declaration, position, next, end, next_valid, next_changed, next_maximum)

fn promote_counted_accumulators(source: Bytes, inout tokens: Vec[syntax.Token], inout facts: Vec[Fact], inout entry_facts: Vec[Fact], params: I64, cursor: I64, position: I64, controller: I64, iterations: I64, body: I64, end: I64) -> Void effects[partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let params_done: Bool = kind == 1
  let budget_done: Bool = position >= 16
  let done: Bool = params_done || budget_done
  if done:
    void
  else:
    let name: I64 = parameter_name(source, tokens, cursor)
    let type_index: I64 = syntax.ast_next(tokens, name)
    let integer: Bool = syntax.ast_node_text_is(source, tokens, type_index, "I64")
    let same_controller: Bool = name == controller
    let not_controller: Bool = !same_controller
    let entry: Fact = fact_at(entry_facts, name)
    let exact_entry: Bool = fact_exact(entry)
    let total_entry: Bool = entry.total
    let start: I64 = entry.lower
    let nonnegative: Bool = start >= 0
    let scan: AccScan = scan_counted_accumulator(source, tokens, facts, name, position, body, end, true, false, 0)
    let scan_valid: Bool = scan.valid && scan.changed
    let shape: Bool = integer && (not_controller && (exact_entry && (total_entry && (nonnegative && scan_valid))))
    let product: I64 = if shape:
      iterations * scan.maximum
    else:
      0
    let upper: I64 = if shape:
      start + product
    else:
      0
    let domain: Bool = if shape:
      in_domain(upper)
    else:
      false
    if domain:
      let fact: Fact = bounded(true, start, true, upper, true)
      let stored: Fact = set_fact(name, fact, facts)
      void
    else:
      void
    let next: I64 = syntax.ast_next(tokens, cursor)
    let next_position: I64 = position + 1
    recur(source, tokens, facts, entry_facts, params, next, next_position, controller, iterations, body, end)

fn prove_counted_recurrence(source: Bytes, inout tokens: Vec[syntax.Token], inout typed_facts: Vec[typing.Fact], inout facts: Vec[Fact], inout refinements: Vec[Refinement], inout entry_facts: Vec[Fact], params: I64, item: I64, body: I64, inout counted: Vec[Counted]) -> Bool effects[alloc, partial]:
  let match_form: Bool = syntax.ast_expression_is_match(source, tokens, body)
  if match_form:
    let condition: I64 = syntax.ast_match_value(body)
    let call_form: Bool = syntax.ast_expression_is_call(source, tokens, condition)
    let callee: I64 = syntax.ast_call_callee(condition)
    let equality: Bool = if call_form:
      syntax.ast_node_text_is(source, tokens, callee, "i64.eq")
    else:
      false
    let left: I64 = syntax.ast_call_arguments(condition)
    let right: I64 = syntax.ast_next(tokens, left)
    let controller: I64 = if equality:
      typing.linked_binding_declaration(tokens, left)
    else:
      -1
    let position: I64 = if controller >= 0:
      parameter_position(source, tokens, syntax.ast_parameters_first(params), controller, 0)
    else:
      -1
    let parsed_bound: Parsed = parse_literal(source, tokens, right)
    let literal_bound_known: Bool = parsed_bound.valid
    let bound_declaration: I64 = typing.linked_binding_declaration(tokens, right)
    let bound_fact: Fact = if bound_declaration >= 0:
      fact_at(entry_facts, bound_declaration)
    else:
      unknown(false, false)
    let parameter_bound_known: Bool = fact_exact(bound_fact)
    let bound_known: Bool = literal_bound_known || parameter_bound_known
    let bound: I64 = if literal_bound_known:
      parsed_bound.value
    else:
      if parameter_bound_known:
        bound_fact.lower
      else:
        -1
    let first_arm: I64 = syntax.ast_match_arms(tokens, body)
    let base: I64 = boolean_arm_body(source, tokens, first_arm, "true")
    let iterative: I64 = boolean_arm_body(source, tokens, first_arm, "false")
    let arms: Bool = (base >= 0) && (iterative >= 0)
    let shape: Bool = equality && ((position >= 0) && arms)
    let start_fact: Fact = if position >= 0:
      fact_at(entry_facts, controller)
    else:
      unknown(false, false)
    let start_known: Bool = fact_exact(start_fact)
    let start: I64 = if start_known:
      start_fact.lower
    else:
      -1
    let base_end: I64 = if arms:
      syntax.ast_next(tokens, base)
    else:
      base
    let iterative_end: I64 = if arms:
      syntax.ast_next(tokens, iterative)
    else:
      iterative
    let base_scan: CountScan = if shape:
      scan_counted_recurrences(source, tokens, controller, position, base, base_end, 0)
    else:
      CountScan(valid: false, count: 0)
    let iterative_scan: CountScan = if shape:
      scan_counted_recurrences(source, tokens, controller, position, iterative, iterative_end, 0)
    else:
      CountScan(valid: false, count: 0)
    let base_empty: Bool = base_scan.count == 0
    let iterative_present: Bool = iterative_scan.count > 0
    let scans_valid: Bool = base_scan.valid && (base_empty && (iterative_scan.valid && iterative_present))
    let nonnegative: Bool = (start >= 0) && (bound >= 0)
    let ordered: Bool = start <= bound
    let numeric: Bool = start_known && (bound_known && (nonnegative && ordered))
    let distance: I64 = if numeric:
      bound - start
    else:
      17
    let small: Bool = distance <= 16
    let within_domain: Bool = (start <= 1000000000) && (bound <= 1000000000)
    let condition_total: Bool = fact_total(facts, condition)
    let proven: Bool = shape && (scans_valid && (numeric && (within_domain && condition_total)))
    if proven:
      let controller_fact: Fact = bounded(true, start, true, bound, true)
      let iterative_upper: I64 = if distance > 0:
        bound - 1
      else:
        bound
      let iterative_fact: Fact = bounded(true, start, true, iterative_upper, true)
      let stored_iterative: Fact = set_fact(controller, iterative_fact, facts)
      mark_counted_updates(source, tokens, facts, position, iterative, iterative_end)
      let refined: Fact = analyze_expression(source, tokens, typed_facts, iterative, facts, refinements, -1)
      if small:
        promote_counted_accumulators(source, tokens, facts, entry_facts, params, syntax.ast_parameters_first(params), 0, controller, distance, iterative, iterative_end)
      else:
        void
      let refined_accumulators: Fact = analyze_expression(source, tokens, typed_facts, iterative, facts, refinements, -1)
      let restored_controller: Fact = set_fact(controller, controller_fact, facts)
      let fact: Counted = Counted(item: item, controller: controller, start: start, bound: bound, step: 1, iterations: distance, base: base, body: iterative)
      if small:
        vec.push(counted, fact)
      else:
        void
      true
    else:
      false
  else:
    false

fn find_counted(inout counted: Vec[Counted], item: I64, index: I64) -> I64 effects[partial]:
  let count: I64 = vec.len(counted)
  let done: Bool = index >= count
  if done:
    -1
  else:
    let fact: Counted = vec.get(counted, index)
    let same: Bool = fact.item == item
    if same:
      index
    else:
      let next: I64 = index + 1
      recur(counted, item, next)

fn prove_tail_recurrence(source: Bytes, inout tokens: Vec[syntax.Token], inout facts: Vec[Fact], params: I64, item: I64, body: I64, inout recurrences: Vec[Recurrence]) -> Bool effects[alloc, partial]:
  let match_form: Bool = syntax.ast_expression_is_match(source, tokens, body)
  if match_form:
    let condition: I64 = syntax.ast_match_value(body)
    let call_form: Bool = syntax.ast_expression_is_call(source, tokens, condition)
    let callee: I64 = syntax.ast_call_callee(condition)
    let bounded_below: Bool = syntax.ast_node_text_is(source, tokens, callee, "i64.le")
    let left: I64 = syntax.ast_call_arguments(condition)
    let right: I64 = syntax.ast_next(tokens, left)
    let declaration: I64 = typing.linked_binding_declaration(tokens, left)
    let parameter: Bool = declaration >= 0
    let bound: Fact = fact_at(facts, right)
    let exact_bound: Bool = fact_exact(bound)
    let first_arm: I64 = syntax.ast_match_arms(tokens, body)
    let true_body: I64 = boolean_arm_body(source, tokens, first_arm, "true")
    let false_body: I64 = boolean_arm_body(source, tokens, first_arm, "false")
    let arms_present: Bool = (true_body >= 0) && (false_body >= 0)
    let tail: I64 = if arms_present:
      tail_expression(source, tokens, false_body)
    else:
      -1
    let recur_form: Bool = if arms_present:
      syntax.ast_expression_is_recur(source, tokens, tail)
    else:
      false
    let condition_total: Bool = fact_total(facts, condition)
    let base_total: Bool = if arms_present:
      fact_total(facts, true_body)
    else:
      false
    let prefix_total: Bool = if arms_present:
      prefix_total_to_tail(source, tokens, facts, false_body, tail)
    else:
      false
    let descent: Descent = if recur_form:
      decreasing_controller(source, tokens, facts, params, declaration, tail)
    else:
      Descent(valid: false, position: -1, step: 0)
    let proven: Bool = match_form && (call_form && (bounded_below && (parameter && (exact_bound && (arms_present && (recur_form && (condition_total && (base_total && (prefix_total && descent.valid)))))))))
    if proven:
      let recurrence: Recurrence = Recurrence(item: item, position: descent.position, bound: bound.lower, step: descent.step)
      vec.push(recurrences, recurrence)
      let recur_total: Fact = promote_total(facts, tail)
      let body_total: Fact = promote_total(facts, body)
      true
    else:
      false
  else:
    false

fn analyze_function(source: Bytes, inout tokens: Vec[syntax.Token], inout typed_facts: Vec[typing.Fact], item: I64, inout facts: Vec[Fact], inout refinements: Vec[Refinement], inout recurrences: Vec[Recurrence], inout counted: Vec[Counted], inout parameter_facts: Vec[Fact], inout entry_facts: Vec[Fact]) -> Void effects[alloc, partial]:
  let params: I64 = syntax.ast_function_parameters(item)
  initialize_parameters(source, tokens, syntax.ast_parameters_first(params), facts, parameter_facts)
  let return_type: I64 = syntax.ast_function_return_type(tokens, item)
  let effects_form: I64 = syntax.ast_function_effects(tokens, item)
  let body: I64 = syntax.ast_next(tokens, effects_form)
  let analyzed: Fact = analyze_expression(source, tokens, typed_facts, body, facts, refinements, -1)
  let counted_proof: Bool = prove_counted_recurrence(source, tokens, typed_facts, facts, refinements, entry_facts, params, item, body, counted)
  let recurrence_total: Bool = if analyzed.total:
    true
  else:
    prove_tail_recurrence(source, tokens, facts, params, item, body, recurrences)
  void

fn analyze_functions(source: Bytes, inout tokens: Vec[syntax.Token], inout typed_facts: Vec[typing.Fact], cursor: I64, inout facts: Vec[Fact], inout refinements: Vec[Refinement], inout recurrences: Vec[Recurrence], inout counted: Vec[Counted], inout parameter_facts: Vec[Fact], inout entry_facts: Vec[Fact]) -> Void effects[alloc, partial]:
  let kind: I64 = syntax.ast_node_kind(tokens, cursor)
  let done: Bool = kind == 1
  if done:
    void
  else:
    let function_item: Bool = syntax.ast_item_is_function(source, tokens, cursor)
    if function_item:
      analyze_function(source, tokens, typed_facts, cursor, facts, refinements, recurrences, counted, parameter_facts, entry_facts)
    else:
      void
    let next: I64 = syntax.ast_next(tokens, cursor)
    recur(source, tokens, typed_facts, next, facts, refinements, recurrences, counted, parameter_facts, entry_facts)

fn analyze_pass(source: Bytes, inout tokens: Vec[syntax.Token], inout typed_facts: Vec[typing.Fact], inout invariants: Vec[Bool], inout entry_invariants: Vec[Bool], parameter_facts: Vec[Fact], entry_facts: Vec[Fact], pass: I64, limit: I64) -> View effects[alloc, partial]:
  let facts: Vec[Fact] = vec.new()
  let length: I64 = vec.len(tokens)
  initialize_facts(length, 0, facts)
  let refinements: Vec[Refinement] = vec.new()
  let recurrences: Vec[Recurrence] = vec.new()
  let counted: Vec[Counted] = vec.new()
  analyze_functions(source, tokens, typed_facts, 3, facts, refinements, recurrences, counted, parameter_facts, entry_facts)
  let done: Bool = pass >= limit
  if done:
    let refinement_count: I64 = vec.len(refinements)
    let refinement_limit: Bool = refinement_count >= 64
    View(facts: facts, refinements: refinement_count, refinements_truncated: refinement_limit, recurrences: recurrences, counted: counted)
  else:
    let next_parameters: Vec[Fact] = vec.new()
    initialize_facts(length, 0, next_parameters)
    let next_entry: Vec[Fact] = vec.new()
    initialize_facts(length, 0, next_entry)
    scan_parameter_calls(source, tokens, facts, invariants, 0, length, next_parameters)
    scan_parameter_calls(source, tokens, facts, entry_invariants, 0, length, next_entry)
    recur(source, tokens, typed_facts, invariants, entry_invariants, next_parameters, next_entry, pass + 1, limit)

fn analyze(source: Bytes, inout tokens: Vec[syntax.Token], inout typed_facts: Vec[typing.Fact]) -> View effects[alloc, partial]:
  let length: I64 = vec.len(tokens)
  let invariants: Vec[Bool] = vec.new()
  initialize_booleans(length, 0, false, invariants)
  collect_parameter_invariants(source, tokens, 3, invariants)
  let entry_invariants: Vec[Bool] = vec.new()
  initialize_booleans(length, 0, true, entry_invariants)
  let parameter_facts: Vec[Fact] = vec.new()
  initialize_facts(length, 0, parameter_facts)
  let entry_facts: Vec[Fact] = vec.new()
  initialize_facts(length, 0, entry_facts)
  analyze_pass(source, tokens, typed_facts, invariants, entry_invariants, parameter_facts, entry_facts, 0, 4)

fn find_recurrence(inout recurrences: Vec[Recurrence], item: I64, index: I64) -> I64 effects[partial]:
  let count: I64 = vec.len(recurrences)
  let done: Bool = index >= count
  if done:
    -1
  else:
    let recurrence: Recurrence = vec.get(recurrences, index)
    let same: Bool = recurrence.item == item
    if same:
      index
    else:
      let next: I64 = index + 1
      recur(recurrences, item, next)

fn recurrence_work(source: Bytes, inout tokens: Vec[syntax.Token], inout view: View, item: I64, arguments: I64) -> Work effects[partial]:
  let recurrences: Vec[Recurrence] = view.recurrences
  let index: I64 = find_recurrence(recurrences, item, 0)
  let found: Bool = index >= 0
  if found:
    let recurrence: Recurrence = vec.get(recurrences, index)
    let argument: I64 = form_at(tokens, arguments, recurrence.position)
    let parsed: Parsed = parse_literal(source, tokens, argument)
    let known: Bool = parsed.valid
    if known:
      let value: I64 = parsed.value
      let bound: I64 = recurrence.bound
      let done: Bool = value <= bound
      if done:
        Work(known: true, iterations: 0)
      else:
        let distance: I64 = value - bound
        let adjusted: I64 = distance + (recurrence.step - 1)
        let iterations: I64 = adjusted / recurrence.step
        Work(known: true, iterations: iterations)
    else:
      Work(known: false, iterations: 0)
  else:
    Work(known: false, iterations: 0)

fn append_i64(value: I64, inout output: Vec[U8]) -> Void effects[alloc, partial]:
  let negative: Bool = value < 0
  if negative:
    text.append_text(output, "-")
    let magnitude: I64 = 0 - value
    text.append_nonnegative_i64(magnitude, output)
  else:
    text.append_nonnegative_i64(value, output)

fn emit_bound(known: Bool, value: I64, inout output: Vec[U8]) -> Void effects[alloc, partial]:
  if known:
    append_i64(value, output)
  else:
    text.append_text(output, "unknown")

fn emit_site(expr: I64, fact: Fact, inout output: Vec[U8]) -> Void effects[alloc, partial]:
  text.append_text(output, " (checked-site ")
  append_i64(expr, output)
  if fact.total:
    text.append_text(output, " (status total) (lower ")
  else:
    text.append_text(output, " (status unknown) (lower ")
  emit_bound(fact.lower_known, fact.lower, output)
  text.append_text(output, ") (upper ")
  emit_bound(fact.upper_known, fact.upper, output)
  text.append_text(output, "))")

fn emit_sites(source: Bytes, inout tokens: Vec[syntax.Token], inout facts: Vec[Fact], index: I64, inout output: Vec[U8], count: I64, reported: I64) -> I64 effects[alloc, partial]:
  let length: I64 = vec.len(tokens)
  let done: Bool = index >= length
  if done:
    count
  else:
    let kind: I64 = syntax.ast_node_kind(tokens, index)
    let form: Bool = kind == 0
    let head: I64 = syntax.ast_list_first(index)
    let call_form: Bool = if form:
      syntax.ast_expression_is_call(source, tokens, index)
    else:
      false
    let callee: I64 = syntax.ast_call_callee(index)
    let checked: Bool = if call_form:
      callee_is_checked_trap(source, tokens, callee)
    else:
      false
    let next_count: I64 = if checked:
      count + 1
    else:
      count
    let room: Bool = reported < 64
    let emit: Bool = checked && room
    if emit:
      let fact: Fact = fact_at(facts, index)
      emit_site(index, fact, output)
    else:
      void
    let next_reported: I64 = if emit:
      reported + 1
    else:
      reported
    let next: I64 = index + 1
    recur(source, tokens, facts, next, output, next_count, next_reported)

fn emit_counted_fact(source: Bytes, inout tokens: Vec[syntax.Token], fact: Counted, inout output: Vec[U8]) -> Void effects[alloc, partial]:
  text.append_text(output, " (counted-loop ")
  append_i64(fact.item, output)
  text.append_text(output, " ")
  let name_index: I64 = fact.item + 2
  text.append_token(source, tokens, name_index, output)
  text.append_text(output, " (guarantee exact) (controller ")
  append_i64(fact.controller, output)
  text.append_text(output, ") (start ")
  append_i64(fact.start, output)
  text.append_text(output, ") (bound ")
  append_i64(fact.bound, output)
  text.append_text(output, ") (step ")
  append_i64(fact.step, output)
  text.append_text(output, ") (iterations ")
  append_i64(fact.iterations, output)
  text.append_text(output, ") (body ")
  append_i64(fact.body, output)
  text.append_text(output, ") (base ")
  append_i64(fact.base, output)
  text.append_text(output, "))")

fn emit_counted_facts(source: Bytes, inout tokens: Vec[syntax.Token], inout counted: Vec[Counted], index: I64, limit: I64, inout output: Vec[U8]) -> Void effects[alloc, partial]:
  let done: Bool = index >= limit
  if done:
    void
  else:
    let fact: Counted = vec.get(counted, index)
    emit_counted_fact(source, tokens, fact, output)
    let next: I64 = index + 1
    recur(source, tokens, counted, next, limit, output)

fn emit_counted_evidence(source: Bytes, inout tokens: Vec[syntax.Token], inout view: View, inout output: Vec[U8]) -> Void effects[alloc, partial]:
  let counted: Vec[Counted] = view.counted
  let count: I64 = vec.len(counted)
  let within_limit: Bool = count <= 64
  let limit: I64 = if within_limit:
    count
  else:
    64
  text.append_text(output, " (counted-loops (fact-limit 64) (facts")
  emit_counted_facts(source, tokens, counted, 0, limit, output)
  text.append_text(output, ") (counted-loop-count ")
  append_i64(count, output)
  text.append_text(output, ") (reported-facts ")
  append_i64(limit, output)
  text.append_text(output, ") (facts-truncated ")
  if within_limit:
    text.append_text(output, "false")
  else:
    text.append_text(output, "true")
  text.append_text(output, ") (guarantee ")
  if within_limit:
    text.append_text(output, "exact")
  else:
    text.append_text(output, "bounded")
  text.append_text(output, "))")

fn emit_module_facts(source: Bytes, inout tokens: Vec[syntax.Token], inout view: View, inout output: Vec[U8]) -> Void effects[alloc, partial]:
  let facts: Vec[Fact] = view.facts
  text.append_text(output, " (integer-proofs (domain -1000000000 1000000000) (refinement-limit 64) (parameter-pass-limit 4) (refinements ")
  append_i64(view.refinements, output)
  text.append_text(output, ") (refinements-truncated ")
  if view.refinements_truncated:
    text.append_text(output, "true")
  else:
    text.append_text(output, "false")
  text.append_text(output, ") (checked-site-report-limit 64) (checked-sites")
  let site_count: I64 = emit_sites(source, tokens, facts, 0, output, 0, 0)
  text.append_text(output, ") (checked-site-count ")
  append_i64(site_count, output)
  if site_count <= 64:
    text.append_text(output, ") (guarantee exact))")
  else:
    text.append_text(output, ") (guarantee bounded))")
  emit_counted_evidence(source, tokens, view, output)
  emit_resource_evidence(source, tokens, view, output)

