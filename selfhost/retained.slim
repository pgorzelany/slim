fn empty_input_queries() -> InputQueries effects[alloc]:
  let heads: Vec[I64] = vec.new()
  let entries: Vec[InputEntry] = vec.new()
  let keys: Vec[InputKey] = vec.new()
  let results: Vec[InputResult] = vec.new()
  InputQueries(heads: heads, entries: entries, keys: keys, results: results)

fn empty_input_history() -> InputHistory effects[alloc]:
  let slots: Vec[I64] = vec.new()
  let functions: Vec[InputFunction] = vec.new()
  let invariants: Vec[InputInvariant] = vec.new()
  let arguments: Vec[InputArgument] = vec.new()
  let queries: InputQueries = empty_input_queries()
  InputHistory(slots: slots, functions: functions, invariants: invariants, arguments: arguments, queries: queries, seal: 0)

fn input_seal_word(sum: I64, value: I64) -> I64 effects[partial]:
  let word: I64 = value % 1000000007
  ((sum * 97) + (word + 1000000007)) % 1000000007

fn input_seal_bool(sum: I64, value: Bool) -> I64 effects[partial]:
  let word: I64 = if value:
    1
  else:
    0
  input_seal_word(sum, word)

fn input_seal_owner(sum: I64, owner: identity.DeclarationId) -> I64 effects[partial]:
  let revision: I64 = input_seal_word(input_seal_word(sum, owner.file.revision.epoch), owner.file.revision.serial)
  input_seal_word(input_seal_word(revision, owner.file.slot), owner.slot)

fn input_seal_value(sum: I64, value: RangeValue) -> I64 effects[partial]:
  input_seal_word(input_seal_word(input_seal_word(sum, value.flags), value.lower), value.upper)

fn input_seal_indices(rows: Vec[I64], at: I64, sum: I64) -> I64 effects[partial]:
  if at >= vec.len(rows):
    sum
  else:
    recur(rows, at + 1, input_seal_word(sum, vec.get(rows, at)))

fn input_seal_invariants(rows: Vec[InputInvariant], at: I64, sum: I64) -> I64 effects[partial]:
  if at >= vec.len(rows):
    sum
  else:
    let row: InputInvariant = vec.get(rows, at)
    let sum_0: I64 = input_seal_word(sum, row.node)
    let sum_1: I64 = input_seal_bool(sum_0, row.invariant)
    recur(rows, at + 1, sum_1)

fn input_seal_arguments(rows: Vec[InputArgument], at: I64, sum: I64) -> I64 effects[partial]:
  if at >= vec.len(rows):
    sum
  else:
    let row: InputArgument = vec.get(rows, at)
    let sum_0: I64 = input_seal_owner(sum, row.callee)
    let sum_1: I64 = input_seal_word(sum_0, row.call)
    let sum_2: I64 = input_seal_word(sum_1, row.argument)
    let sum_3: I64 = input_seal_word(sum_2, row.parameter)
    recur(rows, at + 1, sum_3)

fn input_seal_functions(rows: Vec[InputFunction], at: I64, sum: I64) -> I64 effects[partial]:
  if at >= vec.len(rows):
    sum
  else:
    let row: InputFunction = vec.get(rows, at)
    let sum_0: I64 = input_seal_owner(sum, row.owner)
    let sum_1: I64 = input_seal_word(sum_0, row.nodes)
    let sum_2: I64 = input_seal_word(sum_1, row.source_bytes)
    let sum_3: I64 = input_seal_word(sum_2, row.invariant_start)
    let sum_4: I64 = input_seal_word(sum_3, row.invariant_count)
    let sum_5: I64 = input_seal_word(sum_4, row.argument_start)
    let sum_6: I64 = input_seal_word(sum_5, row.argument_count)
    recur(rows, at + 1, sum_6)

fn input_seal_keys(rows: Vec[InputKey], at: I64, sum: I64) -> I64 effects[partial]:
  if at >= vec.len(rows):
    sum
  else:
    let row: InputKey = vec.get(rows, at)
    let sum_0: I64 = input_seal_owner(sum, row.caller)
    let sum_1: I64 = input_seal_word(sum_0, row.call)
    let sum_2: I64 = input_seal_word(sum_1, row.argument)
    let sum_3: I64 = input_seal_word(sum_2, row.parameter)
    let sum_4: I64 = input_seal_value(sum_3, row.value)
    recur(rows, at + 1, sum_4)

fn input_seal_results(rows: Vec[InputResult], at: I64, sum: I64) -> I64 effects[partial]:
  if at >= vec.len(rows):
    sum
  else:
    let row: InputResult = vec.get(rows, at)
    let sum_0: I64 = input_seal_word(sum, row.parameter)
    let sum_1: I64 = input_seal_bool(sum_0, row.invariant)
    let sum_2: I64 = input_seal_value(sum_1, row.value)
    let sum_3: I64 = input_seal_value(sum_2, row.entry)
    recur(rows, at + 1, sum_3)

fn input_seal_entries(rows: Vec[InputEntry], at: I64, sum: I64) -> I64 effects[partial]:
  if at >= vec.len(rows):
    sum
  else:
    let row: InputEntry = vec.get(rows, at)
    let sum_0: I64 = input_seal_owner(sum, row.owner)
    let sum_1: I64 = input_seal_word(sum_0, row.key_start)
    let sum_2: I64 = input_seal_word(sum_1, row.key_count)
    let sum_3: I64 = input_seal_word(sum_2, row.result_start)
    let sum_4: I64 = input_seal_word(sum_3, row.result_count)
    let sum_5: I64 = input_seal_word(sum_4, row.next)
    recur(rows, at + 1, sum_5)

fn input_history_seal(history: InputHistory) -> I64 effects[partial]:
  let count_0: I64 = input_seal_word(142, vec.len(history.slots))
  let count_1: I64 = input_seal_word(count_0, vec.len(history.functions))
  let count_2: I64 = input_seal_word(count_1, vec.len(history.invariants))
  let count_3: I64 = input_seal_word(count_2, vec.len(history.arguments))
  let count_4: I64 = input_seal_word(count_3, vec.len(history.queries.heads))
  let count_5: I64 = input_seal_word(count_4, vec.len(history.queries.entries))
  let count_6: I64 = input_seal_word(count_5, vec.len(history.queries.keys))
  let count_7: I64 = input_seal_word(count_6, vec.len(history.queries.results))
  let slots: I64 = input_seal_indices(history.slots, 0, count_7)
  let functions: I64 = input_seal_functions(history.functions, 0, slots)
  let invariants: I64 = input_seal_invariants(history.invariants, 0, functions)
  let arguments: I64 = input_seal_arguments(history.arguments, 0, invariants)
  let heads: I64 = input_seal_indices(history.queries.heads, 0, arguments)
  let entries: I64 = input_seal_entries(history.queries.entries, 0, heads)
  let keys: I64 = input_seal_keys(history.queries.keys, 0, entries)
  input_seal_results(history.queries.results, 0, keys)

fn input_pool_bounds(history: InputHistory, declarations: I64) -> Bool effects[partial]:
  let functions: I64 = vec.len(history.functions)
  let invariants: I64 = vec.len(history.invariants)
  let arguments: I64 = vec.len(history.arguments)
  let entries: I64 = vec.len(history.queries.entries)
  let keys: I64 = vec.len(history.queries.keys)
  let results: I64 = vec.len(history.queries.results)
  let bounds: Bool = (functions <= 1000000) && ((invariants <= 1000000) && ((arguments <= 1000000) && ((entries <= 1000000) && ((keys <= 1000000) && (results <= 1000000)))))
  if bounds && ((vec.len(history.slots) == declarations) && (vec.len(history.queries.heads) == declarations)):
    (((((functions + invariants) + arguments) + entries) + keys) + results) <= 1000000
  else:
    false

fn input_function_frames(history: InputHistory, at: I64, invariants: I64, arguments: I64) -> Bool effects[partial]:
  if at >= vec.len(history.functions):
    (invariants == vec.len(history.invariants)) && (arguments == vec.len(history.arguments))
  else:
    let function: InputFunction = vec.get(history.functions, at)
    let starts: Bool = (function.invariant_start == invariants) && (function.argument_start == arguments)
    let slices: Bool = plan_slice_valid(invariants, function.invariant_count, vec.len(history.invariants)) && plan_slice_valid(arguments, function.argument_count, vec.len(history.arguments))
    if starts && slices:
      recur(history, at + 1, invariants + function.invariant_count, arguments + function.argument_count)
    else:
      false

fn input_query_frames(queries: InputQueries, at: I64, keys: I64, results: I64) -> Bool effects[partial]:
  if at >= vec.len(queries.entries):
    (keys == vec.len(queries.keys)) && (results == vec.len(queries.results))
  else:
    let entry: InputEntry = vec.get(queries.entries, at)
    let starts: Bool = (entry.key_start == keys) && (entry.result_start == results)
    let slices: Bool = plan_slice_valid(keys, entry.key_count, vec.len(queries.keys)) && plan_slice_valid(results, entry.result_count, vec.len(queries.results))
    let prior: Bool = (entry.next == -1) || ((entry.next >= 0) && (entry.next < at))
    if (starts && slices) && prior:
      recur(queries, at + 1, keys + entry.key_count, results + entry.result_count)
    else:
      false

fn input_query_chain(queries: InputQueries, owner: identity.DeclarationId, at: I64, remaining: I64, count: I64) -> I64 effects[partial]:
  if at == -1:
    count
  else:
    if (remaining > 0) && ((at >= 0) && (at < vec.len(queries.entries))):
      let entry: InputEntry = vec.get(queries.entries, at)
      let prior: Bool = (entry.next == -1) || ((entry.next >= 0) && (entry.next < at))
      if identity.same_declaration(entry.owner, owner) && prior:
        recur(queries, owner, entry.next, remaining - 1, count + 1)
      else:
        -1
    else:
      -1

fn input_query_heads(queries: InputQueries, index: Index, at: I64, count: I64) -> Bool effects[partial]:
  if at >= vec.len(index.declarations):
    count == vec.len(queries.entries)
  else:
    let declaration: Declaration = vec.get(index.declarations, at)
    let head: I64 = vec.get(queries.heads, at)
    if declaration.kind == 0:
      let visited: I64 = input_query_chain(queries, declaration.owner.declaration, head, 4, 0)
      if visited >= 0:
        recur(queries, index, at + 1, count + visited)
      else:
        false
    else:
      if head == -1:
        recur(queries, index, at + 1, count)
      else:
        false

fn input_function_slots(history: InputHistory, index: Index, at: I64, count: I64) -> Bool effects[partial]:
  if at >= vec.len(index.declarations):
    count == vec.len(history.functions)
  else:
    let declaration: Declaration = vec.get(index.declarations, at)
    let slot: I64 = vec.get(history.slots, at)
    if declaration.kind == 0:
      if (slot == count) && (slot < vec.len(history.functions)):
        let function: InputFunction = vec.get(history.functions, slot)
        let owner: Bool = identity.same_declaration(function.owner, declaration.owner.declaration)
        let extent: Bool = (function.nodes == declaration.owner.count) && (function.source_bytes == bytes.len(declaration.body))
        if owner && extent:
          recur(history, index, at + 1, count + 1)
        else:
          false
      else:
        false
    else:
      if slot == -1:
        recur(history, index, at + 1, count)
      else:
        false

fn input_frames_valid(history: InputHistory, index: Index) -> Bool effects[partial]:
  let declarations: I64 = vec.len(index.declarations)
  if (declarations <= 1000000) && input_pool_bounds(history, declarations):
    if input_function_frames(history, 0, 0, 0) && input_query_frames(history.queries, 0, 0, 0):
      input_function_slots(history, index, 0, 0) && input_query_heads(history.queries, index, 0, 0)
    else:
      false
  else:
    false

fn input_charge(budget: @Vec[RangeBudget], cost: I64) -> Bool effects[partial]:
  if vec.len(budget) == 1:
    let before: RangeBudget = vec.get(budget, 0)
    let fits: Bool = before.eligible && ((cost >= 0) && (cost <= before.remaining))
    let remaining: I64 = if fits:
      before.remaining - cost
    else:
      0
    vec.set(@budget, 0, RangeBudget(eligible: fits, remaining: remaining))
    fits
  else:
    false

fn input_admitted(budget: Vec[RangeBudget]) -> Bool effects[partial]:
  if vec.len(budget) == 1:
    let row: RangeBudget = vec.get(budget, 0)
    row.eligible
  else:
    false

fn input_parameter_rows(source: Bytes, tokens: Vec[syntax.Token], invariants: Vec[Bool], first: I64, cursor: I64, rows: @Vec[InputInvariant]) -> Void effects[alloc, partial]:
  if syntax.ast_node_kind(tokens, cursor) == 1:
    void
  else:
    let name: I64 = ranges.parameter_name(source, tokens, cursor)
    vec.push(@rows, InputInvariant(node: name - first, invariant: vec.get(invariants, name)))
    recur(source, tokens, invariants, first, syntax.ast_next(tokens, cursor), @rows)

fn input_argument_rows(source: Bytes, tokens: Vec[syntax.Token], current: Index, caller: Declaration, callee: Declaration, call: I64, parameter: I64, argument: I64, rows: @Vec[InputArgument], callers: @Vec[I64], budget: @Vec[RangeBudget]) -> Void effects[alloc, partial]:
  if syntax.ast_node_kind(tokens, parameter) == 1:
    void
  else:
    if input_charge(@budget, 1):
      let name: I64 = ranges.parameter_name(source, tokens, parameter)
      vec.push(@rows, InputArgument(callee: callee.owner.declaration, call: call - caller.owner.first, argument: argument - caller.owner.first, parameter: name - callee.owner.first))
      vec.push(@callers, caller.owner.declaration.slot)
      recur(source, tokens, current, caller, callee, call, syntax.ast_next(tokens, parameter), syntax.ast_next(tokens, argument), @rows, @callers, @budget)
    else:
      void

fn input_discover_calls(source: Bytes, tokens: Vec[syntax.Token], current: Index, caller: Declaration, cursor: I64, end: I64, rows: @Vec[InputArgument], callers: @Vec[I64], budget: @Vec[RangeBudget]) -> Void effects[alloc, partial]:
  if (cursor >= end) || (!input_admitted(budget)):
    void
  else:
    let target: I64 = ranges.parameter_call_target(source, tokens, cursor)
    if target >= 0:
      let callee_slot: I64 = vec.get(current.owners, target)
      let callee: Declaration = vec.get(current.declarations, callee_slot)
      let parameter: I64 = syntax.ast_parameters_first(syntax.ast_function_parameters(target))
      input_argument_rows(source, tokens, current, caller, callee, cursor, parameter, syntax.ast_call_arguments(cursor), @rows, @callers, @budget)
    else:
      void
    recur(source, tokens, current, caller, syntax.ast_node_after(cursor), end, @rows, @callers, @budget)

fn input_discover_functions(source: Bytes, tokens: Vec[syntax.Token], current: Index, previous: InputHistory, mapping: Update, callees: Vec[I64], old_callers: Vec[I64], reuse: Bool, at: I64, history: @InputHistory, invariants: @Vec[Bool], callers: @Vec[I64], budget: @Vec[RangeBudget]) -> Void effects[alloc, partial]:
  if (at >= vec.len(current.declarations)) || (!input_admitted(budget)):
    void
  else:
    let declaration: Declaration = vec.get(current.declarations, at)
    if declaration.kind == 0:
      let parameters: I64 = syntax.ast_parameters_first(syntax.ast_function_parameters(declaration.owner.first))
      let parameter_count: I64 = range_parameter_count(tokens, parameters, 0)
      let prior: I64 = if reuse:
        input_structure_previous(source, tokens, current, previous, mapping, callees, old_callers, at)
      else:
        -1
      let argument_cost: I64 = if prior >= 0:
        let function: InputFunction = vec.get(previous.functions, prior)
        function.argument_count
      else:
        0
      if input_charge(@budget, (parameter_count + 1) + argument_cost):
        let invariant_start: I64 = vec.len(history.invariants)
        let rows: Vec[InputInvariant] = mem.replace(@history.invariants, vec.new())
        if prior >= 0:
          let function: InputFunction = vec.get(previous.functions, prior)
          input_import_invariants(previous, function, declaration.owner.first, 0, @invariants, @rows)
        else:
          ranges.collect_function_invariants(source, tokens, declaration.owner.first, @invariants)
          input_parameter_rows(source, tokens, invariants, declaration.owner.first, parameters, @rows)
        let removed: Vec[InputInvariant] = mem.replace(@history.invariants, rows)
        let argument_start: I64 = vec.len(history.arguments)
        let rows: Vec[InputArgument] = mem.replace(@history.arguments, vec.new())
        if prior >= 0:
          let function: InputFunction = vec.get(previous.functions, prior)
          input_import_arguments(previous, function, current, callees, at, 0, @rows, @callers)
        else:
          input_discover_calls(source, tokens, current, declaration, declaration.owner.first, declaration.owner.first + declaration.owner.count, @rows, @callers, @budget)
        let argument_count: I64 = vec.len(rows) - argument_start
        let removed: Vec[InputArgument] = mem.replace(@history.arguments, rows)
        if input_admitted(budget):
          let slot: I64 = vec.len(history.functions)
          let rows: Vec[InputFunction] = mem.replace(@history.functions, vec.new())
          vec.push(@rows, InputFunction(owner: declaration.owner.declaration, nodes: declaration.owner.count, source_bytes: bytes.len(declaration.body), invariant_start: invariant_start, invariant_count: parameter_count, argument_start: argument_start, argument_count: argument_count))
          let removed: Vec[InputFunction] = mem.replace(@history.functions, rows)
          let slots: Vec[I64] = mem.replace(@history.slots, vec.new())
          vec.push(@slots, slot)
          let removed: Vec[I64] = mem.replace(@history.slots, slots)
          void
        else:
          void
      else:
        void
    else:
      let slots: Vec[I64] = mem.replace(@history.slots, vec.new())
      vec.push(@slots, -1)
      let removed: Vec[I64] = mem.replace(@history.slots, slots)
      void
    recur(source, tokens, current, previous, mapping, callees, old_callers, reuse, at + 1, @history, @invariants, @callers, @budget)

fn input_adjacency(arguments: Vec[InputArgument], remaining: I64, incoming: @Vec[I64], adjacency: @Vec[I64]) -> Void effects[partial]:
  if remaining <= 0:
    void
  else:
    let at: I64 = remaining - 1
    let argument: InputArgument = vec.get(arguments, at)
    let slot: I64 = argument.callee.slot
    let previous: I64 = vec.get(incoming, slot)
    vec.set(@adjacency, at, previous)
    vec.set(@incoming, slot, at)
    recur(arguments, at, @incoming, @adjacency)

fn input_same_bool(left: Bool, right: Bool) -> Bool:
  if left:
    right
  else:
    !right

fn input_result_keys_match(history: InputHistory, queries: InputQueries, function: InputFunction, entry: InputEntry, at: I64) -> Bool effects[partial]:
  if entry.result_count == function.invariant_count:
    if at >= function.invariant_count:
      true
    else:
      let invariant: InputInvariant = vec.get(history.invariants, function.invariant_start + at)
      let result: InputResult = vec.get(queries.results, entry.result_start + at)
      if (invariant.node == result.parameter) && input_same_bool(invariant.invariant, result.invariant):
        recur(history, queries, function, entry, at + 1)
      else:
        false
  else:
    false

fn input_contribution_keys_match(current: Index, history: InputHistory, queries: InputQueries, facts: Vec[ranges.Fact], callers: Vec[I64], adjacency: Vec[I64], entry: InputEntry, incoming: I64, at: I64) -> Bool effects[partial]:
  if incoming < 0:
    at == entry.key_count
  else:
    if at >= entry.key_count:
      false
    else:
      let argument: InputArgument = vec.get(history.arguments, incoming)
      let caller: Declaration = vec.get(current.declarations, vec.get(callers, incoming))
      let key: InputKey = vec.get(queries.keys, entry.key_start + at)
      let owner: Bool = identity.same_declaration(caller.owner.declaration, key.caller)
      let nodes: Bool = (key.call == argument.call) && ((key.argument == argument.argument) && (key.parameter == argument.parameter))
      let value: RangeValue = range_pack(ranges.fact_at(facts, caller.owner.first + argument.argument))
      if (owner && nodes) && range_value_equal(key.value, value):
        recur(current, history, queries, facts, callers, adjacency, entry, vec.get(adjacency, incoming), at + 1)
      else:
        false

fn input_find_queries(current: Index, history: InputHistory, queries: InputQueries, facts: Vec[ranges.Fact], callers: Vec[I64], adjacency: Vec[I64], function: InputFunction, incoming: I64, at: I64, remaining: I64, found: I64) -> I64 effects[partial]:
  if at == -1:
    found
  else:
    if (remaining > 0) && ((at >= 0) && (at < vec.len(queries.entries))):
      let entry: InputEntry = vec.get(queries.entries, at)
      let prior: Bool = (entry.next == -1) || ((entry.next >= 0) && (entry.next < at))
      if identity.same_declaration(entry.owner, function.owner) && prior:
        let matches: Bool = input_result_keys_match(history, queries, function, entry, 0) && input_contribution_keys_match(current, history, queries, facts, callers, adjacency, entry, incoming, 0)
        let selected: I64 = if (found < 0) && matches:
          at
        else:
          found
        recur(current, history, queries, facts, callers, adjacency, function, incoming, entry.next, remaining - 1, selected)
      else:
        -1
    else:
      -1

fn input_import_results(queries: InputQueries, entry: InputEntry, first: I64, at: I64, parameters: @Vec[ranges.Fact], entries: @Vec[ranges.Fact]) -> Void effects[partial]:
  if at >= entry.result_count:
    void
  else:
    let result: InputResult = vec.get(queries.results, entry.result_start + at)
    let node: I64 = first + result.parameter
    vec.set(@parameters, node, range_unpack(result.value))
    vec.set(@entries, node, range_unpack(result.entry))
    recur(queries, entry, first, at + 1, @parameters, @entries)

fn input_count_contributions(adjacency: Vec[I64], incoming: I64, count: I64) -> I64 effects[partial]:
  if incoming < 0:
    count
  else:
    recur(adjacency, vec.get(adjacency, incoming), count + 1)

fn input_save_keys(current: Index, arguments: Vec[InputArgument], facts: Vec[ranges.Fact], callers: Vec[I64], adjacency: Vec[I64], incoming: I64, keys: @Vec[InputKey]) -> Void effects[alloc, partial]:
  if incoming < 0:
    void
  else:
    let argument: InputArgument = vec.get(arguments, incoming)
    let caller: Declaration = vec.get(current.declarations, vec.get(callers, incoming))
    let value: RangeValue = range_pack(ranges.fact_at(facts, caller.owner.first + argument.argument))
    vec.push(@keys, InputKey(caller: caller.owner.declaration, call: argument.call, argument: argument.argument, parameter: argument.parameter, value: value))
    recur(current, arguments, facts, callers, adjacency, vec.get(adjacency, incoming), @keys)

fn input_save_results(invariants: Vec[InputInvariant], function: InputFunction, first: I64, parameters: Vec[ranges.Fact], entries: Vec[ranges.Fact], at: I64, results: @Vec[InputResult]) -> Void effects[alloc, partial]:
  if at >= function.invariant_count:
    void
  else:
    let invariant: InputInvariant = vec.get(invariants, function.invariant_start + at)
    let node: I64 = first + invariant.node
    vec.push(@results, InputResult(parameter: invariant.node, invariant: invariant.invariant, value: range_pack(ranges.fact_at(parameters, node)), entry: range_pack(ranges.fact_at(entries, node))))
    recur(invariants, function, first, parameters, entries, at + 1, @results)

fn input_save_current(current: Index, facts: Vec[ranges.Fact], callers: Vec[I64], adjacency: Vec[I64], function: InputFunction, incoming: I64, parameters: Vec[ranges.Fact], entries: Vec[ranges.Fact], history: @InputHistory, budget: @Vec[RangeBudget]) -> Void effects[alloc, partial]:
  let key_count: I64 = input_count_contributions(adjacency, incoming, 0)
  let cost: I64 = (1 + key_count) + function.invariant_count
  let head: I64 = vec.get(history.queries.heads, function.owner.slot)
  let versions: I64 = input_query_chain(history.queries, function.owner, head, 4, 0)
  let admitted: Bool = if (versions >= 0) && (versions < 4):
    input_charge(@budget, cost)
  else:
    input_charge(@budget, -1)
  if admitted:
    let declaration: Declaration = vec.get(current.declarations, function.owner.slot)
    let queries: InputQueries = mem.replace(@history.queries, empty_input_queries())
    let slot: I64 = vec.len(queries.entries)
    let previous: I64 = vec.get(queries.heads, function.owner.slot)
    let saved: InputEntry = InputEntry(owner: function.owner, key_start: vec.len(queries.keys), key_count: key_count, result_start: vec.len(queries.results), result_count: function.invariant_count, next: previous)
    let rows: Vec[InputKey] = mem.replace(@queries.keys, vec.new())
    input_save_keys(current, history.arguments, facts, callers, adjacency, incoming, @rows)
    let removed: Vec[InputKey] = mem.replace(@queries.keys, rows)
    let rows: Vec[InputResult] = mem.replace(@queries.results, vec.new())
    input_save_results(history.invariants, function, declaration.owner.first, parameters, entries, 0, @rows)
    let removed: Vec[InputResult] = mem.replace(@queries.results, rows)
    let rows: Vec[InputEntry] = mem.replace(@queries.entries, vec.new())
    vec.push(@rows, saved)
    let removed: Vec[InputEntry] = mem.replace(@queries.entries, rows)
    let heads: Vec[I64] = mem.replace(@queries.heads, vec.new())
    vec.set(@heads, function.owner.slot, slot)
    let removed: Vec[I64] = mem.replace(@queries.heads, heads)
    let removed: InputQueries = mem.replace(@history.queries, queries)
    void
  else:
    void

fn input_merge_current(current: Index, arguments: Vec[InputArgument], facts: Vec[ranges.Fact], callers: Vec[I64], adjacency: Vec[I64], invariants: Vec[Bool], incoming: I64, parameters: @Vec[ranges.Fact], entries: @Vec[ranges.Fact]) -> Void effects[partial]:
  if incoming < 0:
    void
  else:
    let row: InputArgument = vec.get(arguments, incoming)
    let caller: Declaration = vec.get(current.declarations, vec.get(callers, incoming))
    let callee: Declaration = vec.get(current.declarations, row.callee.slot)
    let argument: I64 = caller.owner.first + row.argument
    let parameter: I64 = callee.owner.first + row.parameter
    let candidate: ranges.Fact = ranges.fact_at(facts, argument)
    let invariant: Bool = vec.get(invariants, parameter)
    let value: ranges.Fact = ranges.merge_parameter_fact(ranges.fact_at(parameters, parameter), candidate, invariant)
    let entry: ranges.Fact = ranges.merge_parameter_fact(ranges.fact_at(entries, parameter), candidate, true)
    vec.set(@parameters, parameter, value)
    vec.set(@entries, parameter, entry)
    recur(current, arguments, facts, callers, adjacency, invariants, vec.get(adjacency, incoming), @parameters, @entries)

fn input_previous_head(current: InputQueries, previous: InputQueries, owner: identity.DeclarationId, head: I64) -> I64 effects[partial]:
  let used: I64 = input_query_chain(current, owner, head, 4, 0)
  if (used >= 0) && (used <= 4):
    let prior: I64 = vec.get(previous.heads, owner.slot)
    let count: I64 = input_query_chain(previous, owner, prior, 4 - used, 0)
    if count >= 0:
      prior
    else:
      -1
  else:
    -1

fn input_query_functions(current: Index, previous: InputQueries, facts: Vec[ranges.Fact], callers: Vec[I64], incoming: Vec[I64], adjacency: Vec[I64], invariants: Vec[Bool], at: I64, history: @InputHistory, budget: @Vec[RangeBudget], parameters: @Vec[ranges.Fact], entries: @Vec[ranges.Fact]) -> Void effects[alloc, partial]:
  if at >= vec.len(current.declarations):
    void
  else:
    let slot: I64 = vec.get(history.slots, at)
    let arguments: I64 = vec.get(incoming, at)
    # Complete empty adjacency leaves both previously cleared input arrays at
    # their exact defaults. There is no scalar merge or result worth retaining.
    if (slot >= 0) && (arguments >= 0):
      let function: InputFunction = vec.get(history.functions, slot)
      let declaration: Declaration = vec.get(current.declarations, at)
      let head: I64 = vec.get(history.queries.heads, at)
      let found: I64 = if input_admitted(budget):
        input_find_queries(current, history, history.queries, facts, callers, adjacency, function, arguments, head, 4, -1)
      else:
        -1
      if found >= 0:
        let entry: InputEntry = vec.get(history.queries.entries, found)
        input_import_results(history.queries, entry, declaration.owner.first, 0, @parameters, @entries)
      else:
        let prior: I64 = if input_admitted(budget) && (vec.len(previous.heads) == vec.len(current.declarations)):
          let prior_head: I64 = input_previous_head(history.queries, previous, function.owner, head)
          input_find_queries(current, history, previous, facts, callers, adjacency, function, arguments, prior_head, 4, -1)
        else:
          -1
        if prior >= 0:
          let entry: InputEntry = vec.get(previous.entries, prior)
          input_import_results(previous, entry, declaration.owner.first, 0, @parameters, @entries)
        else:
          input_merge_current(current, history.arguments, facts, callers, adjacency, invariants, arguments, @parameters, @entries)
        input_save_current(current, facts, callers, adjacency, function, arguments, parameters, entries, @history, @budget)
    else:
      void
    recur(current, previous, facts, callers, incoming, adjacency, invariants, at + 1, @history, @budget, @parameters, @entries)

fn input_transfer(source: Bytes, tokens: Vec[syntax.Token], facts: Vec[ranges.Fact], current: Index, state: @InputState, parameters: @Vec[ranges.Fact], entries: @Vec[ranges.Fact]) -> Void effects[alloc, partial]:
  range_clear_parameters(source, tokens, current.declarations, 0, @parameters, @entries)
  if input_admitted(state.budget):
    let history: InputHistory = mem.replace(@state.history, empty_input_history())
    let budget: Vec[RangeBudget] = mem.replace(@state.budget, vec.new())
    input_query_functions(current, state.previous, facts, state.callers, state.incoming, state.adjacency, state.invariants, 0, @history, @budget, @parameters, @entries)
    let removed: InputHistory = mem.replace(@state.history, history)
    let removed: Vec[RangeBudget] = mem.replace(@state.budget, budget)
    void
  else:
    let entry_invariants: Vec[Bool] = mem.replace(@state.entry_invariants, vec.new())
    if vec.len(entry_invariants) == 0:
      ranges.initialize_booleans(vec.len(tokens), 0, true, @entry_invariants)
    else:
      void
    ranges.scan_parameter_calls(source, tokens, facts, state.invariants, 0, vec.len(tokens), @parameters)
    ranges.scan_parameter_calls(source, tokens, facts, entry_invariants, 0, vec.len(tokens), @entries)
    let removed: Vec[Bool] = mem.replace(@state.entry_invariants, entry_invariants)
    void

fn input_owner_node(index: Index, owner: identity.DeclarationId, ordinal: I64) -> I64 effects[partial]:
  let slot: I64 = owner.slot
  if (slot >= 0) && (slot < vec.len(index.declarations)):
    let declaration: Declaration = vec.get(index.declarations, slot)
    let revision: Bool = identity.same_revision(owner.file.revision, index.revision)
    let same: Bool = identity.same_declaration(owner, declaration.owner.declaration)
    if ((owner.file.slot == 0) && (revision && same)) && (declaration.kind == 0):
      if identity.valid_view(declaration.owner, vec.len(index.owners)) && plan_node_valid(ordinal, declaration.owner.count):
        let node: I64 = declaration.owner.first + ordinal
        if vec.get(index.owners, node) == slot:
          node
        else:
          -1
      else:
        -1
    else:
      -1
  else:
    -1

fn input_argument_valid(old: Cache, caller: identity.DeclarationId, callee: identity.DeclarationId, call: I64, argument: I64, parameter: I64) -> Bool effects[partial]:
  let call_node: I64 = input_owner_node(old.index, caller, call)
  let argument_node: I64 = input_owner_node(old.index, caller, argument)
  let parameter_node: I64 = input_owner_node(old.index, callee, parameter)
  let callee_node: I64 = input_owner_node(old.index, callee, 0)
  if ((call_node >= 0) && (argument_node >= 0)) && ((parameter_node >= 0) && (callee_node >= 0)):
    let owner: Declaration = vec.get(old.index.declarations, caller.slot)
    if (owner.owner.count - call) > 2:
      let shape: Shape = vec.get(old.index.shapes, call_node)
      let argument_shape: Shape = vec.get(old.index.shapes, argument_node)
      let parameter_shape: Shape = vec.get(old.index.shapes, parameter_node)
      let target: Saved = vec.get(old.nodes, syntax.ast_call_callee(call_node))
      let call_shape: Bool = (shape.kind == 0) && (shape.tag == 10)
      let expression: Bool = (argument_shape.kind == 0) || ((argument_shape.kind >= 2) && (argument_shape.kind <= 4))
      let span: Bool = (shape.next > 0) && (shape.next <= (owner.owner.count - call))
      let inside: Bool = ((argument - call) >= 3) && ((argument - call) < shape.next)
      let link: Bool = valid_saved(target, caller) && (target.link.value == callee_node)
      (call_shape && expression) && ((parameter_shape.kind == 2) && ((span && inside) && link))
    else:
      false
  else:
    false

fn input_invariants_valid(old: Cache, history: InputHistory, function: InputFunction, at: I64, previous: I64) -> Bool effects[partial]:
  if at >= function.invariant_count:
    true
  else:
    let invariant: InputInvariant = vec.get(history.invariants, function.invariant_start + at)
    let node: I64 = input_owner_node(old.index, function.owner, invariant.node)
    if (node >= 0) && (invariant.node > previous):
      let shape: Shape = vec.get(old.index.shapes, node)
      if shape.kind == 2:
        recur(old, history, function, at + 1, invariant.node)
      else:
        false
    else:
      false

fn input_arguments_valid(old: Cache, history: InputHistory, function: InputFunction, at: I64, previous_call: I64, previous_argument: I64) -> Bool effects[partial]:
  if at >= function.argument_count:
    true
  else:
    let row: InputArgument = vec.get(history.arguments, function.argument_start + at)
    let order: Bool = (row.call > previous_call) || ((row.call == previous_call) && (row.argument > previous_argument))
    if order && input_argument_valid(old, function.owner, row.callee, row.call, row.argument, row.parameter):
      recur(old, history, function, at + 1, row.call, row.argument)
    else:
      false

fn input_structure_rows_valid(old: Cache, history: InputHistory, at: I64) -> Bool effects[partial]:
  if at >= vec.len(history.functions):
    true
  else:
    let function: InputFunction = vec.get(history.functions, at)
    if input_invariants_valid(old, history, function, 0, -1) && input_arguments_valid(old, history, function, 0, -1, -1):
      recur(old, history, at + 1)
    else:
      false

fn input_query_key_rows_valid(old: Cache, queries: InputQueries, entry: InputEntry, at: I64, previous_caller: I64, previous_call: I64, previous_argument: I64) -> Bool effects[partial]:
  if at >= entry.key_count:
    true
  else:
    let key: InputKey = vec.get(queries.keys, entry.key_start + at)
    let order: Bool = (key.caller.slot > previous_caller) || ((key.caller.slot == previous_caller) && ((key.call > previous_call) || ((key.call == previous_call) && (key.argument > previous_argument))))
    if (order && range_value_valid(key.value)) && input_argument_valid(old, key.caller, entry.owner, key.call, key.argument, key.parameter):
      recur(old, queries, entry, at + 1, key.caller.slot, key.call, key.argument)
    else:
      false

fn input_query_result_rows_valid(old: Cache, queries: InputQueries, entry: InputEntry, at: I64, previous: I64) -> Bool effects[partial]:
  if at >= entry.result_count:
    true
  else:
    let result: InputResult = vec.get(queries.results, entry.result_start + at)
    let node: I64 = input_owner_node(old.index, entry.owner, result.parameter)
    if ((node >= 0) && (result.parameter > previous)) && (range_value_valid(result.value) && range_value_valid(result.entry)):
      let shape: Shape = vec.get(old.index.shapes, node)
      if shape.kind == 2:
        recur(old, queries, entry, at + 1, result.parameter)
      else:
        false
    else:
      false

fn input_query_rows_valid(old: Cache, queries: InputQueries, at: I64) -> Bool effects[partial]:
  if at >= vec.len(queries.entries):
    true
  else:
    let entry: InputEntry = vec.get(queries.entries, at)
    if input_query_key_rows_valid(old, queries, entry, 0, -1, -1, -1) && input_query_result_rows_valid(old, queries, entry, 0, -1):
      recur(old, queries, at + 1)
    else:
      false

fn input_history_valid(history: InputHistory, old: Cache) -> Bool effects[partial]:
  let nodes: I64 = vec.len(old.nodes)
  if old.valid && (((nodes > 0) && (nodes <= 1000000)) && ((vec.len(old.index.owners) == nodes) && (vec.len(old.index.shapes) == nodes))):
    if input_frames_valid(history, old.index):
      if history.seal == input_history_seal(history):
        input_structure_rows_valid(old, history, 0) && input_query_rows_valid(old, history.queries, 0)
      else:
        false
    else:
      false
  else:
    false

fn input_seal_history(history: ^InputHistory) -> InputHistory effects[alloc, partial]:
  let seal: I64 = input_history_seal(history)
  let slots: Vec[I64] = mem.replace(@history.slots, vec.new())
  let functions: Vec[InputFunction] = mem.replace(@history.functions, vec.new())
  let invariants: Vec[InputInvariant] = mem.replace(@history.invariants, vec.new())
  let arguments: Vec[InputArgument] = mem.replace(@history.arguments, vec.new())
  let queries: InputQueries = mem.replace(@history.queries, empty_input_queries())
  InputHistory(slots: slots, functions: functions, invariants: invariants, arguments: arguments, queries: queries, seal: seal)

fn input_finish(state: ^InputState) -> InputHistory effects[alloc, partial]:
  if input_admitted(state.budget):
    let history: InputHistory = mem.replace(@state.history, empty_input_history())
    input_seal_history(^history)
  else:
    empty_input_history()

fn input_mapping_ready(old: Cache, current: Index, mapping: Update) -> Bool effects[partial]:
  let old_nodes: I64 = vec.len(old.index.owners)
  let nodes: I64 = vec.len(current.owners)
  let before: I64 = vec.len(old.index.declarations)
  let after: I64 = vec.len(current.declarations)
  let sizes: Bool = ((old_nodes > 0) && (old_nodes <= 1000000)) && ((nodes > 0) && (nodes <= 1000000))
  let owners: Bool = identity.same_revision(mapping.previous, old.index.revision) && identity.same_revision(mapping.current, current.revision)
  let valid: Bool = (old.index.revision.epoch > 0) && (old.index.revision.serial > 0)
  let newer: Bool = (old.index.revision.epoch == current.revision.epoch) && (old.index.revision.serial < current.revision.serial)
  let frames: Bool = ((vec.len(mapping.before) == after) && (vec.len(mapping.after) == before)) && (((vec.len(mapping.interfaces) == after) && (vec.len(mapping.bodies) == after)) && (vec.len(mapping.checked_imports) == after))
  let shapes: Bool = ((vec.len(old.nodes) == old_nodes) && (vec.len(old.index.shapes) == old_nodes)) && (vec.len(current.shapes) == nodes)
  (old.valid && sizes) && (((before <= old_nodes) && (after <= nodes)) && ((owners && valid) && ((newer && frames) && (shapes && equal(old.index.module, current.module)))))

fn input_mapped_function(old: Index, current: Index, mapping: Update, slot: I64) -> I64 effects[partial]:
  let target: I64 = vec.get(mapping.after, slot)
  if (target >= 0) && (target < vec.len(current.declarations)):
    let before: Declaration = vec.get(old.declarations, slot)
    let after: Declaration = vec.get(current.declarations, target)
    let paired: Bool = (vec.get(mapping.before, target) == slot) && (!vec.get(mapping.interfaces, target))
    let kind: Bool = (before.kind == 0) && (after.kind == 0)
    let views: Bool = identity.valid_view(before.owner, vec.len(old.owners)) && identity.valid_view(after.owner, vec.len(current.owners))
    let owners: Bool = ((before.owner.declaration.slot == slot) && (after.owner.declaration.slot == target)) && ((before.owner.declaration.file.slot == 0) && (after.owner.declaration.file.slot == 0))
    let revisions: Bool = identity.same_revision(before.owner.declaration.file.revision, old.revision) && identity.same_revision(after.owner.declaration.file.revision, current.revision)
    let prefix: Bool = ((before.prefix >= 0) && (before.prefix <= before.owner.count)) && ((after.prefix >= 0) && (after.prefix <= after.owner.count))
    if (paired && kind) && ((views && owners) && (revisions && prefix)):
      if ((before.prefix == after.prefix) && equal(before.name, after.name)) && equal(before.interface, after.interface):
        target
      else:
        -1
    else:
      -1
  else:
    -1

fn input_owner_maps(old: Index, current: Index, mapping: Update, at: I64, callees: @Vec[I64], callers: @Vec[I64]) -> Void effects[alloc, partial]:
  if at >= vec.len(old.declarations):
    void
  else:
    let target: I64 = input_mapped_function(old, current, mapping, at)
    let caller: I64 = if target >= 0:
      if vec.get(mapping.checked_imports, target) && (!vec.get(mapping.bodies, target)):
        target
      else:
        -1
    else:
      -1
    vec.push(@callees, target)
    vec.push(@callers, caller)
    recur(old, current, mapping, at + 1, @callees, @callers)

fn input_previous_key_owners(queries: InputQueries, entry: InputEntry, callers: Vec[I64], at: I64) -> Bool effects[partial]:
  if at >= entry.key_count:
    true
  else:
    let key: InputKey = vec.get(queries.keys, entry.key_start + at)
    if vec.get(callers, key.caller.slot) >= 0:
      recur(queries, entry, callers, at + 1)
    else:
      false

fn input_copy_previous_keys(queries: InputQueries, entry: InputEntry, current: Index, callers: Vec[I64], at: I64, keys: @Vec[InputKey]) -> Void effects[alloc, partial]:
  if at >= entry.key_count:
    void
  else:
    let key: InputKey = vec.get(queries.keys, entry.key_start + at)
    let declaration: Declaration = vec.get(current.declarations, vec.get(callers, key.caller.slot))
    vec.push(@keys, InputKey(caller: declaration.owner.declaration, call: key.call, argument: key.argument, parameter: key.parameter, value: key.value))
    recur(queries, entry, current, callers, at + 1, @keys)

fn input_copy_previous_results(queries: InputQueries, entry: InputEntry, at: I64, results: @Vec[InputResult]) -> Void effects[alloc, partial]:
  if at >= entry.result_count:
    void
  else:
    vec.push(@results, vec.get(queries.results, entry.result_start + at))
    recur(queries, entry, at + 1, @results)

fn input_copy_previous_entries(queries: InputQueries, current: Index, callees: Vec[I64], callers: Vec[I64], at: I64, heads: @Vec[I64], entries: @Vec[InputEntry], keys: @Vec[InputKey], results: @Vec[InputResult]) -> Void effects[alloc, partial]:
  if at >= vec.len(queries.entries):
    void
  else:
    let entry: InputEntry = vec.get(queries.entries, at)
    let target: I64 = vec.get(callees, entry.owner.slot)
    if (target >= 0) && input_previous_key_owners(queries, entry, callers, 0):
      let declaration: Declaration = vec.get(current.declarations, target)
      let next: I64 = vec.get(heads, target)
      let slot: I64 = vec.len(entries)
      let copied: InputEntry = InputEntry(owner: declaration.owner.declaration, key_start: vec.len(keys), key_count: entry.key_count, result_start: vec.len(results), result_count: entry.result_count, next: next)
      input_copy_previous_keys(queries, entry, current, callers, 0, @keys)
      input_copy_previous_results(queries, entry, 0, @results)
      vec.push(@entries, copied)
      vec.set(@heads, target, slot)
      void
    else:
      void
    recur(queries, current, callees, callers, at + 1, @heads, @entries, @keys, @results)

fn input_copy_previous_mapped(queries: InputQueries, current: Index, callees: Vec[I64], callers: Vec[I64]) -> InputQueries effects[alloc, partial]:
  let heads: Vec[I64] = vec.new()
  range_heads(vec.len(current.declarations), 0, @heads)
  let entries: Vec[InputEntry] = vec.new()
  let keys: Vec[InputKey] = vec.new()
  let results: Vec[InputResult] = vec.new()
  input_copy_previous_entries(queries, current, callees, callers, 0, @heads, @entries, @keys, @results)
  InputQueries(heads: heads, entries: entries, keys: keys, results: results)

fn input_structure_parameters(source: Bytes, tokens: Vec[syntax.Token], previous: InputHistory, function: InputFunction, first: I64, parameter: I64, at: I64) -> Bool effects[partial]:
  if syntax.ast_node_kind(tokens, parameter) == 1:
    at == function.invariant_count
  else:
    if at >= function.invariant_count:
      false
    else:
      let row: InputInvariant = vec.get(previous.invariants, function.invariant_start + at)
      if row.node == (ranges.parameter_name(source, tokens, parameter) - first):
        recur(source, tokens, previous, function, first, syntax.ast_next(tokens, parameter), at + 1)
      else:
        false

fn input_structure_arguments(source: Bytes, tokens: Vec[syntax.Token], previous: InputHistory, function: InputFunction, caller: Declaration, callee: Declaration, callees: Vec[I64], call: I64, parameter: I64, argument: I64, at: I64) -> I64 effects[partial]:
  if syntax.ast_node_kind(tokens, parameter) == 1:
    if syntax.ast_node_kind(tokens, argument) == 1:
      at
    else:
      -1
  else:
    if at >= function.argument_count:
      -1
    else:
      let row: InputArgument = vec.get(previous.arguments, function.argument_start + at)
      let owner: Bool = vec.get(callees, row.callee.slot) == callee.owner.declaration.slot
      let name: I64 = ranges.parameter_name(source, tokens, parameter)
      let ordinals: Bool = (row.call == call) && ((row.argument == (argument - caller.owner.first)) && (row.parameter == (name - callee.owner.first)))
      if owner && ordinals:
        recur(source, tokens, previous, function, caller, callee, callees, call, syntax.ast_next(tokens, parameter), syntax.ast_next(tokens, argument), at + 1)
      else:
        -1

fn input_structure_calls(source: Bytes, tokens: Vec[syntax.Token], current: Index, previous: InputHistory, function: InputFunction, caller: Declaration, callees: Vec[I64], at: I64) -> Bool effects[partial]:
  if at >= function.argument_count:
    true
  else:
    let row: InputArgument = vec.get(previous.arguments, function.argument_start + at)
    let call: I64 = caller.owner.first + row.call
    let target: I64 = ranges.parameter_call_target(source, tokens, call)
    if target >= 0:
      let callee: Declaration = vec.get(current.declarations, vec.get(current.owners, target))
      let parameters: I64 = syntax.ast_parameters_first(syntax.ast_function_parameters(target))
      let next: I64 = input_structure_arguments(source, tokens, previous, function, caller, callee, callees, row.call, parameters, syntax.ast_call_arguments(call), at)
      if (next > at) && (next <= function.argument_count):
        recur(source, tokens, current, previous, function, caller, callees, next)
      else:
        false
    else:
      false

fn input_structure_previous(source: Bytes, tokens: Vec[syntax.Token], current: Index, previous: InputHistory, mapping: Update, callees: Vec[I64], callers: Vec[I64], at: I64) -> I64 effects[partial]:
  let before: I64 = vec.get(mapping.before, at)
  if (before >= 0) && (before < vec.len(callers)):
    if vec.get(callers, before) == at:
      let slot: I64 = vec.get(previous.slots, before)
      if slot >= 0:
        let function: InputFunction = vec.get(previous.functions, slot)
        let declaration: Declaration = vec.get(current.declarations, at)
        let parameters: I64 = syntax.ast_parameters_first(syntax.ast_function_parameters(declaration.owner.first))
        let extent: Bool = (function.nodes == declaration.owner.count) && (function.source_bytes == bytes.len(declaration.body))
        if extent && input_structure_parameters(source, tokens, previous, function, declaration.owner.first, parameters, 0):
          if input_structure_calls(source, tokens, current, previous, function, declaration, callees, 0):
            slot
          else:
            -1
        else:
          -1
      else:
        -1
    else:
      -1
  else:
    -1

fn input_import_invariants(previous: InputHistory, function: InputFunction, first: I64, at: I64, invariants: @Vec[Bool], rows: @Vec[InputInvariant]) -> Void effects[alloc, partial]:
  if at >= function.invariant_count:
    void
  else:
    let row: InputInvariant = vec.get(previous.invariants, function.invariant_start + at)
    vec.push(@rows, row)
    vec.set(@invariants, first + row.node, row.invariant)
    recur(previous, function, first, at + 1, @invariants, @rows)

fn input_import_arguments(previous: InputHistory, function: InputFunction, current: Index, callees: Vec[I64], caller: I64, at: I64, rows: @Vec[InputArgument], callers: @Vec[I64]) -> Void effects[alloc, partial]:
  if at >= function.argument_count:
    void
  else:
    let row: InputArgument = vec.get(previous.arguments, function.argument_start + at)
    let callee: Declaration = vec.get(current.declarations, vec.get(callees, row.callee.slot))
    vec.push(@rows, InputArgument(callee: callee.owner.declaration, call: row.call, argument: row.argument, parameter: row.parameter))
    vec.push(@callers, caller)
    recur(previous, function, current, callees, caller, at + 1, @rows, @callers)

fn input_start_history(source: Bytes, tokens: Vec[syntax.Token], old: Cache, previous: InputHistory, current: Index, mapping: Update, use_previous: Bool, limit: I64) -> InputState effects[alloc, partial]:
  let budget: Vec[RangeBudget] = vec.new()
  vec.push(@budget, RangeBudget(eligible: (limit >= 1) && (limit <= 1000000), remaining: limit))
  let ready: Bool = if use_previous && input_admitted(budget):
    input_mapping_ready(old, current, mapping) && input_history_valid(previous, old)
  else:
    false
  let callees: Vec[I64] = vec.new()
  let old_callers: Vec[I64] = vec.new()
  if ready:
    input_owner_maps(old.index, current, mapping, 0, @callees, @old_callers)
  else:
    if use_previous:
      let declined: Bool = input_charge(@budget, -1)
      void
    else:
      void
  let history: InputHistory = empty_input_history()
  let callers: Vec[I64] = vec.new()
  let invariants: Vec[Bool] = vec.new()
  ranges.initialize_booleans(vec.len(tokens), 0, false, @invariants)
  # The retained path supplies the entry-mode invariant directly to the merge.
  # Materialize its full ordinary-scan mask only if a transfer falls back.
  let entry_invariants: Vec[Bool] = vec.new()
  input_discover_functions(source, tokens, current, previous, mapping, callees, old_callers, ready, 0, @history, @invariants, @callers, @budget)
  let incoming: Vec[I64] = vec.new()
  let adjacency: Vec[I64] = vec.new()
  let copied: InputQueries = if input_admitted(budget):
    range_heads(vec.len(current.declarations), 0, @incoming)
    range_heads(vec.len(history.arguments), 0, @adjacency)
    input_adjacency(history.arguments, vec.len(history.arguments), @incoming, @adjacency)
    let queries: InputQueries = mem.replace(@history.queries, empty_input_queries())
    let heads: Vec[I64] = mem.replace(@queries.heads, vec.new())
    range_heads(vec.len(current.declarations), 0, @heads)
    let removed: Vec[I64] = mem.replace(@queries.heads, heads)
    let removed: InputQueries = mem.replace(@history.queries, queries)
    if ready:
      input_copy_previous_mapped(previous.queries, current, callees, old_callers)
    else:
      empty_input_queries()
  else:
    ranges.collect_parameter_invariants(source, tokens, 3, @invariants)
    empty_input_queries()
  InputState(history: history, previous: copied, incoming: incoming, adjacency: adjacency, callers: callers, invariants: invariants, entry_invariants: entry_invariants, budget: budget)

fn input_start(source: Bytes, tokens: Vec[syntax.Token], old: Cache, current: Index, mapping: Update, limit: I64) -> InputState effects[alloc, partial]:
  let count: I64 = vec.len(old.input_history)
  if old.valid && (count == 1):
    let previous: InputHistory = vec.get(old.input_history, 0)
    input_start_history(source, tokens, old, previous, current, mapping, true, limit)
  else:
    let previous: InputHistory = empty_input_history()
    let allowance: I64 = if old.valid && (count > 1):
      0
    else:
      limit
    input_start_history(source, tokens, old, previous, current, mapping, false, allowance)
