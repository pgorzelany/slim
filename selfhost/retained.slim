fn range_copy(old: RangeHistory, prior: RangeEntry, declaration: Declaration, at: I64, budget: RangeBudget, history: @RangeHistory) -> RangeBudget effects[alloc, partial]:
  let cost: I64 = ((((1 + prior.key_count) + prior.fact_count) + prior.refinement_count) + prior.recurrence_count) + prior.counted_count
  if budget.eligible && (cost <= budget.remaining):
    let entry: RangeEntry = RangeEntry(owner: declaration.owner.declaration, nodes: declaration.owner.count, source_bytes: bytes.len(declaration.body), prefix: prior.prefix, key_start: vec.len(history.keys), key_count: prior.key_count, fact_start: vec.len(history.facts), fact_count: prior.fact_count, refinement_start: vec.len(history.refinements), refinement_count: prior.refinement_count, recurrence_start: vec.len(history.recurrences), recurrence_count: prior.recurrence_count, counted_start: vec.len(history.counted), counted_count: prior.counted_count, next: vec.get(history.heads, at))
    let slot: I64 = vec.len(history.entries)
    let rows: Vec[RangeKey] = mem.replace(@history.keys, vec.new())
    range_copy_keys(old.keys, prior.key_start, prior.key_count, 0, @rows)
    let removed: Vec[RangeKey] = mem.replace(@history.keys, rows)
    let rows: Vec[RangeFact] = mem.replace(@history.facts, vec.new())
    range_copy_facts(old.facts, prior.fact_start, prior.fact_count, 0, @rows)
    let removed: Vec[RangeFact] = mem.replace(@history.facts, rows)
    let rows: Vec[RangeRefinement] = mem.replace(@history.refinements, vec.new())
    range_copy_refinements(old.refinements, prior.refinement_start, prior.refinement_count, 0, @rows)
    let removed: Vec[RangeRefinement] = mem.replace(@history.refinements, rows)
    let rows: Vec[ranges.Recurrence] = mem.replace(@history.recurrences, vec.new())
    range_copy_recurrences(old.recurrences, prior.recurrence_start, prior.recurrence_count, 0, @rows)
    let removed: Vec[ranges.Recurrence] = mem.replace(@history.recurrences, rows)
    let rows: Vec[ranges.Counted] = mem.replace(@history.counted, vec.new())
    range_copy_counted(old.counted, prior.counted_start, prior.counted_count, 0, @rows)
    let removed: Vec[ranges.Counted] = mem.replace(@history.counted, rows)
    let rows: Vec[RangeEntry] = mem.replace(@history.entries, vec.new())
    vec.push(@rows, entry)
    let removed: Vec[RangeEntry] = mem.replace(@history.entries, rows)
    let rows: Vec[I64] = mem.replace(@history.heads, vec.new())
    vec.set(@rows, at, slot)
    let removed: Vec[I64] = mem.replace(@history.heads, rows)
    RangeBudget(eligible: true, remaining: budget.remaining - cost)
  else:
    RangeBudget(eligible: false, remaining: 0)

fn range_heads(count: I64, at: I64, output: @Vec[I64]) -> Void effects[alloc, partial]:
  if at >= count:
    void
  else:
    vec.push(@output, -1)
    recur(count, at + 1, @output)

fn range_previous(source: Bytes, tokens: Vec[syntax.Token], old_declarations: Vec[Declaration], old_history: RangeHistory, current: Index, mapping: Update, at: I64, framed: Bool, prefix: I64, parameter_facts: Vec[ranges.Fact], entry_facts: Vec[ranges.Fact]) -> I64 effects[partial]:
  if framed && (!vec.get(mapping.bodies, at)):
    let previous: I64 = vec.get(mapping.before, at)
    if (previous >= 0) && (previous < vec.len(old_declarations)):
      let declaration: Declaration = vec.get(current.declarations, at)
      let prior: Declaration = vec.get(old_declarations, previous)
      let head: I64 = vec.get(old_history.heads, previous)
      range_find(source, tokens, old_history, prior.owner.declaration, declaration.owner, bytes.len(declaration.body), prefix, parameter_facts, entry_facts, head, 5, -1)
    else:
      -1
  else:
    -1

fn range_functions(source: Bytes, tokens: Vec[syntax.Token], typed_facts: Vec[typing.Fact], old_declarations: Vec[Declaration], old_history: RangeHistory, current: Index, mapping: Update, framed: Bool, at: I64, parameter_facts: Vec[ranges.Fact], entry_facts: Vec[ranges.Fact], facts: @Vec[ranges.Fact], refinements: @Vec[ranges.Refinement], recurrences: @Vec[ranges.Recurrence], counted: @Vec[ranges.Counted], budget: RangeBudget, history: @RangeHistory) -> RangeBudget effects[alloc, partial]:
  if at >= vec.len(current.declarations):
    budget
  else:
    let declaration: Declaration = vec.get(current.declarations, at)
    let next_budget: RangeBudget = if declaration.kind == 0:
      let prefix: I64 = vec.len(refinements)
      let recurrence_start: I64 = vec.len(recurrences)
      let counted_start: I64 = vec.len(counted)
      let head: I64 = vec.get(history.heads, at)
      let same: I64 = range_find(source, tokens, history, declaration.owner.declaration, declaration.owner, bytes.len(declaration.body), prefix, parameter_facts, entry_facts, head, 5, -1)
      if same >= 0:
        let entry: RangeEntry = vec.get(history.entries, same)
        range_import(history, entry, declaration.owner, @facts, @refinements, @recurrences, @counted)
        budget
      else:
        let previous: I64 = range_previous(source, tokens, old_declarations, old_history, current, mapping, at, framed, prefix, parameter_facts, entry_facts)
        if previous >= 0:
          let entry: RangeEntry = vec.get(old_history.entries, previous)
          range_import(old_history, entry, declaration.owner, @facts, @refinements, @recurrences, @counted)
          range_copy(old_history, entry, declaration, at, budget, @history)
        else:
          ranges.analyze_function(source, tokens, typed_facts, declaration.owner.first, @facts, @refinements, @recurrences, @counted, parameter_facts, entry_facts)
          range_save(source, tokens, declaration, at, parameter_facts, entry_facts, facts, refinements, recurrences, counted, prefix, recurrence_start, counted_start, budget, @history)
    else:
