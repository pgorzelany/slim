fn empty_update() -> Update effects[alloc]:
  let before: Vec[I64] = vec.new()
  let after: Vec[I64] = vec.new()
  let interfaces: Vec[Bool] = vec.new()
  let bodies: Vec[Bool] = vec.new()
  let invalid: identity.Revision = identity.Revision(epoch: 0, serial: 0)
  Update(checked_imports: vec.new(), previous: invalid, current: invalid, before: before, after: after, interfaces: interfaces, bodies: bodies)

fn empty_index() -> Index effects[alloc]:
  let declarations: Vec[Declaration] = vec.new()
  let owners: Vec[I64] = vec.new()
  let shapes: Vec[Shape] = vec.new()
  let names: Vec[syntax.NameNode] = vec.new()
  let edges: Vec[syntax.NameEdge] = vec.new()
  let revision: identity.Revision = identity.Revision(epoch: 0, serial: 0)
  Index(revision: revision, source: "", module: "", declarations: declarations, owners: owners, shapes: shapes, names: names, edges: edges)

fn empty_cache() -> Cache effects[alloc]:
  let index: Index = empty_index()
  let nodes: Vec[Saved] = vec.new()
  let planning: PlanCache = empty_plan_cache()
  let range_history: Vec[RangeHistory] = vec.new()
  Cache(valid: false, index: index, nodes: nodes, planning: planning, range_history: range_history, input_history: vec.new())

fn empty_plan_cache() -> PlanCache effects[alloc]:
  let entries: Vec[PlanEntry] = vec.new()
  let slots: Vec[I64] = vec.new()
  let values: Vec[PlanValue] = vec.new()
  let allocations: Vec[memory.AllocationPlan] = vec.new()
  let destructions: Vec[memory.DestructionPlan] = vec.new()
  PlanCache(entries: entries, slots: slots, values: values, allocations: allocations, destructions: destructions)

fn copy(source: Bytes, start: I64, end: I64) -> Bytes effects[alloc, partial]:
  let output: Vec[U8] = vec.new()
  text.append_span(source, start, end, @output)
  bytes.freeze(^output)

fn equal_from(left: Bytes, right: Bytes, at: I64) -> Bool effects[partial]:
  if at >= bytes.len(left):
    true
  else:
    if u8.to_i64(bytes.get(left, at)) == u8.to_i64(bytes.get(right, at)):
      recur(left, right, at + 1)
    else:
      false

fn equal(left: Bytes, right: Bytes) -> Bool effects[partial]:
  if bytes.len(left) == bytes.len(right):
    equal_from(left, right, 0)
  else:
    false

fn initialize_index(tokens: Vec[syntax.Token], at: I64, owners: @Vec[I64], shapes: @Vec[Shape]) -> Void effects[alloc, partial]:
  if at >= vec.len(tokens):
    void
  else:
    let token: syntax.Token = vec.get(tokens, at)
    vec.push(@owners, -1)
    vec.push(@shapes, Shape(kind: token.kind, tag: token.tag, next: token.next - at))
    recur(tokens, at + 1, @owners, @shapes)

fn mark_owner(at: I64, end: I64, owner: I64, owners: @Vec[I64]) -> Void effects[partial]:
  if at >= end:
    void
  else:
    vec.set(@owners, at, owner)
    recur(at + 1, end, owner, @owners)

fn index_declarations(source: Bytes, tokens: Vec[syntax.Token], declarations: Vec[ir.Declaration], revision: identity.Revision, at: I64, output: @Vec[Declaration], owners: @Vec[I64], names: @Vec[syntax.NameNode], edges: @Vec[syntax.NameEdge]) -> Void effects[alloc, partial]:
  if at >= vec.len(declarations):
    void
  else:
    let declaration: ir.Declaration = vec.get(declarations, at)
    let first: I64 = declaration.form
    let end: I64 = syntax.ast_next(tokens, first)
    let name_node: I64 = syntax.ast_item_name(first)
    let name: Bytes = copy(source, syntax.ast_node_start(tokens, name_node), syntax.ast_node_end(tokens, name_node))
    let function: Bool = syntax.ast_item_is_function(source, tokens, first)
    let prefix_end: I64 = if function:
      syntax.ast_function_body(tokens, first)
    else:
      end
    let kind: I64 = if function:
      0
    else:
      if syntax.ast_item_is_record(source, tokens, first):
        1
      else:
        2
    let start_byte: I64 = syntax.ast_node_start(tokens, first)
    let end_byte: I64 = syntax.ast_declaration_end(source, tokens, first)
    let prefix_byte: I64 = if function:
      syntax.ast_node_start(tokens, prefix_end)
    else:
      end_byte
    let file: identity.FileId = identity.FileId(revision: revision, slot: 0)
    let id: identity.DeclarationId = identity.DeclarationId(file: file, slot: at)
    let view: identity.View = identity.View(declaration: id, first: first, count: end - first)
    let body: Bytes = copy(source, start_byte, end_byte)
    let interface: Bytes = copy(source, start_byte, prefix_byte)
    vec.push(@output, Declaration(owner: view, name: name, kind: kind, body: body, interface: interface, prefix: prefix_end - first))
    mark_owner(first, end, at, @owners)
    let previous: I64 = syntax.insert_name_chars(name, 0, bytes.len(name), at, 0, @names, @edges)
    recur(source, tokens, declarations, revision, at + 1, @output, @owners, @names, @edges)

fn build_index(source: Bytes, tokens: Vec[syntax.Token], declarations: Vec[ir.Declaration], revision: identity.Revision) -> Index effects[alloc, partial]:
  let output: Vec[Declaration] = vec.new()
  let owners: Vec[I64] = vec.new()
  let shapes: Vec[Shape] = vec.new()
  let names: Vec[syntax.NameNode] = vec.new()
  let edges: Vec[syntax.NameEdge] = vec.new()
  let root: I64 = syntax.append_name_node(-1, @names)
  initialize_index(tokens, 0, @owners, @shapes)
  index_declarations(source, tokens, declarations, revision, 0, @output, @owners, @names, @edges)
  let name: I64 = syntax.ast_module_name(0)
  let module: Bytes = copy(source, syntax.ast_node_start(tokens, name), syntax.ast_node_end(tokens, name))
  Index(revision: revision, source: source, module: module, declarations: output, owners: owners, shapes: shapes, names: names, edges: edges)

fn node_ref(index: Index, node: I64) -> NodeRef effects[partial]:
  if (node < 0) || (node >= vec.len(index.owners)):
    NodeRef::Missing()
  else:
    let owner: I64 = vec.get(index.owners, node)
    if (owner < 0) || (owner >= vec.len(index.declarations)):
      NodeRef::Missing()
    else:
      let declaration: Declaration = vec.get(index.declarations, owner)
      let same: Bool = identity.same_revision(index.revision, declaration.owner.declaration.file.revision)
      let slot: Bool = (declaration.owner.declaration.file.slot == 0) && (declaration.owner.declaration.slot == owner)
      let valid: Bool = identity.valid_view(declaration.owner, vec.len(index.owners)) && (same && slot)
      if valid && (node >= declaration.owner.first):
        let ordinal: I64 = node - declaration.owner.first
        if ordinal < declaration.owner.count:
          NodeRef::Found(identity.NodeId(declaration: declaration.owner.declaration, ordinal: ordinal))
        else:
          NodeRef::Missing()
      else:
        NodeRef::Missing()

fn valid_saved(saved: Saved, owner: identity.DeclarationId) -> Bool:
  identity.same_declaration(saved.owner, owner) && (((saved.tag >= 0) && (saved.tag <= 30)) && ((saved.tag % 8) <= 6))

fn saved_type(index: Index, saved: Saved) -> TypeId effects[partial]:
  TypeId(node: node_ref(index, saved.type.position))

fn saved_link(index: Index, saved: Saved) -> Link effects[partial]:
  if saved.tag >= 8:
    Link::Binding(BindingId(owner: saved.owner, slot: saved.link.value))
  else:
    capture_link(index, saved.link.value)

fn source_link(index: Index, node: I64) -> Link effects[partial]:
  match node_ref(index, node):
    Missing:
      Link::Invalid()
    Found(id):
      Link::Source(id)

fn capture_link(index: Index, link: I64) -> Link effects[partial]:
  let total: I64 = vec.len(index.owners)
  if (total < 1) || (total > 1000000):
    Link::Invalid()
  else:
    if link == -1:
      Link::Missing()
    else:
      if link >= 0:
        source_link(index, link)
      else:
        let base: I64 = total + 1
        let maximum: I64 = ((((total * 3) + 2) * base) + total) + 2
        if link < (0 - maximum):
          Link::Invalid()
        else:
          let packed: I64 = (0 - link) - 2
          let binding: I64 = packed % base
          let mode_type: I64 = packed / base
          let type: I64 = mode_type / 3
          match node_ref(index, binding):
            Missing:
              Link::Invalid()
            Found(id):
              if type == 0:
                Link::Local(LocalLink(binding: id, type: NodeRef::Missing(), mode: mode_type % 3))
              else:
                match node_ref(index, type):
                  Missing:
                    Link::Invalid()
                  Found(type_id):
                    Link::Local(LocalLink(binding: id, type: NodeRef::Found(type_id), mode: mode_type % 3))

fn prior_links(index: Index, tokens: Vec[syntax.Token], at: I64, output: @Vec[StoredLink]) -> Void effects[alloc, partial]:
  if at >= vec.len(tokens):
    void
  else:
    vec.push(@output, StoredLink(value: syntax.ast_node_link(tokens, at)))
    recur(index, tokens, at + 1, @output)

fn fill_missing(count: I64, output: @Vec[I64]) -> Void effects[alloc, partial]:
  if vec.len(output) >= count:
    void
  else:
    vec.push(@output, -1)
    recur(count, @output)

fn match_declarations(old: Cache, current: Index, eligible: Bool, at: I64, before: @Vec[I64], after: @Vec[I64]) -> Void effects[alloc, partial]:
  if at >= vec.len(current.declarations):
    void
  else:
    let declaration: Declaration = vec.get(current.declarations, at)
    let found: I64 = if eligible:
      syntax.lookup_name_chars(declaration.name, 0, bytes.len(declaration.name), 0, old.index.names, old.index.edges)
    else:
      -1
    let previous: I64 = if (found >= 0) && (found < vec.len(old.index.declarations)):
      let candidate: Declaration = vec.get(old.index.declarations, found)
      let valid_owner: Bool = identity.valid_view(candidate.owner, vec.len(old.index.owners)) && identity.same_revision(candidate.owner.declaration.file.revision, old.index.revision)
      let valid_prefix: Bool = (candidate.prefix >= 0) && (candidate.prefix <= candidate.owner.count)
      if (((candidate.kind == declaration.kind) && equal(candidate.name, declaration.name)) && (valid_owner && valid_prefix)) && ((candidate.owner.declaration.file.slot == 0) && (candidate.owner.declaration.slot == found)):
        found
      else:
        -1
    else:
      -1
    vec.push(@before, previous)
    if previous >= 0:
      vec.set(@after, previous, at)
    else:
      void
    recur(old, current, eligible, at + 1, @before, @after)

fn corresponding(old: Index, current: Index, after: Vec[I64], node: identity.NodeId) -> I64 effects[partial]:
  let slot: I64 = node.declaration.slot
  if (slot < 0) || (slot >= vec.len(old.declarations)):
    -2
  else:
    let previous: Declaration = vec.get(old.declarations, slot)
    match identity.resolve_node(previous.owner, node, vec.len(old.owners)):
      Invalid:
        -2
      Found(absolute):
        let target: I64 = vec.get(after, slot)
        if target < 0:
          -2
        else:
          let declaration: Declaration = vec.get(current.declarations, target)
          if node.ordinal < declaration.owner.count:
            declaration.owner.first + node.ordinal
          else:
            -2

fn corresponding_ref(old: Index, current: Index, after: Vec[I64], node: NodeRef) -> I64 effects[partial]:
  match node:
    Missing:
      -1
    Found(id):
      corresponding(old, current, after, id)

fn same_link(old: Index, current: Index, after: Vec[I64], before: Link, link: Link) -> Bool effects[partial]:
  match before:
    Missing:
      match link:
        Missing:
          true
        Source(id):
          false
        Binding(id):
          false
        Local(local):
          false
        Invalid:
          false
    Source(id):
      let mapped: I64 = corresponding(old, current, after, id)
      match link:
        Missing:
          false
        Source(target):
          let owner: Declaration = vec.get(current.declarations, target.declaration.slot)
          mapped == (owner.owner.first + target.ordinal)
        Binding(target):
          false
        Local(local):
          false
        Invalid:
          false
    Binding(id):
      false
    Local(local):
      match link:
        Missing:
          false
        Source(id):
          false
        Binding(id):
          false
        Local(target):
          let owner: Declaration = vec.get(current.declarations, target.binding.declaration.slot)
          let binding: I64 = corresponding(old, current, after, local.binding)
          let type: I64 = corresponding_ref(old, current, after, local.type)
          let target_type: I64 = match target.type:
            Missing:
              -1
            Found(id):
              let declaration: Declaration = vec.get(current.declarations, id.declaration.slot)
              declaration.owner.first + id.ordinal
          (binding == (owner.owner.first + target.binding.ordinal)) && ((type == target_type) && (local.mode == target.mode))
        Invalid:
          false
    Invalid:
      false

fn same_nodes(old: Cache, current: Index, prior: Vec[StoredLink], after: Vec[I64], first: I64, previous: I64, at: I64, count: I64) -> Bool effects[partial]:
  if at >= count:
    true
  else:
    let old_shape: Shape = vec.get(old.index.shapes, previous + at)
    let shape: Shape = vec.get(current.shapes, first + at)
    let saved: Saved = vec.get(old.nodes, previous + at)
    let owner: I64 = vec.get(old.index.owners, previous + at)
    if (owner < 0) || (owner >= vec.len(old.index.declarations)):
      false
    else:
      let declaration: Declaration = vec.get(old.index.declarations, owner)
      let shape_same: Bool = ((old_shape.kind == shape.kind) && (old_shape.tag == shape.tag)) && ((old_shape.next == shape.next) || ((old_shape.next > (count - at)) && (shape.next > (count - at))))
      if shape_same && valid_saved(saved, declaration.owner.declaration):
        let stored: StoredLink = vec.get(prior, first + at)
        let link: Link = capture_link(current, stored.value)
        let before: Link = capture_link(old.index, saved.prior.value)
        if same_link(old.index, current, after, before, link):
          recur(old, current, prior, after, first, previous, at + 1, count)
        else:
          false
      else:
        false

fn classify(old: Cache, current: Index, prior: Vec[StoredLink], before: Vec[I64], after: Vec[I64], at: I64, interfaces: @Vec[Bool], bodies: @Vec[Bool], queue: @Vec[I64]) -> Void effects[alloc, partial]:
  if at >= vec.len(current.declarations):
    void
  else:
    let declaration: Declaration = vec.get(current.declarations, at)
    let previous: I64 = vec.get(before, at)
    let interface_same: Bool = if previous >= 0:
      let candidate: Declaration = vec.get(old.index.declarations, previous)
      if (candidate.prefix == declaration.prefix) && equal(candidate.interface, declaration.interface):
        same_nodes(old, current, prior, after, declaration.owner.first, candidate.owner.first, 0, declaration.prefix)
      else:
        false
    else:
      false
    let body_same: Bool = if interface_same:
      let candidate: Declaration = vec.get(old.index.declarations, previous)
      if (candidate.owner.count == declaration.owner.count) && equal(candidate.body, declaration.body):
        same_nodes(old, current, prior, after, declaration.owner.first, candidate.owner.first, declaration.prefix, declaration.owner.count)
      else:
        false
    else:
      false
    vec.push(@interfaces, !interface_same)
    vec.push(@bodies, !body_same)
    if !interface_same:
      vec.push(@queue, at)
    else:
      void
    recur(old, current, prior, before, after, at + 1, @interfaces, @bodies, @queue)

fn append_edge(current: Index, consumer: I64, at: I64, target: identity.NodeId, heads: @Vec[I64], edges: @Vec[Edge]) -> Void effects[alloc, partial]:
  let provider: I64 = target.declaration.slot
  if provider == consumer:
    void
  else:
    let declaration: Declaration = vec.get(current.declarations, consumer)
    let interface: Bool = at < (declaration.owner.first + declaration.prefix)
    let previous: I64 = vec.get(heads, provider)
    let next: I64 = vec.len(edges)
    vec.push(@edges, Edge(consumer: consumer, interface: interface, next: previous))
    vec.set(@heads, provider, next)

fn dependencies(current: Index, prior: Vec[StoredLink], at: I64, heads: @Vec[I64], edges: @Vec[Edge]) -> Void effects[alloc, partial]:
  if at >= vec.len(prior):
    void
  else:
    let consumer: I64 = vec.get(current.owners, at)
    if consumer >= 0:
      let stored: StoredLink = vec.get(prior, at)
      match capture_link(current, stored.value):
        Missing:
          void
        Source(target):
          append_edge(current, consumer, at, target, @heads, @edges)
        Binding(id):
          void
        Local(local):
          match local.type:
            Missing:
              void
            Found(target):
              append_edge(current, consumer, at, target, @heads, @edges)
        Invalid:
          void
    else:
      void
    recur(current, prior, at + 1, @heads, @edges)

fn propagate_edges(edges: Vec[Edge], at: I64, interfaces: @Vec[Bool], bodies: @Vec[Bool], queue: @Vec[I64]) -> Void effects[alloc, partial]:
  if at < 0:
    void
  else:
    let edge: Edge = vec.get(edges, at)
    vec.set(@bodies, edge.consumer, true)
    if edge.interface && (!vec.get(interfaces, edge.consumer)):
      vec.set(@interfaces, edge.consumer, true)
      vec.push(@queue, edge.consumer)
    else:
      void
    recur(edges, edge.next, @interfaces, @bodies, @queue)

fn propagate(heads: Vec[I64], edges: Vec[Edge], at: I64, interfaces: @Vec[Bool], bodies: @Vec[Bool], queue: @Vec[I64]) -> Void effects[alloc, partial]:
  if at >= vec.len(queue):
    void
  else:
    let provider: I64 = vec.get(queue, at)
    propagate_edges(edges, vec.get(heads, provider), @interfaces, @bodies, @queue)
    recur(heads, edges, at + 1, @interfaces, @bodies, @queue)

fn update(old: Cache, current: Index, prior: Vec[StoredLink]) -> Update effects[alloc, partial]:
  let before: Vec[I64] = vec.new()
  let after: Vec[I64] = vec.new()
  fill_missing(vec.len(old.index.declarations), @after)
  let newer: Bool = identity.same_revision(current.revision, current.revision) && ((old.index.revision.epoch == current.revision.epoch) && (old.index.revision.serial < current.revision.serial))
  let complete: Bool = (vec.len(old.nodes) == vec.len(old.index.owners)) && ((vec.len(old.index.shapes) == vec.len(old.index.owners)) && (vec.len(old.index.names) > 0))
  let eligible: Bool = ((old.valid && newer) && complete) && equal(old.index.module, current.module)
  match_declarations(old, current, eligible, 0, @before, @after)
  let interfaces: Vec[Bool] = vec.new()
  let bodies: Vec[Bool] = vec.new()
  let queue: Vec[I64] = vec.new()
  classify(old, current, prior, before, after, 0, @interfaces, @bodies, @queue)
  let heads: Vec[I64] = vec.new()
  let edges: Vec[Edge] = vec.new()
  fill_missing(vec.len(current.declarations), @heads)
  dependencies(current, prior, 0, @heads, @edges)
  propagate(heads, edges, 0, @interfaces, @bodies, @queue)
  Update(checked_imports: vec.new(), previous: old.index.revision, current: current.revision, before: before, after: after, interfaces: interfaces, bodies: bodies)

fn relocate(old: Index, current: Index, mapping: Update, node: identity.NodeId) -> I64 effects[partial]:
  let absolute: I64 = corresponding(old, current, mapping.after, node)
  if absolute < 0:
    -2
  else:
    let target: I64 = vec.get(mapping.after, node.declaration.slot)
    let declaration: Declaration = vec.get(current.declarations, target)
    let body_safe: Bool = !vec.get(mapping.bodies, target)
    let interface_safe: Bool = (!vec.get(mapping.interfaces, target)) && (node.ordinal < declaration.prefix)
    if body_safe || interface_safe:
      absolute
    else:
      -2

fn relocate_ref(old: Index, current: Index, mapping: Update, node: NodeRef) -> I64 effects[partial]:
  match node:
    Missing:
      -1
    Found(id):
      relocate(old, current, mapping, id)

fn relocate_link(old: Index, current: Index, mapping: Update, owner: identity.DeclarationId, link: Link) -> I64 effects[partial]:
  match link:
    Missing:
      -1
    Source(node):
      relocate(old, current, mapping, node)
    Binding(id):
      if identity.same_declaration(id.owner, owner) && (id.slot >= 2):
        let declaration: Declaration = vec.get(old.declarations, owner.slot)
        if id.slot <= (declaration.owner.count + 2):
          id.slot
        else:
          -2
      else:
        -2
    Local(local):
      let binding: I64 = relocate(old, current, mapping, local.binding)
      let type: I64 = relocate_ref(old, current, mapping, local.type)
      if (binding >= 0) && ((type >= -1) && ((local.mode >= 0) && (local.mode <= 2))):
        let type_node: I64 = if type >= 0:
          type
        else:
          0
        let base: I64 = vec.len(current.owners) + 1
        0 - (((((type_node * 3) + local.mode) * base) + binding) + 2)
      else:
        -2
    Invalid:
      -2

fn import_valid(old: Cache, current: Index, mapping: Update, declaration: Declaration, at: I64) -> Bool effects[partial]:
  if at >= declaration.owner.count:
    true
  else:
    let saved: Saved = vec.get(old.nodes, declaration.owner.first + at)
    if valid_saved(saved, declaration.owner.declaration):
      let stored_type: TypeId = saved_type(old.index, saved)
      let type: I64 = relocate_ref(old.index, current, mapping, stored_type.node)
      let link: I64 = relocate_link(old.index, current, mapping, declaration.owner.declaration, saved_link(old.index, saved))
      if (type >= 0) && (!(link == -2)):
        recur(old, current, mapping, declaration, at + 1)
      else:
        false
    else:
      false

fn import_nodes(old: Cache, current: Index, mapping: Update, declaration: Declaration, first: I64, at: I64, tokens: @Vec[syntax.Token], facts: @Vec[typing.Fact]) -> Void effects[partial]:
  if at >= declaration.owner.count:
    void
  else:
    let saved: Saved = vec.get(old.nodes, declaration.owner.first + at)
    let stored_type: TypeId = saved_type(old.index, saved)
    let type: I64 = relocate_ref(old.index, current, mapping, stored_type.node)
    let link: I64 = relocate_link(old.index, current, mapping, declaration.owner.declaration, saved_link(old.index, saved))
    vec.set(@facts, first + at, typing.Fact(tag: saved.tag, form: type))
    syntax.ast_node_set_link(@tokens, first + at, link)
    recur(old, current, mapping, declaration, first, at + 1, @tokens, @facts)

fn check_functions(source: Bytes, tokens: @Vec[syntax.Token], old: Cache, current: Index, mapping: Update, at: I64, facts: @Vec[typing.Fact], issues: @Vec[typing.Issue], executed: I64, reused: I64, imported: I64, checked_imports: @Vec[Bool]) -> Work effects[alloc, partial]:
  if (at >= vec.len(current.declarations)) || typing.issues_block_inference(issues):
    Work(executed: executed, reused: reused, imported: imported, capacity: false)
  else:
    let declaration: Declaration = vec.get(current.declarations, at)
    let function: Bool = declaration.kind == 0
    let hit: Bool = if function && (!vec.get(mapping.bodies, at)):
      let previous: I64 = vec.get(mapping.before, at)
      if previous >= 0:
        let candidate: Declaration = vec.get(old.index.declarations, previous)
        import_valid(old, current, mapping, candidate, 0)
      else:
        false
    else:
      false
    if function:
      if hit:
        let previous: I64 = vec.get(mapping.before, at)
        let candidate: Declaration = vec.get(old.index.declarations, previous)
        import_nodes(old, current, mapping, candidate, declaration.owner.first, 0, @tokens, @facts)
      else:
        typing.check_function(source, @tokens, declaration.owner.first, @facts, @issues)
    else:
      void
    vec.push(@checked_imports, hit)
    let next_executed: I64 = if function && (!hit):
      executed + 1
    else:
      executed
    let next_reused: I64 = if hit:
      reused + 1
    else:
      reused
    let next_imported: I64 = if hit:
      imported + declaration.owner.count
    else:
      imported
    recur(source, @tokens, old, current, mapping, at + 1, @facts, @issues, next_executed, next_reused, next_imported, @checked_imports)

fn save_nodes(index: Index, tokens: Vec[syntax.Token], facts: Vec[typing.Fact], prior: Vec[StoredLink], at: I64, output: @Vec[Saved]) -> Void effects[alloc, partial]:
  if at >= vec.len(tokens):
    void
  else:
    let fact: typing.Fact = vec.get(facts, at)
    let raw: I64 = syntax.ast_node_link(tokens, at)
    let owner: I64 = vec.get(index.owners, at)
    let declaration: identity.DeclarationId = if owner >= 0:
      let declared: Declaration = vec.get(index.declarations, owner)
      declared.owner.declaration
    else:
      let file: identity.FileId = identity.FileId(revision: index.revision, slot: 0)
      identity.DeclarationId(file: file, slot: -1)
    vec.push(@output, Saved(owner: declaration, tag: fact.tag, type: StoredType(position: fact.form), link: StoredLink(value: raw), prior: vec.get(prior, at)))
    recur(index, tokens, facts, prior, at + 1, @output)

fn plan_node_valid(node: I64, count: I64) -> Bool:
  (node >= 0) && (node < count)

fn plan_slice_valid(start: I64, count: I64, total: I64) -> Bool:
  if ((start >= 0) && (start <= total)) && ((total >= 0) && (total <= 1000000)):
    (count >= 0) && (count <= (total - start))
  else:
    false

fn plan_frames_valid(cache: PlanCache, at: I64, values: I64, allocations: I64, destructions: I64) -> Bool effects[partial]:
  if at >= vec.len(cache.entries):
    (values == vec.len(cache.values)) && ((allocations == vec.len(cache.allocations)) && (destructions == vec.len(cache.destructions)))
  else:
    let entry: PlanEntry = vec.get(cache.entries, at)
    let starts: Bool = (entry.value_start == values) && ((entry.allocation_start == allocations) && (entry.destruction_start == destructions))
    let slices: Bool = plan_slice_valid(values, entry.value_count, vec.len(cache.values)) && (plan_slice_valid(allocations, entry.allocation_count, vec.len(cache.allocations)) && plan_slice_valid(destructions, entry.destruction_count, vec.len(cache.destructions)))
    if starts && slices:
      recur(cache, at + 1, values + entry.value_count, allocations + entry.allocation_count, destructions + entry.destruction_count)
    else:
      false

fn plan_values_valid(cache: PlanCache, entry: PlanEntry, count: I64, at: I64) -> Bool effects[partial]:
  if at >= entry.value_count:
    true
  else:
    let saved: PlanValue = vec.get(cache.values, entry.value_start + at)
    let value: memory.ValuePlan = saved.local
    let nodes: Bool = plan_node_valid(value.name, count) && (plan_node_valid(value.type_index, count) && plan_node_valid(value.declared, count))
    let last: Bool = if saved.last_bytes:
      (value.last_use >= 0) && (value.last_use <= entry.source_bytes)
    else:
      plan_node_valid(value.last_use, count)
    let facts: Bool = ((value.storage >= 0) && (value.storage <= 2)) && ((value.escape >= 0) && (value.escape <= 3))
    let tag_valid: Bool = if saved.last_bytes:
      at < 64
    else:
      at >= 64
    if (tag_valid && nodes) && (last && facts):
      recur(cache, entry, count, at + 1)
    else:
      false

fn plan_allocations_valid(plans: Vec[memory.AllocationPlan], start: I64, length: I64, count: I64, at: I64) -> Bool effects[partial]:
  if at >= length:
    true
  else:
    let plan: memory.AllocationPlan = vec.get(plans, start + at)
    if plan_node_valid(plan.site, count) && ((plan.region >= 0) && (plan.region <= 1)):
      recur(plans, start, length, count, at + 1)
    else:
      false

fn plan_destructions_valid(plans: Vec[memory.DestructionPlan], start: I64, length: I64, count: I64, at: I64) -> Bool effects[partial]:
  if at >= length:
    true
  else:
    let plan: memory.DestructionPlan = vec.get(plans, start + at)
    if plan_node_valid(plan.end, count) && ((plan.region >= 0) && (plan.region <= 1)):
      recur(plans, start, length, count, at + 1)
    else:
      false

fn plan_entry_valid(cache: PlanCache, entry: PlanEntry, owner: identity.View, source_bytes: I64) -> Bool effects[partial]:
  let origin: Bool = identity.same_declaration(entry.owner, owner.declaration) && ((entry.source_bytes == source_bytes) && (source_bytes >= 0))
  let scalar: Bool = ((entry.return_storage >= 0) && (entry.return_storage <= 2)) && ((entry.escaping_values >= 0) && (entry.escaping_values <= entry.value_count))
  let precise: Bool = if entry.liveness_precise:
    entry.value_count <= 64
  else:
    entry.value_count > 64
  if origin && (scalar && precise):
    plan_values_valid(cache, entry, owner.count, 0) && (plan_allocations_valid(cache.allocations, entry.allocation_start, entry.allocation_count, owner.count, 0) && plan_destructions_valid(cache.destructions, entry.destruction_start, entry.destruction_count, owner.count, 0))
  else:
    false

fn shifted_value(value: memory.ValuePlan, token_delta: I64, byte_delta: I64, last_bytes: Bool) -> memory.ValuePlan effects[partial]:
  let last: I64 = if last_bytes:
    value.last_use + byte_delta
  else:
    value.last_use + token_delta
  memory.ValuePlan(name: value.name + token_delta, type_index: value.type_index + token_delta, storage: value.storage, borrowed: value.borrowed, declared: value.declared + token_delta, last_use: last, escape: value.escape)

fn save_plan_values(values: Vec[memory.ValuePlan], token_delta: I64, byte_delta: I64, at: I64, output: @Vec[PlanValue]) -> Void effects[alloc, partial]:
  if at >= vec.len(values):
    void
  else:
    let value: memory.ValuePlan = shifted_value(vec.get(values, at), token_delta, byte_delta, at < 64)
    vec.push(@output, PlanValue(local: value, last_bytes: at < 64))
    recur(values, token_delta, byte_delta, at + 1, @output)

fn import_plan_values(cache: PlanCache, entry: PlanEntry, token_delta: I64, byte_delta: I64, at: I64, output: @Vec[memory.ValuePlan]) -> Void effects[alloc, partial]:
  if at >= entry.value_count:
    void
  else:
    let value: PlanValue = vec.get(cache.values, entry.value_start + at)
    vec.push(@output, shifted_value(value.local, token_delta, byte_delta, value.last_bytes))
    recur(cache, entry, token_delta, byte_delta, at + 1, @output)

fn translate_plan_allocations(plans: Vec[memory.AllocationPlan], start: I64, count: I64, delta: I64, at: I64, output: @Vec[memory.AllocationPlan]) -> Void effects[alloc, partial]:
  if at >= count:
    void
  else:
    let plan: memory.AllocationPlan = vec.get(plans, start + at)
    vec.push(@output, memory.AllocationPlan(site: plan.site + delta, region: plan.region))
    recur(plans, start, count, delta, at + 1, @output)

fn translate_plan_destructions(plans: Vec[memory.DestructionPlan], start: I64, count: I64, delta: I64, at: I64, output: @Vec[memory.DestructionPlan]) -> Void effects[alloc, partial]:
  if at >= count:
    void
  else:
    let plan: memory.DestructionPlan = vec.get(plans, start + at)
    vec.push(@output, memory.DestructionPlan(region: plan.region, end: plan.end + delta, reverse: plan.reverse))
    recur(plans, start, count, delta, at + 1, @output)

fn save_plan(plan: memory.FunctionPlan, declaration: Declaration, origin: I64, values: @Vec[PlanValue], allocations: @Vec[memory.AllocationPlan], destructions: @Vec[memory.DestructionPlan]) -> PlanEntry effects[alloc, partial]:
  let entry: PlanEntry = PlanEntry(owner: declaration.owner.declaration, source_bytes: bytes.len(declaration.body), return_storage: plan.return_storage, local_region: plan.local_region, recursive: plan.recursive, liveness_precise: plan.liveness_precise, escaping_values: plan.escaping_values, value_start: vec.len(values), value_count: vec.len(plan.values), allocation_start: vec.len(allocations), allocation_count: vec.len(plan.allocations), destruction_start: vec.len(destructions), destruction_count: vec.len(plan.destructions))
  let delta: I64 = 0 - declaration.owner.first
  save_plan_values(plan.values, delta, 0 - origin, 0, @values)
  translate_plan_allocations(plan.allocations, 0, entry.allocation_count, delta, 0, @allocations)
  translate_plan_destructions(plan.destructions, 0, entry.destruction_count, delta, 0, @destructions)
  entry

fn import_plan(cache: PlanCache, entry: PlanEntry, declaration: Declaration, origin: I64) -> memory.FunctionPlan effects[alloc, partial]:
  let values: Vec[memory.ValuePlan] = vec.new()
  let allocations: Vec[memory.AllocationPlan] = vec.new()
  let destructions: Vec[memory.DestructionPlan] = vec.new()
  let delta: I64 = declaration.owner.first
  import_plan_values(cache, entry, delta, origin, 0, @values)
  translate_plan_allocations(cache.allocations, entry.allocation_start, entry.allocation_count, delta, 0, @allocations)
  translate_plan_destructions(cache.destructions, entry.destruction_start, entry.destruction_count, delta, 0, @destructions)
  memory.FunctionPlan(function: delta, return_storage: entry.return_storage, local_region: entry.local_region, recursive: entry.recursive, liveness_precise: entry.liveness_precise, values: values, allocations: allocations, destructions: destructions, escaping_values: entry.escaping_values)

fn prior_plan(old: Cache, current: Index, mapping: Update, at: I64, framed: Bool) -> I64 effects[partial]:
  if (!vec.get(mapping.bodies, at)) && framed:
    let previous: I64 = vec.get(mapping.before, at)
    if (previous >= 0) && (previous < vec.len(old.index.declarations)):
      let slot: I64 = vec.get(old.planning.slots, previous)
      if (slot >= 0) && (slot < vec.len(old.planning.entries)):
        let entry: PlanEntry = vec.get(old.planning.entries, slot)
        let before: Declaration = vec.get(old.index.declarations, previous)
        let after: Declaration = vec.get(current.declarations, at)
        if plan_entry_valid(old.planning, entry, before.owner, bytes.len(after.body)):
          slot
        else:
          -1
      else:
        -1
    else:
      -1
  else:
    -1

fn plan_fits(plan: memory.FunctionPlan, budget: PlanBudget) -> Bool effects[partial]:
  budget.eligible && ((budget.functions > 0) && ((vec.len(plan.values) <= budget.values) && ((vec.len(plan.allocations) <= budget.allocations) && (vec.len(plan.destructions) <= budget.destructions))))

fn plan_functions(source: Bytes, tokens: Vec[syntax.Token], old: Cache, current: Index, mapping: Update, at: I64, framed: Bool, budget: PlanBudget, functions: @Vec[memory.FunctionPlan], entries: @Vec[PlanEntry], slots: @Vec[I64], values: @Vec[PlanValue], allocations: @Vec[memory.AllocationPlan], destructions: @Vec[memory.DestructionPlan]) -> Bool effects[alloc, partial]:
  if at >= vec.len(current.declarations):
    budget.eligible
  else:
    let declaration: Declaration = vec.get(current.declarations, at)
    if declaration.kind == 0:
      let origin: I64 = syntax.ast_node_start(tokens, declaration.owner.first)
      let previous: I64 = prior_plan(old, current, mapping, at, framed)
      let plan: memory.FunctionPlan = if previous >= 0:
        let entry: PlanEntry = vec.get(old.planning.entries, previous)
        import_plan(old.planning, entry, declaration, origin)
      else:
        memory.build_function_plan(source, tokens, declaration.owner.first)
      let next: PlanBudget = if plan_fits(plan, budget):
        let entry: PlanEntry = save_plan(plan, declaration, origin, @values, @allocations, @destructions)
        vec.push(@slots, vec.len(entries))
        vec.push(@entries, entry)
        PlanBudget(eligible: true, functions: budget.functions - 1, values: budget.values - vec.len(plan.values), allocations: budget.allocations - vec.len(plan.allocations), destructions: budget.destructions - vec.len(plan.destructions))
      else:
        vec.push(@slots, -1)
        PlanBudget(eligible: false, functions: 0, values: 0, allocations: 0, destructions: 0)
      vec.push(@functions, plan)
      recur(source, tokens, old, current, mapping, at + 1, framed, next, @functions, @entries, @slots, @values, @allocations, @destructions)
    else:
      vec.push(@slots, -1)
      recur(source, tokens, old, current, mapping, at + 1, framed, budget, @functions, @entries, @slots, @values, @allocations, @destructions)

fn plan_checked(source: Bytes, tokens: Vec[syntax.Token], old: Cache, current: Index, mapping: Update, limit: I64) -> Planned effects[alloc, partial]:
  let functions: Vec[memory.FunctionPlan] = vec.new()
  let entries: Vec[PlanEntry] = vec.new()
  let slots: Vec[I64] = vec.new()
  let values: Vec[PlanValue] = vec.new()
  let allocations: Vec[memory.AllocationPlan] = vec.new()
  let destructions: Vec[memory.DestructionPlan] = vec.new()
  let framed: Bool = if (vec.len(old.planning.entries) <= 1000000) && (vec.len(old.planning.slots) == vec.len(old.index.declarations)):
    plan_frames_valid(old.planning, 0, 0, 0, 0)
  else:
    false
  let budget: PlanBudget = PlanBudget(eligible: (limit >= 1) && (limit <= 1000000), functions: limit, values: limit, allocations: limit, destructions: limit)
  let kept: Bool = plan_functions(source, tokens, old, current, mapping, 0, framed, budget, @functions, @entries, @slots, @values, @allocations, @destructions)
  let cache: PlanCache = if kept:
    PlanCache(entries: entries, slots: slots, values: values, allocations: allocations, destructions: destructions)
  else:
    empty_plan_cache()
  Planned(plan: memory.Plan(functions: functions), cache: cache)

fn empty_range_history() -> RangeHistory effects[alloc]:
  let heads: Vec[I64] = vec.new()
  let entries: Vec[RangeEntry] = vec.new()
  let keys: Vec[RangeKey] = vec.new()
  let facts: Vec[RangeFact] = vec.new()
  let refinements: Vec[RangeRefinement] = vec.new()
  let recurrences: Vec[ranges.Recurrence] = vec.new()
  let counted: Vec[ranges.Counted] = vec.new()
  RangeHistory(heads: heads, entries: entries, keys: keys, facts: facts, refinements: refinements, recurrences: recurrences, counted: counted)

fn range_pack(fact: ranges.Fact) -> RangeValue:
  let analyzed: I64 = if fact.analyzed:
    1
  else:
    0
  let lower: I64 = if fact.lower_known:
    2
  else:
    0
  let upper: I64 = if fact.upper_known:
    4
  else:
    0
  let total: I64 = if fact.total:
    8
  else:
    0
  RangeValue(flags: ((analyzed + lower) + upper) + total, lower: fact.lower, upper: fact.upper)

fn range_unpack(value: RangeValue) -> ranges.Fact effects[partial]:
  ranges.Fact(analyzed: (value.flags % 2) == 1, lower_known: ((value.flags / 2) % 2) == 1, lower: value.lower, upper_known: ((value.flags / 4) % 2) == 1, upper: value.upper, total: ((value.flags / 8) % 2) == 1)

fn range_value_valid(value: RangeValue) -> Bool:
  ((value.flags >= 0) && (value.flags < 16)) && (((value.lower >= -1000000000) && (value.lower <= 1000000000)) && ((value.upper >= -1000000000) && (value.upper <= 1000000000)))

fn range_value_equal(left: RangeValue, right: RangeValue) -> Bool:
  (left.flags == right.flags) && ((left.lower == right.lower) && (left.upper == right.upper))

fn range_nondefault(value: RangeValue) -> Bool:
  !((value.flags == 0) && ((value.lower == 0) && (value.upper == 0)))

fn range_frame(history: RangeHistory, at: I64, keys: I64, facts: I64, refinements: I64, recurrences: I64, counted: I64) -> Bool effects[partial]:
  if at >= vec.len(history.entries):
    (keys == vec.len(history.keys)) && ((facts == vec.len(history.facts)) && ((refinements == vec.len(history.refinements)) && ((recurrences == vec.len(history.recurrences)) && (counted == vec.len(history.counted)))))
  else:
    let entry: RangeEntry = vec.get(history.entries, at)
    let starts: Bool = (keys == entry.key_start) && ((facts == entry.fact_start) && ((refinements == entry.refinement_start) && ((recurrences == entry.recurrence_start) && (counted == entry.counted_start))))
    let slices: Bool = plan_slice_valid(keys, entry.key_count, vec.len(history.keys)) && (plan_slice_valid(facts, entry.fact_count, vec.len(history.facts)) && (plan_slice_valid(refinements, entry.refinement_count, vec.len(history.refinements)) && (plan_slice_valid(recurrences, entry.recurrence_count, vec.len(history.recurrences)) && plan_slice_valid(counted, entry.counted_count, vec.len(history.counted)))))
    if starts && slices:
      recur(history, at + 1, keys + entry.key_count, facts + entry.fact_count, refinements + entry.refinement_count, recurrences + entry.recurrence_count, counted + entry.counted_count)
    else:
      false

fn range_history_valid(history: RangeHistory, declarations: I64) -> Bool effects[partial]:
  let entries: I64 = vec.len(history.entries)
  let keys: I64 = vec.len(history.keys)
  let facts: I64 = vec.len(history.facts)
  let refinements: I64 = vec.len(history.refinements)
  let recurrences: I64 = vec.len(history.recurrences)
  let counted: I64 = vec.len(history.counted)
  let bounds: Bool = (entries <= 1000000) && ((keys <= 1000000) && ((facts <= 1000000) && ((refinements <= 1000000) && ((recurrences <= 1000000) && (counted <= 1000000)))))
  if (vec.len(history.heads) == declarations) && bounds:
    if (((((entries + keys) + facts) + refinements) + recurrences) + counted) <= 1000000:
      range_frame(history, 0, 0, 0, 0, 0, 0)
    else:
      false
  else:
    false

fn range_keys_match(source: Bytes, tokens: Vec[syntax.Token], history: RangeHistory, entry: RangeEntry, owner: identity.View, parameter_facts: Vec[ranges.Fact], entry_facts: Vec[ranges.Fact], cursor: I64, at: I64) -> Bool effects[partial]:
  if syntax.ast_node_kind(tokens, cursor) == 1:
    at == entry.key_count
  else:
    if at >= entry.key_count:
      false
    else:
      let saved: RangeKey = vec.get(history.keys, entry.key_start + at)
      let name: I64 = syntax.ast_binding_name(source, tokens, cursor)
      let position: Bool = saved.node == (name - owner.first)
      let parameter: RangeValue = range_pack(vec.get(parameter_facts, name))
      let initial: RangeValue = range_pack(vec.get(entry_facts, name))
      let equal: Bool = range_value_equal(saved.parameter, parameter) && range_value_equal(saved.entry, initial)
      let valid: Bool = range_value_valid(saved.parameter) && range_value_valid(saved.entry)
      if position && (equal && valid):
        recur(source, tokens, history, entry, owner, parameter_facts, entry_facts, syntax.ast_next(tokens, cursor), at + 1)
      else:
        false

fn range_facts_valid(history: RangeHistory, entry: RangeEntry, at: I64, previous: I64) -> Bool effects[partial]:
  if at >= entry.fact_count:
    true
  else:
    let fact: RangeFact = vec.get(history.facts, entry.fact_start + at)
    if (plan_node_valid(fact.node, entry.nodes) && (fact.node > previous)) && (range_value_valid(fact.value) && range_nondefault(fact.value)):
      recur(history, entry, at + 1, fact.node)
    else:
      false

fn range_refinements_valid(history: RangeHistory, entry: RangeEntry, at: I64) -> Bool effects[partial]:
  if at >= entry.refinement_count:
    true
  else:
    let fact: RangeRefinement = vec.get(history.refinements, entry.refinement_start + at)
    let parent: Bool = (fact.parent == -1) || ((fact.parent >= 0) && (fact.parent < at))
    if parent && (plan_node_valid(fact.node, entry.nodes) && range_value_valid(fact.value)):
      recur(history, entry, at + 1)
    else:
      false

fn range_recurrences_valid(history: RangeHistory, entry: RangeEntry, at: I64) -> Bool effects[partial]:
  if at >= entry.recurrence_count:
    true
  else:
    let fact: ranges.Recurrence = vec.get(history.recurrences, entry.recurrence_start + at)
    let position: Bool = (fact.item == 0) && ((fact.position >= 0) && (fact.position < entry.key_count))
    let bounds: Bool = ((fact.bound >= -1000000000) && (fact.bound <= 1000000000)) && ((fact.step > 0) && (fact.step <= 1000000000))
    if position && bounds:
      recur(history, entry, at + 1)
    else:
      false

fn range_counted_valid(history: RangeHistory, entry: RangeEntry, at: I64) -> Bool effects[partial]:
  if at >= entry.counted_count:
    true
  else:
    let fact: ranges.Counted = vec.get(history.counted, entry.counted_start + at)
    let nodes: Bool = (fact.item == 0) && (plan_node_valid(fact.controller, entry.nodes) && (plan_node_valid(fact.base, entry.nodes) && plan_node_valid(fact.body, entry.nodes)))
    let bounds: Bool = ((fact.start >= 0) && (fact.start <= fact.bound)) && ((fact.bound <= 1000000000) && ((fact.step == 1) && ((fact.iterations >= 0) && (fact.iterations <= 16))))
    if nodes && bounds:
      if fact.iterations == (fact.bound - fact.start):
        recur(history, entry, at + 1)
      else:
        false
    else:
      false

fn range_result_valid(history: RangeHistory, entry: RangeEntry) -> Bool effects[partial]:
  let prefix: Bool = (entry.prefix >= 0) && (entry.prefix <= 64)
  if prefix && ((entry.recurrence_count <= 1) && (entry.counted_count <= 1)):
    if entry.refinement_count <= (64 - entry.prefix):
