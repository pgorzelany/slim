module retained

struct TypeId:
  node: NodeRef

struct BindingId:
  owner: identity.DeclarationId
  slot: I64

struct PlaceId:
  node: identity.NodeId

struct PlaceFact:
  place: PlaceId
  root: PlaceId
  declaration: identity.NodeId
  binding: BindingId
  root_type: TypeId
  value_type: TypeId
  root_kind: I64
  value_kind: I64
  borrow_mode: I64
  projections: I64
  steps: I64

enum PlaceResult:
  Invalid(Bytes)
  Unknown(Bytes)
  Bounded(I64)
  Exact(PlaceFact)

enum NodeRef:
  Missing
  Found(identity.NodeId)

struct LocalLink:
  binding: identity.NodeId
  type: NodeRef
  mode: I64

enum Link:
  Missing
  Source(identity.NodeId)
  Binding(BindingId)
  Local(LocalLink)
  Invalid

struct StoredType:
  position: I64

struct StoredLink:
  value: I64

struct Saved:
  owner: identity.DeclarationId
  tag: I64
  type: StoredType
  link: StoredLink
  prior: StoredLink

struct Shape:
  kind: I64
  tag: I64
  next: I64

struct Declaration:
  owner: identity.View
  name: Bytes
  kind: I64
  body: Bytes
  interface: Bytes
  prefix: I64

struct Index:
  revision: identity.Revision
  source: Bytes
  module: Bytes
  declarations: Vec[Declaration]
  owners: Vec[I64]
  shapes: Vec[Shape]
  names: Vec[syntax.NameNode]
  edges: Vec[syntax.NameEdge]

struct Cache:
  valid: Bool
  index: Index
  nodes: Vec[Saved]
  planning: PlanCache

struct PlanEntry:
  owner: identity.DeclarationId
