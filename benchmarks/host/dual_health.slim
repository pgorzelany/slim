(module dual-health (fn healthy ((port I64) (request Bytes)) Bool (effects alloc io) (let body (Vec U8) (call vec.new) (let ok Bool (call io.tcp-exchange "127.0.0.1" port request 8 2000 body) (let length I64 (call vec.len body) (call bool.and ok (call i64.eq length 2)))))) (fn main ((args (Vec Bytes))) I64 (effects alloc io) (fork (let first Bool (call healthy 8080 "A") (let second Bool (call healthy 8081 "B") (match (call bool.and first second) (true (let shown Unit (call io.println "OK") 0)) (false 1)))))))
