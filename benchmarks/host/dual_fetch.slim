module dual-fetch

record Reply:
  ok: Bool
  body: Vec[U8]

fn fetch(port: I64 request: Bytes) -> Reply effects[alloc io]:
  let body: Vec[U8] = vec.new()
  let ok: Bool = io.tcp-exchange("127.0.0.1" port request 64 2000 body)
  make Reply(ok = ok body = body)

fn main(args: Vec[Bytes]) -> I64 effects[alloc io partial]:
  fork:
    let first: Reply = fetch(8080 "LEFT")
    let second: Reply = fetch(8081 "RIGHT")
    let first-ok: Bool = get(first ok)
    let second-ok: Bool = get(second ok)
    let both-ok: Bool = bool.and(first-ok second-ok)
    let first-body: Vec[U8] = get(first body)
    let second-body: Vec[U8] = get(second body)
    let first-length: I64 = vec.len(first-body)
    let second-length: I64 = vec.len(second-body)
    let lengths: Bool = bool.and(i64.eq(first-length 4) i64.eq(second-length 4))
    match bool.and(both-ok lengths):
      true:
        let shown: Unit = io.println("OK")
        0
      false:
        1
