module dual_fetch

struct Reply:
  ok: Bool
  body: Vec[U8]

fn fetch(port: I64, request: Bytes) -> Reply effects[alloc, io]:
  let body: Vec[U8] = vec.new()
  let ok: Bool = io.tcp_exchange("127.0.0.1", port, request, 64, 2000, body)
  Reply(ok: ok, body: body)

fn main(args: Vec[Bytes]) -> I64 effects[alloc, io, partial]:
  parallel:
    let first: Reply = fetch(8080, "LEFT")
    let second: Reply = fetch(8081, "RIGHT")
    let first_ok: Bool = first.ok
    let second_ok: Bool = second.ok
    let both_ok: Bool = first_ok && second_ok
    let first_body: Vec[U8] = first.body
    let second_body: Vec[U8] = second.body
    let first_length: I64 = vec.len(first_body)
    let second_length: I64 = vec.len(second_body)
    let lengths: Bool = (first_length == 4) && (second_length == 4)
    if both_ok && lengths:
      io.println("OK")
      0
    else:
      1
