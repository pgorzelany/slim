module host_clock

fn sample(remaining: I64, previous: I64) -> Bool effects[io, partial]:
  if remaining <= 0:
    true
  else:
    let current: I64 = io.monotonic_ms()
    if current >= previous:
      recur(remaining - 1, current)
    else:
      false

fn main(args: Vec[Bytes]) -> I64 effects[io, partial]:
  let first: I64 = io.monotonic_ms()
  if sample(100000, first):
    0
  else:
    1
