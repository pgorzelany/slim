module local_loan

fn grow(value: @Vec[I64], count: I64) -> Void effects[alloc, partial]:
  if count <= 0:
    void
  else:
    vec.push(@value, count)
    recur(@value, count - 1)

fn exercise(value: @Vec[I64]) -> I64 effects[alloc, partial]:
  let alias: Vec[I64] = value
  grow(@value, 64)
  vec.get(alias, 0)

fn main(args: Vec[Bytes]) -> I64 effects[alloc, partial]:
  let value: Vec[I64] = vec.new()
  vec.push(@value, 7)
  exercise(@value) - 7
