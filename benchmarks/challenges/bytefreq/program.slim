module bytefreq

fn initialize(inout counts: Vec[I64], index: I64) -> Void effects[alloc, partial]:
  if index == 256:
    void
  else:
    vec.push(counts, 0)
    recur(counts, index + 1)

fn scan(inout counts: Vec[I64], input: Bytes, index: I64) -> Void effects[partial]:
  if index == bytes.len(input):
    void
  else:
    let byte: I64 = u8.to_i64(bytes.get(input, index))
    let current: I64 = vec.get(counts, byte)
    vec.set(counts, byte, current + 1)
    recur(counts, input, index + 1)

fn checksum(inout counts: Vec[I64], index: I64, total: I64) -> I64 effects[partial]:
  if index == 256:
    total
  else:
    recur(counts, index + 1, total + (vec.get(counts, index) * (index + 1)))

fn main(args: Vec[Bytes]) -> I64 effects[alloc, io, partial]:
  if vec.len(args) >= 2:
    let input_bytes: Vec[U8] = vec.new()
    let input_read: Bool = io.read_file(vec.get(args, 1), input_bytes)
    if input_read:
      let input: Bytes = bytes.freeze(input_bytes)
      let counts: Vec[I64] = vec.new()
      initialize(counts, 0)
      scan(counts, input, 0)
      let result: I64 = checksum(counts, 0, 0)
      io.print_i64(result)
      io.println("")
      0
    else:
      70
  else:
    io.println("usage: bytefreq FILE")
    64
