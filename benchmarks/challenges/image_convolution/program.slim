(module image-convolution
  (fn fill ((inout current (Vec I64)) (inout next (Vec I64)) (index I64) (count I64)) Unit
    (effects alloc partial)
    (match (call i64.eq index count)
      (true unit)
      (false
        (let value I64 (call i64.rem (call i64.add (call i64.mul index 31) 7) 256)
          (let pushed-current Unit (call vec.push current value)
            (let pushed-next Unit (call vec.push next 0)
              (recur current next (call i64.add index 1) count)))))))
  (fn step ((inout current (Vec I64)) (inout next (Vec I64)) (index I64) (count I64) (size I64)) Unit
    (effects partial)
    (match (call i64.eq index count)
      (true unit)
      (false
        (let row I64 (call i64.div index size)
          (let column I64 (call i64.rem index size)
            (let previous-row I64 (call i64.rem (call i64.add row (call i64.sub size 1)) size)
              (let next-row I64 (call i64.rem (call i64.add row 1) size)
                (let previous-column I64 (call i64.rem (call i64.add column (call i64.sub size 1)) size)
                  (let next-column I64 (call i64.rem (call i64.add column 1) size)
                    (let up-index I64 (call i64.add (call i64.mul previous-row size) column)
                      (let down-index I64 (call i64.add (call i64.mul next-row size) column)
                        (let left-index I64 (call i64.add (call i64.mul row size) previous-column)
                          (let right-index I64 (call i64.add (call i64.mul row size) next-column)
                            (let center I64 (call vec.get current index)
                              (let first I64 (call i64.add (call i64.mul center 4) (call vec.get current up-index))
                                (let second I64 (call i64.add first (call vec.get current down-index))
                                  (let third I64 (call i64.add second (call vec.get current left-index))
                                    (let total I64 (call i64.add third (call vec.get current right-index))
                                      (let value I64 (call i64.div total 8)
                                        (let stored Unit (call vec.set next index value)
                                          (recur current next (call i64.add index 1) count size)))))))))))))))))))))
  (fn copy-image ((inout current (Vec I64)) (inout next (Vec I64)) (index I64) (count I64)) Unit
    (effects partial)
    (match (call i64.eq index count)
      (true unit)
      (false
        (let value I64 (call vec.get next index)
          (let stored Unit (call vec.set current index value)
            (recur current next (call i64.add index 1) count))))))
  (fn rounds ((inout current (Vec I64)) (inout next (Vec I64)) (round I64) (limit I64) (count I64) (size I64)) Unit
    (effects partial)
    (match (call i64.eq round limit)
      (true unit)
      (false
        (let filtered Unit (call step current next 0 count size)
          (let copied Unit (call copy-image current next 0 count)
            (recur current next (call i64.add round 1) limit count size))))))
  (fn checksum ((inout current (Vec I64)) (index I64) (count I64) (total I64)) I64
    (effects partial)
    (match (call i64.eq index count)
      (true total)
      (false
        (recur current (call i64.add index 1) count (call i64.add total (call vec.get current index))))))
  (fn main ((args (Vec Bytes))) I64
    (effects alloc io partial)
    (let size I64 256
      (let count I64 (call i64.mul size size)
        (let current (Vec I64) (call vec.new)
          (let next (Vec I64) (call vec.new)
            (let filled Unit (call fill current next 0 count)
              (let filtered Unit (call rounds current next 0 40 count size)
                (let result I64 (call checksum current 0 count 0)
                  (let shown Unit (call io.print-i64 result)
                    (let newline Unit (call io.println "") 0))))))))))
)
