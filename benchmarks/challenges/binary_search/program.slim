module binary_search

fn fill(inout values: Vec[I64], index: I64, count: I64) -> Void effects[alloc, partial]:
  if index == count:
    void
  else:
    vec.push(values, index * 2)
    recur(values, index + 1, count)

fn search(inout values: Vec[I64], target: I64, left: I64, right: I64) -> I64 effects[partial]:
  if left >= right:
    -1
  else:
    let middle: I64 = left + ((right - left) / 2)
    let candidate: I64 = vec.get(values, middle)
    if candidate == target:
      middle
    else:
      if candidate < target:
        recur(values, target, middle + 1, right)
      else:
        recur(values, target, left, middle)

fn queries(inout values: Vec[I64], index: I64, count: I64, total: I64) -> I64 effects[partial]:
  if index == count:
    total
  else:
    let target_index: I64 = (index * 7919) % vec.len(values)
    let found: I64 = search(values, target_index * 2, 0, vec.len(values))
    recur(values, index + 1, count, total + found)

fn main(args: Vec[Bytes]) -> I64 effects[alloc, io, partial]:
  let values: Vec[I64] = vec.new()
  fill(values, 0, 200000)
  let result: I64 = queries(values, 0, 20000, 0)
  io.print_i64(result)
  io.println("")
  0
