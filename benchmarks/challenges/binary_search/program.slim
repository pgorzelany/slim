module binary-search

fn fill(inout values: Vec[I64] index: I64 count: I64) -> Unit effects[alloc partial]:
  match i64.eq(index count):
    true:
      unit
    false:
      let pushed: Unit = vec.push(values i64.mul(index 2))
      recur(values i64.add(index 1) count)

fn search(inout values: Vec[I64] target: I64 left: I64 right: I64) -> I64 effects[partial]:
  match i64.ge(left right):
    true:
      -1
    false:
      let middle: I64 = i64.add(left i64.div(i64.sub(right left) 2))
      let candidate: I64 = vec.get(values middle)
      match i64.eq(candidate target):
        true:
          middle
        false:
          match i64.lt(candidate target):
            true:
              recur(values target i64.add(middle 1) right)
            false:
              recur(values target left middle)

fn queries(inout values: Vec[I64] index: I64 count: I64 total: I64) -> I64 effects[partial]:
  match i64.eq(index count):
    true:
      total
    false:
      let target-index: I64 = i64.rem(i64.mul(index 7919) vec.len(values))
      let found: I64 = search(values i64.mul(target-index 2) 0 vec.len(values))
      recur(values i64.add(index 1) count i64.add(total found))

fn main(args: Vec[Bytes]) -> I64 effects[alloc io partial]:
  let values: Vec[I64] = vec.new()
  let filled: Unit = fill(values 0 200000)
  let result: I64 = queries(values 0 20000 0)
  let shown: Unit = io.print-i64(result)
  let newline: Unit = io.println("")
  0
