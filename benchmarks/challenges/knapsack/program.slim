module knapsack

fn fill(inout values: Vec[I64], index: I64, count: I64) -> Void effects[alloc, partial]:
  if index > count:
    void
  else:
    vec.push(values, 0)
    recur(values, index + 1, count)

fn capacities(inout values: Vec[I64], capacity: I64, weight: I64, value: I64) -> Void effects[partial]:
  if capacity < weight:
    void
  else:
    let prior: I64 = vec.get(values, capacity - weight)
    let candidate: I64 = prior + value
    let current: I64 = vec.get(values, capacity)
    let better: Bool = candidate > current
    if better:
      vec.set(values, capacity, candidate)
    else:
      void
    recur(values, capacity - 1, weight, value)

fn items(inout values: Vec[I64], item: I64, count: I64, capacity: I64) -> Void effects[partial]:
  if item > count:
    void
  else:
    let weight: I64 = 1 + ((item * 17) % 97)
    let value: I64 = 1 + ((item * 29) % 211)
    capacities(values, capacity, weight, value)
    recur(values, item + 1, count, capacity)

fn main(args: Vec[Bytes]) -> I64 effects[alloc, io, partial]:
  let capacity: I64 = 2048
  let values: Vec[I64] = vec.new()
  fill(values, 0, capacity)
  items(values, 1, 200, capacity)
  let result: I64 = vec.get(values, capacity)
  io.print_i64(result)
  io.println("")
  0
