module gcd_fib

fn gcd(left: I64, right: I64) -> I64 effects[partial]:
  if right == 0:
    left
  else:
    recur(right, left % right)

fn fib(remaining: I64, left: I64, right: I64) -> I64 effects[partial]:
  if remaining == 0:
    left
  else:
    recur(remaining - 1, right, left + right)

fn main(args: Vec[Bytes]) -> I64 effects[io, partial]:
  let result: I64 = gcd(1071, 462) + fib(40, 0, 1)
  io.print_i64(result)
  io.println("")
  0
