module gcd-fib

fn gcd(left: I64 right: I64) -> I64 effects[partial]:
  match i64.eq(right 0):
    true:
      left
    false:
      recur(right i64.rem(left right))

fn fib(remaining: I64 left: I64 right: I64) -> I64 effects[partial]:
  match i64.eq(remaining 0):
    true:
      left
    false:
      recur(i64.sub(remaining 1) right i64.add(left right))

fn main(args: Vec[Bytes]) -> I64 effects[io partial]:
  let result: I64 = i64.add(gcd(1071 462) fib(40 0 1))
  let shown: Unit = io.print-i64(result)
  let newline: Unit = io.println("")
  0
