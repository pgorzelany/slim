module arena_sum

fn fill(arena: @Arena[I64], ids: @Vec[Id[I64]], index: I64, count: I64) -> Void effects[alloc, partial]:
  if index == count:
    void
  else:
    let identity: Id[I64] = arena.add(@arena, (index * 37) % 101)
    vec.push(@ids, identity)
    recur(@arena, @ids, index + 1, count)

fn sum(arena: @Arena[I64], ids: @Vec[Id[I64]], index: I64, total: I64) -> I64 effects[partial]:
  if index == vec.len(ids):
    total
  else:
    let identity: Id[I64] = vec.get(ids, index)
    recur(@arena, @ids, index + 1, total + arena.get(arena, identity))

fn main(args: Vec[Bytes]) -> I64 effects[alloc, io, partial]:
  let arena: Arena[I64] = arena.new()
  let ids: Vec[Id[I64]] = vec.new()
  fill(@arena, @ids, 0, 100000)
  let result: I64 = sum(@arena, @ids, 0, 0)
  io.print_i64(result)
  io.println("")
  0
