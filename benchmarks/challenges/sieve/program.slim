module sieve

fn fill(flags: @Vec[Bool], next: I64, limit: I64) -> Void effects[alloc, partial]:
  if next > limit:
    void
  else:
    vec.push(@flags, true)
    recur(@flags, next + 1, limit)

fn mark(flags: @Vec[Bool], multiple: I64, step: I64, limit: I64) -> Void effects[partial]:
  if multiple > limit:
    void
  else:
    vec.set(@flags, multiple, false)
    recur(@flags, multiple + step, step, limit)

fn cross(flags: @Vec[Bool], prime: I64, limit: I64) -> Void effects[partial]:
  if (prime * prime) > limit:
    void
  else:
    if vec.get(flags, prime):
      mark(@flags, prime * prime, prime, limit)
      recur(@flags, prime + 1, limit)
    else:
      recur(@flags, prime + 1, limit)

fn count(flags: @Vec[Bool], index: I64, limit: I64, total: I64) -> I64 effects[partial]:
  if index > limit:
    total
  else:
    if vec.get(flags, index):
      recur(@flags, index + 1, limit, total + 1)
    else:
      recur(@flags, index + 1, limit, total)

fn main(args: Vec[Bytes]) -> I64 effects[alloc, io, partial]:
  let limit: I64 = 1000000
  let flags: Vec[Bool] = vec.new()
  fill(@flags, 0, limit)
  vec.set(@flags, 0, false)
  vec.set(@flags, 1, false)
  cross(@flags, 2, limit)
  let result: I64 = count(@flags, 2, limit, 0)
  io.print_i64(result)
  io.println("")
  0
