module variants

enum Command:
  Keep
  Add(I64)
  Remove(I64)

fn command(index: I64) -> Command effects[partial]:
  let choice: I64 = index % 3
  if choice == 0:
    Command::Add(index % 17)
  else:
    if choice == 1:
      Command::Remove(index % 13)
    else:
      Command::Keep()

fn apply(value: I64, command: Command) -> I64 effects[partial]:
  match command:
    Keep:
      value
    Add(amount):
      value + amount
    Remove(amount):
      value - amount

fn simulate(index: I64, count: I64, value: I64) -> I64 effects[partial]:
  if index == count:
    value
  else:
    recur(index + 1, count, apply(value, command(index)))

fn main(args: Vec[Bytes]) -> I64 effects[io, partial]:
  let result: I64 = simulate(0, 2000000, 0)
  io.print_i64(result)
  io.println("")
  0
