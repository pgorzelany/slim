module matrix

fn fill(inout values: Vec[I64] index: I64 count: I64 factor: I64) -> Unit effects[alloc partial]:
  match i64.eq(index count):
    true:
      unit
    false:
      let value: I64 = i64.rem(i64.add(i64.mul(index factor) 1) 97)
      let pushed: Unit = vec.push(values value)
      recur(values i64.add(index 1) count factor)

fn dot(inout left: Vec[I64] inout right: Vec[I64] row: I64 column: I64 index: I64 size: I64 total: I64) -> I64 effects[partial]:
  match i64.eq(index size):
    true:
      total
    false:
      let left-index: I64 = i64.add(i64.mul(row size) index)
      let right-index: I64 = i64.add(i64.mul(index size) column)
      let product: I64 = i64.mul(vec.get(left left-index) vec.get(right right-index))
      recur(left right row column i64.add(index 1) size i64.add(total product))

fn sum-cells(inout left: Vec[I64] inout right: Vec[I64] cell: I64 size: I64 total: I64) -> I64 effects[partial]:
  match i64.eq(cell i64.mul(size size)):
    true:
      total
    false:
      let row: I64 = i64.div(cell size)
      let column: I64 = i64.rem(cell size)
      let value: I64 = dot(left right row column 0 size 0)
      recur(left right i64.add(cell 1) size i64.add(total value))

fn main(args: Vec[Bytes]) -> I64 effects[alloc io partial]:
  let size: I64 = 128
  let count: I64 = i64.mul(size size)
  let left: Vec[I64] = vec.new()
  let right: Vec[I64] = vec.new()
  let left-filled: Unit = fill(left 0 count 17)
  let right-filled: Unit = fill(right 0 count 31)
  let result: I64 = sum-cells(left right 0 size 0)
  let shown: Unit = io.print-i64(result)
  let newline: Unit = io.println("")
  0
