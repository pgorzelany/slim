module bfs

fn enqueue(queue: @Vec[I64], node: I64, limit: I64) -> Void effects[alloc]:
  if node <= limit:
    vec.push(@queue, node)
  else:
    void

fn visit(queue: @Vec[I64], index: I64, limit: I64, total: I64) -> I64 effects[alloc, partial]:
  if index == vec.len(queue):
    total
  else:
    let node: I64 = vec.get(queue, index)
    let left: I64 = (node * 2) + 1
    let right: I64 = left + 1
    enqueue(@queue, left, limit)
    enqueue(@queue, right, limit)
    recur(@queue, index + 1, limit, total + node)

fn main(args: Vec[Bytes]) -> I64 effects[alloc, io, partial]:
  let queue: Vec[I64] = vec.new()
  vec.push(@queue, 0)
  let result: I64 = visit(@queue, 0, 100000, 0)
  io.print_i64(result)
  io.println("")
  0
