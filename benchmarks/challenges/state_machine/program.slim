module state-machine

record State:
  a: Bool
  b: Bool
  c: Bool
  d: Bool

fn run(remaining: I64 state: State) -> State effects[partial]:
  match i64.le(remaining 0):
    true:
      state
    false:
      let next-a: Bool = get(state b)
      let next-b: Bool = get(state c)
      let next-c: Bool = get(state d)
      let next-d: Bool = bool.not(get(state a))
      recur(i64.sub(remaining 1) make State(a = next-a b = next-b c = next-c d = next-d))

fn same(left: State right: State) -> Bool:
  bool.and(
    i64.eq(
      match get(left a):
        true:
          1
        false:
          0
      match get(right a):
        true:
          1
        false:
          0
    )
    bool.and(
      i64.eq(
        match get(left b):
          true:
            1
          false:
            0
        match get(right b):
          true:
            1
          false:
            0
      )
      bool.and(
        i64.eq(
          match get(left c):
            true:
              1
            false:
              0
          match get(right c):
            true:
              1
            false:
              0
        )
        i64.eq(
          match get(left d):
            true:
              1
            false:
              0
          match get(right d):
            true:
              1
            false:
              0
        )
      )
    )
  )

fn main(args: Vec[Bytes]) -> I64 effects[io partial]:
  let seed: Bool = i64.gt(vec.len(args) 1)
  let first: State = make State(a = seed b = false c = true d = false)
  let second: State = make State(a = false b = seed c = false d = true)
  let left: State = run(2000000 first)
  let right: State = run(2000000 second)
  let equal: Bool = same(left right)
  let answer: I64 = match equal:
    true:
      1
    false:
      0
  let shown: Unit = io.print-i64(answer)
  let newline: Unit = io.println("")
  0
