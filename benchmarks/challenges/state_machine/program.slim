(module state-machine (record State ((a Bool) (b Bool) (c Bool) (d Bool))) (fn run ((remaining I64) (state State)) State (effects partial) (match (call i64.le remaining 0) (true state) (false (let next-a Bool (get state b) (let next-b Bool (get state c) (let next-c Bool (get state d) (let next-d Bool (call bool.not (get state a)) (recur (call i64.sub remaining 1) (make State (a next-a) (b next-b) (c next-c) (d next-d)))))))))) (fn same ((left State) (right State)) Bool (effects) (call bool.and (call i64.eq (match (get left a) (true 1) (false 0)) (match (get right a) (true 1) (false 0))) (call bool.and (call i64.eq (match (get left b) (true 1) (false 0)) (match (get right b) (true 1) (false 0))) (call bool.and (call i64.eq (match (get left c) (true 1) (false 0)) (match (get right c) (true 1) (false 0))) (call i64.eq (match (get left d) (true 1) (false 0)) (match (get right d) (true 1) (false 0))))))) (fn main ((args (Vec Bytes))) I64 (effects io partial) (let seed Bool (call i64.gt (call vec.len args) 1) (let first State (make State (a seed) (b false) (c true) (d false)) (let second State (make State (a false) (b seed) (c false) (d true)) (let left State (call run 2000000 first) (let right State (call run 2000000 second) (let equal Bool (call same left right) (let answer I64 (match equal (true 1) (false 0)) (let shown Unit (call io.print-i64 answer) (let newline Unit (call io.println "") 0)))))))))))
