module edit-distance

fn minimum-two(left: I64 right: I64) -> I64:
  match i64.le(left right):
    true:
      left
    false:
      right

fn minimum-three(first: I64 second: I64 third: I64) -> I64:
  minimum-two(minimum-two(first second) third)

fn fill(inout previous: Vec[I64] inout current: Vec[I64] index: I64 length: I64) -> Unit effects[alloc partial]:
  match i64.gt(index length):
    true:
      unit
    false:
      let pushed-previous: Unit = vec.push(previous index)
      let pushed-current: Unit = vec.push(current 0)
      recur(previous current i64.add(index 1) length)

fn reset(inout previous: Vec[I64] index: I64 length: I64) -> Unit effects[partial]:
  match i64.gt(index length):
    true:
      unit
    false:
      let stored: Unit = vec.set(previous index index)
      recur(previous i64.add(index 1) length)

fn columns(left: Bytes right: Bytes inout previous: Vec[I64] inout current: Vec[I64] row: I64 column: I64 right-length: I64) -> Unit effects[partial]:
  match i64.gt(column right-length):
    true:
      unit
    false:
      let left-code: I64 = u8.to-i64(bytes.get(left i64.sub(row 1)))
      let right-code: I64 = u8.to-i64(bytes.get(right i64.sub(column 1)))
      let cost: I64 = match i64.eq(left-code right-code):
        true:
          0
        false:
          1
      let deletion: I64 = i64.add(vec.get(previous column) 1)
      let insertion: I64 = i64.add(vec.get(current i64.sub(column 1)) 1)
      let substitution: I64 = i64.add(vec.get(previous i64.sub(column 1)) cost)
      let value: I64 = minimum-three(deletion insertion substitution)
      let stored: Unit = vec.set(current column value)
      recur(left right previous current row i64.add(column 1) right-length)

fn copy-row(inout previous: Vec[I64] inout current: Vec[I64] index: I64 length: I64) -> Unit effects[partial]:
  match i64.gt(index length):
    true:
      unit
    false:
      let value: I64 = vec.get(current index)
      let stored: Unit = vec.set(previous index value)
      recur(previous current i64.add(index 1) length)

fn rows(left: Bytes right: Bytes inout previous: Vec[I64] inout current: Vec[I64] row: I64 left-length: I64 right-length: I64) -> Unit effects[partial]:
  match i64.gt(row left-length):
    true:
      unit
    false:
      let initial: Unit = vec.set(current 0 row)
      let computed: Unit = columns(left right previous current row 1 right-length)
      let copied: Unit = copy-row(previous current 0 right-length)
      recur(left right previous current i64.add(row 1) left-length right-length)

fn repeat(left: Bytes right: Bytes inout previous: Vec[I64] inout current: Vec[I64] round: I64 rounds: I64 left-length: I64 right-length: I64 total: I64) -> I64 effects[partial]:
  match i64.eq(round rounds):
    true:
      total
    false:
      let reset-row: Unit = reset(previous 0 right-length)
      let solved: Unit = rows(left right previous current 1 left-length right-length)
      let value: I64 = vec.get(previous right-length)
      recur(left right previous current i64.add(round 1) rounds left-length right-length i64.add(total value))

fn main(args: Vec[Bytes]) -> I64 effects[alloc io partial]:
  let left: Bytes = "thequickbrownfoxjumpsoverthelazydogpackmyboxwithfivedozenliquorjugsphinxofblackquartzjudgemyvow"
  let right: Bytes = "thequickbluefoxjumpedoverthehazydogpacktheboxwithsixdozenliquorjugssphinxofbrightquartzjudgeourvow"
  let left-length: I64 = bytes.len(left)
  let right-length: I64 = bytes.len(right)
  let previous: Vec[I64] = vec.new()
  let current: Vec[I64] = vec.new()
  let filled: Unit = fill(previous current 0 right-length)
  let rounds: I64 = i64.mul(200 vec.len(args))
  let result: I64 = repeat(left right previous current 0 rounds left-length right-length 0)
  let shown: Unit = io.print-i64(result)
  let newline: Unit = io.println("")
  0
