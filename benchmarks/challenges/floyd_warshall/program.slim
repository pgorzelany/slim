module floyd_warshall

fn fill(inout distances: Vec[I64], index: I64, size: I64) -> Void effects[alloc, partial]:
  let count: I64 = size * size
  if index == count:
    void
  else:
    let row: I64 = index / size
    let column: I64 = index % size
    let diagonal: Bool = row == column
    let seed: I64 = 1 + (((row * 17) + (column * 31)) % 97)
    let value: I64 = if diagonal:
      0
    else:
      seed
    vec.push(distances, value)
    recur(distances, index + 1, size)

fn columns(inout distances: Vec[I64], pivot: I64, row: I64, column: I64, size: I64) -> Void effects[partial]:
  if column == size:
    void
  else:
    let row_base: I64 = row * size
    let pivot_base: I64 = pivot * size
    let left_index: I64 = row_base + pivot
    let right_index: I64 = pivot_base + column
    let target_index: I64 = row_base + column
    let candidate: I64 = vec.get(distances, left_index) + vec.get(distances, right_index)
    let current: I64 = vec.get(distances, target_index)
    let better: Bool = candidate < current
    if better:
      vec.set(distances, target_index, candidate)
    else:
      void
    recur(distances, pivot, row, column + 1, size)

fn rows(inout distances: Vec[I64], pivot: I64, row: I64, size: I64) -> Void effects[partial]:
  if row == size:
    void
  else:
    columns(distances, pivot, row, 0, size)
    recur(distances, pivot, row + 1, size)

fn pivots(inout distances: Vec[I64], pivot: I64, size: I64) -> Void effects[partial]:
  if pivot == size:
    void
  else:
    rows(distances, pivot, 0, size)
    recur(distances, pivot + 1, size)

fn checksum(distances: Vec[I64], index: I64, total: I64) -> I64 effects[partial]:
  if index == vec.len(distances):
    total
  else:
    recur(distances, index + 1, total + vec.get(distances, index))

fn main(args: Vec[Bytes]) -> I64 effects[alloc, io, partial]:
  let size: I64 = 192
  let distances: Vec[I64] = vec.new()
  fill(distances, 0, size)
  pivots(distances, 0, size)
  let result: I64 = checksum(distances, 0, 0)
  io.print_i64(result)
  io.println("")
  0
