module game_of_life

fn fill(current: @Vec[Bool], next: @Vec[Bool], index: I64, count: I64) -> Void effects[alloc, partial]:
  if index == count:
    void
  else:
    let seed: I64 = ((index * 17) + 3) % 3
    let alive: Bool = seed == 0
    vec.push(@current, alive)
    vec.push(@next, false)
    recur(@current, @next, index + 1, count)

fn neighbor_count(current: @Vec[Bool], row: I64, column: I64, offset: I64, size: I64, total: I64) -> I64 effects[partial]:
  if offset == 9:
    total
  else:
    if offset == 4:
      recur(@current, row, column, offset + 1, size, total)
    else:
      let row_delta: I64 = (offset / 3) - 1
      let column_delta: I64 = (offset % 3) - 1
      let neighbor_row: I64 = ((row + row_delta) + size) % size
      let neighbor_column: I64 = ((column + column_delta) + size) % size
      let neighbor_index: I64 = (neighbor_row * size) + neighbor_column
      let alive: Bool = vec.get(current, neighbor_index)
      let increment: I64 = if alive:
        1
      else:
        0
      recur(@current, row, column, offset + 1, size, total + increment)

fn step(current: @Vec[Bool], next: @Vec[Bool], index: I64, count: I64, size: I64) -> Void effects[partial]:
  if index == count:
    void
  else:
    let row: I64 = index / size
    let column: I64 = index % size
    let neighbors: I64 = neighbor_count(@current, row, column, 0, size, 0)
    let alive: Bool = vec.get(current, index)
    let born: Bool = neighbors == 3
    let survives: Bool = alive && (neighbors == 2)
    let value: Bool = born || survives
    vec.set(@next, index, value)
    recur(@current, @next, index + 1, count, size)

fn copy_grid(current: @Vec[Bool], next: @Vec[Bool], index: I64, count: I64) -> Void effects[partial]:
  if index == count:
    void
  else:
    let value: Bool = vec.get(next, index)
    vec.set(@current, index, value)
    recur(@current, @next, index + 1, count)

fn generations(current: @Vec[Bool], next: @Vec[Bool], generation: I64, rounds: I64, count: I64, size: I64) -> Void effects[partial]:
  if generation == rounds:
    void
  else:
    step(@current, @next, 0, count, size)
    copy_grid(@current, @next, 0, count)
    recur(@current, @next, generation + 1, rounds, count, size)

fn checksum(current: @Vec[Bool], index: I64, count: I64, total: I64) -> I64 effects[partial]:
  if index == count:
    total
  else:
    let alive: Bool = vec.get(current, index)
    let increment: I64 = if alive:
      1
    else:
      0
    recur(@current, index + 1, count, total + increment)

fn main(args: Vec[Bytes]) -> I64 effects[alloc, io, partial]:
  let size: I64 = 128
  let count: I64 = size * size
  let current: Vec[Bool] = vec.new()
  let next: Vec[Bool] = vec.new()
  fill(@current, @next, 0, count)
  generations(@current, @next, 0, 100, count, size)
  let result: I64 = checksum(@current, 0, count, 0)
  io.print_i64(result)
  io.println("")
  0
