module game-of-life

fn fill(inout current: Vec[Bool] inout next: Vec[Bool] index: I64 count: I64) -> Unit effects[alloc partial]:
  match i64.eq(index count):
    true:
      unit
    false:
      let seed: I64 = i64.rem(i64.add(i64.mul(index 17) 3) 3)
      let alive: Bool = i64.eq(seed 0)
      let pushed-current: Unit = vec.push(current alive)
      let pushed-next: Unit = vec.push(next false)
      recur(current next i64.add(index 1) count)

fn neighbor-count(inout current: Vec[Bool] row: I64 column: I64 offset: I64 size: I64 total: I64) -> I64 effects[partial]:
  match i64.eq(offset 9):
    true:
      total
    false:
      match i64.eq(offset 4):
        true:
          recur(current row column i64.add(offset 1) size total)
        false:
          let row-delta: I64 = i64.sub(i64.div(offset 3) 1)
          let column-delta: I64 = i64.sub(i64.rem(offset 3) 1)
          let neighbor-row: I64 = i64.rem(i64.add(i64.add(row row-delta) size) size)
          let neighbor-column: I64 = i64.rem(i64.add(i64.add(column column-delta) size) size)
          let neighbor-index: I64 = i64.add(i64.mul(neighbor-row size) neighbor-column)
          let alive: Bool = vec.get(current neighbor-index)
          let increment: I64 = match alive:
            true:
              1
            false:
              0
          recur(current row column i64.add(offset 1) size i64.add(total increment))

fn step(inout current: Vec[Bool] inout next: Vec[Bool] index: I64 count: I64 size: I64) -> Unit effects[partial]:
  match i64.eq(index count):
    true:
      unit
    false:
      let row: I64 = i64.div(index size)
      let column: I64 = i64.rem(index size)
      let neighbors: I64 = neighbor-count(current row column 0 size 0)
      let alive: Bool = vec.get(current index)
      let born: Bool = i64.eq(neighbors 3)
      let survives: Bool = bool.and(alive i64.eq(neighbors 2))
      let value: Bool = bool.or(born survives)
      let stored: Unit = vec.set(next index value)
      recur(current next i64.add(index 1) count size)

fn copy-grid(inout current: Vec[Bool] inout next: Vec[Bool] index: I64 count: I64) -> Unit effects[partial]:
  match i64.eq(index count):
    true:
      unit
    false:
      let value: Bool = vec.get(next index)
      let stored: Unit = vec.set(current index value)
      recur(current next i64.add(index 1) count)

fn generations(inout current: Vec[Bool] inout next: Vec[Bool] generation: I64 rounds: I64 count: I64 size: I64) -> Unit effects[partial]:
  match i64.eq(generation rounds):
    true:
      unit
    false:
      let evolved: Unit = step(current next 0 count size)
      let copied: Unit = copy-grid(current next 0 count)
      recur(current next i64.add(generation 1) rounds count size)

fn checksum(inout current: Vec[Bool] index: I64 count: I64 total: I64) -> I64 effects[partial]:
  match i64.eq(index count):
    true:
      total
    false:
      let alive: Bool = vec.get(current index)
      let increment: I64 = match alive:
        true:
          1
        false:
          0
      recur(current i64.add(index 1) count i64.add(total increment))

fn main(args: Vec[Bytes]) -> I64 effects[alloc io partial]:
  let size: I64 = 128
  let count: I64 = i64.mul(size size)
  let current: Vec[Bool] = vec.new()
  let next: Vec[Bool] = vec.new()
  let filled: Unit = fill(current next 0 count)
  let evolved: Unit = generations(current next 0 100 count size)
  let result: I64 = checksum(current 0 count 0)
  let shown: Unit = io.print-i64(result)
  let newline: Unit = io.println("")
  0
