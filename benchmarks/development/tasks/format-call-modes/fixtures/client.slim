module driver

fn probe(source: Bytes) -> Void effects[alloc, io, partial]:
  let tokens: Vec[syntax.Token] = vec.new()
  let parsed: syntax.ProgramParse = syntax.parse_program_result(source, @tokens)
  boolean(parsed.valid)
  if parsed.valid:
    number(check.check_source_all(source, @tokens))
    let output: Vec[U8] = vec.new()
    format.emit_module(source, tokens, @output)
    let first: Bytes = bytes.freeze(^output)
    io.print_bytes(first)
    let second_tokens: Vec[syntax.Token] = vec.new()
    let second_parsed: syntax.ProgramParse = syntax.parse_program_result(first, @second_tokens)
    boolean(second_parsed.valid)
    if second_parsed.valid:
      number(check.check_source_all(first, @second_tokens))
      let second: Vec[U8] = vec.new()
      format.emit_module(first, second_tokens, @second)
      io.print_bytes(bytes.freeze(^second))
    else:
      void
  else:
    void

fn number(value: I64) -> Void effects[io]:
  io.print_i64(value)
  io.print_bytes("\n")

fn boolean(value: Bool) -> Void effects[io]:
  if value:
    number(1)
  else:
    number(0)

