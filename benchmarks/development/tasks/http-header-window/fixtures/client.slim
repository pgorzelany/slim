module http_app

fn probe(source: Bytes) -> Void effects[io, partial]:
  let response: http_model.Response = http_parser.parse(source)
  boolean(response.valid)
  number(response.code)
  number(response.position)
  number(response.status)
  number(response.body_start)
  number(response.body_end)

fn number(value: I64) -> Void effects[io]:
  io.print_i64(value)
  io.print_bytes("\n")

fn boolean(value: Bool) -> Void effects[io]:
  if value:
    number(1)
  else:
    number(0)

