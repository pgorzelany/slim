module driver

fn probe(source: Bytes, start: I64, end: I64, maximum: I64) -> Void effects[alloc, io, partial]:
  let output: Vec[U8] = vec.new()
  text.append_text(@output, "pre:")
  boolean(text.append_quoted_slice(source, start, end, maximum, @output))
  io.print_bytes(bytes.freeze(^output))
  io.print_bytes("\n")

fn fill(count: I64, output: @Vec[U8]) -> Void effects[alloc, partial]:
  if count == 0:
    void
  else:
    vec.push(@output, i64.to_u8(65))
    recur(count - 1, @output)

fn large(count: I64) -> Void effects[alloc, io, partial]:
  let storage: Vec[U8] = vec.new()
  fill(count, @storage)
  probe(bytes.freeze(^storage), 0, 0, 2)

fn number(value: I64) -> Void effects[io]:
  io.print_i64(value)
  io.print_bytes("\n")

fn boolean(value: Bool) -> Void effects[io]:
  if value:
    number(1)
  else:
    number(0)

