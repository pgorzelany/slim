module driver

fn classify(source: Bytes) -> Void effects[alloc, io, partial]:
  let tokens: Vec[syntax.Token] = vec.new()
  let parsed: syntax.ProgramParse = syntax.parse_program_result(source, @tokens)
  boolean(parsed.valid)
  if parsed.valid:
    syntax.link_declaration_names(source, @tokens)
    let item: I64 = syntax.ast_module_items(0)
    let body: I64 = syntax.ast_function_body(tokens, item)
    let callee: I64 = syntax.ast_call_callee(body)
    boolean(effects.call_requires(source, tokens, callee, 1))
    boolean(effects.call_requires(source, tokens, callee, 2))
    boolean(effects.call_requires(source, tokens, callee, 3))
  else:
    void

fn checked(source: Bytes) -> Void effects[alloc, io, partial]:
  let tokens: Vec[syntax.Token] = vec.new()
  let parsed: syntax.ProgramParse = syntax.parse_program_result(source, @tokens)
  boolean(parsed.valid)
  if parsed.valid:
    number(check.check_source_all(source, @tokens))
  else:
    void

fn number(value: I64) -> Void effects[io]:
  io.print_i64(value)
  io.print_bytes("\n")

fn boolean(value: Bool) -> Void effects[io]:
  if value:
    number(1)
  else:
    number(0)

