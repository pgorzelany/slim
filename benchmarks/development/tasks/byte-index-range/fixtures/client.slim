module component_tests

fn ordinals(index: std_byte_index.Index, cursor: I64, end: I64) -> Void effects[io, partial]:
  if cursor == end:
    io.print_bytes("end\n")
  else:
    let entry: std_byte_index.Entry = vec.get(index.entries, cursor)
    number(entry.ordinal)
    recur(index, cursor + 1, end)

fn show(index: std_byte_index.Index, low: Bytes, high: Bytes) -> Void effects[io, partial]:
  let bounds: std_byte_index.Bounds = std_byte_index.range(index, low, high)
  number(bounds.start)
  number(bounds.end)
  ordinals(index, bounds.start, bounds.end)

fn number(value: I64) -> Void effects[io]:
  io.print_i64(value)
  io.print_bytes("\n")

fn boolean(value: Bool) -> Void effects[io]:
  if value:
    number(1)
  else:
    number(0)

