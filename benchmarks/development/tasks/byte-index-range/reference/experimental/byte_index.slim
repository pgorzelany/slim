module std_byte_index

struct Entry:
  start: I64
  end: I64
  ordinal: I64

struct Index:
  source: Bytes
  entries: Vec[Entry]

struct Bounds:
  start: I64
  end: I64

enum Built:
  Invalid(I64, I64)
  Ready(Index)

fn compare(source: Bytes, left_start: I64, left_end: I64, right: Bytes, right_start: I64, right_end: I64) -> I64 effects[partial]:
  if left_start == left_end:
    if right_start == right_end:
      0
    else:
      -1
  else:
    if right_start == right_end:
      1
    else:
      let left_byte: I64 = u8.to_i64(bytes.get(source, left_start))
      let right_byte: I64 = u8.to_i64(bytes.get(right, right_start))
      if left_byte < right_byte:
        -1
      else:
        if left_byte > right_byte:
          1
        else:
          recur(source, left_start + 1, left_end, right, right_start + 1, right_end)

fn validate(source: Bytes, entries: Vec[Entry], cursor: I64) -> I64 effects[partial]:
  if cursor == vec.len(entries):
    -1
  else:
    let entry: Entry = vec.get(entries, cursor)
    if (entry.start < 0) || ((entry.end < entry.start) || ((entry.end > bytes.len(source)) || (entry.ordinal < 0))):
      cursor
    else:
      if entry.end - entry.start > 256:
        cursor
      else:
        recur(source, entries, cursor + 1)

fn copy_entries(input: Vec[Entry], cursor: I64, output: @Vec[Entry]) -> Void effects[alloc, partial]:
  if cursor == vec.len(input):
    void
  else:
    vec.push(@output, vec.get(input, cursor))
    recur(input, cursor + 1, @output)

fn copy_back(input: Vec[Entry], cursor: I64, output: @Vec[Entry]) -> Void effects[partial]:
  if cursor == vec.len(input):
    void
  else:
    vec.set(@output, cursor, vec.get(input, cursor))
    recur(input, cursor + 1, @output)

fn merge(source: Bytes, input: Vec[Entry], left: I64, middle: I64, right: I64, end: I64, cursor: I64, output: @Vec[Entry]) -> Void effects[partial]:
  if cursor == end:
    void
  else:
    let take_left: Bool = if left == middle:
      false
    else:
      if right == end:
        true
      else:
        let first: Entry = vec.get(input, left)
        let second: Entry = vec.get(input, right)
        compare(source, first.start, first.end, source, second.start, second.end) <= 0
    if take_left:
      vec.set(@output, cursor, vec.get(input, left))
      recur(source, input, left + 1, middle, right, end, cursor + 1, @output)
    else:
      vec.set(@output, cursor, vec.get(input, right))
      recur(source, input, left, middle, right + 1, end, cursor + 1, @output)

fn runs(source: Bytes, input: Vec[Entry], start: I64, width: I64, output: @Vec[Entry]) -> Void effects[partial]:
  let count: I64 = vec.len(input)
  if start == count:
    void
  else:
    let middle: I64 = if width > count - start:
      count
    else:
      start + width
    let end: I64 = if width > count - middle:
      count
    else:
      middle + width
    merge(source, input, start, middle, middle, end, start, @output)
    recur(source, input, end, width, @output)

fn passes(source: Bytes, width: I64, entries: @Vec[Entry], scratch: @Vec[Entry]) -> Void effects[partial]:
  let count: I64 = vec.len(entries)
  if width >= count:
    void
  else:
    runs(source, entries, 0, width, @scratch)
    copy_back(scratch, 0, @entries)
    let next: I64 = if width > count / 2:
      count
    else:
      width * 2
    recur(source, next, @entries, @scratch)

fn duplicate(source: Bytes, entries: Vec[Entry], cursor: I64) -> I64 effects[partial]:
  if cursor >= vec.len(entries):
    -1
  else:
    let previous: Entry = vec.get(entries, cursor - 1)
    let current: Entry = vec.get(entries, cursor)
    if compare(source, previous.start, previous.end, source, current.start, current.end) == 0:
      current.start
    else:
      recur(source, entries, cursor + 1)

fn build(source: Bytes, entries: ^Vec[Entry], maximum: I64) -> Built effects[alloc, partial]:
  if (maximum < 0) || ((maximum > 4096) || (vec.len(entries) > maximum)):
    Built::Invalid(1, vec.len(entries))
  else:
    let invalid: I64 = validate(source, entries, 0)
    if invalid >= 0:
      Built::Invalid(2, invalid)
    else:
      let scratch: Vec[Entry] = vec.new()
      copy_entries(entries, 0, @scratch)
      passes(source, 1, @entries, @scratch)
      let repeated: I64 = duplicate(source, entries, 1)
      if repeated >= 0:
        Built::Invalid(3, repeated)
      else:
        Built::Ready(Index(source: source, entries: entries))

fn lower(index: Index, query: Bytes, query_start: I64, query_end: I64, start: I64, end: I64) -> I64 effects[partial]:
  if start == end:
    start
  else:
    let middle: I64 = start + (end - start) / 2
    let entry: Entry = vec.get(index.entries, middle)
    if compare(index.source, entry.start, entry.end, query, query_start, query_end) < 0:
      recur(index, query, query_start, query_end, middle + 1, end)
    else:
      recur(index, query, query_start, query_end, start, middle)

fn find(index: Index, query: Bytes, query_start: I64, query_end: I64) -> I64 effects[partial]:
  if (query_start < 0) || ((query_end < query_start) || (query_end > bytes.len(query))):
    -1
  else:
    let cursor: I64 = lower(index, query, query_start, query_end, 0, vec.len(index.entries))
    if cursor == vec.len(index.entries):
      -1
    else:
      let entry: Entry = vec.get(index.entries, cursor)
      if compare(index.source, entry.start, entry.end, query, query_start, query_end) == 0:
        entry.ordinal
      else:
        -1

fn prefix_compare(source: Bytes, entry: Entry, query: Bytes, cursor: I64) -> I64 effects[partial]:
  if cursor == bytes.len(query):
    0
  else:
    if cursor == entry.end - entry.start:
      -1
    else:
      let left: I64 = u8.to_i64(bytes.get(source, entry.start + cursor))
      let right: I64 = u8.to_i64(bytes.get(query, cursor))
      if left < right:
        -1
      else:
        if left > right:
          1
        else:
          recur(source, entry, query, cursor + 1)

fn upper_prefix(index: Index, query: Bytes, start: I64, end: I64) -> I64 effects[partial]:
  if start == end:
    start
  else:
    let middle: I64 = start + (end - start) / 2
    let entry: Entry = vec.get(index.entries, middle)
    if prefix_compare(index.source, entry, query, 0) <= 0:
      recur(index, query, middle + 1, end)
    else:
      recur(index, query, start, middle)

fn prefix(index: Index, query: Bytes) -> Bounds effects[partial]:
  let start: I64 = lower(index, query, 0, bytes.len(query), 0, vec.len(index.entries))
  let end: I64 = upper_prefix(index, query, start, vec.len(index.entries))
  Bounds(start: start, end: end)

fn upper_key(index: Index, query: Bytes, start: I64, end: I64) -> I64 effects[partial]:
  if start == end:
    start
  else:
    let middle: I64 = start + (end - start) / 2
    let entry: Entry = vec.get(index.entries, middle)
    if compare(index.source, entry.start, entry.end, query, 0, bytes.len(query)) <= 0:
      recur(index, query, middle + 1, end)
    else:
      recur(index, query, start, middle)

fn range(index: Index, low: Bytes, high: Bytes) -> Bounds effects[partial]:
  if compare(low, 0, bytes.len(low), high, 0, bytes.len(high)) > 0:
    Bounds(start: 0, end: 0)
  else:
    let start: I64 = lower(index, low, 0, bytes.len(low), 0, vec.len(index.entries))
    let end: I64 = upper_key(index, high, start, vec.len(index.entries))
    Bounds(start: start, end: end)
