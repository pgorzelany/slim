module component_tests

fn frames(count: I64, output: @Vec[std_netstring.Frame]) -> Void effects[alloc, partial]:
  if count == 0:
    void
  else:
    vec.push(@output, std_netstring.Frame(start: 0, end: 0, next: -99))
    recur(count - 1, @output)

fn number(value: I64) -> Void effects[io]:
  io.print_i64(value)
  io.print_bytes("\n")

fn boolean(value: Bool) -> Void effects[io]:
  if value:
    number(1)
  else:
    number(0)

