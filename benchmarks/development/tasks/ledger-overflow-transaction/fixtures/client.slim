module ledger

fn show(accounts: Vec[ledger_model.Account], cursor: I64) -> Void effects[io, partial]:
  if cursor == vec.len(accounts):
    void
  else:
    let account: ledger_model.Account = vec.get(accounts, cursor)
    number(account.name_start)
    number(account.name_end)
    number(account.balance)
    boolean(account.open)
    number(account.credits)
    number(account.debits)
    recur(accounts, cursor + 1)

fn probe(mode: I64, from_balance: I64, to_balance: I64, from_credits: I64, from_debits: I64, to_credits: I64, to_debits: I64, amount: I64, from_open: Bool, to_open: Bool) -> Void effects[alloc, io, partial]:
  let accounts: Vec[ledger_model.Account] = vec.new()
  vec.push(@accounts, ledger_model.Account(name_start: 0, name_end: 1, balance: from_balance, open: from_open, credits: from_credits, debits: from_debits))
  vec.push(@accounts, ledger_model.Account(name_start: 1, name_end: 2, balance: to_balance, open: to_open, credits: to_credits, debits: to_debits))
  let command: ledger_model.Command = if mode == 0:
    ledger_model.Command::Credit(0, 1, amount)
  else:
    if mode == 1:
      ledger_model.Command::Debit(0, 1, amount)
    else:
      if mode == 3:
        ledger_model.Command::Transfer(0, 1, 0, 1, amount)
      else:
        if mode == 4:
          ledger_model.Command::Transfer(0, 1, 2, 3, amount)
        else:
          ledger_model.Command::Transfer(0, 1, 1, 2, amount)
  let result: ledger_model.Applied = ledger_state.apply("abx", command, @accounts)
  match result:
    Accepted:
      number(0)
    Rejected(code):
      number(code)
  show(accounts, 0)

fn number(value: I64) -> Void effects[io]:
  io.print_i64(value)
  io.print_bytes("\n")

fn boolean(value: Bool) -> Void effects[io]:
  if value:
    number(1)
  else:
    number(0)

