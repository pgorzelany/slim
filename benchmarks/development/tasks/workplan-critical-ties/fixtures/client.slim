module workplan_app

fn probe(source: Bytes) -> Void effects[alloc, io, partial]:
  let loaded: workplan_model.Loaded = workplan_load.load(source, 4096, 16384)
  match loaded:
    Invalid(code, position):
      workplan_emit.error(code, position)
    Ready(graph):
      let scheduled: workplan_model.Scheduled = workplan_schedule.plan(graph)
      match scheduled:
        Invalid(code, position):
          workplan_emit.error(code, position)
        Ready(plan):
          workplan_emit.report(graph, plan)

fn number(value: I64) -> Void effects[io]:
  io.print_i64(value)
  io.print_bytes("\n")

fn boolean(value: Bool) -> Void effects[io]:
  if value:
    number(1)
  else:
    number(0)

