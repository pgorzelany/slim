module driver

fn show(file: identity.FileId, result: identity.Overlap) -> Void effects[io]:
  match result:
    Invalid:
      io.print_bytes("invalid\n")
    Empty:
      io.print_bytes("empty\n")
    Ready(span):
      io.print_bytes("ready\n")
      number(span.start)
      number(span.end)
      boolean(identity.same_file(file, span.file))

fn probe(file: identity.FileId, left: identity.FileId, right: identity.FileId, a: I64, b: I64, c: I64, d: I64) -> Void effects[io]:
  show(file, identity.intersect_span(file, "abcde", identity.Span(file: left, start: a, end: b), identity.Span(file: right, start: c, end: d)))

fn endings(a: I64, b: I64, c: I64, d: I64) -> Void effects[io, partial]:
  let file: identity.FileId = identity.FileId(revision: identity.Revision(epoch: 1, serial: 1), slot: 0)
  probe(file, file, file, a, b, c, d)
  if d == 5:
    void
  else:
    recur(a, b, c, d + 1)

fn thirds(a: I64, b: I64, c: I64) -> Void effects[io, partial]:
  endings(a, b, c, 0)
  if c == 5:
    void
  else:
    recur(a, b, c + 1)

fn seconds(a: I64, b: I64) -> Void effects[io, partial]:
  thirds(a, b, 0)
  if b == 5:
    void
  else:
    recur(a, b + 1)

fn firsts(a: I64) -> Void effects[io, partial]:
  seconds(a, 0)
  if a == 5:
    void
  else:
    recur(a + 1)

fn number(value: I64) -> Void effects[io]:
  io.print_i64(value)
  io.print_bytes("\n")

fn boolean(value: Bool) -> Void effects[io]:
  if value:
    number(1)
  else:
    number(0)

