module catalog_app

fn probe(source: Bytes, query: Bytes, exact: Bool) -> Void effects[alloc, io, partial]:
  let loaded: catalog_model.Loaded = catalog_data.load(source, 4096)
  match loaded:
    Invalid(code, position):
      io.print_bytes("invalid\n")
      number(code)
      number(position)
    Ready(catalog):
      io.print_bytes("ready\n")
      let bounds: std_byte_index.Bounds = catalog_data.select(catalog, query, exact)
      number(bounds.start)
      number(bounds.end)
      let selected: catalog_model.Selection = catalog_data.accumulate(catalog, bounds.start, bounds.end, 0, 0)
      boolean(selected.valid)
      number(selected.position)
      number(selected.count)
      number(selected.total)
      if selected.valid:
        catalog_emit.report(catalog, bounds, selected)
      else:
        void

fn number(value: I64) -> Void effects[io]:
  io.print_i64(value)
  io.print_bytes("\n")

fn boolean(value: Bool) -> Void effects[io]:
  if value:
    number(1)
  else:
    number(0)

