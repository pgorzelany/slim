module std_tests

fn show(result: std_decimal.Parsed) -> Void effects[io]:
  match result:
    Invalid(position):
      io.print_bytes("invalid\n")
      number(position)
    Overflow(position):
      io.print_bytes("overflow\n")
      number(position)
    Value(value, next):
      io.print_bytes("value\n")
      number(value)
      number(next)

fn number(value: I64) -> Void effects[io]:
  io.print_i64(value)
  io.print_bytes("\n")

fn boolean(value: Bool) -> Void effects[io]:
  if value:
    number(1)
  else:
    number(0)

