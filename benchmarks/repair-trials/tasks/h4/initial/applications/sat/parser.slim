module sat_parser

fn code_at(source: Bytes, index: I64) -> I64 effects[partial]:
  u8.to_i64(bytes.get(source, index))

fn comment_end(source: Bytes, index: I64, length: I64) -> I64 effects[partial]:
  if index >= length:
    index
  else:
    if code_at(source, index) == 10:
      index + 1
    else:
      recur(source, index + 1, length)

fn comment_start(source: Bytes, index: I64, length: I64) -> Bool effects[partial]:
  if code_at(source, index) == 99:
    let next: I64 = index + 1
    if next >= length:
      true
    else:
      let following: I64 = code_at(source, next)
      (following == 32) || (following == 9)
  else:
    false

fn skip_ignored(source: Bytes, index: I64, length: I64) -> I64 effects[partial]:
  if index >= length:
    index
  else:
    let code: I64 = code_at(source, index)
    let space: Bool = (code == 32) || ((code == 9) || ((code == 10) || (code == 13)))
    if space:
      recur(source, index + 1, length)
    else:
      if comment_start(source, index, length):
        let next: I64 = comment_end(source, index, length)
        recur(source, next, length)
      else:
        index

fn token_end(source: Bytes, index: I64, length: I64) -> I64 effects[partial]:
  if index >= length:
    index
  else:
    let code: I64 = code_at(source, index)
    let space: Bool = (code == 32) || ((code == 9) || ((code == 10) || (code == 13)))
    if space:
      index
    else:
      recur(source, index + 1, length)

fn next_token(source: Bytes, index: I64) -> sat_model.Token effects[partial]:
  let length: I64 = bytes.len(source)
  let start: I64 = skip_ignored(source, index, length)
  if start >= length:
    sat_model.Token(eof: true, start: start, end: start)
  else:
    let end: I64 = token_end(source, start, length)
    sat_model.Token(eof: false, start: start, end: end)

fn token_is(source: Bytes, token: sat_model.Token, expected: Bytes) -> Bool effects[partial]:
  let length: I64 = token.end - token.start
  if token.eof || !(length == bytes.len(expected)):
    false
  else:
    std_bytes.range_equal(source, token.start, expected, 0, length)

fn number(source: Bytes, token: sat_model.Token) -> sat_model.Number effects[partial]:
  if token.eof:
    sat_model.Number(valid: false, overflow: false, value: 0, position: token.start)
  else:
    let parsed: std_decimal.Parsed = std_decimal.parse_i64(source, token.start, token.end)
    match parsed:
      Invalid(position):
        sat_model.Number(valid: false, overflow: false, value: 0, position: position)
      Overflow(position):
        sat_model.Number(valid: false, overflow: true, value: 0, position: position)
      Value(value, next):
        sat_model.Number(valid: next == token.end, overflow: false, value: value, position: next)

fn invalid_header(code: I64, position: I64) -> sat_model.Header:
  sat_model.Header(valid: false, code: code, position: position, variables: 0, clauses: 0, next: position)

fn header(source: Bytes) -> sat_model.Header effects[partial]:
  let p: sat_model.Token = next_token(source, 0)
  if !token_is(source, p, "p"):
    invalid_header(10, p.start)
  else:
    let cnf: sat_model.Token = next_token(source, p.end)
    if !token_is(source, cnf, "cnf"):
      invalid_header(11, cnf.start)
    else:
      let variable_token: sat_model.Token = next_token(source, cnf.end)
      let variable: sat_model.Number = number(source, variable_token)
      if !variable.valid:
        invalid_header(12, variable.position)
      else:
        let clause_token: sat_model.Token = next_token(source, variable_token.end)
        let clause: sat_model.Number = number(source, clause_token)
        if !clause.valid:
          invalid_header(12, clause.position)
        else:
          let ranges: Bool = (variable.value > 0) && (clause.value >= 0)
          if !ranges:
            invalid_header(13, variable_token.start)
          else:
            sat_model.Header(valid: true, code: 0, position: 0, variables: variable.value, clauses: clause.value, next: clause_token.end)

fn absolute_variable(literal: I64) -> I64:
  if literal == (-9223372036854775807 - 1):
    -1
  else:
    if literal < 0:
      0 - literal
    else:
      literal

fn invalid_parse(code: I64, position: I64, variables: I64, clauses: I64) -> sat_model.Parse:
  sat_model.Parse(valid: false, code: code, position: position, variables: variables, clauses: clauses)

fn parse_clauses(source: Bytes, index: I64, variables: I64, expected: I64, actual: I64, open: Bool, literals: @Vec[I64], starts: @Vec[I64], ends: @Vec[I64]) -> sat_model.Parse effects[alloc, partial]:
  let token: sat_model.Token = next_token(source, index)
  if token.eof:
    if (!open) && (actual == expected):
      sat_model.Parse(valid: true, code: 0, position: token.start, variables: variables, clauses: actual)
    else:
      invalid_parse(15, token.start, variables, actual)
  else:
    if actual >= expected:
      invalid_parse(15, token.start, variables, actual)
    else:
      let parsed: sat_model.Number = number(source, token)
      if !parsed.valid:
        invalid_parse(14, parsed.position, variables, actual)
      else:
        let literal: I64 = parsed.value
        let variable: I64 = absolute_variable(literal)
        let terminator: Bool = literal == 0
        let in_range: Bool = terminator || ((variable > 0) && (variable <= variables))
        if !in_range:
          invalid_parse(14, token.start, variables, actual)
        else:
          if !open:
            vec.push(@starts, vec.len(literals))
          else:
            void
          if terminator:
            vec.push(@ends, vec.len(literals))
            recur(source, token.end, variables, expected, actual + 1, false, @literals, @starts, @ends)
          else:
            vec.push(@literals, literal)
            recur(source, token.end, variables, expected, actual, true, @literals, @starts, @ends)

fn parse(source: Bytes, literals: @Vec[I64], starts: @Vec[I64], ends: @Vec[I64]) -> sat_model.Parse effects[alloc, partial]:
  let parsed_header: sat_model.Header = header(source)
  if !parsed_header.valid:
    invalid_parse(parsed_header.code, parsed_header.position, 0, 0)
  else:
    parse_clauses(source, parsed_header.next, parsed_header.variables, parsed_header.clauses, 0, false, @literals, @starts, @ends)
