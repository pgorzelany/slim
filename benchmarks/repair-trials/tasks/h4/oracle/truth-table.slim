module sat

fn check(actual: I64, expected: I64) -> I64:
  if actual == expected:
    0
  else:
    1

fn run(literals: Vec[I64], starts: Vec[I64], ends: Vec[I64], variables: I64, expected: I64, budget: I64) -> I64 effects[alloc, partial]:
  let assignments: Vec[I64] = vec.new()
  let solution: sat_model.Solution = sat_solver.solve(literals, starts, ends, variables, budget, @assignments)
  let classification: I64 = match solution:
    Sat(steps):
      1
    Unsat(steps):
      0
    Bounded(steps):
      2
  let valid: I64 = if classification == 1:
    certificate(literals, starts, ends, assignments, 0)
  else:
    0
  check(classification, expected) + valid

fn clause(literals: Vec[I64], assignments: Vec[I64], index: I64, end: I64) -> Bool effects[partial]:
  if index >= end:
    false
  else:
    let literal: I64 = vec.get(literals, index)
    let variable: I64 = if literal < 0:
      0 - literal
    else:
      literal
    let wanted: I64 = if literal < 0:
      0
    else:
      1
    if vec.get(assignments, variable) == wanted:
      true
    else:
      recur(literals, assignments, index + 1, end)

fn certificate(literals: Vec[I64], starts: Vec[I64], ends: Vec[I64], assignments: Vec[I64], at: I64) -> I64 effects[partial]:
  if at >= vec.len(starts):
    0
  else:
    if clause(literals, assignments, vec.get(starts, at), vec.get(ends, at)):
      recur(literals, starts, ends, assignments, at + 1)
    else:
      1

