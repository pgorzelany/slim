(project 1
  (entry ndjson)
  (module json_model "applications/ndjson/model.slim" (imports) (exports Edge Node Parsed))
  (module json_parser "applications/ndjson/parser.slim" (imports json_model std_ascii std_bytes) (exports parse_value skip_space))
  (module ndjson "applications/ndjson/main.slim" (imports json_model telemetry telemetry_emit) (exports))
  (module std_ascii "experimental/ascii.slim" (imports) (exports digit_value hex_value is_alpha is_alphanumeric is_digit is_hex_digit is_lower is_space is_upper))
  (module std_bytes "experimental/bytes.slim" (imports) (exports append append_range count_byte ends_with equal find_byte range_equal starts_with))
  (module std_decimal "experimental/decimal.slim" (imports std_ascii) (exports Parsed parse_i64 parse_u8))
  (module std_text "experimental/text.slim" (imports std_bytes) (exports append_byte append_bytes append_i64 append_span))
  (module telemetry "applications/ndjson/telemetry.slim" (imports json_model json_parser std_bytes std_decimal) (exports Device Stream process))
  (module telemetry_emit "applications/ndjson/emit.slim" (imports std_text telemetry) (exports print_devices print_error)))
