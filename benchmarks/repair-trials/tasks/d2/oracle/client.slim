module ndjson

fn main(args: Vec[Bytes]) -> I64 effects[alloc, io, partial]:
  let source: Bytes = vec.get(args, 1)
  let nodes: Arena[json_model.Node] = arena.new()
  let edges: Vec[json_model.Edge] = vec.new()
  let devices: Vec[telemetry.Device] = vec.new()
  let stream: telemetry.Stream = telemetry.process(source, 0, @nodes, @edges, @devices)
  if stream.valid:
    telemetry_emit.print_devices(source, devices)
    0
  else:
    telemetry_emit.print_error(stream.code, stream.position)
    1
