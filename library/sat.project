(project 1
  (entry sat)
  (module sat "applications/sat/main.slim" (imports sat_emit sat_model sat_parser sat_solver) (exports))
  (module sat_emit "applications/sat/emit.slim" (imports sat_model std_text) (exports print_error print_solution))
  (module sat_model "applications/sat/model.slim" (imports) (exports Header Number Parse Solution Token))
  (module sat_parser "applications/sat/parser.slim" (imports sat_model std_bytes std_decimal) (exports parse))
  (module sat_solver "applications/sat/solver.slim" (imports sat_model std_i64_vec) (exports solve))
  (module std_ascii "experimental/ascii.slim" (imports) (exports digit_value hex_value is_alpha is_alphanumeric is_digit is_hex_digit is_lower is_space is_upper))
  (module std_bytes "experimental/bytes.slim" (imports) (exports append append_range count_byte ends_with equal find_byte range_equal starts_with))
  (module std_decimal "experimental/decimal.slim" (imports std_ascii) (exports Parsed parse_i64 parse_u8))
  (module std_i64_vec "experimental/i64_vec.slim" (imports) (exports contains filled push_at top))
  (module std_text "experimental/text.slim" (imports std_bytes) (exports append_byte append_bytes append_i64 append_span)))
