(project 1
  (entry development_test)
  (module development_data "components/development_summary_data.slim" (imports development_model framed_records std_byte_index std_bytes std_decimal std_netstring) (exports load))
  (module development_emit "components/development_summary_emit.slim" (imports development_model development_stats std_byte_index std_bytes std_netstring std_text) (exports error report))
  (module development_model "components/development_summary_model.slim" (imports std_byte_index std_netstring) (exports Aggregate Condition ConditionState Header Loaded Median Number Pair PairFacts PairState Status Step Summary Trial))
  (module development_stats "components/development_summary_stats.slim" (imports development_model framed_records) (exports condition median pairs ratio_reason step summary_median))
  (module development_test "tests/development_summary.slim" (imports development_data development_emit development_model development_stats std_bytes std_decimal std_text) (exports))
  (module framed_records "components/records.slim" (imports std_decimal std_netstring) (exports Parsed Triple addition_fits integer parse))
  (module std_ascii "experimental/ascii.slim" (imports) (exports digit_value is_digit))
  (module std_byte_index "experimental/byte_index.slim" (imports) (exports Built Entry Index build))
  (module std_bytes "experimental/bytes.slim" (imports) (exports append append_range equal range_equal))
  (module std_decimal "experimental/decimal.slim" (imports std_ascii) (exports Parsed parse_i64))
  (module std_netstring "experimental/netstring.slim" (imports std_ascii std_bytes std_text) (exports Frame Parsed append parse))
  (module std_text "experimental/text.slim" (imports std_bytes) (exports append_bytes append_i64)))
