module operation_cost_work

fn create(maximum: I64) -> Vec[I64] effects[alloc]:
  let output: Vec[I64] = vec.new()
  vec.push(@output, 0)
  vec.push(@output, 0)
  vec.push(@output, 0)
  vec.push(@output, 0)
  vec.push(@output, 0)
  vec.push(@output, maximum)
  output

fn limit(kind: I64) -> I64:
  if kind == 0:
    336518
  else:
    if kind == 1:
      8192
    else:
      if kind == 2:
        24576
      else:
        466944

fn step(work: @Vec[I64], kind: I64) -> Bool effects[partial]:
  if (vec.len(work) == 6) && ((kind >= 0) && (kind < 4)):
    let maximum: I64 = vec.get(work, 5)
    let total: I64 = vec.get(work, 4)
    let observed: I64 = vec.get(work, kind)
    if (maximum >= 0) && ((maximum <= 1000000) && ((total >= 0) && ((total < maximum) && ((observed >= 0) && (observed < limit(kind)))))):
      vec.set(@work, kind, observed + 1)
      vec.set(@work, 4, total + 1)
      true
    else:
      false
  else:
    false
