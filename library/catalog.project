(project 1
  (entry catalog_app)
  (module catalog_app "applications/catalog/main.slim" (imports catalog_data catalog_diff_emit catalog_emit catalog_model catalog_reconcile std_byte_index std_bytes) (exports))
  (module catalog_data "applications/catalog/catalog.slim" (imports catalog_model framed_records std_byte_index std_decimal) (exports accumulate load select))
  (module catalog_diff_emit "applications/catalog/diff_emit.slim" (imports catalog_emit catalog_model catalog_reconcile std_netstring std_text) (exports error report))
  (module catalog_emit "applications/catalog/emit.slim" (imports catalog_model std_byte_index std_netstring std_text) (exports append_record error report))
  (module catalog_model "applications/catalog/model.slim" (imports std_byte_index) (exports Catalog Loaded Record Selection Status))
  (module catalog_reconcile "applications/catalog/reconcile.slim" (imports catalog_model std_byte_index std_bytes) (exports Change Diff Prepared prepare))
  (module framed_records "components/records.slim" (imports std_decimal std_netstring) (exports Parsed Triple addition_fits integer parse))
  (module std_ascii "experimental/ascii.slim" (imports) (exports digit_value is_digit))
  (module std_byte_index "experimental/byte_index.slim" (imports) (exports Bounds Built Entry Index build compare find prefix))
  (module std_bytes "experimental/bytes.slim" (imports) (exports append append_range equal range_equal))
  (module std_decimal "experimental/decimal.slim" (imports std_ascii) (exports Parsed parse_i64))
  (module std_netstring "experimental/netstring.slim" (imports std_ascii std_bytes std_text) (exports Frame Parsed append parse))
  (module std_text "experimental/text.slim" (imports std_bytes) (exports append_bytes append_i64)))
