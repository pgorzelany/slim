module raster_app

fn run(path: Bytes) -> I64 effects[alloc, io, partial]:
  let input: Vec[U8] = vec.new()
  if io.read_file(path, @input):
    let source: Bytes = bytes.freeze(^input)
    let triangles: Vec[raster_model.Triangle] = vec.new()
    let parsed: raster_model.Parse = raster_parser.parse(source, @triangles)
    if parsed.valid:
      let pixels: Vec[U8] = vec.new()
      std_u8_vec.filled(parsed.width * parsed.height, parsed.clear, 0, @pixels)
      raster.render(triangles, parsed.width, parsed.height, 0, @pixels)
      raster_emit.print_pgm(parsed.width, parsed.height, pixels)
      0
    else:
      raster_emit.print_error(parsed.code, parsed.position)
      65
  else:
    raster_emit.print_error(1, 0)
    66

fn main(args: Vec[Bytes]) -> I64 effects[alloc, io, partial]:
  if vec.len(args) == 2:
    run(vec.get(args, 1))
  else:
    raster_emit.print_error(2, 0)
    64
