module workplan_app

fn schedule(source: Bytes) -> I64 effects[alloc, io, partial]:
  let loaded: workplan_model.Loaded = workplan_load.load(source, 4096, 65536)
  match loaded:
    Invalid(code, position):
      workplan_emit.error(code, position)
      65
    Ready(graph):
      let scheduled: workplan_model.Scheduled = workplan_schedule.plan(graph)
      match scheduled:
        Invalid(code, position):
          workplan_emit.error(code, position)
          65
        Ready(plan):
          workplan_emit.report(graph, plan)
          0

fn main(args: Vec[Bytes]) -> I64 effects[alloc, io, partial]:
  if vec.len(args) == 2:
    let input: Vec[U8] = vec.new()
    if io.read_file(vec.get(args, 1), @input):
      schedule(bytes.freeze(^input))
    else:
      workplan_emit.error(1, 0)
      66
  else:
    workplan_emit.error(2, 0)
    64
