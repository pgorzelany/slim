(project 1
  (entry operation_cost_app)
  (module development_data "components/development_summary_data.slim" (imports development_model framed_records std_byte_index std_bytes std_decimal std_netstring) (exports hash_valid lifecycle matches number outcome))
  (module development_model "components/development_summary_model.slim" (imports std_byte_index std_netstring) (exports Aggregate Condition ConditionState Header Loaded Median Number Pair PairFacts PairState Status Step Summary Trial))
  (module framed_records "components/records.slim" (imports std_decimal std_netstring) (exports Parsed Triple addition_fits integer parse))
  (module operation_cost_app "applications/development_operation_cost/main.slim" (imports operation_cost_data operation_cost_emit operation_cost_model operation_cost_stats) (exports))
  (module operation_cost_data "components/development_operation_cost_data.slim" (imports development_data development_model framed_records operation_cost_model operation_cost_work std_byte_index std_netstring) (exports load))
  (module operation_cost_emit "components/development_operation_cost_emit.slim" (imports operation_cost_model operation_cost_stats std_bytes std_netstring std_text) (exports error report))
  (module operation_cost_model "components/development_operation_cost_model.slim" (imports development_model framed_records std_netstring) (exports Command Counted Fields Frame Groups Loaded Metric Request Row Trial Triple View))
  (module operation_cost_stats "components/development_operation_cost_stats.slim" (imports development_model framed_records operation_cost_model operation_cost_work std_byte_index) (exports group_count summarize))
  (module operation_cost_work "components/development_operation_cost_work.slim" (imports) (exports create step))
  (module std_ascii "experimental/ascii.slim" (imports) (exports digit_value is_digit))
  (module std_byte_index "experimental/byte_index.slim" (imports) (exports Built Entry Index build compare))
  (module std_bytes "experimental/bytes.slim" (imports) (exports append append_range equal range_equal))
  (module std_decimal "experimental/decimal.slim" (imports std_ascii) (exports Parsed parse_i64))
  (module std_netstring "experimental/netstring.slim" (imports std_ascii std_bytes std_text) (exports Frame Parsed append parse))
  (module std_text "experimental/text.slim" (imports std_bytes) (exports append_bytes append_i64)))
