(project 1
  (entry project_impact_app)
  (module catalog_data "applications/catalog/catalog.slim" (imports catalog_model framed_records std_byte_index std_decimal) (exports load))
  (module catalog_emit "applications/catalog/emit.slim" (imports catalog_model std_byte_index std_netstring std_text) (exports append_record))
  (module catalog_model "applications/catalog/model.slim" (imports std_byte_index) (exports Catalog Loaded Record Selection Status))
  (module catalog_reconcile "applications/catalog/reconcile.slim" (imports catalog_model std_byte_index std_bytes) (exports Change Diff Prepared prepare))
  (module framed_records "components/records.slim" (imports std_decimal std_netstring) (exports Parsed Triple addition_fits integer parse))
  (module project_impact_app "applications/project_impact/main.slim" (imports project_impact_input project_impact_model std_text) (exports error))
  (module project_impact_closure "applications/project_impact/closure.slim" (imports project_impact_model workplan_model) (exports addition_fits admitted close product_fits zeros))
  (module project_impact_data "applications/project_impact/data.slim" (imports catalog_model project_impact_model std_ascii std_byte_index std_bytes workplan_model) (exports associate reserved reserved_key shape))
  (module project_impact_input "applications/project_impact/input.slim" (imports catalog_data catalog_model project_impact_data project_impact_model project_impact_prepare workplan_load workplan_model) (exports prepare))
  (module project_impact_model "applications/project_impact/model.slim" (imports catalog_model workplan_model) (exports Association Attempt Closure Prepared Result Snapshot Work))
  (module project_impact_prepare "applications/project_impact/prepare.slim" (imports catalog_model catalog_reconcile project_impact_closure project_impact_data project_impact_model project_impact_report std_byte_index std_bytes workplan_model) (exports prepare))
  (module project_impact_report "applications/project_impact/report.slim" (imports catalog_emit catalog_model catalog_reconcile project_impact_model std_byte_index std_netstring std_text workplan_model) (exports finish))
  (module std_ascii "experimental/ascii.slim" (imports) (exports digit_value is_alphanumeric is_digit))
  (module std_byte_index "experimental/byte_index.slim" (imports) (exports Bounds Built Entry Index build compare find prefix))
  (module std_bytes "experimental/bytes.slim" (imports) (exports append append_range equal find_byte range_equal))
  (module std_decimal "experimental/decimal.slim" (imports std_ascii) (exports Parsed parse_i64))
  (module std_netstring "experimental/netstring.slim" (imports std_ascii std_bytes std_text) (exports Frame Parsed append parse))
  (module std_text "experimental/text.slim" (imports std_bytes) (exports append_bytes append_i64))
  (module workplan_load "applications/workplan/load.slim" (imports framed_records std_ascii std_byte_index std_bytes std_decimal workplan_model) (exports load))
  (module workplan_model "applications/workplan/model.slim" (imports std_byte_index) (exports Edge Graph Loaded Plan Schedule Scheduled Status Step Task)))
