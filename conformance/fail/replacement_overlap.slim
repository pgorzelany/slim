module replacement_overlap

struct Owner:
  values: Vec[I64]

fn make(owner: Owner) -> Vec[I64] effects[alloc]:
  let length: I64 = vec.len(owner.values)
  vec.new()

fn invalid(owner: ^Owner) -> Vec[I64] effects[alloc]:
  mem.replace(@owner.values, make(owner))

fn main(args: Vec[Bytes]) -> I64:
  0
