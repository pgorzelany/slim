module enum_unknown_origin

enum Boxed:
  Some(Vec[I64])

fn exercise(left: Boxed, right: Boxed, output: @Vec[I64], flag: Bool) -> I64 effects[alloc]:
  let selected: Boxed = if flag:
    left
  else:
    right
  match selected:
    Some(items):
      vec.push(@output, 9)
      vec.len(items)

fn main(args: Vec[Bytes]) -> I64:
  0
