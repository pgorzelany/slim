(module move-from-inout
  (fn take ((values (Vec I64))) I64 (effects)
    (call vec.len values))
  (fn inspect ((inout values (Vec I64))) I64 (effects)
    (call take values))
  (fn main ((args (Vec Bytes))) I64 (effects alloc)
    (let values (Vec I64) (call vec.new)
      (call inspect values))))
