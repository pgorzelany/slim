module variant-use-after-move

variant Boxed:
  some(Vec[I64])

fn length(value: Boxed) -> I64:
  match value:
    some(items):
      vec.len(items)

fn main(args: Vec[Bytes]) -> I64 effects[alloc]:
  let items: Vec[I64] = vec.new()
  let boxed: Boxed = case Boxed::some(items)
  let first: I64 = length(boxed)
  length(boxed)
