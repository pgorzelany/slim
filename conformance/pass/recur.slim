module recur

fn sum(next: I64, limit: I64, total: I64) -> I64 effects[partial]:
  let done: Bool = next > limit
  if done:
    total
  else:
    let following: I64 = next + 1
    let accumulated: I64 = total + next
    recur(following, limit, accumulated)

fn main(args: Vec[Bytes]) -> I64 effects[io, partial]:
  let answer: I64 = sum(1, 10, 0)
  io.print_i64(answer)
  io.println("")
  0
