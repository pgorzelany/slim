module exclusive_assignment_counted

fn make() -> Vec[I64] effects[alloc]:
  let value: Vec[I64] = vec.new()
  vec.push(@value, 42)
  value

fn exercise(value: @Vec[I64], index: I64) -> I64 effects[alloc, partial]:
  if index == 3:
    vec.get(value, 0) - 42
  else:
    value = if index == 0:
      vec.new()
    else:
      make()
    recur(@value, index + 1)

fn main(args: Vec[Bytes]) -> I64 effects[alloc, partial]:
  let value: Vec[I64] = vec.new()
  vec.push(@value, 7)
  let result: I64 = exercise(@value, 0)
  let observed: I64 = vec.get(value, 0) - 42
  result + observed
