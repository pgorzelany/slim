module variant-wide

variant Wide:
  C00
  C01
  C02
  C03
  C04
  C05
  C06
  C07
  C08
  C09
  C10
  C11
  C12
  C13
  C14
  C15(I64)

fn unwrap(value: Wide) -> I64:
  match value:
    C00:
      0
    C01:
      1
    C02:
      2
    C03:
      3
    C04:
      4
    C05:
      5
    C06:
      6
    C07:
      7
    C08:
      8
    C09:
      9
    C10:
      10
    C11:
      11
    C12:
      12
    C13:
      13
    C14:
      14
    C15(answer):
      answer

fn main(args: Vec[Bytes]) -> I64 effects[io]:
  let value: Wide = case Wide::C15(42)
  let answer: I64 = unwrap(value)
  let shown: Unit = io.print-i64(answer)
  let newline: Unit = io.println("")
  0
