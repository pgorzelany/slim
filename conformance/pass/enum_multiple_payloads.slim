module enum_multiple_payloads

enum Pair:
  Both(Vec[I64], Vec[I64])

fn observe(value: @Pair) -> I64 effects[alloc]:
  match value:
    Both(first, second):
      let other: Vec[I64] = vec.new()
      vec.push(@other, 1)
      let sum: I64 = vec.len(first) + vec.len(second)
      let total: I64 = sum + vec.len(other)
      total - 1

fn main(args: Vec[Bytes]) -> I64 effects[alloc]:
  let value: Pair = Pair::Both(vec.new(), vec.new())
  observe(@value)
