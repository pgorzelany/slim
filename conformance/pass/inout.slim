module inout

fn append_answer(inout values: Vec[I64]) -> Unit effects[alloc]:
  vec.push(values 42)

fn main(args: Vec[Bytes]) -> I64 effects[alloc io]:
  let values: Vec[I64] = vec.new()
  let appended: Unit = append_answer(values)
  let answer: I64 = vec.get(values 0)
  let shown: Unit = io.print-i64(answer)
  let newline: Unit = io.println("")
  0
