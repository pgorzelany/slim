module reduction

fn dead-integer() -> I64:
  let discarded_integer: I64 = 99
  0

fn dead-boolean() -> Bool:
  let discarded_boolean: Bool = false
  true

fn dead-unit() -> Unit:
  let discarded_unit: Unit = unit
  unit

fn idempotent(value: Bool) -> Bool:
  bool.and(value value)

fn identity-match(value: Bool) -> Bool:
  match value:
    true:
      true
    false:
      false

fn common-result(condition: Bool value: Bool) -> Bool:
  match condition:
    true:
      value
    false:
      value

fn main(args: Vec[Bytes]) -> I64 effects[alloc io partial]:
  let helper_integer: I64 = dead-integer()
  let helper_boolean: Bool = dead-boolean()
  let helper_unit: Unit = dead-unit()
  let repeated: Bool = idempotent(true)
  let identity: Bool = identity-match(repeated)
  let common: Bool = common-result(identity true)
  let added: I64 = i64.add(42 0)
  let subtracted: I64 = i64.sub(added 0)
  let multiplied: I64 = i64.mul(subtracted 1)
  let nested: Bool = bool.and(bool.not(false) true)
  let disjoined: Bool = bool.or(nested false)
  let equal: Bool = i64.eq(7 7)
  let combined: Bool = bool.and(disjoined equal)
  let first_selected: Bool = bool.and(combined helper_boolean)
  let selected: Bool = bool.and(first_selected common)
  match true:
    true:
      match selected:
        true:
          let values: Vec[I64] = vec.new()
          let pushed: Unit = vec.push(values multiplied)
          let result: I64 = vec.get(values 0)
          let adjusted: I64 = i64.add(result helper_integer)
          let shown: Unit = io.print-i64(adjusted)
          let newline: Unit = io.println("")
          0
        false:
          1
    false:
      let forbidden: Unit = io.println("unreachable")
      1
