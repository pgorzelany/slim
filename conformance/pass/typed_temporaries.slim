module typed_temporaries

struct Pair:
  left: I64
  right: I64

struct Envelope:
  pair: Pair
  ready: Bool

enum Packet:
  Empty
  Data(Pair, Bool)

fn main(args: Vec[Bytes]) -> I64 effects[io]:
  let envelope: Envelope = Envelope(pair: Pair(left: 10, right: 20), ready: true && true)
  let packet: Packet = Packet::Data(Pair(left: 20, right: 22), true && true)
  match packet:
    Empty:
      1
    Data(pair, ready):
      if ready && true:
        let left: I64 = pair.left
        let right: I64 = pair.right
        let answer: I64 = left + right
        io.print_i64(answer)
        io.println("")
        0
      else:
        2
