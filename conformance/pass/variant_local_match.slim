module variant-local-match

variant Maybe:
  None
  Some(I64)

fn unwrap(value: Maybe) -> I64:
  let local: Maybe = value
  match local:
    None:
      0
    Some(number):
      number

fn main(args: Vec[Bytes]) -> I64 effects[io]:
  let answer: I64 = unwrap(case Maybe::Some(42))
  let shown: Unit = io.print-i64(answer)
  let newline: Unit = io.println("")
  0
