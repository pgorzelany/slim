module reduction

fn dead_integer() -> I64:
  0

fn dead_boolean() -> Bool:
  true

fn dead_unit() -> Void:
  void

fn idempotent(value: Bool) -> Bool:
  value

fn identity_match(value: Bool) -> Bool:
  value

fn common_result(condition: Bool, value: Bool) -> Bool:
  value

fn main(args: Vec[Bytes]) -> I64 effects[alloc, io, partial]:
  let helper_integer: I64 = dead_integer()
  let helper_boolean: Bool = dead_boolean()
  dead_unit()
  let repeated: Bool = idempotent(true)
  let identity: Bool = identity_match(repeated)
  let common: Bool = common_result(identity, true)
  let added: I64 = 42
  let subtracted: I64 = added
  let multiplied: I64 = subtracted
  let nested: Bool = true
  let disjoined: Bool = nested
  let equal: Bool = true
  let combined: Bool = disjoined && equal
  let first_selected: Bool = combined && helper_boolean
  let selected: Bool = first_selected && common
  if selected:
    let values: Vec[I64] = vec.new()
    vec.push(values, multiplied)
    let result: I64 = vec.get(values, 0)
    let adjusted: I64 = result + helper_integer
    io.print_i64(adjusted)
    io.println("")
    0
  else:
    1
