module resource-work

fn run(remaining: I64) -> I64 effects[partial]:
  match i64.le(remaining 0):
    true:
      0
    false:
      recur(i64.sub(remaining 1))

fn known() -> I64 effects[partial]:
  run(10)

fn zero() -> I64 effects[partial]:
  run(0)

fn unknown(count: I64) -> I64 effects[partial]:
  run(count)

fn main(args: Vec[Bytes]) -> I64 effects[partial]:
  let left: I64 = known()
  let right: I64 = zero()
  i64.add(left right)
