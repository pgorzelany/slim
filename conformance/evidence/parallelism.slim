module parallel_evidence

fn safe_left(value: I64) -> Bool:
  value < 10

fn safe_right(value: I64) -> Bool:
  !safe_left(value)

fn safe_consume(value: Bool) -> Bool:
  !value

fn overdeclared() -> Bool effects[alloc, io, partial]:
  true

fn traps(value: I64) -> I64:
  value + 1

fn calls_trap(value: I64) -> I64:
  traps(value)

fn allocates() -> I64 effects[alloc]:
  let values: Vec[I64] = vec.new()
  0

fn borrows(value: @Vec[I64]) -> Bool:
  vec.len(value) > 0

fn mutates(var value: I64) -> I64:
  value = 1
  value

fn repeats(value: I64) -> Bool effects[partial]:
  if value == 0:
    true
  else:
    recur(0)

fn countdown(remaining: I64, state: Bool) -> Bool effects[partial]:
  if remaining <= 0:
    state
  else:
    recur(remaining - 1, !state)

fn countdown_pair(value: I64) -> Bool effects[partial]:
  let left: Bool = countdown(value, true)
  let right: Bool = countdown(value, false)
  left && right

fn overlap(value: I64) -> Bool:
  let first: Bool = safe_left(value)
  let second: Bool = safe_right(value)
  let third: Bool = safe_left(3)
  first && (second && third)

fn cycle_left() -> Bool:
  cycle_right()

fn cycle_right() -> Bool:
  cycle_left()

fn dependent(value: I64) -> Bool:
  let first: Bool = safe_left(value)
  let second: Bool = safe_consume(first)
  first && second

fn main(args: Vec[Bytes]) -> I64:
  let left: Bool = safe_left(1)
  let right: Bool = safe_right(20)
  if left && right:
    0
  else:
    1
