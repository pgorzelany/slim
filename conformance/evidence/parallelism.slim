module parallel-evidence

fn safe-left(value: I64) -> Bool:
  i64.lt(value 10)

fn safe-right(value: I64) -> Bool:
  bool.not(safe-left(value))

fn safe-consume(value: Bool) -> Bool:
  bool.not(value)

fn overdeclared() -> Bool effects[alloc io partial]:
  true

fn traps(value: I64) -> I64:
  i64.add(value 1)

fn calls-trap(value: I64) -> I64:
  traps(value)

fn allocates() -> I64 effects[alloc]:
  let values: Vec[I64] = vec.new()
  0

fn borrows(inout value: I64) -> Bool:
  i64.gt(value 0)

fn mutates(value: I64) -> I64:
  set value = 1
  value

fn repeats(value: I64) -> Bool effects[partial]:
  match i64.eq(value 0):
    true:
      true
    false:
      recur(0)

fn countdown(remaining: I64 state: Bool) -> Bool effects[partial]:
  match i64.le(remaining 0):
    true:
      state
    false:
      recur(i64.sub(remaining 1) bool.not(state))

fn countdown-pair(value: I64) -> Bool effects[partial]:
  let left: Bool = countdown(value true)
  let right: Bool = countdown(value false)
  bool.and(left right)

fn overlap(value: I64) -> Bool:
  let first: Bool = safe-left(value)
  let second: Bool = safe-right(value)
  let third: Bool = safe-left(3)
  bool.and(first bool.and(second third))

fn cycle-left() -> Bool:
  cycle-right()

fn cycle-right() -> Bool:
  cycle-left()

fn dependent(value: I64) -> Bool:
  let first: Bool = safe-left(value)
  let second: Bool = safe-consume(first)
  bool.and(first second)

fn main(args: Vec[Bytes]) -> I64:
  let left: Bool = safe-left(1)
  let right: Bool = safe-right(20)
  match bool.and(left right):
    true:
      0
    false:
      1
