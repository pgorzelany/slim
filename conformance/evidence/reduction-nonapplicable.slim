module reduction_nonapplicable

fn repeated_call(value: Bool) -> Bool:
  (!value) && (!value)

fn effect_order_shape(condition: Bool, value: Bool) -> Bool:
  if !condition:
    value
  else:
    value

fn distinct_results(condition: Bool, left: Bool, right: Bool) -> Bool:
  if condition:
    left
  else:
    right

fn main(args: Vec[Bytes]) -> I64:
  0
